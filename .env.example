# Arquivo opcional de bootstrap/emergência. Em instalação nova, o setup usa essas chaves como ponto de partida.
# Depois disso, o dia a dia fica concentrado na área Admin.

PORT=3001

# Chave de sessão (gere uma chave aleatória longa)
SESSION_SECRET=cartoes_jp_secret_chave_super_segura_123

# ===== GOOGLE OAUTH =====
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Em produção, use:
# GOOGLE_CALLBACK_URL=https://seu-dominio.com/auth/google/callback

# ===== EVOLUTION API (WHATSAPP) =====
EVOLUTION_API_URL=https://sua-instancia.com
EVOLUTION_API_KEY=SuaApiKeyAqui
EVOLUTION_INSTANCE_NAME=NomeDaSuaInstancia

# ===== NOTIFICAÇÕES VIA PUSH =====
# O trio VAPID habilita o push web no navegador. Sem ele, o aviso interno ainda pode existir,
# mas o sininho do browser não entra em cena.
VAPID_PUBLIC_KEY=COLE_AQUI_A_PUBLIC_KEY
VAPID_PRIVATE_KEY=COLE_AQUI_A_PRIVATE_KEY
VAPID_SUBJECT=mailto:seuemail@seudominio.com
# O VAPID_SUBJECT pode ser um mailto: ou uma URL.

# ===== SEGURANÇA DE SESSÃO =====
# Se maior que zero, expira a sessão após esse tempo sem atividade do usuário.
# Exemplo: 5 = exigir novo login após 5 minutos de inatividade.
INACTIVITY_TIMEOUT_MINUTES=0

# ===== AGENDA DOS ALERTAS AUTOMÁTICOS =====
# Esse relógio é compartilhado entre vencimento de fatura, datas do mês e datas combinadas.
CARD_DUE_PUSH_TIMEZONE=America/Sao_Paulo
CARD_DUE_PUSH_HOUR=10
CARD_DUE_PUSH_MINUTE=0
# Intervalo de varredura interna do servidor para revisar as rotinas automáticas.
CARD_DUE_PUSH_CHECK_INTERVAL_MINUTES=10

# ===== ROTINAS AUTOMÁTICAS =====
# Fatura do cartão
CARD_DUE_PUSH_ENABLED=1
CARD_DUE_PUSH_MAX_SENDS_PER_DAY=1
# Se quiser lembretes adicionais no mesmo dia, aumente o valor acima e defina o intervalo abaixo.
# Exemplo: MAX_SENDS_PER_DAY=2 e REPEAT_INTERVAL_MINUTES=480 para um segundo lembrete 8h depois.
CARD_DUE_PUSH_REPEAT_INTERVAL_MINUTES=0

# Datas do mês (grana que entra / grana que sai)
MONTHLY_FINANCE_DATE_ALERT_ENABLED=1

# Datas combinadas (cobranças avulsas com data e lembretes privados com data)
DATE_DRIVEN_ALERTS_ENABLED=1

# ===== COBRANÇAS ENTRE AMIGOS =====
# 1 = cobrança automática exige amizade ativa
# 0 = match por e-mail já libera a cobrança
FRIENDSHIP_GATE_SHARED_DEBT_ENABLED=1

# 1 = habilita a camada read-only de compras compartilhadas aceitas nas proximas fases
# 0 = desliga a exibicao/projecao sem precisar de rollback de banco
ENABLE_SHARED_PURCHASE_PROJECTIONS=1

# ===== API DE AUTOMAÇÕES (N8N + WHATSAPP + IA) =====
# 1 = libera /api/automation/v1 para o N8N. Mantenha 0 até configurar token e workflow.
AUTOMATION_API_ENABLED=0
AUTOMATION_API_TOKEN=
# Opcional no MVP com Bearer token; reservado para assinatura HMAC das requisições.
AUTOMATION_HMAC_SECRET=
AUTOMATION_HMAC_REQUIRED=0
AUTOMATION_HMAC_MAX_SKEW_SECONDS=300
AUTOMATION_DEFAULT_WORKFLOW_RATE_LIMIT_PER_MINUTE=120
AUTOMATION_LOG_RETENTION_DAYS=90
AUTOMATION_ERROR_RETENTION_DAYS=180
# Opcional: separe IPs por vírgula para aceitar somente o servidor do N8N.
AUTOMATION_ALLOWED_IPS=
AUTOMATION_CONVERSATION_TTL_MINUTES=20
AUTOMATION_RATE_LIMIT_PER_PHONE_PER_MINUTE=10
AUTOMATION_RATE_LIMIT_PER_KEY_PER_MINUTE=300
# Janela padrão para correções/remocoes por WhatsApp quando a compra nao nasceu da automacao.
AUTOMATION_PURCHASE_MUTATION_WINDOW_HOURS=72
# Configurações dos lembretes financeiros via WhatsApp.
AUTOMATION_REMINDER_DEFAULT_TIME=09:00
AUTOMATION_REMINDER_DUE_BATCH_LIMIT=50
# Configurações da importação de PDF por WhatsApp.
AUTOMATION_PDF_MAX_FILE_BYTES=12000000
AUTOMATION_PDF_STAGING_TTL_MINUTES=60
# Configurações dos resumos inteligentes via WhatsApp.
AUTOMATION_SMART_SUMMARIES_ENABLED=1
AUTOMATION_SMART_SUMMARY_DUE_BATCH_LIMIT=50

# N8N / Orquestrador WhatsApp 0.0
# A Evolution API deve apontar somente para o webhook do workflow 0.0 - ACERTTAPAY_FLUXO_INICIAL.
# No N8N, ACERTTAPAY_AUTOMATION_API_TOKEN deve ter o mesmo valor de AUTOMATION_API_TOKEN no AcerttaPay.
ACERTTAPAY_URL=http://127.0.0.1:3000
ACERTTAPAY_AUTOMATION_API_TOKEN=

# Redis Chat Memory para os agentes do N8N
# Use REDIS_URL ou configure host/porta/senha/db nas credenciais Redis do N8N.
REDIS_URL=redis://redis:6379/0
N8N_REDIS_HOST=redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=
N8N_REDIS_DB=0
ACERTTAPAY_N8N_MEMORY_TTL_SECONDS=86400
