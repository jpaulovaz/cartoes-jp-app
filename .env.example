PORT=3001

# Chave de sessão (gere uma chave aleatória longa)
SESSION_SECRET=cartoes_jp_secret_chave_super_segura_123

# ===== GOOGLE OAUTH =====
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Em produção, use:
# GOOGLE_CALLBACK_URL=https://seu-dominio.com/auth/google/callback

# ===== EVOLUTION API (WHATSAPP) =====
