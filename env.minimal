# .env.minimal — fallback de bootstrap/emergência do AcerttaPay
# Guarde este arquivo como um paraquedas. O dia a dia deve viver no /admin.
# Importante: mudanças feitas no /admin NÃO atualizam este arquivo automaticamente.

NODE_ENV=production
PORT=3001

# Sessão do app
# Gere uma chave longa, aleatória e bem única.
SESSION_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria

# Google OAuth — mínimo para fresh install e recuperação rápida
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_CALLBACK_URL=https://seu-dominio.com/auth/google/callback
# Em ambiente local, se precisar:
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# O restante pode morar no /admin.
# Se quiser deixar um paraquedas mais completo, descomente e preencha abaixo.

# ===== WHATSAPP / EVOLUTION API =====
# EVOLUTION_API_URL=https://sua-instancia.com
# EVOLUTION_API_KEY=SuaApiKeyAqui
# EVOLUTION_INSTANCE_NAME=NomeDaSuaInstancia

# ===== PUSH / VAPID =====
# O trio VAPID habilita o push web do navegador.
# Sem ele, os avisos internos ainda podem existir, mas o push web nao sai.
# VAPID_PUBLIC_KEY=COLE_AQUI_A_PUBLIC_KEY
# VAPID_PRIVATE_KEY=COLE_AQUI_A_PRIVATE_KEY
# VAPID_SUBJECT=mailto:seuemail@seudominio.com

# ===== SEGURANCA DE SESSAO =====
# INACTIVITY_TIMEOUT_MINUTES=0

# ===== AGENDA DOS ALERTAS AUTOMATICOS =====
# Esse relogio e compartilhado entre fatura, datas do mes e datas combinadas.
# CARD_DUE_PUSH_TIMEZONE=America/Sao_Paulo
# CARD_DUE_PUSH_HOUR=10
# CARD_DUE_PUSH_MINUTE=0
# CARD_DUE_PUSH_CHECK_INTERVAL_MINUTES=10

# ===== ROTINAS AUTOMATICAS =====
# Fatura do cartao
# CARD_DUE_PUSH_ENABLED=1
# CARD_DUE_PUSH_MAX_SENDS_PER_DAY=1
# CARD_DUE_PUSH_REPEAT_INTERVAL_MINUTES=0

# Datas do mes (grana que entra / grana que sai)
# MONTHLY_FINANCE_DATE_ALERT_ENABLED=1

# Datas combinadas (cobrancas avulsas com data e lembretes privados com data)
# DATE_DRIVEN_ALERTS_ENABLED=1
