      "name": "Call Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1056,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $json || {};\nconst reminders = Array.isArray(result.reminders) ? result.reminders : [];\nif (!reminders.length) return [{ json: { has_due: false } }];\nreturn reminders.map((reminder) => ({\n  json: {\n    has_due: true,\n    id: reminder.id,\n    user_id: reminder.user_id,\n    phone: String(reminder.whatsapp_number || reminder.phone_e164 || '').replace(/\\D/g, ''),\n    phone_e164: reminder.phone_e164,\n    whatsapp_number: reminder.whatsapp_number,\n    title: reminder.title,\n    outbound_text: reminder.outbound_text || reminder.whatsapp?.text || `⏰ *Lembrete do AcerttaPay*\\n\\n${reminder.title}`,\n    channel: reminder.channel || 'whatsapp'\n  }\n}));"
      },
      "id": "2b85dc1d-5baf-4dc8-a1d6-f3d19f2c8d6e",
      "name": "Expand Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -816,
        464
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "16623ceb-de53-402b-857e-2e21fdfcc1be",
              "leftValue": "={{ $json.has_due === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
