        "url": "={{ ($env.ACERTTAPAY_URL || 'http://127.0.0.1:3000').replace(/\\/$/, '') + '/api/automation/v1/reminders/' + $('Expand Due Reminders').item.json.id + '/mark-sent' }}",
        "sendHeaders": true,
