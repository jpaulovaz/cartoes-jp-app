        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.ACERTTAPAY_AUTOMATION_API_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { channel: 'whatsapp', limit: Number($env.AUTOMATION_REMINDER_DUE_BATCH_LIMIT || 50) } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ad0defc2-e44b-47ec-8b2d-2f710f6d3e65",
      "name": "Call Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -460,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $json || {};\nconst reminders = Array.isArray(result.reminders) ? result.reminders : [];\nif (!reminders.length) return [{ json: { has_due: false } }];\nreturn reminders.map((reminder) => ({\n  json: {\n    has_due: true,\n    id: reminder.id,\n    user_id: reminder.user_id,\n    phone: String(reminder.whatsapp_number || reminder.phone_e164 || '').replace(/\\D/g, ''),\n    phone_e164: reminder.phone_e164,\n    whatsapp_number: reminder.whatsapp_number,\n    title: reminder.title,\n    outbound_text: reminder.outbound_text || reminder.whatsapp?.text || `⏰ *Lembrete do AcerttaPay*\\n\\n${reminder.title}`,\n    channel: reminder.channel || 'whatsapp'\n  }\n}));"
      },
      "id": "f99a4651-72a5-412d-a3bb-6e4cb6c22e35",
      "name": "Expand Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "16623ceb-de53-402b-857e-2e21fdfcc1be",
              "leftValue": "={{ $json.has_due === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bfa3edf9-a5a5-4e09-b8bc-e77377dbb606",
      "name": "Has Due Reminder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
