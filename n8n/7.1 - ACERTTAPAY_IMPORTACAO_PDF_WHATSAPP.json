    {
      "parameters": {
        "jsCode": "function cleanJson(value) {\n  if (value && typeof value === 'object') return value;\n  const raw = String(value || '').trim();\n  const withoutFence = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```$/i, '').trim();\n  const first = withoutFence.indexOf('{');\n  const last = withoutFence.lastIndexOf('}');\n  if (first >= 0 && last > first) return withoutFence.slice(first, last + 1);\n  return withoutFence;\n}\nlet parsed;\ntry {\n  const content = $json.output ?? $json.text ?? $json.response ?? '';\n  const cleaned = cleanJson(content);\n  parsed = typeof cleaned === 'object' ? cleaned : JSON.parse(cleaned);\n} catch (error) {\n  parsed = { intent: 'help', confidence: 0, job_id: null, reply_text: null };\n}\nconst text = $('Normalize Evolution Payload').first().json.message_text || '';\nif (!parsed.job_id) {\n  const match = String(text).match(/#?\\s*(\\d{1,8})/);\n  if (match && /status|importa|pdf|cancel/i.test(text)) parsed.job_id = Number(match[1]);\n}\nreturn [{ json: parsed }];"
      },
      "id": "6b9625f2-e81e-475c-a339-c4912afe59c9",
      "name": "Parse PDF Command JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        660
      ]
    },
    {
      "parameters": {
        "jsCode": "const intent = String($json.intent || 'help');\nconst jobId = Number($json.job_id || 0);\nconst base = String($env.ACERTTAPAY_URL || 'http://127.0.0.1:3000').replace(/\\/$/, '');\nconst norm = $('Normalize Evolution Payload').first().json;\nconst commonBody = { phone: norm.phone, source: { channel: 'whatsapp', instance: norm.instance, message_id: norm.message_id, raw_text: norm.message_text } };\nif (intent === 'list_pdf_imports') {\n  return [{ json: { needs_backend: true, url: `${base}/api/automation/v1/imports/pdf/jobs/list`, body: { ...commonBody, limit: 5 }, idempotency_key: `whatsapp-pdf-list:${norm.instance}:${norm.message_id}` } }];\n}\nif (intent === 'status_pdf_import') {\n  if (!jobId) return [{ json: { needs_backend: false, reply_text: 'Me manda o número do job para eu consultar. Ex.: *status da importação #12*.' } }];\n  return [{ json: { needs_backend: true, url: `${base}/api/automation/v1/imports/pdf/jobs/${jobId}/status`, body: commonBody, idempotency_key: `whatsapp-pdf-status:${norm.instance}:${norm.message_id}` } }];\n}\nif (intent === 'cancel_pdf_import') {\n  if (!jobId) return [{ json: { needs_backend: false, reply_text: 'Me diz qual importação cancelar. Ex.: *cancelar importação #12*.' } }];\n  return [{ json: { needs_backend: true, url: `${base}/api/automation/v1/imports/pdf/jobs/${jobId}/cancel`, body: commonBody, idempotency_key: `whatsapp-pdf-cancel:${norm.instance}:${norm.message_id}` } }];\n}\nconst defaultText = '📄 *Importação de fatura PDF*\\n\\nMe manda o PDF da fatura por aqui. Se puder, coloca uma legenda assim:\\n*fatura Nubank junho/2026*\\n\\nTambém posso acompanhar:\\n• *status da importação #12*\\n• *cancelar importação #12*\\n• *listar importações*\\n\\nNada entra direto no app: eu só preparo a revisão, você confere e confirma pelo AcerttaPay.';\nreturn [{ json: { needs_backend: false, reply_text: $json.reply_text || defaultText } }];"
      },
