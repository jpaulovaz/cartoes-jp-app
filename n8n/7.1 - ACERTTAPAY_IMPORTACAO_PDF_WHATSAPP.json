      "parameters": {
        "jsCode": "function cleanJson(value) {\n  if (value && typeof value === 'object') return value;\n  const raw = String(value || '').trim();\n  const withoutFence = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```$/i, '').trim();\n  const first = withoutFence.indexOf('{');\n  const last = withoutFence.lastIndexOf('}');\n  if (first >= 0 && last > first) return withoutFence.slice(first, last + 1);\n  return withoutFence;\n}\nlet parsed;\ntry {\n  const content = $json.output ?? $json.text ?? $json.response ?? '';\n  const cleaned = cleanJson(content);\n  parsed = typeof cleaned === 'object' ? cleaned : JSON.parse(cleaned);\n} catch (error) {\n  parsed = { intent: 'complete_pdf_import_details', confidence: 0, card_hint: $('Normalize Evolution Payload').first().json.message_text };\n}\nparsed.month = parsed.month == null ? null : Number(parsed.month);\nparsed.year = parsed.year == null ? null : Number(parsed.year);\nreturn [{ json: parsed }];"
