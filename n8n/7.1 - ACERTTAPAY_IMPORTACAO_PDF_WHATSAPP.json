        "jsCode": "function findBase64(value) {\n  if (!value || typeof value !== 'object') return '';\n  const candidates = [\n    value.base64,\n    value.data?.base64,\n    value.result?.base64,\n    value.media?.base64,\n    value.file?.base64,\n    value.base64Data,\n    value.message?.base64,\n    value.response?.base64\n  ];\n  for (const candidate of candidates) {\n    const text = String(candidate || '').trim();\n    if (text) return text.replace(/^data:[^;]+;base64,/i, '').replace(/\\s+/g, '');\n  }\n  return '';\n}\nconst base64 = findBase64($json);\nconst caption = $('Parse PDF Caption JSON').first().json || {};\nconst normalized = $('Normalize Evolution Payload').first().json;\nif (!base64) {\n  return [{ json: { ok: false, code: 'MEDIA_DOWNLOAD_FAILED', whatsapp: { text: 'Recebi o PDF, mas não consegui baixar a mídia pela Evolution API. Confere a instância e tenta reenviar a fatura. 📄' } } }];\n}\nreturn [{ json: {\n  phone: normalized.phone,\n  filename: normalized.filename || 'fatura.pdf',\n  mime_type: normalized.mimetype || 'application/pdf',\n  file_base64: base64,\n  card_hint: caption.card_hint || null,\n  month: caption.month || null,\n  year: caption.year || null,\n  source: {\n    channel: 'whatsapp',\n    instance: normalized.instance,\n    message_id: normalized.message_id,\n    raw_text: normalized.message_text || normalized.caption || '',\n    filename: normalized.filename,\n    mimetype: normalized.mimetype\n  }\n}}];"
      },
