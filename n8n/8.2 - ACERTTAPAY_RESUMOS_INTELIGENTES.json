      "parameters": {
        "jsCode": "function cleanJsonContent(value) {\n  if (value && typeof value === 'object') return value;\n  const raw = String(value || '').trim();\n  if (!raw) return '';\n  const withoutFence = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```$/i, '').trim();\n  const first = withoutFence.indexOf('{');\n  const last = withoutFence.lastIndexOf('}');\n  if (first >= 0 && last > first) return withoutFence.slice(first, last + 1);\n  return withoutFence;\n}\nlet parsed;\ntry {\n  const cleaned = cleanJsonContent($json.output ?? $json.text ?? $json.response ?? '');\n  parsed = typeof cleaned === 'object' ? cleaned : JSON.parse(cleaned);\n} catch (error) {\n  parsed = { intent: 'help', reply_text: 'Posso mandar resumo do mês, resumo da semana ou ativar resumo automático.' };\n}\nconst phone = $('Normalize Evolution Payload').first().json.phone;\nconst source = { channel: 'whatsapp', instance: $('Normalize Evolution Payload').first().json.instance, message_id: $('Normalize Evolution Payload').first().json.message_id, raw_text: $('Normalize Evolution Payload').first().json.message_text };\nlet endpoint = '/api/automation/v1/insights/monthly';\nlet body = { phone, source, month: parsed.month, year: parsed.year, period: parsed.period };\nif (parsed.intent === 'weekly_summary') {\n  endpoint = '/api/automation/v1/insights/weekly';\n} else if (parsed.intent === 'spending_insights' || parsed.intent === 'monthly_intelligent_summary') {\n  endpoint = '/api/automation/v1/insights/monthly';\n} else if (parsed.intent === 'enable_auto_summary') {\n  endpoint = '/api/automation/v1/insights/preferences';\n  body = { phone, source, summary_kind: parsed.summary_kind || 'weekly', enabled: true, schedule_day: parsed.schedule_day || 1, schedule_hour: parsed.schedule_hour || 9 };\n} else if (parsed.intent === 'disable_auto_summary') {\n  endpoint = '/api/automation/v1/insights/preferences';\n  body = { phone, source, summary_kind: parsed.summary_kind || 'weekly', enabled: false };\n} else if (parsed.intent === 'help') {\n  return [{ json: { send_direct: true, reply_text: parsed.reply_text || '📊 Posso mandar *resumo do mês*, *resumo da semana* e ativar resumo automático. Ex.: *ativar resumo semanal*.' } }];\n} else if (parsed.intent === 'out_of_scope') {\n  return [{ json: { send_direct: true, reply_text: parsed.reply_text || 'Aqui eu cuido dos resumos inteligentes. Para compra, lembrete ou acerto, use o fluxo correspondente.' } }];\n}\nreturn [{ json: { endpoint, body, idempotency_key: `whatsapp-summary:${source.instance}:${source.message_id}` } }];"
      },
