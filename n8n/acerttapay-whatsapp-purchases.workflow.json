        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { model: $env.OPENAI_MODEL || 'gpt-4.1-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Você interpreta mensagens de WhatsApp para criar compras no AcerttaPay. Retorne somente JSON válido. Nunca invente cartão, participante, categoria, parcela ou recorrência. Se houver ambiguidade, marque needs_clarification=true e faça uma pergunta curta. Valores devem ser amount_cents em centavos. Datas devem ser YYYY-MM-DD usando America/Sao_Paulo e a data atual fornecida no contexto. Schema: {\"intent\":\"create_purchase\",\"confidence\":0.0,\"needs_clarification\":false,\"clarifying_question\":null,\"purchase\":{\"date\":\"YYYY-MM-DD\",\"description\":\"\",\"amount_cents\":0,\"installments\":1,\"is_recurring\":false,\"card_hint\":null,\"category_hint\":null}}' }, { role: 'user', content: JSON.stringify({ current_date: $('Normalize Evolution Payload').item.json.current_date, message: $('Normalize Evolution Payload').item.json.message_text }) } ] } }}",
        "options": {}
      },
      "id": "ai-parse-new-purchase",
      "name": "AI Parse New Purchase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        -360
      ]
    },
    {
      "parameters": {
        "jsCode": "const content = $json.choices?.[0]?.message?.content || $json.output || $json.text || '';\nlet parsed;\ntry {\n  parsed = typeof content === 'object' ? content : JSON.parse(String(content).replace(/^```json\\s*/i, '').replace(/```$/i, '').trim());\n} catch (error) {\n  parsed = {\n    intent: 'create_purchase',\n    confidence: 0,\n    needs_clarification: true,\n    clarifying_question: 'Não consegui entender essa compra. Me manda no formato: Nova compra hoje de R$ 199,90 em Casas Bahia.'\n  };\n}\nreturn [{ json: parsed }];"
      },
