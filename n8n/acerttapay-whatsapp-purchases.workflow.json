    {
      "parameters": {
        "jsCode": "const root = $json || {};\nconst data = root.data || root;\nconst key = data.key || {};\nconst msg = data.message || root.message || {};\nconst remoteJid = String(key.remoteJid || data.remoteJid || data.from || root.from || data.sender || '').trim();\nlet phone = String(data.number || data.sender || data.phone || root.number || remoteJid.split('@')[0] || '').replace(/\\D/g, '');\nif (phone.startsWith('0') && phone.length > 11) phone = phone.replace(/^0+/, '');\nconst text = String(\n  data.text ||\n  root.text ||\n  data.body ||\n  root.body ||\n  msg.conversation ||\n  msg.extendedTextMessage?.text ||\n  msg.imageMessage?.caption ||\n  msg.videoMessage?.caption ||\n  ''\n).trim();\nconst messageId = String(key.id || data.messageId || data.id || root.messageId || root.id || '').trim() || `${phone}:${Date.now()}`;\nconst fromMe = Boolean(key.fromMe || data.fromMe || root.fromMe);\nreturn [{\n  json: {\n    phone,\n    message_text: text,\n    message_id: messageId,\n    push_name: data.pushName || root.pushName || data.push_name || '',\n    instance: data.instance || root.instance || $env.EVOLUTION_INSTANCE_NAME || '',\n    from_me: fromMe,\n    is_valid_user_message: Boolean(phone && text && !fromMe),\n    current_date: new Date().toLocaleDateString('sv-SE', { timeZone: 'America/Sao_Paulo' }),\n    raw: root\n  }\n}];"
      },
