<%- include("partials/header", { title: "AcerttaPay | QG do admin" }) %>

<%
  const toneBadgeClasses = {
    success: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200',
    warning: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200',
    muted: 'border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300'
  };
  const tonePanelClasses = {
    success: 'border-emerald-200 bg-emerald-50/80 dark:border-emerald-900/60 dark:bg-emerald-950/20',
    warning: 'border-amber-200 bg-amber-50/80 dark:border-amber-900/60 dark:bg-amber-950/20',
    muted: 'border-slate-200 bg-slate-50/90 dark:border-slate-700 dark:bg-slate-900/40'
  };
  const statusIconByKey = {
    google: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 5v14m7-7H5"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M16.5 7.5A5.5 5.5 0 0012 5a5.5 5.5 0 00-4.5 2.5"></path></svg>',
    whatsapp: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 17l-2.5 1 .8-2.3A7 7 0 1119 12a7 7 0 01-11 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M10 10.5c.4 1.2 1.3 2.1 2.5 2.5"></path></svg>',
    email: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7h16v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 8l8 6 8-6"></path></svg>',
    push: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M15 17h5l-1.4-1.4a2 2 0 01-.6-1.4V11a6 6 0 10-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 17a3 3 0 006 0"></path></svg>',
    backup: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 7a2 2 0 012-2h12a2 2 0 012 2v3H4V7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 10h16v7a2 2 0 01-2 2H6a2 2 0 01-2-2v-7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 14h6"></path></svg>',
    session: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 3l7 4v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V7l7-4z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 9v3l2 2"></path></svg>'
  };
  function renderStatusIcon(key) {
    return statusIconByKey[key] || '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="9" stroke-width="1.9"></circle></svg>';
  }

  const usersList = Array.isArray(users) ? users : [];
  const settingsList = Array.isArray(settingsSections) ? settingsSections : [];
  const serviceCards = Array.isArray(statusCards) ? statusCards : [];
  const activeSectionKey = typeof activeSection !== 'undefined' && activeSection ? activeSection : 'access';
  const backupState = typeof backupPanel !== 'undefined' && backupPanel ? backupPanel : null;
  const emailState = typeof emailPanel !== 'undefined' && emailPanel ? emailPanel : null;
  const pushState = typeof pushPanel !== 'undefined' && pushPanel ? pushPanel : null;
  const adminGuideUrl = backupState && backupState.guideUrl ? backupState.guideUrl : '/admin/guide';
  const adminUsersCount = usersList.filter((item) => String(item.role || '') === 'admin').length;
  const importReleasedCount = usersList.filter((item) => Number(item.can_import ?? 1) !== 0).length;
  const neverAccessedCount = usersList.filter((item) => !(item.last_seen_at || item.last_login)).length;
  const welcomePendingCount = usersList.filter((item) => (item.welcomeEmailStatus?.tone || 'muted') !== 'success').length;
  const servicesReadyCount = serviceCards.filter((item) => item.tone === 'success').length;
  const servicesAttentionCount = serviceCards.length - servicesReadyCount;
  const fieldsWithRestartCount = settingsList.reduce((sum, section) => sum + section.fields.filter((field) => field.restartRequired).length, 0);
  const sectionsWithRestartCount = settingsList.filter((section) => section.fields.some((field) => field.restartRequired)).length;
  const sectionStatusByKey = {};
  serviceCards.forEach((card) => {
    sectionStatusByKey[card.key] = card;
    if (card.key === 'session') {
      sectionStatusByKey.security = card;
    }
  });

  const groupMeta = {
    identity: {
      title: 'Autenticação e segurança',
      description: 'Configurações de login, sessão e proteção de acesso ao aplicativo.'
    },
    messaging: {
      title: 'Mensageria e alertas',
      description: 'Canais usados para comunicação com usuários e notificações operacionais.'
    },
    rules: {
      title: 'Regras do produto',
      description: 'Parâmetros que alteram o comportamento funcional do aplicativo.'
    },
    operations: {
      title: 'Backup e recuperação',
      description: 'Rotinas de cópia, armazenamento e restauração do ambiente.'
    },
    system: {
      title: 'Sistema',
      description: 'Ajustes estruturais do servidor e parâmetros de execução.'
    }
  };

  const sectionCopyOverrides = {
    google: {
      nav: 'Credenciais e retorno do OAuth.',
      description: 'Define Client ID, Client Secret e URL de retorno do login com Google.'
    },
    whatsapp: {
      nav: 'Integração com a Evolution API.',
      description: 'Configura a integração responsável pelos envios automáticos via WhatsApp.'
    },
    email: {
      nav: 'SMTP, remetente e testes de envio.',
      description: 'Centraliza SMTP, remetente padrão, testes e reenvio de comunicações.'
    },
    push: {
      nav: 'Push web, agenda automática e rotinas do sistema.',
      description: 'Liga o push web, organiza a agenda dos alertas automáticos e mostra sem pegadinha quais rotinas do sistema estão ativas.'
    },
    security: {
      nav: 'Sessão, PIN e passkeys.',
      description: 'Define tempo de sessão, proteção local e políticas de autenticação.'
    },
    sharedDebt: {
      nav: 'Regra de vínculo dos acertos.',
      description: 'Configura como o aplicativo valida o vínculo necessário para acertos entre pessoas.'
    },
    backup: {
      nav: 'Agendamento, destinos e restauração.',
      description: 'Gerencia backup automático, armazenamento local, Google Drive e restauração.'
    },
    system: {
      nav: 'Parâmetros técnicos do servidor.',
      description: 'Reúne ajustes estruturais do servidor e itens que podem exigir reinicialização.'
    }
  };

  const groupedSections = Object.keys(groupMeta).map((groupKey) => ({
    key: groupKey,
    title: groupMeta[groupKey].title,
    description: groupMeta[groupKey].description,
    sections: settingsList.filter((section) => section.group === groupKey)
  })).filter((group) => group.sections.length > 0);

  function buildSectionSearchText(section) {
    const override = sectionCopyOverrides[section.key] || {};
    const parts = [section.title, section.eyebrow, override.description || section.description, override.nav || section.shortDescription];
    (section.fields || []).forEach((field) => {
      parts.push(field.label, field.helper, field.key, field.placeholder, field.appliesLabel);
    });
    return parts.filter(Boolean).join(' ');
  }

  function buildNavItemFromSection(section) {
    const statusCard = sectionStatusByKey[section.key] || null;
    const restartCount = section.fields.filter((field) => field.restartRequired).length;
    return {
      key: section.key,
      title: section.title,
      description: (sectionCopyOverrides[section.key] && sectionCopyOverrides[section.key].nav) || section.shortDescription || section.eyebrow || 'Configuração',
      badge: statusCard ? statusCard.status : (restartCount > 0 ? `${restartCount} restart` : `${section.fields.length} ajuste(s)`),
      searchText: buildSectionSearchText(section)
    };
  }

  const navGroups = [
    {
      key: 'workspace',
      title: 'Operação do dia',
      items: [
        {
          key: 'overview',
          title: 'Visão geral',
          description: 'Resumo operacional e atalhos principais.',
          badge: `${servicesReadyCount}/${serviceCards.length || 0}`,
          searchText: 'visao geral resumo rapido servicos acessos email backup push'
        },
        {
          key: 'access',
          title: 'Acessos',
          description: 'Gestão de usuários, permissões e convites.',
          badge: `${usersList.length} acesso(s)`,
          searchText: 'acessos usuarios convite boas-vindas email admin login'
        }
      ]
    }
  ].concat(groupedSections.map((group) => ({
    key: group.key,
    title: group.title,
    items: group.sections.map(buildNavItemFromSection)
  })));

  function getSectionStatus(section) {
    return sectionStatusByKey[section.key] || null;
  }
%>

<div class="op-page-shell op-admin-screen-v4 max-w-[1500px] mx-auto space-y-5 pb-24">
  <section class="op-admin-hero-v4 rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <div class="px-6 py-6 sm:px-8 flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
      <div class="min-w-0 max-w-4xl">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Administração</span>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">QG do admin</h1>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Aqui é o ponto de comando para cuidar de acessos, integrações, backups e ajustes do app sem precisar caçar informação pela tela.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/40"><%= usersList.length %> acesso(s)</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/40"><%= servicesReadyCount %> serviço(s) disponíveis</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/40"><%= servicesAttentionCount %> em atenção</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/40"><%= totalConfigItems %> configurações</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/40"><%= fieldsWithRestartCount %> exigem restart</span>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 xl:min-w-[440px]">
        <button type="button" onclick="openAddUserModal()"
          class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
          Novo acesso
        </button>

        <a href="/admin/messages" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">
          Mensagens do app
        </a>

        <form action="/admin/email/test-connection" method="POST">
          <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">
            Testar e-mail
          </button>
        </form>

        <form action="/admin/backup/run" method="POST">
          <button type="submit" class="w-full inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">
            Executar backup
          </button>
        </form>

        <a href="<%= adminGuideUrl %>" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">
          Abrir guia
        </a>
      </div>
    </div>
  </section>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="op-inline-alert op-inline-alert--warning">
      <div class="op-inline-alert__icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div>
        <div class="op-inline-alert__title">Ação necessária</div>
        <div class="op-inline-alert__text"><%= error %></div>
      </div>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="op-inline-alert op-inline-alert--success">
      <div class="op-inline-alert__icon">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <div>
        <div class="op-inline-alert__title">Alterações salvas</div>
        <div class="op-inline-alert__text"><%= success %></div>
      </div>
    </div>
  <% } %>

  <div class="op-admin-layout grid gap-6 xl:grid-cols-[290px,minmax(0,1fr)] xl:items-start">
    <aside class="self-start xl:sticky xl:top-32 xl:max-h-[calc(100vh-9rem)]">
      <%- include('partials/admin/sidebar', { navGroups, activeSectionKey, adminGuideUrl }) %>
    </aside>

    <div class="space-y-6 min-w-0">
      <section id="admin-section-overview"
               data-admin-search-target
               data-admin-search="visao geral servicos email backup push google seguranca acessos resumo rapido"
               class="op-surface-card op-admin-section-card op-admin-overview-card bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden scroll-mt-32">
        <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-700 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <span class="text-xs font-black uppercase tracking-[0.18em] text-sky-500 dark:text-sky-300">Resumo da ópera</span>
            <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white">Resumo operacional</h2>
            <p class="mt-3 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">
              Resumo dos serviços, atalhos mais utilizados e sinais que exigem acompanhamento imediato.
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="badge"><%= autoReloadCount %> entram na hora</span>
            <span class="badge"><%= restartRequiredCount %> pedem restart</span>
          </div>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
          <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
            <article class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
              <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Acessos ativos</div>
              <div class="mt-3 text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= usersList.length %></div>
              <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400"><%= adminUsersCount %> admin(s) e <%= neverAccessedCount %> ainda sem atividade registrada.</p>
            </article>
            <article class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
              <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Serviços prontos</div>
              <div class="mt-3 text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= servicesReadyCount %>/<%= serviceCards.length || 0 %></div>
              <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400"><%= servicesAttentionCount > 0 ? `${servicesAttentionCount} item(ns) em atenção.` : 'Sem alertas relevantes no momento.' %></p>
            </article>
            <article class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
              <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Pede restart</div>
              <div class="mt-3 text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= fieldsWithRestartCount %></div>
              <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400"><%= sectionsWithRestartCount %> seção(ões) têm pelo menos um campo desse tipo.</p>
            </article>
            <article class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
              <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Convites pendentes</div>
              <div class="mt-3 text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= welcomePendingCount %></div>
              <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">Quem ainda não recebeu ou não teve boas-vindas confirmado.</p>
            </article>
          </div>

          <div class="grid gap-4 xl:grid-cols-[minmax(0,1.1fr),minmax(320px,0.9fr)]">
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              <% serviceCards.forEach((card) => {
                   const toneClass = tonePanelClasses[card.tone || 'muted'] || tonePanelClasses.muted;
                   const badgeClass = toneBadgeClasses[card.tone || 'muted'] || toneBadgeClasses.muted;
              %>
                <article class="rounded-2xl border p-5 <%= toneClass %>">
                  <div class="flex items-start justify-between gap-3">
                    <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-current/10 bg-white/60 text-current dark:bg-slate-900/30">
                      <%- renderStatusIcon(card.key) %>
                    </div>
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= badgeClass %>"><%= card.status %></span>
                  </div>
                  <h3 class="mt-4 text-base font-black tracking-tight text-slate-900 dark:text-white"><%= card.title %></h3>
                  <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300"><%= card.text %></p>
                </article>
              <% }) %>
            </div>

            <div class="space-y-4">
              <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
                <div class="text-xs font-black uppercase tracking-[0.18em] text-violet-500 dark:text-violet-300">Prioridades operacionais</div>
                <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Prioridades</h3>
                <ul class="mt-4 space-y-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                  <li>• Use os atalhos para liberar acesso, testar e-mail ou executar backup sem navegar pela página.</li>
                  <li>• Históricos e blocos de apoio foram mantidos em áreas secundárias para preservar a leitura principal.</li>
                  <li>• A busca lateral localiza seções e campos sem exigir rolagem manual extensa.</li>
                </ul>
              </div>
              <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                <div class="text-xs font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Documentação</div>
                <p class="mt-2">
                  O guia completo continua disponível como referência operacional.
                </p>
                <a href="<%= adminGuideUrl %>" class="mt-4 inline-flex items-center rounded-2xl border border-slate-200 px-4 py-2.5 text-sm font-black text-slate-700 transition hover:bg-white dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                  Abrir guia completo
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%- include('partials/admin/access-section', { users: usersList, user, emailState, toneBadgeClasses }) %>

      <% groupedSections.forEach((group) => { %>
        <section data-admin-group-container class="space-y-4">
          <div class="px-1">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500"><%= group.title %></div>
            <p class="mt-2 max-w-3xl text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400"><%= group.description %></p>
          </div>

          <% group.sections.forEach((section) => {
               const sectionStatus = getSectionStatus(section);
               const restartCount = section.fields.filter((field) => field.restartRequired).length;
               const secretCount = section.fields.filter((field) => field.secret).length;
               const fullText = buildSectionSearchText(section);
               const sectionCopy = sectionCopyOverrides[section.key] || {};
               const sectionDescription = sectionCopy.description || section.shortDescription || section.description;
               const pushStateForSection = section.key === 'push' ? pushState : null;
               const pushFieldMap = pushStateForSection ? Object.fromEntries((section.fields || []).map((field) => [field.key, field])) : {};
               const pushInfrastructureFieldKeys = ['VAPID_PUBLIC_KEY', 'VAPID_PRIVATE_KEY', 'VAPID_SUBJECT'];
               const pushScheduleFieldKeys = ['CARD_DUE_PUSH_TIMEZONE', 'CARD_DUE_PUSH_HOUR', 'CARD_DUE_PUSH_MINUTE', 'CARD_DUE_PUSH_CHECK_INTERVAL_MINUTES'];
          %>
            <section id="admin-section-<%= section.key %>"
                     data-admin-search-target
                     data-admin-search="<%= fullText %>"
                     class="op-surface-card op-admin-section-card bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden scroll-mt-32">
              <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-700 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0 max-w-3xl">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-black uppercase tracking-[0.18em] text-violet-500 dark:text-violet-300"><%= section.eyebrow %></span>
                    <% if (sectionStatus) { %>
                      <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= toneBadgeClasses[sectionStatus.tone || 'muted'] || toneBadgeClasses.muted %>"><%= sectionStatus.status %></span>
                    <% } %>
                  </div>
                  <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= section.title %></h2>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300"><%= sectionDescription %></p>
                </div>
                <div class="flex flex-wrap gap-2 lg:justify-end">
                  <span class="badge"><%= section.fields.length %> ajuste(s)</span>
                  <% if (restartCount > 0) { %>
                    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200"><%= restartCount %> pede(m) restart</span>
                  <% } else { %>
                    <span class="badge">Tudo entra na hora</span>
                  <% } %>
                  <% if (secretCount > 0) { %>
                    <span class="badge"><%= secretCount %> sensível(is)</span>
                  <% } %>
                </div>
              </div>

              <div class="p-6 sm:p-8 grid gap-6 xl:grid-cols-[minmax(0,1fr),320px] xl:items-start">
                <form action="/admin/settings/<%= section.key %>" method="POST" class="space-y-5 min-w-0">
                  <% if (pushStateForSection) { %>
                    <div class="grid gap-4 md:grid-cols-3">
                      <div class="rounded-2xl border p-4 <%= tonePanelClasses[pushStateForSection.infrastructure.tone || 'muted'] || tonePanelClasses.muted %>">
                        <div class="text-[11px] font-black uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Push web</div>
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                          <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= toneBadgeClasses[pushStateForSection.infrastructure.tone || 'muted'] || toneBadgeClasses.muted %>"><%= pushStateForSection.infrastructure.status %></span>
                        </div>
                        <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300"><%= pushStateForSection.infrastructure.helperText %></p>
                      </div>
                      <div class="rounded-2xl border p-4 border-sky-200 bg-sky-50/80 dark:border-sky-900/60 dark:bg-sky-950/20">
                        <div class="text-[11px] font-black uppercase tracking-[0.16em] text-sky-700 dark:text-sky-200">Agenda automática</div>
                        <div class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= pushStateForSection.schedule.label %></div>
                        <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">Varredura a cada <span class="font-black text-slate-900 dark:text-white"><%= pushStateForSection.schedule.checkIntervalMinutes %> min</span>.</p>
                      </div>
                      <div class="rounded-2xl border p-4 border-violet-200 bg-violet-50/80 dark:border-violet-900/60 dark:bg-violet-950/20">
                        <div class="text-[11px] font-black uppercase tracking-[0.16em] text-violet-700 dark:text-violet-200">Rotinas ativas</div>
                        <div class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= pushStateForSection.activeCount %> de <%= pushStateForSection.totalCount %></div>
                        <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">Sem adivinhação: você vê quem toca, quem só avisa no app e quem ficou na geladeira.</p>
                      </div>
                    </div>

                    <% if (!pushStateForSection.infrastructure.configured && pushStateForSection.hasInAppFallback) { %>
                      <div class="rounded-2xl border border-amber-200 bg-amber-50/90 px-4 py-4 text-sm font-medium leading-relaxed text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-100">
                        O push web ainda depende do trio VAPID, mas as rotinas que também geram aviso interno continuam firmes na central do app. Ou seja: o sininho do navegador pode até cochilar, mas o recado não some.
                      </div>
                    <% } %>

                    <div class="space-y-5">
                      <section class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/40">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                          <div class="min-w-0 flex-1">
                            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-300">Bloco 1</div>
                            <h3 class="mt-2 text-xl font-black tracking-tight text-slate-900 dark:text-white">Saúde do push web</h3>
                            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">Aqui mora a tomada do sininho: sem VAPID completo, nenhum push web sai. O teste operacional continua no catálogo de mensagens.</p>
                          </div>
                          <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= toneBadgeClasses[pushStateForSection.infrastructure.tone || 'muted'] || toneBadgeClasses.muted %>"><%= pushStateForSection.infrastructure.status %></span>
                        </div>
                        <div class="mt-4 grid gap-4 md:grid-cols-2">
                          <% pushInfrastructureFieldKeys.forEach((fieldKey) => { const field = pushFieldMap[fieldKey]; if (!field) return; %>
                            <%- include('partials/admin/setting-field', { field }) %>
                          <% }) %>
                        </div>
                      </section>

                      <section class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/40">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                          <div class="min-w-0 flex-1">
                            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Bloco 2</div>
                            <h3 class="mt-2 text-xl font-black tracking-tight text-slate-900 dark:text-white">Agenda dos alertas automáticos</h3>
                            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">Esse relógio é compartilhado entre fatura, datas do mês e datas combinadas. Não é mais um campo fantasiado de “só fatura”.</p>
                          </div>
                          <div class="flex flex-wrap gap-2">
                            <span class="badge"><%= pushStateForSection.schedule.label %></span>
                            <span class="badge">A cada <%= pushStateForSection.schedule.checkIntervalMinutes %> min</span>
                          </div>
                        </div>
                        <div class="mt-4 grid gap-4 md:grid-cols-2">
                          <% pushScheduleFieldKeys.forEach((fieldKey) => { const field = pushFieldMap[fieldKey]; if (!field) return; %>
                            <%- include('partials/admin/setting-field', { field }) %>
                          <% }) %>
                        </div>
                      </section>

                      <section class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/40">
                        <div>
                          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600 dark:text-violet-300">Bloco 3</div>
                          <h3 class="mt-2 text-xl font-black tracking-tight text-slate-900 dark:text-white">Rotinas automáticas</h3>
                          <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">Cada família ganhou seu próprio interruptor, agora com switch visível no card. Assim o admin não apaga a luz da fatura achando que a sala inteira ficou no escuro.</p>
                        </div>
                        <div class="mt-4 grid gap-4 xl:grid-cols-3">
                          <% pushStateForSection.routines.forEach((routine) => { %>
                            <article class="rounded-[24px] border p-4 <%= tonePanelClasses[routine.tone || 'muted'] || tonePanelClasses.muted %>">
                              <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= toneBadgeClasses[routine.tone || 'muted'] || toneBadgeClasses.muted %>"><%= routine.status %></span>
                                <span class="badge"><%= routine.channelLabel %></span>
                              </div>
                              <h4 class="mt-3 text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= routine.title %></h4>
                              <p class="mt-2 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300"><%= routine.description %></p>
                              <div class="mt-4 rounded-2xl border border-white/70 bg-white/80 px-4 py-3 text-sm font-medium leading-relaxed text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">
                                <div><span class="font-black text-slate-900 dark:text-white">Escopo:</span> <%= routine.scopeLabel %></div>
                                <div class="mt-2"><%= routine.helperText %></div>
                              </div>
                              <div class="mt-4 grid gap-4">
                                <% routine.fieldKeys.forEach((fieldKey) => { const field = pushFieldMap[fieldKey]; if (!field) return; %>
                                  <%- include('partials/admin/setting-field', { field }) %>
                                <% }) %>
                              </div>
                            </article>
                          <% }) %>
                        </div>
                      </section>
                    </div>
                  <% } else { %>
                    <div class="grid gap-4 md:grid-cols-2">
                      <% section.fields.forEach((field) => { %>
                        <%- include('partials/admin/setting-field', { field }) %>
                      <% }) %>
                    </div>
                  <% } %>

                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
                      <% if (pushStateForSection) { %>
                        A agenda é compartilhada entre as rotinas automáticas. Salvou aqui, o relógio inteiro entra na linha.
                      <% } else if (restartCount > 0) { %>
                        Os campos com badge amarelo pedem restart depois de salvar.
                      <% } else { %>
                        Esta seção aplica as mudanças sem precisar reiniciar o app.
                      <% } %>
                    </p>
                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-blue-500 dark:hover:bg-blue-400">
                      Salvar <%= section.title %>
                    </button>
                  </div>
                </form>

                <aside class="space-y-4">
                  <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-5">
                    <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Resumo da seção</div>
                    <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-900 dark:text-white">Visão rápida</h3>
                    <div class="mt-4 space-y-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                      <% if (sectionStatus) { %>
                        <p><span class="font-black text-slate-900 dark:text-white"><%= sectionStatus.status %>.</span> <%= sectionStatus.text %></p>
                      <% } else { %>
                        <p>Esta seção não possui painel operacional dedicado; use este bloco como referência principal de configuração.</p>
                      <% } %>
                      <p><%= restartCount > 0 ? `${restartCount} campo(s) desta seção pedem restart.` : 'As alterações desta seção entram em vigor imediatamente após salvar.' %></p>
                      <% if (secretCount > 0) { %>
                        <p><%= secretCount %> campo(s) permanecem mascarados por padrão para proteger dados sensíveis.</p>
                      <% } %>
                    </div>
                  </div>

                  <% if (pushStateForSection) { %>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 space-y-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Sem pegadinha</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">O que está controlado aqui</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Infraestrutura, agenda compartilhada e famílias automáticas ficaram separadas para ninguém precisar ler mente do sistema.</p>
                      </div>
                      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 px-4 py-4 text-sm font-medium text-slate-600 dark:text-slate-300 space-y-3">
                        <p><span class="font-black text-slate-900 dark:text-white">Push web:</span> <%= pushStateForSection.infrastructure.status %>.</p>
                        <p><span class="font-black text-slate-900 dark:text-white">Agenda:</span> <%= pushStateForSection.schedule.label %> com varredura a cada <%= pushStateForSection.schedule.checkIntervalMinutes %> min.</p>
                        <p><span class="font-black text-slate-900 dark:text-white">Rotinas ativas:</span> <%= pushStateForSection.activeCount %> de <%= pushStateForSection.totalCount %>.</p>
                      </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 space-y-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-emerald-500 dark:text-emerald-300">Teste operacional</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Quer ouvir o sininho?</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Os testes de push continuam no catálogo de mensagens. Assim você valida o canal sem misturar com regra de agendamento.</p>
                      </div>
                      <a href="<%= pushStateForSection.pushTestHref %>" class="inline-flex w-full items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200 dark:hover:bg-emerald-950/40">Abrir catálogo de mensagens</a>
                    </div>

                    <% if (!pushStateForSection.infrastructure.configured) { %>
                      <div class="rounded-2xl border border-amber-200 bg-amber-50/90 p-5 text-sm font-medium leading-relaxed text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-100">
                        Sem VAPID completo, o navegador não recebe push web. Já as rotinas de <span class="font-black">Datas do mês</span> e <span class="font-black">Datas combinadas</span> continuam podendo gerar aviso interno no app.
                      </div>
                    <% } %>
                  <% } %>

                  <% if (section.key === 'email' && emailState) { %>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 space-y-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-emerald-500 dark:text-emerald-300">Ações</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Teste de e-mail</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Valide a conexão SMTP e envie um teste sem sair da seção.</p>
                      </div>

                      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 px-4 py-4 text-sm font-medium text-slate-600 dark:text-slate-300 space-y-3">
                        <div>
                          <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Remetente</div>
                          <div class="mt-1 break-all"><%= emailState.fromLabel %></div>
                        </div>
                        <div>
                          <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Link de entrada</div>
                          <div class="mt-1 break-all"><%= emailState.loginUrl || '/login' %></div>
                        </div>
                      </div>

                      <form action="/admin/email/test-connection" method="POST">
                        <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-blue-500 dark:hover:bg-blue-400">
                          Testar conexão SMTP
                        </button>
                      </form>

                      <form action="/admin/email/send-test" method="POST" class="space-y-3">
                        <label class="block">
                          <span class="block text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Destino do teste</span>
                          <input type="email" name="test_recipient_email" value="<%= emailState.testRecipient || '' %>" required
                            class="mt-2 w-full rounded-2xl border border-slate-300 dark:border-slate-600 px-4 py-3 bg-slate-50 dark:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all text-sm font-medium text-slate-800 dark:text-slate-100">
                        </label>
                        <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200 dark:hover:bg-emerald-950/40">
                          Enviar e-mail de teste
                        </button>
                      </form>
                    </div>
                  <% } %>
                </aside>
              </div>

              <% if (section.key === 'email' && emailState) { %>
                <div class="border-t border-slate-100 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/20 p-6 sm:p-8">
                  <details class="group rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5" <%= emailState.recentEvents && emailState.recentEvents.length > 0 ? '' : '' %>>
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Histórico</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Últimos envios de e-mail</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Mantido recolhido para não poluir a leitura principal da configuração.</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300 group-open:bg-blue-50 group-open:text-blue-700 dark:group-open:bg-blue-950/30 dark:group-open:text-blue-200"><%= emailState.recentEvents && emailState.recentEvents.length ? `${emailState.recentEvents.length} registro(s)` : 'Sem registros' %></span>
                    </summary>
                    <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                      <table class="w-full min-w-[900px] text-sm text-left">
                        <thead class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
                          <tr>
                            <th class="px-4 py-4 text-center">Quando</th>
                            <th class="px-4 py-4 text-center">Tipo</th>
                            <th class="px-4 py-4 text-center">Destino</th>
                            <th class="px-4 py-4 text-center">Status</th>
                            <th class="px-4 py-4 text-center">Resumo</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                          <% if (emailState.recentEvents && emailState.recentEvents.length > 0) { %>
                            <% emailState.recentEvents.forEach((event) => { %>
                              <tr class="align-top hover:bg-slate-50/70 dark:hover:bg-slate-700/30 transition-colors">
                                <td class="px-4 py-4 text-slate-700 dark:text-slate-200 font-semibold whitespace-nowrap"><%= event.createdAtLabel %></td>
                                <td class="px-4 py-4 text-slate-600 dark:text-slate-300"><%= event.kind === 'test' ? 'Teste' : 'Boas-vindas' %></td>
                                <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                                  <div class="font-bold text-slate-800 dark:text-white"><%= event.targetName %></div>
                                  <div class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= event.recipient_email %></div>
                                </td>
                                <td class="px-4 py-4 text-center">
                                  <% const eventTone = toneBadgeClasses[event.statusTone || 'muted'] || toneBadgeClasses.muted; %>
                                  <span class="inline-flex min-w-[118px] items-center justify-center px-2.5 py-1 rounded-lg text-xs font-bold border <%= eventTone %>"><%= event.statusLabel %></span>
                                </td>
                                <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                                  <div><%= event.subject %></div>
                                  <% if (event.errorMessage) { %>
                                    <div class="mt-2 text-xs font-medium text-amber-700 dark:text-amber-300"><%= event.errorMessage %></div>
                                  <% } else if (event.sentAtLabel) { %>
                                    <div class="mt-2 text-xs font-medium text-slate-500 dark:text-slate-400">Saiu em <%= event.sentAtLabel %></div>
                                  <% } %>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="5" class="px-4 py-8 text-center text-sm font-medium text-slate-500 dark:text-slate-400">Ainda nenhum e-mail apareceu por aqui.</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </details>
                </div>
              <% } %>

              <% if (section.key === 'backup' && backupState) { %>
                <div class="border-t border-slate-100 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/20 p-6 sm:p-8 space-y-6">
                  <div class="grid gap-4 xl:grid-cols-3">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5">
                      <div class="text-xs font-black uppercase tracking-[0.18em] text-emerald-500 dark:text-emerald-300">Rotina</div>
                      <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Agendamento</h3>
                      <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                        <span class="font-black text-slate-900 dark:text-white"><%= backupState.frequencyLabel %></span>
                        <% if (backupState.config.enabled && backupState.config.frequency !== 'manual') { %>
                          • próxima execução em <span class="font-black text-slate-900 dark:text-white"><%= backupState.nextRunAtLabel %></span>
                        <% } else { %>
                          • automação desativada; somente execução manual.
                        <% } %>
                      </p>
                      <div class="mt-4 flex flex-wrap gap-2 text-xs font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
                        <span class="rounded-full border border-slate-200 dark:border-slate-700 px-3 py-1"><%= backupState.config.timeZone %></span>
                        <span class="rounded-full border border-slate-200 dark:border-slate-700 px-3 py-1">Guarda <%= backupState.keepCountLabel %></span>
                      </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5">
                      <div class="text-xs font-black uppercase tracking-[0.18em] text-sky-500 dark:text-sky-300">Armazenamento local</div>
                      <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Duas cópias no servidor</h3>
                      <div class="mt-4 space-y-3 text-sm font-medium text-slate-600 dark:text-slate-300">
                        <div>
                          <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Principal</div>
                          <code class="mt-1 block text-xs sm:text-sm break-all text-slate-700 dark:text-slate-200"><%= backupState.localPrimaryDisplay %></code>
                        </div>
                        <div>
                          <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Espelho</div>
                          <code class="mt-1 block text-xs sm:text-sm break-all text-slate-700 dark:text-slate-200"><%= backupState.localSecondaryDisplay %></code>
                        </div>
                      </div>
                    </div>

                    <div class="rounded-2xl border <%= backupState.googleConnected ? 'border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/60 dark:bg-emerald-950/20' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800' %> p-5">
                      <div class="text-xs font-black uppercase tracking-[0.18em] <%= backupState.googleConnected ? 'text-emerald-600 dark:text-emerald-300' : 'text-violet-500 dark:text-violet-300' %>">Google Drive</div>
                      <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= backupState.googleConnected ? 'Conta conectada' : 'Conexão pendente' %></h3>
                      <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                        <% if (backupState.googleConnected) { %>
                          <span class="font-black text-slate-900 dark:text-white"><%= backupState.googleEmail || 'Conta conectada' %></span>
                          <% if (backupState.googleFolderName) { %>
                            • pasta <span class="font-black text-slate-900 dark:text-white"><%= backupState.googleFolderName %></span>
                          <% } %>
                        <% } else if (backupState.googleReadyForAuth) { %>
                          O login do Google já está configurado. Falta conectar a conta que receberá os backups em nuvem.
                        <% } else { %>
                          Salve primeiro o Client ID, o Client Secret e a URL de retorno do Google para habilitar a conexão.
                        <% } %>
                      </p>
                      <% if (backupState.googleRedirectUri) { %>
                        <div class="mt-4 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-900/50 px-4 py-3">
                          <div class="text-[11px] font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Redirect URI do backup</div>
                          <code class="mt-2 block text-[11px] sm:text-xs break-all text-slate-700 dark:text-slate-200"><%= backupState.googleRedirectUri %></code>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="grid gap-6 xl:grid-cols-[minmax(0,1.1fr),minmax(0,0.9fr)]">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 space-y-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-blue-500 dark:text-blue-300">Ações rápidas</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Ações operacionais</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Reúne as ações principais de backup e a documentação associada.</p>
                      </div>

                      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        <form action="/admin/backup/run" method="POST">
                          <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-blue-500 dark:hover:bg-blue-400">
                            Executar backup agora
                          </button>
                        </form>

                        <a href="<%= backupState.guideUrl %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-700 px-4 py-3 text-sm font-black text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-900/40 transition">
                          Abrir guia completo
                        </a>

                        <% if (backupState.googleConnected) { %>
                          <form action="/admin/backup/google/disconnect" method="POST">
                            <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-black text-amber-700 transition hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200 dark:hover:bg-amber-950/40">
                              Desconectar Google
                            </button>
                          </form>
                        <% } else if (backupState.googleReadyForAuth) { %>
                          <a href="/admin/backup/google/connect" class="inline-flex items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200 dark:hover:bg-emerald-950/40">
                            Conectar Google Drive
                          </a>
                        <% } else { %>
                          <div class="inline-flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-700 px-4 py-3 text-sm font-black text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-900/30">
                            Configure o Google primeiro
                          </div>
                        <% } %>
                      </div>

                      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 px-4 py-4 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300">
                        O arquivo é gerado com manifesto próprio do AcerttaPay, duas cópias locais e, quando a nuvem está conectada, uma cópia adicional no Google Drive.
                      </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 space-y-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-rose-500 dark:text-rose-300">Restauração</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Restaurar backup</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Envie um <code>.zip</code> gerado pelo próprio AcerttaPay. Antes da restauração, o sistema cria uma cópia de segurança adicional.</p>
                      </div>

                      <form action="/admin/backup/restore" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <label class="block rounded-2xl border border-dashed border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900/40 px-4 py-4">
                          <span class="block text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Arquivo do backup</span>
                          <input type="file" name="backup_zip" accept=".zip,application/zip" required
                            class="mt-3 block w-full text-sm font-medium text-slate-700 dark:text-slate-200 file:mr-4 file:rounded-xl file:border-0 file:bg-slate-900 file:px-4 file:py-2 file:text-sm file:font-black file:text-white hover:file:bg-slate-800 dark:file:bg-blue-500 dark:hover:file:bg-blue-400">
                        </label>
                        <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl bg-rose-600 px-4 py-3 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-rose-700 dark:bg-rose-500 dark:hover:bg-rose-400">
                          Restaurar backup selecionado
                        </button>
                      </form>
                    </div>
                  </div>

                  <details class="group rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Histórico</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Histórico de backups</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Os links locais aparecem quando o arquivo ainda está disponível no servidor. Esta caixa mostra só os 8 backups mais recentes.</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300"><%= backupState.recentRuns && backupState.recentRuns.length ? `Últimos ${backupState.recentRuns.length}` : 'Sem histórico' %></span>
                    </summary>
                    <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                      <table class="w-full min-w-[980px] text-sm text-left">
                        <thead class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
                          <tr>
                            <th class="px-4 py-4 text-center">Quando</th>
                            <th class="px-4 py-4 text-center">Origem</th>
                            <th class="px-4 py-4 text-center">Status</th>
                            <th class="px-4 py-4 text-center">Tamanho</th>
                            <th class="px-4 py-4 text-center">Arquivos</th>
                            <th class="px-4 py-4 text-center">Resumo</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                          <% if (backupState.recentRuns && backupState.recentRuns.length > 0) { %>
                            <% backupState.recentRuns.forEach((run) => { %>
                              <tr class="align-top hover:bg-slate-50/70 dark:hover:bg-slate-700/30 transition-colors">
                                <td class="px-4 py-4 text-slate-700 dark:text-slate-200 font-semibold whitespace-nowrap"><%= run.startedAtLabel %></td>
                                <td class="px-4 py-4 text-slate-600 dark:text-slate-300"><%= run.triggerLabel %></td>
                                <td class="px-4 py-4 text-center">
                                  <span class="inline-flex min-w-[118px] items-center justify-center rounded-xl px-3 py-1 text-xs font-black border <%= run.statusTone === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200' : run.statusTone === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200' : 'border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300' %>">
                                    <%= run.status === 'success' ? 'Sucesso' : run.status === 'warning' ? 'Com aviso' : 'Falhou' %>
                                  </span>
                                </td>
                                <td class="px-4 py-4 text-center font-semibold text-slate-700 dark:text-slate-200"><%= run.sizeLabel %></td>
                                <td class="px-4 py-4">
                                  <div class="flex flex-wrap justify-center gap-2">
                                    <% if (run.localPrimaryAvailable) { %>
                                      <a href="/admin/backup/download/<%= run.id %>/primary" class="inline-flex items-center rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-black text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-900/40">Local 1</a>
                                    <% } %>
                                    <% if (run.localSecondaryAvailable) { %>
                                      <a href="/admin/backup/download/<%= run.id %>/secondary" class="inline-flex items-center rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-black text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-900/40">Local 2</a>
                                    <% } %>
                                    <% if (run.googleAvailable && run.googleViewLink) { %>
                                      <a href="<%= run.googleViewLink %>" target="_blank" rel="noreferrer" class="inline-flex items-center rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-black text-emerald-700 hover:bg-emerald-100 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200 dark:hover:bg-emerald-950/40">Google</a>
                                    <% } %>
                                    <% if (!run.localPrimaryAvailable && !run.localSecondaryAvailable && !run.googleAvailable) { %>
                                      <span class="inline-flex items-center rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-black text-slate-400 dark:text-slate-500">Sem arquivo disponível</span>
                                    <% } %>
                                  </div>
                                </td>
                                <td class="px-4 py-4 text-slate-600 dark:text-slate-300"><%= run.message %></td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="px-4 py-8 text-center text-sm font-medium text-slate-500 dark:text-slate-400">Ainda nenhum backup passou por aqui.</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </details>

                  <details class="group rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
                      <div>
                        <div class="text-xs font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Últimas restaurações</div>
                        <h3 class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">Histórico de restaurações</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Aqui ficam só as 6 restaurações mais recentes, para a área não virar um varal infinito.</p>
                      </div>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300"><%= backupState.recentRestores && backupState.recentRestores.length ? `Últimas ${backupState.recentRestores.length}` : 'Sem histórico' %></span>
                    </summary>
                    <div class="mt-5 grid gap-4 lg:grid-cols-2">
                      <% if (backupState.recentRestores && backupState.recentRestores.length > 0) { %>
                        <% backupState.recentRestores.forEach((restore) => { %>
                          <div class="rounded-2xl border <%= restore.statusTone === 'success' ? 'border-emerald-200 bg-emerald-50/60 dark:border-emerald-900/60 dark:bg-emerald-950/20' : restore.statusTone === 'warning' ? 'border-amber-200 bg-amber-50/60 dark:border-amber-900/60 dark:bg-amber-950/20' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800' %> p-5">
                            <div class="flex items-start justify-between gap-3">
                              <div>
                                <div class="text-xs font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500"><%= restore.startedAtLabel %></div>
                                <h4 class="mt-2 text-base font-black tracking-tight text-slate-900 dark:text-white"><%= restore.backup_name || restore.uploaded_filename || 'Backup restaurado' %></h4>
                              </div>
                              <span class="rounded-full border border-current/20 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] <%= restore.statusTone === 'success' ? 'text-emerald-700 dark:text-emerald-200' : restore.statusTone === 'warning' ? 'text-amber-700 dark:text-amber-200' : 'text-slate-600 dark:text-slate-300' %>"><%= restore.status === 'success' ? 'Sucesso' : restore.status === 'warning' ? 'Aviso' : 'Falhou' %></span>
                            </div>
                            <p class="mt-3 text-sm font-medium leading-relaxed text-slate-600 dark:text-slate-300"><%= restore.message || 'Sem recado extra nesta restauração.' %></p>
                          </div>
                        <% }) %>
                      <% } else { %>
                        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-600 bg-white/70 dark:bg-slate-900/30 p-5 text-sm font-medium text-slate-500 dark:text-slate-400 lg:col-span-2">
                          Nenhuma restauração registrada até o momento.
                        </div>
                      <% } %>
                    </div>
                  </details>
                </div>
              <% } %>
            </section>
          <% }) %>
        </section>
      <% }) %>
    </div>
  </div>
</div>

<div id="addUserModal" class="op-admin-access-modal hidden fixed inset-0 z-[72] bg-slate-900/60 backdrop-blur-sm p-3 sm:p-4 md:p-6" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
  <div class="op-admin-access-modal__panel bg-white dark:bg-slate-800 rounded-2xl p-5 sm:p-6 w-full max-w-4xl shadow-2xl border border-slate-200 dark:border-slate-700" data-dialog-surface onclick="event.stopPropagation()">
    <div class="op-admin-access-modal__header flex justify-between items-start gap-4 mb-6">
      <div>
        <h2 id="userModalTitle" class="text-xl font-black text-slate-800 dark:text-white">Novo acesso</h2>
        <p id="userModalDescription" class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Esse e-mail poderá acessar o aplicativo com a conta Google correspondente.</p>
      </div>
      <button type="button" onclick="closeAddUserModal()" class="op-icon-btn" aria-label="Fechar janela">✕</button>
    </div>

    <form id="userForm" action="/admin/add-user" method="POST" class="op-admin-access-form">
      <div class="op-admin-access-field op-admin-access-field--email">
        <label for="email" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">E-mail do Google</label>
        <input type="email" id="email" name="email" required placeholder="exemplo@gmail.com"
          class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
      </div>

      <div class="op-admin-access-field op-admin-access-field--name">
        <label for="name" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Nome (opcional)</label>
        <input type="text" id="name" name="name" placeholder="Nome da pessoa"
          class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
        <p class="text-xs font-medium text-slate-400 mt-2">Se ficar em branco, o nome será preenchido a partir do e-mail.</p>
      </div>

      <div class="op-admin-access-field op-admin-access-field--role">
        <label for="role" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Nível de acesso</label>
        <select id="role" name="role"
          class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
          <option value="user" selected>Usuário (usa o app)</option>
          <option value="admin">Administrador (app + painel)</option>
        </select>
      </div>

      <label class="op-admin-access-card op-admin-access-card--import flex flex-wrap items-start gap-4 rounded-[24px] border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-4 cursor-pointer transition hover:border-slate-300 hover:shadow-sm dark:hover:border-slate-600">
        <input type="checkbox" id="can_import" name="can_import" value="1" checked
          class="peer sr-only">
        <span class="min-w-0 flex-1 basis-full sm:basis-auto">
          <span class="block text-sm font-black text-slate-800 dark:text-white">Permitir importação de fatura</span>
          <span class="mt-1 block text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Desative para ocultar os recursos de importação para esse usuário.</span>
        </span>
        <span class="sm:ml-auto inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-2 text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 before:content-['Bloqueada'] peer-checked:border-blue-200 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:before:content-['Liberada'] dark:peer-checked:border-blue-900/60 dark:peer-checked:bg-blue-950/40 dark:peer-checked:text-blue-200 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-100 dark:peer-focus-visible:ring-blue-900/40"></span>
        <span aria-hidden="true" class="relative inline-flex h-8 w-14 shrink-0 rounded-full border border-slate-300 bg-slate-200 shadow-inner transition duration-200 ease-out after:absolute after:left-1 after:top-1 after:h-6 after:w-6 after:rounded-full after:bg-white after:shadow-sm after:transition after:duration-200 after:ease-out after:content-[''] peer-checked:border-blue-600 peer-checked:bg-blue-600 peer-checked:after:translate-x-6 dark:border-slate-600 dark:bg-slate-700 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-500 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-100 dark:peer-focus-visible:ring-blue-900/40"></span>
      </label>

      <div id="welcomeEmailControls" class="op-admin-access-stack">
        <label class="op-admin-access-card op-admin-access-card--welcome flex flex-wrap items-start gap-4 rounded-[24px] border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-4 cursor-pointer transition hover:border-slate-300 hover:shadow-sm dark:hover:border-slate-600 <%= emailState && emailState.active ? '' : 'opacity-70 cursor-not-allowed' %>">
          <input type="checkbox" id="send_welcome_email" name="send_welcome_email" value="1" <%= emailState && emailState.active ? 'checked' : '' %> <%= emailState && emailState.active ? '' : 'disabled' %>
            class="peer sr-only">
          <span class="min-w-0 flex-1 basis-full sm:basis-auto">
            <span class="block text-sm font-black text-slate-800 dark:text-white">Enviar e-mail de boas-vindas</span>
            <span class="mt-1 block text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">
              Esse envio não cria senha. O acesso continua sendo feito com a conta Google vinculada a este e-mail.
              <% if (!(emailState && emailState.active)) { %>
                Para habilitar esse envio, conclua a configuração SMTP na seção de e-mail.
              <% } %>
            </span>
          </span>
          <span class="sm:ml-auto inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-2 text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 before:content-['Pausado'] peer-checked:border-blue-200 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:before:content-['Envia'] dark:peer-checked:border-blue-900/60 dark:peer-checked:bg-blue-950/40 dark:peer-checked:text-blue-200 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-100 dark:peer-focus-visible:ring-blue-900/40 peer-disabled:opacity-60"></span>
          <span aria-hidden="true" class="relative inline-flex h-8 w-14 shrink-0 rounded-full border border-slate-300 bg-slate-200 shadow-inner transition duration-200 ease-out after:absolute after:left-1 after:top-1 after:h-6 after:w-6 after:rounded-full after:bg-white after:shadow-sm after:transition after:duration-200 after:ease-out after:content-[''] peer-checked:border-blue-600 peer-checked:bg-blue-600 peer-checked:after:translate-x-6 dark:border-slate-600 dark:bg-slate-700 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-500 peer-focus-visible:ring-4 peer-focus-visible:ring-blue-100 dark:peer-focus-visible:ring-blue-900/40 peer-disabled:opacity-60"></span>
        </label>

        <label class="op-admin-access-field op-admin-access-field--message block rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3">
          <span class="block text-xs font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Mensagem adicional do administrador (opcional)</span>
          <textarea id="welcome_admin_message" name="welcome_admin_message" rows="3" maxlength="280" placeholder="Inclua uma observação curta para acompanhar o convite, se necessário."
            class="mt-3 w-full rounded-2xl border border-slate-300 dark:border-slate-600 px-4 py-3 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all text-sm font-medium text-slate-800 dark:text-slate-100"></textarea>
        </label>
      </div>

      <div class="op-admin-access-actions flex flex-col sm:flex-row gap-3 pt-2">
        <button type="button" onclick="closeAddUserModal()"
          class="flex-1 px-5 py-3 rounded-xl font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">
          Cancelar
        </button>
        <button type="submit"
          class="flex-1 px-5 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
          <span id="userModalSubmitLabel">Salvar acesso</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const addUserModal = document.getElementById('addUserModal');
  const userForm = document.getElementById('userForm');
  const userModalTitle = document.getElementById('userModalTitle');
  const userModalDescription = document.getElementById('userModalDescription');
  const userModalSubmitLabel = document.getElementById('userModalSubmitLabel');
  const emailField = document.getElementById('email');
  const nameField = document.getElementById('name');
  const roleField = document.getElementById('role');
  const canImportField = document.getElementById('can_import');
  const sendWelcomeEmailField = document.getElementById('send_welcome_email');
  const welcomeAdminMessageField = document.getElementById('welcome_admin_message');
  const welcomeEmailControls = document.getElementById('welcomeEmailControls');
  const emailWelcomeAvailable = <%- JSON.stringify(!!(emailState && emailState.active)) %>;
  const defaultLoginUrl = <%- JSON.stringify(emailState && emailState.loginUrl ? emailState.loginUrl : '/login') %>;
  const activeAdminSection = <%- JSON.stringify(activeSectionKey) %>;

  function setUserModalOpenState(isOpen) {
    document.documentElement.classList.toggle('op-admin-access-modal-open', isOpen);
    document.body?.classList.toggle('op-admin-access-modal-open', isOpen);
  }

  function setWelcomeControlsVisible(isVisible) {
    if (welcomeEmailControls) {
      welcomeEmailControls.classList.toggle('hidden', !isVisible);
    }
    if (userForm) {
      userForm.classList.toggle('op-admin-access-form--welcome-hidden', !isVisible);
    }
  }

  function normalizeAdminText(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function configureUserModalForAdd() {
    if (!userForm) return;
    userForm.action = '/admin/add-user';
    userModalTitle.textContent = 'Novo acesso';
    userModalDescription.textContent = 'Esse e-mail poderá acessar o aplicativo com a conta Google correspondente.';
    userModalSubmitLabel.textContent = 'Salvar acesso';
    emailField.value = '';
    nameField.value = '';
    roleField.value = 'user';
    canImportField.checked = true;
    setWelcomeControlsVisible(true);
    if (sendWelcomeEmailField) {
      sendWelcomeEmailField.checked = !!emailWelcomeAvailable;
      sendWelcomeEmailField.disabled = !emailWelcomeAvailable;
    }
    if (welcomeAdminMessageField) {
      welcomeAdminMessageField.value = '';
      welcomeAdminMessageField.disabled = false;
    }
  }

  function openAddUserModal() {
    configureUserModalForAdd();
    addUserModal.classList.remove('hidden');
    setUserModalOpenState(true);
  }

  function openEditUserModal(button) {
    if (!button || !userForm) return;
    userForm.action = `/admin/update-user/${button.dataset.userId}`;
    userModalTitle.textContent = 'Editar acesso';
    userModalDescription.textContent = 'Atualize os dados e as permissões desse usuário.';
    userModalSubmitLabel.textContent = 'Salvar alterações';
    emailField.value = button.dataset.userEmail || '';
    nameField.value = button.dataset.userName || '';
    roleField.value = button.dataset.userRole || 'user';
    canImportField.checked = button.dataset.userCanImport === '1';
    setWelcomeControlsVisible(false);
    if (sendWelcomeEmailField) {
      sendWelcomeEmailField.checked = false;
    }
    if (welcomeAdminMessageField) {
      welcomeAdminMessageField.value = '';
    }
    addUserModal.classList.remove('hidden');
    setUserModalOpenState(true);
  }

  function closeAddUserModal() {
    addUserModal.classList.add('hidden');
    setUserModalOpenState(false);
    configureUserModalForAdd();
  }

  addUserModal?.addEventListener('click', (event) => {
    if (event.target === addUserModal) {
      closeAddUserModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && addUserModal && !addUserModal.classList.contains('hidden')) {
      closeAddUserModal();
    }
  });

  document.querySelectorAll('[data-secret-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const input = button.parentElement?.querySelector('input');
      if (!input) return;
      const revealing = input.type === 'password';
      input.type = revealing ? 'text' : 'password';
      button.textContent = revealing ? 'Esconder' : 'Mostrar';
    });
  });

  document.querySelectorAll('[data-copy-login-url]').forEach((button) => {
    button.addEventListener('click', async () => {
      const loginUrl = button.dataset.loginUrl || defaultLoginUrl;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(loginUrl);
        } else {
          const helper = document.createElement('textarea');
          helper.value = loginUrl;
          document.body.appendChild(helper);
          helper.select();
          document.execCommand('copy');
          helper.remove();
        }
        const previous = button.textContent;
        button.textContent = 'Link copiado';
        setTimeout(() => {
          button.textContent = previous;
        }, 1800);
      } catch (_error) {
        window.prompt('Copie este link:', loginUrl);
      }
    });
  });

  const adminNavLinks = Array.from(document.querySelectorAll('[data-admin-nav-link]'));
  const adminSections = Array.from(document.querySelectorAll('[id^="admin-section-"]'));
  const adminNavGroups = Array.from(document.querySelectorAll('[data-admin-nav-group]'));
  const adminGroupContainers = Array.from(document.querySelectorAll('[data-admin-group-container]'));
  const adminSearchInput = document.querySelector('[data-admin-search-input]');
  const adminSearchTargets = Array.from(document.querySelectorAll('[data-admin-search-target]'));
  const adminNavActiveClasses = ['border-slate-900', 'bg-slate-900', 'text-white', 'shadow-sm', 'dark:border-slate-100', 'dark:bg-slate-100', 'dark:text-slate-900'];
  const adminNavInactiveClasses = ['border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-900/30', 'dark:text-slate-200'];
  const adminNavDotActiveClasses = ['bg-white/80', 'dark:bg-slate-900'];
  const adminNavDotInactiveClasses = ['bg-slate-300', 'dark:bg-slate-600'];

  function setAdminNavActive(activeKey) {
    if (!activeKey) return;
    adminNavLinks.forEach((link) => {
      const isActive = link.dataset.adminNavKey === activeKey;
      link.classList.toggle('hover:border-slate-300', !isActive);
      link.classList.toggle('hover:bg-slate-50', !isActive);
      link.classList.toggle('dark:hover:border-slate-600', !isActive);
      link.classList.toggle('dark:hover:bg-slate-900/50', !isActive);
      adminNavActiveClasses.forEach((className) => link.classList.toggle(className, isActive));
      adminNavInactiveClasses.forEach((className) => link.classList.toggle(className, !isActive));
      link.setAttribute('aria-current', isActive ? 'location' : 'false');
      const dot = link.querySelector('[data-admin-nav-dot]');
      if (dot) {
        adminNavDotActiveClasses.forEach((className) => dot.classList.toggle(className, isActive));
        adminNavDotInactiveClasses.forEach((className) => dot.classList.toggle(className, !isActive));
      }
    });
  }

  function syncAdminNavWithViewport() {
    const visibleSections = adminSections.filter((section) => !section.hidden);
    if (!visibleSections.length) return;
    const viewportAnchor = Math.max(132, Math.min(window.innerHeight * 0.24, 220));
    let currentSection = visibleSections[0];

    visibleSections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      if (rect.top - viewportAnchor <= 0) {
        currentSection = section;
      }
    });

    const activeKeyFromViewport = currentSection.id.replace('admin-section-', '');
    setAdminNavActive(activeKeyFromViewport);
  }

  let adminNavTicking = false;
  function requestAdminNavSync() {
    if (adminNavTicking) return;
    adminNavTicking = true;
    window.requestAnimationFrame(() => {
      syncAdminNavWithViewport();
      adminNavTicking = false;
    });
  }

  function updateAdminGroupVisibility() {
    adminGroupContainers.forEach((group) => {
      const hasVisibleSection = Array.from(group.querySelectorAll('[data-admin-search-target]')).some((section) => !section.hidden);
      group.hidden = !hasVisibleSection;
    });

    adminNavGroups.forEach((group) => {
      const hasVisibleLink = Array.from(group.querySelectorAll('[data-admin-nav-link]')).some((link) => !link.hidden);
      group.hidden = !hasVisibleLink;
    });
  }

  function applyAdminSearch() {
    const query = normalizeAdminText(adminSearchInput?.value || '');

    adminSearchTargets.forEach((section) => {
      const haystack = normalizeAdminText(section.dataset.adminSearch || '');
      const isMatch = !query || haystack.includes(query);
      section.hidden = !isMatch;
      const key = section.id.replace('admin-section-', '');
      const link = adminNavLinks.find((item) => item.dataset.adminNavKey === key);
      if (link) {
        link.hidden = !isMatch;
      }
    });

    updateAdminGroupVisibility();
    requestAdminNavSync();
  }

  adminSearchInput?.addEventListener('input', applyAdminSearch);

  adminNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setAdminNavActive(link.dataset.adminNavKey || 'overview');
      window.setTimeout(requestAdminNavSync, 180);
    });
  });

  window.addEventListener('scroll', requestAdminNavSync, { passive: true });
  window.addEventListener('resize', requestAdminNavSync);

  const accessSearchInput = document.querySelector('[data-access-search-input]');
  const accessRoleFilter = document.querySelector('[data-access-role-filter]');
  const accessSortSelect = document.querySelector('[data-access-sort]');
  const accessPageSizeSelect = document.querySelector('[data-access-page-size]');
  const accessPrevButton = document.querySelector('[data-access-prev]');
  const accessNextButton = document.querySelector('[data-access-next]');
  const accessPageIndicator = document.querySelector('[data-access-page-indicator]');
  const accessPageSummary = document.querySelector('[data-access-page-summary]');
  const accessResults = document.querySelector('[data-access-results]');
  const accessRows = Array.from(document.querySelectorAll('[data-access-row]'));
  const accessTableBody = document.querySelector('[data-access-table-body]');
  const accessEmptyRow = document.querySelector('[data-access-empty]');
  let accessPage = 1;

  function getAccessPageSize() {
    const value = Number(accessPageSizeSelect?.value || 25);
    return Number.isFinite(value) && value > 0 ? value : 25;
  }

  function compareAccessRows(a, b, sortValue) {
    switch (sortValue) {
      case 'created-asc':
        return Number(a.dataset.accessCreatedAt || 0) - Number(b.dataset.accessCreatedAt || 0);
      case 'created-desc':
        return Number(b.dataset.accessCreatedAt || 0) - Number(a.dataset.accessCreatedAt || 0);
      case 'last-login-desc': {
        const diff = Number(b.dataset.accessLastLogin || 0) - Number(a.dataset.accessLastLogin || 0);
        if (diff !== 0) return diff;
        return normalizeAdminText(a.dataset.accessName || '').localeCompare(normalizeAdminText(b.dataset.accessName || ''), 'pt-BR');
      }
      case 'role-desc': {
        const roleDiff = Number(b.dataset.accessRoleRank || 0) - Number(a.dataset.accessRoleRank || 0);
        if (roleDiff !== 0) return roleDiff;
        return normalizeAdminText(a.dataset.accessName || '').localeCompare(normalizeAdminText(b.dataset.accessName || ''), 'pt-BR');
      }
      case 'name-asc':
      default:
        return normalizeAdminText(a.dataset.accessName || '').localeCompare(normalizeAdminText(b.dataset.accessName || ''), 'pt-BR');
    }
  }

  function applyAccessFilters() {
    if (!accessRows.length) return;

    const query = normalizeAdminText(accessSearchInput?.value || '');
    const role = accessRoleFilter?.value || 'all';
    const sortValue = accessSortSelect?.value || 'name-asc';
    const pageSize = getAccessPageSize();

    const filteredRows = accessRows.filter((row) => {
      const haystack = normalizeAdminText(row.dataset.accessSearch || '');
      const roleMatch = role === 'all'
        || (role === 'pending' && row.dataset.accessWelcome === 'pending')
        || (role === 'never' && row.dataset.accessNever === '1')
        || row.dataset.accessRole === role;
      const textMatch = !query || haystack.includes(query);
      return roleMatch && textMatch;
    }).sort((a, b) => compareAccessRows(a, b, sortValue));

    if (accessTableBody) {
      filteredRows.forEach((row) => accessTableBody.appendChild(row));
      if (accessEmptyRow) accessTableBody.appendChild(accessEmptyRow);
    }

    const total = filteredRows.length;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (accessPage > totalPages) accessPage = totalPages;
    if (accessPage < 1) accessPage = 1;

    const start = (accessPage - 1) * pageSize;
    const pageRows = filteredRows.slice(start, start + pageSize);

    accessRows.forEach((row) => {
      row.hidden = !pageRows.includes(row);
    });

    if (accessEmptyRow) {
      accessEmptyRow.hidden = total !== 0;
    }

    if (accessResults) {
      accessResults.textContent = `${total} resultado(s)`;
    }

    if (accessPageIndicator) {
      accessPageIndicator.textContent = `Página ${total ? accessPage : 1} de ${totalPages}`;
    }

    if (accessPageSummary) {
      accessPageSummary.textContent = total
        ? `Exibindo ${start + 1}-${Math.min(start + pageRows.length, total)} de ${total} resultado(s).`
        : 'Nenhum usuário corresponde aos filtros atuais.';
    }

    if (accessPrevButton) accessPrevButton.disabled = accessPage <= 1 || total === 0;
    if (accessNextButton) accessNextButton.disabled = accessPage >= totalPages || total === 0;
  }

  function resetAccessFilters() {
    accessPage = 1;
    applyAccessFilters();
  }

  accessSearchInput?.addEventListener('input', resetAccessFilters);
  accessRoleFilter?.addEventListener('change', resetAccessFilters);
  accessSortSelect?.addEventListener('change', resetAccessFilters);
  accessPageSizeSelect?.addEventListener('change', resetAccessFilters);
  accessPrevButton?.addEventListener('click', () => {
    accessPage -= 1;
    applyAccessFilters();
  });
  accessNextButton?.addEventListener('click', () => {
    accessPage += 1;
    applyAccessFilters();
  });

  window.addEventListener('load', () => {
    configureUserModalForAdd();
    applyAdminSearch();
    applyAccessFilters();

    if (activeAdminSection && activeAdminSection !== 'access') {
      const target = document.getElementById(`admin-section-${activeAdminSection}`);
      if (target && !target.hidden) {
        target.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    }

    requestAdminNavSync();
    window.setTimeout(requestAdminNavSync, 220);
  });
</script>

<%- include("partials/footer") %>
