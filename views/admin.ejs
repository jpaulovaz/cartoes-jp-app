<%- include("partials/header", { title: "OrganizaPay | Administração" }) %>

  <div class="max-w-6xl mx-auto space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Painel de Administração</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-2 font-medium">Gerencie os acessos autorizados e acompanhe o uso do sistema.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <button type="button" onclick="openAddUserModal()"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M18 9v6m3-3h-6m-6 6H5a2 2 0 01-2-2V8a2 2 0 012-2h4l2-2h2l2 2h4a2 2 0 012 2v4"></path>
          </svg>
          Novo Usuário
        </button>

        <a href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 shadow-sm transition-all hover:-translate-y-0.5">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Voltar ao App
        </a>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-2xl border border-red-200 bg-red-50 text-red-700 px-5 py-4 font-medium shadow-sm">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span><%= error %></span>
        </div>
      </div>
      <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 text-emerald-700 px-5 py-4 font-medium shadow-sm">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= success %></span>
            </div>
          </div>
          <% } %>

            <div class="grid gap-8 xl:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
              <section class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Usuários Autorizados</h2>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">
                      <%= users.length %>
                        <%= users.length===1 ? 'usuário cadastrado' : 'usuários cadastrados' %>
                    </p>
                  </div>

                  <button type="button" onclick="openAddUserModal()"
                    class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 4v16m8-8H4"></path>
                    </svg>
                    Adicionar
                  </button>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
                      <tr>
                        <th class="px-4 py-4">Usuário</th>
                        <th class="px-4 py-4">Email</th>
                        <th class="px-4 py-4">Papel</th>
                        <th class="px-4 py-4">Criado em</th>
                        <th class="px-4 py-4">Último acesso</th>
                        <th class="px-4 py-4 text-right">Ações</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% if (users && users.length > 0) { %>
                        <% users.forEach(u => { const isSelf = user && u.id === user.id; %>
                          <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-700/40 transition-colors align-middle">
                            <td class="px-4 py-4">
                              <div class="font-extrabold text-slate-800 dark:text-white"><%= u.name || '-' %></div>
                              <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">ID <%= u.id %></div>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300"><%= u.email %></td>
                            <td class="px-4 py-4">
                              <% if (u.role === 'admin') { %>
                                <span
                                  class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-800">Administrador</span>
                                <% } else { %>
                                  <span
                                    class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600">Usuário</span>
                                  <% } %>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300">
                              <%= u.created_at ? new Date(u.created_at).toLocaleDateString('pt-BR') : '-' %>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap">
                              <%= u.last_login ? new Date(u.last_login).toLocaleString('pt-BR') : 'Nunca acessou' %>
                            </td>
                            <td class="px-4 py-4 text-right">
                              <div class="inline-flex items-center justify-end gap-2 flex-wrap">
                                <% if (isSelf) { %>
                                  <span
                                    class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:border-emerald-800">Você</span>
                                <% } %>
                                <button type="button"
                                  onclick='openEditUserModal(<%- JSON.stringify({ id: u.id, email: u.email || "", name: u.name || "", role: u.role || "user" }) %>)'
                                  class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold border border-blue-200 text-blue-700 hover:bg-blue-50 dark:border-blue-900 dark:text-blue-300 dark:hover:bg-blue-900/20 transition-colors bg-white dark:bg-slate-800 shadow-sm">
                                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                    </path>
                                  </svg>
                                  Editar
                                </button>
                                <% if (!isSelf) { %>
                                  <form action="/admin/remove-user/<%= u.id %>" method="POST" class="inline"
                                    onsubmit="return confirm('Tem certeza que deseja remover este usuário? Ele perderá acesso ao sistema.');">
                                    <button type="submit"
                                      class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold border border-red-200 text-red-600 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-900/20 transition-colors bg-white dark:bg-slate-800 shadow-sm">
                                      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M6 7h12M9 7V4h6v3m-7 4v6m4-6v6m5 2H7a2 2 0 01-2-2V7h14v10a2 2 0 01-2 2z">
                                        </path>
                                      </svg>
                                      Remover
                                    </button>
                                  </form>
                                <% } %>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="6" class="px-4 py-10 text-center text-slate-500 dark:text-slate-400 font-medium">
                                  Nenhum usuário encontrado.
                                </td>
                              </tr>
                              <% } %>
                    </tbody>
                  </table>
                </div>
              </section>

              <aside class="space-y-6">
                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
                  <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Informações do Sistema</h2>
                  <div class="mt-5 space-y-4 text-sm">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Autenticação</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">Google OAuth 2.0</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Isolamento</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">Cada usuário visualiza apenas seus próprios dados</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Titular automático</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">No primeiro login Google é criada uma pessoa titular com o nome do perfil</div>
                    </div>
                  </div>
                </div>

                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
                  <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Como funciona o acesso?</h2>
                  <ol class="mt-5 space-y-3 text-sm font-medium text-slate-600 dark:text-slate-300 list-decimal list-inside">
                    <li>Apenas emails cadastrados nesta lista podem entrar no sistema.</li>
                    <li>No primeiro login com Google, o usuário já ganha uma pessoa titular automaticamente.</li>
                    <li>Usuários com papel <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">admin</code> acessam esta área para gerenciar contas.</li>
                    <li>Usuários com papel <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">user</code> usam apenas as abas do aplicativo.</li>
                  </ol>
                </div>
              </aside>
            </div>
  </div>

  <div id="userModal"
    class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 w-full max-w-lg shadow-2xl border border-slate-200 dark:border-slate-700"
      onclick="event.stopPropagation()">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-xl font-black text-slate-800 dark:text-white" id="userModalTitle">Adicionar Usuário Autorizado</h2>
          <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Esse email poderá entrar no app usando a conta Google correspondente.</p>
        </div>
        <button type="button" onclick="closeUserModal()"
          class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-2xl leading-none">✕</button>
      </div>

      <form id="userForm" action="/admin/add-user" method="POST" class="space-y-4">
        <div>
          <label for="userEmail" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Email do Google</label>
          <input type="email" id="userEmail" name="email" required placeholder="exemplo@gmail.com"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
        </div>

        <div>
          <label for="userName" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Nome (Opcional)</label>
          <input type="text" id="userName" name="name" placeholder="Nome do usuário"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
          <p class="text-xs font-medium text-slate-400 mt-2">Se ficar em branco, usamos a parte anterior ao <code>@</code>.</p>
        </div>

        <div>
          <label for="userRole" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Papel</label>
          <select id="userRole" name="role"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
            <option value="user" selected>Usuário (Apenas app)</option>
            <option value="admin">Administrador (App + Painel Admin)</option>
          </select>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button type="button" onclick="closeUserModal()"
            class="flex-1 px-5 py-3 rounded-xl font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">
            Cancelar
          </button>
          <button type="submit"
            class="flex-1 px-5 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
            <span id="userSubmitText">Adicionar Usuário</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const userModal = document.getElementById('userModal');
    const userForm = document.getElementById('userForm');
    const userModalTitle = document.getElementById('userModalTitle');
    const userSubmitText = document.getElementById('userSubmitText');
    const userEmail = document.getElementById('userEmail');
    const userName = document.getElementById('userName');
    const userRole = document.getElementById('userRole');

    function openAddUserModal() {
      userModalTitle.textContent = 'Adicionar Usuário Autorizado';
      userSubmitText.textContent = 'Adicionar Usuário';
      userForm.action = '/admin/add-user';
      userForm.reset();
      userRole.value = 'user';
      userModal.classList.remove('hidden');
      window.setTimeout(() => userEmail?.focus(), 20);
    }

    function openEditUserModal(userData) {
      userModalTitle.textContent = 'Editar Usuário Autorizado';
      userSubmitText.textContent = 'Salvar Alterações';
      userForm.action = `/admin/update-user/${userData.id}`;
      userEmail.value = userData.email || '';
      userName.value = userData.name || '';
      userRole.value = userData.role === 'admin' ? 'admin' : 'user';
      userModal.classList.remove('hidden');
      window.setTimeout(() => userEmail?.focus(), 20);
    }

    function closeUserModal() {
      userModal.classList.add('hidden');
    }

    userModal?.addEventListener('click', (event) => {
      if (event.target === userModal) {
        closeUserModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && userModal && !userModal.classList.contains('hidden')) {
        closeUserModal();
      }
    });
  </script>

  <%- include("partials/footer") %>
