<%- include("partials/header", { title: "OrganizaPay | Administração" }) %>

  <div class="max-w-6xl mx-auto space-y-8">
    <section class="op-page-hero op-fade-up">
      <div>
        <span class="op-page-hero__eyebrow">Acesso e governança</span>
        <h1 class="op-page-hero__title mt-4">Painel de Administração</h1>
        <p class="op-page-hero__subtitle mt-3">Gerencie os acessos autorizados e acompanhe o uso do sistema.</p>
        <div class="op-page-hero__meta mt-4">
          <span class="badge"><%= users ? users.length : 0 %> usuário(s)</span>
          <span class="badge">Controle de papel e importação</span>
        </div>
      </div>

    </section>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="op-inline-alert op-inline-alert--warning">
        <div class="op-inline-alert__icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <div class="op-inline-alert__title">Atenção</div>
          <div class="op-inline-alert__text"><%= error %></div>
        </div>
      </div>
      <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="op-inline-alert op-inline-alert--success">
            <div class="op-inline-alert__icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div>
              <div class="op-inline-alert__title">Atualização concluída</div>
              <div class="op-inline-alert__text"><%= success %></div>
            </div>
          </div>
          <% } %>

            <div class="space-y-8">
              <section class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Usuários Autorizados</h2>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">
                      <%= users.length %>
                        <%= users.length===1 ? 'usuário cadastrado' : 'usuários cadastrados' %>
                    </p>
                  </div>

                  <button type="button" onclick="openAddUserModal()"
                    class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold text-white bg-blue-600 dark:bg-blue-500 rounded-xl hover:bg-blue-700 dark:hover:bg-blue-600 shadow-sm transition-all hover:-translate-y-0.5">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 4v16m8-8H4"></path>
                    </svg>
                    Adicionar
                  </button>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
                      <tr>
                        <th class="px-4 py-4 text-center">Usuário</th>
                        <th class="px-4 py-4 text-center">Email</th>
                        <th class="px-4 py-4 text-center">Papel</th>
                        <th class="px-4 py-4 text-center">Importação</th>
                        <th class="px-4 py-4 text-center">Criado em</th>
                        <th class="px-4 py-4 text-center">Último acesso</th>
                        <th class="px-4 py-4 text-center">Ações</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% if (users && users.length > 0) { %>
                        <% users.forEach(u => { const isSelf = user && u.id === user.id; %>
                          <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-700/40 transition-colors align-middle">
                            <td class="px-4 py-4">
                              <div class="font-extrabold text-slate-800 dark:text-white"><%= u.name || '-' %></div>
                              <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">ID <%= u.id %></div>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300"><%= u.email %></td>
                            <td class="px-4 py-4">
                              <% if (u.role === 'admin') { %>
                                <span
                                  class="inline-flex min-w-[118px] items-center justify-center px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-800">Administrador</span>
                                <% } else { %>
                                  <span
                                    class="inline-flex min-w-[118px] items-center justify-center px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600">Usuário</span>
                                  <% } %>
                            </td>
                            <td class="px-4 py-4">
                              <% if (Number(u.can_import ?? 1) !== 0) { %>
                                <span class="inline-flex min-w-[104px] items-center justify-center px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:border-emerald-800">Permitida</span>
                              <% } else { %>
                                <span class="inline-flex min-w-[104px] items-center justify-center px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800">Bloqueada</span>
                              <% } %>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300">
                              <%= u.created_at ? new Date(u.created_at).toLocaleDateString('pt-BR') : '-' %>
                            </td>
                            <td class="px-4 py-4 font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap">
                              <%= u.last_login ? new Date(u.last_login).toLocaleString('pt-BR') : 'Nunca acessou' %>
                            </td>
                            <td class="px-4 py-4 text-right">
                              <div class="inline-flex items-center justify-end gap-2 flex-wrap">
                                <button type="button"
                                  onclick="openEditUserModal(this)"
                                  data-user-id="<%= u.id %>"
                                  data-user-email="<%= u.email %>"
                                  data-user-name="<%= u.name || '' %>"
                                  data-user-role="<%= u.role || 'user' %>"
                                  data-user-can-import="<%= Number(u.can_import ?? 1) !== 0 ? '1' : '0' %>"
                                  class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700 transition-colors bg-white dark:bg-slate-800 shadow-sm">
                                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.586-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.414-8.586z">
                                    </path>
                                  </svg>
                                  Editar
                                </button>

                                <% if (isSelf) { %>
                                  <span
                                    class="inline-flex min-w-[104px] items-center justify-center px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:border-emerald-800">Você</span>
                                <% } else { %>
                                  <form action="/admin/remove-user/<%= u.id %>" method="POST" class="inline"
                                    onsubmit="return confirm('Tem certeza que deseja remover este usuário? Ele perderá acesso ao sistema.');">
                                    <button type="submit"
                                      class="inline-flex min-w-[104px] items-center justify-center px-3 py-1.5 rounded-lg text-xs font-bold border border-red-200 text-red-600 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-900/20 transition-colors bg-white dark:bg-slate-800 shadow-sm">
                                      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M6 7h12M9 7V4h6v3m-7 4v6m4-6v6m5 2H7a2 2 0 01-2-2V7h14v10a2 2 0 01-2 2z">
                                        </path>
                                      </svg>
                                      Remover
                                    </button>
                                  </form>
                                <% } %>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="7" class="px-4 py-6">
                                  <div class="op-empty-state op-empty-state--compact">
                                    <div class="op-empty-state__icon">
                                      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v6m3-3h-6m-6 6H5a2 2 0 01-2-2V8a2 2 0 012-2h4l2-2h2l2 2h4a2 2 0 012 2v4"></path></svg>
                                    </div>
                                    <div class="op-empty-state__title">Nenhum usuário encontrado</div>
                                    <p class="op-empty-state__text">Cadastre o primeiro e-mail autorizado para começar a distribuir acessos ao aplicativo.</p>
                                  </div>
                                </td>
                              </tr>
                              <% } %>
                    </tbody>
                  </table>
                </div>
              </section>

              <section class="grid gap-6 xl:grid-cols-2">
                <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
                  <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Informações do Sistema</h2>
                  <div class="mt-5 space-y-4 text-sm">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Autenticação</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">Google OAuth 2.0</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Isolamento</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">Cada usuário visualiza apenas seus próprios dados</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-4">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Titular automático</div>
                      <div class="font-semibold text-slate-800 dark:text-slate-200">No primeiro login Google é criada uma pessoa titular com o nome do perfil</div>
                    </div>
                  </div>
                </div>

                <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
                  <h2 class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">Como funciona o acesso?</h2>
                  <ol class="mt-5 space-y-3 text-sm font-medium text-slate-600 dark:text-slate-300 list-decimal list-inside">
                    <li>Apenas emails cadastrados nesta lista podem entrar no sistema.</li>
                    <li>No primeiro login com Google, o usuário já ganha uma pessoa titular automaticamente.</li>
                    <li>Usuários com papel <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">admin</code> acessam esta área para gerenciar contas.</li>
                    <li>Usuários com papel <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">user</code> usam apenas as abas do aplicativo.</li>
                  </ol>
                </div>
              </section>
            </div>
  </div>

  <div id="addUserModal"
    class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 w-full max-w-lg shadow-2xl border border-slate-200 dark:border-slate-700"
      onclick="event.stopPropagation()">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 id="userModalTitle" class="text-xl font-black text-slate-800 dark:text-white">Adicionar Usuário Autorizado</h2>
          <p id="userModalDescription" class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Esse email poderá entrar no app usando a conta Google correspondente.</p>
        </div>
        <button type="button" onclick="closeAddUserModal()"
          class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-2xl leading-none">✕</button>
      </div>

      <form id="userForm" action="/admin/add-user" method="POST" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Email do Google</label>
          <input type="email" id="email" name="email" required placeholder="exemplo@gmail.com"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
        </div>

        <div>
          <label for="name" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Nome (Opcional)</label>
          <input type="text" id="name" name="name" placeholder="Nome do usuário"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
          <p class="text-xs font-medium text-slate-400 mt-2">Se ficar em branco, usamos a parte anterior ao <code>@</code>.</p>
        </div>

        <div>
          <label for="role" class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Papel</label>
          <select id="role" name="role"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium">
            <option value="user" selected>Usuário (Apenas app)</option>
            <option value="admin">Administrador (App + Painel Admin)</option>
          </select>
        </div>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3">
          <input type="checkbox" id="can_import" name="can_import" value="1" checked
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Permitir Importação de Faturas?</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Quando desmarcado, a pessoa não verá os botões nem poderá acessar a funcionalidade de importação.</span>
          </span>
        </label>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button type="button" onclick="closeAddUserModal()"
            class="flex-1 px-5 py-3 rounded-xl font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">
            Cancelar
          </button>
          <button type="submit"
            class="flex-1 px-5 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
            <span id="userModalSubmitLabel">Adicionar Usuário</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const addUserModal = document.getElementById('addUserModal');
    const userForm = document.getElementById('userForm');
    const userModalTitle = document.getElementById('userModalTitle');
    const userModalDescription = document.getElementById('userModalDescription');
    const userModalSubmitLabel = document.getElementById('userModalSubmitLabel');
    const emailField = document.getElementById('email');
    const nameField = document.getElementById('name');
    const roleField = document.getElementById('role');
    const canImportField = document.getElementById('can_import');

    function configureUserModalForAdd() {
      if (!userForm) return;
      userForm.action = '/admin/add-user';
      userModalTitle.textContent = 'Adicionar Usuário Autorizado';
      userModalDescription.textContent = 'Esse email poderá entrar no app usando a conta Google correspondente.';
      userModalSubmitLabel.textContent = 'Adicionar Usuário';
      emailField.value = '';
      nameField.value = '';
      roleField.value = 'user';
      canImportField.checked = true;
    }

    function openAddUserModal() {
      configureUserModalForAdd();
      addUserModal.classList.remove('hidden');
    }

    function openEditUserModal(button) {
      if (!button || !userForm) return;
      userForm.action = `/admin/update-user/${button.dataset.userId}`;
      userModalTitle.textContent = 'Editar Usuário Autorizado';
      userModalDescription.textContent = 'Atualize os dados de acesso mantendo as permissões desejadas para esse usuário.';
      userModalSubmitLabel.textContent = 'Salvar Alterações';
      emailField.value = button.dataset.userEmail || '';
      nameField.value = button.dataset.userName || '';
      roleField.value = button.dataset.userRole || 'user';
      canImportField.checked = button.dataset.userCanImport === '1';
      addUserModal.classList.remove('hidden');
    }

    function closeAddUserModal() {
      addUserModal.classList.add('hidden');
      configureUserModalForAdd();
    }

    addUserModal?.addEventListener('click', (event) => {
      if (event.target === addUserModal) {
        closeAddUserModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && addUserModal && !addUserModal.classList.contains('hidden')) {
        closeAddUserModal();
      }
    });
  </script>

  <%- include("partials/footer") %>
