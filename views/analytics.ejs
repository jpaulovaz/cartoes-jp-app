                          <div class="min-w-0">
                            <div class="truncate text-sm font-black text-slate-900 dark:text-white"><%= item.label %></div>
                            <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= item.share_pct || 0 %>% das entradas</div>
                          </div>
                          <div class="text-sm font-black text-emerald-700 dark:text-emerald-300"><%= formatBRLFromCents(item.total_cents || 0) %></div>
                        </div>
                        <div class="mt-3 h-2 rounded-full bg-emerald-100 dark:bg-emerald-950/40"><div class="h-2 rounded-full bg-emerald-500 dark:bg-emerald-400" style="width:<%= item.intensity_pct || 0 %>%"></div></div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="mt-4 rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-sm font-semibold leading-6 text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">Ainda não tem entrada lançada nesse mês por aqui.</div>
                <% } %>
              </div>

              <div class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">Saídas que mais pesam</h3>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Ajuda a perceber o que mais está puxando a parte de fora das compras.</p>
                  </div>
                  <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/20 dark:text-rose-300"><%= financeExpenseSources.length %> saída<%= financeExpenseSources.length === 1 ? '' : 's' %></span>
                </div>
                <% if (financeExpenseSources.length > 0) { %>
                  <div class="mt-4 space-y-3">
                    <% financeExpenseSources.slice(0, 6).forEach((item) => { %>
                      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
                        <div class="flex items-center justify-between gap-3">
                          <div class="min-w-0">
                            <div class="truncate text-sm font-black text-slate-900 dark:text-white"><%= item.label %></div>
                            <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= item.share_pct || 0 %>% das saídas</div>
                          </div>
                          <div class="text-sm font-black text-rose-700 dark:text-rose-300"><%= formatBRLFromCents(item.total_cents || 0) %></div>
                        </div>
                        <div class="mt-3 h-2 rounded-full bg-rose-100 dark:bg-rose-950/40"><div class="h-2 rounded-full bg-rose-500 dark:bg-rose-400" style="width:<%= item.intensity_pct || 0 %>%"></div></div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="mt-4 rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-sm font-semibold leading-6 text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">Sem saídas lançadas nesse bloco do mês até agora.</div>
                <% } %>
              </div>
            </section>
          </div>
        <% } else { %>
          <div class="mt-6 rounded-[26px] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center dark:border-slate-700 dark:bg-slate-800/60">
            <div class="text-xl font-black text-slate-900 dark:text-white">Ainda falta abastecer essa parte do mapa</div>
            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-300">Quando você preencher entradas e saídas no detalhamento, esta área ganha comparação de meses e ranking do que mais pesa.</p>
            <a href="/detalhamento/<%= year %>/<%= month %>" class="op-btn op-btn-export op-btn--compact whitespace-nowrap mt-5">Abrir detalhamento</a>
          </div>
        <% } %>
      </div>

      <div data-op-tab-panel="split" hidden>
        <div class="grid gap-3 lg:grid-cols-4">
          <div class="rounded-[24px] border border-slate-200 bg-white/90 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/50">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Dividido entre pessoas</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= formatBRLFromCents(graphKpis.totalPeopleAssignedCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Tudo que já está repartido dentro das compras do mês.</p>
          </div>
          <div class="rounded-[24px] border border-amber-200 bg-amber-50/90 p-4 dark:border-amber-900/60 dark:bg-amber-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-amber-700 dark:text-amber-300">Sem dono ainda</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-amber-900 dark:text-amber-100"><%= formatBRLFromCents(graphKpis.totalUnassignedCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-amber-800/80 dark:text-amber-100/80">Bom para achar o que ainda não foi distribuído.</p>
          </div>
          <div class="rounded-[24px] border border-emerald-200 bg-emerald-50/90 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">Pago nos cartões</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-emerald-800 dark:text-emerald-100"><%= formatBRLFromCents(graphKpis.totalPaidCardsCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-emerald-800/80 dark:text-emerald-100/80">Parte já marcada como quitada no fechamento.</p>
          </div>
          <div class="rounded-[24px] border border-violet-200 bg-violet-50/90 p-4 dark:border-violet-900/60 dark:bg-violet-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-violet-700 dark:text-violet-300">Pessoas na roda</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-violet-900 dark:text-violet-100"><%= peopleRows.length %></div>
            <p class="mt-2 text-xs leading-5 text-violet-800/80 dark:text-violet-100/80">Quem mais puxou valor aparece logo abaixo, junto dos cartões.</p>
          </div>
        </div>

        <div class="mt-6 grid gap-4 xl:grid-cols-2">
          <section class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white">Quem mais puxou valor</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Ajuda a entender a divisão do mês pelas pessoas que entraram na conta.</p>
              </div>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Pessoas</span>
            </div>
            <% if (peopleRows.length > 0) { %>
              <div class="mt-4 space-y-3">
                <% peopleRows.slice(0, 6).forEach((person) => { %>
                  <a href="/month/<%= year %>/<%= month %>?f_person=<%= person.id %>" class="block rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 transition hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-50/70 dark:border-slate-700 dark:bg-slate-800/60 dark:hover:border-violet-800 dark:hover:bg-violet-900/20">
                    <div class="flex items-center justify-between gap-3">
                      <div class="min-w-0">
                        <div class="truncate text-sm font-black text-slate-900 dark:text-white"><%= person.label %></div>
                        <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= person.share_pct || 0 %>% do mês · já pagou <%= formatBRLFromCents(person.paid_cents || 0) %></div>
                      </div>
                      <div class="text-right">
                        <div class="text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(person.total_cents || 0) %></div>
                        <div class="mt-1 text-xs font-semibold <%= Number(person.remaining_cents || 0) > 0 ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300' %>"><%= Number(person.remaining_cents || 0) > 0 ? `faltam ${formatBRLFromCents(person.remaining_cents || 0)}` : 'já está zerado' %></div>
                      </div>
                    </div>
                    <div class="mt-3 h-2 rounded-full bg-violet-100 dark:bg-violet-950/40"><div class="h-2 rounded-full bg-violet-500 dark:bg-violet-400" style="width:<%= person.intensity_pct || 0 %>%"></div></div>
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <div class="mt-4 rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-sm font-semibold leading-6 text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">Quando o mês tiver divisão entre pessoas, esse ranking aparece por aqui.</div>
            <% } %>
          </section>

          <section class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white">Cartões que mais carregaram o mês</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Mostra onde o total do mês ficou concentrado e o que ainda está pendente.</p>
              </div>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Cartões</span>
            </div>
            <% if (cardRows.length > 0) { %>
              <div class="mt-4 space-y-3">
                <% cardRows.slice(0, 6).forEach((card) => { %>
                  <a href="/month/<%= year %>/<%= month %>?f_card=<%= encodeURIComponent(card.label) %>" class="block rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 transition hover:-translate-y-0.5 hover:border-sky-300 hover:bg-sky-50/70 dark:border-slate-700 dark:bg-slate-800/60 dark:hover:border-sky-800 dark:hover:bg-sky-900/20">
                    <div class="flex items-center justify-between gap-3">
                      <div class="min-w-0">
                        <div class="truncate text-sm font-black text-slate-900 dark:text-white"><%= card.label %></div>
                        <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= card.share_pct || 0 %>% do mês · pago <%= formatBRLFromCents(card.paid_cents || 0) %></div>
                      </div>
                      <div class="text-right">
                        <div class="text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(card.total_cents || 0) %></div>
                        <div class="mt-1 text-xs font-semibold <%= Number(card.remaining_cents || 0) > 0 ? 'text-amber-700 dark:text-amber-300' : 'text-emerald-700 dark:text-emerald-300' %>"><%= Number(card.remaining_cents || 0) > 0 ? `faltam ${formatBRLFromCents(card.remaining_cents || 0)}` : 'sem pendência' %></div>
                      </div>
                    </div>
                    <div class="mt-3 h-2 rounded-full bg-sky-100 dark:bg-sky-950/40"><div class="h-2 rounded-full bg-sky-500 dark:bg-sky-400" style="width:<%= card.intensity_pct || 0 %>%"></div></div>
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <div class="mt-4 rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-sm font-semibold leading-6 text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">Quando o mês tiver compras em cartões, esse comparativo aparece aqui.</div>
            <% } %>
          </section>
        </div>
      </div>

      <div data-op-tab-panel="places" hidden>
        <div class="grid gap-3 lg:grid-cols-4 mb-6">
          <div class="rounded-[24px] border border-slate-200 bg-white/90 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/50 lg:col-span-2">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Lugar campeão</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= merchantTop ? merchantTop.label : 'Ainda sem campeão' %></div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400"><%= merchantTop ? `${formatBRLFromCents(merchantTop.total_cents || 0)} em ${merchantTop.txn_count || 0} compra${Number(merchantTop.txn_count || 0) === 1 ? '' : 's'}.` : 'Assim que um lugar puxar mais do que os outros, ele ganha destaque aqui.' %></p>
          </div>
          <div class="rounded-[24px] border border-violet-200 bg-violet-50/90 p-4 dark:border-violet-900/60 dark:bg-violet-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-violet-700 dark:text-violet-300">Ranking</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-violet-900 dark:text-violet-100"><%= merchantRanking.length %></div>
            <p class="mt-2 text-xs leading-5 text-violet-800/80 dark:text-violet-100/80">Lugares reconhecidos nessa leitura.</p>
          </div>
          <div class="rounded-[24px] border border-emerald-200 bg-emerald-50/90 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">Sugestões</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-emerald-900 dark:text-emerald-100"><%= merchantSuggestions.length %></div>
            <p class="mt-2 text-xs leading-5 text-emerald-800/80 dark:text-emerald-100/80">Nomes que o app separou para você confirmar.</p>
          </div>
        </div>

<section class="mb-8 rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40" data-summary-ranking-root>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h3 class="text-lg font-black text-slate-900 dark:text-white">Ranking de estabelecimentos</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Aqui mora o pódio do mês: quem mais apareceu, quem puxou mais grana e quem subiu ou respirou em relação ao mês passado.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2 sm:justify-end">
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Leitura por nome</span>
            <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800" data-summary-ranking-toggle aria-expanded="<%= merchantRankingDefaultOpen ? 'true' : 'false' %>">
              <span data-summary-ranking-toggle-label><%= merchantRankingDefaultOpen ? 'Esconder ranking' : 'Mostrar ranking' %></span>
            </button>
          </div>
        </div>

        <div class="mt-4" data-summary-ranking-panel <%= merchantRankingDefaultOpen ? '' : 'hidden' %>>
        <% if (merchantRanking.length > 0) { %>
          <% const merchantMaxTotal = merchantRanking.reduce((best, item) => Math.max(best, Number(item.total_cents || 0)), 0); %>
          <% const rankingPodium = merchantRanking.slice(0, 3); %>
          <% const rankingRest = merchantRanking.slice(3); %>
          <% const medalMeta = {
            1: { emoji: '🥇', label: 'Ouro do mês', border: 'border-amber-200 dark:border-amber-700', bg: 'bg-amber-50/90 dark:bg-amber-900/20', chip: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-100' },
            2: { emoji: '🥈', label: 'Prata valente', border: 'border-slate-300 dark:border-slate-600', bg: 'bg-slate-50/90 dark:bg-slate-800/80', chip: 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-100' },
            3: { emoji: '🥉', label: 'Bronze na cola', border: 'border-orange-200 dark:border-orange-700', bg: 'bg-orange-50/90 dark:bg-orange-900/20', chip: 'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-100' }
          }; %>
          <% const rankingLeader = merchantRanking[0]; %>

          <div class="rounded-[24px] border border-amber-200 bg-gradient-to-br from-amber-50 via-white to-emerald-50 p-5 shadow-sm dark:border-amber-800 dark:from-amber-900/25 dark:via-slate-900 dark:to-emerald-900/20">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-amber-800 dark:bg-amber-900/50 dark:text-amber-100">🏆 Campeão do mês</div>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <h4 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= rankingLeader.label %></h4>
                  <span class="inline-flex items-center rounded-full border border-amber-200 bg-white/80 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-amber-700 dark:border-amber-700 dark:bg-slate-900/60 dark:text-amber-200"><%= rankingLeader.share_pct || 0 %>% do mês</span>
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-300">Esse aqui levou a taça da gastança no período. Se quiser investigar de perto, é só tocar no card dele logo abaixo.</p>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
                  <span><%= rankingLeader.txn_count || 0 %> compra<%= Number(rankingLeader.txn_count || 0) === 1 ? '' : 's' %></span>
                  <span class="hidden sm:inline">·</span>
                  <span>ticket médio de <%= formatBRLFromCents(rankingLeader.avg_ticket_cents || 0) %></span>
                  <% if (rankingLeader.delta_pct !== null && rankingLeader.delta_pct !== undefined) { %>
                    <span class="hidden sm:inline">·</span>
                    <span class="font-bold <%= Number(rankingLeader.delta_cents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : Number(rankingLeader.delta_cents || 0) < 0 ? 'text-emerald-700 dark:text-emerald-300' : 'text-slate-600 dark:text-slate-300' %>"><%= Number(rankingLeader.delta_cents || 0) > 0 ? 'Subiu' : Number(rankingLeader.delta_cents || 0) < 0 ? 'Respirou' : 'Ficou estável' %> <%= Math.abs(Number(rankingLeader.delta_pct || 0)) %>% vs mês passado</span>
                  <% } else { %>
                    <span class="hidden sm:inline">·</span>
                    <span class="font-bold text-slate-600 dark:text-slate-300">Primeira aparição forte por aqui</span>
                  <% } %>
                </div>
              </div>
