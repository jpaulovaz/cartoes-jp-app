                      <div>
                        <div class="flex items-center justify-between gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300"><span>Entradas</span><span><%= formatBRLFromCents(point.income_cents || 0) %></span></div>
