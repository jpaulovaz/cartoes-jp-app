                  </div>
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/20 dark:text-emerald-300"><%= financeIncomeSources.length %> fonte<%= financeIncomeSources.length === 1 ? '' : 's' %></span>
                </div>
                <% if (financeIncomeSources.length > 0) { %>
                  <div class="mt-4 space-y-3">
                    <% financeIncomeSources.slice(0, 6).forEach((item) => { %>
                      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/60">
