                      </div>
                      <div>
                        <div class="flex items-center justify-between gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-rose-700 dark:text-rose-300"><span>Saídas</span><span><%= formatBRLFromCents(point.expense_cents || 0) %></span></div>
                        <div class="mt-1 h-2 rounded-full bg-rose-100 dark:bg-rose-950/40"><div class="h-2 rounded-full bg-rose-500 dark:bg-rose-400" style="width:<%= expensePct %>%"></div></div>
                      </div>
                    </div>
                    <div class="mt-3 text-xs font-semibold <%= Number(point.net_cents || 0) >= 0 ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>">Saldo do mês: <%= formatBRLFromCents(point.net_cents || 0) %></div>
                  </div>
                <% }) %>
              </div>
