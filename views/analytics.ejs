                  <% } else { %>
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-200">estreia no radar</span>
                  <% } %>
                </div>
                <% if (merchantSample) { %>
                  <p class="mt-3 text-xs leading-5 text-slate-500 dark:text-slate-400">Exemplo lido: <span class="font-semibold text-slate-700 dark:text-slate-200"><%= merchantSample %></span></p>
                <% } %>
                <div class="mt-3 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 opacity-0 transition group-hover:opacity-100 dark:text-emerald-300"><%= merchantHref ? 'Toque para abrir as compras desse nome' : 'Só leitura nessa rodada' %></div>
              <% if (merchantHref) { %>
              </a>
              <% } else { %>
              </div>
              <% } %>
            <% }) %>
          </div>

          <% if (rankingRest.length > 0) { %>
          <div class="mt-4 space-y-3">
            <% rankingRest.forEach((merchant) => { %>
              <% const widthPct = merchantMaxTotal > 0 ? Math.max(8, Math.round((Number(merchant.total_cents || 0) / merchantMaxTotal) * 100)) : 8; %>
              <% const merchantHref = merchant.search_term ? `/month/${year}/${month}?${new URLSearchParams({ f_desc: String(merchant.search_term || '').trim() }).toString()}` : null; %>
              <% const merchantSample = merchant.sample_descriptions && merchant.sample_descriptions.length ? merchant.sample_descriptions[0] : ''; %>
              <% if (merchantHref) { %>
              <a href="<%= merchantHref %>" class="group block rounded-[22px] border border-slate-200 bg-slate-50/80 px-4 py-4 transition duration-200 hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-50/70 focus:outline-none focus:ring-2 focus:ring-emerald-400 dark:border-slate-700 dark:bg-slate-800/70 dark:hover:border-emerald-700 dark:hover:bg-emerald-900/10" aria-label="Abrir compras de <%= merchant.label %>">
              <% } else { %>
              <div class="group block rounded-[22px] border border-slate-200 bg-slate-50/80 px-4 py-4 transition duration-200 dark:border-slate-700 dark:bg-slate-800/70">
              <% } %>
