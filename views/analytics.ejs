                    <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-slate-200/80 dark:bg-slate-700/80">
                      <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 via-emerald-500 to-teal-500" style="width: <%= widthPct %>%"></div>
