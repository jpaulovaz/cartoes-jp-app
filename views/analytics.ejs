                      <span class="hidden sm:inline">·</span>
                      <span>ticket médio de <%= formatBRLFromCents(merchant.avg_ticket_cents || 0) %></span>
                      <% if (merchant.delta_pct !== null && merchant.delta_pct !== undefined) { %>
                        <span class="hidden sm:inline">·</span>
                        <span class="font-bold <%= Number(merchant.delta_cents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : Number(merchant.delta_cents || 0) < 0 ? 'text-emerald-700 dark:text-emerald-300' : 'text-slate-600 dark:text-slate-300' %>">
                          <%= Number(merchant.delta_cents || 0) > 0 ? 'Subiu' : Number(merchant.delta_cents || 0) < 0 ? 'Respirou' : 'Ficou estável' %> <%= Math.abs(Number(merchant.delta_pct || 0)) %>%
                        </span>
                      <% } else { %>
                        <span class="hidden sm:inline">·</span>
                        <span class="font-bold text-slate-600 dark:text-slate-300">estreia no radar</span>
                      <% } %>
                      <% if (merchant.confidence === 'high') { %>
                        <span class="hidden sm:inline">·</span>
                        <span class="font-bold text-emerald-700 dark:text-emerald-300">nome reconhecido</span>
