<%- include("partials/header", { title: `OrganizaPay | Análises ${String(month).padStart(2,'0')}/${year}` }) %>
<%
  const graphKpis = summaryCharts && summaryCharts.kpis ? summaryCharts.kpis : {};
  const graphInsights = summaryCharts && summaryCharts.insights ? summaryCharts.insights : {};
  const merchantRanking = summaryCharts && Array.isArray(summaryCharts.establishments) ? summaryCharts.establishments : [];
  const merchantTop = graphInsights && graphInsights.topMerchant ? graphInsights.topMerchant : null;
  const merchantSuggestions = summaryCharts && Array.isArray(summaryCharts.establishmentSuggestions) ? summaryCharts.establishmentSuggestions : [];
  const merchantLearning = graphInsights && graphInsights.merchantLearning ? graphInsights.merchantLearning : { activeRules: [], pausedRules: [] };
  const merchantSectionDefaultOpen = true;
  const merchantRankingDefaultOpen = true;
  const financeTotals = financeAnalytics && financeAnalytics.totals ? financeAnalytics.totals : { incomeCents: 0, expenseCents: 0, netCents: 0, incomeRowCount: 0, expenseRowCount: 0, positiveNetMonths: 0 };
  const financeTrend = financeAnalytics && Array.isArray(financeAnalytics.trend) ? financeAnalytics.trend : [];
  const financeIncomeSources = financeAnalytics && Array.isArray(financeAnalytics.incomeSources) ? financeAnalytics.incomeSources : [];
  const financeExpenseSources = financeAnalytics && Array.isArray(financeAnalytics.expenseSources) ? financeAnalytics.expenseSources : [];
  const financeTrendMax = Math.max(1, ...financeTrend.map((point) => Math.max(Number(point.income_cents || 0), Number(point.expense_cents || 0))));
  const peopleRows = Array.isArray(peopleBreakdown) ? peopleBreakdown : [];
  const cardRows = Array.isArray(cardBreakdown) ? cardBreakdown : [];
  const hasFinanceFlow = financeTrend.some((point) => Number(point.income_cents || 0) > 0 || Number(point.expense_cents || 0) > 0);
%>

<div class="op-screen op-screen--summary op-screen--analytics w-full">
  <section class="op-page-hero op-fade-up mb-8">
    <div>
      <span class="op-page-hero__eyebrow">Leitura do mês</span>
      <h1 class="op-page-hero__title mt-4">Análises do mês — <%= String(month).padStart(2,'0') %>/<%= year %></h1>
      <p class="op-page-hero__subtitle mt-3">Aqui você enxerga o que pesou, o que entrou, o que saiu e onde vale olhar com mais carinho.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge">Compras: <%= formatBRLFromCents(graphKpis.totalSpentCents || 0) %></span>
        <span class="badge">Entradas: <%= formatBRLFromCents(financeTotals.incomeCents || 0) %></span>
        <span class="badge">Saídas: <%= formatBRLFromCents(financeTotals.expenseCents || 0) %></span>
        <span class="badge"><%= merchantTop ? `Lugar campeão: ${merchantTop.label}` : 'Lugar campeão aparece quando o mês ganha mais histórico' %></span>
      </div>
    </div>
    <div class="op-page-hero__actions op-page-hero__actions--compact">
      <a href="/month/<%= year %>/<%= month %>" class="op-btn op-btn-success op-btn--compact whitespace-nowrap">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
        </svg>
        Ver compras
      </a>
      <a href="/summary/<%= year %>/<%= month %>" class="op-btn op-btn-info op-btn--compact whitespace-nowrap">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v8m4-4H8"></path>
        </svg>
        Fechamento
      </a>
      <a href="/detalhamento/<%= year %>/<%= month %>" class="op-btn op-btn-export op-btn--compact whitespace-nowrap">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6m4 6V7m4 10v-3M5 19h14"></path>
        </svg>
        Detalhamento
      </a>
    </div>
  </section>

  <section class="mb-8 rounded-[28px] border border-slate-200 bg-white/95 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 lg:p-6" data-op-tabs>
    <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.24em] text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200">Visão organizada</div>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white">Agora cada pedaço do mês tem seu canto</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-300">Você pode alternar entre visão geral, entradas e saídas, pessoas e cartões, e a parte dos lugares mais recorrentes.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2 xl:justify-end">
        <a href="/analytics/<%= previousSummaryRef.year %>/<%= previousSummaryRef.month %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700/60">← <span class="ml-2">Mês anterior</span></a>
        <a href="/analytics/<%= nextSummaryRef.year %>/<%= nextSummaryRef.month %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700/60"><span class="mr-2">Próximo mês</span>→</a>
      </div>
    </div>

    <div class="mt-5 op-tab-strip" role="tablist" aria-label="Blocos das análises">
      <button type="button" class="op-tab-btn is-active" role="tab" aria-selected="true" data-op-tab-target="overview">Visão geral</button>
      <button type="button" class="op-tab-btn" role="tab" aria-selected="false" data-op-tab-target="flow">Entradas e saídas</button>
      <button type="button" class="op-tab-btn" role="tab" aria-selected="false" data-op-tab-target="split">Pessoas e cartões</button>
      <button type="button" class="op-tab-btn" role="tab" aria-selected="false" data-op-tab-target="places">Lugares</button>
    </div>

    <div class="mt-6 space-y-6">
      <div data-op-tab-panel="overview">
        <div class="grid gap-3 lg:grid-cols-4">
          <div class="rounded-[24px] border border-slate-200 bg-gradient-to-br from-slate-900 via-violet-900 to-slate-900 p-4 text-white shadow-sm shadow-violet-950/20 dark:border-slate-700">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-violet-200/90">Compras do mês</div>
            <div class="mt-2 text-2xl font-black tracking-tight"><%= formatBRLFromCents(graphKpis.totalSpentCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-violet-100/80"><%= graphKpis.topCategory ? `${graphKpis.topCategory.label} lidera com ${graphKpis.topCategory.share_pct || 0}% do mês.` : 'Quando as categorias aparecerem, a campeã do mês ganha destaque aqui.' %></p>
          </div>
          <div class="rounded-[24px] border border-emerald-200 bg-emerald-50/90 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">Entradas do detalhamento</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-emerald-800 dark:text-emerald-100"><%= formatBRLFromCents(financeTotals.incomeCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-emerald-800/80 dark:text-emerald-100/80"><%= financeTotals.incomeRowCount > 0 ? `${financeTotals.incomeRowCount} linha${financeTotals.incomeRowCount === 1 ? '' : 's'} alimentando essa parte do mês.` : 'Quando você preencher entradas no detalhamento, elas aparecem por aqui.' %></p>
          </div>
          <div class="rounded-[24px] border border-rose-200 bg-rose-50/90 p-4 dark:border-rose-900/60 dark:bg-rose-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-rose-700 dark:text-rose-300">Saídas do detalhamento</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-rose-800 dark:text-rose-100"><%= formatBRLFromCents(financeTotals.expenseCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-rose-800/80 dark:text-rose-100/80"><%= financeTotals.expenseRowCount > 0 ? `${financeTotals.expenseRowCount} linha${financeTotals.expenseRowCount === 1 ? '' : 's'} mostrando o que saiu fora das compras.` : 'Ainda sem saídas registradas no detalhamento deste mês.' %></p>
          </div>
          <div class="rounded-[24px] border border-amber-200 bg-amber-50/90 p-4 dark:border-amber-900/60 dark:bg-amber-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-amber-700 dark:text-amber-300">Em aberto nos cartões</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-amber-900 dark:text-amber-100"><%= formatBRLFromCents(graphKpis.totalRemainingCardsCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-amber-800/80 dark:text-amber-100/80"><%= Number(graphKpis.totalPaidCardsCents || 0) > 0 ? `Já foram ${formatBRLFromCents(graphKpis.totalPaidCardsCents || 0)} marcados como pagos.` : 'Assim que você marcar pagamentos no fechamento, o retrato fica mais completo.' %></p>
          </div>
        </div>

        <section class="mt-6 op-surface-card rounded-[28px] border border-slate-200 bg-white/95 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 lg:p-6" data-summary-graphs-root data-summary-year="<%= year %>" data-summary-month="<%= month %>" data-summary-graphs-ready="false" data-summary-detail-base="analytics">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.24em] text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200">Leitura visual</div>
              <h3 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white">O que mais pesou e como esse mês veio andando</h3>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-300">Aqui entram as categorias e a evolução recente. Tocando em um ponto ou categoria, você cai direto no detalhe correspondente.</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 xl:w-[25rem]">
              <div class="rounded-[22px] border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
                <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Radar do mês</div>
                <div class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white">
                  <% if (graphInsights.currentVsAveragePct === null || graphInsights.currentVsAveragePct === undefined) { %>
                    Ainda sem base para comparar
                  <% } else if (Number(graphInsights.currentVsAveragePct || 0) > 0) { %>
                    <%= Number(graphInsights.currentVsAveragePct || 0) %>% acima da média recente
                  <% } else if (Number(graphInsights.currentVsAveragePct || 0) < 0) { %>
                    <%= Math.abs(Number(graphInsights.currentVsAveragePct || 0)) %>% abaixo da média recente
                  <% } else { %>
                    Na mesma linha da média recente
                  <% } %>
                </div>
                <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Média recente: <span class="font-bold text-slate-800 dark:text-slate-100"><%= formatBRLFromCents(graphInsights.averageMonthlySpendCents || 0) %></span>.</p>
              </div>
              <div class="rounded-[22px] border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
                <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Cobertura</div>
                <div class="mt-2 text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= Number(graphKpis.categoryCoveragePct || 0) %>% categorizado</div>
                <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400"><%= formatBRLFromCents(graphKpis.uncategorizedCents || 0) %> ainda sem etiqueta de compra.</p>
              </div>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300">
            <span class="font-bold text-slate-800 dark:text-slate-100">Dica:</span>
            <span>Tocou numa categoria ou num ponto da linha, a gente te leva direto para o detalhe correspondente.</span>
            <div class="hidden sm:block h-4 w-px bg-slate-300 dark:bg-slate-700"></div>
            <span data-summary-interaction-hint class="font-medium text-slate-500 dark:text-slate-400">Clique para explorar os detalhes.</span>
          </div>

          <div class="mt-6 grid gap-4 xl:grid-cols-2">
            <div class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-black text-slate-900 dark:text-white">Distribuição por categoria</h3>
                  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Mostra quem puxou mais da grana nas compras do mês.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Categorias</span>
              </div>
              <div class="mt-4 flex flex-col gap-4 xl:flex-row xl:items-center">
                <div class="w-full xl:max-w-[290px]" data-summary-donut-chart><div class="flex min-h-[260px] animate-pulse items-center justify-center rounded-[24px] border border-slate-200 bg-slate-50/80 px-6 py-10 text-center text-sm font-semibold leading-6 text-slate-400 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-500">Assando a pizza financeira...</div></div>
                <div class="min-w-0 flex-1" data-summary-donut-legend><div class="grid gap-3 sm:grid-cols-2"><div class="h-20 animate-pulse rounded-2xl border border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-800/60"></div><div class="h-20 animate-pulse rounded-2xl border border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-800/60"></div><div class="h-20 animate-pulse rounded-2xl border border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-800/60"></div><div class="h-20 animate-pulse rounded-2xl border border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-800/60"></div></div></div>
              </div>
            </div>

            <div class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-black text-slate-900 dark:text-white">Evolução mensal</h3>
                  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Se o mês apertou mais ou aliviou, a linha entrega rápido.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Últimos 6 meses</span>
              </div>
              <div class="mt-4" data-summary-line-chart><div class="flex min-h-[260px] animate-pulse items-center justify-center rounded-[24px] border border-slate-200 bg-slate-50/80 px-6 py-10 text-center text-sm font-semibold leading-6 text-slate-400 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-500">Afinando a linha do tempo das compras...</div></div>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/70">
                  <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Comparação com o mês anterior</div>
                  <div class="mt-2 text-lg font-black <%= Number(graphKpis.deltaCents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : 'text-emerald-600 dark:text-emerald-300' %>"><%= Number(graphKpis.deltaCents || 0) > 0 ? '+' : '' %><%= formatBRLFromCents(graphKpis.deltaCents || 0) %></div>
                  <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400"><% if (graphKpis.deltaPct === null || graphKpis.deltaPct === undefined) { %>Ainda sem base para comparar.<% } else { %><%= Math.abs(Number(graphKpis.deltaPct || 0)) %>% <%= Number(graphKpis.deltaPct || 0) >= 0 ? 'acima' : 'abaixo' %> do mês anterior.<% } %></p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/70">
                  <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Pico recente</div>
                  <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= graphInsights.peakPoint ? graphInsights.peakPoint.label : 'Ainda sem pico' %></div>
                  <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400"><%= graphInsights.peakPoint ? `${formatBRLFromCents(graphInsights.peakPoint.total_cents || 0)} foi o maior total da janela recente.` : 'Assim que houver histórico suficiente, o pico aparece aqui.' %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="sr-only" aria-live="polite" data-summary-graphs-status>Análises do mês prontas para carregar.</div>
          <script type="application/json" data-summary-graphs-json><%- JSON.stringify(summaryCharts || { categories: [], monthlyTrend: [], kpis: {}, insights: {} }) %></script>
        </section>
      </div>

      <div data-op-tab-panel="flow" hidden>
        <div class="grid gap-3 lg:grid-cols-4">
          <div class="rounded-[24px] border border-emerald-200 bg-emerald-50/90 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">Entradas</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-emerald-800 dark:text-emerald-100"><%= formatBRLFromCents(financeTotals.incomeCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-emerald-800/80 dark:text-emerald-100/80"><%= financeIncomeSources[0] ? `${financeIncomeSources[0].label} puxa ${financeIncomeSources[0].share_pct || 0}% das entradas.` : 'Ainda sem entrada lançada neste mês.' %></p>
          </div>
          <div class="rounded-[24px] border border-rose-200 bg-rose-50/90 p-4 dark:border-rose-900/60 dark:bg-rose-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-rose-700 dark:text-rose-300">Saídas</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-rose-800 dark:text-rose-100"><%= formatBRLFromCents(financeTotals.expenseCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-rose-800/80 dark:text-rose-100/80"><%= financeExpenseSources[0] ? `${financeExpenseSources[0].label} é a saída que mais pesa.` : 'Ainda sem saída registrada neste pedaço do mês.' %></p>
          </div>
          <div class="rounded-[24px] border border-slate-200 bg-slate-900 p-4 text-white dark:border-slate-700 dark:bg-slate-950">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">Saldo do detalhamento</div>
            <div class="mt-2 text-2xl font-black tracking-tight"><%= formatBRLFromCents(financeTotals.netCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-slate-300"><%= Number(financeTotals.netCents || 0) >= 0 ? 'Entrou mais do que saiu neste recorte.' : 'As saídas estão maiores do que as entradas neste recorte.' %></p>
          </div>
          <a href="/detalhamento/<%= year %>/<%= month %>" class="rounded-[24px] border border-slate-200 bg-white/90 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900/50">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Abrir onde isso é editado</div>
            <div class="mt-2 text-xl font-black tracking-tight text-slate-900 dark:text-white">Detalhamento do mês</div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">É ali que entram salário, contas da casa, extras e qualquer outro fluxo fora das compras do cartão.</p>
          </a>
        </div>

        <% if (hasFinanceFlow) { %>
          <div class="mt-6 grid gap-4 xl:grid-cols-[1.3fr,1fr]">
            <section class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-black text-slate-900 dark:text-white">Entradas e saídas ao longo dos meses</h3>
                  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Bom para ver se a folga do mês apareceu ou se o aperto já vinha dando sinais.</p>
                </div>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Últimos 6 meses</span>
              </div>
              <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                <% financeTrend.forEach((point) => { 
                     const incomePct = financeTrendMax > 0 ? Math.max(8, Math.round((Number(point.income_cents || 0) / financeTrendMax) * 100)) : 0;
                     const expensePct = financeTrendMax > 0 ? Math.max(8, Math.round((Number(point.expense_cents || 0) / financeTrendMax) * 100)) : 0;
                %>
                  <div class="rounded-[22px] border <%= point.is_current ? 'border-violet-300 bg-violet-50/70 dark:border-violet-800 dark:bg-violet-900/20' : 'border-slate-200 bg-slate-50/80 dark:border-slate-700 dark:bg-slate-800/60' %> p-4">
                    <div class="flex items-center justify-between gap-2">
