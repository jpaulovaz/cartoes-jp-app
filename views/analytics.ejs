                    </div>
                    <% if (merchantSample) { %>
                      <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Exemplo lido: <span class="font-semibold text-slate-700 dark:text-slate-200"><%= merchantSample %></span></p>
