                  </div>
                  <div class="text-left lg:ml-4 lg:min-w-[160px] lg:text-right">
                    <div class="text-lg font-black tracking-tight text-slate-900 dark:text-white"><%= formatBRLFromCents(merchant.total_cents || 0) %></div>
                    <div class="mt-1 text-[11px] font-bold uppercase tracking-[0.18em] <%= Number(merchant.delta_cents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : Number(merchant.delta_cents || 0) < 0 ? 'text-emerald-700 dark:text-emerald-300' : 'text-slate-500 dark:text-slate-400' %>">
                      <% if (merchant.delta_pct !== null && merchant.delta_pct !== undefined) { %>
                        <%= Number(merchant.delta_cents || 0) > 0 ? '▲' : Number(merchant.delta_cents || 0) < 0 ? '▼' : '•' %> <%= Number(merchant.delta_cents || 0) > 0 ? '+' : '' %><%= formatBRLFromCents(merchant.delta_cents || 0) %>
                      <% } else { %>
                        primeira aparição forte
                      <% } %>
                    </div>
                    <div class="mt-1 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700 opacity-0 transition group-hover:opacity-100 dark:text-emerald-300"><%= merchantHref ? 'Abrir compras desse nome' : 'Só leitura nessa rodada' %></div>
                  </div>
                </div>
              <% if (merchantHref) { %>
              </a>
              <% } else { %>
              </div>
              <% } %>
            <% }) %>
          </div>
          <% } %>
        <% } else { %>
          <div class="mt-4 flex min-h-[180px] items-center justify-center rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-sm font-semibold leading-6 text-slate-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300">Ainda não apareceu compra suficiente para montar esse ranking. Assim que o mês ganhar movimento, essa área entra em cena.</div>
        <% } %>
        </div>
    </section>

<section class="mb-8 op-surface-card rounded-[28px] border border-slate-200 bg-white/95 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 lg:p-6" data-summary-intel-root>
