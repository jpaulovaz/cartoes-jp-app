<%- include("partials/header", { title: "OrganizaPay | Cartões" }) %>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Cartões de Crédito</h1>
      <p class="text-slate-500 dark:text-slate-400 mt-2 font-medium">Cadastre seus cartões e configure os dias de fechamento e vencimento da fatura.</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 sm:p-8">

      <form method="post" action="/cards" class="mb-8 pb-8 border-b border-slate-100 dark:border-slate-700">
        <div class="grid md:grid-cols-12 gap-3 items-end">
          <div class="md:col-span-5">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Nome do cartão</label>
            <input name="name"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Ex: Nubank, Inter..." required />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Fechamento</label>
            <input name="close_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Dia" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Vencimento</label>
            <input name="due_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Dia" />
          </div>
          <div class="md:col-span-3">
            <button type="submit"
              class="w-full px-4 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
              + Adicionar
            </button>
          </div>
        </div>
        <p class="text-xs font-medium text-slate-400 dark:text-slate-500 mt-3 flex items-center">
          <svg class="w-4 h-4 mr-1 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          O sistema empurra automaticamente o vencimento para o próximo dia útil considerando feriados nacionais e fins
          de semana. O fechamento é usado para sugerir o primeiro mês da fatura nos lançamentos manuais.
        </p>
      </form>

      <div class="grid gap-4 sm:grid-cols-2">
        <% cards.forEach(c=> { %>
          <div
            class="group flex flex-col justify-between border border-slate-200 dark:border-slate-700 rounded-2xl p-5 hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-md transition-all <%= c.active ? 'bg-white dark:bg-slate-800' : 'bg-slate-50/80 dark:bg-slate-900/80' %> relative overflow-hidden">

            <div class="flex items-start justify-between gap-4 mb-5">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 shadow-inner flex items-center justify-center text-white">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                </div>
                <div>
                  <div class="font-extrabold text-slate-800 dark:text-white text-lg">
                    <%= c.name %>
                  </div>
                  <div class="flex flex-wrap gap-2 mt-2 text-xs font-bold">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600">
                      Fechamento: <span class="ml-1"><%= c.close_day ? 'Dia ' + c.close_day : 'Não definido' %></span>
                    </span>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600">
                      Vencimento: <span class="ml-1"><%= c.due_day ? 'Dia ' + c.due_day : 'Não definido' %></span>
                    </span>
                  </div>
                </div>
              </div>
              <span
                class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold border <%= c.active ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-slate-100 dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300' %>">
                <%= c.active ? 'Ativo' : 'Desativado' %>
              </span>
            </div>

            <form method="post" action="/cards/<%= c.id %>/update"
              class="mt-auto bg-slate-50 dark:bg-slate-900 -mx-5 px-4 py-4 border-y border-slate-100 dark:border-slate-700">
              <div class="grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] gap-3 items-end">
                <div>
                  <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Fechamento</label>
                  <input name="close_day" type="number" min="1" max="31" value="<%= c.close_day || '' %>" placeholder="Dia"
                    class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm font-bold bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Vencimento</label>
                  <input name="due_day" type="number" min="1" max="31" value="<%= c.due_day || '' %>" placeholder="Dia"
                    class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm font-bold bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
                <button
                  class="px-4 py-2 text-sm font-bold rounded-lg bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-600 hover:text-blue-700 hover:border-blue-300 dark:hover:border-blue-500 transition-colors shadow-sm">
                  Salvar
                </button>
              </div>
            </form>

            <div class="flex flex-wrap gap-2 mt-4">
              <form method="post" action="/cards/<%= c.id %>/toggle"
                data-confirm-prompt="<%= c.active ? 'Desativar' : 'Reativar' %> o cartão <%= c.name %>? Esta ação não apaga histórico."
                data-confirm-phrase="Eu confirmo"
                class="flex-1">
                <button
                  class="w-full px-4 py-2 text-sm font-bold rounded-xl border <%= c.active ? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %> transition-colors shadow-sm">
                  <%= c.active ? 'Desativar' : 'Reativar' %>
                </button>
              </form>

              <form method="post" action="/cards/<%= c.id %>/delete"
                data-confirm-prompt="Excluir o cartão <%= c.name %>? A exclusão só será concluída se não houver histórico vinculado."
                data-confirm-phrase="Eu confirmo"
                class="flex-1">
                <button
                  class="w-full px-4 py-2 text-sm font-bold rounded-xl border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition-colors shadow-sm">
                  Excluir
                </button>
              </form>
            </div>

          </div>
          <% }) %>
      </div>

    </div>
  </div>

  <%- include("partials/footer") %>