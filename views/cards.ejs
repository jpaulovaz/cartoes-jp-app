<%- include("partials/header", { title: "Cartões JP | Cartões" }) %>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Cartões de Crédito</h1>
      <p class="text-slate-500 mt-2 font-medium">Cadastre seus cartões e configure os dias de fechamento e vencimento padrão.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-6 sm:p-8">

      <form method="post" action="/cards" class="mb-8 pb-8 border-b border-slate-100">
        <div class="grid md:grid-cols-12 gap-3 items-start">
          <div class="md:col-span-6">
            <input name="name"
              class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="Nome do cartão (ex: Nubank, Inter...)" required />
          </div>
          <div class="md:col-span-2">
            <input name="close_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="Dia de Fechamento" />
          </div>
          <div class="md:col-span-2">
            <input name="due_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="Dia de Vencimento" />
          </div>
          <div class="md:col-span-2">
            <button type="submit"
              class="w-full px-4 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
              + Adicionar
            </button>
          </div>
        </div>
        <p class="text-xs font-medium text-slate-400 mt-3 flex items-center">
          <svg class="w-4 h-4 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          O sistema empurra automaticamente o vencimento para o próximo dia útil considerando feriados nacionais e fins
          de semana.
        </p>
      </form>

      <div class="grid gap-4 sm:grid-cols-2">
        <% cards.forEach(c=> { %>
          <div
            class="group flex flex-col justify-between border border-slate-200 rounded-2xl p-5 hover:border-blue-300 hover:shadow-md transition-all bg-white relative overflow-hidden">

            <div class="flex items-start gap-4 mb-5">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 shadow-inner flex items-center justify-center text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                </svg>
              </div>
              <div>
                <div class="font-extrabold text-slate-800 text-lg">
                  <%= c.name %>
                </div>
                <div class="text-sm font-medium text-slate-500 mt-0.5">Fechamento atual: <span
                    class="text-slate-700 font-bold">
                    <%= c.close_day ? 'Dia ' + c.close_day : 'Não definido' %>
                  </span></div>
                <div class="text-sm font-medium text-slate-500 mt-0.5">Vencimento atual: <span
                    class="text-slate-700 font-bold">
                    <%= c.due_day ? 'Dia ' + c.due_day : 'Não definido' %>
                  </span></div>
              </div>
            </div>

            <form method="post" action="/cards/<%= c.id %>/update"
              class="grid grid-cols-1 sm:grid-cols-[auto,auto,1fr] items-center gap-2 mt-auto bg-slate-50 -mx-5 -mb-5 p-4 border-t border-slate-100">
              <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wide">Fechamento:</label>
                <input name="close_day" type="number" min="1" max="31" value="<%= c.close_day || '' %>" placeholder="Dia"
                  class="w-20 border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
              </div>
              <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wide">Vencimento:</label>
                <input name="due_day" type="number" min="1" max="31" value="<%= c.due_day || '' %>" placeholder="Dia"
                  class="w-20 border border-slate-300 rounded-lg px-3 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-blue-500 outline-none" />
              </div>
              <button
                class="sm:ml-auto px-4 py-1.5 text-sm font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-300 transition-colors shadow-sm">
                Salvar
              </button>
            </form>

          </div>
          <% }) %>
      </div>

    </div>
  </div>

  <%- include("partials/footer") %>