<%- include("partials/header", { title: "AcerttaPay | Carteira de cartões" }) %>

  <div class="op-screen op-screen--cards op-cards-screen-v4 op-cards-screen-v5 mx-auto max-w-5xl space-y-5 pb-24">
    <section class="op-page-hero op-fade-up op-cards-hero-v4 op-cards-hero-v5 mb-6">
      <div>
        <span class="op-page-hero__eyebrow">Carteira do app</span>
        <h1 class="op-page-hero__title mt-4">Carteira de cartões</h1>
        <p class="op-page-hero__subtitle mt-3">Defina fechamento, vencimento e bandeira para manter a leitura mensal consistente.</p>
        <div class="op-page-hero__meta mt-4">
          <span class="badge"><%= cards ? cards.length : 0 %> cartão(ões)</span>
          <span class="badge">Base pronta para o mês e o resumo</span>
        </div>
      </div>
    </section>

    <div class="op-surface-card op-cards-shell bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 sm:p-8">

      <form id="card-form" method="post" action="/cards" class="op-cards-form-shell mb-8 pb-8 border-b border-slate-100 dark:border-slate-700">
        <input type="hidden" name="edit_id" id="card-form-edit-id" value="">

        <div class="op-cards-form-intro mb-5">
          <h2 id="card-form-title" class="text-xl font-black text-slate-900 dark:text-white">Cadastrar cartão</h2>
          <p id="card-form-subtitle" class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Preencha uma vez e mantenha o cálculo mensal alinhado ao fechamento real do cartão.</p>
        </div>

        <div class="grid md:grid-cols-12 gap-3 items-end">
          <div class="md:col-span-5">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Nome do cartão</label>
            <input id="card-form-name" name="name"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Ex: Nubank, Inter..." required />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Fechamento</label>
            <input id="card-form-close-day" name="close_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Dia" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Vencimento</label>
            <input id="card-form-due-day" name="due_day" type="number" min="1" max="31"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white"
              placeholder="Dia" />
          </div>
          <div class="md:col-span-3">
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Bandeira (opcional)</label>
            <select id="card-form-brand" name="brand" class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-900 dark:text-white">
              <option value="">Sem informar por enquanto</option>
              <% (cardBrandOptions || []).forEach((brandOption) => { %>
                <option value="<%= brandOption.value %>"><%= brandOption.label %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end">
          <button type="button" id="card-form-cancel" class="hidden op-btn op-btn-ghost w-full sm:w-auto sm:min-w-[12rem]">
            Cancelar edição
          </button>
          <button id="card-form-submit" type="submit"
            class="op-btn op-btn-primary w-full sm:w-auto sm:min-w-[13.5rem]">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span id="card-form-submit-label">Salvar cartão</span>
          </button>
        </div>
        <p class="text-xs font-medium text-slate-400 dark:text-slate-500 mt-3 flex items-center">
          <svg class="w-4 h-4 mr-1 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Se o vencimento cair em fim de semana ou feriado nacional, o app joga para o próximo dia útil. O fechamento ajuda a sugerir em qual fatura a compra entra.
        </p>
      </form>

      <div class="op-wallet-grid grid gap-4 sm:grid-cols-2">
        <% cards.forEach(c=> { const brandMeta = getCardBrandMeta(c.brand); %>
          <div
            class="op-wallet-card group flex flex-col justify-between border border-slate-200 dark:border-slate-700 rounded-2xl p-5 hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-md transition-all <%= c.active ? 'bg-white dark:bg-slate-800' : 'bg-slate-50/80 dark:bg-slate-900/80' %> relative overflow-hidden">

            <div class="flex items-start justify-between gap-4 mb-5">
              <div class="flex items-start gap-4 min-w-0">
                <div class="op-card-brand-face">
                  <% if (brandMeta) { %>
                    <img src="<%= brandMeta.asset %>" alt="<%= brandMeta.label %>" class="op-card-brand-face__logo" loading="lazy">
                  <% } else { %>
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <div class="font-extrabold text-slate-800 dark:text-white text-lg break-words leading-tight">
                    <%= c.name %>
                  </div>
                  <div class="mt-2 space-y-2 text-xs font-bold">
                    <% if (brandMeta) { %>
                      <span class="op-card-brand-badge">
                        <img src="<%= brandMeta.asset %>" alt="<%= brandMeta.label %>" class="op-card-brand-logo" loading="lazy">
                        <span><%= brandMeta.label %></span>
                      </span>
                    <% } %>
                    <div class="flex flex-wrap sm:flex-nowrap gap-2">
                      <span class="inline-flex flex-1 min-w-0 items-center justify-center sm:justify-start px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 whitespace-nowrap">
                        Fecha: <span class="ml-1"><%= c.close_day ? 'Dia ' + c.close_day : 'A definir' %></span>
                      </span>
                      <span class="inline-flex flex-1 min-w-0 items-center justify-center sm:justify-start px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 whitespace-nowrap">
                        Vence: <span class="ml-1"><%= c.due_day ? 'Dia ' + c.due_day : 'A definir' %></span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
              <span
                class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold border shrink-0 <%= c.active ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-slate-100 dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300' %>">
                <%= c.active ? 'Ativo' : 'Em pausa' %>
              </span>
            </div>

            <div class="mt-auto border-t border-slate-100 dark:border-slate-700 pt-4 space-y-3">
              <button
                type="button"
                data-card-edit-button
                data-card-id="<%= c.id %>"
                data-card-name="<%= c.name %>"
                data-card-close-day="<%= c.close_day || '' %>"
                data-card-due-day="<%= c.due_day || '' %>"
                data-card-brand="<%= c.brand || '' %>"
                class="op-btn op-btn-info op-btn--block">
                Editar dados
              </button>

              <div class="grid gap-2 sm:grid-cols-2">
                <form method="post" action="/cards/<%= c.id %>/toggle"
                  data-confirm-prompt="<%= c.active ? 'Pausar cartão' : 'Reativar cartão' %> o cartão <%= c.name %>? Esta ação não apaga histórico."
                  data-confirm-phrase="Eu confirmo">
                  <button
                    class="w-full px-4 py-2.5 text-sm font-bold rounded-xl border <%= c.active ? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %> transition-colors shadow-sm">
                    <%= c.active ? 'Pausar cartão' : 'Reativar cartão' %>
                  </button>
                </form>

                <form method="post" action="/cards/<%= c.id %>/delete"
                  data-confirm-prompt="Apagar o cartão <%= c.name %>? Isso só vai até o fim se não houver histórico pendurado nele."
                  data-confirm-phrase="Eu confirmo">
                  <button
                    class="w-full px-4 py-2.5 text-sm font-bold rounded-xl border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition-colors shadow-sm">
                    Excluir cartão
                  </button>
                </form>
              </div>
            </div>

          </div>
        <% }) %>
      </div>

    </div>
  </div>

  <script>
    (() => {
      const form = document.getElementById('card-form');
      if (!form) return;

      const editIdInput = document.getElementById('card-form-edit-id');
      const nameInput = document.getElementById('card-form-name');
      const closeDayInput = document.getElementById('card-form-close-day');
      const dueDayInput = document.getElementById('card-form-due-day');
      const brandInput = document.getElementById('card-form-brand');
      const title = document.getElementById('card-form-title');
      const subtitle = document.getElementById('card-form-subtitle');
      const submitLabel = document.getElementById('card-form-submit-label');
      const cancelButton = document.getElementById('card-form-cancel');

      const createState = {
        title: 'Cadastrar cartão',
        subtitle: 'Preencha uma vez e mantenha o cálculo mensal alinhado ao fechamento real do cartão.',
        submit: 'Salvar cartão'
      };

      const editState = {
        title: 'Editar cartão',
        subtitle: 'Atualize nome, bandeira ou datas sempre que o cartão mudar.',
        submit: 'Atualizar cartão'
      };

      const resetForm = () => {
        form.reset();
        editIdInput.value = '';
        title.textContent = createState.title;
        subtitle.textContent = createState.subtitle;
        submitLabel.textContent = createState.submit;
        cancelButton.classList.add('hidden');
      };

      cancelButton?.addEventListener('click', resetForm);

      document.querySelectorAll('[data-card-edit-button]').forEach((button) => {
        button.addEventListener('click', () => {
          editIdInput.value = button.dataset.cardId || '';
          nameInput.value = button.dataset.cardName || '';
          closeDayInput.value = button.dataset.cardCloseDay || '';
          dueDayInput.value = button.dataset.cardDueDay || '';
          brandInput.value = button.dataset.cardBrand || '';
          title.textContent = editState.title;
          subtitle.textContent = editState.subtitle;
          submitLabel.textContent = editState.submit;
          cancelButton.classList.remove('hidden');
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          window.setTimeout(() => nameInput.focus(), 180);
        });
      });
    })();
  </script>

  <%- include("partials/footer") %>
