<%- include("partials/header", { title: "OrganizaPay | 👑 Meu Controle" }) %>

    <% 
        let incCents = 0;
        let expCents = 0;
        finances.forEach((f) => {
            if (f.type === 'income') incCents += f.amount_cents;
            if (f.type === 'expense') expCents += f.amount_cents;
        });

        const sharedDebtOwedCents = Number((sharedDebtSummary && sharedDebtSummary.owedCents) || 0);
        const sharedDebtReceivableCents = Number((sharedDebtSummary && sharedDebtSummary.receivableCents) || 0);
        const saldoCents = incCents + sharedDebtReceivableCents - expCents - cardTotalCents - sharedDebtOwedCents;

        let prevM = parseInt(month, 10) - 1;
        let prevY = parseInt(year, 10);
        if (prevM < 1) { prevM = 12; prevY--; }
        let nextM = parseInt(month, 10) + 1;
        let nextY = parseInt(year, 10);
        if (nextM > 12) { nextM = 1; nextY++; }

        const heroOwnerName = String((owner && owner.name) || '').trim().split(/\s+/).filter(Boolean).slice(0, 2).join(' ') || 'Seu painel';
        const incomeFinances = finances.filter((f) => f.type === 'income');
        const expenseFinances = finances.filter((f) => f.type === 'expense');

        function isVariable(fin) {
            return (fin.amount_mode || 'fixed') === 'variable';
        }

        function getDisplayValue(fin) {
            if (isVariable(fin)) return formatBRLFromCents(fin.amount_cents);
            const hasMath = fin.formula && /[-+*/]/.test(fin.formula);
            if (hasMath) return fin.formula;
            return formatBRLFromCents(fin.amount_cents);
        }

        function getDesc(fin) {
            if (fin.description) return fin.description;
            if (fin.category_id) {
                const cat = categories.find((c) => c.id === fin.category_id);
                return cat ? cat.name : 'Item de valor único';
            }
            return '';
        }

        function getItemCount(fin) {
            return Array.isArray(fin.items) ? fin.items.length : 0;
        }

        function getVariableHint(fin) {
            const totalItems = getItemCount(fin);
            if (!totalItems) return 'Ainda sem lançamentos por aqui';
            return totalItems === 1 ? '1 lançamento somando esse total' : `${totalItems} lançamentos somando esse total`;
        }
    %>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
                data-month-swipe-area
                data-month-swipe-prev="/detalhamento/<%= prevY %>/<%= prevM %>"
                data-month-swipe-next="/detalhamento/<%= nextY %>/<%= nextM %>"
                style="touch-action: pan-y pinch-zoom;">

                <section class="op-page-hero op-fade-up mb-8">
                    <div>
                        <span class="op-page-hero__eyebrow">Painel principal</span>
                        <h1 class="op-page-hero__title mt-4">👑 Meu Controle</h1>
                        <p class="op-page-hero__subtitle mt-3"><span class="font-bold text-blue-600 dark:text-blue-300"><%= heroOwnerName %></span>, aqui você vê o que entrou, o que saiu, os cartões e o respiro do mês sem ficar abrindo mil telas.</p>
                    </div>

                    <div class="op-page-hero__actions w-full lg:max-w-[32rem]">
                        <% if (isClosed) { %>
                            <button onclick="toggleLock('open')"
                                class="w-full inline-flex items-center justify-center rounded-2xl bg-rose-100 px-4 py-3 text-sm font-bold text-rose-700 shadow-sm transition-colors hover:bg-rose-200 dark:bg-rose-900/30 dark:text-rose-300">
                                🔒 Mês Fechado
                            </button>
                        <% } else { %>
                            <button onclick="toggleLock('close')"
                                class="w-full inline-flex items-center justify-center rounded-2xl bg-emerald-100 px-4 py-3 text-sm font-bold text-emerald-700 shadow-sm transition-colors hover:bg-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300">
                                🔓 Fechar Mês
                            </button>
                        <% } %>

                        <button type="button" data-manual-modal-open
                            <%= (isClosed || !cards || !cards.length) ? 'disabled' : '' %>
                            class="w-full inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 <%= (isClosed || !cards || !cards.length) ? 'opacity-60 cursor-not-allowed hover:bg-emerald-600' : 'hover:bg-emerald-700' %>">
                            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Nova compra
                        </button>

                        <div class="col-span-2 w-full flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 p-1 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/70">
                            <a href="/detalhamento/<%= prevY %>/<%= prevM %>"
                                class="flex-1 rounded-xl bg-slate-50 px-3 py-3 text-center text-sm font-bold text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">&larr; Anterior</a>
                            <a href="/month/<%= year %>/<%= month %>"
                                class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white shadow-inner transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 dark:bg-slate-950 dark:hover:bg-slate-900 dark:focus:ring-slate-600 dark:focus:ring-offset-slate-900">
                                <%= String(month).padStart(2, '0' ) %> / <%= year %>
                            </a>
                            <a href="/detalhamento/<%= nextY %>/<%= nextM %>"
                                class="flex-1 rounded-xl bg-slate-50 px-3 py-3 text-center text-sm font-bold text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">Próximo &rarr;</a>
                        </div>
                    </div>
                </section>

                <div id="modalManualDetalhamento" data-manual-modal aria-hidden="true"
                    class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 w-full max-w-md shadow-2xl">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-xl font-black text-slate-800 dark:text-white">Adicionar compra</h2>
                            <button type="button" data-manual-modal-close
                                class="op-icon-btn" aria-label="Fechar janela">✕</button>
                        </div>

                        <form action="/txn/manual" method="POST" class="space-y-4" data-auto-first-due-form>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Data da Compra</label>
                                    <input type="date" name="date" required data-manual-date-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Cartão</label>
                                    <select name="card_id" data-manual-card-select <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                        <% cards.forEach(c => { %>
                                            <option value="<%= c.id %>" data-close-day="<%= c.close_day || '' %>" data-due-day="<%= c.due_day || '' %>">
                                                <%= c.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Valor Total (R$)</label>
                                    <input type="text" name="amount" placeholder="0,00" required data-money-mask data-manual-amount-input inputmode="decimal" enterkeyhint="next" autocapitalize="off" autocomplete="off" <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Parcelas</label>
                                    <input type="number" name="installments" value="1" min="1" max="99" required data-installments-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Vai cair em qual fatura?</label>
                                <input type="month" name="first_due" value="<%= year %>-<%= String(month).padStart(2, '0') %>" required data-manual-first-due <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">A gente sugere isso pela data da compra e pelo fechamento do cartão. Se precisar, pode ajustar sem cerimônia.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Descrição</label>
                                <input type="text" name="description" placeholder="Ex: Monitor Dell" required <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                            </div>

                            <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= typeof isClosed !== 'undefined' && isClosed ? 'opacity-60' : '' %>">
          <input type="checkbox" name="assign_to_owner" value="1" <%= typeof isClosed !== 'undefined' && isClosed ? 'disabled' : '' %>
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Essa compra é minha</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Marque para jogar esta compra direto no seu nome — e isso também vale para próximas parcelas ou repetições.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= isClosed ? 'opacity-60' : '' %>">
                                <input type="checkbox" name="is_recurring" value="1" data-recurring-toggle <%= isClosed ? 'disabled' : '' %>
                                    class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
                                <span>
                                    <span class="block text-sm font-bold text-slate-800 dark:text-white">Repetir todo mês</span>
                                    <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Perfeito para academia, streaming, escola, internet e afins. Só funciona com 1 parcela.</span>
                                </span>
                            </label>

                            <% if (isClosed) { %>
                                <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                                    Este mês está fechado. Abra o mês para lançar novos itens nele.
                                </div>
                            <% } else { %>
                                <button type="submit"
                                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all">
                                    Salvar compra
                                </button>
                            <% } %>
                        </form>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                    <div class="bg-emerald-500 p-5 rounded-3xl text-white shadow-sm border border-emerald-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Grana que entrou</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(incCents) %>
                        </h3>
                    </div>
                    <div class="bg-violet-500 p-5 rounded-3xl text-white shadow-sm border border-violet-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Saiu no mês</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents) %>
                        </h3>
                    </div>
                    <div class="bg-amber-500 p-5 rounded-3xl text-white shadow-sm border border-amber-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Ficou nos cartões</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(cardTotalCents) %>
                        </h3>
                    </div>
                    <div class="bg-rose-500 p-5 rounded-3xl text-white shadow-sm border border-rose-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Tudo comprometido</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents + cardTotalCents) %>
                        </h3>
                    </div>
                    <div class="bg-blue-600 p-5 rounded-3xl text-white shadow-sm border border-blue-700 col-span-2 lg:col-span-1">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Quanto sobra</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(saldoCents) %>
                        </h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 mt-4">
                    <a href="/shared-debts#received" class="block bg-sky-500 p-5 rounded-3xl text-white shadow-sm border border-sky-600 hover:-translate-y-0.5 transition-transform">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Cobranças pra pagar</p>
                                <h3 class="text-xl xl:text-2xl font-black mt-1">
                                    <%= formatBRLFromCents(sharedDebtOwedCents) %>
                                </h3>
                                <p class="mt-2 text-xs font-semibold opacity-85">
                                    <%= Number(sharedDebtSummary?.owedCount || 0) %> cobrança(s) ativa(s) neste mês
                                </p>
                                <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] opacity-90">Abrir cobranças recebidas</p>
                            </div>
                            <div class="h-12 w-12 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center text-2xl">🧾</div>
                        </div>
                    </a>
                    <a href="/shared-debts#sent" class="block bg-cyan-600 p-5 rounded-3xl text-white shadow-sm border border-cyan-700 hover:-translate-y-0.5 transition-transform">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Cobranças pra receber</p>
                                <h3 class="text-xl xl:text-2xl font-black mt-1">
                                    <%= formatBRLFromCents(sharedDebtReceivableCents) %>
                                </h3>
                                <p class="mt-2 text-xs font-semibold opacity-85">
                                    <%= Number(sharedDebtSummary?.receivableCount || 0) %> cobrança(s) ativa(s) neste mês
                                </p>
                                <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] opacity-90">Abrir cobranças enviadas</p>
                            </div>
                            <div class="h-12 w-12 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center text-2xl">💸</div>
                        </div>
                    </a>
                </div>

                <% if (alerts && alerts.length) { %>
                    <div class="mb-8 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
                            <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Olho vivo no mês</h2>
                            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Os pontos que merecem sua atenção antes que virem dor de cabeça.</p>
                        </div>
                        <div class="p-4 md:p-5 grid gap-3">
                            <% alerts.forEach(alert => { %>
                                <div class="rounded-2xl border px-4 py-3 <%= alert.type === 'warning' ? 'border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-900/20' : 'border-blue-200 bg-blue-50 dark:border-blue-800 dark:bg-blue-900/20' %>">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-white"><%= alert.icon %> <%= alert.title %></div>
                                            <div class="text-sm text-slate-600 dark:text-slate-300 mt-1"><%= alert.description %></div>
                                        </div>
                                        <% if (alert.href) { %>
                                            <a href="<%= alert.href %>" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700">Abrir</a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                    <div class="space-y-8">
                        <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-900 px-4 py-4 sm:px-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <h5 class="text-white font-bold">✨ Grana que entra</h5>
                                    <p class="text-xs font-medium text-white/70 mt-1">Valor único segue no toque rápido. Vários lançamentos abrem a listinha completinha.</p>
                                </div>
                                <button type="button" onclick="openFinanceCreator('income')" <%= isClosed ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-2 rounded-xl transition-colors">+ Nova entrada</button>
                            </div>
                            <div class="p-4 sm:p-6">
                                <% if (!incomeFinances.length) { %>
                                    <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/60 px-4 py-6 text-sm font-medium text-slate-500 dark:text-slate-400">
                                        Ainda não caiu nada por aqui. Quando pintar uma entrada, ela aparece nessa vitrine.
                                    </div>
                                <% } else { %>
                                    <div data-no-month-swipe>
                                        <div class="divide-y divide-slate-100 dark:divide-slate-700">
                                            <% incomeFinances.forEach((fin) => { const variable = isVariable(fin); const itemCount = getItemCount(fin); %>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-2 gap-y-2 py-3 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:gap-x-3">
                                                    <div class="min-w-0 space-y-2">
                                                        <input type="text" <%= isClosed ? 'disabled' : '' %> class="w-full min-w-0 bg-transparent border-b border-transparent text-sm font-semibold text-slate-800 focus:border-blue-500 outline-none dark:text-slate-200 disabled:opacity-60 sm:text-base sm:font-medium" value="<%= getDesc(fin) %>" onchange="updateRow(<%= fin.id %>, 'description', this.value)">
                                                        <% if (variable) { %>
                                                            <div class="flex flex-wrap items-center gap-2">
                                                                <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 px-2.5 py-1 text-[11px] font-bold text-sky-700 dark:bg-sky-900/30 dark:text-sky-300">
                                                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h10"></path></svg>
                                                                    Vários lançamentos
                                                                </span>
                                                                <span class="text-[11px] font-semibold leading-relaxed text-slate-500 dark:text-slate-400"><%= getVariableHint(fin) %></span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="w-40 min-w-[10rem] max-w-[10rem] self-start sm:w-48 sm:min-w-[12rem] sm:max-w-[12rem]">
                                                        <% if (variable) { %>
                                                            <button type="button" onclick="openVariableEditor(<%= fin.id %>)" class="w-full rounded-2xl border border-emerald-200 bg-emerald-50 px-2.5 py-2 text-right transition hover:border-emerald-300 hover:bg-emerald-100 dark:border-emerald-900/40 dark:bg-emerald-900/20 dark:hover:bg-emerald-900/30 sm:px-3">
                                                                <span class="block font-mono text-[13px] font-black text-emerald-700 dark:text-emerald-300 sm:text-sm"><%= formatBRLFromCents(fin.amount_cents) %></span>
                                                                <span class="mt-1 block text-[10px] font-semibold leading-tight text-slate-500 dark:text-slate-400 sm:text-[11px]"><%= itemCount ? `${itemCount} lançamento${itemCount === 1 ? '' : 's'}` : (isClosed ? 'Abrir listinha' : 'Toque para preencher') %></span>
                                                            </button>
                                                        <% } else { %>
                                                            <input type="text" data-money-mask inputmode="numeric" <%= isClosed ? 'disabled' : '' %> class="w-full rounded-2xl border border-emerald-200 bg-emerald-50 px-3 py-2 font-mono text-[13px] font-black text-right text-emerald-700 outline-none transition hover:border-emerald-300 focus:border-emerald-400 focus:ring-2 focus:ring-blue-500 disabled:opacity-60 dark:border-emerald-900/40 dark:bg-emerald-900/30 dark:text-emerald-400 sm:text-sm" value="<%= getDisplayValue(fin) %>" onblur="saveMath(<%= fin.id %>, this.value)">
                                                        <% } %>
                                                    </div>
                                                    <div class="self-start pt-0.5 text-right sm:pt-1">
                                                        <button type="button" onclick="deleteRow(<%= fin.id %>, '<%= variable ? 'variable' : 'fixed' %>')" <%= isClosed ? 'hidden' : '' %> class="inline-flex h-8 w-8 items-center justify-center rounded-full text-lg font-bold text-slate-300 transition-colors hover:bg-rose-50 hover:text-rose-500 dark:hover:bg-rose-900/20">×</button>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-800 dark:bg-slate-900 px-4 py-4 sm:px-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <h5 class="text-white font-bold">🧾 Grana que sai</h5>
                                    <p class="text-xs font-medium text-white/70 mt-1">Vale para rotina, corre do trabalho, combustível e tudo que aperta o mês.</p>
                                </div>
                                <button type="button" onclick="openFinanceCreator('expense')" <%= isClosed ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-2 rounded-xl transition-colors">+ Nova saída</button>
                            </div>
                            <div class="p-4 sm:p-6">
                                <% if (!expenseFinances.length) { %>
                                    <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/60 px-4 py-6 text-sm font-medium text-slate-500 dark:text-slate-400">
                                        Ainda não saiu nada por aqui. Quando pintar uma saída, ela entra nessa lista.
                                    </div>
                                <% } else { %>
                                    <div data-no-month-swipe>
                                        <div class="divide-y divide-slate-100 dark:divide-slate-700">
                                            <% expenseFinances.forEach((fin) => { const variable = isVariable(fin); const itemCount = getItemCount(fin); %>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-2 gap-y-2 py-3 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:gap-x-3">
                                                    <div class="min-w-0 space-y-2">
                                                        <input type="text" <%= isClosed ? 'disabled' : '' %> class="w-full min-w-0 bg-transparent border-b border-transparent text-sm font-semibold text-slate-800 focus:border-rose-500 outline-none dark:text-slate-200 disabled:opacity-60 sm:text-base sm:font-medium" value="<%= getDesc(fin) %>" onchange="updateRow(<%= fin.id %>, 'description', this.value)">
                                                        <% if (variable) { %>
                                                            <div class="flex flex-wrap items-center gap-2">
                                                                <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 px-2.5 py-1 text-[11px] font-bold text-sky-700 dark:bg-sky-900/30 dark:text-sky-300">
                                                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h10"></path></svg>
                                                                    Vários lançamentos
                                                                </span>
                                                                <span class="text-[11px] font-semibold leading-relaxed text-slate-500 dark:text-slate-400"><%= getVariableHint(fin) %></span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="w-40 min-w-[10rem] max-w-[10rem] self-start sm:w-48 sm:min-w-[12rem] sm:max-w-[12rem]">
                                                        <% if (variable) { %>
                                                            <button type="button" onclick="openVariableEditor(<%= fin.id %>)" class="w-full rounded-2xl border border-rose-200 bg-rose-50 px-2.5 py-2 text-right transition hover:border-rose-300 hover:bg-rose-100 dark:border-rose-900/40 dark:bg-rose-900/20 dark:hover:bg-rose-900/30 sm:px-3">
                                                                <span class="block font-mono text-[13px] font-black text-rose-700 dark:text-rose-300 sm:text-sm"><%= formatBRLFromCents(fin.amount_cents) %></span>
                                                                <span class="mt-1 block text-[10px] font-semibold leading-tight text-slate-500 dark:text-slate-400 sm:text-[11px]"><%= itemCount ? `${itemCount} lançamento${itemCount === 1 ? '' : 's'}` : (isClosed ? 'Abrir listinha' : 'Toque para preencher') %></span>
                                                            </button>
                                                        <% } else { %>
                                                            <input type="text" data-money-mask inputmode="numeric" <%= isClosed ? 'disabled' : '' %> class="w-full rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 font-mono text-[13px] font-black text-right text-rose-700 outline-none transition hover:border-rose-300 focus:border-rose-400 focus:ring-2 focus:ring-rose-500 disabled:opacity-60 dark:border-rose-900/40 dark:bg-rose-900/30 dark:text-rose-400 sm:text-sm" value="<%= getDisplayValue(fin) %>" onblur="saveMath(<%= fin.id %>, this.value)">
                                                        <% } %>
