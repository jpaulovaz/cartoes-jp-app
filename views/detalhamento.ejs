                                        Ainda não tem lançamento aqui. Adicione uma linha para começar a somar.
                                    </div>

                                    <div id="finance-items-list" class="space-y-3"></div>
                                </div>

                                <div id="finance-readonly-note" class="hidden rounded-[24px] border border-amber-200 bg-amber-50 px-4 py-4 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                                    Este mês está fechado. Pode conferir a listinha numa boa, mas editar fica pra quando ele for reaberto.
                                </div>
                            </div>

                            <div class="flex flex-col-reverse gap-3 border-t border-slate-200 px-5 py-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                                <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-4 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" data-finance-close>Fechar</button>
                                <button type="button" id="finance-save-btn" class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-700">Salvar item</button>
                            </div>
                        </section>
                    </div>
                </div>

                <div id="financeDeleteModal" aria-hidden="true" class="hidden fixed inset-0 z-[10031] bg-slate-950/60 backdrop-blur-sm px-3 py-3 sm:px-4 sm:py-8">
                    <div class="flex min-h-full items-end justify-center sm:items-center">
                        <section class="w-full max-w-xl overflow-hidden rounded-[30px] border border-slate-200 bg-white/95 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/95 dark:ring-slate-700" role="dialog" aria-modal="true" aria-labelledby="finance-delete-title">
                            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-800 sm:px-6">
                                <div>
                                    <div id="finance-delete-eyebrow" class="text-[11px] font-black uppercase tracking-[0.18em] text-rose-600 dark:text-rose-300">Apagar item</div>
                                    <h2 id="finance-delete-title" class="mt-1 text-xl font-black text-slate-900 dark:text-white">Tem certeza mesmo?</h2>
                                    <p id="finance-delete-subtitle" class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Se você confirmar, esse item sai da lista sem dar meia-volta.</p>
                                </div>
                                <button type="button" class="op-icon-btn shrink-0" data-finance-delete-close aria-label="Fechar janela">✕</button>
                            </div>

                            <div class="max-h-[65vh] space-y-4 overflow-y-auto px-5 py-5 sm:px-6">
                                <div class="rounded-[24px] border border-rose-200 bg-rose-50 px-4 py-4 dark:border-rose-900/40 dark:bg-rose-900/20">
                                    <div class="text-[11px] font-black uppercase tracking-[0.16em] text-rose-700 dark:text-rose-300">Total desse item</div>
                                    <div id="finance-delete-total" class="mt-2 text-2xl font-black text-rose-700 dark:text-rose-300">R$ 0,00</div>
                                </div>
                                <div id="finance-delete-items" class="space-y-3"></div>
                            </div>

                            <div class="flex flex-col-reverse gap-3 border-t border-slate-200 px-5 py-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                                <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-4 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" data-finance-delete-close>Voltar</button>
                                <button type="button" id="finance-delete-confirm" class="inline-flex items-center justify-center rounded-2xl bg-rose-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-rose-500/20 transition hover:bg-rose-700">Apagar item</button>
                            </div>
                        </section>
                    </div>
                </div>
            </div>

            <script>
                const detailMonth = <%- JSON.stringify(Number(month)) %>;
                const detailYear = <%- JSON.stringify(Number(year)) %>;
                const detailMonthIsClosed = <%- JSON.stringify(!!isClosed) %>;
                const financeModalState = {
                    action: 'create',
                    financeType: 'income',
                    amountMode: 'fixed',
                    financeId: null,
                    readOnly: false
                };
                const financeDeleteState = {
                    financeId: null,
                    amountMode: 'fixed'
                };
                const financeRefs = {
                    modal: document.getElementById('financeModal'),
                    eyebrow: document.getElementById('finance-modal-eyebrow'),
                    title: document.getElementById('finance-modal-title'),
                    subtitle: document.getElementById('finance-modal-subtitle'),
                    modeGroup: document.getElementById('finance-mode-group'),
                    modeButtons: Array.from(document.querySelectorAll('[data-finance-mode-btn]')),
                    descriptionLabel: document.getElementById('finance-description-label'),
                    descriptionInput: document.getElementById('finance-description-input'),
                    totalPreview: document.getElementById('finance-total-preview'),
                    totalCaption: document.getElementById('finance-total-caption'),
                    fixedPanel: document.getElementById('finance-fixed-panel'),
                    variablePanel: document.getElementById('finance-variable-panel'),
                    variableEmpty: document.getElementById('finance-variable-empty'),
                    itemsList: document.getElementById('finance-items-list'),
                    addItemButton: document.getElementById('finance-add-item-btn'),
                    readonlyNote: document.getElementById('finance-readonly-note'),
                    saveButton: document.getElementById('finance-save-btn'),
                    closeButtons: Array.from(document.querySelectorAll('[data-finance-close]')),
                    deleteModal: document.getElementById('financeDeleteModal'),
                    deleteEyebrow: document.getElementById('finance-delete-eyebrow'),
                    deleteTitle: document.getElementById('finance-delete-title'),
                    deleteSubtitle: document.getElementById('finance-delete-subtitle'),
                    deleteItems: document.getElementById('finance-delete-items'),
                    deleteTotal: document.getElementById('finance-delete-total'),
                    deleteConfirm: document.getElementById('finance-delete-confirm'),
                    deleteCloseButtons: Array.from(document.querySelectorAll('[data-finance-delete-close]'))
                };
                const brlFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

                function evaluateFormula(str) {
                    try {
                        let clean = String(str || '').replace(/R\$\s?/g, '').replace(/\s/g, '');
                        if (clean.includes(',')) {
                            clean = clean.replace(/\./g, '');
                            clean = clean.replace(/,/g, '.');
                        }
                        clean = clean.replace(/[^-+*/().0-9]/g, '');
                        return Function(`'use strict'; return (${clean || 0})`)();
                    } catch (e) {
                        return 0;
                    }
                }

                function formatCurrency(cents) {
                    return brlFormatter.format((Number(cents) || 0) / 100);
                }

                function getMoneyMaskApi() {
                    if (window.OPMoneyMask) return window.OPMoneyMask;
                    return {
                        bind() { },
                        toCents(value) {
                            const digits = String(value || '').replace(/\D/g, '');
                            return digits ? Number(digits) : 0;
                        },
                        formatFromCents(cents) {
                            const amount = (Number(cents) || 0) / 100;
                            return new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
                        }
                    };
                }

                function getDefaultItemDate() {
                    const today = new Date();
                    const currentMonthIndex = detailMonth - 1;
                    const targetMonth = String(detailMonth).padStart(2, '0');
                    if (today.getFullYear() === detailYear && today.getMonth() === currentMonthIndex) {
                        return today.toISOString().slice(0, 10);
                    }
                    return `${detailYear}-${targetMonth}-01`;
                }

                function getFinanceTypeLabel(type) {
                    return type === 'expense' ? 'saída' : 'entrada';
                }

                function formatFinanceItemDate(value) {
                    if (!value) return 'Sem data';
                    const parsed = new Date(`${value}T12:00:00`);
                    return Number.isNaN(parsed.getTime()) ? 'Sem data' : parsed.toLocaleDateString('pt-BR');
                }

                function createDeletePreviewCard({ title, meta, amountCents }) {
                    const row = document.createElement('div');
                    row.className = 'rounded-[22px] border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-950/60';

                    const top = document.createElement('div');
                    top.className = 'flex items-start justify-between gap-3';

                    const details = document.createElement('div');
                    const heading = document.createElement('div');
                    heading.className = 'text-sm font-bold text-slate-800 dark:text-white';
                    heading.textContent = title || 'Sem detalhe';
                    const metaNode = document.createElement('div');
                    metaNode.className = 'mt-1 text-xs font-medium text-slate-500 dark:text-slate-400';
                    metaNode.textContent = meta || 'Sem detalhe extra';
                    details.appendChild(heading);
                    details.appendChild(metaNode);

                    const amount = document.createElement('div');
                    amount.className = 'text-sm font-black text-rose-700 dark:text-rose-300';
                    amount.textContent = formatCurrency(amountCents || 0);

                    top.appendChild(details);
                    top.appendChild(amount);
                    row.appendChild(top);
                    return row;
                }

                function updateBodyLockState() {
                    const hasOpenModal = (financeRefs.modal && !financeRefs.modal.classList.contains('hidden')) || (financeRefs.deleteModal && !financeRefs.deleteModal.classList.contains('hidden'));
                    document.body.classList.toggle('overflow-hidden', !!hasOpenModal);
                }

                function showFinanceModal() {
                    if (!financeRefs.modal) return;
                    financeRefs.modal.classList.remove('hidden');
                    financeRefs.modal.setAttribute('aria-hidden', 'false');
                    updateBodyLockState();
                }

                function closeFinanceModal() {
                    if (!financeRefs.modal) return;
                    financeRefs.modal.classList.add('hidden');
                    financeRefs.modal.setAttribute('aria-hidden', 'true');
                    updateBodyLockState();
                }

                function showDeleteModal() {
                    if (!financeRefs.deleteModal) return;
                    financeRefs.deleteModal.classList.remove('hidden');
                    financeRefs.deleteModal.setAttribute('aria-hidden', 'false');
                    updateBodyLockState();
                }

                function closeDeleteModal() {
                    if (!financeRefs.deleteModal) return;
                    financeRefs.deleteModal.classList.add('hidden');
                    financeRefs.deleteModal.setAttribute('aria-hidden', 'true');
                    updateBodyLockState();
                }

                function createVariableItemRow(item = {}) {
                    const row = document.createElement('div');
                    row.className = 'rounded-[24px] border border-slate-200 bg-white px-4 py-4 shadow-sm dark:border-slate-700 dark:bg-slate-900';
                    row.dataset.variableItemRow = '1';
                    row.innerHTML = `
                        <div class="grid gap-3 md:grid-cols-[170px_minmax(0,1fr)_170px_auto] md:items-end">
                            <div>
                                <label class="block text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-2">Data</label>
                                <input type="date" data-variable-item-date class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900">
                            </div>
                            <div>
                                <label class="block text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-2">Origem ou detalhe</label>
                                <input type="text" data-variable-item-source class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900" placeholder="Ex: Festa do Pijama, posto, almoço no evento">
                            </div>
                            <div>
                                <label class="block text-[11px] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-2">Valor</label>
                                <input type="text" data-variable-item-amount class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2 text-right text-sm font-black text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900" inputmode="numeric" autocomplete="off" placeholder="0,00">
                            </div>
                            <div class="md:pb-[1px]">
                                <button type="button" data-variable-item-remove class="inline-flex w-full items-center justify-center rounded-2xl border border-rose-200 px-3 py-2 text-sm font-bold text-rose-600 transition hover:bg-rose-50 dark:border-rose-900/40 dark:text-rose-300 dark:hover:bg-rose-900/20">Remover</button>
                            </div>
                        </div>
                    `;

                    const dateInput = row.querySelector('[data-variable-item-date]');
                    const sourceInput = row.querySelector('[data-variable-item-source]');
                    const amountInput = row.querySelector('[data-variable-item-amount]');
                    const removeButton = row.querySelector('[data-variable-item-remove]');
                    const moneyMask = getMoneyMaskApi();

                    if (dateInput) dateInput.value = item.item_date || item.date || getDefaultItemDate();
                    if (sourceInput) sourceInput.value = item.item_source || item.source || '';
                    if (amountInput) {
                        amountInput.value = moneyMask.formatFromCents(Number(item.amount_cents || item.amountCents || 0));
                        moneyMask.bind(amountInput);
                        amountInput.addEventListener('input', refreshFinanceTotalPreview);
                        amountInput.addEventListener('change', refreshFinanceTotalPreview);
                    }
                    if (dateInput) {
                        dateInput.disabled = financeModalState.readOnly;
                        dateInput.addEventListener('input', refreshFinanceTotalPreview);
                        dateInput.addEventListener('change', refreshFinanceTotalPreview);
                    }
                    if (sourceInput) {
                        sourceInput.disabled = financeModalState.readOnly;
                        sourceInput.addEventListener('input', refreshFinanceTotalPreview);
                        sourceInput.addEventListener('change', refreshFinanceTotalPreview);
                    }
                    if (removeButton) {
                        removeButton.hidden = financeModalState.readOnly;
                        removeButton.addEventListener('click', () => {
                            row.remove();
                            syncVariableEmptyState();
                            refreshFinanceTotalPreview();
                        });
                    }

                    return row;
                }

                function syncVariableEmptyState() {
                    if (!financeRefs.variableEmpty || !financeRefs.itemsList) return;
                    const totalRows = financeRefs.itemsList.querySelectorAll('[data-variable-item-row]').length;
                    financeRefs.variableEmpty.classList.toggle('hidden', totalRows > 0);
                }

                function renderVariableItems(items = []) {
                    if (!financeRefs.itemsList) return;
                    financeRefs.itemsList.innerHTML = '';
                    items.forEach((item) => {
                        financeRefs.itemsList.appendChild(createVariableItemRow(item));
                    });
                    syncVariableEmptyState();
                    refreshFinanceTotalPreview();
                }

                function readVariableItems({ validate = false } = {}) {
                    if (!financeRefs.itemsList) return [];
                    const moneyMask = getMoneyMaskApi();
                    const rows = Array.from(financeRefs.itemsList.querySelectorAll('[data-variable-item-row]'));
                    const items = [];

                    rows.forEach((row) => {
                        const dateValue = (row.querySelector('[data-variable-item-date]')?.value || '').trim();
                        const sourceValue = (row.querySelector('[data-variable-item-source]')?.value || '').trim();
                        const amountValue = row.querySelector('[data-variable-item-amount]')?.value || '';
                        const amountCents = moneyMask.toCents(amountValue);
                        const hasAnyValue = !!dateValue || !!sourceValue || amountCents > 0;

                        if (!hasAnyValue) return;

                        if (validate && (!dateValue || !sourceValue || amountCents <= 0)) {
                            throw new Error('Em vários lançamentos, preencha data, origem e valor certinhos.');
                        }

                        items.push({ item_date: dateValue, item_source: sourceValue, amount_cents: amountCents });
                    });

                    return items;
                }

                function refreshFinanceTotalPreview() {
                    if (!financeRefs.totalPreview || !financeRefs.totalCaption) return;

                    if (financeModalState.amountMode !== 'variable') {
                        financeRefs.totalPreview.textContent = 'R$ 0,00';
                        financeRefs.totalCaption.textContent = 'O valor você ajusta direto na lista depois.';
                        return;
                    }

                    const items = readVariableItems();
                    const totalCents = items.reduce((sum, item) => sum + Number(item.amount_cents || 0), 0);
                    financeRefs.totalPreview.textContent = formatCurrency(totalCents);

                    if (!items.length) {
                        financeRefs.totalCaption.textContent = 'Sem lançamentos ainda. A linha principal pode ficar de prontidão.';
                    } else if (items.length === 1) {
                        financeRefs.totalCaption.textContent = '1 lançamento entrando nesse total.';
                    } else {
                        financeRefs.totalCaption.textContent = `${items.length} lançamentos entrando nesse total.`;
                    }
                }

                function setModeButtonState(activeMode) {
                    financeRefs.modeButtons.forEach((button) => {
                        const isActive = button.dataset.financeMode === activeMode;
                        button.className = `rounded-2xl border px-4 py-3 text-left text-sm font-bold transition-colors ${isActive
                            ? 'border-slate-900 bg-slate-900 text-white dark:border-slate-100 dark:bg-slate-100 dark:text-slate-900'
                            : 'border-slate-300 bg-slate-50 text-slate-600 hover:bg-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'}`;
                        button.disabled = financeModalState.readOnly || financeModalState.action !== 'create';
                    });
                }

                function applyFinanceModalState() {
                    const isCreate = financeModalState.action === 'create';
                    const isVariableMode = financeModalState.amountMode === 'variable';
                    const isIncome = financeModalState.financeType === 'income';

                    if (financeRefs.modeGroup) {
                        financeRefs.modeGroup.classList.toggle('hidden', !isCreate);
                    }
                    if (financeRefs.fixedPanel) {
                        financeRefs.fixedPanel.classList.toggle('hidden', isVariableMode);
                    }
                    if (financeRefs.variablePanel) {
                        financeRefs.variablePanel.classList.toggle('hidden', !isVariableMode);
                    }
                    if (financeRefs.readonlyNote) {
                        financeRefs.readonlyNote.classList.toggle('hidden', !financeModalState.readOnly);
                    }
                    if (financeRefs.addItemButton) {
                        financeRefs.addItemButton.hidden = !isVariableMode || financeModalState.readOnly;
                    }
                    if (financeRefs.saveButton) {
                        financeRefs.saveButton.classList.toggle('hidden', financeModalState.readOnly);
                    }
                    if (financeRefs.descriptionInput) {
                        financeRefs.descriptionInput.disabled = financeModalState.readOnly;
                    }

                    setModeButtonState(financeModalState.amountMode);
                    syncVariableEmptyState();
                    refreshFinanceTotalPreview();

                    if (isCreate) {
                        financeRefs.eyebrow.textContent = isIncome ? 'Nova entrada' : 'Nova saída';
                        financeRefs.title.textContent = isVariableMode
                            ? (isIncome ? 'Montar uma entrada em vários lançamentos' : 'Montar uma saída em vários lançamentos')
                            : (isIncome ? 'Criar uma entrada de valor único' : 'Criar uma saída de valor único');
                        financeRefs.subtitle.textContent = isVariableMode
                            ? 'Você dá um nome principal e soma cada pedacinho na listinha abaixo.'
                            : 'Salva o nome agora e o valor fica no toque rápido lá na lista.';
                        financeRefs.descriptionLabel.textContent = isIncome ? 'Nome da entrada' : 'Nome da saída';
                        financeRefs.descriptionInput.placeholder = isIncome ? 'Ex: Shows, Salário, Freelas' : 'Ex: Combustível, Alimentação, Operação';
                        financeRefs.saveButton.textContent = 'Salvar item';
                    } else {
                        const baseName = (financeRefs.descriptionInput.value || 'item com vários lançamentos').trim();
                        financeRefs.eyebrow.textContent = financeModalState.readOnly ? 'Listinha em modo leitura' : 'Editar lançamentos';
                        financeRefs.title.textContent = financeModalState.readOnly ? `Conferir ${baseName}` : `Ajustar ${baseName}`;
                        financeRefs.subtitle.textContent = financeModalState.readOnly
                            ? 'Pode dar aquela conferida. Para mexer, é só reabrir o mês.'
                            : 'Tudo que você mexer aqui já recalcula o total que aparece na tela.';
                        financeRefs.descriptionLabel.textContent = 'Nome principal';
                        financeRefs.descriptionInput.placeholder = 'Ex: Shows';
                        financeRefs.saveButton.textContent = 'Salvar listinha';
                    }
                }

                function resetFinanceModalState() {
                    financeModalState.action = 'create';
                    financeModalState.financeType = 'income';
                    financeModalState.amountMode = 'fixed';
                    financeModalState.financeId = null;
                    financeModalState.readOnly = false;
                }

                async function fetchJson(url, options = {}) {
                    const fetchOptions = { ...options };
                    fetchOptions.headers = { ...(options.headers || {}) };
                    if (fetchOptions.body && !fetchOptions.headers['Content-Type']) {
                        fetchOptions.headers['Content-Type'] = 'application/json';
                    }

                    const response = await fetch(url, fetchOptions);
                    let data = {};
                    try {
                        data = await response.json();
                    } catch (e) {
                        data = {};
                    }

                    if (!response.ok) {
                        throw new Error(data.error || 'Não consegui concluir essa parte agora.');
                    }

                    return data;
                }

                async function saveFinanceModal() {
                    if (financeModalState.readOnly) return;
                    const description = (financeRefs.descriptionInput?.value || '').trim();
                    if (!description) {
                        alert('Dá um nome para esse item antes de salvar.');
                        financeRefs.descriptionInput?.focus();
                        return;
                    }

                    try {
                        const payload = {
                            description,
                            items: financeModalState.amountMode === 'variable' ? readVariableItems({ validate: true }) : []
                        };

                        if (financeModalState.action === 'create') {
                            payload.month = detailMonth;
                            payload.year = detailYear;
                            payload.type = financeModalState.financeType;
                            payload.amount_mode = financeModalState.amountMode;
                            await fetchJson('/finances/add-row', {
                                method: 'POST',
                                body: JSON.stringify(payload)
                            });
                        } else {
                            await fetchJson(`/finances/variable/${financeModalState.financeId}`, {
                                method: 'POST',
                                body: JSON.stringify(payload)
                            });
                        }

                        location.reload();
                    } catch (error) {
                        alert(error.message || 'Não consegui salvar esse item agora.');
                    }
                }

                function calculatePad() {
                    const text = document.getElementById('calc-pad')?.value || '';
                    let sum = 0;
                    text.split('\n').forEach((line) => {
                        const val = evaluateFormula(line);
                        if (val) sum += val;
                    });
                    const resultNode = document.getElementById('calc-result');
                    if (resultNode) {
                        resultNode.innerText = `Fechou em: ${sum.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}`;
                    }
                }

                async function updateRow(id, field, value) {
                    try {
                        await fetchJson(`/finances/update/${id}`, {
                            method: 'POST',
                            body: JSON.stringify({ field, value })
                        });
                    } catch (error) {
                        alert(error.message || 'Não consegui atualizar esse item agora.');
                        location.reload();
                    }
                }

                async function saveMath(id, inputStr) {
                    const result = evaluateFormula(inputStr);
                    try {
                        await fetchJson(`/finances/update/${id}`, {
                            method: 'POST',
                            body: JSON.stringify({ field: 'formula_and_value', formula: inputStr, amount_cents: Math.round(result * 100) })
                        });
                        location.reload();
                    } catch (error) {
                        alert(error.message || 'Não consegui salvar esse valor agora.');
                        location.reload();
                    }
                }

                async function saveNotes(type, content) {
                    try {
                        await fetchJson(`/finances/notes/<%= year %>/<%= month %>`, {
                            method: 'POST',
                            body: JSON.stringify({ type, content })
                        });
                    } catch (error) {
                        alert(error.message || 'Não consegui salvar essa anotação agora.');
                    }
                }

                async function toggleLock(status) {
                    const msg = status === 'close'
                        ? 'Deseja FECHAR este mês? Você não poderá mais editar os valores até reabrir.'
                        : 'Deseja REABRIR este mês para edições?';

                    if (!confirm(msg)) return;

                    try {
                        await fetchJson('/finances/toggle-close', {
                            method: 'POST',
                            body: JSON.stringify({ month: <%= month %>, year: <%= year %>, status })
                        });
                        location.reload();
                    } catch (error) {
                        alert(error.message || 'Não consegui mudar o cadeado agora.');
                    }
                }

                async function deleteRow(id, amountMode) {
                    try {
                        const data = await fetchJson(`/finances/details/${id}`);
                        const finance = data.finance || {};
                        const resolvedAmountMode = (finance.amount_mode || amountMode || 'fixed') === 'variable' ? 'variable' : 'fixed';
                        const financeLabel = getFinanceTypeLabel(finance.type);
                        const items = Array.isArray(finance.items) ? finance.items : [];

                        financeDeleteState.financeId = finance.id;
                        financeDeleteState.amountMode = resolvedAmountMode;

                        if (financeRefs.deleteEyebrow) {
                            financeRefs.deleteEyebrow.textContent = resolvedAmountMode === 'variable'
                                ? `Apagar ${financeLabel} em vários lançamentos`
                                : `Apagar ${financeLabel} de valor único`;
                        }
                        if (financeRefs.deleteTitle) {
                            financeRefs.deleteTitle.textContent = resolvedAmountMode === 'variable'
                                ? 'Tem certeza mesmo?'
                                : 'Vai tirar esse item da lista?';
                        }
                        if (financeRefs.deleteSubtitle) {
                            financeRefs.deleteSubtitle.textContent = resolvedAmountMode === 'variable'
                                ? (items.length
                                    ? `Ao apagar ${finance.description || 'esse item'}, vai tudo isso junto no pacote:`
                                    : `Ao apagar ${finance.description || 'esse item'}, o nome principal também some da lista.`)
                                : `Ao apagar ${finance.description || 'esse item'}, ele sai da lista na hora. Se bater dúvida, ainda dá tempo de voltar.`;
                        }
                        if (financeRefs.deleteConfirm) {
                            financeRefs.deleteConfirm.textContent = resolvedAmountMode === 'variable' ? 'Apagar tudo' : 'Apagar item';
                        }
                        if (financeRefs.deleteTotal) {
                            financeRefs.deleteTotal.textContent = formatCurrency(finance.amount_cents || 0);
                        }
                        if (financeRefs.deleteItems) {
                            financeRefs.deleteItems.innerHTML = '';
                        }

                        if (!financeRefs.deleteItems) {
                            showDeleteModal();
                            return;
                        }

                        if (resolvedAmountMode === 'variable') {
                            if (!items.length) {
                                const emptyState = document.createElement('div');
                                emptyState.className = 'rounded-[22px] border border-dashed border-slate-300 bg-slate-50 px-4 py-4 text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-400';
                                emptyState.textContent = 'Esse item está zerado agora, mas apagar remove o nome principal da tela também.';
                                financeRefs.deleteItems.appendChild(emptyState);
                            } else {
                                items.forEach((item) => {
                                    financeRefs.deleteItems.appendChild(createDeletePreviewCard({
                                        title: item.item_source || 'Sem detalhe',
                                        meta: formatFinanceItemDate(item.item_date),
                                        amountCents: item.amount_cents || 0
                                    }));
                                });
                            }
                        } else {
                            const formulaText = String(finance.formula || '').trim();
                            financeRefs.deleteItems.appendChild(createDeletePreviewCard({
                                title: finance.description || `Essa ${financeLabel}`,
                                meta: formulaText ? `Conta guardada: ${formulaText}` : 'Valor único salvo para este mês.',
                                amountCents: finance.amount_cents || 0
                            }));
                        }

                        showDeleteModal();
                    } catch (error) {
                        alert(error.message || 'Não consegui abrir os detalhes desse item agora.');
                    }
                }

                async function openVariableEditor(id) {
                    try {
                        const data = await fetchJson(`/finances/details/${id}`);
                        const finance = data.finance || {};
                        financeModalState.action = 'edit';
                        financeModalState.financeType = finance.type || 'income';
                        financeModalState.amountMode = 'variable';
                        financeModalState.financeId = finance.id;
                        financeModalState.readOnly = !!data.isClosed;
                        financeRefs.descriptionInput.value = finance.description || '';
                        renderVariableItems(Array.isArray(finance.items) ? finance.items : []);
                        applyFinanceModalState();
                        showFinanceModal();
                        if (!financeModalState.readOnly) {
                            requestAnimationFrame(() => financeRefs.descriptionInput?.focus());
                        }
                    } catch (error) {
                        alert(error.message || 'Não consegui abrir essa listinha agora.');
                    }
                }

                function openFinanceCreator(type) {
                    resetFinanceModalState();
                    financeModalState.financeType = type === 'expense' ? 'expense' : 'income';
                    financeRefs.descriptionInput.value = '';
                    renderVariableItems([]);
                    applyFinanceModalState();
                    showFinanceModal();
                    requestAnimationFrame(() => financeRefs.descriptionInput?.focus());
                }

                financeRefs.modeButtons.forEach((button) => {
                    button.addEventListener('click', () => {
                        financeModalState.amountMode = button.dataset.financeMode === 'variable' ? 'variable' : 'fixed';
                        applyFinanceModalState();
                    });
                });

                financeRefs.closeButtons.forEach((button) => {
                    button.addEventListener('click', closeFinanceModal);
                });

                financeRefs.deleteCloseButtons.forEach((button) => {
                    button.addEventListener('click', closeDeleteModal);
                });

                financeRefs.addItemButton?.addEventListener('click', () => {
                    financeRefs.itemsList.appendChild(createVariableItemRow());
                    syncVariableEmptyState();
                    refreshFinanceTotalPreview();
                });

                financeRefs.saveButton?.addEventListener('click', saveFinanceModal);
                financeRefs.descriptionInput?.addEventListener('input', () => {
                    if (financeModalState.action === 'edit') {
                        applyFinanceModalState();
                    }
                });

                financeRefs.deleteConfirm?.addEventListener('click', async () => {
                    if (!financeDeleteState.financeId) return;
                    try {
                        await fetchJson(`/finances/delete/${financeDeleteState.financeId}`, { method: 'POST' });
                        location.reload();
                    } catch (error) {
                        alert(error.message || 'Não consegui apagar esse item agora.');
                    }
                });

                financeRefs.modal?.addEventListener('click', (event) => {
                    if (event.target === financeRefs.modal) {
                        closeFinanceModal();
                    }
                });

                financeRefs.deleteModal?.addEventListener('click', (event) => {
                    if (event.target === financeRefs.deleteModal) {
                        closeDeleteModal();
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key !== 'Escape') return;
                    if (financeRefs.deleteModal && !financeRefs.deleteModal.classList.contains('hidden')) {
                        closeDeleteModal();
                        return;
                    }
                    if (financeRefs.modal && !financeRefs.modal.classList.contains('hidden')) {
                        closeFinanceModal();
                    }
                });

                document.addEventListener('DOMContentLoaded', () => {
                    calculatePad();
                    applyFinanceModalState();
                });
            </script>

            <%- include('partials/footer') %>