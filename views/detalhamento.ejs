                    </div>
                </div>

                <div id="financeModal" aria-hidden="true" class="hidden fixed inset-0 z-[10030] bg-slate-950/60 backdrop-blur-sm px-3 py-3 sm:px-4 sm:py-8">
                    <div class="flex min-h-full items-end justify-center sm:items-center">
                        <section class="w-full max-w-3xl overflow-hidden rounded-[30px] border border-slate-200 bg-white/95 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/95 dark:ring-slate-700" role="dialog" aria-modal="true" aria-labelledby="finance-modal-title">
                            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-800 sm:px-6">
                                <div>
                                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300" id="finance-modal-eyebrow">Nova entrada</div>
                                    <h2 id="finance-modal-title" class="mt-1 text-xl font-black text-slate-900 dark:text-white">Criar item</h2>
                                    <p id="finance-modal-subtitle" class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Escolha o jeito certo e deixe a conta redondinha.</p>
                                </div>
                                <button type="button" class="op-icon-btn shrink-0" data-finance-close aria-label="Fechar janela">✕</button>
                            </div>

                            <div class="max-h-[72vh] space-y-5 overflow-y-auto px-5 py-5 sm:px-6">
                                <div id="finance-mode-group" class="grid grid-cols-2 gap-2">
                                    <button type="button" data-finance-mode-btn data-finance-mode="fixed" class="rounded-2xl border px-4 py-3 text-left text-sm font-bold transition-colors">Valor único</button>
                                    <button type="button" data-finance-mode-btn data-finance-mode="variable" class="rounded-2xl border px-4 py-3 text-left text-sm font-bold transition-colors">Vários lançamentos</button>
                                </div>

                                <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_220px] md:items-start">
                                    <div>
                                        <label for="finance-description-input" id="finance-description-label" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Nome da entrada</label>
                                        <input id="finance-description-input" type="text" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:bg-slate-950" placeholder="Ex: Shows, Salário, Freelas">
                                    </div>
