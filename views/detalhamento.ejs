<%- include("partials/header", { title: "AcerttaPay | 👑 Meu Controle" }) %>

    <% 
        let incCents = 0;
        let expCents = 0;
        finances.forEach((f) => {
            if (f.type === 'income') incCents += f.amount_cents;
            if (f.type === 'expense') expCents += f.amount_cents;
        });

        const sharedDebtTrailModule = sharedDebtDetailModuleSummary || {};
        const sharedDebtTrailPay = sharedDebtTrailModule.pay || {};
        const sharedDebtTrailReceive = sharedDebtTrailModule.receive || {};
        const sharedDebtTrailManual = sharedDebtTrailModule.manual || {};
        const sharedDebtTrailCard = sharedDebtTrailModule.card || {};
        const sharedDebtTrailChips = Array.isArray(sharedDebtTrailModule.chips) ? sharedDebtTrailModule.chips : [];
        const sharedDebtTrailHeaderHref = sharedDebtTrailModule.headerHref || '/shared-debts';

        const cardHealthModule = cardHealthDetailModuleSummary || {};
        const cardHealthCurrent = cardHealthModule.current || {};
        const cardHealthFuture = cardHealthModule.future || {};
        const cardHealthThird = cardHealthModule.thirdParties || {};
        const cardHealthRadar = cardHealthModule.radar || {};
        const cardHealthChips = Array.isArray(cardHealthModule.chips) ? cardHealthModule.chips : [];
        const cardHealthCompact = cardHealthModule.compact || {};
        const cardHealthUseCompact = !!cardHealthModule.useCompactState;
        const cardHealthPrimaryCta = cardHealthModule.primaryCta || { href: `/summary/${year}/${month}`, label: 'Fechamento do mês' };
        const cardHealthSecondaryCta = cardHealthModule.secondaryCta || { href: '/geral', label: 'Ver cartões' };
        const saldoCents = incCents - expCents - cardTotalCents;

        let prevM = parseInt(month, 10) - 1;
        let prevY = parseInt(year, 10);
        if (prevM < 1) { prevM = 12; prevY--; }
        let nextM = parseInt(month, 10) + 1;
        let nextY = parseInt(year, 10);
        if (nextM > 12) { nextM = 1; nextY++; }

        const heroOwnerName = String((owner && owner.name) || '').trim().split(/\s+/).filter(Boolean).slice(0, 2).join(' ') || 'Seu painel';
        const incomeFinances = finances.filter((f) => f.type === 'income');
        const expenseFinances = finances.filter((f) => f.type === 'expense');
        const expenseProgress = expensePaymentProgress || {};
        const cardProgress = cardPaymentProgress || {};

        function clampProgressPct(value) {
            const pct = Number(value || 0);
            if (!Number.isFinite(pct)) return 0;
            return Math.max(0, Math.min(100, Math.round(pct)));
        }

        function isVariable(fin) {
            return (fin.amount_mode || 'fixed') === 'variable';
        }

        function buildFinancePaymentState(fin) {
            const totalCents = Math.max(0, Number(fin.amount_cents || 0));

            if (!isVariable(fin)) {
                const isPaid = Number(fin.is_paid || 0) === 1;
                const paidCents = isPaid ? totalCents : 0;
                return {
                    mode: 'fixed',
                    isPaid,
                    totalItemCount: totalCents > 0 ? 1 : 0,
                    paidItemCount: isPaid && totalCents > 0 ? 1 : 0,
                    totalCents,
                    paidCents,
                    remainingCents: Math.max(0, totalCents - paidCents),
                    progressPct: totalCents > 0 ? clampProgressPct((paidCents / totalCents) * 100) : 0,
                    isComplete: totalCents > 0 && paidCents >= totalCents
                };
            }

            const items = Array.isArray(fin.items) ? fin.items : [];
            const paidItems = items.filter((item) => Number(item.is_paid || 0) === 1);
            const paidCents = paidItems.reduce((sum, item) => sum + Math.max(0, Number(item.amount_cents || 0)), 0);
            return {
                mode: 'variable',
                isPaid: items.length > 0 && paidItems.length === items.length,
                totalItemCount: items.length,
                paidItemCount: paidItems.length,
                totalCents,
                paidCents,
                remainingCents: Math.max(0, totalCents - paidCents),
                progressPct: totalCents > 0 ? clampProgressPct((paidCents / totalCents) * 100) : 0,
                isComplete: totalCents > 0 && paidCents >= totalCents
            };
        }

        function getProgressCardStyle(progress) {
            return `--op-paid-progress:${clampProgressPct(progress && progress.progressPct)}%;`;
        }

        function getDisplayValue(fin) {
            if (isVariable(fin)) return formatBRLFromCents(fin.amount_cents);
            const hasMath = fin.formula && /[-+*/]/.test(fin.formula);
            if (hasMath) return fin.formula;
            return formatBRLFromCents(fin.amount_cents);
        }

        function getDesc(fin) {
            if (fin.description) return fin.description;
            if (fin.category_id) {
                const cat = categories.find((c) => c.id === fin.category_id);
                return cat ? cat.name : 'Item de valor único';
            }
            return '';
        }

        function getItemCount(fin) {
            return Array.isArray(fin.items) ? fin.items.length : 0;
        }

        function getVariableHint(fin) {
            const paymentState = buildFinancePaymentState(fin);
            const totalItems = getItemCount(fin);
            if (!totalItems) return 'Ainda sem lançamentos por aqui';

            const baseLabel = totalItems === 1 ? '1 lançamento somando esse total' : `${totalItems} lançamentos somando esse total`;
            if (!paymentState.paidItemCount) return `${baseLabel} · Nada marcado como pago ainda`;
            if (paymentState.paidItemCount === totalItems) return `${baseLabel} · Tudo já foi pago`;
            return `${baseLabel} · ${paymentState.paidItemCount} de ${totalItems} pagos`;
        }

        function getFinanceScheduleMeta(fin) {
            return (fin && fin.schedule_meta) ? fin.schedule_meta : {};
        }

        function financeScheduleChipClasses(fin, scheduleMeta) {
            const tone = String((scheduleMeta && scheduleMeta.tone) || '').trim();
            const isToday = !!(scheduleMeta && scheduleMeta.isToday);
            if (isToday) {
                return fin.type === 'expense'
                    ? 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100'
                    : 'border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-700 dark:bg-sky-900/30 dark:text-sky-100';
            }
            if (tone === 'success') return 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-100';
            if (tone === 'warning') return 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100';
            if (tone === 'info') return 'border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-700 dark:bg-sky-900/30 dark:text-sky-100';
            return 'border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200';
        }

        function financeScheduleButtonClasses(fin, scheduleMeta) {
            const isToday = !!(scheduleMeta && scheduleMeta.isToday);
            const hasSchedule = !!(scheduleMeta && scheduleMeta.hasSchedule);
            if (isToday) {
                return fin.type === 'expense'
                    ? 'border-amber-300 bg-amber-50 text-amber-900 hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100 dark:hover:bg-amber-900/40'
                    : 'border-sky-300 bg-sky-50 text-sky-800 hover:bg-sky-100 dark:border-sky-700 dark:bg-sky-900/30 dark:text-sky-100 dark:hover:bg-sky-900/40';
            }
            if (hasSchedule) {
                return fin.type === 'expense'
                    ? 'border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 dark:border-rose-900/40 dark:bg-rose-900/20 dark:text-rose-200 dark:hover:bg-rose-900/30'
                    : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:border-emerald-900/40 dark:bg-emerald-900/20 dark:text-emerald-200 dark:hover:bg-emerald-900/30';
            }
            return 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200 dark:hover:bg-slate-800';
        }

        function sharedDebtTrailChipClasses(tone) {
            if (tone === 'warning') return 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100';
            if (tone === 'success') return 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-100';
            if (tone === 'info') return 'border-sky-200 bg-sky-50 text-sky-900 dark:border-sky-700 dark:bg-sky-900/30 dark:text-sky-100';
            return 'border-slate-200 bg-white text-slate-700 dark:border-slate-600 dark:bg-slate-900/70 dark:text-slate-200';
        }

        function buildSharedDebtTrailCountLabel(count) {
            const total = Number(count || 0);
            if (total <= 0) return 'Nenhuma cobrança em aberto por aqui';
            return total === 1 ? '1 cobrança em aberto por aqui' : `${total} cobranças em aberto por aqui`;
        }

        function buildSharedDebtTrailBreakdown(scope) {
            const parts = [];

            if (scope === 'pay') {
                const cardCount = Number(sharedDebtTrailCard.owedItemCount || 0);
                const manualCount = Number(sharedDebtTrailManual.owedCount || 0);

                if (cardCount > 0) parts.push(cardCount === 1 ? '1 item do cartão' : `${cardCount} itens do cartão`);
                if (manualCount > 0) parts.push(manualCount === 1 ? '1 cobrança avulsa' : `${manualCount} cobranças avulsas`);
            } else {
                const cardCount = Number(sharedDebtTrailCard.receivableItemCount || 0);
                const manualCount = Number(sharedDebtTrailManual.receivableCount || 0);
                const privateCount = Number(sharedDebtTrailManual.privateActiveCount || 0);

                if (cardCount > 0) parts.push(cardCount === 1 ? '1 item do cartão' : `${cardCount} itens do cartão`);
                if (manualCount > 0) parts.push(manualCount === 1 ? '1 cobrança avulsa' : `${manualCount} cobranças avulsas`);
                if (privateCount > 0) parts.push(privateCount === 1 ? '1 lembrete privado' : `${privateCount} lembretes privados`);
            }

            if (!parts.length) return 'Fica só no lembrete. Não entra no saldo do topo.';
            return `${parts.join(' • ')}. Fica só no lembrete. Não entra no saldo do topo.`;
        }

        function buildSharedDebtTrailCtaLabel(scope) {
            if (scope === 'pay') return 'Abrir cobranças recebidas';
            const receiveHref = String(sharedDebtTrailReceive.href || '');
            const hasOnlyPrivate = Number(sharedDebtTrailManual.receivableCount || 0) === 0
                && Number(sharedDebtTrailCard.receivableItemCount || 0) === 0
                && Number(sharedDebtTrailManual.privateActiveCount || 0) > 0;
            if (hasOnlyPrivate || receiveHref.includes('#private-reminders')) return 'Abrir lembretes privados';
            return 'Abrir cobranças enviadas';
        }

        function healthChipClasses(tone) {
            if (tone === 'warning') return 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100';
            if (tone === 'success') return 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-100';
            return 'border-slate-200 bg-white text-slate-700 dark:border-slate-600 dark:bg-slate-900/70 dark:text-slate-200';
        }

        function healthCompactBadgeClasses(tone) {
            if (tone === 'warning') return 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-100';
            if (tone === 'success') return 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-100';
            return 'border-slate-200 bg-white text-slate-700 dark:border-slate-600 dark:bg-slate-900/70 dark:text-slate-200';
        }

        function healthRadarItemClasses(tone) {
            if (tone === 'warning') return 'border-amber-200 bg-amber-50/80 dark:border-amber-800 dark:bg-amber-900/20';
            if (tone === 'success') return 'border-emerald-200 bg-emerald-50/80 dark:border-emerald-800 dark:bg-emerald-900/20';
            return 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/60';
        }
    %>

            <div class="op-screen op-screen--detalhamento max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
                data-month-swipe-area
                data-month-swipe-prev="/detalhamento/<%= prevY %>/<%= prevM %>"
                data-month-swipe-next="/detalhamento/<%= nextY %>/<%= nextM %>"
                style="touch-action: pan-y pinch-zoom;">

                <section class="op-page-hero op-fade-up mb-8">
                    <div>
                        <span class="op-page-hero__eyebrow">Painel principal</span>
                        <h1 class="op-page-hero__title mt-4">👑 Meu Controle</h1>
                        <p class="op-page-hero__subtitle mt-3"><span class="font-bold text-blue-600 dark:text-blue-300"><%= heroOwnerName %></span>, aqui você vê o que entrou, o que saiu, os cartões e o respiro do mês sem ficar abrindo mil telas.</p>
                    </div>

                    <div class="op-page-hero__actions w-full lg:max-w-[32rem]">
                        <% if (isClosed) { %>
                            <button onclick="toggleLock('open')"
                                class="op-btn op-btn-danger-soft op-btn--block">
                                🔒 Mês Fechado
                            </button>
                        <% } else { %>
                            <button onclick="toggleLock('close')"
                                class="op-btn op-btn-success op-btn--block">
                                🔓 Fechar Mês
                            </button>
                        <% } %>

                        <button type="button" data-manual-modal-open
                            <%= (isClosed || !cards || !cards.length) ? 'disabled' : '' %>
                            class="op-btn op-btn-success op-btn--block <%= (isClosed || !cards || !cards.length) ? 'opacity-60 cursor-not-allowed' : '' %>">
                            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Nova compra
                        </button>

                        <div class="col-span-2 w-full flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 p-1 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/70">
                            <a href="/detalhamento/<%= prevY %>/<%= prevM %>"
                                class="op-btn op-btn-ghost flex-1">&larr; Anterior</a>
                            <a href="/month/<%= year %>/<%= month %>"
                                class="op-btn op-btn-primary whitespace-nowrap px-4">
                                <%= String(month).padStart(2, '0' ) %> / <%= year %>
                            </a>
                            <a href="/detalhamento/<%= nextY %>/<%= nextM %>"
                                class="op-btn op-btn-ghost flex-1">Próximo &rarr;</a>
                        </div>
                    </div>
                </section>


                <% if (alerts && alerts.length) { %>
                    <div class="mb-8 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
                            <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Olho vivo no mês</h2>
                            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Os pontos que merecem sua atenção antes que virem dor de cabeça.</p>
                        </div>
                        <div class="p-4 md:p-5 grid gap-3">
                            <% alerts.forEach(alert => { %>
                                <div class="rounded-2xl border px-4 py-3 <%= alert.type === 'warning' ? 'border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-900/20' : 'border-blue-200 bg-blue-50 dark:border-blue-800 dark:bg-blue-900/20' %>">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-white"><%= alert.icon %> <%= alert.title %></div>
                                            <div class="text-sm text-slate-600 dark:text-slate-300 mt-1"><%= alert.description %></div>
                                        </div>
                                        <% if (alert.href) { %>
                                            <a href="<%= alert.href %>" class="op-btn op-btn-ghost px-4 py-2 text-sm">Abrir</a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>


                <div id="modalManualDetalhamento" data-manual-modal aria-hidden="true"
                    class="hidden fixed inset-0 z-[10020] bg-slate-900/60 backdrop-blur-sm px-3 py-3 sm:px-4 sm:py-6">
                    <div class="pointer-events-none flex min-h-full items-end justify-center sm:items-center">
                      <div class="pointer-events-auto flex w-full max-w-lg flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-800 lg:max-w-4xl xl:max-w-5xl max-h-[calc(100dvh-1rem)] sm:max-h-[calc(100dvh-2rem)]">
                        <div class="flex shrink-0 justify-between items-center border-b border-slate-200 px-4 py-4 sm:px-6 dark:border-slate-700">
                            <h2 class="text-xl font-black text-slate-800 dark:text-white">Adicionar compra</h2>
                            <button type="button" data-manual-modal-close
                                class="op-icon-btn" aria-label="Fechar janela">✕</button>
                        </div>

                        <div class="op-manual-modal__scroll flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-6"><form action="/txn/manual" method="POST" class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0" data-auto-first-due-form>
                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Data da Compra</label>
                                    <input type="date" name="date" required data-manual-date-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Cartão</label>
                                    <select name="card_id" data-manual-card-select <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                        <% cards.forEach(c => { %>
                                            <option value="<%= c.id %>" data-close-day="<%= c.close_day || '' %>" data-due-day="<%= c.due_day || '' %>">
                                                <%= c.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Valor Total (R$)</label>
                                    <input type="text" name="amount" placeholder="0,00" required data-money-mask data-manual-amount-input inputmode="decimal" enterkeyhint="next" autocapitalize="off" autocomplete="off" <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Parcelas</label>
                                    <input type="number" name="installments" value="1" min="1" max="99" required data-installments-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Vai cair em qual fatura?</label>
                                <input type="month" name="first_due" value="<%= year %>-<%= String(month).padStart(2, '0') %>" required data-manual-first-due <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">A gente sugere isso pela data da compra e pelo fechamento do cartão. Se precisar, pode ajustar sem cerimônia.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Descrição</label>
                                <input type="text" name="description" placeholder="Ex: Monitor Dell" required <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                            </div>

                            <div data-purchase-category-control class="space-y-3 lg:col-span-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Categoria (opcional)</label>
                                    <select name="purchase_category_id" data-purchase-category-select <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                        <option value="">Sem categoria por enquanto</option>
                                        <% (purchaseCategories || []).forEach(category => { %>
                                            <option value="<%= category.id %>"><%= category.name %></option>
                                        <% }) %>
                                        <option value="__new__">Criar categoria nova</option>
                                    </select>
                                    <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">Se quiser, você já organiza agora. Se não quiser, tudo bem também.</p>
                                </div>
                                <div data-purchase-category-custom-shell hidden>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Nome da nova categoria</label>
                                    <input type="text" name="purchase_category_custom" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input disabled <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                            </div>

                            <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= typeof isClosed !== 'undefined' && isClosed ? 'opacity-60' : '' %>">
          <input type="checkbox" name="assign_to_owner" value="1" <%= typeof isClosed !== 'undefined' && isClosed ? 'disabled' : '' %>
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Essa ficou comigo</span>
