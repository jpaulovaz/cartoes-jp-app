                            </div>
                            <div class="p-6">
                                <textarea id="calc-pad" <%= isClosed ? 'disabled' : '' %> class="w-full font-mono text-sm bg-slate-50 dark:bg-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 outline-none disabled:opacity-60" rows="5" placeholder="Ex: 50 + 20" oninput="calculatePad()" onchange="saveNotes('math', this.value)"><%= notes.content_math %></textarea>
                                <div class="mt-3 text-right text-lg font-black text-blue-700 dark:text-blue-400" id="calc-result">Fechou em: R$ 0,00</div>
