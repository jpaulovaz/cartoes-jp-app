<%- include('partials/header') %>

    <% /* Calculo de saldo */ let incCents=0; let expCents=0; finances.forEach(f=> {
        if(f.type === 'income') incCents += f.amount_cents;
        if(f.type === 'expense') expCents += f.amount_cents;
        });

        let saldoCents = incCents - expCents - cardTotalCents;

        /* Lógica para botões de Mês Anterior / Próximo */
        let prevM = parseInt(month) - 1; let prevY = parseInt(year);
        if (prevM < 1) { prevM=12; prevY--; } let nextM=parseInt(month) + 1; let nextY=parseInt(year); if (nextM> 12) {
            nextM = 1; nextY++; }

            /* Funções visuais para os campos */
            function getDisplayValue(fin) {
            const hasMath = fin.formula && /[-+*/]/.test(fin.formula);
            if (hasMath) return fin.formula;
            return formatBRLFromCents(fin.amount_cents);
            }

            function getDesc(fin) {
            if (fin.description) return fin.description;
            if (fin.category_id) {
            const cat = categories.find(c => c.id === fin.category_id);
            return cat ? cat.name : 'Conta Fixa';
            }
            return '';
            }
            %>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

                <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">👑 Meu
                            Detalhamento</h1>
                        <p class="text-slate-500 mt-1 font-medium">Titular: <span class="text-blue-600">
                                <%= owner.name %>
                            </span></p>
                    </div>

                    <div class="flex items-center gap-3">
                        <% if (isClosed) { %>
                            <button onclick="toggleLock('open')"
                                class="px-4 py-2 bg-rose-100 text-rose-700 hover:bg-rose-200 dark:bg-rose-900 dark:text-rose-300 rounded-xl text-sm font-bold shadow-sm transition-colors flex items-center gap-2">
                                🔒 Mês Fechado
                            </button>
                            <% } else { %>
                                <button onclick="toggleLock('close')"
                                    class="px-4 py-2 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 dark:bg-emerald-900 dark:text-emerald-300 rounded-xl text-sm font-bold shadow-sm transition-colors flex items-center gap-2">
                                    🔓 Fechar Mês
                                </button>
                                <% } %>

                                    <div
                                        class="flex items-center gap-2 bg-white dark:bg-slate-800 p-1 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
                                        <a href="/detalhamento/<%= prevY %>/<%= prevM %>"
                                            class="px-3 py-2 bg-slate-50 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-lg text-sm font-bold transition-colors">&larr;
                                            Anterior</a>
                                        <div
                                            class="px-4 py-2 bg-slate-900 dark:bg-slate-950 text-white rounded-lg text-sm font-bold shadow-inner">
                                            <%= String(month).padStart(2, '0' ) %> / <%= year %>
                                        </div>
                                        <a href="/detalhamento/<%= nextY %>/<%= nextM %>"
                                            class="px-3 py-2 bg-slate-50 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-lg text-sm font-bold transition-colors">Próximo
                                            &rarr;</a>
                                    </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
                    <div class="bg-emerald-500 p-5 rounded-3xl text-white shadow-sm border border-emerald-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Total Recebido</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(incCents) %>
                        </h3>
                    </div>
                    <div class="bg-violet-500 p-5 rounded-3xl text-white shadow-sm border border-violet-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Contas Fixas</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents) %>
                        </h3>
                    </div>
                    <div class="bg-amber-500 p-5 rounded-3xl text-white shadow-sm border border-amber-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Meus Cartões</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(cardTotalCents) %>
                        </h3>
                    </div>
                    <div class="bg-rose-500 p-5 rounded-3xl text-white shadow-sm border border-rose-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Contas+Cartões</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents + cardTotalCents) %>
                        </h3>
                    </div>
                    <div
                        class="bg-blue-600 p-5 rounded-3xl text-white shadow-sm border border-blue-700 col-span-2 lg:col-span-1">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Saldo Final</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(saldoCents) %>
                        </h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                    <div class="space-y-8">
                        <div
                            class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-900 px-6 py-4 flex justify-between items-center">
                                <h5 class="text-white font-bold">📥 Entradas (Caixa)</h5>
                                <button onclick="addRow('income', 'Nome da nova entrada (ex: Venda, Pix):')" <%=isClosed
                                    ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1
                                    rounded-lg transition-colors">+ Nova Entrada</button>
                            </div>
                            <div class="p-6">
                                <table class="w-full text-left">
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                        <% finances.filter(f=> f.type === 'income').forEach(fin => { %>
                                            <tr>
                                                <td class="py-3">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    bg-transparent border-b border-transparent focus:border-blue-500
                                                    outline-none dark:text-slate-200 disabled:opacity-60" value="<%=
                                                        getDesc(fin) %>" onchange="updateRow(<%= fin.id %>,
                                                            'description', this.value)">
                                                </td>
                                                <td class="py-3 w-40">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    font-mono font-bold text-right text-emerald-700
                                                    dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30
                                                    rounded-lg px-2 py-1 focus:ring-2 focus:ring-blue-500 outline-none
                                                    disabled:opacity-60" value="<%= getDisplayValue(fin) %>"
                                                        onblur="saveMath(<%= fin.id %>, this.value)">
                                                </td>
                                                <td class="py-3 pl-2 text-right">
                                                    <button onclick="deleteRow(<%= fin.id %>)" <%=isClosed ? 'hidden'
                                                        : '' %> class="text-slate-300 hover:text-rose-500 font-bold
                                                        transition-colors">×</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div
                            class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-800 dark:bg-slate-900 px-6 py-4 flex justify-between items-center">
                                <h5 class="text-white font-bold">🏠 Contas Domésticas</h5>
                                <button onclick="addRow('expense', 'Nome da nova conta (ex: Luz, Internet):')"
                                    <%=isClosed ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20
                                    text-white px-3 py-1 rounded-lg transition-colors">+ Nova Conta</button>
                            </div>
                            <div class="p-6">
                                <table class="w-full text-left">
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                        <% finances.filter(f=> f.type === 'expense').forEach(fin => { %>
                                            <tr>
                                                <td class="py-3">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    bg-transparent border-b border-transparent focus:border-rose-500
                                                    outline-none dark:text-slate-200 disabled:opacity-60" value="<%=
                                                        getDesc(fin) %>" onchange="updateRow(<%= fin.id %>,
                                                            'description', this.value)">
                                                </td>
                                                <td class="py-3 w-40">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    font-mono font-bold text-right text-rose-700 dark:text-rose-400
                                                    bg-rose-50 dark:bg-rose-900/30 rounded-lg px-2 py-1 focus:ring-2
                                                    focus:ring-rose-500 outline-none disabled:opacity-60" value="<%=
                                                        getDisplayValue(fin) %>" onblur="saveMath(<%= fin.id %>,
                                                            this.value)">
                                                </td>
                                                <td class="py-3 pl-2 text-right">
                                                    <button onclick="deleteRow(<%= fin.id %>)" <%=isClosed ? 'hidden'
                                                        : '' %> class="text-slate-300 hover:text-rose-500 font-bold
                                                        transition-colors">×</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div
                            class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-blue-700 dark:bg-blue-800 px-6 py-4">
                                <h5 class="text-white font-bold">🧮 Calculadora de Rascunho</h5>
                            </div>
                            <div class="p-6">
                                <textarea id="calc-pad" <%=isClosed ? 'disabled' : ''
                                    %> class="w-full font-mono text-sm bg-slate-50 dark:bg-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 outline-none disabled:opacity-60" rows="5" placeholder="Ex: 50 + 20" oninput="calculatePad()" onchange="saveNotes('math', this.value)"><%= notes.content_math %></textarea>
                                <div class="mt-3 text-right text-lg font-black text-blue-700 dark:text-blue-400"
                                    id="calc-result">Soma Total: R$ 0,00</div>
                            </div>
                        </div>

                        <div
                            class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-600 dark:bg-slate-700 px-6 py-4">
                                <h5 class="text-white font-bold">📝 Lembretes</h5>
                            </div>
                            <div class="p-6">
                                <textarea <%=isClosed ? 'disabled' : ''
                                    %> class="w-full text-sm bg-slate-50 dark:bg-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 outline-none disabled:opacity-60" rows="8" placeholder="Notas do mês..." onchange="saveNotes('text', this.value)"><%= notes.content_text %></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function evaluateFormula(str) {
                    try {
                        let clean = str.replace(/R\$\s?/g, '').replace(/\s/g, '');
                        if (clean.includes(',')) {
                            clean = clean.replace(/\./g, '');
                            clean = clean.replace(/,/g, '.');
                        }
                        clean = clean.replace(/[^-+*/().0-9]/g, '');
                        return Function(`'use strict'; return (${clean || 0})`)();
                    } catch (e) { return 0; }
                }

                function calculatePad() {
                    const text = document.getElementById('calc-pad').value;
                    let sum = 0;
                    text.split('\n').forEach(line => {
                        try {
                            const val = evaluateFormula(line);
                            if (val) sum += val;
                        } catch (e) { }
                    });
                    document.getElementById('calc-result').innerText = `Soma Total: ` + sum.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                }

                async function addRow(type, promptMsg) {
                    const desc = prompt(promptMsg);
                    if (!desc) return;
                    await fetch('/finances/add-row', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ month: <%= month %>, year: <%= year %>, type: type, description: desc })
                });
                location.reload(); 
    }

                async function updateRow(id, field, value) {
                    await fetch(`/finances/update/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ field, value })
                    });
                }

                async function saveMath(id, inputStr) {
                    const result = evaluateFormula(inputStr);
                    await fetch(`/finances/update/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ field: 'formula_and_value', formula: inputStr, amount_cents: Math.round(result * 100) })
                    });
                    location.reload();
                }

                async function deleteRow(id) {
                    if (!confirm("Deseja mesmo apagar esta linha?")) return;
                    await fetch(`/finances/delete/${id}`, { method: 'POST' });
                    location.reload();
                }

                async function saveNotes(type, content) {
                    await fetch(`/finances/notes/<%= year %>/<%= month %>`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ type, content })
                    });
                }

                // NOVA FUNÇÃO DO CADEADO
                async function toggleLock(status) {
                    const msg = status === 'close'
                        ? "Deseja FECHAR este mês? Você não poderá mais editar os valores até reabrir."
                        : "Deseja REABRIR este mês para edições?";

                    if (!confirm(msg)) return;

                    await fetch('/finances/toggle-close', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ month: <%= month %>, year: <%= year %>, status })
                });
                location.reload(); 
    }

                window.onload = () => { calculatePad(); };
            </script>

            <%- include('partials/footer') %>