<%- include("partials/header", { title: "OrganizaPay | 👑 Meu Controle" }) %>

    <% /* Calculo de saldo */ let incCents=0; let expCents=0; finances.forEach(f=> {
        if(f.type === 'income') incCents += f.amount_cents;
        if(f.type === 'expense') expCents += f.amount_cents;
        });

        const sharedDebtOwedCents = Number(sharedDebtSummary?.owedCents || 0);
        const sharedDebtReceivableCents = Number(sharedDebtSummary?.receivableCents || 0);
        let saldoCents = incCents + sharedDebtReceivableCents - expCents - cardTotalCents - sharedDebtOwedCents;

        /* Lógica para botões de Mês Anterior / Próximo */
        let prevM = parseInt(month) - 1; let prevY = parseInt(year);
        if (prevM < 1) { prevM=12; prevY--; } let nextM=parseInt(month) + 1; let nextY=parseInt(year); if (nextM> 12) {
            nextM = 1; nextY++; }

            /* Funções visuais para os campos */
            function getDisplayValue(fin) {
            const hasMath = fin.formula && /[-+*/]/.test(fin.formula);
            if (hasMath) return fin.formula;
            return formatBRLFromCents(fin.amount_cents);
            }

            function getDesc(fin) {
            if (fin.description) return fin.description;
            if (fin.category_id) {
            const cat = categories.find(c => c.id === fin.category_id);
            return cat ? cat.name : 'Conta Fixa';
            }
            return '';
            }
            %>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
                data-month-swipe-area
                data-month-swipe-prev="/detalhamento/<%= prevY %>/<%= prevM %>"
                data-month-swipe-next="/detalhamento/<%= nextY %>/<%= nextM %>"
                style="touch-action: pan-y pinch-zoom;">

                <section class="op-page-hero op-fade-up mb-8">
                    <div>
                        <span class="op-page-hero__eyebrow">Painel principal</span>
                        <h1 class="op-page-hero__title mt-4">👑 Meu Controle</h1>
                        <p class="op-page-hero__subtitle mt-3">Titular: <span class="font-bold text-blue-600 dark:text-blue-300"><%= owner.name %></span>. Acompanhe contas, cartões, saldo e próximos passos do mês de uma forma fácil.</p>
                    </div>

                    <div class="op-page-hero__actions w-full lg:max-w-[32rem]">
                        <% if (isClosed) { %>
                            <button onclick="toggleLock('open')"
                                class="w-full inline-flex items-center justify-center rounded-2xl bg-rose-100 px-4 py-3 text-sm font-bold text-rose-700 shadow-sm transition-colors hover:bg-rose-200 dark:bg-rose-900/30 dark:text-rose-300">
                                🔒 Mês Fechado
                            </button>
                        <% } else { %>
                            <button onclick="toggleLock('close')"
                                class="w-full inline-flex items-center justify-center rounded-2xl bg-emerald-100 px-4 py-3 text-sm font-bold text-emerald-700 shadow-sm transition-colors hover:bg-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300">
                                🔓 Fechar Mês
                            </button>
                        <% } %>

                        <button type="button"
                            onclick="document.getElementById('modalManualDetalhamento').classList.remove('hidden')"
                            <%= (isClosed || !cards || !cards.length) ? 'disabled' : '' %>
                            class="w-full inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 <%= (isClosed || !cards || !cards.length) ? 'opacity-60 cursor-not-allowed hover:bg-emerald-600' : 'hover:bg-emerald-700' %>">
                            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Novo Item
                        </button>

                        <div class="col-span-2 w-full flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 p-1 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/70">
                            <a href="/detalhamento/<%= prevY %>/<%= prevM %>"
                                class="flex-1 rounded-xl bg-slate-50 px-3 py-3 text-center text-sm font-bold text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">&larr; Anterior</a>
                            <a href="/month/<%= year %>/<%= month %>"
                                class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white shadow-inner transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 dark:bg-slate-950 dark:hover:bg-slate-900 dark:focus:ring-slate-600 dark:focus:ring-offset-slate-900">
                                <%= String(month).padStart(2, '0' ) %> / <%= year %>
                            </a>
                            <a href="/detalhamento/<%= nextY %>/<%= nextM %>"
                                class="flex-1 rounded-xl bg-slate-50 px-3 py-3 text-center text-sm font-bold text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">Próximo &rarr;</a>
                        </div>
                    </div>
                </section>

                <div id="modalManualDetalhamento"
                    class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 w-full max-w-md shadow-2xl">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-xl font-black text-slate-800 dark:text-white">Novo Gasto Manual</h2>
                            <button type="button" onclick="document.getElementById('modalManualDetalhamento').classList.add('hidden')"
                                class="text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 text-2xl">✕</button>
                        </div>

                        <form action="/txn/manual" method="POST" class="space-y-4" data-auto-first-due-form>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Data da Compra</label>
                                    <input type="date" name="date" required data-manual-date-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Cartão Utilizado</label>
                                    <select name="card_id" data-manual-card-select <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                        <% cards.forEach(c => { %>
                                            <option value="<%= c.id %>" data-close-day="<%= c.close_day || '' %>" data-due-day="<%= c.due_day || '' %>">
                                                <%= c.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Valor Total (R$)</label>
                                    <input type="text" name="amount" placeholder="0,00" required data-money-mask inputmode="numeric" <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Parcelas</label>
                                    <input type="number" name="installments" value="1" min="1" max="99" required data-installments-input <%= isClosed ? 'disabled' : '' %>
                                        class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">1º Vencimento</label>
                                <input type="month" name="first_due" value="<%= year %>-<%= String(month).padStart(2, '0') %>" required data-manual-first-due <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                                <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">Preenchido automaticamente pela data da compra e pelo fechamento do cartão, mas você pode alterar manualmente.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Descrição</label>
                                <input type="text" name="description" placeholder="Ex: Monitor Dell" required <%= isClosed ? 'disabled' : '' %>
                                    class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                            </div>

                            <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= typeof isClosed !== 'undefined' && isClosed ? 'opacity-60' : '' %>">
          <input type="checkbox" name="assign_to_owner" value="1" <%= typeof isClosed !== 'undefined' && isClosed ? 'disabled' : '' %>
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Atribuir este item a mim</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Marque para lançar este item automaticamente no seu nome, inclusive nas próximas parcelas ou recorrências</span>
          </span>
        </label>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= isClosed ? 'opacity-60' : '' %>">
                                <input type="checkbox" name="is_recurring" value="1" data-recurring-toggle <%= isClosed ? 'disabled' : '' %>
                                    class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
                                <span>
                                    <span class="block text-sm font-bold text-slate-800 dark:text-white">Tornar este item recorrente mensal</span>
                                    <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Ideal para academia, streaming, escola, internet e condomínio. Funciona somente com 1 parcela.</span>
                                </span>
                            </label>

                            <% if (isClosed) { %>
                                <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                                    Este mês está fechado. Abra o mês para lançar novos itens nele.
                                </div>
                            <% } else { %>
                                <button type="submit"
                                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all">
                                    Criar Lançamento
                                </button>
                            <% } %>
                        </form>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                    <div class="bg-emerald-500 p-5 rounded-3xl text-white shadow-sm border border-emerald-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Total Recebido</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(incCents) %>
                        </h3>
                    </div>
                    <div class="bg-violet-500 p-5 rounded-3xl text-white shadow-sm border border-violet-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Contas Fixas</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents) %>
                        </h3>
                    </div>
                    <div class="bg-amber-500 p-5 rounded-3xl text-white shadow-sm border border-amber-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Meus Cartões</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(cardTotalCents) %>
                        </h3>
                    </div>
                    <div class="bg-rose-500 p-5 rounded-3xl text-white shadow-sm border border-rose-600">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Contas+Cartões</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(expCents + cardTotalCents) %>
                        </h3>
                    </div>
                    <div
                        class="bg-blue-600 p-5 rounded-3xl text-white shadow-sm border border-blue-700 col-span-2 lg:col-span-1">
                        <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Saldo Final</p>
                        <h3 class="text-xl xl:text-2xl font-black mt-1">
                            <%= formatBRLFromCents(saldoCents) %>
                        </h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 mt-4">
                    <a href="/shared-debts#received" class="block bg-sky-500 p-5 rounded-3xl text-white shadow-sm border border-sky-600 hover:-translate-y-0.5 transition-transform">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold opacity-80 uppercase tracking-wider">Dívidas com Amigos</p>
                                <h3 class="text-xl xl:text-2xl font-black mt-1">
                                    <%= formatBRLFromCents(sharedDebtOwedCents) %>
                                </h3>
                                <p class="mt-2 text-xs font-semibold opacity-85">
                                    <%= Number(sharedDebtSummary?.owedCount || 0) %> cobrança(s) ativa(s) neste mês
                                </p>
                                <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] opacity-90">Abrir cobranças recebidas</p>
                            </div>
                            <div class="h-12 w-12 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center text-2xl">🤝</div>
                        </div>
                    </a>
                    <a href="/shared-debts#sent" class="block bg-cyan-600 p-5 rounded-3xl text-white shadow-sm border border-cyan-700 hover:-translate-y-0.5 transition-transform">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-bold opacity-80 uppercase tracking-wider">A Receber de Amigos</p>
                                <h3 class="text-xl xl:text-2xl font-black mt-1">
                                    <%= formatBRLFromCents(sharedDebtReceivableCents) %>
                                </h3>
                                <p class="mt-2 text-xs font-semibold opacity-85">
                                    <%= Number(sharedDebtSummary?.receivableCount || 0) %> cobrança(s) ativa(s) neste mês
                                </p>
                                <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] opacity-90">Abrir cobranças enviadas</p>
                            </div>
                            <div class="h-12 w-12 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center text-2xl">💸</div>
                        </div>
                    </a>
                </div>

                <% if (alerts && alerts.length) { %>
                    <div class="mb-8 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
                            <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Alertas rápidos</h2>
                            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Sinais importantes para manter o mês em dia.</p>
                        </div>
                        <div class="p-4 md:p-5 grid gap-3">
                            <% alerts.forEach(alert => { %>
                                <div class="rounded-2xl border px-4 py-3 <%= alert.type === 'warning' ? 'border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-900/20' : 'border-blue-200 bg-blue-50 dark:border-blue-800 dark:bg-blue-900/20' %>">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-white"><%= alert.icon %> <%= alert.title %></div>
                                            <div class="text-sm text-slate-600 dark:text-slate-300 mt-1"><%= alert.description %></div>
                                        </div>
                                        <% if (alert.href) { %>
                                            <a href="<%= alert.href %>" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700">Abrir</a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                    <div class="space-y-8">
                        <div
                            class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-900 px-6 py-4 flex justify-between items-center">
                                <h5 class="text-white font-bold">📥 Entradas (Caixa)</h5>
                                <button onclick="addRow('income', 'Nome da nova entrada (ex: Venda, Pix):')" <%=isClosed
                                    ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1
                                    rounded-lg transition-colors">+ Nova Entrada</button>
                            </div>
                            <div class="p-6">
                                <table class="w-full text-left">
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                        <% finances.filter(f=> f.type === 'income').forEach(fin => { %>
                                            <tr>
                                                <td class="py-3">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    bg-transparent border-b border-transparent focus:border-blue-500
                                                    outline-none dark:text-slate-200 disabled:opacity-60" value="<%=
                                                        getDesc(fin) %>" onchange="updateRow(<%= fin.id %>,
                                                            'description', this.value)">
                                                </td>
                                                <td class="py-3 w-40">
                                                    <input type="text" data-money-mask inputmode="numeric" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    font-mono font-bold text-right text-emerald-700
                                                    dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30
                                                    rounded-lg px-2 py-1 focus:ring-2 focus:ring-blue-500 outline-none
                                                    disabled:opacity-60" value="<%= getDisplayValue(fin) %>"
                                                        onblur="saveMath(<%= fin.id %>, this.value)">
                                                </td>
                                                <td class="py-3 pl-2 text-right">
                                                    <button onclick="deleteRow(<%= fin.id %>)" <%=isClosed ? 'hidden'
                                                        : '' %> class="text-slate-300 hover:text-rose-500 font-bold
                                                        transition-colors">×</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div
                            class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-800 dark:bg-slate-900 px-6 py-4 flex justify-between items-center">
                                <h5 class="text-white font-bold">🏠 Contas Domésticas</h5>
                                <button onclick="addRow('expense', 'Nome da nova conta (ex: Luz, Internet):')"
                                    <%=isClosed ? 'hidden' : '' %> class="text-xs bg-white/10 hover:bg-white/20
                                    text-white px-3 py-1 rounded-lg transition-colors">+ Nova Conta</button>
                            </div>
                            <div class="p-6">
                                <table class="w-full text-left">
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                        <% finances.filter(f=> f.type === 'expense').forEach(fin => { %>
                                            <tr>
                                                <td class="py-3">
                                                    <input type="text" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    bg-transparent border-b border-transparent focus:border-rose-500
                                                    outline-none dark:text-slate-200 disabled:opacity-60" value="<%=
                                                        getDesc(fin) %>" onchange="updateRow(<%= fin.id %>,
                                                            'description', this.value)">
                                                </td>
                                                <td class="py-3 w-40">
                                                    <input type="text" data-money-mask inputmode="numeric" <%=isClosed ? 'disabled' : '' %> class="w-full
                                                    font-mono font-bold text-right text-rose-700 dark:text-rose-400
                                                    bg-rose-50 dark:bg-rose-900/30 rounded-lg px-2 py-1 focus:ring-2
                                                    focus:ring-rose-500 outline-none disabled:opacity-60" value="<%=
                                                        getDisplayValue(fin) %>" onblur="saveMath(<%= fin.id %>,
                                                            this.value)">
                                                </td>
                                                <td class="py-3 pl-2 text-right">
                                                    <button onclick="deleteRow(<%= fin.id %>)" <%=isClosed ? 'hidden'
                                                        : '' %> class="text-slate-300 hover:text-rose-500 font-bold
                                                        transition-colors">×</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div
                            class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-blue-700 dark:bg-blue-800 px-6 py-4">
                                <h5 class="text-white font-bold">🧮 Calculadora de Rascunho</h5>
                            </div>
                            <div class="p-6">
                                <textarea id="calc-pad" <%=isClosed ? 'disabled' : ''
                                    %> class="w-full font-mono text-sm bg-slate-50 dark:bg-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 outline-none disabled:opacity-60" rows="5" placeholder="Ex: 50 + 20" oninput="calculatePad()" onchange="saveNotes('math', this.value)"><%= notes.content_math %></textarea>
                                <div class="mt-3 text-right text-lg font-black text-blue-700 dark:text-blue-400"
                                    id="calc-result">Soma Total: R$ 0,00</div>
                            </div>
                        </div>

                        <div
                            class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                            <div class="bg-slate-600 dark:bg-slate-700 px-6 py-4">
                                <h5 class="text-white font-bold">📝 Lembretes</h5>
                            </div>
                            <div class="p-6">
                                <textarea <%=isClosed ? 'disabled' : ''
                                    %> class="w-full text-sm bg-slate-50 dark:bg-slate-900 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 focus:ring-2 focus:ring-blue-500 outline-none disabled:opacity-60" rows="8" placeholder="Notas do mês..." onchange="saveNotes('text', this.value)"><%= notes.content_text %></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function evaluateFormula(str) {
                    try {
                        let clean = str.replace(/R\$\s?/g, '').replace(/\s/g, '');
                        if (clean.includes(',')) {
                            clean = clean.replace(/\./g, '');
                            clean = clean.replace(/,/g, '.');
                        }
                        clean = clean.replace(/[^-+*/().0-9]/g, '');
                        return Function(`'use strict'; return (${clean || 0})`)();
                    } catch (e) { return 0; }
                }

                function calculatePad() {
                    const text = document.getElementById('calc-pad').value;
                    let sum = 0;
                    text.split('\n').forEach(line => {
                        try {
                            const val = evaluateFormula(line);
                            if (val) sum += val;
                        } catch (e) { }
                    });
                    document.getElementById('calc-result').innerText = `Soma Total: ` + sum.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                }

                async function addRow(type, promptMsg) {
                    const desc = prompt(promptMsg);
                    if (!desc) return;
                    await fetch('/finances/add-row', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ month: <%= month %>, year: <%= year %>, type: type, description: desc })
                });
                location.reload(); 
    }

                async function updateRow(id, field, value) {
                    await fetch(`/finances/update/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ field, value })
                    });
                }

                async function saveMath(id, inputStr) {
                    const result = evaluateFormula(inputStr);
                    await fetch(`/finances/update/${id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ field: 'formula_and_value', formula: inputStr, amount_cents: Math.round(result * 100) })
                    });
                    location.reload();
                }

                async function deleteRow(id) {
                    if (!confirm("Deseja mesmo apagar esta linha?")) return;
                    await fetch(`/finances/delete/${id}`, { method: 'POST' });
                    location.reload();
                }

                async function saveNotes(type, content) {
                    await fetch(`/finances/notes/<%= year %>/<%= month %>`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ type, content })
                    });
                }

                // NOVA FUNÇÃO DO CADEADO
                async function toggleLock(status) {
                    const msg = status === 'close'
                        ? "Deseja FECHAR este mês? Você não poderá mais editar os valores até reabrir."
                        : "Deseja REABRIR este mês para edições?";

                    if (!confirm(msg)) return;

                    await fetch('/finances/toggle-close', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ month: <%= month %>, year: <%= year %>, status })
                });
                location.reload(); 
    }

                window.onload = () => { calculatePad(); };
            </script>

            <%- include('partials/footer') %>