<%- include("partials/header", { title: title || "AcerttaPay | Opa" }) %>

<section class="mx-auto w-full max-w-3xl">
  <div class="rounded-[32px] border border-rose-100/80 bg-white/95 p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900/85 sm:p-8">
    <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 ring-1 ring-rose-100 dark:bg-rose-950/30 dark:text-rose-300 dark:ring-rose-900/40" aria-hidden="true">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.72 3h16.92a2 2 0 0 0 1.72-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path>
      </svg>
    </div>

    <div class="mt-5 space-y-3">
      <div class="text-[11px] font-black uppercase tracking-[0.18em] text-rose-500/80 dark:text-rose-300/80">Ajuste rápido</div>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-[2rem]"><%= errorTitle || 'Tem um detalhe pedindo atenção' %></h1>
      <p class="text-sm font-medium leading-7 text-slate-600 dark:text-slate-300 sm:text-base"><%= errorMessage || 'Algo saiu do trilho por aqui.' %></p>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="<%= actionHref || '/' %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-soft transition hover:-translate-y-0.5 hover:shadow-xl dark:bg-white dark:text-slate-900">
        <%= actionLabel || 'Voltar para o app' %>
      </a>
      <button type="button" onclick="window.history.back()" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800">
        Voltar uma casa
      </button>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
