<%- include("partials/header", { title: "AcerttaPay | Meu Radar" }) %>

<%
  function safeRadarNumber(value) {
    const numeric = Number(value || 0);
    return Number.isFinite(numeric) ? numeric : 0;
  }

  function pluralizeRadar(count, singular, plural) {
    return Number(count || 0) === 1 ? singular : plural;
  }

  function getRadarSharedRows(group) {
    if (!group || !group.sharedProjectionSummary || !Array.isArray(group.sharedProjectionSummary.rows)) return [];
    return group.sharedProjectionSummary.rows;
  }
%>

  <div class="op-screen op-screen--home op-radar-screen max-w-6xl mx-auto space-y-5">

  <section class="op-page-hero op-radar-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Painel financeiro do mês</span>
      <h1 class="op-page-hero__title mt-4">Meu Radar</h1>
      <p class="op-page-hero__subtitle mt-3">Acompanhe entradas, saídas, cartões e alertas do mês em um só painel.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><span class="md:hidden"><%= groupedRecent ? groupedRecent.filter(group => !group.__section).length : 0 %> mês(es) no radar</span><span class="hidden md:inline"><%= groupedRecent ? groupedRecent.filter(group => !group.__section).length : 0 %> período(s) no radar</span></span>
      </div>
    </div>

    <div class="space-y-3 lg:ml-auto lg:flex lg:max-w-[32rem] lg:flex-col lg:items-end">
      <div class="op-page-hero__actions op-page-hero__actions--geral">
        <button type="button" data-manual-modal-open
          class="op-btn op-btn-success">
          <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Anotar compra
        </button>

        <% if (canImport) { %>
          <a href="/import"
            class="op-btn op-btn-primary">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Trazer fatura
          </a>
        <% } %>
      </div>
    </div>
  </section>


  <div id="modalManual" data-manual-modal aria-hidden="true"
    class="hidden fixed inset-0 z-[10020] bg-slate-900/60 backdrop-blur-sm px-3 py-3 sm:px-4 sm:py-6">
    <div class="pointer-events-none flex min-h-full items-end justify-center sm:items-center">
      <div class="pointer-events-auto flex w-full max-w-lg flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-800 lg:max-w-4xl xl:max-w-5xl max-h-[calc(100dvh-1rem)] sm:max-h-[calc(100dvh-2rem)]">
      <div class="flex shrink-0 justify-between items-center border-b border-slate-200 px-4 py-4 sm:px-6 dark:border-slate-700">
        <h2 class="text-xl font-black text-slate-800 dark:text-white">Anotar uma compra</h2>
        <button type="button" data-manual-modal-close
          class="op-icon-btn" aria-label="Fechar">✕</button>
      </div>

      <div class="op-manual-modal__scroll flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-6"><form action="/txn/manual" method="POST" class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0" data-auto-first-due-form data-local-draft-flow="manual_purchase">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Quando rolou a compra?</label>
            <input type="date" name="date" required data-manual-date-input
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Qual cartão entrou nessa?</label>
            <select name="card_id" data-manual-card-select
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
              <% cards.forEach(c=> { %>
                <option value="<%= c.id %>" data-close-day="<%= c.close_day || '' %>" data-due-day="<%= c.due_day || '' %>">
                  <%= c.name %>
                </option>
                <% }) %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Quanto foi? (R$)</label>
            <input type="text" name="amount" placeholder="0,00" required data-money-mask data-manual-amount-input inputmode="decimal" enterkeyhint="next" autocapitalize="off" autocomplete="off"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Em quantas parcelas?</label>
            <input type="number" name="installments" value="1" min="1" max="99" required data-installments-input
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Em qual fatura isso vai cair?</label>
          <input type="month" name="first_due" value="<%= featuredOpenGroup ? `${featuredOpenGroup.year}-${String(featuredOpenGroup.month).padStart(2, '0')}` : `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}` %>" required data-manual-first-due
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">A gente sugere essa data com base na compra e no fechamento do cartão. Se quiser trocar, fique à vontade 🙂</p>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">O que foi comprado?</label>
          <input type="text" name="description" placeholder="Ex: Monitor Dell" required
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
        </div>

        <div data-purchase-category-control class="space-y-3 lg:col-span-2">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Categoria (se quiser organizar já)</label>
            <select name="purchase_category_id" data-purchase-category-select
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
              <option value="">Deixar sem categoria por enquanto</option>
              <% (purchaseCategories || []).forEach(category => { %>
                <option value="<%= category.id %>"><%= category.name %></option>
              <% }) %>
              <option value="__new__">Criar categoria nova</option>
            </select>
            <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">Perfeito para organizar depois sem travar esse registro rapidinho de agora.</p>
          </div>
          <div data-purchase-category-custom-shell hidden>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Como vai chamar essa categoria nova?</label>
            <input type="text" name="purchase_category_custom" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input disabled
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          </div>
        </div>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3">
          <input type="checkbox" name="assign_to_owner" value="1"
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Essa ficou 100% comigo</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Marque aqui quando essa compra for só sua. Se tiver parcela ou repetição, a lógica segue junto sem complicação.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3">
          <input type="checkbox" name="is_recurring" value="1" data-recurring-toggle
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Repetir todo mês</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Ótimo para academia, streaming, escola, internet e outras figurinhas carimbadas. Funciona com 1 parcela.</span>
          </span>
        </label>

        <button type="submit"
          class="op-btn op-btn-success op-btn--block lg:col-span-2">
          Salvar compra
        </button>
      </form></div>
      </div>
    </div>
  </div>

  <%- include("partials/monthly-email-summary-modal") %>

  <div>
    <% if (!groupedRecent || groupedRecent.length===0) { %>
      <div class="op-empty-state op-radar-empty op-fade-up">
        <div class="op-empty-state__icon">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div class="op-empty-state__title">Tudo tranquilo por aqui ✨</div>
        <% if (canImport) { %>
          <p class="op-empty-state__text max-w-sm mx-auto">Ainda não pintou nenhum movimento. Você pode trazer a primeira fatura ou anotar uma compra manual para colocar <span class="md:hidden">o mês</span><span class="hidden md:inline">o período</span> pra rodar.</p>
          <div class="op-empty-state__actions">
            <a class="op-btn op-btn-info" href="/import">
              <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Trazer primeira fatura
            </a>
          </div>
        <% } else { %>
          <p class="op-empty-state__text max-w-sm mx-auto">Ainda não há compras para mostrar <span class="md:hidden">neste mês</span><span class="hidden md:inline">neste período</span>. Seu acesso não libera importação de faturas, mas você pode seguir anotando compras manuais por aqui.</p>
        <% } %>
      </div>
      <% } else { %>

        <div class="op-radar-stack space-y-5">
          <% groupedRecent.forEach((group)=> { %>
            <% if (group.__section) { %>
              <div class="op-radar-divider pt-1">
                <div class="flex items-center gap-3 mb-2">
                  <div class="op-radar-divider__line h-px flex-1 <%= group.kind === 'closed' ? 'bg-amber-200 dark:bg-amber-800' : 'bg-emerald-200 dark:bg-emerald-800' %>"></div>
                  <div class="op-radar-divider__label px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-[0.2em] <%= group.kind === 'closed' ? 'bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-900/20 dark:text-amber-200 dark:border-amber-800' : 'bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-200 dark:border-emerald-800' %>"><%= group.label %></div>
                  <div class="op-radar-divider__line h-px flex-1 <%= group.kind === 'closed' ? 'bg-amber-200 dark:bg-amber-800' : 'bg-emerald-200 dark:bg-emerald-800' %>"></div>
                </div>
                <p class="op-radar-divider__description text-xs font-medium text-slate-500 dark:text-slate-400 px-1"><%= group.description %></p>
              </div>
            <% } else { %>
            <details
              class="group op-surface-card op-radar-period bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden transition-all">

              <summary
                class="op-radar-period__summary cursor-pointer select-none p-5 sm:p-6 flex flex-col lg:flex-row lg:items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors border-b border-transparent group-open:border-slate-100 dark:group-open:border-slate-700 relative">

                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-3">
                    <div
                      class="op-radar-period__icon w-12 h-12 rounded-xl bg-slate-900 flex items-center justify-center text-white font-bold shadow-inner">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                      </svg>
                    </div>
                    <div class="op-radar-period__heading">
                      <h2 class="op-radar-period__title text-2xl font-extrabold text-slate-800 dark:text-white flex items-center gap-2 flex-wrap">
                        <span><%= group.label %></span>
                        <% if (group.isClosed) { %>
                          <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Fechado bonitinho</span>
                        <% } %>
                      </h2>
                      <p class="op-radar-period__caption text-sm font-medium text-slate-500 dark:text-slate-400">
                        <% if (group.cards.length > 0) { %>
                          <%= group.cards.length %> <%= pluralizeRadar(group.cards.length, 'cartão na área', 'cartões na área') %>
                        <% } else { %>
                          Sem cartão próprio neste mês
                        <% } %>
                        <% if (group.hasSharedProjections) { %>
                          <span class="mx-1 text-slate-300 dark:text-slate-600">•</span>
                          <%= group.shared_count || getRadarSharedRows(group).length || 0 %> <%= pluralizeRadar(group.shared_count || getRadarSharedRows(group).length, 'compartilhada aceita', 'compartilhadas aceitas') %>
                        <% } %>
                      </p>
                    </div>
                  </div>

                  <div
                    class="op-radar-period__stats flex flex-wrap gap-6 lg:gap-10 mt-4 lg:mt-2 ml-0 lg:ml-16 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 p-3 rounded-xl lg:border-none lg:bg-transparent lg:dark:bg-transparent lg:p-0">
                    <div class="op-radar-stat flex flex-col">
                      <span class="op-radar-stat__label text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Total do
                        mês</span>
                      <span class="op-radar-stat__value text-base font-bold text-slate-800 dark:text-white">
                        <%= formatBRLFromCents(group.total_cents) %>
                      </span>
                    </div>
                    <div class="op-radar-stat op-radar-stat--paid flex flex-col">
                      <span class="op-radar-stat__label text-[10px] font-bold text-emerald-500 uppercase tracking-wider mb-0.5">Já saiu daqui</span>
                      <span class="op-radar-stat__value text-base font-bold text-emerald-600">
                        <%= formatBRLFromCents(group.paid_cents) %>
                      </span>
                    </div>
                    <div class="op-radar-stat op-radar-stat--remaining flex flex-col">
                      <span class="op-radar-stat__label text-[10px] font-bold text-red-400 uppercase tracking-wider mb-0.5">Ainda falta</span>
                      <span class="op-radar-stat__value text-base font-bold text-red-500">
                        <%= formatBRLFromCents(group.remaining_cents) %>
                      </span>
                    </div>
                  </div>

                  <% if (group.hasSharedProjections) { %>
                    <div class="op-radar-shared-overview mt-3 ml-0 lg:ml-16 rounded-2xl border border-violet-100 bg-violet-50/80 px-3 py-2.5 text-xs font-bold text-violet-800 dark:border-violet-900/60 dark:bg-violet-900/20 dark:text-violet-100">
                      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
                        <span class="inline-flex items-center gap-1.5">
                          <span class="h-2 w-2 rounded-full bg-slate-400 dark:bg-slate-500"></span>
                          Cartões próprios: <strong><%= formatBRLFromCents(group.own_total_cents || 0) %></strong>
                        </span>
                        <span class="hidden text-violet-300 sm:inline">•</span>
                        <span class="inline-flex items-center gap-1.5">
                          <span class="h-2 w-2 rounded-full bg-violet-500"></span>
                          Compartilhadas aceitas: <strong><%= formatBRLFromCents(group.shared_total_cents || 0) %></strong>
                        </span>
                        <% if (safeRadarNumber(group.shared_pending_cents) > 0) { %>
                          <span class="hidden text-violet-300 sm:inline">•</span>
                          <span class="inline-flex items-center gap-1.5 text-amber-700 dark:text-amber-200">
                            <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                            Em conferência: <strong><%= formatBRLFromCents(group.shared_pending_cents || 0) %></strong>
                          </span>
                        <% } %>
                      </div>
                    </div>
                  <% } %>
                </div>

                <div class="op-radar-period__actions flex items-center gap-3 mt-5 lg:mt-0 pt-5 lg:pt-0 border-t border-slate-100 dark:border-slate-700 lg:border-none">
                  <div class="op-radar-period__action-grid">
                    <a href="/month/<%= group.year %>/<%= group.month %>"
                      class="op-btn op-btn--compact op-hero-link op-hero-link--month"
                      onclick="event.stopPropagation()">
                      Ver m&ecirc;s
                    </a>

                    <a href="/summary/<%= group.year %>/<%= group.month %>"
                      class="op-btn op-btn--compact op-hero-link op-hero-link--summary"
                      onclick="event.stopPropagation()">
                      Fechamento
                    </a>

                    <a href="/analytics/<%= group.year %>/<%= group.month %>"
                      class="op-btn op-btn--compact op-hero-link op-hero-link--analytics"
                      onclick="event.stopPropagation()">
                      An&aacute;lises
                    </a>

                    <button type="button"
                      class="op-btn op-btn--compact op-hero-link op-hero-link--email-summary"
                      data-monthly-summary-email-open
                      data-monthly-year="<%= group.year %>"
                      data-monthly-month="<%= group.month %>"
                      data-monthly-label="<%= group.label %>"
                      onclick="event.preventDefault(); event.stopPropagation();">
                      Resumo no e-mail
                    </button>
                  </div>

                  <div
                    class="op-radar-period__chevron w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-300 group-open:rotate-180 transition-transform duration-300 ml-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                </div>

              </summary>

              <div class="op-radar-period__panel p-5 sm:p-6 bg-slate-50/50 dark:bg-slate-900/50">
                <% const radarSharedRows = getRadarSharedRows(group); %>

                <% if (group.cards.length) { %>
                  <h3 class="text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-4">Cartões que apareceram neste mês
                  </h3>

                  <div class="op-radar-card-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <% group.cards.forEach(card=> { %>
                      <div
                        class="op-radar-card bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-5 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-md transition-all flex flex-col relative">

                        <% const cardBrandMeta = getCardBrandMeta(card.card_brand); %>
                        <div class="op-radar-card__head flex justify-between items-start gap-3 mb-3">
                          <div>
                            <div class="font-extrabold text-slate-800 dark:text-white text-lg break-words leading-tight">
                              <%= card.card_name %>
                            </div>
                            <% if (cardBrandMeta) { %>
                              <div class="mt-2">
                                <span class="op-card-brand-badge">
                                  <img src="<%= cardBrandMeta.asset %>" alt="<%= cardBrandMeta.label %>" class="op-card-brand-logo" loading="lazy">
                                  <span><%= cardBrandMeta.label %></span>
                                </span>
                              </div>
                            <% } %>
                          </div>
                          <span class="op-radar-card__badge bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold px-2 py-1 rounded-md whitespace-nowrap">
                            <%= card.txn_count %> lançamentos
                          </span>
                        </div>

                        <div class="op-radar-card__file text-xs font-medium text-slate-400 dark:text-slate-500 mb-4 break-all">
                          Arquivo usado: <%= card.original_filename || "N/A" %>
                        </div>

                        <div class="op-radar-card__metrics grid grid-cols-2 gap-3 mb-4">
                          <div class="op-radar-card__metric rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Total de lançamentos</div>
                            <div class="text-lg font-black text-slate-800 dark:text-white"><%= card.txn_count %></div>
                          </div>
                          <div class="op-radar-card__metric rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Quanto esse cartão somou</div>
                            <div class="text-sm font-black text-slate-800 dark:text-white"><%= formatBRLFromCents(card.import_total) %></div>
                          </div>
                        </div>

                        <div class="op-radar-card__actions mt-auto space-y-2">
                          <a href="/month/<%= card.year %>/<%= card.month %>?f_card=<%= card.card_name %>"
                            class="op-btn op-btn-ghost op-btn--block">
                            Ver compras desse cartão
                          </a>
                          <% if (group.isClosed) { %>
                            <div class="block w-full text-center px-4 py-2.5 bg-amber-50 border border-amber-200 text-amber-800 font-semibold text-sm rounded-lg dark:bg-amber-900/20 dark:border-amber-800 dark:text-amber-200">
                              Mês fechado — sem apagar nada por aqui
                            </div>
                          <% } else { %>
                            <form method="post" action="/geral/<%= card.year %>/<%= card.month %>/card/<%= card.card_id %>/delete"
                              data-confirm-prompt="Quer mesmo apagar todas as compras do cartão <%= card.card_name %> em <%= group.label %>? Isso também remove as divisões ligadas a esses lançamentos."
                              data-confirm-phrase="Quero apagar">
                              <button
                                class="op-btn op-btn-danger-soft op-btn--block">
                                Apagar compras desse cartão
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="rounded-[24px] border border-dashed border-slate-300 bg-white/70 px-4 py-5 text-sm font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300">
                    Nenhum cartão próprio apareceu nesta competência. O valor do mês vem das compras compartilhadas aceitas.
                  </div>
                <% } %>

                <% if (group.hasSharedProjections) { %>
                  <% const radarSharedPreviewRows = radarSharedRows.slice(0, 3); %>
                  <section class="mt-5 rounded-[26px] border border-violet-100 bg-white p-4 shadow-sm dark:border-violet-900/50 dark:bg-slate-800/80">
                    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                      <div class="min-w-0">
                        <span class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.16em] text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200">
                          Compra compartilhada recebida
                        </span>
                        <h3 class="mt-3 text-base font-black text-slate-900 dark:text-white">Compartilhadas aceitas também entram no radar</h3>
                        <p class="mt-1 max-w-3xl text-sm font-medium text-slate-500 dark:text-slate-400">
                          Elas contam no total do mês, mas continuam somente leitura. Pagamento, contestação e confirmação ficam na Central de Acertos.
                        </p>
                      </div>
                      <a href="/shared-debts#received" class="inline-flex w-full items-center justify-center rounded-2xl border border-violet-200 bg-violet-50 px-4 py-2.5 text-sm font-black text-violet-700 transition hover:-translate-y-0.5 hover:bg-violet-100 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200 dark:hover:bg-violet-900/35 sm:w-auto">
                        Central de Acertos
                      </a>
                    </div>

                    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                      <div class="rounded-2xl border border-violet-100 bg-violet-50/80 px-3 py-2.5 dark:border-violet-900/60 dark:bg-violet-900/20">
                        <div class="text-[10px] font-black uppercase tracking-[0.15em] text-violet-600 dark:text-violet-300">Total aceito</div>
                        <div class="mt-1 text-lg font-black text-violet-800 dark:text-violet-100"><%= formatBRLFromCents(group.shared_total_cents || 0) %></div>
                      </div>
                      <div class="rounded-2xl border border-emerald-100 bg-emerald-50/80 px-3 py-2.5 dark:border-emerald-900/60 dark:bg-emerald-900/20">
                        <div class="text-[10px] font-black uppercase tracking-[0.15em] text-emerald-600 dark:text-emerald-300">Pago confirmado</div>
                        <div class="mt-1 text-lg font-black text-emerald-700 dark:text-emerald-200"><%= formatBRLFromCents(group.shared_paid_cents || 0) %></div>
                      </div>
                      <div class="rounded-2xl border border-amber-100 bg-amber-50/80 px-3 py-2.5 dark:border-amber-900/60 dark:bg-amber-900/20">
                        <div class="text-[10px] font-black uppercase tracking-[0.15em] text-amber-600 dark:text-amber-300">Em conferência</div>
                        <div class="mt-1 text-lg font-black text-amber-700 dark:text-amber-200"><%= formatBRLFromCents(group.shared_pending_cents || 0) %></div>
                      </div>
                      <div class="rounded-2xl border border-sky-100 bg-sky-50/80 px-3 py-2.5 dark:border-sky-900/60 dark:bg-sky-900/20">
                        <div class="text-[10px] font-black uppercase tracking-[0.15em] text-sky-600 dark:text-sky-300">Ainda falta</div>
                        <div class="mt-1 text-lg font-black text-sky-700 dark:text-sky-200"><%= formatBRLFromCents(group.shared_open_cents || 0) %></div>
                      </div>
                    </div>

                    <% if (radarSharedPreviewRows.length) { %>
                      <div class="mt-4 grid gap-3 lg:grid-cols-3">
                        <% radarSharedPreviewRows.forEach(item => { %>
                          <article class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-3 dark:border-slate-700 dark:bg-slate-900/45">
                            <div class="flex items-start justify-between gap-3">
                              <div class="min-w-0">
                                <div class="text-[11px] font-black uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Enviado por <%= item.requesterName || 'alguém' %></div>
                                <div class="mt-1 text-sm font-black text-slate-900 dark:text-white break-words"><%= item.description || 'Compra compartilhada' %></div>
                                <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= item.categoryName || 'Compartilhadas' %> · <%= item.statusLabel || 'Aceita' %></div>
                              </div>
                              <div class="shrink-0 text-right text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(item.amountCents || 0) %></div>
                            </div>
                          </article>
                        <% }) %>
                      </div>
                    <% } %>

                    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">O cartão continua do remetente. Aqui entra só a sua parte aceita, sem botão perigoso no meio do caminho.</p>
                      <a href="/month/<%= group.year %>/<%= group.month %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">
                        Ver no mês
                      </a>
                    </div>
                  </section>
                <% } %>

              </div>

            </details>
            <% } %>
            <% }) %>
        </div>
        <% } %>
  </div>

  <%- include("partials/footer") %>
