<%- include("partials/header", { title: "Cartões JP | Início" }) %>

  <div
    class="mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 bg-white dark:bg-slate-800 p-6 md:p-8 rounded-3xl shadow-sm border border-slate-200">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Visão Geral</h1>
      <p class="text-slate-500 mt-2 font-medium">Suas faturas agrupadas por mês de vencimento.</p>
    </div>

    <a href="/import"
      class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Nova Importação
    </a>
  </div>

  <div>
    <% if (!groupedRecent || groupedRecent.length===0) { %>
      <div class="text-center py-20 bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200">
        <div class="w-20 h-20 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
            </path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Nenhuma fatura encontrada</h3>
        <p class="text-slate-500 mb-6 max-w-sm mx-auto">Comece importando o primeiro arquivo CSV gerado pelos seus
          cartões.</p>
        <a class="text-blue-600 font-bold hover:text-blue-800 transition-colors" href="/import">Fazer primeira
          importação &rarr;</a>
      </div>
      <% } else { %>

        <div class="space-y-5">
          <% groupedRecent.forEach((group)=> { %>
            <details
              class="group bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition-all">

              <summary
                class="cursor-pointer select-none p-5 sm:p-6 flex flex-col lg:flex-row lg:items-center justify-between hover:bg-slate-50 transition-colors border-b border-transparent group-open:border-slate-100 relative">

                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-3">
                    <div
                      class="w-12 h-12 rounded-xl bg-slate-900 flex items-center justify-center text-white font-bold shadow-inner">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                      </svg>
                    </div>
                    <div>
                      <h2 class="text-2xl font-extrabold text-slate-800">
                        <%= group.label %>
                      </h2>
                      <p class="text-sm font-medium text-slate-500">
                        <%= group.cards.length %>
                          <%= group.cards.length===1 ? 'cartão importado' : 'cartões importados' %>
                      </p>
                    </div>
                  </div>

                  <div
                    class="flex flex-wrap gap-6 lg:gap-10 mt-4 lg:mt-2 ml-0 lg:ml-16 bg-white dark:bg-slate-800 border border-slate-100 p-3 rounded-xl lg:border-none lg:bg-transparent lg:p-0">
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Total do
                        Mês</span>
                      <span class="text-base font-bold text-slate-800">
                        <%= formatBRLFromCents(group.total_cents) %>
                      </span>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-emerald-500 uppercase tracking-wider mb-0.5">Total
                        Pago</span>
                      <span class="text-base font-bold text-emerald-600">
                        <%= formatBRLFromCents(group.paid_cents) %>
                      </span>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-red-400 uppercase tracking-wider mb-0.5">Falta
                        Pagar</span>
                      <span class="text-base font-bold text-red-500">
                        <%= formatBRLFromCents(group.remaining_cents) %>
                      </span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-3 mt-5 lg:mt-0 pt-5 lg:pt-0 border-t border-slate-100 lg:border-none">
                  <a href="/month/<%= group.year %>/<%= group.month %>"
                    class="flex-1 lg:flex-none text-center px-5 py-2.5 text-sm font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5"
                    onclick="event.stopPropagation()">
                    Abrir Mês
                  </a>

                  <a href="/summary/<%= group.year %>/<%= group.month %>"
                    class="flex-1 lg:flex-none text-center px-5 py-2.5 text-sm font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5"
                    onclick="event.stopPropagation()">
                    Resumo
                  </a>

                  <div
                    class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 group-open:rotate-180 transition-transform duration-300 ml-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                </div>

              </summary>

              <div class="p-5 sm:p-6 bg-slate-50/50">
                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Cartões Importados neste mês
                </h3>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  <% group.cards.forEach(card=> { %>
                    <div
                      class="bg-white dark:bg-slate-800 border border-slate-200 rounded-xl p-5 hover:border-slate-300 hover:shadow-md transition-all flex flex-col relative">

                      <div class="flex justify-between items-start mb-3">
                        <div class="font-extrabold text-slate-800 text-lg truncate">
                          <%= card.card_name %>
                        </div>
                        <span class="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-1 rounded-md">
                          <%= card.txn_count %> itens
                        </span>
                      </div>

                      <div class="text-xs font-medium text-slate-400 mb-5 truncate">
                        Arquivo: <%= card.original_filename || "N/A" %>
                      </div>

                      <div class="mt-auto">
                        <a href="/month/<%= card.year %>/<%= card.month %>?f_card=<%= card.card_name %>"
                          class="block w-full text-center px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 text-slate-700 font-semibold text-sm rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-colors">
                          Ver transações deste cartão
                        </a>
                      </div>
                    </div>
                    <% }) %>
                </div>

              </div>

            </details>
            <% }) %>
        </div>
        <% } %>
  </div>

  <%- include("partials/footer") %>