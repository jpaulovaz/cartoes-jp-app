<%- include("partials/header", { title: "Cartões JP" }) %>
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
  <h2 class="text-lg font-semibold mb-2">Últimas importações</h2>
  <% if (!recent || recent.length === 0) { %>
    <p class="text-sm text-slate-600">Nenhuma importação ainda. Vá em <a class="text-blue-700 underline" href="/import">Importar</a>.</p>
  <% } else { %>
    <div class="space-y-2">
      <% recent.forEach(r => { %>
        <div class="flex items-center justify-between border border-slate-200 rounded-xl p-3">
          <div>
            <div class="font-medium"><%= r.card_name %> — <%= String(r.month).padStart(2,'0') %>/<%= r.year %></div>
            <div class="text-xs text-slate-600"><%= r.txn_count %> itens • <%= r.original_filename || "" %></div>
          </div>
          <div class="flex gap-2">
            <a class="px-3 py-1 text-sm rounded-lg border border-slate-300 bg-white hover:bg-slate-50" href="/month/<%= r.year %>/<%= r.month %>">Abrir mês</a>
            <a class="px-3 py-1 text-sm rounded-lg border border-slate-300 bg-white hover:bg-slate-50" href="/summary/<%= r.year %>/<%= r.month %>">Resumo</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include("partials/footer") %>
