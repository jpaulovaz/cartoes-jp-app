<%- include("partials/header", { title: "Cartões JP" }) %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Visão Geral</h1>
    <p class="text-slate-500 mt-1">Acompanhe e gerencie as faturas dos seus cartões de crédito.</p>
  </div>
  <a href="/import" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-sm transition-all hover:-translate-y-0.5">
    + Nova Importação
  </a>
</div>

<div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-6 sm:p-8">
  <h2 class="text-xl font-semibold text-slate-800 mb-6">Últimas Importações</h2>
  
  <% if (!recent || recent.length === 0) { %>
    <div class="text-center py-16 bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200">
        <div class="w-16 h-16 bg-blue-100 text-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
        <h3 class="text-lg font-medium text-slate-900 mb-1">Nenhuma fatura encontrada</h3>
        <p class="text-slate-500 mb-4 max-w-sm mx-auto">Você ainda não importou nenhum arquivo CSV para o sistema.</p>
        <a class="text-blue-600 font-medium hover:text-blue-800 hover:underline" href="/import">Ir para importação &rarr;</a>
    </div>
  <% } else { %>
    <div class="grid gap-5 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      <% recent.forEach(r => { %>
        <div class="group relative flex flex-col justify-between bg-white border border-slate-200 rounded-2xl p-5 hover:border-blue-300 hover:shadow-lg transition-all duration-300 ease-in-out">
          
          <div class="mb-5">
            <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
                    <%= String(r.month).padStart(2,'0') %>/<%= r.year %>
                </span>
            </div>
            <h3 class="font-bold text-slate-900 text-lg truncate" title="<%= r.card_name %>"><%= r.card_name %></h3>
            <p class="text-sm font-medium text-slate-500 mt-1"><%= r.txn_count %> transações</p>
            <p class="text-xs text-slate-400 mt-2 truncate" title="<%= r.original_filename || '' %>"><%= r.original_filename || "Arquivo não especificado" %></p>
          </div>
          
          <div class="flex gap-2 mt-auto pt-4 border-t border-slate-100">
            <a class="flex-1 text-center px-3 py-2.5 text-sm font-semibold rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors" href="/month/<%= r.year %>/<%= r.month %>">
              Abrir Mês
            </a>
            <a class="flex-1 text-center px-3 py-2.5 text-sm font-semibold rounded-xl bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors" href="/summary/<%= r.year %>/<%= r.month %>">
              Resumo
            </a>
          </div>
          
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("partials/footer") %>