<%- include("partials/header", { title: "Cartões JP | Importar CSV" }) %>

  <div class="max-w-3xl mx-auto">
    <div class="mb-8 flex flex-col items-center text-center">
      <div
        class="w-16 h-16 bg-slate-900 text-white rounded-2xl flex items-center justify-center mb-4 shadow-lg shadow-slate-200">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Importar Fatura</h1>
      <p class="text-slate-500 mt-2 font-medium max-w-md">Faça o upload do arquivo CSV da fatura para o sistema
        processar as transações.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-6 sm:p-10 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-600 to-indigo-600"></div>

      <% if (typeof error !=='undefined' && error) { %>
        <div class="mb-8 flex items-center p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 animate-pulse">
          <svg class="w-6 h-6 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-semibold text-sm">
            <%= error %>
          </span>
        </div>
        <% } %>

          <form method="post" action="/import" enctype="multipart/form-data" class="space-y-6">

            <div>
              <label class="block text-sm font-bold text-slate-700 mb-2">Cartão de Crédito</label>
              <select name="card_id" required
                class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 hover:bg-white focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all cursor-pointer font-medium text-slate-700">
                <option value="">Selecione o cartão correspondente...</option>
                <% cards.forEach(c=> { %>
                  <option value="<%= c.id %>">
                    <%= c.name %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Mês (Vencimento)</label>
                <input name="month" type="number" min="1" max="12" placeholder="Ex: 12" required
                  class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 hover:bg-white focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all font-medium text-slate-700" />
              </div>
              <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Ano</label>
                <input name="year" type="number" min="2000" max="2100" placeholder="Ex: 2026" required
                  class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 hover:bg-white focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all font-medium text-slate-700" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-bold text-slate-700 mb-2">Arquivo CSV</label>
              <div
                class="border-2 border-dashed border-slate-300 rounded-xl p-2 bg-slate-50 hover:bg-slate-100 transition-colors">
                <input name="csvfile" type="file" accept=".csv,text/csv" required
                  class="w-full text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-bold file:bg-blue-100 file:text-blue-700 hover:file:bg-blue-200 cursor-pointer" />
              </div>
            </div>

            <div class="pt-6 mt-2 border-t border-slate-100">
              <button type="submit"
                class="w-full px-6 py-3.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-lg shadow-slate-200 transition-all hover:-translate-y-0.5 flex justify-center items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                </svg>
                Processar Arquivo
              </button>
            </div>

          </form>
    </div>
  </div>

  <%- include("partials/footer") %>