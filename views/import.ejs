<%- include("partials/header", { title: "Importar CSV" }) %>
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
  <h1 class="text-xl font-semibold mb-4">Importar CSV</h1>
  <% if (error) { %>
    <div class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"><%= error %></div>
  <% } %>
  <form method="post" action="/import" enctype="multipart/form-data" class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="text-sm text-slate-700">Cartão</label>
      <select name="card_id" class="w-full border border-slate-300 rounded-xl px-3 py-2">
        <option value="">Selecione...</option>
        <% cards.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
      <p class="text-xs text-slate-500 mt-1">Na importação você indica qual cartão é o CSV.</p>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <label class="text-sm text-slate-700">Mês</label>
        <input name="month" type="number" min="1" max="12" class="w-full border border-slate-300 rounded-xl px-3 py-2" />
      </div>
      <div>
        <label class="text-sm text-slate-700">Ano</label>
        <input name="year" type="number" min="2000" max="2100" class="w-full border border-slate-300 rounded-xl px-3 py-2" />
      </div>
      <div class="col-span-2">
        <label class="text-sm text-slate-700">Arquivo CSV</label>
        <input name="csvfile" type="file" accept=".csv,text/csv" class="w-full border border-slate-300 rounded-xl px-3 py-2 bg-white" />
      </div>
    </div>
    <div class="md:col-span-2 flex gap-2">
      <button class="px-4 py-2 rounded-xl bg-slate-900 text-white">Importar</button>
      <a class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50" href="/">Voltar</a>
    </div>
  </form>
</div>
<%- include("partials/footer") %>
