                                <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= match.cardNumberLabel %></div>
                                <div><span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300" title="<%= match.originLabel %>"><%= match.isManual ? 'Manual' : 'Importada' %></span></div>
                                <div class="text-right text-[13px] font-black text-slate-900 dark:text-slate-100"><%= match.amountLabel %></div>
                              </div>
                            <% }) %>
                          </div>
                        </div>
                      </section>
                    <% } %>
                  </div>

                  <aside class="rounded-[20px] border border-slate-200 bg-white/95 p-3.5 shadow-sm dark:border-slate-700 dark:bg-slate-900/80 xl:sticky xl:top-0 xl:self-start">
                    <div class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Quantas linhas entram?</div>
                    <label class="mt-3 block">
                      <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Escolha a quantidade</span>
                      <select name="keep_csv_<%= group.id %>" data-csv-keep data-group-id="<%= group.id %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-900 outline-none transition focus:border-sky-400 focus:bg-white focus:ring-2 focus:ring-sky-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:bg-slate-900">
                        <% for (let keepCount = 0; keepCount <= group.occurrenceCount; keepCount += 1) { %>
                          <option value="<%= keepCount %>" <%= keepCount === Number(group.defaultKeepCount || 0) ? 'selected' : '' %>>
                            <% if (keepCount === 0) { %>
                              Pular todas as <%= group.occurrenceCount %> linhas
                            <% } else if (keepCount === group.occurrenceCount) { %>
                              Importar todas as <%= group.occurrenceCount %> linhas
                            <% } else { %>
                              Importar <%= keepCount %> de <%= group.occurrenceCount %> linhas
                            <% } %>
                          </option>
                        <% } %>
                      </select>
                    </label>

                    <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-950/70">
                      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Sugestao automatica</div>
                      <div class="mt-2 text-xl font-black text-slate-900 dark:text-slate-100"><span data-csv-current-count="<%= group.id %>"><%= group.defaultKeepCount %></span> linha(s)</div>
                      <p class="mt-2 text-xs font-medium leading-5 text-slate-600 dark:text-slate-300">A sugestao considera as coincidencias ja encontradas no app para esse mesmo dia e valor.</p>
                    </div>
                  </aside>
                </div>
              </article>
            <% }) %>
          </section>

          <section data-review-tab-panel="final" class="hidden space-y-3.5">
            <div class="grid gap-2.5 lg:grid-cols-3">
              <div class="rounded-[20px] border border-emerald-200 bg-emerald-50/80 px-4 py-3.5 dark:border-emerald-900/60 dark:bg-emerald-950/20">
                <div class="text-[10px] font-black uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">Entra como compra nova</div>
                <div class="mt-2 text-[1.7rem] font-black leading-none text-emerald-900 dark:text-emerald-100" data-final-total><%= previewSummary.defaultFinalTotalLabel || formatBRLFromCents(0) %></div>
                <div class="mt-1.5 text-[13px] font-semibold text-emerald-700/80 dark:text-emerald-200/80"><span data-final-count><%= previewSummary.defaultNewImportCount || previewSummary.defaultFinalCount || 0 %></span> nova(s) · <span data-overwrite-count><%= previewSummary.defaultOverwriteCount || 0 %></span> sobrescrita(s)</div>
              </div>
              <div class="rounded-[20px] border border-violet-200 bg-violet-50/80 px-4 py-3.5 dark:border-violet-900/60 dark:bg-violet-950/20">
                <div class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">O cartao fica em</div>
                <div class="mt-2 text-[1.7rem] font-black leading-none text-violet-900 dark:text-violet-100" data-projected-total><%= previewSummary.projectedCardTotalLabel || formatBRLFromCents(0) %></div>
                <div class="mt-1.5 text-[13px] font-semibold text-violet-700/80 dark:text-violet-200/80"><span data-projected-count><%= previewSummary.projectedCardCount || 0 %></span> compra(s) no mes depois de gravar</div>
              </div>
              <div class="rounded-[20px] border border-slate-200 bg-white px-4 py-3.5 dark:border-slate-700 dark:bg-slate-900/80">
                <div class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Comparacao com o arquivo</div>
                <div class="mt-2 text-[1.45rem] font-black leading-none text-slate-900 dark:text-slate-100"><%= previewSummary.parsedTotalLabel || formatBRLFromCents(0) %></div>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300" data-final-diff-text>Agora a comparacao usa o total que o cartao vai ter depois da importacao, nao so o que entrou nesta rodada.</p>
              </div>
            </div>

            <div class="grid gap-3 xl:grid-cols-[1.1fr_0.9fr]">
              <section class="rounded-[24px] border border-slate-200 bg-white p-3.5 shadow-sm dark:border-slate-700 dark:bg-slate-900/80 sm:p-4">
                <div class="flex flex-col gap-2.5 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <div class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Lista final</div>
                    <h3 class="mt-1.5 text-base font-black text-slate-900 dark:text-slate-100">Novas compras que vao entrar</h3>
                  </div>
                  <div class="text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Compras unicas entram sozinhas. O restante segue exatamente as escolhas das abas anteriores.</div>
                </div>

                <div class="mt-4 overflow-x-auto" data-final-item-list>
                  <div class="min-w-[700px] space-y-2">
                    <div class="grid grid-cols-[1.9fr_92px_96px_132px_104px] gap-3 px-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
                      <div>Lancamento</div>
                      <div>Data</div>
                      <div>Final</div>
                      <div>Status</div>
                      <div class="text-right">Valor</div>
                    </div>

                    <% previewAutoItems.forEach((item) => { %>
                      <article data-final-item data-final-import-item data-amount-cents="<%= item.amountCents %>" class="grid grid-cols-[1.9fr_92px_96px_132px_104px] items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 px-3 py-3 text-sm dark:border-emerald-900/60 dark:bg-emerald-950/20">
                        <div class="min-w-0">
                          <div class="text-[13px] font-black leading-5 text-slate-900 dark:text-slate-100"><%= item.description %></div>
                          <div class="mt-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400">Compra unica do arquivo</div>
                        </div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.dateLabel %></div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.cardNumberLabel %></div>
                        <div><span class="inline-flex items-center rounded-full border border-emerald-200 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-emerald-700 dark:border-emerald-900/60 dark:bg-slate-900 dark:text-emerald-200">Unica no arquivo</span></div>
                        <div class="text-right text-[13px] font-black text-slate-900 dark:text-slate-100"><%= item.amountLabel %></div>
                      </article>
                    <% }) %>

                    <% previewAppCandidates.forEach((candidate) => {
                      const item = previewItemMap.get(candidate.itemId);
                      if (!item) return;
                    %>
                      <article data-final-item data-final-import-item data-final-app-item="<%= candidate.id %>" data-amount-cents="<%= item.amountCents %>" class="hidden grid grid-cols-[1.9fr_92px_96px_132px_104px] items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50/70 px-3 py-3 text-sm dark:border-amber-900/60 dark:bg-amber-950/20">
                        <div class="min-w-0">
                          <div class="text-[13px] font-black leading-5 text-slate-900 dark:text-slate-100"><%= item.description %></div>
                          <div class="mt-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400">Incluida apesar da suspeita</div>
                        </div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.dateLabel %></div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.cardNumberLabel %></div>
                        <div><span class="inline-flex items-center rounded-full border border-amber-200 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-amber-700 dark:border-amber-900/60 dark:bg-slate-900 dark:text-amber-200">Suspeita confirmada</span></div>
                        <div class="text-right text-[13px] font-black text-slate-900 dark:text-slate-100"><%= item.amountLabel %></div>
                      </article>
                    <% }) %>

                    <% previewCsvGroups.forEach((group) => {
                      const groupItems = (group.itemIds || []).map((itemId) => previewItemMap.get(itemId)).filter(Boolean);
                      groupItems.forEach((item, index) => {
                    %>
                      <article data-final-item data-final-import-item data-final-csv-group="<%= group.id %>" data-final-csv-position="<%= index + 1 %>" data-amount-cents="<%= item.amountCents %>" class="<%= index < Number(group.defaultKeepCount || 0) ? '' : 'hidden ' %>grid grid-cols-[1.9fr_92px_96px_132px_104px] items-start gap-3 rounded-2xl border border-sky-200 bg-sky-50/70 px-3 py-3 text-sm dark:border-sky-900/60 dark:bg-sky-950/20">
                        <div class="min-w-0">
                          <div class="text-[13px] font-black leading-5 text-slate-900 dark:text-slate-100"><%= item.description %></div>
                          <div class="mt-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400">Ocorrencia <%= index + 1 %> de <%= group.occurrenceCount %></div>
                        </div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.dateLabel %></div>
                        <div class="text-[12px] font-semibold text-slate-700 dark:text-slate-200"><%= item.cardNumberLabel %></div>
                        <div><span class="inline-flex items-center rounded-full border border-sky-200 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-sky-700 dark:border-sky-900/60 dark:bg-slate-900 dark:text-sky-200">CSV repetido</span></div>
                        <div class="text-right text-[13px] font-black text-slate-900 dark:text-slate-100"><%= item.amountLabel %></div>
                      </article>
                    <% }) }) %>
                  </div>
                </div>

                <div data-final-import-empty class="hidden mt-4 rounded-[20px] border border-dashed border-slate-300 bg-slate-50 px-5 py-6 text-center text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
                  Nenhuma compra nova ficou marcada para entrar por enquanto.
                </div>
              </section>

              <section class="rounded-[24px] border border-violet-200 bg-violet-50/70 p-3.5 shadow-sm dark:border-violet-900/50 dark:bg-violet-950/15 sm:p-4">
                <div class="flex flex-col gap-2.5 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <div class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">Lista final</div>
                    <h3 class="mt-1.5 text-base font-black text-slate-900 dark:text-slate-100">Lançamentos manuais que vao ser sobrescritos</h3>
                  </div>
                  <div class="text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">A compra manual continua a mesma. O app atualiza os dados vindos do CSV e preserva categoria/divisao.</div>
                </div>

                <div class="mt-4 space-y-2" data-final-overwrite-list>
                  <% previewAppCandidates.forEach((candidate) => {
                    const item = previewItemMap.get(candidate.itemId);
                    if (!item) return;
                    const defaultOverwriteMatch = (candidate.existingMatches || []).find((match) => Number(match.id || 0) === Number(candidate.defaultOverwriteTargetId || 0)) || null;
                  %>
                    <article data-final-item data-final-overwrite-item="<%= candidate.id %>" data-amount-cents="<%= item.amountCents %>" class="hidden rounded-2xl border border-violet-200 bg-white px-3 py-3 text-sm dark:border-violet-900/60 dark:bg-slate-900/80">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <div class="text-[13px] font-black leading-5 text-slate-900 dark:text-slate-100"><%= item.description %></div>
                          <div class="mt-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                            Atualiza: <span data-final-overwrite-target-label="<%= candidate.id %>"><%= defaultOverwriteMatch ? defaultOverwriteMatch.description : 'Escolha o manual alvo na aba de suspeitas' %></span>
                          </div>
                        </div>
                        <span class="inline-flex items-center rounded-full border border-violet-200 bg-violet-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-violet-700 dark:border-violet-900/60 dark:bg-violet-900/30 dark:text-violet-200">Sobrescreve</span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                        <span><%= item.dateLabel %></span>
                        <span>·</span>
                        <span><%= item.cardNumberLabel %></span>
                        <span>·</span>
                        <span><%= item.amountLabel %></span>
                      </div>
                    </article>
                  <% }) %>
                </div>

                <div data-final-overwrite-empty class="hidden mt-4 rounded-[20px] border border-dashed border-violet-200 bg-white/70 px-5 py-6 text-center text-sm font-medium text-slate-500 dark:border-violet-900/60 dark:bg-slate-900/50 dark:text-slate-400">
                  Nenhum lancamento manual sera sobrescrito nesta confirmacao.
                </div>
              </section>
            </div>

            <div data-final-empty-state class="hidden rounded-[20px] border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
              Nada ficou selecionado para importar ou sobrescrever por enquanto. Ajuste as escolhas nas abas anteriores e volte aqui para conferir o resultado.
            </div>
          </section>

        <div class="border-t border-slate-200 bg-white/95 px-4 py-4 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 sm:px-6 lg:px-7">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="max-w-4xl text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Agora o espelho compara o valor do arquivo com o total que esse cartao vai ter depois da importacao. Assim fica mais facil decidir se a fatura fechada realmente vai bater.</div>
            <div class="flex shrink-0 flex-col gap-2.5 sm:flex-row">
              <button type="button" data-import-review-close class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-800">
                Voltar ao formulario
              </button>
              <button type="submit" data-import-review-confirm class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">
                Confirmar importacao
              </button>
            </div>
          </div>
        </div>
      </form>
    </section>
  </div>
<% } %>

<script>
  (function() {
    const fileInput = document.querySelector('[data-import-file-input]');
    const fileLabel = document.querySelector('[data-import-file-label]');
    if (fileInput && fileLabel) {
      fileInput.addEventListener('change', function() {
        const fileName = fileInput.files && fileInput.files[0] ? fileInput.files[0].name : 'Use o arquivo exportado da operadora do cartao. Formatos aceitos: .csv';
        fileLabel.textContent = fileName;
      });
    }

    const modal = document.querySelector('[data-import-review-modal]');
    if (!modal) return;

    const modalBackdrop = modal.querySelector('[data-import-review-backdrop]');
    const reviewForm = document.getElementById('import-review-form');
    const openButtons = document.querySelectorAll('[data-open-import-review]');
    const closeButtons = document.querySelectorAll('[data-import-review-close]');
    const tabContainer = modal.querySelector('[data-review-tab-container]');
    const reviewScroller = tabContainer;
    const tabButtons = modal.querySelectorAll('[data-review-tab-trigger]');
    const tabPanels = modal.querySelectorAll('[data-review-tab-panel]');
    const finalItems = Array.from(modal.querySelectorAll('[data-final-item]'));
    const finalImportItems = Array.from(modal.querySelectorAll('[data-final-import-item]'));
    const finalOverwriteItems = Array.from(modal.querySelectorAll('[data-final-overwrite-item]'));
    const appResolutionInputs = Array.from(modal.querySelectorAll('[data-app-resolution]'));
    const overwriteTargetInputs = Array.from(modal.querySelectorAll('[data-overwrite-target]'));
    const overwriteTargetStaticInputs = Array.from(modal.querySelectorAll('[data-overwrite-target-static]'));
    const overwriteTargetBoxes = Array.from(modal.querySelectorAll('[data-overwrite-target-box]'));
    const csvSelects = Array.from(modal.querySelectorAll('[data-csv-keep]'));
    const finalCountTargets = Array.from(modal.querySelectorAll('[data-final-count]'));
    const overwriteCountTargets = Array.from(modal.querySelectorAll('[data-overwrite-count]'));
    const finalTotalTargets = Array.from(modal.querySelectorAll('[data-final-total]'));
    const finalTotalSecondaryTargets = Array.from(modal.querySelectorAll('[data-final-total-secondary]'));
    const projectedCountTargets = Array.from(modal.querySelectorAll('[data-projected-count]'));
    const projectedTotalTargets = Array.from(modal.querySelectorAll('[data-projected-total]'));
    const diffText = modal.querySelector('[data-final-diff-text]');
    const emptyState = modal.querySelector('[data-final-empty-state]');
    const finalImportEmptyState = modal.querySelector('[data-final-import-empty]');
    const finalOverwriteEmptyState = modal.querySelector('[data-final-overwrite-empty]');
    const confirmButtons = Array.from(modal.querySelectorAll('[data-import-review-confirm]'));
    const fileTotalCents = Number(tabContainer?.dataset.fileTotalCents || 0);
    const existingTotalCents = Number(tabContainer?.dataset.existingTotalCents || 0);
    const existingCount = Number(tabContainer?.dataset.existingCount || 0);
    const moneyFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    const candidateIds = Array.from(new Set(appResolutionInputs.map((input) => String(input.dataset.candidateId || '')).filter(Boolean)));

    function formatMoney(cents) {
      return moneyFormatter.format((Number(cents || 0)) / 100);
    }

    function lockBody(locked) {
      if (locked) {
        document.body.classList.add('overflow-hidden');
      } else {
        document.body.classList.remove('overflow-hidden');
      }
    }

    function openModal() {
      modal.classList.remove('hidden');
      lockBody(true);
    }

    function closeModal() {
      modal.classList.add('hidden');
      lockBody(false);
    }

    function setActiveTab(tabName) {
      tabButtons.forEach((button) => {
        const isActive = button.getAttribute('data-review-tab-trigger') === tabName;
        button.classList.toggle('border-violet-300', isActive);
        button.classList.toggle('bg-violet-50', isActive);
        button.classList.toggle('dark:border-violet-700', isActive);
        button.classList.toggle('dark:bg-violet-950/30', isActive);
      });
      tabPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-review-tab-panel') !== tabName);
      });
    }

    function updateCsvKeepCounters() {
      csvSelects.forEach((select) => {
        const groupId = select.dataset.groupId;
        const target = modal.querySelector('[data-csv-current-count="' + groupId + '"]');
        if (target) target.textContent = String(Number(select.value || 0));
      });
    }

    function getCandidateResolution(candidateId) {
      const checked = modal.querySelector('[data-app-resolution][data-candidate-id="' + candidateId + '"]:checked');
      return checked ? String(checked.value || 'skip') : 'skip';
    }

    function getSelectedOverwriteTarget(candidateId) {
      const checked = modal.querySelector('[data-overwrite-target][data-candidate-id="' + candidateId + '"]:checked');
      if (checked) {
        return {
          value: String(checked.value || ''),
          description: String(checked.dataset.targetDescription || '').trim()
        };
      }
      const staticInput = modal.querySelector('[data-overwrite-target-static][data-candidate-id="' + candidateId + '"]');
      if (staticInput) {
        return {
          value: String(staticInput.value || ''),
          description: String(staticInput.dataset.targetDescription || '').trim()
        };
      }
      return { value: '', description: '' };
    }

    function updateOverwriteVisibility() {
      overwriteTargetBoxes.forEach((box) => {
        const candidateId = String(box.getAttribute('data-overwrite-target-box') || '');
        box.classList.toggle('hidden', getCandidateResolution(candidateId) !== 'overwrite');
      });
    }

    function stabilizeReviewScroll(anchorCard) {
      if (!reviewScroller) return;
      requestAnimationFrame(() => {
        const maxScrollTop = Math.max(0, reviewScroller.scrollHeight - reviewScroller.clientHeight);
        if (reviewScroller.scrollTop > maxScrollTop) {
          reviewScroller.scrollTop = maxScrollTop;
        }
        if (!anchorCard || !reviewScroller.contains(anchorCard)) return;

        const scrollerRect = reviewScroller.getBoundingClientRect();
        const cardRect = anchorCard.getBoundingClientRect();
        const margin = 20;
        if (cardRect.top < scrollerRect.top + margin || cardRect.bottom > scrollerRect.bottom - margin) {
          anchorCard.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      });
    }

    function handlePreviewSelectionChange(event) {
      const anchorCard = event && event.target && typeof event.target.closest === 'function'
        ? event.target.closest('[data-review-candidate-card]')
        : null;
      updateFinalPreview();
      stabilizeReviewScroll(anchorCard);
    }

    function updateFinalPreview() {
      updateOverwriteVisibility();

      let invalidOverwriteCount = 0;
      candidateIds.forEach((candidateId) => {
        const resolution = getCandidateResolution(candidateId);
        const importTarget = modal.querySelector('[data-final-app-item="' + candidateId + '"]');
        const overwriteTarget = modal.querySelector('[data-final-overwrite-item="' + candidateId + '"]');

        if (importTarget) {
          importTarget.classList.toggle('hidden', resolution !== 'import');
        }
        if (overwriteTarget) {
          overwriteTarget.classList.toggle('hidden', resolution !== 'overwrite');
        }

        const selectedOverwrite = getSelectedOverwriteTarget(candidateId);
        const targetLabels = modal.querySelectorAll('[data-final-overwrite-target-label="' + candidateId + '"]');
        targetLabels.forEach((label) => {
          label.textContent = selectedOverwrite.description || 'Escolha o manual alvo na aba de suspeitas';
        });

        const needsExplicitTarget = modal.querySelectorAll('[data-overwrite-target][data-candidate-id="' + candidateId + '"]').length > 0;
        const invalidCurrentOverwrite = resolution === 'overwrite' && needsExplicitTarget && !selectedOverwrite.value;
        if (overwriteTarget) {
          overwriteTarget.dataset.invalidTarget = invalidCurrentOverwrite ? '1' : '0';
        }
        if (invalidCurrentOverwrite) invalidOverwriteCount += 1;
      });

      csvSelects.forEach((select) => {
        const groupId = select.dataset.groupId;
        const keepCount = Number(select.value || 0);
        const groupItems = Array.from(modal.querySelectorAll('[data-final-csv-group="' + groupId + '"]'));
        groupItems.forEach((item) => {
          const position = Number(item.getAttribute('data-final-csv-position') || 0);
          item.classList.toggle('hidden', position > keepCount);
        });
      });

      let importedCount = 0;
      let importedTotalCents = 0;
      finalImportItems.forEach((item) => {
        if (item.classList.contains('hidden')) return;
        importedCount += 1;
        importedTotalCents += Number(item.getAttribute('data-amount-cents') || 0);
      });

      let overwriteCount = 0;
      finalOverwriteItems.forEach((item) => {
        if (item.classList.contains('hidden')) return;
        overwriteCount += 1;
      });

      finalCountTargets.forEach((target) => {
        target.textContent = String(importedCount);
      });
      overwriteCountTargets.forEach((target) => {
        target.textContent = String(overwriteCount);
      });
      finalTotalTargets.forEach((target) => {
        target.textContent = formatMoney(importedTotalCents);
      });
      finalTotalSecondaryTargets.forEach((target) => {
        target.textContent = formatMoney(importedTotalCents);
      });

      const projectedCount = existingCount + importedCount;
      const projectedTotalCents = existingTotalCents + importedTotalCents;

      projectedCountTargets.forEach((target) => {
        target.textContent = String(projectedCount);
      });
      projectedTotalTargets.forEach((target) => {
        target.textContent = formatMoney(projectedTotalCents);
      });

      const diff = projectedTotalCents - fileTotalCents;
      if (diffText) {
        if (diff === 0) {
          diffText.textContent = 'Boa! Depois da importacao, o total do cartao bate certinho com o valor do arquivo.';
          diffText.className = 'mt-2 text-sm font-medium leading-6 text-emerald-700 dark:text-emerald-300';
        } else if (diff < 0) {
          diffText.textContent = 'Depois da importacao, o cartao ainda fica ' + formatMoney(Math.abs(diff)) + ' abaixo do arquivo. Vale revisar se faltou alguma compra ou se parte da fatura caiu em outro mes.';
          diffText.className = 'mt-2 text-sm font-medium leading-6 text-amber-700 dark:text-amber-300';
        } else {
          diffText.textContent = 'Depois da importacao, o cartao fica ' + formatMoney(diff) + ' acima do arquivo. Vale revisar para nao deixar compra em dobro ou lancamento manual sobrando.';
          diffText.className = 'mt-2 text-sm font-medium leading-6 text-rose-700 dark:text-rose-300';
        }
      }

      const totalActions = importedCount + overwriteCount;
      if (emptyState) {
        emptyState.classList.toggle('hidden', totalActions > 0);
      }
      if (finalImportEmptyState) {
        finalImportEmptyState.classList.toggle('hidden', importedCount > 0);
      }
      if (finalOverwriteEmptyState) {
        finalOverwriteEmptyState.classList.toggle('hidden', overwriteCount > 0);
      }

      const shouldDisableConfirm = totalActions <= 0 || invalidOverwriteCount > 0;
      confirmButtons.forEach((button) => {
        button.disabled = shouldDisableConfirm;
        button.classList.toggle('opacity-60', shouldDisableConfirm);
        button.classList.toggle('cursor-not-allowed', shouldDisableConfirm);
      });

      updateCsvKeepCounters();
    }

    openButtons.forEach((button) => button.addEventListener('click', openModal));
    closeButtons.forEach((button) => button.addEventListener('click', closeModal));
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', function() {
        setActiveTab(button.getAttribute('data-review-tab-trigger'));
      });
    });
    appResolutionInputs.forEach((input) => input.addEventListener('change', handlePreviewSelectionChange));
    overwriteTargetInputs.forEach((input) => input.addEventListener('change', handlePreviewSelectionChange));
    csvSelects.forEach((select) => select.addEventListener('change', updateFinalPreview));
    if (reviewForm) {
      reviewForm.addEventListener('submit', function() {
        confirmButtons.forEach((button) => {
          button.disabled = true;
          button.classList.add('opacity-60', 'cursor-not-allowed');
        });
      });
    }

    setActiveTab(tabContainer?.dataset.defaultTab || 'final');
    updateFinalPreview();
    if (modal.dataset.initialOpen === '1') {
      openModal();
    }
  })();
</script>

<%- include("partials/footer") %>
