<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= title || 'AcerttaPay | Desbloquear' %></title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#020617">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="AcerttaPay">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    };
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <link rel="stylesheet" href="/app.css" />
  <style>
    .op-pin-slot { width: 12px; height: 12px; border-radius: 999px; border: 2px solid rgba(148, 163, 184, 0.55); }
    .dark .op-pin-slot { border-color: rgba(100, 116, 139, 0.8); }
    .op-pin-slot.is-filled { background: rgb(15 23 42); border-color: rgb(15 23 42); }
    .dark .op-pin-slot.is-filled { background: rgb(251 191 36); border-color: rgb(251 191 36); }
    .op-pin-key { min-height: 60px; }
  </style>
</head>
<%
  const pinState = appPinSecurity || {};
  const pinMinLength = Number(pinState.minLength || 4) || 4;
  const pinMaxLength = Number(pinState.maxLength || 6) || 6;
  const pinIdleLabel = pinState.idleLabel || '1 minuto';
  const pinIdleOptions = Array.isArray(pinState.idleOptions) ? pinState.idleOptions : [];
  const showRecoveryPanel = !!reauthFresh;
  const recoveryMode = lockMode === 'recover' && showRecoveryPanel;
  const safeNext = nextTarget || '/';
  const displayName = (lockUser && lockUser.name) ? lockUser.name : 'Você';
  const displayEmail = (lockUser && lockUser.email) ? lockUser.email : '';
  const displayPhoto = (lockUser && lockUser.photo_url) ? lockUser.photo_url : '';
  const flashType = flash && flash.type ? String(flash.type) : '';
  const flashMessage = flash && flash.message ? String(flash.message) : '';
%>
<body class="op-auth-page min-h-screen font-sans">
  <main class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center p-4 sm:p-6">
    <div class="grid w-full gap-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.8fr)] lg:items-center">
      <section class="op-auth-shell w-full">
        <div class="op-auth-card overflow-hidden">
          <section class="relative z-10 px-6 py-7 lg:px-8 lg:py-9">
            <img src="/logo.png" alt="AcerttaPay" class="mx-auto mb-6 w-full max-w-[240px] drop-shadow-[0_18px_26px_rgba(37,99,235,0.16)] sm:max-w-[280px]">

            <div class="mx-auto mb-5 flex max-w-md items-center gap-4 rounded-[24px] border border-slate-200 bg-white/95 px-4 py-4 shadow-lg shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-950/80">
              <% if (displayPhoto) { %>
                <img src="<%= displayPhoto %>" alt="<%= displayName %>" class="h-14 w-14 rounded-2xl object-cover ring-1 ring-slate-200 dark:ring-slate-700">
              <% } else { %>
                <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-900 text-lg font-black text-white dark:bg-amber-500 dark:text-slate-950"><%= (displayName || 'V').charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="min-w-0 flex-1">
                <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Proteção por PIN</div>
                <h1 class="mt-1 truncate text-2xl font-black tracking-tight text-slate-900 dark:text-slate-50"><%= displayName %></h1>
                <% if (displayEmail) { %>
                  <p class="mt-1 truncate text-sm font-medium text-slate-500 dark:text-slate-400"><%= displayEmail %></p>
                <% } %>
              </div>
            </div>

            <% if (flashMessage) { %>
              <div class="mb-5 rounded-[22px] border px-4 py-3 text-sm font-semibold <%= flashType === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/25 dark:text-emerald-200' : flashType === 'info' ? 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/25 dark:text-sky-200' : 'border-red-200 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-900/25 dark:text-red-200' %>">
                <%= flashMessage %>
              </div>
            <% } %>

            <div class="mb-5">
              <div class="text-xs font-extrabold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">Desbloqueio</div>
              <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900 dark:text-slate-50">Digite seu PIN para voltar</h2>
              <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400"><%= lockMessage || 'Seu app está protegido por PIN. Digite os números para destravar.' %></p>
            </div>

            <form method="post" action="/lock/unlock" class="grid gap-4" id="appUnlockForm" autocomplete="off">
              <input type="hidden" name="next" value="<%= safeNext %>">
              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">PIN do app</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= pinMaxLength %>" name="pin" id="lockPinInput" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pr-16 text-center text-2xl font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required autofocus>
                  <button type="button" id="lockPinVisibilityToggle" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500">Ver</button>
                </div>
                <div id="lockPinSlots" class="mt-3"></div>
              </label>

              <div class="grid grid-cols-3 gap-3 pt-1" id="lockPinPad">
                <% [1,2,3,4,5,6,7,8,9].forEach((digit) => { %>
                  <button type="button" class="op-pin-key rounded-2xl border border-slate-200 bg-white px-4 py-3 text-lg font-black text-slate-800 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900" data-pin-key="<%= digit %>"><%= digit %></button>
                <% }) %>
                <button type="button" class="op-pin-key rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black uppercase tracking-[0.16em] text-slate-500 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-900" data-pin-action="clear">Limpar</button>
                <button type="button" class="op-pin-key rounded-2xl border border-slate-200 bg-white px-4 py-3 text-lg font-black text-slate-800 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900" data-pin-key="0">0</button>
                <button type="button" class="op-pin-key rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black uppercase tracking-[0.16em] text-slate-500 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-900" data-pin-action="backspace">Apagar</button>
              </div>

              <button type="submit" id="unlockSubmit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Desbloquear app</button>
            </form>

            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <a href="/lock/reauth/google" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900">Esqueci o PIN</a>
              <a href="/logout" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-900">Sair da conta</a>
            </div>

            <p class="mt-4 text-xs leading-6 text-slate-500 dark:text-slate-400">Hoje esse PIN está configurado para travar de novo <strong class="font-semibold text-slate-700 dark:text-slate-200"><%= pinIdleLabel %></strong>. Se você redefinir por aqui, o app volta destravado na sequência.</p>
          </section>
        </div>
      </section>

      <aside class="grid gap-5">
        <section class="rounded-[28px] border border-slate-200 bg-white/90 p-5 shadow-lg shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-900/80 sm:p-6">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Como isso funciona</div>
          <h3 class="mt-2 text-lg font-black text-slate-900 dark:text-white">Jeitinho celular, sem drama</h3>
          <ul class="mt-3 grid gap-3 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
            <li class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-950/60">O PIN é numérico, curtinho e opcional. Quem não ativou continua entrando sem ele.</li>
            <li class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-950/60">Quando o app fica parado ou volta do segundo plano depois do tempo escolhido, ele trava de novo.</li>
            <li class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-950/60">Se a memória falhar, a saída fica no Google: você confirma a conta e redefine o PIN com segurança.</li>
          </ul>
        </section>

        <section class="rounded-[28px] border <%= showRecoveryPanel ? 'border-emerald-200 bg-emerald-50/80 dark:border-emerald-900/70 dark:bg-emerald-900/20' : 'border-sky-200 bg-sky-50/80 dark:border-sky-900/70 dark:bg-sky-950/30' %> p-5 shadow-lg shadow-slate-900/5 sm:p-6">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] <%= showRecoveryPanel ? 'text-emerald-700 dark:text-emerald-300' : 'text-sky-700 dark:text-sky-300' %>"><%= showRecoveryPanel ? 'Conta confirmada' : 'Precisando redefinir?' %></div>
          <h3 class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= showRecoveryPanel ? 'Agora você pode trocar ou desligar o PIN' : 'Se o PIN sumiu da cabeça, tem saída bonita' %></h3>
          <% if (showRecoveryPanel) { %>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Sua conta Google já foi confirmada. Esse passe fica aberto por alguns minutinhos para você trocar o PIN ou desligar essa trava sem precisar do PIN atual.</p>

            <form method="post" action="/lock/recovery/setup" class="mt-4 grid gap-4 rounded-[24px] border border-white/80 bg-white/90 p-4 dark:border-slate-800 dark:bg-slate-950/70" autocomplete="off" id="recoveryPinForm">
              <input type="hidden" name="mode" value="create">
              <input type="hidden" name="next" value="<%= safeNext %>">
              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Novo PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= pinMaxLength %>" name="pin" id="recoveryPinInput" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pr-16 text-center text-lg font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500" data-pin-visibility-toggle="recoveryPinInput">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots="recoveryPinInput" data-max-length="<%= pinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Confirmar novo PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= pinMaxLength %>" name="pin_confirm" id="recoveryPinConfirmInput" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 pr-16 text-center text-lg font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500" data-pin-visibility-toggle="recoveryPinConfirmInput">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots="recoveryPinConfirmInput" data-max-length="<%= pinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Novo tempo de bloqueio</span>
                <select name="pin_idle_seconds" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20">
                  <% pinIdleOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= option.selected ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>

              <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Salvar novo PIN</button>
            </form>

            <form method="post" action="/lock/recovery/disable" class="mt-4" id="recoveryDisableForm">
              <input type="hidden" name="next" value="<%= safeNext %>">
              <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-rose-200 bg-white px-5 py-3 text-sm font-black text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-950 dark:text-rose-300 dark:hover:bg-rose-900/20">Desligar PIN por enquanto</button>
            </form>
          <% } else { %>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Quando o PIN resolver brincar de esconde-esconde, você pode confirmar a mesma conta Google que usa no app. Depois disso, liberamos uma janelinha curta para trocar ou desligar essa proteção.</p>
            <a href="/lock/reauth/google" class="mt-4 inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Confirmar com Google</a>
          <% } %>
        </section>
      </aside>
    </div>
  </main>

  <script>
    (function () {
      const unlockInput = document.getElementById('lockPinInput');
      const unlockSlots = document.getElementById('lockPinSlots');
      const unlockToggle = document.getElementById('lockPinVisibilityToggle');
      const unlockForm = document.getElementById('appUnlockForm');
      const unlockSubmit = document.getElementById('unlockSubmit');
      const pinPad = document.getElementById('lockPinPad');
      const pinMaxLength = <%= pinMaxLength %>;
      let activeInput = unlockInput;

      function normalizeDigits(input) {
        if (!(input instanceof HTMLInputElement)) return '';
        const digits = String(input.value || '').replace(/\D/g, '').slice(0, pinMaxLength);
        if (digits !== input.value) input.value = digits;
        return digits;
      }

      function renderSlots(container, input) {
        if (!(container instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
        const digits = normalizeDigits(input);
        container.innerHTML = `
          <div class="flex items-center justify-center gap-2">${Array.from({ length: pinMaxLength }, (_, index) => `<span class="op-pin-slot ${index < digits.length ? 'is-filled' : ''}"></span>`).join('')}</div>
          <div class="mt-2 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">${digits.length}/${pinMaxLength} dígitos</div>
        `;
      }

      function bindSlotContainer(container) {
        if (!(container instanceof HTMLElement)) return;
        const inputId = container.getAttribute('data-pin-slots');
        const input = document.getElementById(inputId || '');
        if (!(input instanceof HTMLInputElement)) return;
        const sync = () => renderSlots(container, input);
        input.addEventListener('input', sync);
        input.addEventListener('change', sync);
        input.addEventListener('focus', () => { activeInput = input; });
        sync();
      }

      function bindVisibilityToggle(button) {
        if (!(button instanceof HTMLButtonElement)) return;
        const target = document.getElementById(button.getAttribute('data-pin-visibility-toggle') || '');
        if (!(target instanceof HTMLInputElement)) return;
        const sync = () => {
          const visible = target.type === 'text';
          button.textContent = visible ? 'Ocultar' : 'Ver';
          button.setAttribute('aria-pressed', visible ? 'true' : 'false');
        };
        button.addEventListener('click', () => {
          target.type = target.type === 'password' ? 'text' : 'password';
          sync();
          target.focus();
          target.setSelectionRange?.(target.value.length, target.value.length);
        });
        sync();
      }

      if (unlockInput instanceof HTMLInputElement) {
        unlockInput.addEventListener('input', () => renderSlots(unlockSlots, unlockInput));
        unlockInput.addEventListener('focus', () => { activeInput = unlockInput; });
        renderSlots(unlockSlots, unlockInput);
      }

      if (unlockToggle instanceof HTMLButtonElement && unlockInput instanceof HTMLInputElement) {
        unlockToggle.setAttribute('data-pin-visibility-toggle', 'lockPinInput');
        bindVisibilityToggle(unlockToggle);
      }

      document.querySelectorAll('[data-pin-slots]').forEach((container) => bindSlotContainer(container));
      document.querySelectorAll('[data-pin-visibility-toggle]').forEach((button) => bindVisibilityToggle(button));
      document.querySelectorAll('input[inputmode="numeric"]').forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;
        input.addEventListener('input', () => {
          normalizeDigits(input);
          document.querySelectorAll(`[data-pin-slots="${input.id}"]`).forEach((container) => renderSlots(container, input));
        });
        input.addEventListener('focus', () => { activeInput = input; });
      });

      if (pinPad instanceof HTMLElement && unlockInput instanceof HTMLInputElement) {
        pinPad.addEventListener('click', (event) => {
          const button = event.target instanceof HTMLElement ? event.target.closest('button') : null;
          if (!(button instanceof HTMLButtonElement)) return;
          const target = activeInput instanceof HTMLInputElement ? activeInput : unlockInput;
          if (!(target instanceof HTMLInputElement)) return;
          target.focus();
          const action = button.getAttribute('data-pin-action');
          const digit = button.getAttribute('data-pin-key');
          const currentValue = normalizeDigits(target);

          if (action === 'clear') {
            target.value = '';
          } else if (action === 'backspace') {
            target.value = currentValue.slice(0, -1);
          } else if (digit && currentValue.length < pinMaxLength) {
            target.value = `${currentValue}${digit}`;
          }

          target.dispatchEvent(new Event('input', { bubbles: true }));
        });
      }

      if (unlockForm instanceof HTMLFormElement && unlockSubmit instanceof HTMLButtonElement) {
        unlockForm.addEventListener('submit', () => {
          unlockSubmit.disabled = true;
          unlockSubmit.textContent = 'Destravando...';
        });
      }

      document.getElementById('recoveryPinForm')?.addEventListener('submit', (event) => {
        const button = event.currentTarget.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.textContent = 'Salvando...';
        }
      });

      document.getElementById('recoveryDisableForm')?.addEventListener('submit', (event) => {
        const button = event.currentTarget.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.textContent = 'Desligando...';
        }
      });

      window.setTimeout(() => {
        const focusTarget = document.getElementById('<%= recoveryMode ? 'recoveryPinInput' : 'lockPinInput' %>');
        focusTarget?.focus();
      }, 40);
    })();
  </script>
</body>
</html>
