      function buildImpactPanel({ tone = 'info', title = '', body = '' } = {}) {
        const palette = {
          info: 'border-sky-200 bg-sky-50 text-sky-900 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-100',
          warning: 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-100',
          danger: 'border-rose-200 bg-rose-50 text-rose-900 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-100',
          success: 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-100'
        };
        const panel = document.createElement('div');
        panel.className = `rounded-[22px] border px-4 py-3 text-sm ${palette[tone] || palette.info}`;
        panel.innerHTML = `<div class="text-sm font-black">${escapeHtml(title)}</div><p class="mt-1 leading-6 opacity-90">${escapeHtml(body)}</p>`;
        return panel;
      }

      function inferItemSplitMode(item) {
        if (!item || !Array.isArray(item.selected_ids) || !item.selected_ids.length) return 'none';
        const participantIds = item.selected_ids.map((value) => Number(value || 0)).filter(Boolean);
        if (!participantIds.length) return 'none';
        if (participantIds.length <= 1) return 'single';
        const shares = item.selected_shares && typeof item.selected_shares === 'object' ? item.selected_shares : {};
        const amount = Number(item.amount_cents || 0);
        const values = participantIds.map((personId) => Number(shares[personId] || 0));
        const total = values.reduce((sum, value) => sum + value, 0);
        if (amount !== 0 && total === amount) {
          const expectedMap = buildEqualShareMapLocal(amount, participantIds);
          const expected = participantIds.map((personId) => Number(expectedMap[personId] || 0));
          return expected.every((value, index) => value === values[index]) ? 'equal' : 'exact';
        }
        return 'exact';
      }

      function refreshEditPurchaseInsights(item, refs) {
        if (!item || !refs || !(refs.stack instanceof HTMLElement)) return;
        const amountInput = refs.amountInput instanceof HTMLInputElement ? refs.amountInput : null;
        const dateInput = refs.dateInput instanceof HTMLInputElement ? refs.dateInput : null;
        const cardSelect = refs.cardSelect instanceof HTMLSelectElement ? refs.cardSelect : null;
        const firstDueInput = refs.firstDueInput instanceof HTMLInputElement ? refs.firstDueInput : null;
        const descriptionInput = refs.descriptionInput instanceof HTMLInputElement ? refs.descriptionInput : null;
        refs.stack.innerHTML = '';

        const typeTitle = item.recurring_rule_id ? 'Compra recorrente' : (item.has_future_installments ? 'Compra parcelada' : 'Compra única');
        const typeBody = item.recurring_rule_id
          ? 'Se você salvar com alcance futuro, a compra atual, as próximas recorrências já criadas e a regra da recorrência andam juntas.'
          : item.has_future_installments
            ? 'Se você salvar com alcance futuro, a parcela atual e as próximas acompanham a mudança.'
            : 'As mudanças valem apenas para este lançamento.';
        refs.stack.appendChild(buildImpactPanel({ tone: 'info', title: typeTitle, body: typeBody }));

        const splitMode = inferItemSplitMode(item);
        if (splitMode === 'equal') {
          refs.stack.appendChild(buildImpactPanel({ tone: 'success', title: 'Divisão em partes iguais detectada', body: 'Se o valor mudar, a divisão entre as pessoas acompanha automaticamente para continuar tudo redondinho.' }));
        } else if (splitMode === 'exact') {
          refs.stack.appendChild(buildImpactPanel({ tone: 'warning', title: 'Divisão com valores definidos', body: 'Se você mudar o valor, o app pode travar o salvamento até a divisão ser revisada. Melhor evitar surpresa na hora do acerto.' }));
        }

        if (descriptionInput && item.has_future_installments && descriptionInput.value.trim() !== String(item.description || '').trim()) {
          refs.stack.appendChild(buildImpactPanel({ tone: 'info', title: 'Nome das parcelas continua organizado', body: 'Ao aplicar no futuro, o nome-base novo segue para as próximas parcelas e o contador 01/12, 02/12... continua no lugar certo.' }));
        }

        const originalMonthValue = `${String(item.year || currentYear).padStart(4, '0')}-${String(item.month || currentMonth).padStart(2, '0')}`;
        if (firstDueInput && /^\d{4}-\d{2}$/.test(firstDueInput.value) && firstDueInput.value !== originalMonthValue) {
          const dueMonth = Number(firstDueInput.value.slice(5, 7));
          const dueYear = Number(firstDueInput.value.slice(0, 4));
          refs.stack.appendChild(buildImpactPanel({
            tone: 'warning',
            title: 'Fatura de destino alterada',
            body: item.recurring_rule_id
              ? `A base da recorrência passa a apontar para ${formatMonthLabel(dueMonth, dueYear)} se você aplicar no futuro.`
              : `Essa compra passa a mirar ${formatMonthLabel(dueMonth, dueYear)}. Se escolher alcance futuro, as próximas parcelas reencaixam junto.`
          }));
        }

        if (cardSelect && Number(cardSelect.value || 0) !== Number(item.card_id || 0)) {
          refs.stack.appendChild(buildImpactPanel({ tone: 'warning', title: 'Cartão novo na jogada', body: 'Trocar o cartão mexe na fatura de destino e respeita os bloqueios de mês fechado. Se algum mês estiver fechado, o app segura o passe.' }));
        }

        if (amountInput && amountInput.value && amountInput.value !== formatMoney(item.amount_cents)) {
          refs.stack.appendChild(buildImpactPanel({
            tone: splitMode === 'exact' ? 'warning' : 'info',
            title: 'Valor alterado',
            body: splitMode === 'exact'
              ? 'Como já existe divisão detalhada entre pessoas, esse é o ponto mais sensível da edição.'
              : 'Se não houver trava de liquidação ou mês fechado, o valor novo segue normalmente.'
          }));
        }

        if (dateInput && dateInput.value && dateInput.value !== String(item.txn_date || '')) {
          refs.stack.appendChild(buildImpactPanel({ tone: 'info', title: 'Data da compra mudou', body: 'O app recalcula a sugestão de fatura com base no cartão escolhido. Se você travar a fatura manualmente, a gente respeita.' }));
        }
      }

