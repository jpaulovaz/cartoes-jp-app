          const selectedOption = cardSelect.options[cardSelect.selectedIndex];
          const suggested = (window.OPComputeSuggestedFirstDue || (() => ''))(dateInput.value, selectedOption?.dataset.closeDay || '', selectedOption?.dataset.dueDay || '');
          if (suggested && !firstDueInput.dataset.touched) {
            firstDueInput.value = suggested;
          }
        };
        const refreshInsights = () => refreshEditPurchaseInsights(item, {
          stack: insightsStack,
          amountInput,
          dateInput,
          cardSelect,
          firstDueInput,
          descriptionInput
        });

        dateInput.addEventListener('change', () => {
          syncFirstDueSuggestion();
          refreshInsights();
        });
        cardSelect.addEventListener('change', () => {
          syncFirstDueSuggestion();
          refreshInsights();
        });
        firstDueInput.addEventListener('input', () => {
          firstDueInput.dataset.touched = '1';
          refreshInsights();
        });
        amountInput.addEventListener('input', refreshInsights);
        descriptionInput.addEventListener('input', refreshInsights);
        syncFirstDueSuggestion();
        refreshInsights();

        wrapper.appendChild(form);
        return { wrapper, form, amountInput, submitButtonLabel: 'Salvar alterações' };
      }

      async function openEditSheet(txnId) {
        const item = getTxnItem(txnId);
        if (!item) return;

        const built = buildEditPurchaseForm(item);
        const wrapper = built.wrapper;
        const form = built.form;

        openMonthSheet({
          title: 'Editar compra',
          subtitle: item.recurring_rule_id ? 'Mudanças estruturais respeitam a lógica das recorrências.' : (item.has_future_installments ? 'Mudanças estruturais também podem alcançar as próximas parcelas.' : 'Ajuste a compra sem precisar excluir e lançar de novo.'),
          body: wrapper,
          actions: form ? [
            {
              label: built.submitButtonLabel || 'Salvar alterações',
              tone: 'primary',
              closeOnClick: false,
              onClick: async () => {
                const amountInput = form.querySelector('input[name="amount"]');
                const descriptionInput = form.querySelector('input[name="description"]');
                const dateInput = form.querySelector('input[name="date"]');
                const firstDueInput = form.querySelector('input[name="first_due"]');
                const cardSelect = form.querySelector('select[name="card_id"]');
                if (!(amountInput instanceof HTMLInputElement) || !(descriptionInput instanceof HTMLInputElement) || !(dateInput instanceof HTMLInputElement) || !(firstDueInput instanceof HTMLInputElement) || !(cardSelect instanceof HTMLSelectElement)) {
                  showAllocMessage('Não consegui montar o formulário de edição agora.', 'error');
                  return false;
                }
                if (!descriptionInput.value.trim()) {
                  showAllocMessage('A descrição não pode ficar em branco.', 'warning');
                  descriptionInput.focus();
                  return false;
                }
                if (!amountInput.value.trim()) {
                  showAllocMessage('Falta o valor dessa compra.', 'warning');
                  amountInput.focus();
                  return false;
                }
                let scope = 'single';
                if (item.has_future_installments || item.recurring_rule_id) {
                  scope = await resolveSelectionScope([item], {
                    actionLabel: 'salvar essa edição',
                    subjectLabel: 'edição',
                    includeRecurring: true
                  });
                  if (!scope) return false;
                }

                const payload = new URLSearchParams(new FormData(form));
                payload.set('apply_scope', scope);

                try {
                  const response = await fetch(`/txn/${item.id}/edit`, {
                    method: 'POST',
                    body: payload.toString(),
                    headers: {
                      'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                      'X-Requested-With': 'XMLHttpRequest',
                      'X-AcerttaPay-Async': '1'
                    }
                  });
                  let data = null;
                  try { data = await response.json(); } catch (_) { data = null; }
                  if (!response.ok || !data || data.ok === false) {
                    throw new Error((data && data.error) || (data && data.message) || 'Não consegui salvar essa edição agora.');
                  }
                  showAllocMessage(data.message || 'Compra atualizada com sucesso.', 'success');
                  window.setTimeout(() => {
                    window.location.href = data.redirect || `/month/${currentYear}/${currentMonth}`;
                  }, 220);
                  return false;
                } catch (error) {
                  console.error(error);
                  showAllocMessage(error.message || 'Não consegui salvar essa edição agora.', 'error');
                  return false;
                }
              }
            },
            { label: 'Cancelar', tone: 'cancel' }
          ] : [
            { label: 'Fechar', tone: 'cancel' }
          ]
        });
      }

      function buildSplitModeOption({ title, description, value, checked, accentClass }) {
