<%- include("partials/header", { title: `OrganizaPay | Itens ${String(month).padStart(2,'0')}/${year}` }) %>

<%
  function isSelfParticipant(person) {
    return !!person && (String(person.profile_kind || "").toLowerCase() === "self" || Number(person.is_owner || 0) !== 0 || !!person.is_self);
  }

  function getParticipantDisplayName(person) {
    if (!person) return "";
    return isSelfParticipant(person) ? "Eu" : String(person.name || "").trim();
  }

  function getParticipantChipLabel(person, totalParticipants) {
    const label = getParticipantDisplayName(person);
    if (isSelfParticipant(person) && Number(totalParticipants || 0) === 1) return "Só eu";
    if (!label) return "";
    const parts = label.split(/\s+/).filter(Boolean);
    return parts[0] || label;
  }
%>

  <div class="op-screen op-screen--month max-w-7xl mx-auto space-y-6 pb-24">
    <section class="op-page-hero op-fade-up">
      <div>
        <span class="op-page-hero__eyebrow">Gestão do mês</span>
        <h1 class="op-page-hero__title mt-4">Compras do mês — <%= String(month).padStart(2,'0') %>/<%= year %></h1>
        <p class="op-page-hero__subtitle mt-3">Revise as compras do mês, divida valores e deixe tudo redondinho sem sofrer no caminho.</p>
        <div class="op-page-hero__meta mt-4">
          <span class="badge"><%= isClosed ? 'Mês fechado' : 'Mês em edição' %></span>
          <span class="badge"><%= txns ? txns.length : 0 %> item(ns)</span>
        </div>
        <div id="allocMsg" class="mt-3 h-5 text-sm font-bold text-emerald-600 transition-all duration-300"></div>
      </div>
      <div class="op-page-hero__actions">
        <% if (isClosed) { %>
          <button type="button" disabled
            class="op-btn op-btn-muted op-btn--block">
            🔒 Mês Fechado
          </button>
        <% } else { %>
          <button type="button" data-manual-modal-open
            class="op-btn op-btn-success op-btn--block">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Nova compra
          </button>
        <% } %>

        <a href="/summary/<%= year %>/<%= month %>"
          class="op-btn op-btn-info op-btn--block">
          <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6m4 6V7m4 10v-3M5 19h14"></path>
          </svg>
          Resumo do mês</a>
        <% if (canImport) { %>
          <a href="/import"
            class="op-btn op-btn-primary op-btn--block">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Importar fatura</a>
        <% } %>
      </div>
    </section>

    <% if (isClosed) { %>
      <div class="op-inline-alert op-inline-alert--warning">
        <div class="op-inline-alert__icon">🔒</div>
        <div>
          <div class="op-inline-alert__title">Mês fechado por aqui</div>
          <div class="op-inline-alert__text">Distribuições, exclusões e novas compras em <%= String(month).padStart(2,'0') %>/<%= year %> estão bloqueadas.</div>
        </div>
      </div>
    <% } %>

    <% const monthDraftQueueSummary = draftQueueSummaryForMonth || { queueCount: 0, itemCount: 0, totalCents: 0 }; %>
    <% if (monthDraftQueueSummary.queueCount > 0) { %>
      <div class="op-inline-alert op-inline-alert--info">
        <div class="op-inline-alert__icon">📤</div>
        <div>
          <div class="op-inline-alert__title">Caixa de saída aquecendo para <%= String(month).padStart(2,'0') %>/<%= year %></div>
          <div class="op-inline-alert__text">Você tem <strong><%= monthDraftQueueSummary.itemCount %> cobrança(s)</strong> guardada(s) em <strong><%= monthDraftQueueSummary.queueCount %> rascunho(s)</strong>, somando <strong><%= formatBRLFromCents(monthDraftQueueSummary.totalCents) %></strong>. Quando quiser, é só disparar tudo lá em <a href="/shared-debts#draft-queues" class="underline underline-offset-2">Cobranças</a>.</div>
        </div>
      </div>
    <% } %>

    <div class="mb-6 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Compras que se repetem</h2>
        </div>
      </div>

      <% if (recurringRules && recurringRules.length) { %>
        <div class="grid gap-4 lg:grid-cols-2">
          <% recurringRules.forEach(rule => { %>
            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/70 p-4">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div>
                  <div class="text-base font-extrabold text-slate-800 dark:text-white"><%= rule.description %></div>
                  <div class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400"><%= rule.card_name %> · <%= formatBRLFromCents(rule.amount_cents) %></div>
                </div>
                <% if (rule.status === 'active') { %>
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-300">Ativo</span>
                <% } else if (rule.status === 'paused') { %>
                  <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-300">Pausado</span>
                <% } else { %>
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Encerrado</span>
                <% } %>
              </div>

              <div class="mt-3 grid gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 sm:grid-cols-2">
                <div>Compra recorrente no dia <span class="font-bold text-slate-700 dark:text-slate-200"><%= rule.purchase_day || '-' %></span></div>
                <div>Primeiro vencimento <span class="font-bold text-slate-700 dark:text-slate-200"><%= rule.start_due_label %></span></div>
                <div>Ativo a partir de <span class="font-bold text-slate-700 dark:text-slate-200"><%= rule.active_from_label %></span></div>
                <div><span class="md:hidden">Próximo mês</span><span class="hidden md:inline">Próxima competência</span> <span class="font-bold text-slate-700 dark:text-slate-200"><%= rule.preview_label || '—' %></span></div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                <% if (rule.status === 'active') { %>
                  <form method="post" action="/recurring/<%= rule.id %>/state"
                    data-confirm-prompt="Pausar a compra recorrente <%= rule.description %>? Se a compra deste mês ainda não rolou, ela sai junto com as próximas. Se já rolou, o mês atual fica guardado."
                    data-confirm-phrase="Eu confirmo">
                    <input type="hidden" name="action" value="pause">
                    <button class="px-4 py-2 rounded-xl text-sm font-bold border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700">Pausar</button>
                  </form>
                <% } else if (rule.status === 'paused') { %>
                  <form method="post" action="/recurring/<%= rule.id %>/state">
                    <input type="hidden" name="action" value="resume">
                    <button class="px-4 py-2 rounded-xl text-sm font-bold bg-emerald-600 text-white hover:bg-emerald-700">Retomar</button>
                  </form>
                <% } %>

                <% if (rule.status !== 'ended') { %>
                  <form method="post" action="/recurring/<%= rule.id %>/state"
                    data-confirm-prompt="Encerrar a compra recorrente <%= rule.description %>? Se a compra deste mês ainda não rolou, ela sai junto com as próximas. O que já rolou continua no histórico."
                    data-confirm-phrase="Eu confirmo">
                    <input type="hidden" name="action" value="end">
                    <button class="px-4 py-2 rounded-xl text-sm font-bold border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Encerrar</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="op-empty-state op-empty-state--compact">
          <div class="op-empty-state__icon">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10m-11 9h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v11a2 2 0 002 2z"></path></svg>
          </div>
          <div class="op-empty-state__title">Nenhuma compra recorrente por aqui</div>
          <p class="op-empty-state__text">Crie uma compra manual e marque <strong class="text-slate-700 dark:text-slate-200">Repetir todo mês</strong> para deixar essa rotina no piloto semi-automático.</p>
        </div>
      <% } %>
    </div>

    <div id="modalManual" data-manual-modal aria-hidden="true"
      class="hidden fixed inset-0 z-[10020] bg-slate-900/60 backdrop-blur-sm px-3 py-3 sm:px-4 sm:py-6">
      <div class="pointer-events-none flex min-h-full items-end justify-center sm:items-center">
        <div class="pointer-events-auto flex w-full max-w-lg flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-800 lg:max-w-4xl xl:max-w-5xl max-h-[calc(100dvh-1rem)] sm:max-h-[calc(100dvh-2rem)]">
        <div class="flex shrink-0 justify-between items-center border-b border-slate-200 px-4 py-4 sm:px-6 dark:border-slate-700">
          <h2 class="text-xl font-black text-slate-800 dark:text-white">Adicionar compra</h2>
          <button type="button" data-manual-modal-close
            class="op-icon-btn" aria-label="Fechar janela">✕</button>
        </div>

        <div class="op-manual-modal__scroll flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-6"><form action="/txn/manual" method="POST" class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0" data-auto-first-due-form>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Data da Compra</label>
              <input type="date" name="date" required data-manual-date-input <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Cartão</label>
              <select name="card_id" data-manual-card-select <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                <% cards.forEach(c=> { %>
                  <option value="<%= c.id %>" data-close-day="<%= c.close_day || '' %>" data-due-day="<%= c.due_day || '' %>">
                    <%= c.name %>
                  </option>
                  <% }) %>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Valor Total (R$)</label>
              <input type="text" name="amount" placeholder="0,00" required data-money-mask data-manual-amount-input inputmode="decimal" enterkeyhint="next" autocapitalize="off" autocomplete="off" <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Parcelas</label>
              <input type="number" name="installments" value="1" min="1" max="99" required data-installments-input <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Vai cair em qual fatura?</label>
            <input type="month" name="first_due" value="<%= year %>-<%= String(month).padStart(2, '0') %>" required data-manual-first-due <%= isClosed ? "disabled" : "" %>
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
            <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">A gente sugere isso pela data da compra e pelo fechamento do cartão. Se precisar, pode ajustar sem cerimônia.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Descrição</label>
            <input type="text" name="description" placeholder="Ex: Monitor Dell" required <%= isClosed ? "disabled" : "" %>
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
          </div>

          <div data-purchase-category-control class="space-y-3 lg:col-span-2">
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Categoria (opcional)</label>
              <select name="purchase_category_id" data-purchase-category-select <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
                <option value="">Sem categoria por enquanto</option>
                <% (activePurchaseCategories || []).forEach(category => { %>
                  <option value="<%= category.id %>"><%= category.name %></option>
                <% }) %>
                <option value="__new__">Criar categoria nova</option>
              </select>
              <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">É opcional. Se quiser deixar para depois, a compra segue a vida normalmente.</p>
            </div>
            <div data-purchase-category-custom-shell hidden>
              <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Nome da nova categoria</label>
              <input type="text" name="purchase_category_custom" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input disabled <%= isClosed ? "disabled" : "" %>
                class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none focus:bg-white dark:focus:bg-slate-950 transition-colors">
            </div>
          </div>

          <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= typeof isClosed !== 'undefined' && isClosed ? 'opacity-60' : '' %>">
          <input type="checkbox" name="assign_to_owner" value="1" <%= typeof isClosed !== 'undefined' && isClosed ? 'disabled' : '' %>
            class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
          <span>
            <span class="block text-sm font-bold text-slate-800 dark:text-white">Essa ficou comigo</span>
            <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Marque aqui quando essa compra for só sua. Se tiver parcela ou repetição, a ideia segue junto.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3 <%= isClosed ? 'opacity-60' : '' %>">
            <input type="checkbox" name="is_recurring" value="1" data-recurring-toggle <%= isClosed ? "disabled" : "" %>
              class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500 bg-white dark:bg-slate-800">
            <span>
              <span class="block text-sm font-bold text-slate-800 dark:text-white">Repetir todo mês</span>
              <span class="mt-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Perfeito para academia, streaming, escola, internet e afins. Só funciona com 1 parcela.</span>
            </span>
          </label>

          <% if (isClosed) { %>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200 lg:col-span-2">
              Este mês está fechado. Abra o mês para lançar novos itens nele.
            </div>
          <% } else { %>
            <button type="submit"
              class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all lg:col-span-2">
              Salvar compra
            </button>
          <% } %>
        </form></div>
      </div>
    </div>
  </div>

    <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-5 mb-6">
      <form method="get" action="/month/<%= year %>/<%= month %>" class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-8">
        <input type="hidden" name="sort" value="<%= sort %>" />
        <input type="hidden" name="dir" value="<%= dir %>" />

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Data</label>
          <input type="date" name="f_date" value="<%= filters.f_date || '' %>"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Descrição</label>
          <input name="f_desc" value="<%= filters.f_desc || '' %>"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="Ex: Uber, Mercado..." />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Cartão</label>
          <input name="f_card" value="<%= filters.f_card || '' %>"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="Ex: Nubank" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Nº (Final)</label>
          <input name="f_number" value="<%= filters.f_number || '' %>"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="****" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Valor</label>
          <input name="f_amount" value="<%= filters.f_amount || '' %>" data-money-mask inputmode="numeric"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="R$ 0,00" />
        </div>

        <div class="md:col-span-2 lg:col-span-2 xl:col-span-1">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Categoria</label>
          <select name="f_category"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Todas</option>
            <option value="none" <%= String(filters.f_category || '') === 'none' ? 'selected' : '' %>>Sem categoria</option>
            <% (purchaseCategories || []).forEach(category => { %>
              <option value="<%= category.id %>" <%= String(filters.f_category || '') === String(category.id) ? 'selected' : '' %>><%= category.name %><%= category.active ? '' : ' (arquivada)' %></option>
            <% }) %>
          </select>
        </div>

        <div class="md:col-span-2 lg:col-span-1">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Distribuído</label>
          <select name="f_allocated"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Todos</option>
            <option value="sim" <%=filters.f_allocated==='sim' ? 'selected' : '' %>>Sim</option>
            <option value="nao" <%=filters.f_allocated==='nao' ? 'selected' : '' %>>Não</option>
          </select>
        </div>

        <div class="md:col-span-2 lg:col-span-1">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Pessoa</label>
          <select name="f_person"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Todas</option>
            <% people.forEach(p => { %>
              <option value="<%= p.id %>" <%= String(filters.f_person || '') === String(p.id) ? 'selected' : '' %>><%= getParticipantDisplayName(p) %></option>
            <% }) %>
          </select>
        </div>

        <div class="md:col-span-2 lg:col-span-2 xl:col-span-2">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1.5">Ordem dos itens</label>
          <select name="order"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-xl px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="recent" <%= listOrder === 'recent' ? 'selected' : '' %>>Mais recentes primeiro</option>
            <option value="oldest" <%= listOrder === 'oldest' ? 'selected' : '' %>>Mais antigos primeiro</option>
          </select>
          <p class="mt-1 text-[11px] font-medium text-slate-400 dark:text-slate-500">Ao aplicar, a lista volta a ser organizada por data.</p>
        </div>

        <div class="md:col-span-2 lg:col-span-4 xl:col-span-4 flex flex-col sm:flex-row sm:items-end gap-3">
          <button
            class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-sm">Filtrar</button>
          <a class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-sm"
            href="/month/<%= year %>/<%= month %>">Limpar</a>
        </div>
      </form>
    </div>

    <details class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-5 mb-6 group">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Categorias de compra</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Use esse cantinho para organizar suas categorias sem bagunçar o histórico que já existe.</p>
        </div>
        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-600 transition group-open:rotate-180 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">⌄</span>
      </summary>
      <div class="mt-4 space-y-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ativas no momento</div>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if ((activePurchaseCategories || []).length) { %>
              <% activePurchaseCategories.forEach(category => { %>
                <form method="post" action="/purchase-categories/<%= category.id %>/archive" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200">
                  <span><%= category.name %></span>
                  <button type="submit" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[11px] font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800">Arquivar</button>
                </form>
              <% }) %>
            <% } else { %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-400">Ainda não apareceu nenhuma categoria ativa por aqui.</div>
            <% } %>
          </div>
        </div>

        <div>
          <div class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Arquivadas</div>
          <p class="mt-1 text-xs font-medium text-slate-400 dark:text-slate-500">Arquivar tira a categoria dos seletores, mas não mexe no histórico das compras que já usaram esse nome.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% const archivedPurchaseCategories = (purchaseCategories || []).filter(category => !category.active); %>
            <% if (archivedPurchaseCategories.length) { %>
              <% archivedPurchaseCategories.forEach(category => { %>
                <form method="post" action="/purchase-categories/<%= category.id %>/restore" class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-sm font-semibold text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                  <span><%= category.name %></span>
                  <button type="submit" class="inline-flex items-center rounded-full border border-amber-200 bg-white/90 px-2 py-0.5 text-[11px] font-bold text-amber-700 transition hover:bg-white dark:border-amber-700 dark:bg-slate-950/80 dark:text-amber-200 dark:hover:bg-slate-900">Reativar</button>
                </form>
              <% }) %>
            <% } else { %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-400">Nenhuma categoria arquivada até agora.</div>
            <% } %>
          </div>
        </div>
      </div>
    </details>

    <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
      <div class="border-b border-slate-200 dark:border-slate-700 px-5 py-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h2 class="text-lg font-extrabold text-slate-800 dark:text-white">Lista de compras</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              <% if (isClosed) { %>
                Este mês está em modo somente leitura. Abra um item para consultar os detalhes sem alterar a distribuição.
              <% } else { %>
                Toque ou clique em uma compra para abrir as ações. Para selecionar várias, use <strong class="font-bold text-slate-700 dark:text-slate-200">Selecionar</strong> ou segure um item no celular.
              <% } %>
            </p>
          </div>
          <% if (!isClosed) { %>
            <div class="flex flex-col sm:flex-row gap-2">
              <button type="button" id="monthEnterSelectionBtn"
                class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">
                Selecionar
              </button>
              <button type="button" id="monthExitSelectionBtn"
                class="hidden inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">
                Cancelar Seleção
              </button>
            </div>
          <% } %>
        </div>
      </div>

      <div class="overflow-x-auto md:overflow-visible">
        <table class="block md:table w-full text-sm text-left">
          <thead
            class="hidden md:table-header-group bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('date') %>">Data</a></th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('desc') %>">Descrição</a></th>
              <th class="hidden md:table-cell px-4 py-4 text-left">Categoria</th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('card') %>">Cartão</a></th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('number') %>">Nº</a></th>
              <th class="px-4 py-4 text-right"><a class="hover:text-blue-600 transition-colors inline-flex items-center"
                  href="<%= sortLink('amount') %>">Valor</a></th>
              <th class="px-4 py-4 text-center"><a
                  class="hover:text-blue-600 transition-colors inline-flex items-center"
                  href="<%= sortLink('allocated') %>">Status</a></th>
              <th class="px-4 py-4 text-left">Resumo e ações</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            <% txns.forEach(t => {
                 const participantPeople = (t.selected_ids || []).map(pid => people.find(p => Number(p.id) === Number(pid))).filter(Boolean);
                 const shortParticipantNames = participantPeople.map(person => getParticipantChipLabel(person, participantPeople.length)).filter(Boolean);
            %>
              <tr class="op-month-row block md:table-row mb-3 rounded-[28px] border border-slate-200 bg-white/95 p-4 shadow-sm shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-800/60 md:mb-0 md:rounded-none md:border-b md:border-x-0 md:border-t-0 md:border-slate-100 md:bg-transparent md:p-0 md:shadow-none dark:md:border-slate-700 hover:bg-slate-50/60 dark:hover:bg-slate-700/30 transition-colors align-middle space-y-1 md:space-y-0 cursor-pointer"
                data-month-row data-txn-id="<%= t.id %>" tabindex="0" role="button" aria-label="Abrir ações para <%= t.description %>">
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap">
                  <div class="flex items-center justify-between gap-3 md:block">
                    <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Data</span>
                    <span><%= formatDateBR(t.txn_date) %></span>
                  </div>
                </td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-bold text-slate-800 dark:text-white" title="<%= t.description %>">
                  <div class="flex items-start justify-between gap-3 md:block">
                    <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500 pt-0.5">Descrição</span>
                    <span class="text-right md:text-left break-words whitespace-normal block flex-1"><%= t.description %></span>
                  </div>
                </td>
                <td class="hidden md:table-cell px-4 py-3 align-middle">
                  <% if (t.purchase_category_name) { %>
                    <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-700 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200"><%= t.purchase_category_name %></span>
                  <% } else { %>
                    <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">—</span>
                  <% } %>
                </td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3">
                  <div class="flex items-center justify-between gap-3 md:block">
                    <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Cartão</span>
                    <span class="inline-flex items-center px-2 py-1 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs border border-slate-200 dark:border-slate-600 text-right md:text-left">
                      <%= t.card_name %>
                    </span>
                  </div>
                </td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-mono text-xs text-slate-500 dark:text-slate-400">
                  <div class="flex items-center justify-between gap-3 md:block">
                    <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500 not-italic font-sans">Nº</span>
                    <span><%= t.card_number || '-' %></span>
                  </div>
                </td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-right font-black text-slate-900 dark:text-white">
                  <div class="flex items-center justify-between gap-3 md:block">
                    <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Valor</span>
                    <span><%= formatBRLFromCents(t.amount_cents) %></span>
                  </div>
                </td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center status-icon">
                  <% if (t.alloc_count > 0) { %>
                    <div class="flex items-center justify-between md:justify-center gap-3">
                      <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Status</span>
                      <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center md:mx-auto"
                        title="Distribuído">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="flex items-center justify-between md:justify-center gap-3">
                      <span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Status</span>
                      <div class="w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center md:mx-auto"
                        title="Sem distribuição">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                      </div>
                    </div>
                  <% } %>
                </td>
                <td class="op-month-row__meta block md:table-cell px-3 md:px-4 py-3 md:py-3 mt-3 md:mt-0 rounded-2xl border border-slate-200/90 bg-slate-50/90 dark:border-slate-700 dark:bg-slate-900/35 md:rounded-none md:border-0 md:bg-transparent md:px-0 md:py-3">
                  <div class="flex items-start gap-3">
                    <% if (!isClosed) { %>
                      <span data-selection-indicator
                        class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-300 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-600">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                      </span>
                    <% } %>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap gap-2">
                        <% if (shortParticipantNames.length) { %>
                          <% shortParticipantNames.slice(0, 3).forEach(name => { %>
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-200"><%= name %></span>
                          <% }) %>
                          <% if (shortParticipantNames.length > 3) { %>
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-bold text-slate-500 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-400">+<%= shortParticipantNames.length - 3 %></span>
                          <% } %>
                        <% } else { %>
                          <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-bold text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Sem participantes</span>
                        <% } %>
                      </div>

                      <div class="mt-2 flex flex-wrap gap-2">
                        <% if (t.purchase_category_name) { %>
                          <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-700 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200 md:hidden"><%= t.purchase_category_name %></span>
                        <% } %>
                        <% if (t.has_future_installments) { %>
                          <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-bold text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">Parcelada</span>
                        <% } %>
                        <% if (t.recurring_rule_id) { %>
                          <span class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-2.5 py-1 text-[11px] font-bold text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200">Recorrente</span>
                        <% } %>
                      </div>

                      <div class="mt-2 text-[11px] font-medium text-slate-400 dark:text-slate-500">
                        <% if (isClosed) { %>
                          Abra a compra para consultar a divisão dela.
                        <% } else { %>
                          <span class="md:hidden">Toque para ações · Segure para selecionar</span>
                          <span class="hidden md:inline">Clique para ações · Ctrl/Cmd+clique para selecionar</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% if (txns.length===0) { %>
      <div class="mt-6 op-empty-state op-empty-state--compact">
        <div class="op-empty-state__icon">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <div class="op-empty-state__title">Nenhum resultado</div>
        <p class="op-empty-state__text">Nenhum item encontrado com os filtros de busca atuais. Ajuste os critérios ou limpe a busca para voltar à lista completa.</p>
      </div>
      <% } %>

  </div>


  <% if (!isClosed) { %>
    <div id="monthSelectionToolbar"
      class="op-month-selection-toolbar fixed left-4 right-4 z-50 rounded-[28px] border border-slate-200/80 bg-white/95 p-4 shadow-2xl shadow-slate-900/10 backdrop-blur-md dark:border-slate-700 dark:bg-slate-900/95">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <span id="monthSelectionCount"
              class="inline-flex h-9 min-w-[2.25rem] items-center justify-center rounded-2xl bg-blue-600 px-3 text-sm font-black text-white shadow-lg shadow-blue-500/25">0</span>
            <div>
              <div class="text-sm font-black text-slate-900 dark:text-slate-100">Modo seleção</div>
              <div id="monthSelectionSummary" class="text-xs font-medium text-slate-500 dark:text-slate-400">Selecione um ou mais itens para abrir as ações do lote.</div>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:flex md:flex-wrap md:justify-end">
          <button type="button" id="monthBulkPeopleBtn"
            class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Participantes</button>
          <button type="button" id="monthBulkCategoryBtn"
            class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Categoria</button>
          <button type="button" id="monthBulkMoveBtn"
            class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Mover Fatura</button>
          <button type="button" id="monthBulkDeleteBtn"
            class="inline-flex items-center justify-center rounded-2xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700 transition hover:-translate-y-0.5 hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200 dark:hover:bg-red-900/35">Excluir</button>
          <button type="button" id="monthBulkCancelBtn"
            class="inline-flex items-center justify-center rounded-2xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700 transition hover:-translate-y-0.5 hover:bg-red-100 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200 dark:hover:bg-red-900/35">Cancelar</button>
        </div>
      </div>
    </div>
  <% } %>

  <style>
    .op-month-row {
      position: relative;
      -webkit-tap-highlight-color: transparent;
    }

    @media (max-width: 767px) {
      .op-month-row {
        overflow: hidden;
      }

      .op-month-row.is-selected {
        box-shadow: inset 0 0 0 2px rgba(37, 99, 235, 0.92), 0 8px 20px rgba(15, 23, 42, 0.08) !important;
      }

      .dark .op-month-row.is-selected {
        box-shadow: inset 0 0 0 2px rgba(96, 165, 250, 0.92), 0 10px 24px rgba(2, 6, 23, 0.28) !important;
      }

      .op-month-row.is-selected .op-month-row__meta {
        border-color: rgba(59, 130, 246, 0.42);
      }

      .op-month-row__meta {
        position: relative;
      }

      .op-month-row__meta::before {
        content: '';
        position: absolute;
        left: 1rem;
        right: 1rem;
        top: 0;
        border-top: 1.5px solid rgba(148, 163, 184, 0.3);
      }

      .dark .op-month-row__meta::before {
        border-top-color: rgba(100, 116, 139, 0.5);
      }
    }

    @media (min-width: 768px) {
      .op-month-row.is-selected > td {
        background-color: rgba(239, 246, 255, 0.9) !important;
        box-shadow: inset 0 2px 0 rgba(37, 99, 235, 0.9), inset 0 -2px 0 rgba(37, 99, 235, 0.9);
      }

      .op-month-row.is-selected > td:first-child {
        box-shadow: inset 2px 0 0 rgba(37, 99, 235, 0.9), inset 0 2px 0 rgba(37, 99, 235, 0.9), inset 0 -2px 0 rgba(37, 99, 235, 0.9);
      }

      .op-month-row.is-selected > td:last-child {
        box-shadow: inset -2px 0 0 rgba(37, 99, 235, 0.9), inset 0 2px 0 rgba(37, 99, 235, 0.9), inset 0 -2px 0 rgba(37, 99, 235, 0.9);
      }

      .dark .op-month-row.is-selected > td {
        background-color: rgba(30, 41, 59, 0.92) !important;
        box-shadow: inset 0 2px 0 rgba(96, 165, 250, 0.92), inset 0 -2px 0 rgba(96, 165, 250, 0.92);
      }

      .dark .op-month-row.is-selected > td:first-child {
        box-shadow: inset 2px 0 0 rgba(96, 165, 250, 0.92), inset 0 2px 0 rgba(96, 165, 250, 0.92), inset 0 -2px 0 rgba(96, 165, 250, 0.92);
      }

      .dark .op-month-row.is-selected > td:last-child {
        box-shadow: inset -2px 0 0 rgba(96, 165, 250, 0.92), inset 0 2px 0 rgba(96, 165, 250, 0.92), inset 0 -2px 0 rgba(96, 165, 250, 0.92);
      }
    }

    .op-month-selection-toolbar {
      bottom: calc(var(--op-mobile-bottom-clearance, 5.75rem) + 0.75rem);
      opacity: 0;
      pointer-events: none;
      transform: translateY(1.5rem);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .op-month-selection-toolbar.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    @media (min-width: 768px) {
      .op-month-selection-toolbar {
        left: 50%;
        right: auto;
        bottom: 1.5rem;
        width: min(760px, calc(100vw - 3rem));
        transform: translateX(-50%) translateY(1.5rem);
      }

      .op-month-selection-toolbar.is-visible {
        transform: translateX(-50%) translateY(0);
      }
    }
  </style>

  <script>
    window.monthViewBootstrap = {
      month: <%= month %>,
      year: <%= year %>,
      isClosed: <%- JSON.stringify(!!isClosed) %>,
      people: <%- JSON.stringify((people || []).map(p => ({ id: Number(p.id), name: p.name, is_owner: !!p.is_owner, is_self: !!p.is_self, profile_kind: p.profile_kind || '' }))).replace(/</g, '\\u003c') %>,
      purchaseCategories: <%- JSON.stringify((activePurchaseCategories || []).map(category => ({ id: Number(category.id), name: category.name }))).replace(/</g, '\\u003c') %>,
      txns: <%- JSON.stringify((txns || []).map(t => ({
        id: Number(t.id),
        description: t.description,
        amount_cents: Number(t.amount_cents || 0),
        selected_ids: (t.selected_ids || []).map(Number),
        selected_shares: Object.fromEntries(Object.entries(t.selected_shares || {}).map(([key, value]) => [Number(key), Number(value || 0)])),
        has_future_installments: !!t.has_future_installments,
        recurring_rule_id: t.recurring_rule_id ? Number(t.recurring_rule_id) : null,
        purchase_category_id: t.purchase_category_id ? Number(t.purchase_category_id) : null,
        purchase_category_name: t.purchase_category_name || '',
        month: Number(t.month || month),
        year: Number(t.year || year)
      }))).replace(/</g, '\\u003c') %>
    };
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const bootstrap = window.monthViewBootstrap || {};
      const isClosed = !!bootstrap.isClosed;
      const currentMonth = Number(bootstrap.month || 0);
      const currentYear = Number(bootstrap.year || 0);
      const people = Array.isArray(bootstrap.people) ? bootstrap.people : [];
      const purchaseCategories = Array.isArray(bootstrap.purchaseCategories) ? bootstrap.purchaseCategories : [];
      const txns = Array.isArray(bootstrap.txns) ? bootstrap.txns : [];
      const txnsById = new Map(txns.map(item => [String(item.id), {
        ...item,
        id: Number(item.id),
        amount_cents: Number(item.amount_cents || 0),
        month: Number(item.month || currentMonth),
        year: Number(item.year || currentYear),
        selected_ids: Array.isArray(item.selected_ids) ? item.selected_ids.map(Number) : [],
        selected_shares: item.selected_shares && typeof item.selected_shares === 'object'
          ? Object.fromEntries(Object.entries(item.selected_shares).map(([key, value]) => [Number(key), Number(value || 0)]))
          : {},
        has_future_installments: !!item.has_future_installments,
        recurring_rule_id: item.recurring_rule_id ? Number(item.recurring_rule_id) : null,
        purchase_category_id: item.purchase_category_id ? Number(item.purchase_category_id) : null,
        purchase_category_name: item.purchase_category_name || ''
      }]));

      const rows = Array.from(document.querySelectorAll('[data-month-row]'));
      const rowById = new Map(rows.map(row => [String(row.dataset.txnId || ''), row]));
      const allocMsg = document.getElementById('allocMsg');
      const enterSelectionBtn = document.getElementById('monthEnterSelectionBtn');
      const exitSelectionBtn = document.getElementById('monthExitSelectionBtn');
      const toolbar = document.getElementById('monthSelectionToolbar');
      const selectionCountEl = document.getElementById('monthSelectionCount');
      const toolbarSummaryEl = document.getElementById('monthSelectionSummary');
      const bulkPeopleBtn = document.getElementById('monthBulkPeopleBtn');
      const bulkCategoryBtn = document.getElementById('monthBulkCategoryBtn');
      const bulkMoveBtn = document.getElementById('monthBulkMoveBtn');
      const bulkDeleteBtn = document.getElementById('monthBulkDeleteBtn');
      const bulkCancelBtn = document.getElementById('monthBulkCancelBtn');
      const selectedIds = new Set();
      let selectionMode = false;
      let monthSheetState = null;
      let messageTimer = null;

      const currencyFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
      const monthNames = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function formatMoney(value) {
        return currencyFormatter.format((Number(value || 0)) / 100);
      }

      function formatMonthLabel(month, year) {
        const safeMonth = Number(month || 0);
        const safeYear = Number(year || 0);
        const name = monthNames[safeMonth - 1] || 'Mês';
        return `${name}/${safeYear}`;
      }

      function shiftMonthLocal(year, month, amount) {
        let y = Number(year || 0);
        let m = Number(month || 0) + Number(amount || 0);
        while (m > 12) {
          m -= 12;
          y += 1;
        }
        while (m < 1) {
          m += 12;
          y -= 1;
        }
        return { month: m, year: y };
      }

      function showAllocMessage(message, tone = 'success') {
        if (!allocMsg) return;
        const toneClass = tone === 'error'
          ? 'text-red-600'
          : tone === 'warning'
            ? 'text-amber-600'
            : 'text-emerald-600';
        allocMsg.innerHTML = `<span class="${toneClass} font-bold">${escapeHtml(message)}</span>`;
        if (messageTimer) window.clearTimeout(messageTimer);
        messageTimer = window.setTimeout(() => {
          allocMsg.innerHTML = '';
        }, 4500);
      }

      function getTxnItem(txnId) {
        return txnsById.get(String(txnId)) || null;
      }

      function getTxnItems(txnIds) {
        return (txnIds || []).map(getTxnItem).filter(Boolean);
      }

      function getSelectedTxnIds() {
        return Array.from(selectedIds.values()).map(value => Number(value)).filter(Number.isInteger);
      }

      function sumAmounts(items) {
        return (items || []).reduce((acc, item) => acc + Number(item.amount_cents || 0), 0);
      }

      function updateSelectionUI() {
        const selectedTxnIds = getSelectedTxnIds();
        const selectedItems = getTxnItems(selectedTxnIds);
        const selectedCount = selectedItems.length;

        rows.forEach(row => {
          const txnId = String(row.dataset.txnId || '');
          const indicator = row.querySelector('[data-selection-indicator]');
          const isSelected = selectedIds.has(txnId);

          row.classList.toggle('is-selected', isSelected);

          if (indicator) {
            indicator.classList.toggle('hidden', !selectionMode);
            indicator.classList.toggle('flex', selectionMode);
            indicator.classList.toggle('border-blue-600', isSelected);
            indicator.classList.toggle('bg-blue-600', isSelected);
            indicator.classList.toggle('text-white', isSelected);
            indicator.classList.toggle('shadow-lg', isSelected);
            indicator.classList.toggle('shadow-blue-500/20', isSelected);
            indicator.classList.toggle('border-slate-200', !isSelected);
            indicator.classList.toggle('bg-white', !isSelected);
            indicator.classList.toggle('text-slate-300', !isSelected);
            indicator.classList.toggle('dark:border-slate-700', !isSelected);
            indicator.classList.toggle('dark:bg-slate-900', !isSelected);
            indicator.classList.toggle('dark:text-slate-600', !isSelected);
          }
        });

        if (toolbar && selectionCountEl && toolbarSummaryEl) {
          toolbar.classList.toggle('is-visible', selectionMode);
          selectionCountEl.textContent = String(selectedCount);
          toolbarSummaryEl.textContent = selectedCount
            ? `${selectedCount} item(ns) · ${formatMoney(sumAmounts(selectedItems))}`
            : 'Selecione um ou mais itens para abrir as ações do lote.';
        }

        [bulkPeopleBtn, bulkCategoryBtn, bulkMoveBtn, bulkDeleteBtn].forEach(button => {
          if (button) button.disabled = selectedCount === 0;
        });

        if (enterSelectionBtn) enterSelectionBtn.classList.toggle('hidden', selectionMode);
        if (exitSelectionBtn) exitSelectionBtn.classList.toggle('hidden', !selectionMode);
      }

      function enterSelectionMode(initialIds = []) {
        if (isClosed) return;
        selectionMode = true;
        (initialIds || []).forEach(txnId => {
          if (txnsById.has(String(txnId))) selectedIds.add(String(txnId));
        });
        updateSelectionUI();
      }

      function exitSelectionMode() {
        selectionMode = false;
        selectedIds.clear();
        updateSelectionUI();
      }

      function toggleSelection(txnId) {
        const key = String(txnId || '');
        if (!txnsById.has(key)) return;
        if (selectedIds.has(key)) selectedIds.delete(key);
        else selectedIds.add(key);
        updateSelectionUI();
      }

      function toneClasses(tone = 'secondary') {
        const base = 'w-full rounded-2xl px-4 py-3 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900 disabled:cursor-not-allowed disabled:opacity-50';
        if (tone === 'danger') return `${base} bg-red-600 text-white hover:bg-red-700 focus:ring-red-500`;
        if (tone === 'cancel') return `${base} border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 focus:ring-red-400 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200 dark:hover:bg-red-900/35 dark:focus:ring-red-500`;
        if (tone === 'primary') return `${base} bg-slate-900 text-white hover:bg-slate-800 focus:ring-slate-500 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white dark:focus:ring-slate-300`;
        return `${base} border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 focus:ring-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 dark:focus:ring-slate-500`;
      }

      function ensureMonthSheet() {
        if (monthSheetState && monthSheetState.root && document.body.contains(monthSheetState.root)) {
          return monthSheetState;
        }

        const root = document.createElement('div');
        root.className = 'fixed inset-0 z-[9999] hidden';
        root.innerHTML = `
          <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-month-sheet-backdrop></div>
          <div class="relative z-10 flex min-h-full items-end justify-center p-2 sm:items-center sm:p-4">
            <div class="flex h-[calc(100dvh-1rem)] max-h-[calc(100dvh-1rem)] w-full max-w-lg flex-col overflow-hidden rounded-[28px] bg-white shadow-2xl ring-1 ring-slate-200 sm:h-auto sm:max-h-[calc(100dvh-2rem)] dark:bg-slate-900 dark:ring-slate-700" data-month-sheet-surface>
              <div class="shrink-0 border-b border-slate-200 px-4 py-4 sm:px-5 dark:border-slate-800" data-month-sheet-header>
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-slate-100" data-month-sheet-title></h3>
                    <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400" data-month-sheet-subtitle></p>
                  </div>
                  <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" data-month-sheet-close>✕</button>
                </div>
              </div>
              <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-5" data-month-sheet-body></div>
              <div class="shrink-0 flex flex-col gap-2 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 sm:px-5 sm:py-4" data-month-sheet-actions style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"></div>
            </div>
          </div>
        `;
        document.body.appendChild(root);

        monthSheetState = {
          root,
          surface: root.querySelector('[data-month-sheet-surface]'),
          header: root.querySelector('[data-month-sheet-header]'),
          title: root.querySelector('[data-month-sheet-title]'),
          subtitle: root.querySelector('[data-month-sheet-subtitle]'),
          body: root.querySelector('[data-month-sheet-body]'),
          actions: root.querySelector('[data-month-sheet-actions]'),
          onClose: null
        };

        const closeMonthSheet = () => {
          monthSheetState.root.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
          const handler = monthSheetState.onClose;
          monthSheetState.onClose = null;
          if (typeof handler === 'function') handler();
        };

        root.querySelector('[data-month-sheet-backdrop]')?.addEventListener('click', closeMonthSheet);
        root.querySelector('[data-month-sheet-close]')?.addEventListener('click', closeMonthSheet);
        root.addEventListener('click', (event) => {
          const surface = monthSheetState?.surface;
          if (!surface || monthSheetState?.root.classList.contains('hidden')) return;
          if (!surface.contains(event.target)) closeMonthSheet();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && monthSheetState && !monthSheetState.root.classList.contains('hidden')) {
            closeMonthSheet();
          }
        });

        monthSheetState.close = closeMonthSheet;
        return monthSheetState;
      }

      function openMonthSheet({ title = 'Ações', subtitle = '', body = null, actions = [], onClose = null, size = 'default' } = {}) {
        const state = ensureMonthSheet();
        const surfaceSizeClass = size === 'people' ? 'sm:max-w-6xl' : (size === 'wide' ? 'sm:max-w-5xl' : 'sm:max-w-lg');
        state.onClose = typeof onClose === 'function' ? onClose : null;
        state.surface.className = `flex h-[calc(100dvh-1rem)] max-h-[calc(100dvh-1rem)] w-full ${surfaceSizeClass} flex-col overflow-hidden rounded-[28px] bg-white shadow-2xl ring-1 ring-slate-200 sm:h-auto sm:max-h-[calc(100dvh-2rem)] dark:bg-slate-900 dark:ring-slate-700`;
        state.header.className = 'shrink-0 border-b border-slate-200 px-4 py-4 sm:px-5 dark:border-slate-800';
        state.body.className = `min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-5 ${size === 'people' ? 'xl:px-6 xl:py-5' : ''}`.trim();
        state.actions.className = 'shrink-0 flex flex-col gap-2 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 sm:px-5 sm:py-4';
        state.actions.style.paddingBottom = 'calc(0.75rem + env(safe-area-inset-bottom, 0px))';
        state.title.textContent = title;
        state.subtitle.textContent = subtitle || '';
        state.subtitle.classList.toggle('hidden', !subtitle);
        state.body.innerHTML = '';
        state.actions.innerHTML = '';

        if (typeof body === 'string') {
          state.body.innerHTML = body;
        } else if (body instanceof Node) {
          state.body.appendChild(body);
        }

        if (state.root.parentElement === document.body) {
          document.body.appendChild(state.root);
        }

        actions.forEach((action, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = toneClasses(action.tone || 'secondary');
          button.textContent = action.label;
          button.disabled = !!action.disabled;
          button.addEventListener('click', async () => {
            if (button.disabled) return;
            if (!action.onClick) {
              if (action.closeOnClick !== false) state.close();
              return;
            }
            button.disabled = true;
            try {
              const result = await action.onClick();
              if (result !== false && action.closeOnClick !== false) {
                state.close();
              }
            } finally {
              button.disabled = !!action.disabled;
            }
          });
          state.actions.appendChild(button);
          if (index === 0) {
            window.requestAnimationFrame(() => button.focus());
          }
        });

        state.root.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        return state;
      }

      async function resolveSelectionScope(items, { actionLabel = 'alterar a distribuição', destructive = false, moveAction = false, subjectLabel = 'participantes', includeRecurring = false } = {}) {
        const scopedItems = (items || []).filter(item => item.has_future_installments || (includeRecurring && Number(item.recurring_rule_id || 0) > 0));
        if (!scopedItems.length) {
          return 'single';
        }

        const recurringCount = scopedItems.filter(item => Number(item.recurring_rule_id || 0) > 0).length;
        const installmentCount = scopedItems.filter(item => item.has_future_installments && Number(item.recurring_rule_id || 0) <= 0).length;
        const plainCount = Math.max(0, (items || []).length - scopedItems.length);
        const hasRecurring = recurringCount > 0;
        const hasInstallments = installmentCount > 0;
        const scopeGroupLabel = hasRecurring && hasInstallments
          ? 'compras parceladas e recorrentes'
          : hasRecurring
            ? 'compras recorrentes'
            : 'compras parceladas';
        const scopeFutureLabel = hasRecurring && hasInstallments
          ? 'Itens Atuais + Próximas Parcelas/Recorrências'
          : hasRecurring
            ? 'Itens Atuais + Próximas Recorrências'
            : 'Itens Atuais + Próximas Parcelas';
        const scopeFutureDescription = hasRecurring && hasInstallments
          ? 'Também aplica a ação nas próximas parcelas e nas próximas recorrências já ligadas aos itens selecionados.'
          : hasRecurring
            ? 'Também aplica a ação nas próximas recorrências, incluindo lançamentos futuros que já tenham nascido.'
            : 'Também aplica a ação nas próximas parcelas de cada compra parcelada selecionada.';
        const title = destructive
          ? (items.length > 1 ? `Excluir ${scopeGroupLabel}` : `Excluir ${hasRecurring ? 'compra recorrente' : 'compra parcelada'}`)
          : moveAction
            ? (items.length > 1 ? 'Mover compras parceladas' : 'Mover compra parcelada')
            : (items.length > 1 ? `Aplicar ${subjectLabel} em ${scopeGroupLabel}` : `Aplicar ${subjectLabel} em ${hasRecurring ? 'compra recorrente' : 'compra parcelada'}`);

        const messageParts = [
          `${items.length} compra(s) · ${formatMoney(sumAmounts(items))}`,
          `${scopedItems.length} item(ns) com alcance futuro exigem confirmação antes de concluir ${actionLabel}.`,
          'Só compras atuais: altera apenas as compras selecionadas agora.',
          `${scopeFutureLabel}: ${scopeFutureDescription}`
        ];

        if (plainCount > 0) {
          messageParts.push(`Os ${plainCount} item(ns) sem parcelamento nem recorrência continuam sendo alterados apenas uma vez.`);
        }

        if (moveAction) {
          messageParts.push('A data da compra será mantida; o app ajusta apenas a fatura/mês de cobrança.');
        }

        if (window.showActionDialog) {
          return await window.showActionDialog({
            title,
            message: messageParts.join('\n\n'),
            options: destructive
              ? [
                  { label: 'Excluir Só Itens Atuais', value: 'single', tone: 'danger' },
                  { label: `Excluir ${scopeFutureLabel}`, value: 'future', tone: 'danger' },
                  { label: 'Cancelar', value: null, tone: 'cancel' }
                ]
              : moveAction
                ? [
                    { label: 'Mover Só Itens Atuais', value: 'single', tone: 'primary' },
                    { label: 'Mover Itens Atuais + Próximas Parcelas', value: 'future', tone: 'primary' },
                    { label: 'Cancelar', value: null, tone: 'cancel' }
                  ]
                : [
                    { label: 'Aplicar Só Itens Atuais', value: 'single', tone: 'primary' },
                    { label: `Aplicar ${scopeFutureLabel}`, value: 'future', tone: 'primary' },
                    { label: 'Cancelar', value: null, tone: 'cancel' }
                  ]
          });
        }

        const fallbackText = hasRecurring
          ? (items.length > 1
              ? `Aplicar ${actionLabel} em ${items.length} compra(s), incluindo próximas parcelas e recorrências quando existir alcance futuro?`
              : 'Aplicar essa mudança também nas próximas parcelas ou recorrências desta compra?')
          : (items.length > 1
              ? `Aplicar ${actionLabel} em ${items.length} compra(s), incluindo próximas parcelas das compras parceladas?`
              : `Aplicar ${actionLabel} incluindo próximas parcelas desta compra parcelada?`);
        return window.confirm(fallbackText) ? 'future' : 'single';
      }

      async function confirmDeleteScope(items, scope) {
        const safeScope = String(scope || 'single');
        const count = Array.isArray(items) ? items.length : 0;
        const hasFuture = safeScope === 'future';
        const message = hasFuture
          ? (count > 1
              ? 'Confirmar a exclusão das compras selecionadas e também das próximas parcelas das compras parceladas envolvidas? Isso apaga os itens e as divisões associadas.'
              : 'Confirmar a exclusão desta compra e também das próximas parcelas desta compra parcelada? Isso apaga o item e as divisões associadas.')
          : (count > 1
              ? `Confirmar a exclusão de ${count} compra(s) selecionada(s)? Isso apaga os itens e as divisões associadas.`
              : 'Confirmar a exclusão desta compra? Isso apaga o item e a divisão associada.');

        if (window.confirmTypedAction) {
          return await window.confirmTypedAction(message);
        }

        return window.confirm(message);
      }

      async function postBulkAction(url, payload) {
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          let data = null;
          try {
            data = await response.json();
          } catch (_) {
            data = null;
          }

          if (!response.ok || !data || data.ok === false) {
            throw new Error((data && data.error) || (data && data.message) || 'Não foi possível concluir a ação.');
          }

          showAllocMessage(data.message || 'Ação concluída com sucesso.', 'success');
          exitSelectionMode();
          window.setTimeout(() => window.location.reload(), 450);
          return true;
        } catch (error) {
          console.error(error);
          showAllocMessage(error.message || 'Não foi possível concluir a ação.', 'error');
          return false;
        }
      }

      function getUniformSelection(items) {
        if (!items.length) return [];
        const signatures = items.map(item => (item.selected_ids || []).map(Number).sort((a, b) => a - b).join(','));
        const first = signatures[0];
        const same = signatures.every(signature => signature === first);
        if (!same) return null;
        return first ? first.split(',').map(Number).filter(Number.isInteger) : [];
      }

      function buildPersonCard(person, checked) {
        const label = document.createElement('label');
        label.className = 'group min-w-0 cursor-pointer';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = 'person_ids';
        input.value = String(person.id);
        input.className = 'peer sr-only';
        input.checked = checked;

        const card = document.createElement('span');
        card.className = 'flex min-h-[58px] items-center gap-2 rounded-[18px] border border-slate-200/80 bg-white/90 px-3 py-2.5 shadow-sm transition-all group-hover:border-blue-300 group-hover:shadow-md peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-lg dark:border-slate-700 dark:bg-slate-900/60 dark:group-hover:border-blue-500 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-950/35';

        const name = document.createElement('span');
        name.className = 'min-w-0 flex-1 text-sm font-bold leading-5 text-slate-800 dark:text-slate-100';
        name.textContent = (person.is_self || String(person.profile_kind || '').toLowerCase() === 'self' || person.is_owner) ? 'Eu' : person.name;

        const badge = document.createElement('span');
        badge.className = 'inline-flex h-8 w-8 flex-none items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-400 transition-all peer-checked:border-blue-500 peer-checked:bg-blue-600 peer-checked:text-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-500 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-500 dark:peer-checked:text-white';
        badge.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';

        card.appendChild(name);
        card.appendChild(badge);
        label.appendChild(input);
        label.appendChild(card);
        return label;
      }

      function buildEqualShareMapLocal(totalCents, personIds) {
        const ids = Array.from(new Set((personIds || []).map(Number).filter(Number.isInteger)));
        const shareMap = {};
        if (!ids.length) return shareMap;
        const numericTotal = Number(totalCents || 0);
        const share = Math.floor(numericTotal / ids.length);
        const remainder = numericTotal - (share * ids.length);
        ids.forEach((pid, idx) => {
          const extra = idx < Math.abs(remainder) ? Math.sign(remainder) : 0;
          shareMap[pid] = share + extra;
        });
        return shareMap;
      }

      function normalizeSelectedShares(item) {
        const map = {};
        if (!item || !item.selected_shares || typeof item.selected_shares !== 'object') return map;
        Object.entries(item.selected_shares).forEach(([rawKey, rawValue]) => {
          const key = Number(rawKey || 0);
          if (Number.isInteger(key) && key > 0) map[key] = Number(rawValue || 0);
        });
        return map;
      }

      function bindDynamicMoneyMask(input) {
        if (!(input instanceof HTMLInputElement)) return;
        if (window.OPMoneyMask && typeof window.OPMoneyMask.bind === 'function') {
          window.OPMoneyMask.bind(input);
          return;
        }
        input.setAttribute('inputmode', 'numeric');
      }

      function buildSplitModeOption({ title, description, value, checked, accentClass }) {
        const label = document.createElement('label');
        label.className = 'group h-full cursor-pointer';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'split_mode_choice';
        input.value = value;
        input.className = 'peer sr-only';
        input.checked = checked;

        const card = document.createElement('span');
        card.className = `flex h-full items-start gap-3 rounded-[20px] border border-slate-200 bg-white px-4 py-3.5 shadow-sm transition-all group-hover:border-slate-300 group-hover:shadow-md ${accentClass} dark:border-slate-700 dark:bg-slate-900/60`;
        card.innerHTML = `<span class="mt-0.5 inline-flex h-9 w-9 flex-none items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-500 transition-all peer-checked:border-current peer-checked:bg-current peer-checked:text-white dark:border-slate-700 dark:bg-slate-950">${value === 'exact' ? '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-3.314 0-6 2.239-6 5 0 1.657.97 3.126 2.465 4.038L8 21l3.211-2.14A7.43 7.43 0 0012 19c3.314 0 6-2.239 6-5s-2.686-5-6-5z"></path></svg>' : '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'}</span><span class="min-w-0"><span class="block text-sm font-black text-slate-900 dark:text-slate-100">${escapeHtml(title)}</span><span class="mt-1 block text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">${escapeHtml(description)}</span></span>`;

        label.appendChild(input);
        label.appendChild(card);
        return label;
      }

      function openPeopleSheet(txnIds) {
        const items = getTxnItems(txnIds);
        if (!items.length) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'space-y-4';

        const summary = document.createElement('div');
        summary.className = 'rounded-[22px] border border-slate-200 bg-slate-50/90 px-4 py-3 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-200';
        summary.textContent = items.length > 1
          ? `${items.length} compra(s) selecionada(s) · ${formatMoney(sumAmounts(items))}`
          : `${items[0].description} · ${formatMoney(items[0].amount_cents)}`;
        wrapper.appendChild(summary);

        const uniformSelection = getUniformSelection(items);
        const singleItem = items.length === 1 ? items[0] : null;
        const initialSelectedIds = uniformSelection !== null
          ? uniformSelection
          : (singleItem ? (singleItem.selected_ids || []).map(Number) : []);
        const exactModeAvailable = !!singleItem && Number(singleItem.amount_cents || 0) >= 0;
        const draftShares = { ...(singleItem ? normalizeSelectedShares(singleItem) : {}) };

        if (uniformSelection === null && items.length > 1) {
          const note = document.createElement('div');
          note.className = 'rounded-[22px] border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200';
          note.textContent = 'Os itens selecionados têm distribuições diferentes. A seleção abaixo substituirá a distribuição atual de todos eles.';
          wrapper.appendChild(note);
        }

        const selectionSection = document.createElement('section');
        selectionSection.className = 'space-y-3';
        wrapper.appendChild(selectionSection);

        const selectionHeader = document.createElement('div');
        selectionHeader.className = 'flex flex-wrap items-start justify-between gap-3';
        selectionHeader.innerHTML = `
          <div>
            <div class="text-sm font-black text-slate-900 dark:text-slate-100">Quem entra nessa divisão?</div>
            <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Marque as pessoas participantes. A grade fica mais compacta para aguentar de 2 até 20 nomes sem engolir os botões finais.</p>
          </div>
        `;
        selectionSection.appendChild(selectionHeader);

        const selectionCounter = document.createElement('span');
        selectionCounter.className = 'inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300';
        selectionHeader.appendChild(selectionCounter);

        if (!people.length) {
          const empty = document.createElement('div');
          empty.className = 'rounded-[22px] border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300';
          empty.textContent = 'Nenhuma pessoa visível neste mês para aplicar a distribuição.';
          selectionSection.appendChild(empty);
        } else {
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-2 gap-2 md:grid-cols-3 lg:grid-cols-5';
          people.forEach(person => {
            grid.appendChild(buildPersonCard(person, initialSelectedIds.includes(Number(person.id))));
          });
          selectionSection.appendChild(grid);
        }

        const splitModeSection = document.createElement('section');
        splitModeSection.className = 'space-y-3 hidden';
        splitModeSection.hidden = true;

        const splitModeHeader = document.createElement('div');
        splitModeHeader.innerHTML = `
          <div class="text-sm font-black text-slate-900 dark:text-slate-100">Como você quer dividir essa compra?</div>
          <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Quando entram 2 ou mais pessoas, escolha o estilo da divisão antes de salvar.</p>
        `;
        splitModeSection.appendChild(splitModeHeader);

        const splitModeBody = document.createElement('div');
        splitModeBody.className = 'space-y-3';

        const splitModeGrid = document.createElement('div');
        splitModeGrid.className = 'grid gap-2 sm:grid-cols-2 lg:max-w-[30rem]';

        const equalOption = buildSplitModeOption({
          title: 'Partes iguais',
          description: 'O app reparte sozinho entre as pessoas marcadas.',
          value: 'equal',
          checked: false,
          accentClass: 'peer-checked:border-emerald-400 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 dark:peer-checked:border-emerald-500 dark:peer-checked:bg-emerald-950/25'
        });
        const exactOption = buildSplitModeOption({
          title: 'Valor definido',
          description: 'Você dita o valor de cada pessoa, sem chute e sem susto.',
          value: 'exact',
          checked: false,
          accentClass: 'peer-checked:border-violet-400 peer-checked:bg-violet-50 peer-checked:text-violet-700 dark:peer-checked:border-violet-500 dark:peer-checked:bg-violet-950/25'
        });
        splitModeGrid.appendChild(equalOption);
        splitModeGrid.appendChild(exactOption);
        splitModeBody.appendChild(splitModeGrid);

        const exactPanel = document.createElement('div');
        exactPanel.className = 'space-y-4 rounded-[24px] border border-violet-200 bg-violet-50/80 p-4 dark:border-violet-900/70 dark:bg-violet-950/20 hidden';
        exactPanel.hidden = true;

        const exactIntro = document.createElement('div');
        exactIntro.className = 'text-sm font-semibold text-violet-900 dark:text-violet-200';
        exactIntro.textContent = singleItem
          ? `Total da compra: ${formatMoney(singleItem.amount_cents)}. Preencha até fechar certinho.`
          : 'Valor definido fica disponível quando você abre uma compra por vez.';
        exactPanel.appendChild(exactIntro);

        const exactFields = document.createElement('div');
        exactFields.className = 'grid gap-3 lg:grid-cols-2';
        exactPanel.appendChild(exactFields);

        const exactTotals = document.createElement('div');
        exactTotals.className = 'rounded-[18px] border border-white/70 bg-white/85 px-4 py-3 text-sm dark:border-slate-800 dark:bg-slate-900/60';
        exactPanel.appendChild(exactTotals);

        splitModeBody.appendChild(exactPanel);
        splitModeSection.appendChild(splitModeBody);
        wrapper.appendChild(splitModeSection);

        const multiExactNote = document.createElement('div');
        multiExactNote.className = 'rounded-[22px] border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-800 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200';
        multiExactNote.textContent = 'Quer usar valores definidos? Abra uma compra por vez. Em seleção múltipla, o app mantém só a divisão em partes iguais para não misturar os totais.';
        multiExactNote.hidden = items.length === 1;
        multiExactNote.classList.toggle('hidden', items.length === 1);
        wrapper.appendChild(multiExactNote);

        const modeInputs = () => Array.from(splitModeGrid.querySelectorAll('input[name="split_mode_choice"]'));
        const getSelectedIds = () => Array.from(wrapper.querySelectorAll('input[name="person_ids"]:checked'))
          .map(input => Number(input.value))
          .filter(Number.isInteger);
        let saveActionButtons = [];

        function clearSplitModeChoice() {
          modeInputs().forEach((input) => {
            input.checked = false;
          });
        }

        function syncSelectionCounter() {
          const count = getSelectedIds().length;
          selectionCounter.textContent = count === 0
            ? 'Ninguém marcado'
            : (count === 1 ? '1 participante marcado' : `${count} participantes marcados`);
        }

        function getSplitMode() {
          const active = splitModeGrid.querySelector('input[name="split_mode_choice"]:checked');
          return active ? String(active.value || '') : '';
        }

        function renderExactFields() {
          exactFields.innerHTML = '';
          if (!singleItem) return;
          const selectedIds = getSelectedIds();
          const defaultMap = buildEqualShareMapLocal(Number(singleItem.amount_cents || 0), selectedIds);

          selectedIds.forEach((personId) => {
            const person = people.find(entry => Number(entry.id) === Number(personId));
            if (!person) return;
            if (draftShares[personId] === undefined) draftShares[personId] = defaultMap[personId] || 0;

            const row = document.createElement('label');
            row.className = 'rounded-[20px] border border-white/80 bg-white/90 px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-900/70';

            const header = document.createElement('div');
            header.className = 'mb-2 flex items-center justify-between gap-3';
            const isSelfPerson = person.is_self || String(person.profile_kind || '').toLowerCase() === 'self' || person.is_owner;
            const personTitle = isSelfPerson ? 'Minha parte' : person.name;
            const personHint = isSelfPerson ? 'Minha parte' : 'Digite a parte dessa pessoa';
            header.innerHTML = `<span class="text-sm font-black text-slate-900 dark:text-slate-100">${escapeHtml(personTitle)}</span><span class="text-xs font-semibold text-slate-500 dark:text-slate-400">${escapeHtml(personHint)}</span>`;
            row.appendChild(header);

            const input = document.createElement('input');
            input.type = 'text';
            input.name = `share_amounts[${personId}]`;
            input.placeholder = '0,00';
            input.value = window.OPMoneyMask && typeof window.OPMoneyMask.formatFromCents === 'function'
              ? window.OPMoneyMask.formatFromCents(draftShares[personId])
              : formatMoney(draftShares[personId]);
            input.className = 'w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-bold text-slate-900 shadow-sm focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900/70 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20';
            input.setAttribute('data-money-mask', '1');
            bindDynamicMoneyMask(input);
            input.addEventListener('input', () => {
              draftShares[personId] = window.OPMoneyMask && typeof window.OPMoneyMask.toCents === 'function'
                ? window.OPMoneyMask.toCents(input.value)
                : Number(String(input.value || '').replace(/\D/g, '')) || 0;
              syncExactTotals();
            });
            row.appendChild(input);
            exactFields.appendChild(row);
          });
        }

        function syncExactTotals() {
          if (!singleItem) {
            exactTotals.innerHTML = '';
            return;
          }
          const selectedIds = getSelectedIds();
          const typedTotal = selectedIds.reduce((sum, personId) => sum + Number(draftShares[personId] || 0), 0);
          const targetTotal = Number(singleItem.amount_cents || 0);
          const diff = targetTotal - typedTotal;
          let toneClass = 'text-emerald-700 dark:text-emerald-300';
          let helperText = 'Fechou certinho. Agora é só salvar.';
          if (diff > 0) {
            toneClass = 'text-amber-700 dark:text-amber-300';
            helperText = `Ainda falta ${formatMoney(diff)} para bater com o total.`;
          } else if (diff < 0) {
            toneClass = 'text-red-700 dark:text-red-300';
            helperText = `Passou ${formatMoney(Math.abs(diff))}. Dá uma aparada e segue o baile.`;
          }
          exactTotals.innerHTML = `
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500">Resumo da divisão</div>
                <div class="mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300">Compra: ${escapeHtml(formatMoney(targetTotal))}</div>
              </div>
              <div class="text-right">
                <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500">Somando agora</div>
                <div class="mt-1 text-lg font-black text-slate-900 dark:text-slate-100">${escapeHtml(formatMoney(typedTotal))}</div>
              </div>
            </div>
            <div class="mt-3 text-sm font-bold ${toneClass}">${escapeHtml(helperText)}</div>
          `;
        }

        function syncSaveButtonState() {
          if (!saveActionButtons.length) return;
          const selectedIds = getSelectedIds();
          const needsExplicitChoice = exactModeAvailable && selectedIds.length > 1;
          const disabled = !people.length || (needsExplicitChoice && !getSplitMode());
          saveActionButtons.forEach((button) => {
            if (button) button.disabled = disabled;
          });
        }

        function syncSplitUi() {
          const selectedIds = getSelectedIds();
          const canPickMode = exactModeAvailable && selectedIds.length > 1;
          if (!canPickMode) {
            clearSplitModeChoice();
          }

          splitModeSection.hidden = !canPickMode;
          splitModeSection.classList.toggle('hidden', !canPickMode);
          multiExactNote.hidden = items.length === 1;
          multiExactNote.classList.toggle('hidden', items.length === 1);

          const wantsExact = canPickMode && getSplitMode() === 'exact';
          exactPanel.hidden = !wantsExact;
          exactPanel.classList.toggle('hidden', !wantsExact);

          if (wantsExact) {
            renderExactFields();
            syncExactTotals();
          } else {
            exactFields.innerHTML = '';
            exactTotals.innerHTML = '';
          }

          syncSelectionCounter();
          syncSaveButtonState();
        }

        wrapper.querySelectorAll('input[name="person_ids"]').forEach((input) => {
          input.addEventListener('change', () => {
            syncSplitUi();
          });
        });
        modeInputs().forEach((input) => {
          input.addEventListener('change', () => {
            syncSplitUi();
          });
        });
        async function submitAllocationChange(deliveryMode = 'send_now') {
          const checkedIds = getSelectedIds();
          const payload = {
            txn_ids: txnIds,
            person_ids: checkedIds,
            apply_scope: 'single',
            delivery_mode: deliveryMode
          };

          if (checkedIds.length > 1) {
            const selectedMode = exactModeAvailable ? getSplitMode() : 'equal';
            if (exactModeAvailable && !selectedMode) {
              showAllocMessage('Escolha o tipo de divisão antes de salvar.', 'warning');
              syncSplitUi();
              return false;
            }
            payload.split_mode = selectedMode;
          }

          if (singleItem && checkedIds.length > 1 && getSplitMode() === 'exact') {
            const targetTotal = Number(singleItem.amount_cents || 0);
            const typedTotal = checkedIds.reduce((sum, personId) => sum + Number(draftShares[personId] || 0), 0);
            if (typedTotal !== targetTotal) {
              syncExactTotals();
              showAllocMessage('Os valores definidos ainda não fecharam com o total da compra.', 'warning');
              return false;
            }
            payload.share_amounts = checkedIds.reduce((acc, personId) => {
              acc[personId] = Number(draftShares[personId] || 0);
              return acc;
            }, {});
          }

          const actionLabel = deliveryMode === 'draft' ? 'guardar a distribuição' : 'alterar a distribuição';
          const scope = await resolveSelectionScope(items, { actionLabel });
          if (!scope) return false;
          payload.apply_scope = scope;
          const ok = await postBulkAction(`/month/${currentYear}/${currentMonth}/bulk/alloc`, payload);
          if (ok) ensureMonthSheet().close();
          return false;
        }

        const saveNowAction = {
          label: 'Salvar Divisão',
          tone: 'primary',
          closeOnClick: false,
          disabled: !people.length,
          onClick: async () => submitAllocationChange('send_now')
        };

        const saveLaterAction = {
          label: 'Salvar e Mandar Depois',
          tone: 'primary',
          closeOnClick: false,
          disabled: !people.length,
          onClick: async () => submitAllocationChange('draft')
        };

        const sheetState = openMonthSheet({
          title: items.length > 1 ? 'Aplicar participantes' : 'Selecionar participantes',
          subtitle: items.length > 1
            ? 'A distribuição será substituída em todos os itens selecionados.'
            : 'Escolha quem participa e, se quiser, dite o valor de cada um.',
          body: wrapper,
          size: 'people',
          actions: [
            saveNowAction,
            saveLaterAction,
            { label: 'Cancelar', tone: 'cancel' }
          ]
        });
        saveActionButtons = Array.from(sheetState.actions.querySelectorAll('button')).slice(0, 2);
        syncSelectionCounter();
        syncSplitUi();
      }

      function openCategorySheet(txnIds) {
        const items = getTxnItems(txnIds);
        if (!items.length) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'space-y-4';

        const summary = document.createElement('div');
        summary.className = 'rounded-[22px] border border-slate-200 bg-slate-50/90 px-4 py-3 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-200';
        summary.innerHTML = `<div class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Seleção</div><div class="mt-1 text-sm font-black">${items.length > 1 ? `${items.length} compra(s)` : escapeHtml(items[0].description)} · ${escapeHtml(formatMoney(sumAmounts(items)))}</div>`;
        wrapper.appendChild(summary);

        const categoryIds = Array.from(new Set(items.map(item => Number(item.purchase_category_id || 0)).filter((value) => Number.isInteger(value) && value > 0)));
        const uniformCategoryId = categoryIds.length === 1 && items.every(item => Number(item.purchase_category_id || 0) === categoryIds[0]) ? categoryIds[0] : null;
        const uniformCategoryName = uniformCategoryId && items.every(item => String(item.purchase_category_name || '') === String(items[0].purchase_category_name || ''))
          ? String(items[0].purchase_category_name || '')
          : '';
        const hasMixedCategories = items.some(item => Number(item.purchase_category_id || 0) !== Number(items[0].purchase_category_id || 0));

        const currentState = document.createElement('div');
        currentState.className = hasMixedCategories
          ? 'rounded-[22px] border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
          : 'rounded-[22px] border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-900 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200';
        currentState.innerHTML = hasMixedCategories
          ? '<div class="text-xs font-bold uppercase tracking-wide text-amber-500/80 dark:text-amber-300/80">Estado atual</div><div class="mt-1">As compras selecionadas estão com categorias diferentes. O que você escolher agora substitui tudo de uma vez.</div>'
          : `<div class="text-xs font-bold uppercase tracking-wide text-blue-500/80 dark:text-blue-300/80">Estado atual</div><div class="mt-1">${uniformCategoryId ? `Categoria atual: <strong>${escapeHtml(uniformCategoryName || 'Categoria atual')}</strong>.` : 'As compras selecionadas estão sem categoria por enquanto.'}</div>`;
        wrapper.appendChild(currentState);

        const selectorShell = document.createElement('div');
        selectorShell.className = 'space-y-3';
        selectorShell.setAttribute('data-purchase-category-control', '');
        wrapper.appendChild(selectorShell);

        const selectorField = document.createElement('div');
        selectorField.innerHTML = '<label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Nova categoria</label>';
        const select = document.createElement('select');
        select.name = 'purchase_category_id';
        select.setAttribute('data-purchase-category-select', '');
        select.className = 'w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950';
        select.innerHTML = '<option value="">Sem categoria por enquanto</option>';

        purchaseCategories.forEach((category) => {
          const option = document.createElement('option');
          option.value = String(category.id);
          option.textContent = category.name;
          if (uniformCategoryId && Number(category.id) === Number(uniformCategoryId)) option.selected = true;
          select.appendChild(option);
        });

        if (uniformCategoryId && !purchaseCategories.some((category) => Number(category.id) === Number(uniformCategoryId))) {
          const archivedOption = document.createElement('option');
          archivedOption.value = String(uniformCategoryId);
          archivedOption.textContent = `${uniformCategoryName || 'Categoria atual'} (arquivada)`;
          archivedOption.selected = true;
          select.appendChild(archivedOption);
        }

        const newOption = document.createElement('option');
        newOption.value = '__new__';
        newOption.textContent = 'Criar categoria nova';
        select.appendChild(newOption);
        selectorField.appendChild(select);
        selectorShell.appendChild(selectorField);

        const customShell = document.createElement('div');
        customShell.hidden = true;
        customShell.setAttribute('data-purchase-category-custom-shell', '');
        customShell.innerHTML = '<label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Nome da nova categoria</label><input type="text" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950">';
        selectorShell.appendChild(customShell);

        const helper = document.createElement('p');
        helper.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';
        helper.textContent = 'Isso ajuda a organizar o mês e não mexe no valor nem na divisão da compra.';
        wrapper.appendChild(helper);

        if (window.OPInitPurchaseCategoryControls) {
          window.OPInitPurchaseCategoryControls(wrapper);
        } else {
          const wantsCustom = () => String(select.value || '') === '__new__';
          const customInput = customShell.querySelector('[data-purchase-category-custom-input]');
          const syncCustom = () => {
            customShell.hidden = !wantsCustom();
            if (customInput) {
              customInput.disabled = !wantsCustom();
              if (!wantsCustom()) customInput.value = '';
            }
          };
          select.addEventListener('change', syncCustom);
          syncCustom();
        }

        openMonthSheet({
          title: items.length > 1 ? 'Mudar categoria das compras' : 'Mudar categoria da compra',
          subtitle: items.length > 1 ? 'A categoria escolhida será aplicada em todos os itens selecionados.' : 'Escolha a categoria que faz mais sentido para essa compra.',
          body: wrapper,
          actions: [
            {
              label: 'Salvar Categoria',
              tone: 'primary',
              closeOnClick: false,
              onClick: async () => {
                const customInput = wrapper.querySelector('[data-purchase-category-custom-input]');
                const selectedValue = String(select.value || '');
                const customValue = customInput instanceof HTMLInputElement ? customInput.value.trim() : '';
                if (selectedValue === '__new__' && !customValue) {
                  showAllocMessage('Dê um nome para a nova categoria antes de salvar.', 'warning');
                  return false;
                }
                const scope = await resolveSelectionScope(items, { actionLabel: 'mudar a categoria', subjectLabel: items.length > 1 ? 'categorias' : 'categoria', includeRecurring: true });
                if (!scope) return false;
                const ok = await postBulkAction(`/month/${currentYear}/${currentMonth}/bulk/category`, {
                  txn_ids: txnIds,
                  purchase_category_id: selectedValue,
                  purchase_category_custom: customValue,
                  apply_scope: scope
                });
                if (ok) ensureMonthSheet().close();
                return false;
              }
            },
            { label: 'Cancelar', tone: 'cancel' }
          ]
        });
      }

      function openMoveSheet(txnIds) {
        const items = getTxnItems(txnIds);
        if (!items.length) return;

        const recurringItem = items.find(item => Number(item.recurring_rule_id || 0) > 0);
        if (recurringItem) {
          showAllocMessage('Compras recorrentes ainda não entram no fluxo de mover para outra fatura. Remova-as da seleção e tente novamente.', 'warning');
          return;
        }

        const baseMonth = Number(items[0].month || currentMonth);
        const baseYear = Number(items[0].year || currentYear);
        const defaultTarget = shiftMonthLocal(baseYear, baseMonth, 1);
        const years = [];
        for (let year = baseYear - 1; year <= baseYear + 3; year += 1) years.push(year);

        const wrapper = document.createElement('div');
        wrapper.className = 'space-y-4';

        const intro = document.createElement('div');
        intro.className = 'rounded-[22px] border border-slate-200 bg-slate-50/90 px-4 py-3 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-200';
        intro.innerHTML = `<div class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Seleção</div><div class="mt-1 text-sm font-black text-slate-900 dark:text-slate-100">${items.length} compra(s) · ${escapeHtml(formatMoney(sumAmounts(items)))}</div><p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">A data da compra será mantida. O app vai ajustar apenas a fatura/mês de cobrança.</p>`;
        wrapper.appendChild(intro);

        const quickRow = document.createElement('div');
        quickRow.className = 'grid grid-cols-2 gap-2';
        const quickPrev = document.createElement('button');
        quickPrev.type = 'button';
        quickPrev.className = 'inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800';
        quickPrev.textContent = 'Fatura anterior';
        const quickNext = document.createElement('button');
        quickNext.type = 'button';
        quickNext.className = 'inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white';
        quickNext.textContent = 'Próxima fatura';
        quickRow.appendChild(quickPrev);
        quickRow.appendChild(quickNext);
        wrapper.appendChild(quickRow);

        const grid = document.createElement('div');
        grid.className = 'grid gap-3 sm:grid-cols-2';
        const monthField = document.createElement('div');
        const monthLabelEl = document.createElement('label');
        monthLabelEl.className = 'mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400';
        monthLabelEl.textContent = 'Mês da fatura';
        const monthSelect = document.createElement('select');
        monthSelect.className = 'w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950';
        monthNames.forEach((name, index) => {
          const option = document.createElement('option');
          option.value = String(index + 1);
          option.textContent = name;
          if ((index + 1) === Number(defaultTarget.month)) option.selected = true;
          monthSelect.appendChild(option);
        });
        monthField.appendChild(monthLabelEl);
        monthField.appendChild(monthSelect);

        const yearField = document.createElement('div');
        const yearLabelEl = document.createElement('label');
        yearLabelEl.className = 'mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400';
        yearLabelEl.textContent = 'Ano da fatura';
        const yearSelect = document.createElement('select');
        yearSelect.className = 'w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950';
        years.forEach(value => {
          const option = document.createElement('option');
          option.value = String(value);
          option.textContent = String(value);
          if (value === Number(defaultTarget.year)) option.selected = true;
          yearSelect.appendChild(option);
        });
        yearField.appendChild(yearLabelEl);
        yearField.appendChild(yearSelect);

        grid.appendChild(monthField);
        grid.appendChild(yearField);
        wrapper.appendChild(grid);

        const preview = document.createElement('div');
        preview.className = 'rounded-[22px] border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-900 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200';
        const updatePreview = () => {
          preview.innerHTML = `<div class="text-xs font-bold uppercase tracking-wide text-blue-500/80 dark:text-blue-300/80">Destino</div><div class="mt-1 text-sm font-black">${escapeHtml(formatMonthLabel(monthSelect.value, yearSelect.value))}</div>`;
        };
        monthSelect.addEventListener('change', updatePreview);
        yearSelect.addEventListener('change', updatePreview);
        updatePreview();
        wrapper.appendChild(preview);

        quickPrev.addEventListener('click', () => {
          const target = shiftMonthLocal(baseYear, baseMonth, -1);
          monthSelect.value = String(target.month);
          yearSelect.value = String(target.year);
          updatePreview();
        });

        quickNext.addEventListener('click', () => {
          const target = shiftMonthLocal(baseYear, baseMonth, 1);
          monthSelect.value = String(target.month);
          yearSelect.value = String(target.year);
          updatePreview();
        });

        openMonthSheet({
          title: items.length > 1 ? 'Mover para outra fatura' : 'Mover compra',
          subtitle: items.length > 1 ? 'A mudança será aplicada em todos os itens selecionados.' : 'A data da compra continuará a mesma.',
          body: wrapper,
          actions: [
            {
              label: 'Mover para a Fatura Escolhida',
              tone: 'primary',
              closeOnClick: false,
              onClick: async () => {
                const targetMonth = Number(monthSelect.value || 0);
                const targetYear = Number(yearSelect.value || 0);
                if (targetMonth === baseMonth && targetYear === baseYear) {
                  showAllocMessage('Escolha uma fatura diferente do mês atual.', 'warning');
                  return false;
                }
                const scope = await resolveSelectionScope(items, { actionLabel: 'mover para outra fatura', moveAction: true });
                if (!scope) return false;
                const ok = await postBulkAction(`/month/${currentYear}/${currentMonth}/bulk/move`, {
                  txn_ids: txnIds,
                  target_month: targetMonth,
                  target_year: targetYear,
                  apply_scope: scope
                });
                if (ok) ensureMonthSheet().close();
                return false;
              }
            },
            { label: 'Cancelar', tone: 'cancel' }
          ]
        });
      }

      async function submitDelete(txnIds, scope = 'single') {
        return await postBulkAction(`/month/${currentYear}/${currentMonth}/bulk/delete`, {
          txn_ids: txnIds,
          apply_scope: scope
        });
      }

      function openDeleteSheet(txnIds) {
        const items = getTxnItems(txnIds);
        if (!items.length) return;

        const futureItems = items.filter(item => item.has_future_installments);
        const nonInstallmentCount = Math.max(0, items.length - futureItems.length);
        const wrapper = document.createElement('div');
        wrapper.className = 'space-y-4';

        const summary = document.createElement('div');
        summary.className = 'rounded-[22px] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900 dark:border-red-800 dark:bg-red-900/20 dark:text-red-100';
        summary.innerHTML = `<div class="text-xs font-bold uppercase tracking-wide text-red-500/80 dark:text-red-300/80">Exclusão</div><div class="mt-1 text-sm font-black">${items.length} compra(s) · ${escapeHtml(formatMoney(sumAmounts(items)))}</div><p class="mt-2 text-sm font-medium text-red-700/90 dark:text-red-200/90">Isso apaga as compras selecionadas e as divisões associadas.</p>`;
        wrapper.appendChild(summary);

        let scopeValue = 'single';

        if (futureItems.length) {
          const note = document.createElement('div');
          note.className = 'rounded-[22px] border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-100';
          note.innerHTML = `<div class="text-xs font-bold uppercase tracking-wide text-amber-500/90 dark:text-amber-300/80">Compras parceladas</div><p class="mt-1">${futureItems.length} item(ns) parcelado(s) exigem definição de alcance antes da exclusão.</p>${nonInstallmentCount > 0 ? `<p class="mt-2 text-sm font-medium text-amber-800/90 dark:text-amber-200/90">Os ${nonInstallmentCount} item(ns) sem parcelamento serão excluídos apenas uma vez.</p>` : ''}`;
          wrapper.appendChild(note);

          const scopeGroup = document.createElement('div');
          scopeGroup.className = 'space-y-3';

          const scopeTitle = document.createElement('div');
          scopeTitle.className = 'text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400';
          scopeTitle.textContent = 'Alcance da exclusão';
          scopeGroup.appendChild(scopeTitle);

          const options = [
            {
              value: 'single',
              title: futureItems.length > 1 ? 'Excluir só itens atuais' : 'Excluir só item atual',
              description: futureItems.length > 1
                ? 'Remove apenas as compras selecionadas neste mês.'
                : 'Remove apenas a compra selecionada neste mês.'
            },
            {
              value: 'future',
              title: futureItems.length > 1 ? 'Excluir itens atuais + próximas parcelas' : 'Excluir item atual + próximas parcelas',
              description: futureItems.length > 1
                ? 'Também remove as próximas parcelas de cada compra parcelada selecionada.'
                : 'Também remove as próximas parcelas desta compra parcelada.'
            }
          ];

          options.forEach((option, index) => {
            const label = document.createElement('label');
            label.className = 'group block cursor-pointer';

            const input = document.createElement('input');
            input.type = 'radio';
            input.name = 'delete_scope_choice';
            input.value = option.value;
            input.className = 'peer sr-only';
            input.checked = index === 0;
            input.addEventListener('change', () => {
              if (input.checked) scopeValue = option.value;
            });

            const card = document.createElement('span');
            card.className = 'block rounded-[22px] border border-slate-200 bg-white px-4 py-3 shadow-sm transition-all group-hover:-translate-y-0.5 group-hover:border-red-300 group-hover:shadow-md peer-checked:border-red-400 peer-checked:bg-red-50 peer-checked:shadow-lg dark:border-slate-700 dark:bg-slate-900/55 dark:group-hover:border-red-500 dark:peer-checked:border-red-500 dark:peer-checked:bg-red-950/30';
            card.innerHTML = `<span class="flex items-start justify-between gap-3"><span><span class="block text-sm font-black text-slate-900 dark:text-slate-100">${escapeHtml(option.title)}</span><span class="mt-1 block text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">${escapeHtml(option.description)}</span></span><span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full border border-slate-300 bg-white text-transparent peer-checked:border-red-500 peer-checked:bg-red-600 peer-checked:text-white dark:border-slate-600 dark:bg-slate-950 dark:peer-checked:border-red-500 dark:peer-checked:bg-red-500">✓</span></span>`;

            label.appendChild(input);
            label.appendChild(card);
            scopeGroup.appendChild(label);
          });

          wrapper.appendChild(scopeGroup);
        }

        openMonthSheet({
          title: items.length > 1 ? 'Confirmar exclusão' : 'Excluir compra',
          subtitle: futureItems.length ? 'Escolha o alcance da exclusão e confirme a ação.' : 'Confirme a exclusão da compra selecionada.',
          body: wrapper,
          actions: [
            {
              label: items.length > 1 ? 'Excluir Compras' : 'Excluir Compra',
              tone: 'danger',
              closeOnClick: false,
              onClick: async () => {
                const chosenScope = futureItems.length
                  ? String((wrapper.querySelector('input[name="delete_scope_choice"]:checked') || {}).value || scopeValue || 'single')
                  : 'single';
                const ok = await submitDelete(txnIds, chosenScope);
                if (ok) ensureMonthSheet().close();
                return false;
              }
            },
            { label: 'Cancelar', tone: 'cancel' }
          ]
        });
      }

      function executeDelete(txnIds) {
        openDeleteSheet(txnIds);
      }

      async function openSingleActionMenu(txnId) {
        const item = getTxnItem(txnId);
        if (!item) return;

        if (!window.showActionDialog) {
          openPeopleSheet([txnId]);
          return;
        }

        const message = [
          formatMoney(item.amount_cents),
          formatMonthLabel(item.month, item.year),
          item.recurring_rule_id ? 'Compra recorrente' : (item.has_future_installments ? 'Compra parcelada' : 'Compra do mês')
        ].filter(Boolean).join(' · ');

        const choice = await window.showActionDialog({
          title: item.description,
          message,
          options: [
            { label: 'Selecionar Participantes', value: 'people', tone: 'secondary' },
            { label: 'Mudar Categoria', value: 'category', tone: 'secondary' },
            { label: 'Mover para Outra Fatura', value: 'move', tone: 'secondary' },
            { label: 'Selecionar Vários', value: 'multi', tone: 'secondary' },
            { label: 'Excluir Compra', value: 'delete', tone: 'danger' },
            { label: 'Cancelar', value: null, tone: 'cancel' }
          ]
        });

        if (choice === 'people') {
          openPeopleSheet([txnId]);
          return;
        }
        if (choice === 'category') {
          openCategorySheet([txnId]);
          return;
        }
        if (choice === 'move') {
          openMoveSheet([txnId]);
          return;
        }
        if (choice === 'multi') {
          enterSelectionMode([txnId]);
          return;
        }
        if (choice === 'delete') {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              executeDelete([txnId]);
            });
          });
          return;
        }
      }

      function handleRowActivation(row, event) {
        const txnId = String(row.dataset.txnId || '');
        if (!txnId) return;

        if (selectionMode) {
          toggleSelection(txnId);
          return;
        }

        if (isClosed) {
          window.location.href = `/txn/${txnId}`;
          return;
        }

        if (event && (event.metaKey || event.ctrlKey)) {
          enterSelectionMode([txnId]);
          return;
        }

        openSingleActionMenu(txnId);
      }

      function attachLongPress(row) {
        if (isClosed) return;
        let timer = null;
        let startX = 0;
        let startY = 0;

        const clear = () => {
          if (timer) window.clearTimeout(timer);
          timer = null;
        };

        row.addEventListener('touchstart', (event) => {
          if (selectionMode) return;
          if (!event.touches || event.touches.length !== 1) return;
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
          const txnId = String(row.dataset.txnId || '');
          clear();
          timer = window.setTimeout(() => {
            row.dataset.longPressTriggered = '1';
            enterSelectionMode([txnId]);
            if (navigator.vibrate) navigator.vibrate(12);
            clear();
          }, 430);
        }, { passive: true });

        row.addEventListener('touchmove', (event) => {
          if (!timer || !event.touches || !event.touches.length) return;
          const deltaX = Math.abs(event.touches[0].clientX - startX);
          const deltaY = Math.abs(event.touches[0].clientY - startY);
          if (deltaX > 12 || deltaY > 12) clear();
        }, { passive: true });

        row.addEventListener('touchend', clear, { passive: true });
        row.addEventListener('touchcancel', clear, { passive: true });
      }

      rows.forEach(row => {
        row.addEventListener('click', (event) => {
          if (row.dataset.longPressTriggered === '1') {
            row.dataset.longPressTriggered = '';
            event.preventDefault();
            return;
          }
          handleRowActivation(row, event);
        });

        row.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          handleRowActivation(row, event);
        });

        row.addEventListener('contextmenu', (event) => {
          if (isClosed) return;
          event.preventDefault();
          handleRowActivation(row, event);
        });

        attachLongPress(row);
      });

      enterSelectionBtn?.addEventListener('click', () => enterSelectionMode());
      exitSelectionBtn?.addEventListener('click', exitSelectionMode);
      bulkCancelBtn?.addEventListener('click', exitSelectionMode);
      bulkPeopleBtn?.addEventListener('click', () => openPeopleSheet(getSelectedTxnIds()));
      bulkCategoryBtn?.addEventListener('click', () => openCategorySheet(getSelectedTxnIds()));
      bulkMoveBtn?.addEventListener('click', () => openMoveSheet(getSelectedTxnIds()));
      bulkDeleteBtn?.addEventListener('click', () => executeDelete(getSelectedTxnIds()));

      updateSelectionUI();
    });
  </script>

  <%- include("partials/footer") %>
