<%- include("partials/header", { title: `Cartões JP | Itens ${String(month).padStart(2,'0')}/${year}` }) %>

  <div class="max-w-7xl mx-auto pb-24">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Lançamentos — <%=
            String(month).padStart(2,'0') %>/<%= year %>
        </h1>
        <div id="allocMsg" class="text-sm font-bold text-emerald-600 mt-2 h-5 transition-all duration-300"></div>
      </div>
      <div class="flex gap-2">
        <a href="/summary/<%= year %>/<%= month %>"
          class="px-5 py-2.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all hover:-translate-y-0.5">Resumo
          do Mês</a>
        <a href="/import"
          class="px-5 py-2.5 rounded-xl font-bold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 shadow-sm transition-all">Importar
          Mais</a>
      </div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-5 mb-6">
      <form method="get" action="/month/<%= year %>/<%= month %>" class="grid md:grid-cols-6 gap-4">
        <input type="hidden" name="sort" value="<%= sort %>" />
        <input type="hidden" name="dir" value="<%= dir %>" />

        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Data</label>
          <input name="f_date" value="<%= filters.f_date || '' %>"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="Ex: 2026-03" />
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Descrição</label>
          <input name="f_desc" value="<%= filters.f_desc || '' %>"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="Ex: Uber, Mercado..." />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Cartão</label>
          <input name="f_card" value="<%= filters.f_card || '' %>"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="Ex: Nubank" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Nº (Final)</label>
          <input name="f_number" value="<%= filters.f_number || '' %>"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="****" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Valor</label>
          <input name="f_amount" value="<%= filters.f_amount || '' %>"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
            placeholder="49,90" />
        </div>

        <div class="md:col-span-1">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">Distribuído</label>
          <select name="f_allocated"
            class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Todos</option>
            <option value="sim" <%=filters.f_allocated==='sim' ? 'selected' : '' %>>Sim</option>
            <option value="nao" <%=filters.f_allocated==='nao' ? 'selected' : '' %>>Não</option>
          </select>
        </div>

        <div class="md:col-span-5 flex items-end gap-3">
          <button
            class="px-6 py-2.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-sm">Filtrar</button>
          <a class="px-6 py-2.5 rounded-xl font-bold text-slate-600 border border-slate-300 bg-white hover:bg-slate-50 transition-colors"
            href="/month/<%= year %>/<%= month %>">Limpar</a>
        </div>
      </form>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead
            class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('date') %>">Data</a></th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('desc') %>">Descrição</a></th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('card') %>">Cartão</a></th>
              <th class="px-4 py-4"><a class="hover:text-blue-600 transition-colors flex items-center"
                  href="<%= sortLink('number') %>">Nº</a></th>
              <th class="px-4 py-4 text-right"><a class="hover:text-blue-600 transition-colors inline-flex items-center"
                  href="<%= sortLink('amount') %>">Valor</a></th>
              <th class="px-4 py-4 text-center"><a
                  class="hover:text-blue-600 transition-colors inline-flex items-center"
                  href="<%= sortLink('allocated') %>">Ok?</a></th>
              <th class="px-4 py-4 text-center w-[340px]">Distribuição Rápida</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% txns.forEach(t=> { %>
              <tr class="hover:bg-slate-50/50 transition-colors group align-middle">
                <td class="px-4 py-3 font-medium text-slate-600 whitespace-nowrap">
                  <%= formatDateBR(t.txn_date) %>
                </td>
                <td class="px-4 py-3 font-bold text-slate-800 max-w-[200px] truncate" title="<%= t.description %>">
                  <%= t.description %>
                </td>
                <td class="px-4 py-3">
                  <span
                    class="inline-flex items-center px-2 py-1 rounded bg-slate-100 text-slate-700 font-bold text-xs border border-slate-200">
                    <%= t.card_name %>
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-500">
                  <%= t.card_number || "-" %>
                </td>
                <td class="px-4 py-3 text-right font-black text-slate-900">
                  <%= formatBRLFromCents(t.amount_cents) %>
                </td>

                <td class="px-4 py-3 text-center status-icon">
                  <% if (t.alloc_count> 0) { %>
                    <div
                      class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto"
                      title="Distribuído">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                    <% } else { %>
                      <div
                        class="w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto"
                        title="Não Distribuído">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                      </div>
                      <% } %>
                </td>

                <td class="px-4 py-3">
                  <form method="post" action="/txn/<%= t.id %>/alloc" data-alloc-form="<%= t.id %>"
                    class="bg-slate-50 border border-slate-200 rounded-xl p-2.5 shadow-inner transition-colors duration-300">

                    <div
                      class="grid grid-cols-3 gap-x-3 gap-y-0.5 mb-2 min-w-[300px] border border-slate-100 rounded-xl p-2 bg-slate-50/50">
                      <% people.forEach(p=> { %>
                        <label class="flex items-center gap-1.5 cursor-pointer select-none group py-0.5">
                          <input type="checkbox" name="person_ids" value="<%= p.id %>" <%=(t.selected_ids &&
                            t.selected_ids.includes(p.id)) ? "checked" : "" %>
                          class="w-3.5 h-3.5 text-blue-600 rounded border-slate-300 focus:ring-blue-500 bg-white" />

                          <span
                            class="text-[10px] font-semibold text-slate-600 group-hover:text-blue-600 truncate leading-tight">
                            <%= p.name.split(' ')[0] %>
      </span>
    </label>
  <% }) %>
</div>

                    <div class="flex items-center gap-2">
                      <button type="submit"
                        class="px-4 py-1.5 text-xs font-bold rounded-lg bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition-transform active:scale-95 btn-salvar-indiv">Salvar</button>

                      <button type="button" onclick="copyAlloc(' <%=t.id %>')"
                              class="px-3 py-1.5 text-[11px] font-bold rounded-lg border border-slate-300 bg-white
                              text-slate-600 hover:bg-slate-100 transition-colors"
                              title="Copiar atribuição">Copiar</button>

                              <button type="button" onclick="pasteAlloc('<%= t.id %>')"
                                class="px-3 py-1.5 text-[11px] font-bold rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-100 transition-colors"
                                title="Colar atribuição">Colar</button>

                              <a class="ml-auto px-3 py-1.5 text-[11px] font-bold rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-100 transition-colors"
                                href="/txn/<%= t.id %>">Detalhe</a>
                    </div>
                  </form>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (txns.length===0) { %>
      <div class="mt-6 p-6 rounded-3xl bg-amber-50 border-2 border-dashed border-amber-200 text-center">
        <h3 class="font-bold text-amber-900 mb-1">Nenhum resultado</h3>
        <p class="text-sm font-medium text-amber-700">Nenhum item encontrado com os filtros de busca atuais.</p>
      </div>
      <% } %>

  </div>

  <div id="globalSaveBar"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-4 rounded-2xl shadow-2xl z-50 items-center gap-5 transition-transform duration-300 translate-y-32 flex opacity-0 pointer-events-none">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold shadow-inner"
        id="modCount">0</div>
      <span class="font-medium text-sm">itens alterados e não salvos</span>
    </div>
    <button id="btnGlobalSave" onclick="saveAllModified()"
      class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 rounded-xl font-bold text-sm shadow-sm transition-colors flex items-center">
      Salvar Tudo Agora
    </button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const modifiedForms = new Set();
      const globalSaveBar = document.getElementById('globalSaveBar');
      const modCount = document.getElementById('modCount');
      const allocMsg = document.getElementById('allocMsg');
      const btnGlobalSave = document.getElementById('btnGlobalSave');

      // 1. Monitora todas as edições nos formulários
      document.querySelectorAll('form[data-alloc-form]').forEach(form => {
        // Quando marcar/desmarcar pessoa, marca como modificado
        form.addEventListener('change', () => markAsModified(form));

        // Quando clicar no "Salvar" individual
        form.addEventListener('submit', async (e) => {
          e.preventDefault(); // Impede o recarregamento da página (Filtro não se perde!)
          await saveForm(form);
        });
      });

      // Função que destaca a linha e exibe a barra flutuante
      function markAsModified(form) {
        modifiedForms.add(form);
        form.classList.add('bg-amber-50', 'border-amber-300'); // Destaca visualmente a caixa
        updateGlobalBar();
      }

      // Atualiza o contador da barra flutuante
      function updateGlobalBar() {
        if (modifiedForms.size > 0) {
          globalSaveBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
          modCount.innerText = modifiedForms.size;
        } else {
          globalSaveBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
        }
      }

      // A Mágica: Salva os dados silenciosamente e atualiza os ícones na tela
      window.saveForm = async function (form) {
        const btn = form.querySelector('.btn-salvar-indiv');
        const originalText = btn.innerHTML;
        btn.innerHTML = '...';
        btn.disabled = true;

        // Pega os dados do form
        const formData = new URLSearchParams(new FormData(form));

        try {
          // Envia os dados por baixo dos panos para o Node.js
          await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
          });

          // Remove o destaque amarelo de pendência
          modifiedForms.delete(form);
          form.classList.remove('bg-amber-50', 'border-amber-300');

          // Atualiza automaticamente o ícone de Ok/Falta (Verde ou Laranja)
          const statusTd = form.closest('tr').querySelector('.status-icon');
          if (statusTd) {
            const isAllocated = form.querySelectorAll('input[type="checkbox"]:checked').length > 0;
            if (isAllocated) {
              statusTd.innerHTML = `<div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto" title="Distribuído"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>`;
            } else {
              statusTd.innerHTML = `<div class="w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto" title="Não Distribuído"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>`;
            }
          }

          allocMsg.innerHTML = '<span class="text-emerald-600">Item salvo!</span>';
          setTimeout(() => allocMsg.innerHTML = '', 3000);
          updateGlobalBar();
        } catch (err) {
          allocMsg.innerHTML = '<span class="text-red-600">Erro ao salvar.</span>';
        } finally {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      };

      // Salva de uma vez todos os que estiverem destacados
      window.saveAllModified = async function () {
        const originalText = btnGlobalSave.innerHTML;
        btnGlobalSave.innerHTML = 'Processando...';
        btnGlobalSave.disabled = true;

        // Dispara o salvamento para todos simultaneamente
        const promises = Array.from(modifiedForms).map(f => saveForm(f));
        await Promise.all(promises);

        btnGlobalSave.innerHTML = originalText;
        btnGlobalSave.disabled = false;

        allocMsg.innerHTML = '<span class="text-emerald-600 font-extrabold text-base">Todas as alterações foram salvas com sucesso!</span>';
        setTimeout(() => allocMsg.innerHTML = '', 4000);
      };

      // Melhorando as funções de Copiar e Colar para interagir com o "Salvar Todos"
      window.copyAlloc = function (txnId) {
        const form = document.querySelector(`form[data-alloc-form="${txnId}"]`);
        if (!form) return;
        const cbs = form.querySelectorAll('input[name="person_ids"]:checked');
        window.copiedIds = Array.from(cbs).map(cb => cb.value);
        allocMsg.innerHTML = '<span class="text-blue-600">Atribuição copiada! Agora clique em Colar nos outros itens.</span>';
        setTimeout(() => allocMsg.innerHTML = '', 3000);
      };

      window.pasteAlloc = function (txnId) {
        if (!window.copiedIds) {
          allocMsg.innerHTML = '<span class="text-amber-600">Nenhuma atribuição copiada. Use o botão Copiar antes.</span>';
          return;
        }
        const form = document.querySelector(`form[data-alloc-form="${txnId}"]`);
        if (!form) return;

        const cbs = form.querySelectorAll('input[name="person_ids"]');
        cbs.forEach(cb => {
          cb.checked = window.copiedIds.includes(cb.value);
        });

        // Automaticamente marca o item colado como pendente para ser salvo em massa
        markAsModified(form);
        allocMsg.innerHTML = '<span class="text-blue-600">Colado! Não esqueça de Salvar.</span>';
      };
    });
  </script>

  <%- include("partials/footer") %>