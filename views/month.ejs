        amountInput.setAttribute('inputmode', 'decimal');
        bindDynamicMoneyMask(amountInput);
        amountGrid.appendChild(buildPurchaseFormField('Valor total (R$)', amountInput));

        const firstDueInput = document.createElement('input');
        firstDueInput.type = 'month';
        firstDueInput.name = 'first_due';
        firstDueInput.required = true;
        firstDueInput.value = `${String(item.year || currentYear).padStart(4, '0')}-${String(item.month || currentMonth).padStart(2, '0')}`;
        firstDueInput.className = buildInputBase();
        amountGrid.appendChild(buildPurchaseFormField(item.recurring_rule_id ? 'Próxima fatura desta recorrência' : 'Vai cair em qual fatura?', firstDueInput));
        form.appendChild(amountGrid);

        const descriptionInput = document.createElement('input');
        descriptionInput.type = 'text';
        descriptionInput.name = 'description';
        descriptionInput.required = true;
        descriptionInput.value = item.description || '';
        descriptionInput.className = buildInputBase();
        form.appendChild(buildPurchaseFormField('Descrição', descriptionInput));

        const categoryBlock = document.createElement('div');
        categoryBlock.setAttribute('data-purchase-category-control', '1');
