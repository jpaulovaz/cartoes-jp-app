        input.setAttribute('inputmode', 'numeric');
      }

      function normalizeShareForAmount(cents, totalCents) {
        const absoluteCents = Math.abs(Number(cents || 0));
        return Number(totalCents || 0) < 0 ? -absoluteCents : absoluteCents;
      }

      function getMoneyInputDisplayCents(cents) {
        return Math.abs(Number(cents || 0));
      }


