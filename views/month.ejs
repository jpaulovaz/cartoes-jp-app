                </td>

                <td class="block md:table-cell px-0 md:px-4 py-3 md:py-3 mt-3 md:mt-0 border-t border-dashed border-slate-200 dark:border-slate-700 md:border-t-0">
                  <div class="md:hidden">
                    <div class="mb-2 text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Distribuição Rápida</div>
                    <form method="post" action="/txn/<%= t.id %>/alloc" data-alloc-form="<%= t.id %>" data-form-variant="mobile" data-installment-scope-form="alloc" data-has-future-installments="<%= t.has_future_installments ? '1' : '0' %>" data-installment-label="<%= t.description %>"
                      class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-2.5 shadow-inner transition-colors duration-300">

                      <div
                        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-3 gap-y-2 mb-3 min-w-0 md:min-w-[380px] border border-slate-100 dark:border-slate-700 rounded-xl p-2 bg-slate-50/40 dark:bg-slate-900/40">
                        <% people.forEach(p=> { %>
                          <label class="flex items-center gap-2 cursor-pointer select-none group py-0.5 min-w-0">
                            <input type="checkbox" name="person_ids" value="<%= p.id %>" <%=(t.selected_ids &&
                              t.selected_ids.includes(p.id)) ? "checked" : "" %> <%= isClosed ? "disabled" : "" %>
                            class="w-4 h-4 text-blue-600 rounded border-slate-300 dark:border-slate-600 focus:ring-blue-500 bg-white dark:bg-slate-800 shrink-0" />

                            <span class="text-xs font-bold text-slate-700 dark:text-slate-200 group-hover:text-blue-600 truncate">
                              <%= p.name.split(' ')[0] %>
                          </span>
                        </label>
                      <% }) %>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 flex-wrap">
                      <% if (isClosed) { %>
                        <div class="w-full rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                          Mês fechado: distribuição e exclusão bloqueadas.
                        </div>
                      <% } else { %>
                        <button type="submit"
                          class="w-full sm:w-auto px-4 py-2 text-xs font-bold rounded-lg bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition-transform active:scale-95 btn-salvar-indiv">Salvar</button>

                        <button type="button" onclick="copyAlloc('<%= t.id %>')"
                                  class="w-full sm:w-auto px-3 py-2 text-xs font-bold rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                                  title="Copiar atribuição">Copiar</button>

                        <button type="button" onclick="pasteAlloc('<%= t.id %>')"
                            class="w-full sm:w-auto px-3 py-2 text-xs font-bold rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                            title="Colar atribuição">Colar</button>

                        <button type="submit" form="delete-txn-<%= t.id %>"
                            class="w-full sm:w-auto sm:ml-auto px-3 py-2 text-xs font-bold rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition-colors">
                            Excluir
                        </button>
                      <% } %>
                    </div>
                    </form>
                    <% if (!isClosed) { %>
                      <form id="delete-txn-<%= t.id %>" method="post" action="/txn/<%= t.id %>/delete"
                        data-confirm-prompt="Excluir este lançamento? Esta ação remove o item e a distribuição associada."
                        data-confirm-phrase="Eu confirmo"
                        data-installment-scope-form="delete"
                        data-has-future-installments="<%= t.has_future_installments ? '1' : '0' %>"
                        data-installment-label="<%= t.description %>"></form>
                    <% } %>
                  </div>

                  <div class="hidden md:block">
                    <% if (isClosed) { %>
                      <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200 text-left">
                        Mês fechado: distribuição e exclusão bloqueadas.
                      </div>
                    <% } else { %>
                      <form id="alloc-desktop-<%= t.id %>" method="post" action="/txn/<%= t.id %>/alloc" data-alloc-form="<%= t.id %>" data-form-variant="desktop" data-installment-scope-form="alloc" data-has-future-installments="<%= t.has_future_installments ? '1' : '0' %>" data-installment-label="<%= t.description %>"
                        class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-2.5 shadow-inner transition-colors duration-300">
                        <div class="flex flex-col gap-2">
                          <button type="submit"
                            class="w-full px-4 py-2 text-xs font-bold rounded-lg bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition-transform active:scale-95 btn-salvar-indiv">Salvar</button>

                          <div class="grid grid-cols-2 gap-2">
                            <button type="button" onclick="copyAlloc('<%= t.id %>')"
                                    class="w-full px-3 py-2 text-xs font-bold rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                                    title="Copiar atribuição">Copiar</button>

                            <button type="button" onclick="pasteAlloc('<%= t.id %>')"
                                class="w-full px-3 py-2 text-xs font-bold rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
                                title="Colar atribuição">Colar</button>
                          </div>

                          <button type="submit" form="delete-txn-desktop-<%= t.id %>"
                              class="w-full px-3 py-2 text-xs font-bold rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition-colors">
                              Excluir
                          </button>
                        </div>
                      </form>
                      <form id="delete-txn-desktop-<%= t.id %>" method="post" action="/txn/<%= t.id %>/delete"
                        data-confirm-prompt="Excluir este lançamento? Esta ação remove o item e a distribuição associada."
                        data-confirm-phrase="Eu confirmo"
                        data-installment-scope-form="delete"
                        data-has-future-installments="<%= t.has_future_installments ? '1' : '0' %>"
                        data-installment-label="<%= t.description %>"></form>
                    <% } %>
                  </div>
                </td>
              </tr>
              <tr class="hidden md:table-row bg-transparent">
                <td colspan="7" class="px-4 pb-4 pt-0">
                  <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 px-4 py-3">
                    <div class="flex items-center justify-between gap-3 mb-3">
                      <span class="text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Participantes</span>
                      <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500">Marque quem participa deste lançamento</span>
                    </div>
                    <div class="flex flex-wrap gap-2.5">
                      <% people.forEach(p=> { %>
                        <label class="inline-flex items-center gap-2 cursor-pointer select-none rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 min-w-[120px] max-w-full hover:border-blue-300 dark:hover:border-blue-500 transition-colors">
                          <input type="checkbox" name="person_ids" form="alloc-desktop-<%= t.id %>" value="<%= p.id %>" <%=(t.selected_ids &&
                            t.selected_ids.includes(p.id)) ? "checked" : "" %> <%= isClosed ? "disabled" : "" %>
                          class="w-4 h-4 text-blue-600 rounded border-slate-300 dark:border-slate-600 focus:ring-blue-500 bg-white dark:bg-slate-800 shrink-0" />
                          <span class="text-xs font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap">
                            <%= p.name.split(' ')[0] %>
                          </span>
                        </label>
                      <% }) %>
                    </div>
                  </div>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (txns.length===0) { %>
      <div class="mt-6 op-empty-state op-empty-state--compact">
        <div class="op-empty-state__icon">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <div class="op-empty-state__title">Nenhum resultado</div>
        <p class="op-empty-state__text">Nenhum item encontrado com os filtros de busca atuais. Ajuste os critérios ou limpe a busca para voltar à lista completa.</p>
      </div>
      <% } %>

  </div>

  <% if (!isClosed) { %>
  <div id="globalSaveBar"
    class="fixed bottom-4 left-4 right-4 md:right-auto md:bottom-6 md:left-1/2 md:-translate-x-1/2 bg-slate-900 text-white px-4 sm:px-6 py-4 rounded-2xl shadow-2xl z-50 items-stretch sm:items-center gap-4 sm:gap-5 transition-transform duration-300 translate-y-32 flex flex-col sm:flex-row opacity-0 pointer-events-none">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold shadow-inner"
        id="modCount">0</div>
      <span class="font-medium text-sm">itens alterados e não salvos</span>
    </div>
    <button id="btnGlobalSave" onclick="saveAllModified()"
      class="w-full sm:w-auto justify-center px-6 py-2.5 bg-blue-600 hover:bg-blue-500 rounded-xl font-bold text-sm shadow-sm transition-colors flex items-center">
      Salvar Tudo Agora
    </button>
  </div>
  <% } %>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const modifiedForms = new Set();
      const globalSaveBar = document.getElementById('globalSaveBar');
      const modCount = document.getElementById('modCount');
      const allocMsg = document.getElementById('allocMsg');
      const btnGlobalSave = document.getElementById('btnGlobalSave');

      function getPersonCheckboxes(form) {
        const inner = Array.from(form.querySelectorAll('input[name="person_ids"]'));
        if (!form.id) return inner;
        const linked = Array.from(document.querySelectorAll(`input[name="person_ids"][form="${form.id}"]`));
        return Array.from(new Set([...inner, ...linked]));
      }

      function syncSiblingForms(form) {
        const txnId = String(form?.dataset?.allocForm || '').trim();
        if (!txnId) return;

        const selectedIds = new Set(
          getPersonCheckboxes(form)
            .filter(cb => cb.checked)
            .map(cb => String(cb.value))
        );

        document.querySelectorAll(`form[data-alloc-form="${txnId}"]`).forEach(otherForm => {
          if (otherForm === form) return;
          getPersonCheckboxes(otherForm).forEach(cb => {
            cb.checked = selectedIds.has(String(cb.value));
          });
        });
      }

      function getVisibleAllocForm(txnId) {
        const forms = Array.from(document.querySelectorAll(`form[data-alloc-form="${txnId.trim()}"]`));
        return forms.find(form => form.offsetParent !== null) || forms[0] || null;
      }

      document.querySelectorAll('form[data-alloc-form]').forEach(form => {
        const handleChange = () => {
          syncSiblingForms(form);
          markAsModified(form);
        };

        form.addEventListener('change', handleChange);
        getPersonCheckboxes(form).forEach(input => {
          input.addEventListener('change', handleChange);
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          await saveForm(form);
        });
      });

      function markAsModified(form) {
        modifiedForms.add(form);
        form.classList.add('bg-amber-50', 'border-amber-300');
        updateGlobalBar();
      }

      function updateGlobalBar() {
        if (modifiedForms.size > 0) {
          globalSaveBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
          modCount.innerText = modifiedForms.size;
        } else {
          globalSaveBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
        }
      }

      function formHasFutureInstallments(form) {
        return String(form?.dataset?.hasFutureInstallments || '') === '1';
      }

      async function resolveBatchInstallmentStrategy(forms) {
        const formsWithFutureInstallments = forms.filter(formHasFutureInstallments);
        if (!formsWithFutureInstallments.length || forms.length <= 1) {
          return 'ask';
        }

        const result = await window.showActionDialog({
          title: 'Salvar vários lançamentos',
          message: `Você alterou ${forms.length} lançamento(s). ${formsWithFutureInstallments.length} deles fazem parte de compras parceladas.\n\nEscolha como deseja aplicar a distribuição nas parcelas futuras.`,
          options: [
            { label: 'Cancelar', value: null, tone: 'secondary' },
            { label: 'Perguntar item a item', value: 'ask', tone: 'secondary' },
            { label: 'Aplicar só a atual para todos os parcelados', value: 'single', tone: 'primary' },
            { label: 'Aplicar atual + próximas para todos os parcelados', value: 'future', tone: 'primary' }
          ]
        });

        return result;
      }

      window.saveForm = async function (form, options = {}) {
        const btn = form.querySelector('.btn-salvar-indiv');
        const originalText = btn ? btn.innerHTML : 'Salvar';
        if (btn) {
          btn.innerHTML = '...';
          btn.disabled = true;
        }

        const hasFutureInstallments = formHasFutureInstallments(form);
        const requestedStrategy = String(options.scopeStrategy || 'ask').trim().toLowerCase();
        let chosenScope = 'single';

        if (hasFutureInstallments) {
          if (requestedStrategy === 'single' || requestedStrategy === 'future') {
            chosenScope = requestedStrategy;
          } else {
            chosenScope = window.resolveInstallmentScope
              ? await window.resolveInstallmentScope(form, { actionLabel: "alterar a distribuição" })
              : 'single';
          }
        }

        if (!chosenScope) {
          if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
          return false;
        }

        const formData = new URLSearchParams(new FormData(form));
        formData.set('apply_scope', chosenScope);

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
          });

          if (!response.ok) {
            throw new Error(await response.text() || 'Erro ao salvar.');
          }

          modifiedForms.delete(form);
          form.classList.remove('bg-amber-50', 'border-amber-300');

          const statusTd = form.closest('tr').querySelector('.status-icon');
          if (statusTd) {
            const isAllocated = getPersonCheckboxes(form).filter(cb => cb.checked).length > 0;
            if (isAllocated) {
              statusTd.innerHTML = `<div class="flex items-center justify-between md:justify-center gap-3"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Status</span><div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center md:mx-auto" title="Distribuído"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div></div>`;
            } else {
              statusTd.innerHTML = `<div class="flex items-center justify-between md:justify-center gap-3"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Status</span><div class="w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center md:mx-auto" title="Não Distribuído"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div></div>`;
            }
          }

          allocMsg.innerHTML = '<span class="text-emerald-600">Item salvo!</span>';
          setTimeout(() => allocMsg.innerHTML = '', 3000);
          updateGlobalBar();
          return true;
        } catch (err) {
          allocMsg.innerHTML = `<span class="text-red-600">${err.message || 'Erro ao salvar.'}</span>`;
          return false;
        } finally {
          if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
        }
      };

      window.saveAllModified = async function () {
        const formsToSave = Array.from(modifiedForms);
        if (!formsToSave.length) return;

        const originalText = btnGlobalSave.innerHTML;
        btnGlobalSave.innerHTML = 'Processando...';
        btnGlobalSave.disabled = true;

        try {
          const scopeStrategy = await resolveBatchInstallmentStrategy(formsToSave);
          if (!scopeStrategy) {
            return;
          }

          let successCount = 0;
          let failureCount = 0;

          for (const form of formsToSave) {
            const ok = await saveForm(form, { scopeStrategy });
            if (ok) successCount += 1;
            else failureCount += 1;
          }

          if (failureCount === 0) {
            allocMsg.innerHTML = '<span class="text-emerald-600 font-extrabold text-base">Todas as alterações foram salvas com sucesso!</span>';
          } else if (successCount > 0) {
            allocMsg.innerHTML = `<span class="text-amber-600 font-extrabold text-base">${successCount} item(ns) salvo(s) e ${failureCount} com pendência.</span>`;
          }
          setTimeout(() => allocMsg.innerHTML = '', 4000);
        } finally {
          btnGlobalSave.innerHTML = originalText;
          btnGlobalSave.disabled = false;
        }
      };

      window.copyAlloc = function (txnId) {
        const form = getVisibleAllocForm(txnId);
        if (!form) return;

        const cbs = getPersonCheckboxes(form).filter(cb => cb.checked);
        const values = Array.from(cbs).map(cb => cb.value);

        localStorage.setItem("allocClipboard", JSON.stringify(values));

        allocMsg.innerHTML = '<span class="text-blue-600 font-bold">Atribuição copiada!</span>';
        setTimeout(() => allocMsg.innerHTML = '', 3000);
      };

      window.pasteAlloc = function (txnId) {
        const raw = localStorage.getItem("allocClipboard");
        if (!raw) {
          allocMsg.innerHTML = '<span class="text-amber-600 font-bold">Nenhuma atribuição copiada. Use o botão Copiar antes.</span>';
          return;
        }

        const ids = JSON.parse(raw);
        const form = getVisibleAllocForm(txnId);
        if (!form) return;

        const cbs = getPersonCheckboxes(form);
        cbs.forEach(cb => {
          cb.checked = ids.includes(cb.value);
        });

        syncSiblingForms(form);
        markAsModified(form);
        allocMsg.innerHTML = '<span class="text-blue-600 font-bold">Colado! Não esqueça de Salvar.</span>';
      };
    });
  </script>

  <%- include("partials/footer") %>