        categorySelect.appendChild(emptyOption);
        sortedPurchaseCategories.forEach((category) => {
          const option = document.createElement('option');
          option.value = String(category.id);
          option.textContent = category.name;
          if (Number(category.id) === Number(item.purchase_category_id || 0)) option.selected = true;
          categorySelect.appendChild(option);
        });
        const newOption = document.createElement('option');
        newOption.value = '__new__';
        newOption.textContent = 'Criar categoria nova';
        categorySelect.appendChild(newOption);
        categoryBlock.appendChild(buildPurchaseFormField('Categoria', categorySelect));

        const customShell = document.createElement('div');
        customShell.hidden = true;
        customShell.setAttribute('data-purchase-category-custom-shell', '1');
        const customInput = document.createElement('input');
        customInput.type = 'text';
        customInput.name = 'purchase_category_custom';
        customInput.maxLength = 60;
        customInput.disabled = true;
        customInput.placeholder = 'Ex: Feira de sábado';
        customInput.className = buildInputBase();
        customInput.setAttribute('data-purchase-category-custom-input', '1');
