<%- include("partials/header", { title: "OrganizaPay | Notificações" }) %>

<%
  function formatTimeBR(dateStr) {
    if (!dateStr) return '--:--';
    try {
      return new Date(dateStr).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    } catch (err) {
      return '--:--';
    }
  }

  function typeLabel(item) {
    if (item?.related_type === 'shared_debt_request' || item?.type === 'shared_debt_request') return 'Dívida compartilhada';
    return 'Notificação';
  }
%>

<div class="max-w-6xl mx-auto space-y-8">
  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Notificações</h1>
      <p class="mt-2 text-sm md:text-base font-medium text-slate-500 dark:text-slate-400">
        Acompanhe atualizações importantes do OrganizaPay e vá direto para o item relacionado.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Não lidas</div>
        <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white"><%= unreadCount %></div>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Lidas</div>
        <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white"><%= readCount %></div>
      </div>

      <% if ((notifications || []).length > 0) { %>
        <form method="POST" action="/notifications/read-all">
          <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 dark:bg-slate-100 px-4 py-3 text-sm font-bold text-white dark:text-slate-900 shadow-sm hover:opacity-90 transition-opacity">
            Marcar todas como lidas
          </button>
        </form>
      <% } %>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/70">
      <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Central de notificações</h2>
      <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Tudo o que ainda exige sua atenção ou merece consulta rápida.</p>
    </div>

    <% if (!(notifications || []).length) { %>
      <div class="px-6 py-12 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-900 dark:text-slate-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path>
          </svg>
        </div>
        <div class="text-base font-bold text-slate-800 dark:text-slate-100">Nenhuma notificação por enquanto.</div>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Quando houver atualizações sobre cobranças compartilhadas ou outros eventos do sistema, elas aparecerão aqui.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-slate-100 dark:divide-slate-700">
        <% notifications.forEach(item => { const unread = Number(item.is_read || 0) === 0; %>
          <article class="px-6 py-5 <%= unread ? 'bg-blue-50/60 dark:bg-blue-900/10' : '' %>">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-bold <%= unread ? 'border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-300' : 'border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300' %>">
                    <%= unread ? 'Não lida' : 'Lida' %>
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500"><%= typeLabel(item) %></span>
                </div>

                <h3 class="mt-3 text-base font-extrabold text-slate-900 dark:text-white"><%= item.title %></h3>
                <p class="mt-2 text-sm font-medium text-slate-600 dark:text-slate-300"><%= item.body || 'Sem descrição complementar.' %></p>

                <div class="mt-3 flex flex-wrap items-center gap-3 text-xs font-medium text-slate-400 dark:text-slate-500">
                  <span>Criada em <%= formatDateBR(item.created_at) %> às <%= formatTimeBR(item.created_at) %></span>
                  <% if (Number(item.is_read || 0) !== 0 && item.read_at) { %>
                    <span>Lida em <%= formatDateBR(item.read_at) %> às <%= formatTimeBR(item.read_at) %></span>
                  <% } %>
                </div>
              </div>

              <div class="flex flex-col-reverse gap-2 sm:flex-row lg:flex-col lg:items-stretch lg:min-w-[220px]">
                <% if (Number(item.is_read || 0) === 0) { %>
                  <form method="POST" action="/notifications/<%= item.id %>/read">
                    <button type="submit" class="w-full inline-flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                      Marcar como lida
                    </button>
                  </form>
                <% } %>

                <% if (item.href) { %>
                  <a href="/notifications/<%= item.id %>/open" class="w-full inline-flex items-center justify-center rounded-2xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition-colors">
                    Ver detalhes
                  </a>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<%- include("partials/footer") %>
