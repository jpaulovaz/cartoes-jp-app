<%- include("partials/header", { title: "OrganizaPay | Notificações" }) %>

<div class="max-w-5xl mx-auto space-y-6">
  <section class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Notificações</h1>
      <p class="mt-2 text-sm md:text-base font-medium text-slate-500 dark:text-slate-400">Acompanhe atualizações do sistema e das dívidas compartilhadas.</p>
    </div>
    <% const unreadCount = notifications.filter(item => Number(item.is_read) !== 1).length; %>
    <div class="flex items-center gap-3">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 shadow-sm">
        <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Não lidas</div>
        <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white"><%= unreadCount %></div>
      </div>
      <% if (unreadCount > 0) { %>
        <form method="post" action="/notifications/mark-all-read">
          <input type="hidden" name="return_to" value="/notifications">
          <button type="submit" class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600">
            Marcar todas como lidas
          </button>
        </form>
      <% } %>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
    <% if (!notifications.length) { %>
      <div class="px-6 py-14 text-center">
        <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-900 dark:text-slate-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
          </svg>
        </div>
        <p class="font-semibold text-slate-700 dark:text-slate-200">Nenhuma notificação por aqui.</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Quando algo novo acontecer, você verá nesta central.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-slate-100 dark:divide-slate-700">
        <% notifications.forEach(item => { const isUnread = Number(item.is_read) !== 1; %>
          <article class="px-6 py-5 <%= isUnread ? 'bg-blue-50/60 dark:bg-blue-900/10' : '' %>">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-base font-bold text-slate-900 dark:text-white"><%= item.title || 'Notificação' %></h2>
                  <% if (isUnread) { %>
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-[11px] font-bold text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">Não lida</span>
                  <% } else { %>
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600 dark:bg-slate-700 dark:text-slate-300">Lida</span>
                  <% } %>
                </div>
                <p class="mt-2 text-sm font-medium text-slate-600 dark:text-slate-300"><%= item.body || 'Sem detalhes adicionais.' %></p>
                <div class="mt-3 text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">
                  <%= formatDateBR(item.created_at) %> • <%= new Date(item.created_at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2 md:justify-end">
                <% if (item.href) { %>
                  <a href="/notifications/<%= item.id %>/go" class="inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600">
                    Ver detalhes
                  </a>
                <% } %>
                <% if (isUnread) { %>
                  <form method="post" action="/notifications/<%= item.id %>/read">
                    <input type="hidden" name="return_to" value="/notifications">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 shadow-sm transition hover:bg-slate-50 dark:hover:bg-slate-700">
                      Marcar como lida
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<%- include("partials/footer") %>
