<%
  const usersList = Array.isArray(users) ? users : [];
  const adminUsersCount = usersList.filter((item) => String(item.role || '') === 'admin').length;
  const importReleasedCount = usersList.filter((item) => Number(item.can_import ?? 1) !== 0).length;
  const neverAccessedCount = usersList.filter((item) => !item.last_login).length;
  const welcomePendingCount = usersList.filter((item) => (item.welcomeEmailStatus?.tone || 'muted') !== 'success').length;
%>
<section id="admin-section-access"
         data-admin-search-target
         data-admin-search="acessos usuarios convite email boas-vindas admin importacao login tabela"
         class="op-surface-card bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden scroll-mt-32">
  <div class="px-6 py-6 sm:px-8 border-b border-slate-200/80 dark:border-slate-700/80 space-y-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Acessos</span>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Usuários e permissões</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Tabela centralizada para revisar permissões, status do convite e atividade recente sem fragmentar a leitura em vários cards.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <button type="button" onclick="openAddUserModal()"
          class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Novo acesso
        </button>
        <button type="button" data-copy-login-url data-login-url="<%= emailState && emailState.loginUrl ? emailState.loginUrl : '/login' %>"
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">
          Copiar link de entrada
        </button>
      </div>
    </div>

    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 px-4 py-4">
        <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Total de acessos</div>
        <div class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= usersList.length %></div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= adminUsersCount %> administrador(es) e <%= Math.max(usersList.length - adminUsersCount, 0) %> usuário(s).</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 px-4 py-4">
        <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Importação liberada</div>
        <div class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= importReleasedCount %></div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= Math.max(usersList.length - importReleasedCount, 0) %> acesso(s) sem permissão de importação.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 px-4 py-4">
        <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Convites pendentes</div>
        <div class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= welcomePendingCount %></div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Usuários sem confirmação de boas-vindas.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 px-4 py-4">
        <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Sem acesso registrado</div>
        <div class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= neverAccessedCount %></div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Útil para acompanhar quem recebeu acesso, mas ainda não entrou.</p>
      </div>
    </div>

    <div class="grid gap-3 xl:grid-cols-[minmax(0,1.5fr),220px,180px,180px] xl:items-end">
      <label class="block xl:col-span-1">
        <span class="block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Buscar usuário</span>
        <div class="relative mt-2">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 dark:text-slate-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.6-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input type="search" data-access-search-input placeholder="Nome, e-mail, papel ou status"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 py-3 pl-10 pr-4 text-sm text-slate-800 dark:text-slate-100 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-300 dark:focus:border-slate-500 dark:focus:ring-slate-700">
        </div>
      </label>

      <label class="block">
        <span class="block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Filtro</span>
        <select data-access-role-filter
                class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-300 dark:focus:border-slate-500 dark:focus:ring-slate-700">
          <option value="all">Todos</option>
          <option value="admin">Administradores</option>
          <option value="user">Usuários</option>
          <option value="pending">Convite pendente</option>
          <option value="never">Sem acesso</option>
        </select>
      </label>

      <label class="block">
        <span class="block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Ordenar por</span>
        <select data-access-sort
                class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-300 dark:focus:border-slate-500 dark:focus:ring-slate-700">
          <option value="name-asc">Nome (A-Z)</option>
          <option value="created-desc">Cadastro mais recente</option>
          <option value="created-asc">Cadastro mais antigo</option>
          <option value="last-login-desc">Acesso mais recente</option>
          <option value="role-desc">Papel</option>
        </select>
      </label>

      <label class="block">
        <span class="block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Linhas por página</span>
        <select data-access-page-size
                class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-300 dark:focus:border-slate-500 dark:focus:ring-slate-700">
          <option value="10">10</option>
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </label>
    </div>

    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between text-sm text-slate-600 dark:text-slate-300">
      <p>Layout de tabela para leitura rápida de grandes volumes, com filtros, ordenação e paginação local.</p>
      <span data-access-results class="inline-flex items-center rounded-full border border-slate-200 dark:border-slate-700 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-300"><%= usersList.length %> resultado(s)</span>
    </div>
  </div>

  <div class="p-6 sm:p-8 space-y-4">
    <% if (usersList.length > 0) { %>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full min-w-[1180px] text-sm">
          <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 dark:text-slate-400 uppercase text-[11px] tracking-[0.14em]">
            <tr>
              <th class="px-4 py-3 text-left font-bold">Usuário</th>
              <th class="px-4 py-3 text-left font-bold">Papel</th>
              <th class="px-4 py-3 text-left font-bold">Importação</th>
              <th class="px-4 py-3 text-left font-bold">Boas-vindas</th>
              <th class="px-4 py-3 text-left font-bold">Último acesso</th>
              <th class="px-4 py-3 text-left font-bold">Cadastro</th>
              <th class="px-4 py-3 text-left font-bold">Ações</th>
            </tr>
          </thead>
          <tbody data-access-table-body class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-800">
            <% usersList.forEach((u) => {
                 const isSelf = user && u.id === user.id;
                 const welcomeTone = toneBadgeClasses[u.welcomeEmailStatus?.tone || 'muted'] || toneBadgeClasses.muted;
                 const roleLabel = u.role === 'admin' ? 'Administrador' : 'Usuário';
                 const importLabel = Number(u.can_import ?? 1) !== 0 ? 'Liberada' : 'Bloqueada';
                 const welcomeLabel = u.welcomeEmailStatus?.label || 'Nunca enviado';
                 const welcomeDetail = u.welcomeEmailStatus?.detail || 'Sem envio registrado.';
                 const createdAtDate = u.created_at ? new Date(u.created_at) : null;
                 const lastLoginDate = u.last_login ? new Date(u.last_login) : null;
                 const createdAtLabel = createdAtDate ? createdAtDate.toLocaleDateString('pt-BR') : '-';
                 const lastLoginLabel = lastLoginDate ? lastLoginDate.toLocaleDateString('pt-BR') : 'Sem acesso';
                 const searchCorpus = [u.name, u.email, roleLabel, importLabel, welcomeLabel, welcomeDetail].filter(Boolean).join(' ');
            %>
              <tr data-access-row
                  data-access-search="<%= searchCorpus %>"
                  data-access-role="<%= u.role === 'admin' ? 'admin' : 'user' %>"
                  data-access-welcome="<%= (u.welcomeEmailStatus?.tone || 'muted') === 'success' ? 'sent' : 'pending' %>"
                  data-access-never="<%= u.last_login ? '0' : '1' %>"
                  data-access-name="<%= String(u.name || '').toLowerCase() %>"
                  data-access-created-at="<%= createdAtDate ? createdAtDate.getTime() : 0 %>"
                  data-access-last-login="<%= lastLoginDate ? lastLoginDate.getTime() : 0 %>"
                  data-access-role-rank="<%= u.role === 'admin' ? 1 : 0 %>"
                  class="align-top hover:bg-slate-50/80 dark:hover:bg-slate-900/30 transition-colors">
                <td class="px-4 py-4">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <div class="font-semibold text-slate-900 dark:text-white"><%= u.name || '-' %></div>
                      <% if (isSelf) { %>
                        <span class="inline-flex items-center rounded-full border border-slate-300 dark:border-slate-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600 dark:text-slate-300">Você</span>
                      <% } %>
                    </div>
                    <div class="mt-1 break-all text-sm text-slate-600 dark:text-slate-300"><%= u.email %></div>
                    <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">ID <%= u.id %></div>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] <%= u.role === 'admin' ? 'border-slate-300 bg-slate-100 text-slate-700 dark:border-slate-600 dark:bg-slate-900/60 dark:text-slate-200' : 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/30 dark:text-slate-300' %>"><%= roleLabel %></span>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] <%= Number(u.can_import ?? 1) !== 0 ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-200' : 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200' %>"><%= importLabel %></span>
                </td>
                <td class="px-4 py-4">
                  <div class="space-y-2">
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] <%= welcomeTone %>"><%= welcomeLabel %></span>
                    <div class="text-xs leading-relaxed text-slate-500 dark:text-slate-400 max-w-[220px]"><%= welcomeDetail %></div>
                  </div>
                </td>
                <td class="px-4 py-4 text-slate-700 dark:text-slate-200 whitespace-nowrap"><%= lastLoginLabel %></td>
                <td class="px-4 py-4 text-slate-700 dark:text-slate-200 whitespace-nowrap"><%= createdAtLabel %></td>
                <td class="px-4 py-4">
                  <div class="flex flex-wrap gap-2">
                    <button type="button"
                      onclick="openEditUserModal(this)"
                      data-user-id="<%= u.id %>"
                      data-user-email="<%= u.email %>"
                      data-user-name="<%= u.name || '' %>"
                      data-user-role="<%= u.role || 'user' %>"
                      data-user-can-import="<%= Number(u.can_import ?? 1) !== 0 ? '1' : '0' %>"
                      class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200 dark:hover:bg-slate-900/70">
                      Editar
                    </button>

                    <button type="button"
                      data-copy-login-url
                      data-login-url="<%= emailState && emailState.loginUrl ? emailState.loginUrl : '/login' %>"
                      class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200 dark:hover:bg-slate-900/70">
                      Link
                    </button>

                    <form action="/admin/users/<%= u.id %>/resend-welcome" method="POST">
                      <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-900/50 dark:text-slate-200 dark:hover:bg-slate-900/80">
                        Reenviar e-mail
                      </button>
                    </form>

                    <% if (!isSelf) { %>
                      <form action="/admin/remove-user/<%= u.id %>" method="POST" onsubmit="return confirm('Excluir esse acesso da área ativa? O histórico continua salvo, mas a exclusão trava se ainda houver cobrança aberta, Pix do mês em andamento ou rascunho na caixa de saída.')">
                        <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-100 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300 dark:hover:bg-red-950/40">
                          Remover
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
            <tr data-access-empty hidden>
              <td colspan="7" class="px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                Nenhum usuário encontrado com os filtros atuais.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p data-access-page-summary class="text-sm text-slate-600 dark:text-slate-300">Exibindo todos os resultados.</p>
        <div class="flex items-center gap-2">
          <button type="button" data-access-prev class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">Anterior</button>
          <span data-access-page-indicator class="inline-flex min-w-[110px] items-center justify-center rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-slate-500 dark:border-slate-700 dark:text-slate-300">Página 1 de 1</span>
          <button type="button" data-access-next class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-900/40">Próxima</button>
        </div>
      </div>
    <% } else { %>
      <div class="op-empty-state op-empty-state--compact">
        <div class="op-empty-state__icon">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v6m3-3h-6m-6 6H5a2 2 0 01-2-2V8a2 2 0 012-2h4l2-2h2l2 2h4a2 2 0 012 2v4"></path></svg>
        </div>
        <div class="op-empty-state__title">Nenhum usuário encontrado</div>
        <p class="op-empty-state__text">Cadastre o primeiro e-mail autorizado para começar a distribuir acessos ao aplicativo.</p>
      </div>
    <% } %>

    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/40 p-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      O fluxo permanece o mesmo: acesso liberado, login com Google e ações por linha para editar permissões, reenviar o e-mail de boas-vindas ou remover o acesso.
    </div>
  </div>
</section>
