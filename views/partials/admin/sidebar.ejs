<div class="op-surface-card rounded-2xl border border-slate-200 bg-white/95 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/95 space-y-5 xl:flex xl:max-h-[calc(100vh-9rem)] xl:flex-col xl:overflow-hidden">
  <div>
    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Navegação</div>
    <h2 class="mt-2 text-lg font-semibold tracking-tight text-slate-900 dark:text-white">Mapa da administração</h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      Use a busca para localizar seções, campos e ações sem percorrer toda a página.
    </p>
  </div>

  <label class="block">
    <span class="block text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Buscar seção</span>
    <div class="relative mt-2">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 dark:text-slate-500">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.6-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </span>
      <input type="search"
             data-admin-search-input
             placeholder="Buscar seção, campo ou ação"
             class="w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 py-3 pl-10 pr-4 text-sm text-slate-800 dark:text-slate-100 outline-none transition focus:border-slate-400 focus:ring-2 focus:ring-slate-300 dark:focus:border-slate-500 dark:focus:ring-slate-700">
    </div>
  </label>

  <div class="space-y-4 xl:min-h-0 xl:flex-1 xl:overflow-y-auto xl:pr-1">
    <% navGroups.forEach((group) => { %>
      <section data-admin-nav-group class="space-y-2">
        <div class="px-1 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= group.title %></div>
        <nav class="space-y-1.5">
          <% group.items.forEach((item) => {
               const selected = activeSectionKey === item.key || (activeSectionKey === 'access' && item.key === 'access');
               const badgeText = item.badge || '';
          %>
            <a href="#admin-section-<%= item.key %>"
               data-admin-nav-link
               data-admin-nav-key="<%= item.key %>"
               data-admin-nav-target="admin-section-<%= item.key %>"
               data-admin-search="<%= item.searchText || '' %>"
               aria-current="<%= selected ? 'location' : 'false' %>"
               class="flex items-start gap-3 rounded-xl border px-3.5 py-3 transition-all <%= selected ? 'border-slate-900 bg-slate-900 text-white shadow-sm dark:border-slate-100 dark:bg-slate-100 dark:text-slate-900' : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/30 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-900/50' %>">
              <span data-admin-nav-dot class="mt-1 h-2.5 w-2.5 rounded-full <%= selected ? 'bg-white/80 dark:bg-slate-900' : 'bg-slate-300 dark:bg-slate-600' %>"></span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-3">
                  <span class="block text-sm font-semibold tracking-tight"><%= item.title %></span>
                  <% if (badgeText) { %>
                    <span class="inline-flex items-center rounded-full border border-current/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.12em] opacity-85"><%= badgeText %></span>
                  <% } %>
                </span>
                <span class="mt-1 block text-xs leading-relaxed text-current/80"><%= item.description %></span>
              </span>
            </a>
          <% }) %>
        </nav>
      </section>
    <% }) %>
  </div>

  <details class="rounded-xl border border-slate-200 bg-slate-50/90 px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900/40">
    <summary class="cursor-pointer list-none font-semibold text-slate-800 dark:text-slate-100 flex items-center justify-between gap-3">
      Como usar o painel
      <span class="text-xs font-bold text-slate-400 dark:text-slate-500">abrir</span>
    </summary>
    <div class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      <p>• Use a navegação lateral para alternar entre operação diária e configurações técnicas.</p>
      <p>• Ações operacionais ficam separadas dos formulários para reduzir ruído visual.</p>
      <p>• O guia completo continua disponível como apoio, mas a página foi organizada para leitura direta.</p>
      <a href="<%= adminGuideUrl %>" class="inline-flex items-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-white dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">
        Abrir guia completo
      </a>
    </div>
  </details>
</div>
