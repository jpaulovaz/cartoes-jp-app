<!doctype html>
<html lang="pt-BR" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= typeof title !== 'undefined' ? title : nomeTitular.toUpperCase() %></title>

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#020617">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="AcerttaPay">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          boxShadow: {
            soft: '0 18px 44px rgba(15, 23, 42, 0.08)',
            strong: '0 24px 60px rgba(15, 23, 42, 0.14)'
          }
        }
      }
    };
  </script>

  <script>
    (function () {
      const root = document.documentElement;
      const ua = navigator.userAgent || '';
      const platform = navigator.platform || '';
      const maxTouchPoints = navigator.maxTouchPoints || 0;
      const isIOS = /iPad|iPhone|iPod/.test(ua) || (platform === 'MacIntel' && maxTouchPoints > 1);
      const isStandalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true;

      root.classList.toggle('op-ios', !!isIOS);
      root.classList.toggle('op-standalone', !!isStandalone);
      root.classList.toggle('op-ios-standalone', !!(isIOS && isStandalone));
      root.dataset.opPlatform = isIOS ? 'ios' : 'default';
      root.dataset.opDisplayMode = isStandalone ? 'standalone' : 'browser';
    })();
  </script>

  <script>
    (function () {
      const root = document.documentElement;
      const styleKey = 'op-theme-style';
      const storedStyle = localStorage.getItem(styleKey);
      const validStyles = new Set(['classic', 'confete', 'orgulho']);
      root.dataset.themeStyle = validStyles.has(storedStyle) ? storedStyle : 'classic';

      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const nextTheme = storedTheme === 'dark' || (!storedTheme && prefersDark) ? 'dark' : 'light';
      root.classList.toggle('dark', nextTheme === 'dark');

      const themeColorMeta = document.querySelector('meta[name="theme-color"]');
      if (themeColorMeta) {
        let themeColor;
        if (root.dataset.themeStyle === 'confete') {
          themeColor = nextTheme === 'dark' ? '#1f1633' : '#fff3f7';
        } else if (root.dataset.themeStyle === 'orgulho') {
          themeColor = nextTheme === 'dark' ? '#34173a' : '#f75f70';
        } else {
          themeColor = nextTheme === 'dark' ? '#020617' : '#eaf2ff';
        }
        themeColorMeta.setAttribute('content', themeColor);
      }
    })();

    function toggleDarkMode() {
      const html = document.documentElement;
      const nextTheme = html.classList.contains('dark') ? 'light' : 'dark';
      html.classList.toggle('dark', nextTheme === 'dark');
      localStorage.setItem('theme', nextTheme);
      if (typeof window.OPSyncThemeChrome === 'function') {
        window.OPSyncThemeChrome();
      }
    }
  </script>

  <link rel="stylesheet" href="/app.css" />
  <script defer src="/app.js"></script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(err => console.error('Erro no PWA:', err));
      });
    }
  </script>

  <style>
    .mobile-top-chrome-fix {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: calc(env(safe-area-inset-top, 0px) + 4px);
      background: linear-gradient(180deg, rgba(2,6,23,0.98), rgba(2,6,23,0.6));
      z-index: 60;
      pointer-events: none;
    }

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(241, 245, 249, 0.7);
    }

    html.dark ::-webkit-scrollbar-track {
      background: rgba(30, 41, 59, 0.65);
    }

    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.75);
      border-radius: 999px;
    }

    html.dark ::-webkit-scrollbar-thumb {
      background: rgba(71, 85, 105, 0.9);
    }
  </style>
</head>
<%
  const appPinContext = (typeof appPin !== 'undefined' && appPin) ? appPin : {};
  const appPinScreen = (typeof currentPath !== 'undefined' && currentPath === '/lock') ? 'lock' : 'app';
%>
<body class="op-shell text-slate-800 dark:text-slate-200 antialiased selection:bg-blue-300 selection:text-blue-900 flex min-h-screen flex-col font-sans"
      data-push-public-key="<%= typeof pushPublicKey !== 'undefined' ? pushPublicKey : '' %>"
      data-push-configured="<%= pushNotificationsEnabled ? '1' : '0' %>"
      data-app-pin-enabled="<%= appPinContext.enabled ? '1' : '0' %>"
      data-app-pin-idle-seconds="<%= Number(appPinContext.idleSeconds || 0) %>"
      data-app-pin-lock-url="/lock/engage"
      data-app-pin-touch-url="/lock/touch"
      data-app-pin-screen="<%= appPinScreen %>">
  <div class="mobile-top-chrome-fix" aria-hidden="true"></div>

  <% const dNav = new Date();
     const mNav = dNav.getMonth() + 1;
     const yNav = dNav.getFullYear();
     const defaultDashboardHref = (typeof dashboardHref !== 'undefined' && dashboardHref) ? dashboardHref : `/detalhamento/${yNav}/${mNav}`;
     const isUserAdmin = !!(user && user.role === 'admin');
     const canImportData = Number((user && user.can_import) ?? (typeof canImport !== 'undefined' ? canImport : 1)) !== 0;
     const ownerDisplayNameRaw = ((nomeTitular || '').replace(/^Detalhamento\s+/i, '').trim());
     const ownerDisplayName = ownerDisplayNameRaw && ownerDisplayNameRaw.toLowerCase() !== 'contas' ? ownerDisplayNameRaw : ((user && user.name) ? user.name : 'Você');
     const ownerNameParts = ownerDisplayName.split(/\s+/).filter(Boolean);
     const ownerShortName = ownerNameParts.slice(0, 2).join(' ') || 'Você';
     const unreadNotifications = Number(typeof unreadNotificationCount !== 'undefined' ? unreadNotificationCount : 0) || 0;
     const readNotifications = Number(typeof readNotificationCount !== 'undefined' ? readNotificationCount : 0) || 0;
     const recentNotificationItems = Array.isArray(recentNotifications) ? recentNotifications : [];
     const userPhotoUrl = (typeof userAvatar !== 'undefined' && userAvatar && userAvatar.photo_url) ? String(userAvatar.photo_url) : '';
     const hasUserPhoto = !!userPhotoUrl;
  %>

  <header class="sticky top-0 z-50 px-3 pt-[max(env(safe-area-inset-top,0px),0.25rem)] md:px-4 lg:px-6">
    <div class="op-topbar-shell mx-auto mt-2 max-w-[1640px] rounded-[30px] border border-white/10 px-3 py-3 md:px-5 md:py-4">
      <div class="op-topbar-desktop hidden md:flex items-center gap-4">
        <a href="<%= defaultDashboardHref %>" class="flex min-w-0 items-center gap-4 rounded-[22px] border border-white/8 bg-white/5 px-4 py-3 transition hover:bg-white/10">
          <% if (hasUserPhoto) { %><img src="<%= userPhotoUrl %>" alt="<%= ownerShortName %>" loading="lazy" referrerpolicy="no-referrer" class="h-14 w-14 rounded-full object-cover shadow-[0_14px_32px_rgba(37,99,235,0.32)] ring-2 ring-white/25"><% } else { %><img src="/icon-192.png" alt="AcerttaPay" class="h-14 w-14 rounded-[1.35rem] object-cover shadow-[0_14px_32px_rgba(37,99,235,0.32)]"><% } %>
          <span class="min-w-0">
            <span class="block text-[11px] font-extrabold uppercase tracking-[0.18em] text-sky-200/80">AcerttaPay</span>
            <span class="mt-1 block truncate text-lg font-black tracking-tight text-white"><%= ownerShortName %></span>
            <span class="mt-0.5 block truncate text-sm font-medium text-slate-300">Seu cantinho financeiro</span>
          </span>
        </a>

        <nav class="op-desktop-nav flex min-w-0 flex-1 items-center gap-1 overflow-x-auto px-1">
          <a href="<%= defaultDashboardHref %>" data-nav-key="painel" class="op-nav-link">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h4a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2"></path></svg>
            Painel
          </a>
          <a href="/geral" data-nav-key="geral" class="op-nav-link">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            Geral
          </a>
          <a href="/people" data-nav-key="people" class="op-nav-link">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-1a4 4 0 00-5.356-3.772M17 20H7m10 0v-1c0-.653-.084-1.287-.24-1.892M7 20H2v-1a4 4 0 015.356-3.772M7 20v-1c0-.653.084-1.287.24-1.892m0 0a5.002 5.002 0 019.52 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            Amigos
          </a>
          <a href="/shared-debts" data-nav-key="shared" class="op-nav-link">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m-3-9h6a2 2 0 012 2 2 2 0 01-2 2H9a2 2 0 00-2 2 2 2 0 002 2h6"></path></svg>
            Cobranças
          </a>
          <a href="/cards" data-nav-key="cards" class="op-nav-link">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M5 11h14M6 15h3m3 0h2m-9 4h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            Cartões
          </a>
          <% if (canImportData) { %>
            <a href="/import" data-nav-key="import" class="op-nav-link">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
              Importar
            </a>
          <% } %>
          <% if (isUserAdmin) { %>
            <a href="/admin" data-nav-key="admin" class="op-nav-link">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622C17.176 19.29 21 14.591 21 9c0-1.042-.133-2.052-.382-3.016z"></path></svg>
              Admin
            </a>
          <% } %>
        </nav>

        <div class="flex items-center gap-2">
          <button type="button" class="op-utility-btn op-utility-btn--notify" data-push-center-open data-push-center-open-variant="icon" data-push-visual-state="loading" aria-haspopup="dialog" aria-controls="notification-center" aria-expanded="false" title="Abrir central de alertas" aria-label="Abrir central de alertas">
            <span class="op-utility-btn__icon" data-push-center-icon>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path></svg>
              <% if (unreadNotifications > 0) { %>
                <span class="op-utility-btn__badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
              <% } %>
            </span>
          </button>
          <button type="button" class="op-utility-btn op-utility-btn--style" data-theme-style-open title="Trocar visual" aria-label="Trocar visual do app">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.5 3C7.806 3 4 6.358 4 10.5c0 2.037.923 3.885 2.431 5.246.563.507.867 1.25.867 2.008V19a2 2 0 002 2h1.327a1 1 0 00.916-.599l.863-1.94a1 1 0 01.914-.6H15a5 5 0 100-10c-.551 0-1-.449-1-1V3.126c-.49-.083-.992-.126-1.5-.126z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 5.5l2 2M15 7l3-3"></path></svg>
          </button>
          <button onclick="toggleDarkMode()" class="op-utility-btn" title="Alternar claro e escuro" aria-label="Alternar claro e escuro">
            <svg class="h-5 w-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <svg class="h-5 w-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          </button>
          <% if (user) { %>
            <a href="/logout" class="op-utility-btn" title="Sair" aria-label="Sair do app">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
          <% } %>
        </div>
      </div>

      <div class="op-topbar-mobile md:hidden space-y-3">
        <div class="op-mobile-topbar-row flex items-center gap-3">
          <a href="<%= defaultDashboardHref %>" class="op-mobile-brand-card flex min-w-0 flex-1 items-center gap-3 rounded-[24px] border border-white/10 bg-white/6 px-3 py-3">
            <% if (hasUserPhoto) { %><img src="<%= userPhotoUrl %>" alt="<%= ownerShortName %>" loading="lazy" referrerpolicy="no-referrer" class="h-12 w-12 rounded-full object-cover shadow-[0_10px_24px_rgba(37,99,235,0.3)] ring-2 ring-white/25"><% } else { %><img src="/icon-192.png" alt="AcerttaPay" class="h-12 w-12 rounded-[1.1rem] object-cover shadow-[0_10px_24px_rgba(37,99,235,0.3)]"><% } %>
            <span class="min-w-0">
              <span class="block truncate text-sm font-black text-white"><%= ownerShortName %></span>
              <span class="block truncate text-xs font-medium text-slate-300 sm:hidden">Seu cantinho</span>
              <span class="hidden truncate text-xs font-medium text-slate-300 sm:block">Seu cantinho financeiro</span>
            </span>
          </a>
          <button type="button" class="op-utility-btn op-utility-btn--notify shrink-0" data-push-center-open data-push-center-open-variant="icon" data-push-visual-state="loading" aria-haspopup="dialog" aria-controls="notification-center" aria-expanded="false" title="Abrir central de alertas" aria-label="Abrir central de alertas">
            <span class="op-utility-btn__icon" data-push-center-icon>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path></svg>
              <% if (unreadNotifications > 0) { %>
                <span class="op-utility-btn__badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
              <% } %>
            </span>
          </button>
          <button type="button" class="op-utility-btn shrink-0" data-mobile-appearance-open title="Ajustes visuais" aria-label="Abrir ajustes visuais">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.983 5.5c.345-1.414 2.362-1.414 2.707 0a1.392 1.392 0 001.98.937c1.277-.711 2.705.717 1.994 1.994a1.392 1.392 0 00.937 1.98c1.414.345 1.414 2.362 0 2.707a1.392 1.392 0 00-.937 1.98c.711 1.277-.717 2.705-1.994 1.994a1.392 1.392 0 00-1.98.937c-.345 1.414-2.362 1.414-2.707 0a1.392 1.392 0 00-1.98-.937c-1.277.711-2.705-.717-1.994-1.994a1.392 1.392 0 00-.937-1.98c-1.414-.345-1.414-2.362 0-2.707a1.392 1.392 0 00.937-1.98c-.711-1.277.717-2.705 1.994-1.994.861.479 1.92-.01 1.98-.937z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </button>
          <% if (user) { %>
            <a href="/logout" class="op-utility-btn shrink-0" title="Sair" aria-label="Sair do app">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
          <% } %>
        </div>

      </div>
    </div>
  </header>

  <div id="mobile-appearance-menu" data-mobile-appearance-menu class="fixed inset-0 z-[10036] hidden md:hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-transparent" data-mobile-appearance-backdrop></div>
    <div class="op-mobile-appearance-menu__wrap pointer-events-none absolute inset-x-0 top-0 flex justify-end px-3 pt-[calc(env(safe-area-inset-top,0px)+5.2rem)]">
      <div class="op-mobile-appearance-menu__panel pointer-events-auto w-[min(18rem,calc(100vw-1.5rem))] rounded-[26px] border border-slate-200 bg-white/96 p-3 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/96 dark:ring-slate-700">
        <div class="mb-2 px-1">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Ajustes visuais</div>
          <p class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400">Aqui você troca a roupa do app sem mexer na vida financeira.</p>
        </div>
        <div class="space-y-2">
          <button type="button" class="op-mobile-appearance-menu__button" data-theme-style-open data-mobile-appearance-action>
            <span class="op-mobile-appearance-menu__icon" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.5 3C7.806 3 4 6.358 4 10.5c0 2.037.923 3.885 2.431 5.246.563.507.867 1.25.867 2.008V19a2 2 0 002 2h1.327a1 1 0 00.916-.599l.863-1.94a1 1 0 01.914-.6H15a5 5 0 100-10c-.551 0-1-.449-1-1V3.126c-.49-.083-.992-.126-1.5-.126z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 5.5l2 2M15 7l3-3"></path></svg>
            </span>
            <span class="min-w-0 flex-1 text-left">
              <span class="block text-sm font-black text-slate-900 dark:text-white">Trocar visual</span>
              <span class="mt-0.5 block text-xs font-semibold text-slate-500 dark:text-slate-400" data-mobile-theme-style-caption>Clássico, Confete ou Orgulho</span>
            </span>
            <svg class="h-4 w-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
          <button type="button" class="op-mobile-appearance-menu__button" onclick="toggleDarkMode()" data-mobile-appearance-action data-mobile-appearance-mode-button>
            <span class="op-mobile-appearance-menu__icon" aria-hidden="true">
              <svg class="h-5 w-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
              <svg class="h-5 w-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </span>
            <span class="min-w-0 flex-1 text-left">
              <span class="block text-sm font-black text-slate-900 dark:text-white" data-mobile-appearance-mode-label>Modo escuro</span>
              <span class="mt-0.5 block text-xs font-semibold text-slate-500 dark:text-slate-400" data-mobile-appearance-mode-helper>Deixa a tela mais confortável quando a luz abaixa.</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="notification-center" data-notification-center class="fixed inset-0 z-[10040] hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-notification-center-backdrop></div>
    <div class="relative z-10 flex min-h-full items-end justify-center overflow-y-auto px-3 py-3 sm:items-start sm:px-4 sm:pt-24 sm:pb-6">
      <section class="op-notification-center w-full max-w-xl overflow-hidden rounded-[30px] border border-slate-200 bg-white/95 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/95 dark:ring-slate-700" role="dialog" aria-modal="true" aria-labelledby="notification-center-title">
        <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-800 sm:px-6">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Central de alertas</div>
            <h2 id="notification-center-title" class="mt-1 text-xl font-black text-slate-900 dark:text-white">Seu sininho agora cuida do app todo</h2>
            <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Avisos de vencimento, respostas e confirmações passam por aqui neste aparelho.</p>
          </div>
          <button type="button" class="op-icon-btn shrink-0" data-notification-center-close aria-label="Fechar central de alertas">✕</button>
        </div>

        <div class="op-notification-center__body space-y-5 px-5 py-5 sm:px-6">
          <div class="rounded-[26px] border border-sky-100 bg-sky-50/80 p-4 shadow-sm dark:border-sky-900/60 dark:bg-sky-950/20">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">Alertas neste aparelho</div>
                <p id="notification-center-push-status" class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Ative os alertas para receber um toque do app quando pintar novidade importante.</p>
                <p class="mt-2 text-xs font-semibold text-slate-400 dark:text-slate-500">Esse ajuste vale para este navegador ou celular. Se entrar em outro aparelho, é só ligar por lá também.</p>
              </div>
              <div class="w-full sm:w-[15rem] sm:flex-shrink-0">
                <button type="button" data-push-toggle data-push-public-key="<%= pushPublicKey %>" data-push-status-target="#notification-center-push-status" class="op-btn op-btn-warning-soft op-btn--block">Ativar alertas</button>
              </div>
            </div>
          </div>

          <section class="space-y-3">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white">Seus avisos</h3>
                <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400"><% if (unreadNotifications > 0) { %>Você tem <strong class="text-slate-900 dark:text-white"><%= unreadNotifications %></strong> <%= unreadNotifications === 1 ? 'aviso sem abrir' : 'avisos sem abrir' %>.<% } else if (recentNotificationItems.length) { %>Tudo em dia por aqui. Os avisos mais novos aparecem primeiro.<% } else { %>Tudo em dia por aqui. Quando surgir novidade, ela aparece nesta lista.<% } %></p>
              </div>
              <% if (unreadNotifications > 0 || readNotifications > 0) { %>
                <div class="flex flex-wrap gap-2 sm:justify-end">
                  <% if (unreadNotifications > 0) { %>
                    <form method="POST" action="/notifications/read-all" class="shrink-0">
                      <button type="submit" class="op-btn op-btn-ghost">Marcar tudo como visto</button>
                    </form>
                  <% } %>
                  <% if (readNotifications > 0) { %>
                    <form method="POST" action="/notifications/clear-read" class="shrink-0">
                      <button type="submit" class="op-btn op-btn-ghost" title="Tira da lista só os avisos que você já abriu">Limpar antigas</button>
                    </form>
                  <% } %>
                </div>
              <% } %>
            </div>

            <% if (recentNotificationItems.length) { %>
              <div class="space-y-3">
                <% recentNotificationItems.forEach((notification) => { const notificationUnread = Number(notification.is_read || 0) === 0; %>
                  <a href="/notifications/<%= notification.id %>/open" class="op-notification-item <%= notificationUnread ? 'is-unread' : '' %>">
                    <div class="flex items-start gap-3">
                      <div class="op-notification-item__icon" aria-hidden="true">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.389 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path></svg>
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <div class="text-sm font-black text-slate-900 dark:text-white"><%= notification.title %></div>
                          <% if (notificationUnread) { %><span class="rounded-full bg-rose-500 px-2 py-0.5 text-[10px] font-black uppercase tracking-[0.14em] text-white">Novo</span><% } %>
                        </div>
                        <p class="mt-1 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400"><%= notification.body || 'Tem uma novidade te esperando aqui dentro.' %></p>
                        <div class="mt-2 text-xs font-semibold text-slate-400 dark:text-slate-500"><%= formatDateBR(notification.created_at) %></div>
                      </div>
                      <svg class="mt-1 h-4 w-4 shrink-0 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </div>
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <div class="rounded-[26px] border border-dashed border-slate-200 bg-slate-50/80 px-4 py-6 text-center dark:border-slate-700 dark:bg-slate-800/70">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-200/80 text-slate-500 dark:bg-slate-700 dark:text-slate-300">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.389 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path></svg>
                </div>
                <div class="mt-3 text-sm font-black text-slate-900 dark:text-white">Nenhum aviso por enquanto</div>
                <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Quando o app tiver algo importante para te contar, este cantinho entra em ação.</p>
              </div>
            <% } %>
          </section>
        </div>
      </section>
    </div>
  </div>

  <div id="theme-style-center" data-theme-style-center class="fixed inset-0 z-[10042] hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-theme-style-backdrop></div>
    <div class="relative z-10 flex min-h-full items-end justify-center overflow-y-auto px-3 py-3 sm:items-center sm:px-4 sm:py-6">
      <section class="op-style-center-panel w-full max-w-5xl overflow-x-hidden overflow-y-auto overscroll-contain rounded-[30px] border border-slate-200 bg-white/95 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/95 dark:ring-slate-700" role="dialog" aria-modal="true" aria-labelledby="theme-style-title">
        <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-800 sm:px-6">
          <div>
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-fuchsia-600 dark:text-fuchsia-300">Trocar visual</div>
            <h2 id="theme-style-title" class="mt-1 text-xl font-black text-slate-900 dark:text-white">Clássico, Confete ou Orgulho?</h2>
            <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">A função continua igualzinha. O que muda aqui é só a roupa do app — agora com mais um jeitinho de brilhar.</p>
          </div>
          <button type="button" class="op-icon-btn shrink-0" data-theme-style-close aria-label="Fechar seleção de visual">✕</button>
        </div>
        <div class="space-y-5 px-5 py-5 sm:px-6">
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <button type="button" class="op-style-card" data-theme-style-choice="classic">
              <span class="op-style-card__preview op-style-card__preview--classic" aria-hidden="true">
                <span class="op-style-card__preview-topbar"></span>
                <span class="op-style-card__preview-body"></span>
                <span class="op-style-card__preview-pill"></span>
              </span>
              <span class="op-style-card__content">
                <span class="op-style-card__kicker">Clássico</span>
                <span class="op-style-card__title">Elegante, tech e focado</span>
                <span class="op-style-card__text">Para quem curte um visual mais sóbrio, com cara de cockpit financeiro arrumadinho.</span>
              </span>
              <span class="op-style-card__check" data-theme-style-check>Ativo</span>
            </button>

            <button type="button" class="op-style-card" data-theme-style-choice="confete">
              <span class="op-style-card__preview op-style-card__preview--confete" aria-hidden="true">
                <span class="op-style-card__preview-topbar"></span>
                <span class="op-style-card__preview-body"></span>
                <span class="op-style-card__preview-pill"></span>
              </span>
              <span class="op-style-card__content">
                <span class="op-style-card__kicker">Confete</span>
                <span class="op-style-card__title">Divertido, moderno e quentinho</span>
                <span class="op-style-card__text">Mais cor, mais personalidade e um clima leve sem perder o conforto visual do dia a dia.</span>
              </span>
              <span class="op-style-card__check" data-theme-style-check>Ativo</span>
            </button>

            <button type="button" class="op-style-card" data-theme-style-choice="orgulho">
              <span class="op-style-card__preview op-style-card__preview--orgulho" aria-hidden="true">
                <span class="op-style-card__preview-topbar"></span>
                <span class="op-style-card__preview-body"></span>
                <span class="op-style-card__preview-pill"></span>
              </span>
              <span class="op-style-card__content">
                <span class="op-style-card__kicker">Orgulho</span>
                <span class="op-style-card__title">Vibrante, acolhedor e cheio de presença</span>
                <span class="op-style-card__text">Mais cor, mais brilho e uma energia de celebração que continua confortável de usar do começo ao fim.</span>
              </span>
              <span class="op-style-card__check" data-theme-style-check>Ativo</span>
            </button>
          </div>

          <div class="rounded-[26px] border border-slate-200 bg-slate-50/80 px-4 py-4 text-sm font-medium leading-6 text-slate-600 dark:border-slate-800 dark:bg-slate-800/70 dark:text-slate-300">
            <strong class="font-black text-slate-900 dark:text-white">Dica amiga:</strong> você pode misturar o visual com claro ou escuro do jeito que ficar mais gostoso de usar. O app deixa você brincar sem bagunçar nada.
          </div>
        </div>
      </section>
    </div>
  </div>

  <main class="op-app-main mx-auto w-full max-w-[1640px] flex-grow px-3 py-5 md:px-4 md:py-8 lg:px-6" style="padding-bottom: var(--op-mobile-bottom-clearance); scroll-padding-bottom: var(--op-mobile-bottom-clearance);">
    <% if (flash && flash.message) {
         const flashClasses = flash.type === 'success'
           ? 'border-emerald-200 bg-emerald-50/90 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-900/25 dark:text-emerald-200'
           : flash.type === 'error'
             ? 'border-red-200 bg-red-50/90 text-red-800 dark:border-red-800 dark:bg-red-900/25 dark:text-red-200'
             : 'border-blue-200 bg-blue-50/90 text-blue-800 dark:border-blue-800 dark:bg-blue-900/25 dark:text-blue-200';
    %>
      <div class="mb-5 op-fade-up">
        <div class="rounded-[22px] border px-4 py-3 text-sm font-semibold shadow-soft backdrop-blur-sm <%= flashClasses %>">
          <%= flash.message %>
        </div>
      </div>
    <% } %>
