<section class="rounded-[32px] border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-700 dark:bg-slate-800" data-import-pdf-jobs-panel data-import-pdf-jobs-panel-url="/import/pdf/jobs/panel" data-auto-refresh-running="<%= hasRunningPdfJobs ? '1' : '0' %>">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Processamento em fila</div>
      <h2 class="mt-1 text-base font-black text-slate-900 dark:text-slate-100">Importações recentes</h2>
    </div>
    <% if (hasRunningPdfJobs) { %>
      <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-200">Em atualização</span>
    <% } %>
  </div>

  <div class="mt-4 space-y-3" data-import-pdf-jobs-root>
    <% if (!pdfJobs.length) { %>
      <div class="rounded-[24px] border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">Quando você enviar um PDF, o processamento aparece aqui com os atalhos de cada job.</div>
    <% } %>

    <% pdfJobs.forEach((job) => { %>
      <article class="rounded-[24px] border <%= job.status === 'failed' ? 'border-amber-200 bg-amber-50/80 dark:border-amber-900/60 dark:bg-amber-950/20' : job.status === 'review_warn' ? 'border-violet-200 bg-violet-50/80 dark:border-violet-900/60 dark:bg-violet-950/20' : 'border-slate-200 bg-slate-50/70 dark:border-slate-700 dark:bg-slate-900/50' %> p-4 shadow-sm">
        <div class="flex flex-col gap-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="truncate text-sm font-black text-slate-900 dark:text-slate-100"><%= job.originalFilename %></h3>
              <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400"><%= job.cardName %> · <%= String(job.month).padStart(2, '0') %>/<%= job.year %></p>
            </div>
            <span class="inline-flex shrink-0 items-center rounded-full border px-3 py-1 text-[10px] font-black uppercase tracking-[0.14em] <%= job.status === 'review_ready' ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/20 dark:text-emerald-200' : job.status === 'review_warn' ? 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-900/60 dark:bg-violet-950/20 dark:text-violet-200' : job.status === 'failed' ? 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900/60 dark:bg-amber-950/20 dark:text-amber-200' : 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300' %>"><%= job.statusLabel %></span>
          </div>

          <% if (job.providerUsed || job.rowCount) { %>
            <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
              <% if (job.providerUsed) { %><span><%= job.providerUsed %></span><% } %>
              <% if (job.rowCount) { %><span>· <%= job.rowCount %> linha(s)</span><% } %>
            </div>
          <% } %>

          <% if (job.warningMessage || job.errorMessage) { %>
            <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 text-xs font-medium leading-5 text-slate-600 dark:border-slate-700 dark:bg-slate-950/70 dark:text-slate-300"><%= job.warningMessage || job.errorMessage %></div>
          <% } %>

          <div class="flex flex-wrap gap-2">
            <% if (job.canReview) { %>
              <a href="/import/pdf/jobs/<%= job.id %>/review" class="inline-flex items-center justify-center rounded-2xl bg-violet-600 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-violet-700">Revisar</a>
            <% } %>
            <% if (job.canDownload) { %>
              <a href="/import/pdf/jobs/<%= job.id %>/download" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">Baixar CSV</a>
            <% } %>
            <% if (job.canRetry) { %>
              <form method="post" action="/import/pdf/jobs/<%= job.id %>/retry">
                <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-amber-300 bg-white px-4 py-2.5 text-xs font-bold text-amber-700 transition hover:bg-amber-50 dark:border-amber-900/60 dark:bg-slate-950 dark:text-amber-200">Processar novamente</button>
              </form>
            <% } %>
            <% if (job.canDelete) { %>
              <form method="post" action="/import/pdf/jobs/<%= job.id %>/delete" data-confirm-prompt="Quer mesmo apagar este job e todos os arquivos gerados? Depois não dá para desfazer.">
                <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-rose-300 bg-white px-4 py-2.5 text-xs font-bold text-rose-700 transition hover:bg-rose-50 dark:border-rose-900/60 dark:bg-slate-950 dark:text-rose-200">Excluir</button>
              </form>
            <% } %>
            <% if (job.events && job.events.length) { %>
              <details class="group">
                <summary class="cursor-pointer list-none rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">Detalhes do job</summary>
                <div class="mt-2 space-y-1 rounded-2xl border border-slate-200 bg-white px-3 py-3 text-[11px] font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-950/70 dark:text-slate-300">
                  <% job.events.forEach((event) => { %>
                    <div>• <%= event.message %></div>
                  <% }) %>
                </div>
              </details>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>
