<% const monthlySummaryRecipient = user && user.email ? user.email : 'seu e-mail de login'; %>
<div data-monthly-email-modal aria-hidden="true" class="hidden fixed inset-0 z-[10030] bg-slate-900/60 px-3 py-3 backdrop-blur-sm sm:px-4 sm:py-6">
  <div class="pointer-events-none flex min-h-full items-end justify-center sm:items-center">
    <div class="op-monthly-email-modal pointer-events-auto flex w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800 max-h-[calc(100dvh-1rem)] sm:max-h-[calc(100dvh-2rem)]">
      <div class="flex shrink-0 items-start justify-between gap-4 border-b border-slate-200 px-4 py-4 dark:border-slate-700 sm:px-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-500 dark:text-cyan-300">Resumo no e-mail</p>
          <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Resumo do m&ecirc;s por e-mail</h2>
          <p class="mt-1 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Escolha o conteúdo do resumo que será enviado ao seu e-mail.</p>
        </div>
        <button type="button" data-monthly-email-close class="op-icon-btn" aria-label="Fechar">x</button>
      </div>

      <form data-monthly-email-form class="flex flex-1 flex-col overflow-hidden">
        <div class="op-monthly-email-modal__scroll flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-5">
          <div class="rounded-2xl border border-cyan-100 bg-cyan-50 px-4 py-3 text-sm font-semibold text-cyan-900 dark:border-cyan-900/60 dark:bg-cyan-950/30 dark:text-cyan-100">
            <div>Compet&ecirc;ncia: <span data-monthly-email-period-label>--/----</span></div>
            <div class="mt-1 text-xs font-medium text-cyan-700 dark:text-cyan-200">Vai para: <span data-monthly-email-recipient><%= monthlySummaryRecipient %></span></div>
          </div>

          <fieldset class="mt-4 space-y-3">
            <legend class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500">Conteúdo do resumo</legend>

            <label class="op-monthly-email-option">
              <input type="checkbox" data-monthly-email-section="overview" checked>
              <span><strong>Vis&atilde;o geral do m&ecirc;s</strong><small>Totais, pagos, faltando, status do m&ecirc;s e atalhos para voltar ao app.</small></span>
            </label>

            <label class="op-monthly-email-option">
              <input type="checkbox" data-monthly-email-section="cards" checked>
              <span><strong>Compras por cart&atilde;o</strong><small>Resumo por cart&atilde;o com total, pago, pendente e vencimento usado.</small></span>
            </label>

            <label class="op-monthly-email-option">
              <input type="checkbox" data-monthly-email-section="analytics" checked>
              <span><strong>Categorias e estabelecimentos</strong><small>Top categorias, maior estabelecimento e gr&aacute;ficos simples para e-mail.</small></span>
            </label>

            <label class="op-monthly-email-option">
              <input type="checkbox" data-monthly-email-section="financeFlow" checked>
              <span><strong>Entradas e sa&iacute;das fora do cart&atilde;o</strong><small>Receitas, despesas avulsas e saldo previsto do m&ecirc;s.</small></span>
            </label>

            <label class="op-monthly-email-option">
              <input type="checkbox" data-monthly-email-section="people" checked>
              <span><strong>Pessoas e acertos</strong><small>Totais por pessoa e pend&ecirc;ncias.</small></span>
            </label>

            <label class="op-monthly-email-option op-monthly-email-option--attachment">
              <input type="checkbox" data-monthly-email-attachment="transactionsCsv" checked>
              <span><strong>CSV de compras</strong><small>Anexo .csv com as compras da compet&ecirc;ncia para abrir no Excel/Sheets.</small></span>
            </label>
          </fieldset>

          <div data-monthly-email-status class="hidden mt-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300" role="status" aria-live="polite"></div>
        </div>

        <div class="flex shrink-0 flex-col gap-2 border-t border-slate-200 px-4 py-4 dark:border-slate-700 sm:flex-row sm:justify-end sm:px-6">
          <button type="button" data-monthly-email-close class="op-btn op-btn-ghost sm:min-w-[8rem]">Cancelar</button>
          <button type="submit" data-monthly-email-submit class="op-btn op-btn-info sm:min-w-[12rem]">
            <span data-monthly-email-submit-label>Enviar resumo</span>
            <span data-monthly-email-submit-spinner class="hidden">Enviando...</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
