  <div id="contactModal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4 sm:p-6" aria-hidden="true">
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-contact-modal-close></div>
    <div id="contactModalPanel" role="dialog" aria-modal="true" aria-labelledby="contactFormTitle" class="op-contact-modal-panel relative flex max-h-[min(92vh,980px)] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800">
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-700 sm:px-6">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <div id="contactFormEyebrow" class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Novo contato</div>
            <span id="contactEditingBadge" class="hidden inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-[11px] font-bold text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200">Modo edição</span>
          </div>
          <h2 id="contactFormTitle" class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Adicionar ou editar contato</h2>
          <p id="contactFormHint" class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Salve nome, telefone e e-mail. Se essa pessoa também usa o app, o convite pode ser enviado depois. O Pix continua no perfil dela.</p>
        </div>
        <button type="button" data-contact-modal-close class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-100" aria-label="Fechar formulário de contato">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <form method="post" action="/people" id="contactForm" class="flex min-h-0 flex-1 flex-col">
        <input type="hidden" name="id" id="contactPersonId">
        <input type="hidden" name="return_to" value="/people#network-list">

        <div class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6">
          <div class="grid gap-4">
            <div class="w-full relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <input name="name" id="contactName" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-cyan-500 dark:focus:ring-cyan-500/20" placeholder="Nome do contato" required>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
              <div class="min-w-0 md:col-span-2">
                <div class="grid gap-3 sm:grid-cols-3">
                  <div class="sm:col-span-1">
                    <select name="phone_country" id="contactPhoneCountry" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-cyan-500 dark:focus:ring-cyan-500/20" autocomplete="tel-country-code">
                      <% if (preferredPhoneCountryOptions.length) { %>
                        <optgroup label="Mais usados">
                          <% preferredPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === phoneDefaultCountryCode ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                      <% if (otherPhoneCountryOptions.length) { %>
                        <optgroup label="Todos os países">
                          <% otherPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === phoneDefaultCountryCode ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                    </select>
                  </div>
                  <div class="sm:col-span-2">
                    <div class="relative min-w-0">
                      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                      </div>
                      <input name="phone" id="contactPhone" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-cyan-500 dark:focus:ring-cyan-500/20" placeholder="(21) 99999-9999" inputmode="tel" autocomplete="tel-national">
                    </div>
                  </div>
                </div>
                <p id="contactPhoneHint" class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">DDI e máscara se ajustam por aqui conforme o país escolhido.</p>
              </div>

              <div class="relative min-w-0 md:col-span-2">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m8-4H8m12 8H4a2 2 0 01-2-2V6a2 2 0 012-2h16a2 2 0 012 2v8a2 2 0 01-2 2z"></path></svg>
                </div>
                <input name="email" id="contactEmail" type="email" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-cyan-500 dark:focus:ring-cyan-500/20" placeholder="email@exemplo.com">
              </div>
            </div>

            <div class="rounded-xl border border-cyan-200 bg-cyan-50/70 px-4 py-3.5 shadow-sm dark:border-cyan-900/60 dark:bg-cyan-950/20 sm:px-5">
              <div class="flex items-start gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-cyan-600 shadow-sm ring-1 ring-cyan-100 dark:bg-slate-800 dark:text-cyan-300 dark:ring-cyan-900/50" aria-hidden="true">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1zm7 4h.01"></path></svg>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Pix da outra pessoa</div>
                  <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Você não precisa guardar o Pix de ninguém aqui. Quando a relação estiver ativa, o app usa o Pix que a própria pessoa deixou no perfil.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-200 px-5 py-4 dark:border-slate-700 sm:px-6">
          <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button type="button" id="contactBtnCancel" onclick="closeContactComposeModal()" class="hidden w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto">Cancelar</button>
            <button type="submit" id="contactBtnSubmit" class="inline-flex w-full items-center justify-center rounded-2xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-cyan-500/20 transition-all hover:-translate-y-0.5 hover:bg-cyan-700 sm:w-auto">
              <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Salvar contato
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
