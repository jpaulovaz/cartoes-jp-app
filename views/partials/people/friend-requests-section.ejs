    <section id="friend-requests" class="op-people-requests-section op-network-requests-shell scroll-mt-28 mb-8 rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm dark:border-emerald-900/50 dark:bg-slate-800 sm:p-7">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">Convites recebidos</div>
          <h2 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Pessoas aguardando sua resposta</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Ao aceitar, esse contato entra na sua rede e passa a poder dividir e acertar valores com você.</p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50/90 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm dark:border-emerald-900/70 dark:bg-emerald-900/20 dark:text-emerald-200">
          <%= pendingRequests.length === 1 ? '1 convite esperando você' : `${pendingRequests.length} convites esperando você` %>
        </div>
      </div>

      <div class="mt-6 grid gap-4">
        <% pendingRequests.forEach((request) => {
             const isHighlighted = highlightedFriendRequestId && Number(highlightedFriendRequestId) === Number(request.id);
        %>
          <article id="friend-request-<%= request.id %>" class="op-people-request-card op-network-request-card overflow-hidden rounded-2xl border bg-slate-50/70 shadow-sm transition-all dark:bg-slate-900/60 <%= isHighlighted ? 'border-emerald-400 ring-2 ring-emerald-200 dark:border-emerald-500 dark:ring-emerald-900/70' : 'border-emerald-200 dark:border-slate-700' %>">
            <div class="h-1.5 bg-gradient-to-r from-emerald-400 via-cyan-400 to-cyan-400"></div>
            <div class="p-5 sm:p-6">
              <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-lg font-bold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-200">
                      <%= (request.requester_name || 'A').charAt(0).toUpperCase() %>
                    </span>
                    <div class="min-w-0">
                      <div class="text-lg font-bold text-slate-900 dark:text-white"><%= request.requester_name || 'Usuário AcerttaPay' %></div>
                      <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Enviou um convite para entrar na sua rede.</div>
                    </div>
                  </div>

                  <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
                    <span class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200">Também usa o app</span>
                    <% if (request.linked_person_name) { %>
                      <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">Já apareceu como <%= request.linked_person_name %></span>
                    <% } %>
                    <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pedido pendente</span>
                  </div>
                </div>

                <div class="grid gap-2 sm:min-w-[18rem] sm:grid-cols-2 xl:w-auto">
                  <form method="post" action="/friend-requests/<%= request.id %>/respond">
                    <input type="hidden" name="action" value="accept">
                    <button type="submit" class="w-full rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">Aceitar</button>
                  </form>
                  <form method="post" action="/friend-requests/<%= request.id %>/respond">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="w-full rounded-2xl border border-rose-200 bg-white px-4 py-3 text-sm font-bold text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">Recusar</button>
                  </form>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
