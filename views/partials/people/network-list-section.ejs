  <section id="network-list" class="op-network-list-section scroll-mt-28 mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-8">
    <div>
      <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Sua rede ativa</div>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Relações e contatos</h2>
      <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Busque, filtre e acompanhe quem já está na sua rede ou ainda depende de ação.</p>
    </div>

    <% if (contactList.length) { %>
      <div class="op-network-toolbar mt-6 grid gap-4 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-center">
        <label class="relative block">
          <span class="sr-only">Buscar na rede</span>
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input type="search" id="networkSearch" class="w-full rounded-2xl border border-slate-300 bg-slate-50 py-3.5 pl-11 pr-4 text-sm font-medium text-slate-900 shadow-sm transition outline-none focus:border-slate-500 focus:bg-white focus:ring-2 focus:ring-slate-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-slate-400 dark:focus:bg-slate-950 dark:focus:ring-slate-500/20" placeholder="Buscar por nome, telefone ou e-mail">
        </label>

        <div class="op-network-filter-strip flex flex-wrap gap-2">
          <button type="button" data-network-filter="all" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Todos <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-300"><%= contactList.length %></span></button>
          <button type="button" data-network-filter="friend" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Minha rede <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-300"><%= activeFriendCount %></span></button>
          <button type="button" data-network-filter="pending" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Convites <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-300"><%= pendingContactCount %></span></button>
          <button type="button" data-network-filter="discover" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Já no app <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-300"><%= discoverableCount %></span></button>
          <button type="button" data-network-filter="local" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Na sua lista <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-300"><%= localOnlyCount %></span></button>
        </div>
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <% contactList.forEach((p) => {
             const isHighlighted = highlightedFriendRequestId && Number(p.incoming_friend_request_id || 0) === Number(highlightedFriendRequestId);
             const personState = getNetworkState(p);
             const pixState = getPixStateMeta(p);
             const profileSignatureMeta = getSignatureVibeMeta(p.profile_signature_vibe);
             const profileSignatureVisible = p.friendship_active && !!(p.profile_signature_text || p.profile_signature_vibe);
             let personHintText = '';
             if (!p.email) {
               personHintText = 'Com e-mail, fica mais fácil localizar esse contato no app.';
             } else if (!p.has_app_user) {
               personHintText = 'Este contato ainda não foi encontrado no app. Se entrar depois, o perfil passa a centralizar o Pix.';
             } else if (p.friendship_active && !p.active) {
               personHintText = 'A relação está ativa, mas este contato está pausado.';
             } else if (p.friendship_active && p.linked_user_pix_ready) {
               personHintText = 'Quando houver pagamento, o app usa o Pix do perfil.';
             } else if (p.friendship_active && p.linked_user_pix_enabled && !p.linked_user_pix_ready) {
               personHintText = 'A relação está ativa, mas o Pix ainda está em validação.';
             } else if (p.friendship_active) {
               personHintText = 'A relação está ativa. Falta apenas configurar o Pix.';
             } else if (p.friendship_state === 'pending_sent') {
               personHintText = 'Convite enviado. Aguardando retorno.';
             } else if (p.friendship_state === 'pending_received') {
               personHintText = 'Este contato já enviou um convite. Basta aceitar.';
             } else if (!p.active) {
               personHintText = 'Este contato usa o app, mas está pausado.';
             } else {
               personHintText = 'O app já encontrou este contato. Se fizer sentido, envie um convite.';
             }
        %>
          <article
            data-person-card
            data-filter-state="<%= personState.key %>"
            data-search-text="<%= [p.name, p.phone_search_text, p.email, personState.label, personHintText, p.profile_signature_text, profileSignatureMeta?.label].filter(Boolean).join(' ') %>"
            class="op-network-card group relative overflow-hidden rounded-2xl border bg-white shadow-sm transition-all dark:bg-slate-800 <%= isHighlighted ? 'border-emerald-400 ring-2 ring-emerald-200 dark:border-emerald-500 dark:ring-emerald-900/70' : 'border-slate-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-slate-700 dark:hover:border-slate-600' %>">
            <div class="h-1.5 bg-gradient-to-r <%= personState.barClasses %>"></div>
            <div class="flex flex-col gap-4 p-5 sm:p-6">
              <div class="flex min-w-0 gap-4">
                <div class="relative h-14 w-14 shrink-0">
                  <% if (getAvatarUrl(p)) { %>
                    <img src="<%= getAvatarUrl(p) %>" alt="<%= p.name %>" loading="lazy" referrerpolicy="no-referrer" class="h-14 w-14 rounded-full object-cover ring-2 ring-slate-200 dark:ring-slate-700">
                  <% } else { %>
                    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-lg font-bold text-slate-600 transition-colors group-hover:bg-cyan-50 group-hover:text-cyan-600 dark:bg-slate-900 dark:text-slate-300 dark:group-hover:bg-cyan-900/40"><%= getAvatarInitials(p) %></div>
                  <% } %>
                  <% if (p.friendship_active) { %>
                    <span class="absolute -bottom-1 -right-1 inline-flex h-7 w-7 items-center justify-center rounded-full border border-emerald-200 bg-emerald-500 text-[13px] text-white shadow-sm dark:border-emerald-700" title="Relacionamento ativo"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14L21 3m0 0h-6m6 0v6M14 10L3 21m0 0h6m-6 0v-6"></path></svg></span>
                  <% } %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-start gap-2">
                    <h3 class="min-w-0 flex-1 text-xl font-bold text-slate-900 dark:text-white"><span class="block truncate"><%= p.name %></span></h3>
                    <span class="inline-flex shrink-0 items-center rounded-full border px-2.5 py-1 text-[10.5px] font-bold <%= personState.badgeClasses %>"><%= personState.label %></span>
                    <button type="button"
                      data-id="<%= p.id %>"
                      data-name="<%= p.name %>"
                      data-phone="<%= p.phone_ui_national || '' %>"
                      data-phone-country="<%= p.phone_ui_country || phoneDefaultCountryCode %>"
                      data-email="<%= p.email || '' %>"
                      onclick="editContactFromButton(this)"
                      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:border-cyan-200 hover:bg-cyan-50 hover:text-cyan-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-cyan-800 dark:hover:bg-cyan-900/20 dark:hover:text-cyan-200"
                      aria-label="Editar contato"
                      title="Editar contato">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    </button>
                  </div>

                  <% if (profileSignatureVisible) { %>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                      <% if (p.profile_signature_text) { %>
                        <p class="min-w-0 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= p.profile_signature_text %></p>
                      <% } %>
                      <% if (profileSignatureMeta) { %>
                        <span class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-[11px] font-bold text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/30 dark:text-cyan-200"><%= profileSignatureMeta.label %></span>
                      <% } %>
                    </div>
                  <% } %>

                  <div class="mt-3 space-y-2 text-[13px] font-medium text-slate-600 dark:text-slate-300">
                    <div class="inline-flex w-fit max-w-full items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
                      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50/80 text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a2 2 0 011.897 1.368l1.516 4.547a2 2 0 01-.45 2.11l-2.07 2.07a16 16 0 006.364 6.364l2.07-2.07a2 2 0 012.11-.45l4.547 1.516A2 2 0 0121 15.72V19a2 2 0 01-2 2h-1C9.163 21 3 14.837 3 7V5z"></path></svg>
                      </span>
                      <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis whitespace-nowrap leading-5" title="<%= p.phone_display ? p.phone_display : 'Telefone não informado ainda.' %>"><%= p.phone_display ? p.phone_display : 'Telefone não informado ainda.' %></span>
                    </div>
                    <div class="inline-flex w-fit max-w-full items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
                      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50/80 text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-16 8h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                      </span>
                      <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis whitespace-nowrap leading-5" title="<%= p.email ? p.email : 'E-mail não informado ainda.' %>"><%= p.email ? p.email : 'E-mail não informado ainda.' %></span>
                    </div>
                  </div>

                  <div class="mt-3 inline-flex max-w-full items-center gap-2 overflow-hidden rounded-full border border-slate-200 bg-slate-50/80 px-3 py-2 text-[13px] font-semibold leading-5 text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 whitespace-nowrap">
                    <span aria-hidden="true"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8M8 14h5m7 6l-3.6-1.8a2 2 0 00-.9-.2H6a3 3 0 01-3-3V7a3 3 0 013-3h12a3 3 0 013 3v8a3 3 0 01-3 3h-.5a2 2 0 00-.9.2L20 20z"></path></svg></span>
                    <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis"><%= personState.summary %></span>
                  </div>
                </div>
              </div>

              <div class="op-network-filter-strip flex flex-wrap gap-2">
                <%- renderPersonStatusChips(p) %>
              </div>

              <div class="op-network-card-actions grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-4">
                <% if (p.friendship_state === 'active') { %>
                  <form method="post" action="/people/<%= p.id %>/unfriend" class="min-w-0" data-confirm-prompt="Desfazer amizade com <%= p.name %>? O histórico continua salvo, mas novas cobranças entre vocês param na hora.">
                    <button class="<%= personActionMatchComprasClass %> border-rose-200 bg-white text-rose-700 hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">
                      <span class="<%= personActionMatchComprasLabelClass %>">Desfazer amizade</span>
                    </button>
                  </form>
                <% } else if (p.friendship_state === 'pending_sent') { %>
                  <form method="post" action="/friend-requests/<%= p.outgoing_friend_request_id %>/cancel" class="min-w-0">
                    <button class="<%= personActionMatchComprasClass %> border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100 dark:border-amber-900 dark:bg-amber-900/20 dark:text-amber-200 dark:hover:bg-amber-900/35">
                      <span class="<%= personActionMatchComprasLabelClass %>">Cancelar pedido</span>
                    </button>
                  </form>
                <% } else if (p.friendship_state === 'pending_received') { %>
                  <form method="post" action="/friend-requests/<%= p.incoming_friend_request_id %>/respond" class="min-w-0">
                    <input type="hidden" name="action" value="accept">
                    <button class="<%= personActionMatchComprasClass %> border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400">
                      <span class="<%= personActionMatchComprasLabelClass %>">Aceitar amizade</span>
                    </button>
                  </form>
                  <form method="post" action="/friend-requests/<%= p.incoming_friend_request_id %>/respond" class="min-w-0">
                    <input type="hidden" name="action" value="reject">
                    <button class="<%= personActionMatchComprasClass %> border-rose-200 bg-white text-rose-700 hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">
                      <span class="<%= personActionMatchComprasLabelClass %>">Recusar</span>
                    </button>
                  </form>
                <% } else if (p.has_app_user && p.active) { %>
                  <form method="post" action="/people/<%= p.id %>/send-friend-request" class="min-w-0">
                    <button class="<%= personActionMatchComprasClass %> border-cyan-600 bg-cyan-600 text-white hover:bg-cyan-700 dark:border-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400">
                      <span class="<%= personActionMatchComprasLabelClass %>">Mandar convite</span>
                    </button>
                  </form>
                <% } else { %>
                  <div class="<%= personActionMatchComprasClass %> border-dashed border-slate-200 bg-slate-50/60 text-xs font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400">
                    <span class="<%= personActionMatchComprasLabelClass %>">Convite indisponível</span>
                  </div>
                <% } %>

                <% if (p.friendship_active && p.has_app_user) { %>
                  <a href="/people/<%= p.id %>/compras-comigo" class="inline-flex min-h-[48px] w-full items-center justify-center rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-center text-sm font-bold leading-none text-cyan-700 shadow-sm transition-colors hover:bg-cyan-100 dark:border-cyan-900 dark:bg-cyan-900/20 dark:text-cyan-200 dark:hover:bg-cyan-900/35" title="<%= (p.compras_comigo_badge_count || 0) > 0 ? `${p.compras_comigo_badge_count} item(ns) pedindo sua ação nessa amizade.` : 'Abrir a leitura mensal das compras em que você entrou nessa amizade.' %>">
                    <span class="inline-flex items-center justify-center gap-2 leading-none">
                      <span class="block leading-none">Compras comigo</span>
                      <% if ((p.compras_comigo_badge_count || 0) > 0) { %>
                        <span class="inline-flex min-w-[1.65rem] items-center justify-center rounded-full border border-cyan-200 bg-white px-2 py-0.5 text-[11px] font-bold leading-none text-cyan-700 shadow-sm dark:border-cyan-800 dark:bg-cyan-950/60 dark:text-cyan-200"><%= p.compras_comigo_badge_count %></span>
                      <% } %>
                    </span>
                  </a>
                <% } %>

                <form method="post" action="/people/<%= p.id %>/toggle" class="min-w-0">
                  <button class="<%= personActionMatchComprasClass %> bg-white dark:bg-slate-900 <%= p.active ? 'border-red-200 text-red-600 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-900/20' : 'border-green-200 text-green-700 hover:bg-green-50 dark:border-green-900 dark:text-green-400 dark:hover:bg-green-900/20' %>">
                    <span class="<%= personActionMatchComprasLabelClass %>"><%= p.active ? 'Desativar' : 'Reativar' %></span>
                  </button>
                </form>
                <form method="post" action="/people/<%= p.id %>/delete" class="min-w-0" data-confirm-prompt="Excluir <%= p.name %> da sua lista ativa? O passado continua salvo, mas a exclusão trava se ainda houver valor em aberto, Pix do mês em andamento ou cobrança guardada para enviar depois." data-confirm-phrase="Eu confirmo">
                  <button class="<%= personActionMatchComprasClass %> border-red-200 bg-white text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-slate-900 dark:text-red-400 dark:hover:bg-red-900/20">
                    <span class="<%= personActionMatchComprasLabelClass %>">Excluir da lista</span>
                  </button>
                </form>
              </div>

              <div class="op-network-card-insights grid gap-3 xl:grid-cols-2">
                <div class="rounded-xl border border-cyan-200/70 bg-cyan-50/80 px-4 py-3.5 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20">
                  <div class="flex flex-wrap items-center gap-2">
                    <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600/80 dark:text-cyan-300/80">Pix nas cobranças</div>
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= pixState.badgeClasses %>"><%= pixState.label %></span>
                  </div>
                  <p class="mt-2 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= pixState.summary %></p>
                </div>

                <div class="rounded-xl border border-cyan-100/70 bg-slate-50/90 px-4 py-3.5 shadow-sm shadow-cyan-100/10 dark:border-slate-700 dark:bg-slate-900/70 sm:px-5">
                  <div class="flex items-start gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-cyan-600 shadow-sm ring-1 ring-cyan-100 dark:bg-slate-800 dark:text-cyan-300 dark:ring-slate-700" aria-hidden="true">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600/70 dark:text-cyan-300/80">Situação atual</div>
                      <p class="mt-1 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= personHintText %></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% }) %>

        <div id="networkFilteredEmpty" class="op-network-empty-state hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-6 py-10 text-center text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400 lg:col-span-2">Nenhum contato corresponde ao filtro atual. Ajuste a busca ou troque o filtro para continuar.</div>
      </div>
    <% } else { %>
      <div class="op-network-empty-state mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-900/50">
        <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Sua rede ainda está vazia. Quando quiser, comece adicionando quem participa das suas divisões e acertos.</div>
        <button type="button" onclick="openContactComposeModal(this)" class="mt-4 inline-flex items-center justify-center rounded-2xl border border-cyan-600 bg-cyan-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-700 dark:border-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400">Adicionar contato</button>
      </div>
    <% } %>
  </section>
