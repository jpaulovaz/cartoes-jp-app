    <section id="alerts" class="op-settings-alerts-card scroll-mt-28 mb-8 rounded-2xl border border-cyan-200 bg-white p-5 shadow-sm dark:border-cyan-900/50 dark:bg-slate-800 sm:p-6 xl:mx-auto xl:max-w-[80rem]">
      <div class="mb-5">
        <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Alertas</div>
        <h2 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Defina o que deve gerar aviso</h2>
        <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Os grupos continuam os mesmos, agora reunidos em uma área própria de preferências.</p>
      </div>
          <div class="mt-4 space-y-4">
            <div class="op-settings-alerts-summary rounded-2xl border border-cyan-100 bg-cyan-50/80 p-4 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full border border-cyan-200 bg-white/90 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-700 shadow-sm dark:border-cyan-800 dark:bg-slate-900/80 dark:text-cyan-200">Seus alertas</span>
                    <span class="inline-flex items-center rounded-full border border-white/80 bg-white/80 px-3 py-1 text-[11px] font-bold text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300"><%= notificationPreferenceEnabledCount %>/<%= notificationPreferenceTotalCount %> grupos ligados</span>
                  </div>
                </div>
                <button type="button" data-push-toggle data-push-toggle-variant="compact" data-push-public-key="<%= pushPublicKey %>" data-push-status-target="#selfNotificationPushStatus" class="op-btn op-btn-warning-soft op-btn--compact shrink-0 self-start sm:self-auto whitespace-nowrap">Ativar alertas</button>
              </div>
              <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white">Alertas da conta</h3>
              <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">As opções abaixo valem para sua conta. O botão ao lado ativa alertas neste aparelho.</p>
              <p id="selfNotificationPushStatus" class="mt-2 text-sm font-semibold leading-6 text-slate-500 dark:text-slate-400">Ative este aparelho para receber alertas.</p>
            </div>

            <form method="post" action="/people/notification-preferences" class="space-y-4">
              <input type="hidden" name="return_to" value="/settings#alerts">
              <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900/80">
                <% notificationPreferenceGroups.forEach((group, index) => { 
                     const groupCopy = notificationPreferenceCopy[group.key] || {};
                     const groupTitle = groupCopy.title || group.title;
                     const groupDescription = groupCopy.description || group.description;
                %>
                  <label class="group flex cursor-pointer items-center gap-3 px-4 py-2.5 transition-colors hover:bg-cyan-50/60 dark:hover:bg-cyan-950/20">
                    <div class="min-w-0 flex-1">
                      <div class="text-[13px] font-bold text-slate-900 dark:text-white"><%= groupTitle %></div>
                      <p class="mt-0.5 text-[11px] font-medium leading-4.5 text-slate-500 dark:text-slate-400"><%= groupDescription %></p>
                    </div>
                    <div class="flex shrink-0 items-center gap-3 pl-2">
                      <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400"><%= group.enabled ? 'Ligado' : 'Pausado' %></span>
                      <input type="checkbox" name="pref_<%= group.key %>" value="1" <%= group.enabled ? 'checked' : '' %> class="h-5 w-5 shrink-0 rounded-md border-slate-300 text-cyan-600 focus:ring-cyan-500 dark:border-slate-600 dark:bg-slate-950">
                    </div>
                  </label>
                  <% if (index < notificationPreferenceGroups.length - 1) { %>
                    <div class="mx-4 border-t border-slate-200/80 dark:border-slate-700/80"></div>
                  <% } %>
                <% }) %>
              </div>

              <div class="op-settings-context-note flex flex-col gap-3 rounded-xl border border-dashed border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/60 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">As preferências ficam salvas na sua conta. O sino do topo continua abrindo a central completa.</p>
                <button type="submit" class="inline-flex w-full shrink-0 items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto whitespace-nowrap">Salvar alertas</button>
              </div>
            </form>
          </div>

    </section>
