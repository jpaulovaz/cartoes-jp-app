    <section id="profile" class="op-settings-profile-shell op-settings-profile-layout scroll-mt-28 mb-8 grid gap-6 xl:grid-cols-[minmax(0,1.02fr)_minmax(340px,0.98fr)] xl:items-start">
      <div class="op-settings-profile-panel rounded-2xl border border-amber-200 bg-white shadow-sm dark:border-amber-900/50 dark:bg-slate-800">
        <div class="border-b border-amber-100 px-5 py-5 dark:border-amber-900/40 sm:px-6 sm:py-6">
          <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-amber-700 dark:text-amber-300">Perfil</div>
          <h2 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Atualize seus dados principais</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Nome, telefone e e-mail usados na sua rede e nos acertos ficam centralizados aqui.</p>
        </div>
        <div id="selfIdentityShell" class="border-t border-amber-100 p-5 dark:border-amber-900/40 sm:p-6">
          <form method="post" action="/people" id="selfIdentityForm" class="space-y-4" autocomplete="on">
            <input type="hidden" name="id" id="selfPersonId" value="<%= selfProfile.id %>">
            <input type="hidden" name="profile_section" value="identity">
            <input type="hidden" name="return_to" value="/settings#profile">

            <label class="block">
              <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Nome exibido</span>
              <input name="name" id="selfName" value="<%- selfName %>" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="Seu nome no app" required>
            </label>

            <div class="grid gap-4">
              <div class="min-w-0">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">País e telefone</span>
                <div class="grid gap-3 sm:grid-cols-3">
                  <div class="sm:col-span-1">
                    <select name="phone_country" id="selfPhoneCountry" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" autocomplete="tel-country-code">
                      <% if (preferredPhoneCountryOptions.length) { %>
                        <optgroup label="Mais usados">
                          <% preferredPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === selfPhoneCountry ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                      <% if (otherPhoneCountryOptions.length) { %>
                        <optgroup label="Todos os países">
                          <% otherPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === selfPhoneCountry ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                    </select>
                  </div>
                  <div class="sm:col-span-2">
                    <div class="relative min-w-0">
                      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                      </div>
                      <input name="phone" id="selfPhone" value="<%- selfPhone %>" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="(21) 99999-9999" inputmode="tel" autocomplete="tel-national">
                    </div>
                  </div>
                </div>
              </div>

              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">E-mail visível</span>
                <div class="relative min-w-0">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-16 8h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                  </div>
                  <input name="email" id="selfEmail" type="email" value="<%- selfEmail %>" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="email@exemplo.com">
                </div>
              </label>
            </div>

            <div class="op-settings-context-note rounded-xl border border-cyan-100 bg-cyan-50/80 px-4 py-3.5 text-sm font-medium leading-6 text-slate-600 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20 dark:text-slate-300">
              Esses dados ajudam sua rede a reconhecer você nas divisões, cobranças e acertos do app.
            </div>

            <div class="pt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
              <button type="button" id="selfIdentityCancel" onclick="resetSelfIdentityForm()" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto">Cancelar</button>
              <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto">Salvar dados</button>
            </div>
          </form>
        </div>
      </div>
      <div class="grid gap-6">
        <section class="op-settings-profile-card op-settings-overview-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Resumo rápido</div>
              <h3 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Visão geral da conta</h3>
            </div>
            <p class="max-w-sm text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Os indicadores ao lado mostram o estado atual do seu perfil, alertas, Pix e acesso.</p>
          </div>
          <div class="op-settings-overview-grid mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Alertas</div>
              <div class="mt-2 text-lg font-bold text-slate-900 dark:text-white"><%= notificationPreferenceEnabledCount %>/<%= notificationPreferenceTotalCount %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Grupos ligados.</p>
            </div>
            <div class="rounded-xl border border-cyan-200/70 bg-cyan-50/80 px-4 py-3 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20">
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Pix</div>
              <div class="mt-2 text-lg font-bold text-slate-900 dark:text-white"><%= selfProfile.pix_enabled && selfProfile.pix_valid ? 'Pronto' : (selfProfile.pix_enabled ? 'Ajustar' : 'Desligado') %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Recebimento por aqui.</p>
            </div>
            <div class="rounded-xl border border-amber-200/70 bg-amber-50/80 px-4 py-3 shadow-sm dark:border-amber-900/50 dark:bg-amber-950/20">
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-amber-700 dark:text-amber-300">PIN</div>
              <div class="mt-2 text-lg font-bold text-slate-900 dark:text-white"><%= appPinEnabled ? appPinIdleLabel : 'Desligado' %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= appPinEnabled ? 'Tempo atual do bloqueio.' : 'Proteção extra ainda desligada.' %></p>
            </div>
            <div class="rounded-xl border border-cyan-200/70 bg-cyan-50/80 px-4 py-3 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20">
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Aparelhos</div>
              <div class="mt-2 text-lg font-bold text-slate-900 dark:text-white"><%= appPasskeyCount %>/<%= appPasskeyMaxCount || 6 %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Prontos para desbloqueio.</p>
            </div>
          </div>
        </section>

        <section id="profile-photo" class="op-settings-photo-card flex h-full flex-col rounded-2xl border border-cyan-200 bg-white p-5 shadow-sm dark:border-cyan-900/50 dark:bg-slate-800 sm:p-6">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Foto do perfil</div>
            <h3 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Sua foto na conta</h3>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">A foto aparece no topo do app e nas divisões. Se não houver imagem, o app usa sua identificação padrão.</p>
          </div>

          <% const hasGoogleDefaultPhoto = !!(selfProfile && selfProfile.google_photo_url); %>
          <% const photoMode = (selfProfile && selfProfile.profile_photo_mode) || 'default'; %>
          <% const hasManualPhoto = photoMode === 'manual' && !!(selfProfile && selfProfile.profile_photo_url); %>
          <% const showUseDefaultButton = hasManualPhoto || (photoMode === 'none' && hasGoogleDefaultPhoto); %>
          <% const showRemoveButton = !!(selfProfile && selfProfile.photo_url); %>

          <div class="mt-4 flex flex-1 flex-col">
            <form method="post" action="/people/profile-photo" enctype="multipart/form-data" class="flex flex-col gap-3" id="profilePhotoForm">
              <input type="hidden" name="return_to" value="/settings#profile-photo">
              <input id="profilePhotoInput" type="file" name="profile_photo" accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full rounded-2xl border border-cyan-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm file:mr-3 file:rounded-xl file:border-0 file:bg-cyan-100 file:px-3 file:py-2 file:font-bold file:text-cyan-700 hover:file:bg-cyan-200 dark:border-cyan-900/70 dark:bg-slate-900 dark:text-slate-200 dark:file:bg-cyan-900/40 dark:file:text-cyan-200">
              <div id="profilePhotoPreviewWrap" class="hidden w-full items-center gap-3 rounded-2xl border border-cyan-200/80 bg-cyan-50/70 px-4 py-3 dark:border-cyan-900/60 dark:bg-cyan-950/20">
                <img id="profilePhotoPreview" alt="Prévia da sua foto" class="h-14 w-14 rounded-full object-cover ring-2 ring-cyan-200 dark:ring-cyan-800/70">
                <div class="min-w-0 flex-1">
                  <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Prévia da foto</div>
                  <p id="profilePhotoHint" class="mt-1 text-sm font-medium leading-5 text-slate-600 dark:text-slate-300">Se a prévia estiver certa, salve para aplicar na conta.</p>
                </div>
              </div>
              <div class="w-full rounded-2xl border border-cyan-200/80 bg-white/80 p-3 text-sm font-medium leading-6 text-slate-600 shadow-sm dark:border-cyan-900/60 dark:bg-slate-900/70 dark:text-slate-300">
                Você pode escolher a imagem, ajustar e salvar quando a prévia estiver certa.
              </div>
            </form>

            <div class="flex flex-wrap items-stretch justify-end gap-3 pt-4">
              <% if (showUseDefaultButton) { %>
                <form method="post" action="/people/profile-photo/use-default" class="shrink-0">
                  <input type="hidden" name="return_to" value="/settings#profile-photo">
                  <button type="submit" class="inline-flex min-h-[46px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Usar foto padrão</button>
                </form>
              <% } %>
              <% if (showRemoveButton) { %>
                <form method="post" action="/people/profile-photo/remove" class="shrink-0">
                  <input type="hidden" name="return_to" value="/settings#profile-photo">
                  <button type="submit" class="inline-flex min-h-[46px] items-center justify-center rounded-2xl border border-rose-200 bg-rose-50/70 px-4 py-3 text-sm font-bold text-rose-700 transition-all hover:bg-rose-100/80 dark:border-rose-900/70 dark:bg-rose-950/20 dark:text-rose-200 dark:hover:bg-rose-950/35">Excluir foto</button>
                </form>
              <% } %>
              <button form="profilePhotoForm" id="profilePhotoSubmit" type="submit" class="inline-flex min-h-[46px] items-center justify-center rounded-2xl bg-cyan-600 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-cyan-500/20 transition-all hover:-translate-y-0.5 hover:bg-cyan-700 disabled:cursor-not-allowed disabled:opacity-60 shrink-0">Salvar foto</button>
            </div>
          </div>
        </section>
      </div>

        <div id="profilePhotoCropModal" class="fixed inset-0 z-[120] hidden items-center justify-center overflow-y-auto p-4 sm:p-6" aria-hidden="true">
          <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm" data-profile-photo-modal-close></div>
          <div class="relative my-auto w-full max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 shadow-lg dark:border-slate-700 dark:bg-slate-900 sm:p-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Ajuste sua foto</div>
                <h4 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Escolha o melhor enquadramento</h4>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Arraste para posicionar, ajuste o zoom e centralize a imagem antes de salvar.</p>
              </div>
              <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800" data-profile-photo-modal-close>Fechar</button>
            </div>
            <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
              <div>
                <div id="profilePhotoCropStage" class="relative mx-auto aspect-square w-full max-w-[26rem] overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 shadow-inner dark:border-slate-700 touch-none select-none">
                  <img id="profilePhotoCropImage" alt="Ajuste da foto" class="absolute left-1/2 top-1/2 max-w-none will-change-transform pointer-events-none select-none" draggable="false">
                  <div class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/35"></div>
                  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0,transparent_56%,rgba(15,23,42,0.42)_100%)]"></div>
                </div>
                <p class="mt-3 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Se houver mais gente na foto, arraste até deixar você no centro. A moldura redonda serve como prévia do recorte final.</p>
              </div>
              <div class="rounded-xl border border-cyan-200/80 bg-cyan-50/70 p-4 shadow-sm dark:border-cyan-900/60 dark:bg-cyan-950/20">
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Como vai ficar</div>
                <div class="mt-4 flex items-center justify-center">
                  <div class="relative h-28 w-28 overflow-hidden rounded-full border-4 border-white bg-slate-200 shadow-lg ring-1 ring-cyan-200 dark:border-slate-900 dark:bg-slate-800 dark:ring-cyan-900/70">
                    <img id="profilePhotoCropPreview" alt="Prévia circular da foto" class="absolute left-1/2 top-1/2 max-w-none will-change-transform pointer-events-none select-none" draggable="false">
                  </div>
                </div>
                <label class="mt-5 block">
                  <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Zoom</span>
                  <input id="profilePhotoCropZoom" type="range" min="1" max="3" step="0.01" value="1" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-cyan-100 accent-cyan-600 dark:bg-slate-800">
                </label>
                <div class="mt-5 flex flex-col gap-3">
                  <button type="button" id="profilePhotoCropApply" class="inline-flex items-center justify-center rounded-2xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-cyan-500/20 transition-all hover:-translate-y-0.5 hover:bg-cyan-700">Aplicar foto</button>
                  <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800" data-profile-photo-modal-close>Escolher outra depois</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
