    <section id="security" class="op-settings-security-shell scroll-mt-28 xl:mx-auto xl:max-w-[80rem]">
        <section id="app-security" class="op-settings-security-card op-settings-security-panel xl:col-span-2 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Segurança do app</div>
              <h3 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">PIN e bloqueio automático</h3>
              <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Defina se o app pede PIN ao abrir e em quanto tempo ele volta a bloquear automaticamente.</p>
            </div>
            <% if (appPinEnabled) { %>
              <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">PIN ativo</span>
            <% } else { %>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">PIN desativado</span>
            <% } %>
          </div>

          <div class="mt-5 grid gap-4">
            <div class="grid gap-4 xl:grid-cols-2 xl:items-stretch">
              <div class="op-settings-security-summary-card h-full rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 sm:px-5">
                <div class="flex items-start gap-3">
                  <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white text-slate-700 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-200 dark:ring-slate-700" aria-hidden="true">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-.967.784-1.75 1.75-1.75S15.5 10.033 15.5 11c0 .645-.35 1.208-.87 1.51-.358.208-.63.57-.63.98V15m-4-4V8a4 4 0 118 0v3m-10 0h12a1 1 0 011 1v7a1 1 0 01-1 1H7a1 1 0 01-1-1v-7a1 1 0 011-1z"></path></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Resumo atual</div>
                    <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
                      <% if (appPinEnabled) { %>
                        O app já pede PIN para abrir e hoje está configurado para bloquear novamente em <strong class="font-semibold text-slate-700 dark:text-slate-100"><%= appPinIdleLabel %></strong>.
                      <% } else { %>
                        Hoje o app abre sem PIN. Se quiser, você pode ativar essa camada para proteger melhor o conteúdo financeiro.
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="op-settings-security-action-card flex h-full flex-col rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 sm:px-5">
                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
                  <% if (!appPinEnabled) { %>
                    <button type="button" data-app-pin-open="create" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Ativar PIN</button>
                  <% } else { %>
                    <button type="button" data-app-pin-open="change" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Trocar PIN</button>
                    <form method="post" action="/lock/engage" class="contents sm:contents">
                      <input type="hidden" name="reason" value="manual">
                      <input type="hidden" name="return_to" value="/settings#security">
                      <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Bloquear agora</button>
                    </form>
                    <button type="button" data-app-pin-open="idle" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Tempo de bloqueio</button>
                    <button type="button" data-app-pin-open="disable" class="inline-flex items-center justify-center rounded-2xl border border-rose-200 bg-white px-5 py-3 text-sm font-bold text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">Desligar PIN</button>
                  <% } %>
                </div>
                <p class="mt-3 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Seu PIN pode ter de <%= appPinMinLength %> a <%= appPinMaxLength %> dígitos. A recomendação é usar <strong class="font-semibold text-slate-700 dark:text-slate-100">6 números</strong> e evitar combinações simples, como 1234 ou 0000.</p>
              </div>
            </div>

            <div class="grid gap-4 xl:grid-cols-2 xl:items-stretch">
              <div class="op-settings-context-note h-full rounded-2xl border border-cyan-200/70 bg-cyan-50/80 px-4 py-4 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20 sm:px-5">
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Como funciona</div>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Depois de ativado, o app pede PIN ao abrir de novo ou quando o tempo configurado expira. Se esquecer o PIN, a tela de bloqueio permite confirmar sua conta Google para redefinir.</p>
              </div>

              <div class="op-settings-context-note h-full rounded-2xl border border-dashed border-slate-200 bg-slate-50/70 px-4 py-4 text-sm font-medium leading-6 text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 sm:px-5">
                <div class="font-bold text-slate-900 dark:text-white">Recuperação de acesso</div>
                <p class="mt-2">Se você esquecer o PIN, tente o desbloqueio normal. Se não funcionar, a tela de bloqueio oferece a recuperação com Google para redefinir o acesso.</p>
              </div>
            </div>

            <div class="op-settings-security-passkey rounded-2xl border border-cyan-200/70 bg-cyan-50/80 px-4 py-4 shadow-sm dark:border-cyan-900/50 dark:bg-cyan-950/20 sm:px-5">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Desbloqueio no aparelho</div>
                    <span class="inline-flex items-center rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-bold text-cyan-700 dark:border-cyan-800 dark:bg-slate-900/70 dark:text-cyan-200"><%= appPasskeyCount %>/<%= appPasskeyMaxCount || 6 %> aparelhos</span>
                  </div>
                  <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Se o aparelho permitir, você pode usar digital, rosto ou a proteção nativa para abrir o app. O PIN continua como alternativa.</p>
                </div>
                <% if (appPasskeyState.canRegister) { %>
                  <button type="button" id="appPasskeyRegisterButton" class="inline-flex w-full items-center justify-center rounded-2xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-cyan-500/20 transition-all hover:-translate-y-0.5 hover:bg-cyan-700 sm:w-auto sm:shrink-0">Adicionar neste aparelho</button>
                <% } else if (appPasskeyState.limitReached) { %>
                  <div class="inline-flex items-center rounded-2xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-amber-700 dark:border-amber-800 dark:bg-slate-900/70 dark:text-amber-200 sm:shrink-0">Você já chegou no limite de aparelhos por aqui.</div>
                <% } %>
              </div>

              <p id="appPasskeyFeedback" class="mt-3 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= appPasskeyState.helpText || 'Quando quiser, você pode preparar este aparelho para destravar o app com a proteção nativa do dispositivo.' %></p>

              <% if (appPasskeyItems.length) { %>
                <div class="mt-4 grid gap-3 lg:grid-cols-2">
                  <% appPasskeyItems.forEach((item) => { %>
                    <div class="h-full rounded-xl border border-white/80 bg-white/90 px-4 py-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/70">
                      <div class="flex h-full flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <div class="truncate text-sm font-bold text-slate-900 dark:text-white"><%= item.label %></div>
                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= item.badgeTone === 'emerald' ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200' : 'border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300' %>"><%= item.badgeLabel %></span>
                          </div>
                          <div class="mt-2 grid gap-1 text-xs font-semibold leading-5 text-slate-500 dark:text-slate-400 sm:grid-cols-2">
                            <p>Preparado em <strong class="font-semibold text-slate-700 dark:text-slate-200"><%= item.createdAtLabel || 'agora há pouco' %></strong></p>
                            <p><%= item.hasBeenUsed ? 'Último uso em' : 'Ainda não foi usado para destravar' %> <strong class="font-semibold text-slate-700 dark:text-slate-200"><%= item.hasBeenUsed ? item.lastUsedAtLabel : '—' %></strong></p>
                          </div>
                        </div>
                        <form method="post" action="/people/security/passkeys/<%= item.id %>/delete" data-confirm-prompt="Remover <%= item.label %> da lista de desbloqueio? O PIN continua funcionando normalmente." class="sm:shrink-0">
                          <input type="hidden" name="return_to" value="/settings#security">
                          <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-rose-200 bg-white px-4 py-3 text-sm font-bold text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20 sm:w-auto">Remover</button>
                        </form>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <div id="appPinManageModal" class="fixed inset-0 z-[130] hidden items-center justify-center overflow-y-auto p-4 sm:p-6" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="appPinManageTitle" aria-describedby="appPinManageHint appPinRulesHint">
          <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm" data-app-pin-close></div>
          <div class="relative my-auto w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-lg dark:border-slate-700 dark:bg-slate-900 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Segurança do app</div>
                <h4 id="appPinManageTitle" class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Criar PIN</h4>
                <p id="appPinManageHint" class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Escolha um PIN numérico para proteger a abertura do app.</p>
              </div>
              <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800" data-app-pin-close aria-label="Fechar">✕</button>
            </div>

            <p id="appPinRulesHint" class="mt-4 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-xs font-semibold leading-5 text-cyan-700 dark:border-cyan-900/60 dark:bg-cyan-950/20 dark:text-cyan-200">Para manter a proteção mais forte, combinações simples como 1234, 0000 ou sequências repetidas não são aceitas.</p>

            <form method="post" action="/people/security/pin/setup" class="mt-5 grid gap-4" id="appPinManageForm" autocomplete="off">
              <input type="hidden" name="return_to" value="/settings#security">
              <input type="hidden" name="mode" id="appPinManageMode" value="create">

              <div id="appPinCurrentGroup" class="hidden">
                <label class="block">
                  <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">PIN atual</span>
                  <div class="relative">
                    <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="current_pin" id="appPinCurrentInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-bold tracking-[0.12em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••">
                    <button type="button" data-app-pin-visibility-toggle data-target="appPinCurrentInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Ver</button>
                  </div>
                  <div class="mt-3" data-pin-slots data-input-id="appPinCurrentInput" data-max-length="<%= appPinMaxLength %>"></div>
                </label>
              </div>

              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Novo PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="pin" id="appPinNewInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-bold tracking-[0.12em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinNewInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinNewInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Confirmar PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="pin_confirm" id="appPinConfirmInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-bold tracking-[0.12em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinConfirmInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinConfirmInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Depois de quanto tempo travar de novo</span>
                <select name="pin_idle_seconds" id="appPinIdleSelect" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20">
                  <% appPinIdleOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= option.selected ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto" data-app-pin-close>Cancelar</button>
                <button type="submit" id="appPinManageSubmit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto">Salvar PIN</button>
              </div>
            </form>
          </div>
        </div>


        <div id="appPinIdleModal" class="fixed inset-0 z-[130] hidden items-center justify-center overflow-y-auto p-4 sm:p-6" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="appPinIdleTitle" aria-describedby="appPinIdleHint">
          <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm" data-app-pin-idle-close></div>
          <div class="relative my-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-5 shadow-lg dark:border-slate-700 dark:bg-slate-900 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-600 dark:text-slate-300">Tempo de bloqueio</div>
                <h4 id="appPinIdleTitle" class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Alterar tempo de bloqueio</h4>
                <p id="appPinIdleHint" class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Escolha o novo tempo e confirme o PIN atual para atualizar essa configuração.</p>
              </div>
              <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800" data-app-pin-idle-close aria-label="Fechar">✕</button>
            </div>

            <form method="post" action="/people/security/pin/idle" class="mt-5 grid gap-4" id="appPinIdleForm" autocomplete="off">
              <input type="hidden" name="return_to" value="/settings#security">
              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">PIN atual</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="current_pin" id="appPinIdleCurrentInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-bold tracking-[0.12em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinIdleCurrentInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinIdleCurrentInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Depois de quanto tempo travar de novo</span>
                <select name="pin_idle_seconds" id="appPinIdleManageSelect" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20">
                  <% appPinIdleOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= option.selected ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto" data-app-pin-idle-close>Cancelar</button>
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto">Atualizar tempo</button>
              </div>
            </form>
          </div>
        </div>

        <div id="appPinDisableModal" class="fixed inset-0 z-[130] hidden items-center justify-center overflow-y-auto p-4 sm:p-6" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="appPinDisableTitle" aria-describedby="appPinDisableHint">
          <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm" data-app-pin-disable-close></div>
          <div class="relative my-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-5 shadow-lg dark:border-slate-700 dark:bg-slate-900 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-rose-600 dark:text-rose-300">Desligar PIN</div>
                <h4 id="appPinDisableTitle" class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Remover proteção por PIN?</h4>
                <p id="appPinDisableHint" class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Para confirmar, informe o PIN atual. Assim o app remove essa camada sem alterar sua conta Google.</p>
              </div>
              <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800" data-app-pin-disable-close aria-label="Fechar">✕</button>
            </div>

            <form method="post" action="/people/security/pin/disable" class="mt-5 grid gap-4" id="appPinDisableForm" autocomplete="off">
              <input type="hidden" name="return_to" value="/settings#security">
              <label class="block">
                <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">PIN atual</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="current_pin" id="appPinDisableInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-bold tracking-[0.12em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinDisableInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinDisableInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto" data-app-pin-disable-close>Cancelar</button>
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-rose-200 bg-rose-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-rose-500/20 transition-all hover:-translate-y-0.5 hover:bg-rose-700 sm:w-auto">Desligar PIN</button>
              </div>
            </form>
          </div>
        </div>
    </section>

    </section>
