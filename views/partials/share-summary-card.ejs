<%
  const safeHeroText = typeof heroText !== 'undefined'
    ? heroText
    : 'Confira abaixo os lançamentos deste período e o valor total para conferência e pagamento.';
  const safePeriodLabelText = typeof periodLabelText !== 'undefined' ? periodLabelText : 'Período';
  const safePaymentTitle = typeof paymentTitle !== 'undefined' ? paymentTitle : 'Situação do pagamento';
  const safeTotalLabel = typeof totalLabel !== 'undefined' ? totalLabel : 'Total do período';
  const safeListTitle = typeof listTitle !== 'undefined' ? listTitle : 'Lançamentos do período';
  const safeFooterLeft = typeof footerLeft !== 'undefined' ? footerLeft : 'Gerado pelo OrganizaPay';
  const safeFooterRight = typeof footerRight !== 'undefined' ? footerRight : 'Imagem pronta para compartilhar';
  const safeCaptureScale = typeof captureScale !== 'undefined' ? captureScale : 2;
  const numericTotalCents = Number(totalCents || 0) || 0;
  const safePaidCents = Number(typeof paidCents !== 'undefined' ? paidCents : 0) || 0;
  const safeRemainingCents = Number(
    typeof remainingCents !== 'undefined'
      ? remainingCents
      : Math.max(0, numericTotalCents - safePaidCents)
  ) || 0;
  const safeCardTotals = (typeof cardTotals !== 'undefined' && Array.isArray(cardTotals)) ? cardTotals : [];
  const paymentStatusText = safeRemainingCents === 0 && numericTotalCents > 0
    ? 'Quitado'
    : safePaidCents > 0
      ? 'Pagamento parcial'
      : 'Pagamento ainda não informado';
  const paymentMetrics = safePaidCents > 0
    ? [
        { label: 'Já pago', value: formatBRL(safePaidCents) },
        { label: safeRemainingCents > 0 ? 'Falta pagar' : 'Situação', value: safeRemainingCents > 0 ? formatBRL(safeRemainingCents) : 'Quitado' }
      ]
    : [
        { label: 'Situação', value: 'Aguardando pagamento' }
      ];
%>

<div
  id="<%= cardId %>"
  class="share-summary-card mx-auto w-full max-w-[47.5rem] overflow-hidden rounded-[32px] border border-white/80 bg-white text-slate-900 shadow-[0_34px_78px_rgba(15,23,42,0.18)]"
  data-capture-width="760"
  <%= exportMode ? `data-capture-scale="${safeCaptureScale}"` : '' %>
>
  <div class="relative overflow-hidden px-5 pb-5 pt-6 sm:px-7">
    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-blue-100"></div>
    <div class="absolute -left-14 bottom-0 h-24 w-24 rounded-full bg-emerald-50"></div>

    <div class="relative z-10 flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
      <div class="min-w-0">
        <div class="share-summary-card__brand">
          <img src="/icon-192.png" alt="OrganizaPay" class="share-summary-card__brand-logo">
          <div class="min-w-0">
            <div class="share-summary-card__brand-title">OrganizaPay</div>
            <div class="share-summary-card__brand-subtitle">Resumo financeiro para envio</div>
          </div>
        </div>
        <h2 class="mt-4 text-[28px] font-black leading-tight tracking-[-0.03em] text-slate-900"><%= person.name %></h2>
        <p class="mt-2 max-w-[34rem] text-sm font-medium leading-6 text-slate-500"><%= safeHeroText %></p>
      </div>
      <div class="share-summary-card__period">
        <div class="share-summary-card__period-label"><%= safePeriodLabelText %></div>
        <div class="mt-2 text-lg font-black tracking-[-0.03em]"><%= periodLabel %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 share-summary-card__summary-grid">
      <div class="share-summary-card__payment-shell">
        <div class="share-summary-card__section-label"><%= safePaymentTitle %></div>
        <div class="mt-3 inline-flex items-center rounded-full bg-slate-900/6 px-3 py-1.5 text-xs font-bold text-slate-600"><%= paymentStatusText %></div>
        <div class="mt-3 share-summary-card__metrics <%= paymentMetrics.length === 1 ? 'share-summary-card__metrics--single' : '' %>">
          <% paymentMetrics.forEach(metric => { %>
            <div class="share-summary-card__metric">
              <span class="share-summary-card__metric-label"><%= metric.label %></span>
              <span class="share-summary-card__metric-value"><%= metric.value %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="share-summary-card__total-shell">
        <div class="share-summary-card__total-label"><%= safeTotalLabel %></div>
        <div class="mt-2 share-summary-card__total-value"><%= formatBRL(numericTotalCents) %></div>
      </div>
    </div>

    <% if (safeCardTotals.length) { %>
      <div class="relative z-10 mt-5 rounded-[28px] border border-slate-200 bg-slate-50/88 px-4 py-4 sm:px-5">
        <div class="share-summary-card__section-label">Resumo por cartão</div>
        <div class="mt-3 share-summary-card__cards-grid">
          <% safeCardTotals.forEach(card => { %>
            <div class="share-summary-card__card-total">
              <div class="share-summary-card__card-name"><%= card.card_name || 'Sem cartão' %></div>
              <div class="share-summary-card__card-value"><%= formatBRL(Number(card.total_cents || 0)) %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="relative z-10 mt-5 rounded-[28px] border border-slate-200 bg-slate-50/85 px-4 py-4 sm:px-5">
      <div class="share-summary-card__list-head">
        <div>
          <div class="share-summary-card__section-label"><%= safeListTitle %></div>
          <div class="mt-1 text-sm font-bold text-slate-700"><%= visibleItems.length %> item(ns) exibido(s)</div>
        </div>
        <span class="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-slate-600 shadow-sm">Lista completa do período</span>
      </div>

      <div class="mt-3 space-y-2.5">
        <% visibleItems.forEach(item => { %>
          <% const dateLabel = itemDate(item); %>
          <% const cardName = (item && (item.card_name || item.cardName || item.card_label || item.cardLabel || item.card)) || 'Sem cartão'; %>
          <div class="share-summary-card__item">
            <div class="share-summary-card__item-date"><%= dateLabel || 'Sem data' %></div>
            <div class="min-w-0">
              <div class="share-summary-card__item-title"><%= getDescription(item) %></div>
            </div>
            <div class="share-summary-card__item-side">
              <div class="share-summary-card__item-value"><%= formatBRL(getItemCents(item)) %></div>
              <div class="share-summary-card__item-card" title="<%= cardName %>"><%= cardName %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="relative z-10 mt-4 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-slate-500">
      <span><%= safeFooterLeft %></span>
      <span><%= safeFooterRight %></span>
    </div>
  </div>
</div>
