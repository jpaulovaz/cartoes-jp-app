<div
  id="<%= cardId %>"
  class="share-summary-card mx-auto w-full max-w-[44rem] overflow-hidden rounded-[32px] border border-white/80 bg-white text-slate-900 shadow-[0_34px_78px_rgba(15,23,42,0.18)] <%= compactMode ? 'share-summary-card--compact' : '' %> <%= summaryMode ? 'share-summary-card--summary' : '' %>"
  <%= exportMode ? `data-capture-scale="${captureScale}"` : '' %>
>
  <div class="relative overflow-hidden px-5 pb-5 pt-6 sm:px-7">
    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-blue-100"></div>
    <div class="absolute -left-14 bottom-0 h-24 w-24 rounded-full bg-emerald-50"></div>

    <div class="relative z-10 flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
      <div class="min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.18em] text-blue-700">
          <img src="/logo.png" alt="OrganizaPay" class="h-4 w-auto object-contain">
          OrganizaPay
        </div>
        <h2 class="mt-4 text-[26px] font-black leading-tight tracking-[-0.03em] text-slate-900"><%= person.name %></h2>
        <p class="mt-2 max-w-[28rem] text-sm font-medium leading-6 text-slate-500"><%= heroText || 'Resumo financeiro pensado para leitura rápida no celular, com foco no total e nos itens mais importantes do período.' %></p>
      </div>
      <div class="min-w-[124px] rounded-[24px] bg-slate-900 px-4 py-3 text-right text-white shadow-[0_18px_38px_rgba(15,23,42,0.14)]">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-300"><%= periodLabelText || 'Período' %></div>
        <div class="mt-2 text-lg font-black tracking-[-0.03em]"><%= periodLabel %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
      <div class="rounded-[24px] border border-slate-200 bg-slate-50 px-4 py-4">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-400"><%= metricsTitle || 'Leitura rápida' %></div>
        <div class="mt-2 share-summary-card__metrics">
          <% (metricPills || [
            { label: 'Itens', value: `${items.length}` },
            { label: 'Modo', value: summaryMode ? 'Compacto' : 'Completo' }
          ]).forEach(metric => { %>
            <div class="share-summary-card__metric">
              <span class="share-summary-card__metric-label"><%= metric.label %></span>
              <span class="share-summary-card__metric-value"><%= metric.value %></span>
            </div>
          <% }) %>
        </div>
        <% if (compactHint) { %>
          <div class="mt-3 share-summary-card__legend"><%= compactHint %></div>
        <% } %>
      </div>
      <div class="rounded-[24px] bg-emerald-500 px-5 py-4 text-white shadow-[0_22px_42px_rgba(16,185,129,0.28)]">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-emerald-100"><%= totalLabel || 'Total do período' %></div>
        <div class="mt-2 text-[28px] font-black leading-none tracking-[-0.04em]"><%= formatBRL(totalCents) %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 rounded-[28px] border border-slate-200 bg-slate-50/85 px-4 py-4 sm:px-5">
      <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3">
        <div>
          <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-400"><%= listTitle || 'Itens do resumo' %></div>
          <div class="mt-1 text-sm font-bold text-slate-700"><%= summaryMode ? `${visibleItems.length} exibido(s) + resumo dos demais` : `${visibleItems.length} item(ns) exibido(s)` %></div>
        </div>
        <span class="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-slate-600 shadow-sm"><%= summaryMode ? `${hiddenItems.length} item(ns) resumido(s)` : 'Todos os itens visíveis' %></span>
      </div>

      <div class="mt-3 space-y-2.5">
        <% visibleItems.forEach(item => { %>
          <div class="share-summary-card__item grid grid-cols-[1fr_auto] gap-3 rounded-[22px] bg-white px-4 py-3 shadow-sm">
            <div class="min-w-0">
              <div class="share-summary-card__item-title truncate text-sm font-black text-slate-900"><%= getDescription(item) %></div>
              <% const dateLabel = itemDate(item); %>
              <div class="mt-1 text-xs font-semibold text-slate-500"><%= dateLabel || 'Sem data informada' %></div>
            </div>
            <div class="text-right">
              <div class="text-sm font-black text-slate-900"><%= formatBRL(getItemCents(item)) %></div>
              <div class="mt-1 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400"><%= itemValueLabel || 'Item' %></div>
            </div>
          </div>
        <% }) %>

        <% if (summaryMode) { %>
          <div class="grid grid-cols-[1fr_auto] gap-3 rounded-[22px] border border-dashed border-slate-300 bg-slate-100 px-4 py-3">
            <div class="min-w-0">
              <div class="text-sm font-black text-slate-900">+ <%= hiddenItems.length %> item(ns) adicional(is)</div>
              <div class="mt-1 text-xs font-semibold text-slate-500"><%= summaryText || 'Resumo automático ativado para deixar a imagem mais confortável em telas menores e no envio por mensageiros.' %></div>
            </div>
            <div class="text-right">
              <div class="text-sm font-black text-slate-900"><%= formatBRL(hiddenTotalCents) %></div>
              <div class="mt-1 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Resumo</div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="relative z-10 mt-4 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-slate-500">
      <span><%= footerLeft || 'Gerado pelo OrganizaPay · foco em leitura móvel' %></span>
      <span><%= footerRight || (summaryMode ? `Total completo considerado: ${items.length} item(ns)` : 'Imagem pronta para compartilhar') %></span>
    </div>
  </div>
</div>
