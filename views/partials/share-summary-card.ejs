<%
  const safeHeroText = typeof heroText !== 'undefined'
    ? heroText
    : 'Confira abaixo as compras deste período e o valor que ainda falta para fechar tudo.';
  const safePeriodLabelText = typeof periodLabelText !== 'undefined' ? periodLabelText : 'Período';
  const safePaymentTitle = typeof paymentTitle !== 'undefined' ? paymentTitle : 'Situação do pagamento';
  const safeTotalLabel = typeof totalLabel !== 'undefined' ? totalLabel : 'Total do período';
  const safeListTitle = typeof listTitle !== 'undefined' ? listTitle : 'Compras do período';
  const safeFooterLeft = typeof footerLeft !== 'undefined' ? footerLeft : 'Feito no OrganizaPay';
  const safeCaptureScale = typeof captureScale !== 'undefined' ? captureScale : 2;
  const safeSharePixContext = typeof sharePixContext !== 'undefined' ? sharePixContext : null;
  const numericTotalCents = Number(totalCents || 0) || 0;
  const paidValueCents = Number(typeof paidCents !== 'undefined' ? paidCents : 0) || 0;
  const rawBalanceCents = numericTotalCents - paidValueCents;
  const normalizedRemainingCents = Math.max(0, rawBalanceCents);
  const normalizedPaidCents = Math.max(0, paidValueCents);

  let paymentStatusText = 'Pagamento ainda não informado';
  if (numericTotalCents > 0 && rawBalanceCents <= 0) {
    paymentStatusText = 'Quitado';
  } else if (normalizedPaidCents > 0) {
    paymentStatusText = 'Pagamento parcial';
  }

  const paymentStatusClass = rawBalanceCents <= 0 && numericTotalCents > 0
    ? 'share-summary-card__status share-summary-card__status--success'
    : normalizedPaidCents > 0
      ? 'share-summary-card__status share-summary-card__status--warning'
      : 'share-summary-card__status share-summary-card__status--neutral';

  const paymentMetrics = [
    {
      label: 'Já pago',
      value: formatBRL(normalizedPaidCents),
      valueClass: normalizedPaidCents > 0
        ? 'share-summary-card__metric-value share-summary-card__metric-value--positive'
        : 'share-summary-card__metric-value'
    },
    {
      label: 'Falta pagar',
      value: formatBRL(normalizedRemainingCents),
      valueClass: normalizedRemainingCents > 0
        ? 'share-summary-card__metric-value share-summary-card__metric-value--danger'
        : 'share-summary-card__metric-value share-summary-card__metric-value--positive'
    }
  ];
%>

<div
  id="<%= cardId %>"
  class="share-summary-card <%= exportMode ? 'share-summary-card--export' : '' %> mx-auto w-full max-w-[54rem] overflow-hidden rounded-[30px] border border-white/80 bg-white text-slate-900 shadow-[0_28px_64px_rgba(15,23,42,0.14)]"
  data-capture-width="860"
  data-export-mode="<%= exportMode ? '1' : '0' %>"
  <%= exportMode ? `data-capture-scale="${safeCaptureScale}"` : '' %>
>
  <div class="relative overflow-hidden px-5 pb-5 pt-6 sm:px-7">
    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-blue-100"></div>
    <div class="absolute -left-14 bottom-0 h-24 w-24 rounded-full bg-emerald-50"></div>

    <div class="relative z-10 flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
      <div class="min-w-0">
        <div class="share-summary-card__brand">
          <img src="/icon-192.png" alt="OrganizaPay" class="share-summary-card__brand-logo">
          <div class="min-w-0">
            <div class="share-summary-card__brand-title">OrganizaPay</div>
            <div class="share-summary-card__brand-subtitle">Resumo financeiro</div>
          </div>
        </div>
        <h2 class="mt-4 text-[28px] font-black leading-tight tracking-[-0.03em] text-slate-900"><%= person.name %></h2>
        <p class="mt-2 max-w-[34rem] text-sm font-medium leading-6 text-slate-500"><%= safeHeroText %></p>
      </div>
      <div class="share-summary-card__period">
        <div class="share-summary-card__period-label"><%= safePeriodLabelText %></div>
        <div class="mt-2 text-lg font-black tracking-[-0.03em]"><%= periodLabel %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 share-summary-card__summary-grid">
      <div class="share-summary-card__payment-shell">
        <div class="share-summary-card__section-label"><%= safePaymentTitle %></div>
        <div class="mt-3 <%= paymentStatusClass %>"><%= paymentStatusText %></div>
        <div class="mt-3 share-summary-card__metrics">
          <% paymentMetrics.forEach(metric => { %>
            <div class="share-summary-card__metric">
              <span class="share-summary-card__metric-label"><%= metric.label %></span>
              <span class="<%= metric.valueClass %>"><%= metric.value %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="share-summary-card__total-shell">
        <div class="share-summary-card__total-label"><%= safeTotalLabel %></div>
        <div class="mt-2 share-summary-card__total-value"><%= formatBRL(numericTotalCents) %></div>
      </div>
    </div>

    <% if (safeSharePixContext && safeSharePixContext.available && normalizedRemainingCents > 0) { %>
      <div class="relative z-10 mt-5 share-summary-card__pix-shell">
        <div class="share-summary-card__pix-copy">
          <div class="share-summary-card__section-label">Pix desta vez</div>
          <div class="mt-2 share-summary-card__pix-amount"><%= formatBRL(Number(safeSharePixContext.amountCents || normalizedRemainingCents)) %></div>
          <p class="mt-2 share-summary-card__pix-text"><%= safeSharePixContext.helperText || 'No banco, é só escanear ou usar o código que segue no texto.' %></p>
          <div class="mt-3 share-summary-card__pix-chips">
            <% if (safeSharePixContext.keyTypeLabel) { %>
              <span class="share-summary-card__pix-chip"><%= safeSharePixContext.keyTypeLabel %></span>
            <% } %>
            <% if (safeSharePixContext.maskedKey) { %>
              <span class="share-summary-card__pix-chip"><%= safeSharePixContext.maskedKey %></span>
            <% } %>
            <% if (safeSharePixContext.ownerName) { %>
              <span class="share-summary-card__pix-chip">Recebe: <%= safeSharePixContext.ownerName %></span>
            <% } %>
          </div>
        </div>
        <div class="share-summary-card__pix-qr-shell">
          <% if (safeSharePixContext.qrDataUrl) { %>
            <img src="<%= safeSharePixContext.qrDataUrl %>" alt="QR Code Pix" class="share-summary-card__pix-qr-image">
          <% } else { %>
            <div class="share-summary-card__pix-qr-fallback">O QR não apareceu aqui, mas o código completo segue no texto.</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <div class="relative z-10 mt-5 rounded-[28px] border border-slate-200 bg-slate-50/88 px-4 py-4 sm:px-5">
      <div class="share-summary-card__list-head">
        <div>
          <div class="share-summary-card__section-label"><%= safeListTitle %></div>
          <div class="mt-1 text-sm font-bold text-slate-700"><%= visibleItems.length %> item(ns) exibido(s)</div>
        </div>
      </div>

      <div class="mt-3 space-y-2.5">
        <% visibleItems.forEach(item => { %>
          <% const dateLabel = itemDate(item); %>
          <% const cardName = (item && (item.card_name || item.cardName || item.card_label || item.cardLabel || item.card)) || 'Sem cartão'; %>
          <div class="share-summary-card__item">
            <div class="share-summary-card__item-date"><%= dateLabel || 'Sem data' %></div>
            <div class="min-w-0">
              <div class="share-summary-card__item-title"><%= getDescription(item) %></div>
            </div>
            <div class="share-summary-card__item-side">
              <div class="share-summary-card__item-value"><%= formatBRL(getItemCents(item)) %></div>
              <div class="share-summary-card__item-card" title="<%= cardName %>"><%= cardName %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="relative z-10 mt-4 text-xs font-bold text-slate-500">
      <span><%= safeFooterLeft %></span>
    </div>
  </div>
</div>
