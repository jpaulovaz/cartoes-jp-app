<%
  const safeHeroText = typeof heroText !== 'undefined' ? heroText : 'Resumo financeiro pensado para leitura rápida no celular, mantendo o total e todos os itens do período sempre visíveis.';
  const safePeriodLabelText = typeof periodLabelText !== 'undefined' ? periodLabelText : 'Período';
  const safeMetricsTitle = typeof metricsTitle !== 'undefined' ? metricsTitle : 'Leitura rápida';
  const safeMetricPills = (typeof metricPills !== 'undefined' && metricPills)
    ? metricPills
    : [
        { label: 'Itens', value: `${items.length}` },
        { label: 'Visual', value: compactMode ? 'Compacta' : 'Completa' }
      ];
  const safeCompactHint = typeof compactHint !== 'undefined' ? compactHint : '';
  const safeTotalLabel = typeof totalLabel !== 'undefined' ? totalLabel : 'Total do período';
  const safeListTitle = typeof listTitle !== 'undefined' ? listTitle : 'Itens do período';
  const safeItemValueLabel = typeof itemValueLabel !== 'undefined' ? itemValueLabel : 'Item';
  const safeSummaryText = typeof summaryText !== 'undefined'
    ? summaryText
    : ''; // mantido apenas por compatibilidade com includes antigos
  const safeFooterLeft = typeof footerLeft !== 'undefined' ? footerLeft : 'Gerado pelo OrganizaPay · foco em leitura móvel';
  const safeFooterRight = typeof footerRight !== 'undefined'
    ? footerRight
    : 'Imagem pronta para compartilhar';
  const safeCaptureScale = typeof captureScale !== 'undefined' ? captureScale : 2;
%>

<div
  id="<%= cardId %>"
  class="share-summary-card mx-auto w-full max-w-[44rem] overflow-hidden rounded-[32px] border border-white/80 bg-white text-slate-900 shadow-[0_34px_78px_rgba(15,23,42,0.18)] <%= compactMode ? 'share-summary-card--compact' : '' %> <%= summaryMode ? 'share-summary-card--summary' : '' %>"
  <%= exportMode ? `data-capture-scale="${safeCaptureScale}"` : '' %>
>
  <div class="relative overflow-hidden px-5 pb-5 pt-6 sm:px-7">
    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-blue-100"></div>
    <div class="absolute -left-14 bottom-0 h-24 w-24 rounded-full bg-emerald-50"></div>

    <div class="relative z-10 flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
      <div class="min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.18em] text-blue-700">
          <img src="/logo.png" alt="OrganizaPay" class="h-4 w-auto object-contain">
          OrganizaPay
        </div>
        <h2 class="mt-4 text-[26px] font-black leading-tight tracking-[-0.03em] text-slate-900"><%= person.name %></h2>
        <p class="mt-2 max-w-[28rem] text-sm font-medium leading-6 text-slate-500"><%= safeHeroText %></p>
      </div>
      <div class="min-w-[124px] rounded-[24px] bg-slate-900 px-4 py-3 text-right text-white shadow-[0_18px_38px_rgba(15,23,42,0.14)]">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-300"><%= safePeriodLabelText %></div>
        <div class="mt-2 text-lg font-black tracking-[-0.03em]"><%= periodLabel %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
      <div class="rounded-[24px] border border-slate-200 bg-slate-50 px-4 py-4">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-400"><%= safeMetricsTitle %></div>
        <div class="mt-2 share-summary-card__metrics">
          <% safeMetricPills.forEach(metric => { %>
            <div class="share-summary-card__metric">
              <span class="share-summary-card__metric-label"><%= metric.label %></span>
              <span class="share-summary-card__metric-value"><%= metric.value %></span>
            </div>
          <% }) %>
        </div>
        <% if (safeCompactHint) { %>
          <div class="mt-3 share-summary-card__legend"><%= safeCompactHint %></div>
        <% } %>
      </div>
      <div class="rounded-[24px] bg-emerald-500 px-5 py-4 text-white shadow-[0_22px_42px_rgba(16,185,129,0.28)]">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-emerald-100"><%= safeTotalLabel %></div>
        <div class="mt-2 text-[28px] font-black leading-none tracking-[-0.04em]"><%= formatBRL(totalCents) %></div>
      </div>
    </div>

    <div class="relative z-10 mt-5 rounded-[28px] border border-slate-200 bg-slate-50/85 px-4 py-4 sm:px-5">
      <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3">
        <div>
          <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-400"><%= safeListTitle %></div>
          <div class="mt-1 text-sm font-bold text-slate-700"><%= visibleItems.length %> item(ns) exibido(s)</div>
        </div>
        <span class="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-slate-600 shadow-sm">Todos os itens visíveis</span>
      </div>

      <div class="mt-3 space-y-2.5">
        <% visibleItems.forEach(item => { %>
          <div class="share-summary-card__item grid grid-cols-[1fr_auto] gap-3 rounded-[22px] bg-white px-4 py-3 shadow-sm">
            <div class="min-w-0">
              <div class="share-summary-card__item-title break-words text-sm font-black text-slate-900"><%= getDescription(item) %></div>
              <% const dateLabel = itemDate(item); %>
              <div class="mt-1 text-xs font-semibold text-slate-500"><%= dateLabel || 'Sem data informada' %></div>
            </div>
            <div class="text-right">
              <div class="text-sm font-black text-slate-900"><%= formatBRL(getItemCents(item)) %></div>
              <div class="mt-1 max-w-[152px] truncate text-[11px] font-bold text-slate-400" title="<%= (item && (item.card_name || item.cardName || item.card_label || item.cardLabel || item.card)) || 'Sem cartão' %>"><%= (item && (item.card_name || item.cardName || item.card_label || item.cardLabel || item.card)) || 'Sem cartão' %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="relative z-10 mt-4 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-slate-500">
      <span><%= safeFooterLeft %></span>
      <span><%= safeFooterRight %></span>
    </div>
  </div>
</div>
