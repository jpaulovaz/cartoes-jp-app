<%- include("partials/header", { title: title || `AcerttaPay | Compras com ${contact && contact.name ? contact.name : 'amizade'}` }) %>

<%
  const contactPerson = contact || person || {};
  const safeOutgoingRows = Array.isArray(outgoingRows) ? outgoingRows : [];
  const safeIncomingOpenItems = Array.isArray(incomingOpenItems) ? incomingOpenItems : [];
  const safeIncomingHistoryItems = Array.isArray(incomingHistoryItems) ? incomingHistoryItems : [];
  const safeIncomingItems = safeIncomingOpenItems.concat(safeIncomingHistoryItems).sort((a, b) => {
    const aDate = new Date(a.source_txn_date || a.created_at || a.updated_at || 0).getTime() || 0;
    const bDate = new Date(b.source_txn_date || b.created_at || b.updated_at || 0).getTime() || 0;
    return bDate - aDate;
  });
  const safeSummary = summary || {};
  const safeFilters = comprasFilters || filters || {};
  const activeStatusFilter = String(safeFilters.status || 'all').trim().toLowerCase();
  const searchValue = String(safeFilters.q || '').trim();
  const monthText = typeof monthLabel === 'function' ? monthLabel(month, year) : `${String(month).padStart(2, '0')}/${year}`;
  const monthChipText = `${String(month).padStart(2, '0')} / ${year}`;
  const pageBasePath = `/people/${contactPerson.id}/compras-comigo/${year}/${month}`;
  const createChargeAction = `${pageBasePath}/create-charge`;
  const statusOptions = [
    { value: 'all', label: 'Todos os status' },
    { value: 'chargeable', label: 'Sem cobrança' },
    { value: 'draft', label: 'Na caixa de saída' },
    { value: 'sent', label: 'Enviadas ou aceitas' },
    { value: 'done', label: 'Concluídas' }
  ];

  function chipClass(extra) {
    return `inline-flex max-w-full items-center justify-center rounded-full border px-2.5 py-1 text-center text-[11px] font-bold leading-none whitespace-nowrap ${extra || 'border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-200'}`;
  }

  function shortDate(value) {
    return value ? formatDateBR(value) : monthText;
  }

  function incomingDateLabel(item) {
    return item.sourceDateLabel || (item.source_txn_date ? formatDateBR(item.source_txn_date) : (item.created_at ? formatDateBR(item.created_at) : monthText));
  }

  function incomingCardLabel(item) {
    if (item.request_kind === 'manual' || item.isManual) return 'Avulsa';
    return item.card_name_snapshot || 'Cartão';
  }

  function incomingValue(item) {
    return Number(item.total_cents || item.amount_cents || 0);
  }

  function statusFilterSelected(value) {
    return activeStatusFilter === value ? 'selected' : '';
  }
%>

<div class="op-screen op-screen--month mx-auto max-w-7xl space-y-6 pb-24">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Compras com amigo</span>
      <h1 class="op-page-hero__title mt-4">Compras com <%= contactPerson.name || 'essa pessoa' %></h1>
      <p class="op-page-hero__subtitle mt-3">Veja o que vocês dividiram em <%= monthText %> e crie cobranças que ainda não estão na caixa de saída.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= monthText %></span>
        <span class="badge"><%= safeOutgoingRows.length %> que você marcou</span>
        <span class="badge"><%= safeIncomingItems.length %> recebida(s)</span>
        <% if ((safeSummary.chargeableCount || 0) > 0) { %>
          <span class="badge"><%= safeSummary.chargeableCount %> para cobrar</span>
        <% } %>
      </div>
    </div>

    <div class="op-page-hero__actions w-full lg:max-w-[32rem]">
      <a href="<%= backHref || '/people#network-lounge' %>" class="op-btn op-hero-link op-hero-link--network op-btn--block">← Voltar para Minha Rede</a>
      <a href="<%= sharedDebtsHref || '/shared-debts' %>" class="op-btn op-hero-link op-hero-link--debts op-btn--block">Abrir Central de Acertos</a>

      <div class="w-full flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 p-1 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/70">
        <a href="<%= previousMonthHref %>" class="op-btn op-btn-ghost flex-1">← Anterior</a>
        <span class="op-btn op-hero-link op-hero-link--month pointer-events-none shrink-0 whitespace-nowrap px-4" aria-current="page"><%= monthChipText %></span>
        <a href="<%= nextMonthHref %>" class="op-btn op-btn-ghost flex-1">Próximo →</a>
      </div>

      <% if (!isCurrentMonth) { %>
        <div class="flex w-full justify-end">
          <a href="<%= currentMonthHref %>" class="inline-flex items-center rounded-full border border-slate-200 bg-white/80 px-3 py-1.5 text-xs font-bold text-slate-600 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300 dark:hover:bg-slate-800">Ir para o mês atual</a>
        </div>
      <% } %>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Eu marquei</div>
      <div class="mt-2 text-2xl font-bold text-slate-900 dark:text-white"><%= formatBRLFromCents(safeSummary.outgoingMarkedCents || 0) %></div>
      <p class="mt-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Parte de <%= contactPerson.name || 'essa pessoa' %> nas compras do mês.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Para criar cobrança</div>
      <div class="mt-2 text-2xl font-bold text-slate-900 dark:text-white"><%= safeSummary.chargeableCount || 0 %></div>
      <p class="mt-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Itens sem cobrança ativa ou rascunho.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Recebidas</div>
      <div class="mt-2 text-2xl font-bold text-slate-900 dark:text-white"><%= formatBRLFromCents(safeSummary.incomingOpenAmountCents || 0) %></div>
      <p class="mt-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Valores em aberto que vieram dessa amizade.</p>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-5">
    <form method="GET" action="<%= pageBasePath %>" class="grid gap-3 md:grid-cols-[minmax(0,1fr)_16rem_auto_auto] md:items-end">
      <label class="block">
        <span class="mb-1 block text-xs font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Buscar</span>
        <input type="search" name="q" value="<%= searchValue %>" placeholder="Descrição, cartão, categoria ou status" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700 shadow-sm outline-none transition focus:border-cyan-300 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-cyan-900/30">
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Status</span>
        <select name="status" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700 shadow-sm outline-none transition focus:border-cyan-300 focus:ring-4 focus:ring-cyan-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-cyan-900/30">
          <% statusOptions.forEach((option) => { %>
            <option value="<%= option.value %>" <%= statusFilterSelected(option.value) %>><%= option.label %></option>
          <% }) %>
        </select>
      </label>
      <button type="submit" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">Filtrar</button>
      <a href="<%= clearFiltersHref || pageBasePath %>" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Limpar</a>
    </form>
  </section>

  <details id="outgoing" class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800" open>
    <summary class="flex cursor-pointer list-none flex-col gap-3 border-b border-slate-200 px-5 py-5 dark:border-slate-700 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Eu marquei para <%= contactPerson.name || 'essa pessoa' %></div>
        <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Compras que podem virar cobrança</h2>
        <p class="mt-1 text-sm font-semibold text-slate-500 dark:text-slate-400">Quando necessário, crie a cobrança e ela vai para a caixa de saída.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="badge"><%= safeOutgoingRows.length %> itens</span>
        <% if ((safeSummary.chargeableCount || 0) > 0) { %><span class="badge"><%= safeSummary.chargeableCount %> sem cobrança</span><% } %>
        <% if ((safeSummary.outgoingDraftCount || 0) > 0) { %><span class="badge"><%= safeSummary.outgoingDraftCount %> na caixa</span><% } %>
      </div>
    </summary>

    <% if (!safeOutgoingRows.length) { %>
      <div class="op-empty-state op-empty-state--compact m-5">
        
        <div class="op-empty-state__title">Nada marcado para essa pessoa em <%= monthText %></div>
        <p class="op-empty-state__text">Quando você dividir uma compra com <%= contactPerson.name || 'essa pessoa' %>, ela aparece aqui.</p>
      </div>
    <% } else { %>
      <div class="op-table-shell overflow-x-auto xl:overflow-x-visible">
        <table class="op-month-ledger-table block md:table min-w-full md:min-w-[86rem] xl:min-w-0 xl:w-full text-sm text-left">
          <thead class="hidden md:table-header-group bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="px-4 py-4">Data</th>
              <th class="px-4 py-4">Descrição</th>
              <th class="px-4 py-4 text-center">Categoria</th>
              <th class="px-4 py-4 text-center">Cartão</th>
              <th class="px-4 py-4 text-right">Parte da pessoa</th>
              <th class="px-4 py-4 text-center">Status</th>
              <th class="px-4 py-4 pr-8 text-left min-w-[16rem]">Ação</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            <% safeOutgoingRows.forEach((row) => { %>
              <tr class="op-month-row op-month-ledger-row block md:table-row mb-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-sm shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-800/60 md:mb-0 md:rounded-none md:border-b md:border-x-0 md:border-t-0 md:border-slate-100 md:bg-transparent md:p-0 md:shadow-none dark:md:border-slate-700 align-middle space-y-1 md:space-y-0">
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-semibold text-slate-600 dark:text-slate-300 whitespace-nowrap"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Data</span><span><%= row.dateLabel %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-bold text-slate-900 dark:text-white"><div class="flex items-start justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 pt-0.5">Descrição</span><span class="text-right md:text-left break-words"><%= row.description %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Categoria</span><span class="<%= chipClass('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200') %>"><%= row.categoryName %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Cartão</span><span class="<%= chipClass() %>"><%= row.cardName %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-right font-bold text-slate-900 dark:text-white"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Parte</span><span><%= row.shareFormatted %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center"><div class="flex items-center justify-between gap-3 md:justify-center"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Status</span><span class="<%= chipClass(row.statusMeta && row.statusMeta.classes) %>"><%= row.statusMeta && row.statusMeta.label ? row.statusMeta.label : 'Sem status' %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 pr-0 md:pr-8 py-3 md:py-3">
                  <% if (row.canCreateCharge) { %>
                    <form method="POST" action="<%= createChargeAction %>" class="inline-flex w-full md:w-auto" data-compras-comigo-create-form>
                      <input type="hidden" name="transaction_id" value="<%= row.transactionId %>">
                      <input type="hidden" name="scope" value="single" data-compras-comigo-scope-input>
                      <% if (row.hasFutureEligibleInstallments) { %>
                        <button type="button" class="inline-flex min-h-[44px] w-full items-center justify-center rounded-2xl bg-cyan-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-700 dark:bg-cyan-500 dark:hover:bg-cyan-400 md:w-auto" data-compras-comigo-create-charge data-has-future="1" data-future-count="<%= row.futureEligibleCount %>" data-future-total="<%= row.futureEligibleTotalFormatted %>" data-description="<%= row.description %>">Criar cobrança</button>
                      <% } else { %>
                        <button type="submit" class="inline-flex min-h-[44px] w-full items-center justify-center rounded-2xl bg-cyan-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-700 dark:bg-cyan-500 dark:hover:bg-cyan-400 md:w-auto">Criar cobrança</button>
                      <% } %>
                    </form>
                  <% } else if (row.actionHref) { %>
                    <a href="<%= row.actionHref %>" class="inline-flex min-h-[44px] w-full items-center justify-center whitespace-nowrap rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 md:w-auto"><%= row.statusMeta && row.statusMeta.key === 'draft' ? 'Ver caixa' : 'Ver acerto' %></a>
                  <% } else { %>
                    <span class="text-sm font-semibold text-slate-400 dark:text-slate-500">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </details>

  <details id="incoming" class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800" open>
    <summary class="flex cursor-pointer list-none flex-col gap-3 border-b border-slate-200 px-5 py-5 dark:border-slate-700 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-300">Recebidas de <%= contactPerson.name || 'essa pessoa' %></div>
        <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Compras que chegaram para você</h2>
        <p class="mt-1 text-sm font-semibold text-slate-500 dark:text-slate-400">Itens que essa amizade compartilhou com você nesta competência.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="badge"><%= safeIncomingItems.length %> itens</span>
        <% if ((safeSummary.incomingOpenAmountCents || 0) > 0) { %><span class="badge"><%= formatBRLFromCents(safeSummary.incomingOpenAmountCents || 0) %> em aberto</span><% } %>
      </div>
    </summary>

    <% if (!safeIncomingItems.length) { %>
      <div class="op-empty-state op-empty-state--compact m-5">
        
        <div class="op-empty-state__title">Nada recebido dessa amizade em <%= monthText %></div>
        <p class="op-empty-state__text">Quando <%= contactPerson.name || 'essa pessoa' %> dividir uma compra com você, ela aparece aqui.</p>
      </div>
    <% } else { %>
      <div class="op-table-shell overflow-x-auto xl:overflow-x-visible">
        <table class="op-month-ledger-table block md:table min-w-full md:min-w-[80rem] xl:min-w-0 xl:w-full text-sm text-left">
          <thead class="hidden md:table-header-group bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="px-4 py-4">Data</th>
              <th class="px-4 py-4">Descrição</th>
              <th class="px-4 py-4 text-center">Origem</th>
              <th class="px-4 py-4 text-right">Minha parte</th>
              <th class="px-4 py-4 text-center">Status</th>
              <th class="px-4 py-4 pr-8 text-left">Ação</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            <% safeIncomingItems.forEach((item) => { %>
              <% const itemHref = item.actionMeta && item.actionMeta.href ? item.actionMeta.href : `/shared-debts?request=${item.id}`; %>
              <tr class="op-month-row op-month-ledger-row block md:table-row mb-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-sm shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-800/60 md:mb-0 md:rounded-none md:border-b md:border-x-0 md:border-t-0 md:border-slate-100 md:bg-transparent md:p-0 md:shadow-none dark:md:border-slate-700 align-middle space-y-1 md:space-y-0">
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-semibold text-slate-600 dark:text-slate-300 whitespace-nowrap"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Data</span><span><%= incomingDateLabel(item) %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 font-bold text-slate-900 dark:text-white"><div class="flex items-start justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400 pt-0.5">Descrição</span><span class="text-right md:text-left break-words"><%= item.description_snapshot || 'Compra compartilhada' %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Origem</span><span class="<%= chipClass('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200') %>"><%= incomingCardLabel(item) %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-right font-bold text-slate-900 dark:text-white"><div class="flex items-center justify-between gap-3 md:block"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Minha parte</span><span><%= formatBRLFromCents(incomingValue(item)) %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 py-1.5 md:py-3 text-center"><div class="flex items-center justify-between gap-3 md:justify-center"><span class="md:hidden text-[11px] font-bold uppercase tracking-wide text-slate-400">Status</span><span class="<%= chipClass(item.statusMeta && item.statusMeta.classes) %>"><%= item.statusMeta && item.statusMeta.label ? item.statusMeta.label : 'Em aberto' %></span></div></td>
                <td class="block md:table-cell px-0 md:px-4 pr-0 md:pr-8 py-3 md:py-3"><a href="<%= itemHref %>" class="inline-flex min-h-[44px] w-full items-center justify-center whitespace-nowrap rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 md:w-auto">Ver acerto</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </details>
</div>

<%- include("partials/footer") %>
