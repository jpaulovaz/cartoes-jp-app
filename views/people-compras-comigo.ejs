<%- include("partials/header", { title: title || `AcerttaPay | Compras comigo` }) %>

<%
  const contactPerson = contact || person || {};
  const safeOpenItems = Array.isArray(openItems) ? openItems : [];
  const safeHistoryItems = Array.isArray(historyItems) ? historyItems : [];
  const safeSummary = summary || {};
  const isHistoryTab = String(activeTab || 'open') === 'history';
  const visibleItems = isHistoryTab ? safeHistoryItems : safeOpenItems;
  const monthText = typeof monthLabel === 'function' ? monthLabel(month, year) : `${String(month).padStart(2, '0')}/${year}`;
  const availableMonthEntries = Array.isArray(availableRanks) ? availableRanks
    .map((rank) => {
      const safeRank = Number(rank || 0);
      if (!safeRank) return null;
      const entryYear = Math.floor(safeRank / 100);
      const entryMonth = safeRank % 100;
      if (!entryMonth || !entryYear) return null;
      return {
        rank: safeRank,
        month: entryMonth,
        year: entryYear,
        label: typeof monthLabel === 'function' ? monthLabel(entryMonth, entryYear) : `${String(entryMonth).padStart(2, '0')}/${entryYear}`,
        href: `/people/${contactPerson.id}/compras-comigo/${entryYear}/${entryMonth}?tab=${isHistoryTab ? 'history' : 'open'}`
      };
    })
    .filter(Boolean)
    : [];

  function initials(name) {
    const parts = String(name || '').trim().split(/\s+/).filter(Boolean).slice(0, 2);
    return parts.length ? parts.map((part) => part.charAt(0).toUpperCase()).join('') : 'OP';
  }

  function participantAvatarUrl(personEntry) {
    if (personEntry && personEntry.photo_url) return String(personEntry.photo_url);
    if (personEntry && personEntry.linked_user_photo_url) return String(personEntry.linked_user_photo_url);
    return '';
  }

  function quickActionClasses(action) {
    const tone = String(action && action.tone ? action.tone : 'primary');
    if (tone === 'success') {
      return 'border border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-700 dark:border-emerald-500 dark:bg-emerald-500 dark:hover:bg-emerald-400';
    }
    if (tone === 'danger') {
      return 'border border-rose-200 bg-white text-rose-700 hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20';
    }
    return 'border border-violet-600 bg-violet-600 text-white hover:bg-violet-700 dark:border-violet-500 dark:bg-violet-500 dark:hover:bg-violet-400';
  }
%>

<div class="op-screen op-screen--month mx-auto max-w-7xl space-y-6 pb-24">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Amizade + competência mensal</span>
      <h1 class="op-page-hero__title mt-4">Compras comigo — <%= contactPerson.name || 'Amizade' %></h1>
      <p class="op-page-hero__subtitle mt-3">Aqui entram só as compras em que <%= contactPerson.name || 'essa pessoa' %> te envolveu, sem virar vitrine da vida financeira do outro lado.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= monthText %></span>
        <span class="badge"><%= formatBRLFromCents(safeSummary.openAmountCents || 0) %> em aberto</span>
        <span class="badge"><%= safeSummary.needsMyActionCount || 0 %> pedindo minha ação</span>
        <span class="badge"><%= safeSummary.waitingOtherSideCount || 0 %> aguardando o outro lado</span>
      </div>
    </div>

    <div class="op-page-hero__actions op-page-hero__actions--compact">
      <div class="op-month-hero-actions__row op-month-hero-actions__row--dual">
        <a href="<%= backHref || '/people' %>" class="op-btn op-btn-accent-soft op-btn--compact whitespace-nowrap">← Voltar para Amigos</a>
        <a href="<%= sharedDebtsHref || '/shared-debts' %>" class="op-btn op-btn-info op-btn--compact whitespace-nowrap">Abrir Cobranças</a>
      </div>

      <div class="op-month-hero-actions__row op-month-hero-actions__row--triple">
        <a href="<%= previousMonthHref %>" class="op-btn op-btn-accent-soft op-btn--compact whitespace-nowrap">← Mês anterior</a>
        <a href="<%= currentMonthHref %>" class="op-btn <%= isCurrentMonth ? 'op-btn-success' : 'op-btn-primary' %> op-btn--compact whitespace-nowrap"><%= isCurrentMonth ? 'Mês atual' : 'Ir para o atual' %></a>
        <a href="<%= nextMonthHref %>" class="op-btn op-btn-accent-soft op-btn--compact whitespace-nowrap">Mês seguinte →</a>
      </div>
    </div>
  </section>

  <div class="op-inline-alert op-inline-alert--info">
    <div class="op-inline-alert__icon">🔎</div>
    <div>
      <div class="op-inline-alert__title">Recorte bem comportado</div>
      <div class="op-inline-alert__text">Essa tela mostra só o que <strong><%= contactPerson.name || 'essa pessoa' %></strong> lançou para você. Nada de abrir compras em que você não entra na dança.</div>
    </div>
  </div>

  <section class="rounded-[28px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-center gap-4">
        <div class="relative h-14 w-14 shrink-0">
          <% if (participantAvatarUrl(contactPerson)) { %>
            <img src="<%= participantAvatarUrl(contactPerson) %>" alt="<%= contactPerson.name || 'Amizade' %>" loading="lazy" referrerpolicy="no-referrer" class="h-14 w-14 rounded-full object-cover ring-2 ring-slate-200 dark:ring-slate-700">
          <% } else { %>
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-lg font-black text-slate-600 dark:bg-slate-900 dark:text-slate-300"><%= initials(contactPerson.name) %></div>
          <% } %>
          <span class="absolute -bottom-1 -right-1 inline-flex h-7 w-7 items-center justify-center rounded-full border border-emerald-200 bg-emerald-500 text-[13px] text-white shadow-sm dark:border-emerald-700" title="Amizade ativa">🔗</span>
        </div>

        <div class="min-w-0">
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Leitura mensal da relação</p>
          <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white"><%= contactPerson.name || 'Amizade' %> · <%= monthText %></h2>
          <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">A navegação segue mês a mês, no mesmo espírito do /month, para ninguém se perder no meio das competências.</p>
        </div>
      </div>

      <% if (availableMonthEntries.length > 1) { %>
        <div class="flex flex-wrap gap-2 lg:max-w-[26rem] lg:justify-end">
          <% availableMonthEntries.slice(0, 6).forEach((entry) => { const activeEntry = Number(entry.month) === Number(month) && Number(entry.year) === Number(year); %>
            <a href="<%= entry.href %>" class="inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-bold transition-colors <%= activeEntry ? 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800' %>"><%= entry.label %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <div class="flex flex-wrap gap-3">
    <a href="<%= openTabHref %>" class="inline-flex items-center gap-2 rounded-2xl border px-4 py-2.5 text-sm font-black shadow-sm transition-colors <%= !isHistoryTab ? 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800' %>">
      Em aberto
      <span class="rounded-full px-2 py-0.5 text-[11px] <%= !isHistoryTab ? 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-200' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300' %>"><%= safeSummary.openCount || safeOpenItems.length %></span>
    </a>
    <a href="<%= historyTabHref %>" class="inline-flex items-center gap-2 rounded-2xl border px-4 py-2.5 text-sm font-black shadow-sm transition-colors <%= isHistoryTab ? 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800' %>">
      Histórico
      <span class="rounded-full px-2 py-0.5 text-[11px] <%= isHistoryTab ? 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-200' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-300' %>"><%= safeSummary.historyCount || safeHistoryItems.length %></span>
    </a>
  </div>

  <% if (!visibleItems.length) { %>
    <div class="op-empty-state">
      <div class="op-empty-state__icon"><%= isHistoryTab ? '🗂️' : '🧾' %></div>
      <div class="op-empty-state__title"><%= isHistoryTab ? `Nada no histórico de ${monthText}` : `Nada em aberto em ${monthText}` %></div>
      <p class="op-empty-state__text">
        <% if (isHistoryTab) { %>
          Quando alguma cobrança dessa amizade encerrar ou sair de cena nessa competência, ela aparece aqui sem bagunçar a fila principal.
        <% } else { %>
          Aqui entram só os itens que <%= contactPerson.name || 'essa pessoa' %> lançou para você nessa competência. Se tudo estiver quietinho, pode comemorar sem culpa.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="grid gap-4">
      <% visibleItems.forEach((item) => { %>
        <% const quickActions = Array.isArray(item.quickActions) ? item.quickActions : []; %>
        <% const requestHref = `/shared-debts?request=${item.id}`; %>
        <% const actionHref = item.actionMeta && item.actionMeta.href ? String(item.actionMeta.href) : requestHref; %>
        <% const actionLabel = actionHref === requestHref && quickActions.length ? 'Abrir conversa completa' : (item.actionMeta && item.actionMeta.label ? item.actionMeta.label : 'Abrir na cobrança'); %>
        <% const actionIsSettlementHref = actionHref.indexOf('?settlement=') !== -1; %>
        <% const quickActionHasSameHref = quickActions.some((action) => action && action.kind === 'link' && String(action.href || '') === actionHref); %>
        <article class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm transition-all dark:border-slate-700 dark:bg-slate-800 sm:p-6">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= item.isCard ? 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200' : 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200' %>"><%= item.isCard ? 'No cartão' : 'Avulsa' %></span>
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= item.statusMeta.classes %>"><%= item.statusMeta.label %></span>
                  </div>
                  <h3 class="mt-3 text-xl font-black text-slate-900 dark:text-white"><%= item.description_snapshot %></h3>
                  <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= item.detailLine %></p>
                </div>

                <div class="w-full shrink-0 rounded-[24px] border border-slate-200 bg-slate-50/90 px-4 py-3 text-left shadow-sm dark:border-slate-700 dark:bg-slate-900/70 lg:w-auto lg:min-w-[12rem] lg:text-right">
                  <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Minha parte</div>
                  <div class="mt-1 text-2xl font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(item.total_cents || 0) %></div>
                  <% if ((item.amount_paid_cents || 0) > 0 && !item.payment_marked_at) { %>
                    <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400"><%= formatBRLFromCents(item.amount_paid_cents || 0) %> já abatidos · <%= formatBRLFromCents(item.amount_pending_cents || 0) %> em aberto</div>
                  <% } else if (item.payment_marked_at && String(item.status || '') === 'accepted') { %>
                    <div class="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400">Pagamento já avisado por aqui</div>
                  <% } %>
                </div>
              </div>

              <div class="mt-4 rounded-[24px] border border-slate-200 bg-slate-50/80 px-4 py-3.5 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
                <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Leitura rápida</div>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= item.hint %></p>
                <% if (item.request_note) { %>
                  <div class="mt-3 rounded-2xl border border-dashed border-slate-200 bg-white/90 px-3 py-2.5 text-sm font-medium leading-6 text-slate-600 dark:border-slate-700 dark:bg-slate-950/40 dark:text-slate-300">
                    <span class="font-black text-slate-700 dark:text-slate-100">Recado:</span> <%= item.request_note %>
                  </div>
                <% } %>
              </div>

              <% if (item.metaRows && item.metaRows.length) { %>
                <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                  <% item.metaRows.forEach((meta) => { %>
                    <div class="rounded-[22px] border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
                      <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400"><%= meta.label %></div>
                      <div class="mt-1 text-sm font-semibold text-slate-800 dark:text-slate-100"><%= meta.value %></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <div class="flex shrink-0 flex-col gap-2 lg:w-[16rem]">
              <% if (quickActions.length) { %>
                <div class="grid gap-2 <%= quickActions.length > 1 ? 'sm:grid-cols-2 lg:grid-cols-1' : '' %>">
                  <% quickActions.forEach((action) => { %>
                    <% if (action.kind === 'form') { %>
                      <form method="POST" action="<%= action.action %>" <%= action.confirmPrompt ? `data-confirm-prompt="${action.confirmPrompt}"` : '' %>>
                        <% (action.fields || []).forEach((field) => { %>
                          <input type="hidden" name="<%= field.name %>" value="<%= field.value %>">
                        <% }) %>
                        <button type="submit" class="inline-flex min-h-[48px] w-full items-center justify-center rounded-2xl px-4 py-3 text-sm font-black shadow-sm transition-colors <%= quickActionClasses(action) %>"><%= action.label %></button>
                      </form>
                    <% } else { %>
                      <a href="<%= action.href %>" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl px-4 py-3 text-sm font-black shadow-sm transition-colors <%= quickActionClasses(action) %>"><%= action.label %></a>
                    <% } %>
                  <% }) %>
                </div>
              <% } %>

              <% if (!quickActionHasSameHref) { %>
                <a href="<%= actionHref %>" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl <%= quickActions.length ? 'border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800' : 'bg-violet-600 px-4 py-3 text-sm font-black text-white shadow-lg shadow-violet-500/20 hover:bg-violet-700 dark:bg-violet-500 dark:hover:bg-violet-400' %> transition-colors"><%= actionLabel %></a>
              <% } %>

              <% if (item.isCard && item.card_monthly_settlement_id && !actionIsSettlementHref) { %>
                <a href="/shared-debts?settlement=<%= item.card_monthly_settlement_id %>" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Abrir carteira do mês</a>
              <% } %>
              <% if (actionHref !== requestHref) { %>
                <a href="<%= requestHref %>" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Ver na cobrança</a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("partials/footer") %>
