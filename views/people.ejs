<%- include("partials/header", { title: "OrganizaPay | Amigos" }) %>

<%
  const pendingRequests = Array.isArray(pendingFriendRequests) ? pendingFriendRequests : [];
  const selfProfile = selfPerson || null;
  const contactList = Array.isArray(contacts) ? contacts : (Array.isArray(people) ? people : []);
  const activeFriendCount = contactList.filter(p => p && p.friendship_active).length;
  const discoverableCount = contactList.filter(p => p && p.has_app_user && !p.friendship_active).length;
  const pixStateList = Array.isArray(pixStateOptions) ? pixStateOptions : [];
  const getPixStateCode = (entry) => entry && typeof entry === 'object' ? String(entry.code || entry.sigla || '').trim() : String(entry || '').trim();
  const getPixStateName = (entry) => entry && typeof entry === 'object' ? String(entry.name || entry.nome || '').trim() : '';
  const getPixStateLabel = (entry) => {
    const code = getPixStateCode(entry);
    const name = getPixStateName(entry);
    if (code && name) return `${code} · ${name}`;
    return code || name || '';
  };
  const pixStateDefault = pixDefaultState || 'RJ';
  const pixCityDefault = pixDefaultCity || 'Rio de Janeiro';
  const selfName = selfProfile?.name || '';
  const selfPhone = selfProfile?.phone || '';
  const selfEmail = selfProfile?.email || '';
  const selfPixEnabled = !!selfProfile?.pix_enabled;
  const selfPixKeyType = selfProfile?.pix_key_type || '';
  const selfPixKeyValueInput = selfProfile?.pix_key_value_input || selfProfile?.pix_key_value || '';
  const selfPixState = selfProfile?.pix_state || pixStateDefault;
  const selfPixCity = selfProfile?.pix_city || pixCityDefault;
  const selfPixLabel = selfProfile?.pix_label || '';
  const getAvatarUrl = (person) => person && person.photo_url ? String(person.photo_url) : (person && person.linked_user_photo_url && person.friendship_active ? String(person.linked_user_photo_url) : '');
  const getAvatarInitials = (person) => {
    const source = String((person && person.name) || '').trim().split(/\s+/).filter(Boolean).slice(0, 2);
    return source.length ? source.map((part) => part.charAt(0).toUpperCase()).join('') : 'OP';
  };

  const renderPersonStatusChips = (person) => {
    const chips = [];
    const addChip = (classes, label) => {
      chips.push(`<span class="inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1 text-[11px] font-bold ${classes}">${label}</span>`);
    };

    if (person.is_self) {
      addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Seu perfil');
    }

    if (person.active) {
      addChip('border-green-200 bg-green-50 text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-200', 'Ativo');
    } else {
      addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Inativo');
    }

    if (!person.is_self && person.has_app_user) {
      addChip('border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200', 'Também usa o app');
      addChip('border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200', 'Pix no perfil da pessoa');
    }

    if (!person.email) {
      addChip('border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-200', 'Sem e-mail');
    }

    if (person.is_self) {
      if (person.pix_enabled && person.pix_valid) {
        addChip('border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200', 'Pix pronto');
      } else if (person.pix_enabled && !person.pix_valid) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pedindo ajuste');
      }
    }

    if (!person.is_self && person.friendship_active) {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Amizade ativa');
      if (person.can_share_charge) {
        addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'Cobrança automática liberada');
      } else if (!person.active) {
        addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Cobrança pausada');
      }
      if (person.linked_user_pix_ready) {
        addChip('border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200', 'Pix pronto do outro lado');
      } else if (person.linked_user_pix_enabled) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pedindo ajuste');
      } else if (person.has_app_user) {
        addChip('border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300', 'Pix ainda não pronto');
      }
    } else if (!person.is_self && person.friendship_state === 'pending_sent') {
      addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pedido enviado');
    } else if (!person.is_self && person.friendship_state === 'pending_received') {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Pedido recebido');
    }

    return chips.join('');
  };
%>

<div class="max-w-6xl mx-auto">
  <section class="op-page-hero op-fade-up mb-8">
    <div>
      <span class="op-page-hero__eyebrow">Seu perfil + sua rede</span>
      <h1 class="op-page-hero__title mt-4">Amigos</h1>
      <p class="op-page-hero__subtitle mt-3">Agora ficou cada um no seu quadrado bonitinho: seu perfil vive fixo aqui no app, a lista de baixo fica só para contatos, amizades e cobranças, e o Pix de cada pessoa mora no próprio perfil.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge">Seu perfil não disputa lugar com ninguém</span>
        <span class="badge">Cada um cuida do próprio Pix</span>
      </div>
    </div>

    <div class="op-kpi-strip xl:max-w-[32rem]">
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label">Seu perfil</div>
        <div class="op-kpi-card__value"><%= selfProfile ? 1 : 0 %></div>
        <div class="op-kpi-card__hint">sempre fixo na conta</div>
      </div>
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label">Na sua rede</div>
        <div class="op-kpi-card__value"><%= contactList.length %></div>
        <div class="op-kpi-card__hint">contato(s) salvos</div>
      </div>
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label text-emerald-600 dark:text-emerald-300">Amizades</div>
        <div class="op-kpi-card__value text-emerald-700 dark:text-emerald-200"><%= activeFriendCount %></div>
        <div class="op-kpi-card__hint text-emerald-700/80 dark:text-emerald-200/80">vínculo(s) ativo(s)</div>
      </div>
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label text-sky-600 dark:text-sky-300"><%= pendingRequests.length ? 'Convites' : 'Também usam' %></div>
        <div class="op-kpi-card__value text-sky-700 dark:text-sky-200"><%= pendingRequests.length ? pendingRequests.length : discoverableCount %></div>
        <div class="op-kpi-card__hint text-sky-700/80 dark:text-sky-200/80"><%= pendingRequests.length ? 'te esperando' : 'já estão no app' %></div>
      </div>
    </div>
  </section>

  <% if (pendingRequests.length) { %>
    <section id="friend-requests" class="mb-8 op-surface-card rounded-3xl border border-emerald-200 bg-emerald-50/80 p-6 shadow-sm dark:border-emerald-900/60 dark:bg-emerald-950/20 sm:p-7">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">Convites que chegaram</div>
          <h2 class="mt-2 text-xl font-black text-slate-900 dark:text-white">Tem amizade batendo na porta</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Aceitando, vocês passam a poder trocar cobranças automáticas entre si. Recusando, fica tudo como está — sem climão e sem bagunça.</p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-white/90 px-4 py-3 text-sm font-semibold text-emerald-700 shadow-sm dark:border-emerald-900/70 dark:bg-slate-900/60 dark:text-emerald-200">
          <%= pendingRequests.length === 1 ? '1 pedido pendente' : `${pendingRequests.length} pedidos pendentes` %>
        </div>
      </div>

      <div class="mt-6 grid gap-4">
        <% pendingRequests.forEach((request) => {
             const isHighlighted = highlightedFriendRequestId && Number(highlightedFriendRequestId) === Number(request.id);
        %>
          <div id="friend-request-<%= request.id %>" class="rounded-[26px] border px-4 py-4 shadow-sm transition-all sm:px-5 <%= isHighlighted ? 'border-emerald-400 bg-white dark:border-emerald-500 dark:bg-slate-900 ring-2 ring-emerald-200 dark:ring-emerald-900/70' : 'border-emerald-200 bg-white/90 dark:border-slate-700 dark:bg-slate-900/70' %>">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-100 text-lg font-black text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-200">
                    <%= (request.requester_name || 'A').charAt(0).toUpperCase() %>
                  </span>
                  <div class="min-w-0">
                    <div class="text-lg font-black text-slate-900 dark:text-white"><%= request.requester_name || 'Usuário OrganizaPay' %></div>
                    <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Quer virar seu contato de confiança no app.</div>
                  </div>
                </div>
                <div class="mt-3 flex flex-wrap gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
                  <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">Também usa o app</span>
                  <% if (request.linked_person_name) { %>
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Já apareceu como <%= request.linked_person_name %></span>
                  <% } %>
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pedido pendente</span>
                </div>
              </div>
              <div class="grid gap-2 sm:min-w-[17rem] sm:grid-cols-2 lg:w-auto">
                <form method="post" action="/friend-requests/<%= request.id %>/respond">
                  <input type="hidden" name="action" value="accept">
                  <button type="submit" class="w-full rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-black text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">Aceitar</button>
                </form>
                <form method="post" action="/friend-requests/<%= request.id %>/respond">
                  <input type="hidden" name="action" value="reject">
                  <button type="submit" class="w-full rounded-2xl border border-rose-200 bg-white px-4 py-3 text-sm font-black text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">Recusar</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (selfProfile) { %>
    <section class="mb-8 op-surface-card rounded-3xl border border-amber-200 bg-white p-6 shadow-sm dark:border-amber-900/60 dark:bg-slate-800 sm:p-8">
      <div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-amber-600 dark:text-amber-300">Seu perfil</div>
          <h2 class="mt-2 text-xl font-black text-slate-900 dark:text-white">Aqui mora você</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Esse perfil é a base da sua conta. É daqui que saem o seu Pix, a autoatribuição das compras e a sua identidade nas cobranças.</p>
        </div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50/90 px-4 py-3 text-sm font-semibold text-amber-700 shadow-sm dark:border-amber-900 dark:bg-amber-900/20 dark:text-amber-200">
          Fixo por aqui. Sem troca de crachá.
        </div>
      </div>

      <div class="grid gap-6 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
          <div class="flex items-start gap-4">
            <div class="relative h-14 w-14 shrink-0">
              <% if (getAvatarUrl(selfProfile)) { %>
                <img src="<%= getAvatarUrl(selfProfile) %>" alt="<%= selfProfile.name %>" loading="lazy" referrerpolicy="no-referrer" class="h-14 w-14 rounded-full object-cover ring-2 ring-amber-200 dark:ring-amber-800/70">
              <% } else { %>
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 text-xl font-black text-amber-700 dark:bg-amber-900/30 dark:text-amber-200"><%= getAvatarInitials(selfProfile) %></div>
              <% } %>
              <span class="absolute -top-2 -right-2 text-xl drop-shadow-sm" title="Seu perfil">👑</span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-xl font-black text-slate-900 dark:text-white"><%= selfProfile.name %></div>
              <div class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400"><%= selfProfile.phone ? '📱 ' + selfProfile.phone : '📱 Telefone não informado' %></div>
              <div class="mt-1 break-all text-sm font-medium text-slate-500 dark:text-slate-400"><%= selfProfile.email ? '✉️ ' + selfProfile.email : '— E-mail não informado' %></div>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <%- renderPersonStatusChips(selfProfile) %>
          </div>

          <div class="mt-5 rounded-[24px] border border-violet-200/70 bg-violet-50/80 px-4 py-4 shadow-sm dark:border-violet-900/50 dark:bg-violet-950/20 sm:px-5">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-violet-600 shadow-sm ring-1 ring-violet-100 dark:bg-slate-800 dark:text-violet-300 dark:ring-violet-900/50" aria-hidden="true">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1zm7 4h.01"></path></svg>
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600/80 dark:text-violet-300/80">Pix por aqui</div>
                  <% if (selfProfile.pix_enabled && selfProfile.pix_valid) { %>
                    <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[11px] font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pronto para uso</span>
                  <% } else if (selfProfile.pix_enabled) { %>
                    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Falta um ajuste</span>
                  <% } else { %>
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">Ainda desligado</span>
                  <% } %>
                </div>
                <p class="mt-1 max-w-none text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
                  <% if (selfProfile.pix_enabled) { %>
                    <strong class="font-semibold text-slate-700 dark:text-slate-100"><%= (selfProfile.pix_key_type_label || 'Chave Pix') + ' · ' + (selfProfile.pix_masked_key || 'aguardando preenchimento') %></strong>.
                    <% if (selfProfile.pix_city) { %>
                      Cidade do Pix: <strong class="font-semibold text-slate-700 dark:text-slate-100"><%= selfProfile.pix_city %><%= selfProfile.pix_state ? ' / ' + selfProfile.pix_state : '' %></strong>.
                    <% } %>
                    Esse é o Pix que entra em cena quando você recebe cobranças por aqui.
                  <% } else { %>
                    Nenhuma chave salva por aqui ainda. Quando você ligar isso aqui, as cobranças já podem sair com o seu Pix sem correria depois.
                  <% } %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
        <section class="rounded-[28px] border border-sky-200 bg-sky-50/80 p-5 shadow-sm dark:border-sky-900/70 dark:bg-sky-950/20 sm:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Sua fotinha por aqui</div>
              <h3 class="mt-2 text-lg font-black text-slate-900 dark:text-white">Seu rosto no crachá do app</h3>
              <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Quando você coloca uma foto, ela aparece no topo do app e nas divisões de compra. Se não tiver foto, o ícone do OrganizaPay continua firme no cabeçalho.</p>
            </div>
            <div class="relative h-16 w-16 shrink-0">
              <% if (getAvatarUrl(selfProfile)) { %><img src="<%= getAvatarUrl(selfProfile) %>" alt="<%= selfProfile.name %>" loading="lazy" referrerpolicy="no-referrer" class="h-16 w-16 rounded-full object-cover ring-2 ring-sky-200 dark:ring-sky-800/70"><% } else { %><div class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-lg font-black text-sky-700 shadow-sm ring-1 ring-sky-100 dark:bg-slate-900 dark:text-sky-200 dark:ring-sky-900/60"><%= getAvatarInitials(selfProfile) %></div><% } %>
            </div>
          </div>
          <div id="profile-photo" class="mt-4 grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto] scroll-mt-28">
            <form method="post" action="/people/profile-photo" enctype="multipart/form-data" class="flex flex-col gap-3" id="profilePhotoForm">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <input id="profilePhotoInput" type="file" name="profile_photo" accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full rounded-2xl border border-sky-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm file:mr-3 file:rounded-xl file:border-0 file:bg-sky-100 file:px-3 file:py-2 file:font-bold file:text-sky-700 hover:file:bg-sky-200 dark:border-sky-900/70 dark:bg-slate-900 dark:text-slate-200 dark:file:bg-sky-900/40 dark:file:text-sky-200">
                <button id="profilePhotoSubmit" type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-sky-500/20 transition-all hover:-translate-y-0.5 hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-60">Salvar foto</button>
              </div>
              <div class="rounded-2xl border border-sky-200/80 bg-white/80 p-3 text-xs font-medium leading-5 text-slate-600 shadow-sm dark:border-sky-900/60 dark:bg-slate-900/70 dark:text-slate-300">
                Eu dou uma aparadinha antes de subir: deixo quadradinha, leve e pronta para rodar bonito no celular, PWA e desktop.
              </div>
              <div id="profilePhotoPreviewWrap" class="hidden items-center gap-3 rounded-2xl border border-sky-200/80 bg-sky-50/70 px-4 py-3 dark:border-sky-900/60 dark:bg-sky-950/20">
                <img id="profilePhotoPreview" alt="Prévia da sua foto" class="h-14 w-14 rounded-full object-cover ring-2 ring-sky-200 dark:ring-sky-800/70">
                <div class="min-w-0 flex-1">
                  <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Prévia da fotinha</div>
                  <p id="profilePhotoHint" class="mt-1 text-sm font-medium leading-5 text-slate-600 dark:text-slate-300">Assim ela vai aparecer no app.</p>
                </div>
              </div>
            </form>
            <% if (selfProfile.photo_url) { %>
              <form method="post" action="/people/profile-photo/remove">
                <button type="submit" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Tirar foto daqui</button>
              </form>
            <% } %>
          </div>
        </section>

        <form method="post" action="/people" class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 sm:p-6">
          <input type="hidden" name="id" id="selfPersonId" value="<%= selfProfile.id %>">
          <div class="grid gap-4">
            <div>
              <label class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Como você aparece</label>
              <input name="name" id="selfName" value="<%- selfName %>" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="Seu nome no app" required>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
              <div>
                <label class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Telefone</label>
                <input name="phone" id="selfPhone" value="<%- selfPhone %>" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="(21) 99999-9999">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">E-mail visível</label>
                <input name="email" id="selfEmail" type="email" value="<%- selfEmail %>" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="email@exemplo.com">
              </div>
            </div>

            <div class="rounded-[24px] border border-violet-200 bg-violet-50/70 px-4 py-4 shadow-sm dark:border-violet-900/60 dark:bg-violet-950/20 sm:px-5">
              <div class="flex items-start gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-violet-600 shadow-sm ring-1 ring-violet-100 dark:bg-slate-800 dark:text-violet-300 dark:ring-violet-900/50" aria-hidden="true">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1zm7 4h.01"></path></svg>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600 dark:text-violet-300">Receber por Pix</div>
                  <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Quando você recebe uma cobrança, é esse Pix que entra em cena. Deixa pronto uma vez e pronto: menos correria, mais paz.</p>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center gap-3">
                <label class="inline-flex items-center gap-3 rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-bold text-violet-700 shadow-sm dark:border-violet-800 dark:bg-slate-900/70 dark:text-violet-200">
                  <input type="checkbox" name="pix_enabled" id="selfPixEnabled" value="1" class="h-4 w-4 rounded border-violet-300 text-violet-600 focus:ring-violet-500" <%= selfPixEnabled ? 'checked' : '' %>>
                  <span>Deixar Pix pronto</span>
                </label>
                <p class="text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">A chave fica mascaradinha na lista e só aparece inteira quando alguém realmente for copiar o Pix.</p>
              </div>

              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <label class="block">
                  <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Tipo da chave</span>
                  <select name="pix_key_type" id="selfPixKeyType" class="w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20">
                    <option value="">Escolha um tipo</option>
                    <option value="cpf" <%= selfPixKeyType === 'cpf' ? 'selected' : '' %>>CPF</option>
                    <option value="cnpj" <%= selfPixKeyType === 'cnpj' ? 'selected' : '' %>>CNPJ</option>
                    <option value="email" <%= selfPixKeyType === 'email' ? 'selected' : '' %>>E-mail</option>
                    <option value="phone" <%= selfPixKeyType === 'phone' ? 'selected' : '' %>>Celular</option>
                    <option value="evp" <%= selfPixKeyType === 'evp' ? 'selected' : '' %>>Chave aleatória</option>
                  </select>
                </label>
                <label class="block">
                  <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Chave Pix</span>
                  <input name="pix_key_value" id="selfPixKeyValue" value="<%- selfPixKeyValueInput %>" class="w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20" placeholder="Ex.: 21999999999" inputmode="text" autocomplete="off">
                  <p id="selfPixKeyHelp" class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Se for celular, pode mandar só DDD + número, com ou sem máscara. O +55 entra por nossa conta.</p>
                </label>
              </div>

              <div class="mt-4 grid gap-3 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)]">
                <label class="block">
                  <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Estado</span>
                  <select name="pix_state" id="selfPixState" class="w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20">
                    <% pixStateList.forEach((stateEntry) => { const stateCode = getPixStateCode(stateEntry); const stateLabel = getPixStateLabel(stateEntry); if (!stateCode) return; %>
                      <option value="<%= stateCode %>" <%= selfPixState === stateCode ? 'selected' : '' %>><%= stateLabel %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="block">
                  <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Cidade</span>
                  <input name="pix_city" id="selfPixCity" value="<%- selfPixCity %>" list="selfPixCitySuggestions" class="w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20" placeholder="Cidade do recebedor">
                  <datalist id="selfPixCitySuggestions"></datalist>
                </label>
              </div>

              <label class="mt-4 block">
                <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Nome que aparece no Pix</span>
                <input name="pix_label" id="selfPixLabel" value="<%- selfPixLabel %>" class="w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20" placeholder="Ex.: João - OrganizaPay">
              </label>
            </div>

            <div class="flex flex-wrap justify-end gap-3">
              <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400">Salvar meu perfil</button>
            </div>
          </div>
        </form>
      </div>
    </section>
  <% } %>

  <section class="mb-8 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 sm:p-8">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">Monte sua rede</div>
        <h2 class="mt-2 text-xl font-black text-slate-900 dark:text-white">Cadastre alguém novo</h2>
        <p class="mt-2 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Aqui entra só quem faz parte das suas divisões, amizades e cobranças. Seu perfil já está guardado no bloco de cima.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50/90 px-4 py-3 text-sm font-semibold text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">
        Contatos e amizades em um só lugar.
      </div>
    </div>

    <form method="post" action="/people" id="contactForm" class="flex flex-col gap-4 mb-8 pb-8 border-b border-slate-100 dark:border-slate-700">
      <div class="text-sm font-medium text-slate-500 dark:text-slate-400 -mb-1">O e-mail continua opcional. O Pix, agora, cada um cuida do seu: aqui você salva só o contato e o resto entra quando a amizade estiver ativa.</div>
      <input type="hidden" name="id" id="contactPersonId">

      <div class="w-full relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </div>
        <input name="name" id="contactName" class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium" placeholder="Nome do amigo ou contato" required>
      </div>

      <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto_auto] items-start">
        <div class="relative min-w-0">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <input name="phone" id="contactPhone" class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium" placeholder="(21) 99999-9999">
        </div>

        <div class="relative min-w-0">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m8-4H8m12 8H4a2 2 0 01-2-2V6a2 2 0 012-2h16a2 2 0 012 2v8a2 2 0 01-2 2z"></path></svg>
          </div>
          <input name="email" id="contactEmail" type="email" class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium" placeholder="email@exemplo.com">
        </div>

        <button type="submit" id="contactBtnSubmit" class="w-full md:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl font-bold text-white bg-slate-900 dark:bg-blue-600 hover:bg-slate-800 dark:hover:bg-blue-700 shadow-sm transition-all hover:-translate-y-0.5 whitespace-nowrap">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Salvar contato
        </button>
        <button type="button" id="contactBtnCancel" onclick="resetContactForm()" class="hidden w-full md:w-auto px-4 py-3 rounded-xl font-bold text-slate-500 bg-slate-100 hover:bg-slate-200 transition-all whitespace-nowrap">Cancelar</button>
      </div>

      <div class="rounded-[24px] border border-violet-200 bg-violet-50/70 px-4 py-4 shadow-sm dark:border-violet-900/60 dark:bg-violet-950/20 sm:px-5">
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-violet-600 shadow-sm ring-1 ring-violet-100 dark:bg-slate-800 dark:text-violet-300 dark:ring-violet-900/50" aria-hidden="true">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1zm7 4h.01"></path></svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600 dark:text-violet-300">Pix da outra pessoa</div>
            <p class="mt-1 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Você não precisa cadastrar a chave Pix de ninguém por aqui. Quando a amizade estiver ativa e rolar pagamento, o app usa o Pix que a própria pessoa deixou no perfil dela.</p>
          </div>
        </div>
      </div>
    </form>

    <div>
      <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Sua rede ativa</div>
          <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white">Amigos e contatos</h2>
        </div>
        <div class="text-sm font-semibold text-slate-500 dark:text-slate-400"><%= contactList.length === 1 ? '1 contato salvo' : `${contactList.length} contatos salvos` %></div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <% if (contactList.length) { %>
          <% contactList.forEach((p) => {
               const isHighlighted = highlightedFriendRequestId && Number(p.incoming_friend_request_id || 0) === Number(highlightedFriendRequestId);
               let personHintText = '';
               if (!p.email) {
                 personHintText = 'Quer descobrir se essa pessoa também usa o app? Um e-mail aqui já ajuda a abrir essa porta.';
               } else if (!p.has_app_user) {
                 personHintText = 'Por enquanto o app não achou uma conta OrganizaPay com esse e-mail. Se a pessoa entrar depois, o Pix continua sendo cadastrado por ela, no perfil dela.';
               } else if (p.friendship_active && !p.active) {
                 personHintText = 'A amizade segue ativa, mas este contato está inativo na sua lista. Novos envios automáticos ficam pausados até você reativar — e o Pix continua vindo do perfil dessa pessoa quando tudo voltar a rodar.';
               } else if (p.friendship_active && p.linked_user_pix_ready) {
                 personHintText = 'Vocês já estão conectados. Quando pintar pagamento, o app pega o Pix vivo dessa pessoa no perfil dela — se ela trocar por lá, aqui já acompanha sem drama.';
               } else if (p.friendship_active && p.linked_user_pix_enabled && !p.linked_user_pix_ready) {
                 personHintText = 'A amizade já está ativa, mas o Pix dessa pessoa ainda está pedindo um ajuste no próprio perfil. Quando ela fechar isso, as cobranças pegam a versão certa.';
               } else if (p.friendship_active) {
                 personHintText = 'A amizade já está ativa. Agora só falta essa pessoa deixar o Pix dela pronto no próprio perfil para os pagamentos ficarem redondinhos.';
               } else if (p.friendship_state === 'pending_sent') {
                 personHintText = 'O convite já foi enviado. Quando vier o joinha, o Pix passa a vir do perfil dessa pessoa automaticamente.';
               } else if (p.friendship_state === 'pending_received') {
                 personHintText = 'Essa pessoa já te chamou. É só aceitar aqui e pronto: amizade ativa, com autorização dos dois lados e cada um cuidando do próprio Pix.';
               } else if (!p.active) {
                 personHintText = 'Esse contato usa o app, mas está desativado na sua lista. Reative quando quiser colocar em jogo de novo.';
               } else {
                 personHintText = 'O app já reconheceu essa pessoa. Se fizer sentido, mande um pedido de amizade para liberar cobranças automáticas — e o Pix entra depois, vindo do perfil dela.';
               }
          %>
            <div class="group rounded-[28px] border p-5 transition-all bg-white dark:bg-slate-800 shadow-sm <%= isHighlighted ? 'border-emerald-400 dark:border-emerald-500 ring-2 ring-emerald-200 dark:ring-emerald-900/70' : 'border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-md' %>">
              <div class="flex flex-col gap-5">
                <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
                  <div class="flex min-w-0 flex-1 gap-4 xl:pr-4">
                    <div class="relative h-12 w-12 shrink-0">
                      <% if (getAvatarUrl(p)) { %><img src="<%= getAvatarUrl(p) %>" alt="<%= p.name %>" loading="lazy" referrerpolicy="no-referrer" class="h-12 w-12 rounded-full object-cover ring-2 ring-slate-200 dark:ring-slate-700"><% } else { %><div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-lg font-bold text-slate-600 transition-colors group-hover:bg-blue-50 group-hover:text-blue-600 dark:bg-slate-900 dark:text-slate-300 dark:group-hover:bg-blue-900/40"><%= getAvatarInitials(p) %></div><% } %>
                      <% if (p.friendship_active) { %>
                        <span class="absolute -bottom-1 -right-1 inline-flex h-6 w-6 items-center justify-center rounded-full border border-emerald-200 bg-emerald-500 text-[13px] text-white shadow-sm dark:border-emerald-700" title="Amizade ativa">🔗</span>
                      <% } %>
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <div class="text-lg font-extrabold text-slate-800 dark:text-white"><%= p.name %></div>
                        <button type="button"
                          data-id="<%= p.id %>"
                          data-name="<%= p.name %>"
                          data-phone="<%= p.phone || '' %>"
                          data-email="<%= p.email || '' %>"
                          onclick="editContactFromButton(this)"
                          class="text-slate-400 hover:text-blue-500 transition-colors"
                          aria-label="Editar contato"
                          title="Editar contato">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        </button>
                      </div>

                      <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400"><%= p.phone ? '📱 ' + p.phone : '📱 Telefone não informado' %></div>
                      <div class="mt-1 break-all text-xs font-medium text-slate-500 dark:text-slate-400"><%= p.email ? '✉️ ' + p.email : '— E-mail não informado' %></div>
                    </div>
                  </div>

                  <div class="flex w-full flex-col gap-2 xl:w-[15rem] xl:shrink-0">
                    <% if (p.friendship_state === 'active') { %>
                      <form method="post" action="/people/<%= p.id %>/unfriend" data-confirm-prompt="Desfazer amizade com <%= p.name %>? O histórico continua salvo, mas novos envios automáticos entre vocês param na hora.">
                        <button class="w-full rounded-2xl border border-rose-200 bg-white px-4 py-3 text-sm font-black text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">Desfazer amizade</button>
                      </form>
                    <% } else if (p.friendship_state === 'pending_sent') { %>
                      <form method="post" action="/friend-requests/<%= p.outgoing_friend_request_id %>/cancel">
                        <button class="w-full rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-black text-amber-700 transition-all hover:bg-amber-100 dark:border-amber-900 dark:bg-amber-900/20 dark:text-amber-200 dark:hover:bg-amber-900/35">Cancelar pedido</button>
                      </form>
                    <% } else if (p.friendship_state === 'pending_received') { %>
                      <form method="post" action="/friend-requests/<%= p.incoming_friend_request_id %>/respond">
                        <input type="hidden" name="action" value="accept">
                        <button class="w-full rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-black text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">Aceitar amizade</button>
                      </form>
                      <form method="post" action="/friend-requests/<%= p.incoming_friend_request_id %>/respond">
                        <input type="hidden" name="action" value="reject">
                        <button class="w-full rounded-2xl border border-rose-200 bg-white px-4 py-3 text-sm font-black text-rose-700 transition-all hover:bg-rose-50 dark:border-rose-900 dark:bg-slate-900 dark:text-rose-300 dark:hover:bg-rose-900/20">Recusar</button>
                      </form>
                    <% } else if (p.has_app_user && p.active) { %>
                      <form method="post" action="/people/<%= p.id %>/send-friend-request">
                        <button class="w-full rounded-2xl bg-sky-600 px-4 py-3 text-sm font-black text-white shadow-lg shadow-sky-500/20 transition-all hover:-translate-y-0.5 hover:bg-sky-700">Enviar pedido de amizade</button>
                      </form>
                    <% } else { %>
                      <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-3 text-center text-xs font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400">Convite indisponível</div>
                    <% } %>

                    <div class="grid gap-2 pt-1">
                      <form method="post" action="/people/<%= p.id %>/toggle">
                        <button class="w-full px-3 py-2.5 text-xs font-bold rounded-xl border <%= p.active ? 'border-red-200 dark:border-red-900 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20' : 'border-green-200 dark:border-green-900 text-green-700 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20' %> transition-colors bg-white dark:bg-slate-700 shadow-sm"><%= p.active ? 'Desativar' : 'Reativar' %></button>
                      </form>
                      <form method="post" action="/people/<%= p.id %>/delete" data-confirm-prompt="Excluir <%= p.name %> da sua lista ativa? O passado continua salvo, mas a exclusão trava se ainda houver valor em aberto, Pix do mês em andamento ou cobrança guardada para enviar depois." data-confirm-phrase="Eu confirmo">
                        <button class="w-full px-3 py-2.5 text-xs font-bold rounded-xl border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors bg-white dark:bg-slate-700 shadow-sm">Excluir da lista</button>
                      </form>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-3">
                  <div class="flex flex-wrap items-center gap-2"><%- renderPersonStatusChips(p) %></div>

                  <div class="w-full rounded-[24px] border border-violet-200/70 bg-violet-50/80 px-4 py-4 shadow-sm dark:border-violet-900/50 dark:bg-violet-950/20 sm:px-5">
                    <div class="flex items-start gap-3">
                      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-violet-600 shadow-sm ring-1 ring-violet-100 dark:bg-slate-800 dark:text-violet-300 dark:ring-violet-900/50" aria-hidden="true"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1zm7 4h.01"></path></svg></span>
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600/80 dark:text-violet-300/80">Pix nas cobranças</div>
                          <% if (p.friendship_active && p.linked_user_pix_ready) { %>
                            <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-[11px] font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pronto quando pintar cobrança</span>
                          <% } else if (p.friendship_active && p.linked_user_pix_enabled) { %>
                            <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Falta um ajuste</span>
                          <% } else if (p.friendship_active && p.has_app_user) { %>
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">Ainda não deixou pronto</span>
                          <% } else if (p.has_app_user) { %>
                            <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-bold text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">Entra depois da amizade</span>
                          <% } else { %>
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">Contato local</span>
                          <% } %>
                        </div>
                        <p class="mt-1 max-w-none text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
                          <% if (p.friendship_active && p.linked_user_pix_ready) { %>
                            Quando você for pagar algo a <strong class="font-semibold text-slate-700 dark:text-slate-100"><%= p.name %></strong>, o app usa o Pix que essa pessoa deixou no próprio perfil. Se ela trocar a chave por lá, a próxima cobrança já acompanha a versão nova.
                          <% } else if (p.friendship_active && p.linked_user_pix_enabled) { %>
                            A amizade já está ativa, mas o Pix dessa pessoa ainda está pedindo um ajuste no próprio perfil. Quando ela fechar isso, é esse cadastro vivo que entra em cena nas cobranças.
                          <% } else if (p.friendship_active && p.has_app_user) { %>
                            A amizade já está ativa. Agora só falta essa pessoa deixar o Pix dela redondinho no próprio perfil para os pagamentos acontecerem sem improviso.
                          <% } else if (p.has_app_user) { %>
                            Você não precisa cadastrar a chave Pix dessa pessoa por aqui. Quando a amizade for aceita e surgir um pagamento, o app usa o Pix que ela mesma deixou no perfil dela.
                          <% } else { %>
                            Por enquanto isso aqui é só contato. Se essa pessoa entrar no app depois, o Pix continua sendo cadastrado por ela, no perfil dela.
                          <% } %>
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="w-full rounded-[24px] border border-sky-100/70 bg-slate-50/90 px-4 py-4 shadow-sm shadow-sky-100/10 dark:border-slate-700 dark:bg-slate-900/70 sm:px-5">
                    <div class="flex items-start gap-3">
                      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-sky-600 shadow-sm ring-1 ring-sky-100 dark:bg-slate-800 dark:text-sky-300 dark:ring-slate-700" aria-hidden="true"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                      <div class="min-w-0 flex-1">
                        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600/70 dark:text-sky-300/80">Recadinho do app</div>
                        <p class="mt-1 max-w-none text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= personHintText %></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="rounded-[28px] border border-dashed border-slate-300 bg-slate-50/70 px-6 py-10 text-center text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400">Sua rede ainda está vazia por aqui. Quando quiser, comece adicionando quem entra nas suas divisões e cobranças.</div>
        <% } %>
      </div>
    </div>
  </section>
</div>

<script>
  const PIX_CITY_SUGGESTIONS_BY_STATE = <%- JSON.stringify(pixCitySuggestionsByState || {}) %>;
  const PIX_ALL_CITY_SUGGESTIONS = <%- JSON.stringify(pixAllCitySuggestions || []) %>;
  const PIX_DEFAULT_STATE = <%- JSON.stringify(pixStateDefault) %>;
  const PIX_DEFAULT_CITY = <%- JSON.stringify(pixCityDefault) %>;

  function normalizeText(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function getField(prefix, suffix) {
    return document.getElementById(`${prefix}${suffix}`);
  }

  function suggestionText(entry) {
    if (entry && typeof entry === 'object') {
      return String(entry.name || entry.label || entry.value || entry.code || '').trim();
    }
    return String(entry || '').trim();
  }

  function findPixStateByCity(city) {
    const safeCity = normalizeText(city);
    if (!safeCity) return '';
    return Object.entries(PIX_CITY_SUGGESTIONS_BY_STATE).find(([, cities]) =>
      (cities || []).some((entry) => normalizeText(suggestionText(entry)) === safeCity)
    )?.[0] || '';
  }

  function fillPixCitySuggestions(prefix, stateCode) {
    const datalist = document.getElementById(`${prefix}PixCitySuggestions`);
    if (!datalist) return;
    const entries = (stateCode && PIX_CITY_SUGGESTIONS_BY_STATE[stateCode])
      ? PIX_CITY_SUGGESTIONS_BY_STATE[stateCode]
      : PIX_ALL_CITY_SUGGESTIONS;
    datalist.innerHTML = (entries || []).map((city) => {
      const safeCity = suggestionText(city);
      if (!safeCity) return '';
      const option = document.createElement('option');
      option.value = safeCity;
      return option.outerHTML;
    }).join('');
  }

  function updatePixKeyUi(prefix) {
    const typeInput = getField(prefix, 'PixKeyType');
    const keyInput = getField(prefix, 'PixKeyValue');
    const help = getField(prefix, 'PixKeyHelp');
    if (!typeInput || !keyInput || !help) return;

    const type = String(typeInput.value || '').trim();
    keyInput.removeAttribute('maxlength');
    keyInput.inputMode = 'text';
    keyInput.autocapitalize = 'off';

    if (type === 'phone') {
      keyInput.placeholder = 'Ex.: 21999999999';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 15;
      help.textContent = 'Se for celular, pode mandar só DDD + número, com ou sem máscara. O +55 entra por nossa conta.';
      return;
    }

    if (type === 'cpf') {
      keyInput.placeholder = 'Ex.: 12345678900';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 14;
      help.textContent = 'Pode colar com pontuação ou só os números. A gente limpa por trás.';
      return;
    }

    if (type === 'cnpj') {
      keyInput.placeholder = 'Ex.: 12345678000190';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 18;
      help.textContent = 'Pode colar com pontuação ou só os números. A gente limpa por trás.';
      return;
    }

    if (type === 'email') {
      keyInput.placeholder = 'Ex.: joao@email.com';
      help.textContent = 'Aqui vale o e-mail completinho, do jeitinho que está cadastrado no banco.';
      return;
    }

    if (type === 'evp') {
      keyInput.placeholder = 'Ex.: 123e4567-e89b-12d3-a456-426614174000';
      help.textContent = 'Se for chave aleatória, cole ela inteira e pronto.';
      return;
    }

    keyInput.placeholder = 'Ex.: 21999999999';
    help.textContent = 'Se for celular, pode mandar só DDD + número, com ou sem máscara. O +55 entra por nossa conta.';
  }

  function updatePixCityUi(prefix, forceCity = false) {
    const stateInput = getField(prefix, 'PixState');
    const cityInput = getField(prefix, 'PixCity');
    if (!stateInput || !cityInput) return;

    const stateCode = String(stateInput.value || '').trim();
    fillPixCitySuggestions(prefix, stateCode);

    const suggestions = (PIX_CITY_SUGGESTIONS_BY_STATE[stateCode] || []).map(suggestionText).filter(Boolean);
    const currentCity = String(cityInput.value || '').trim();
    if (!currentCity) {
      if (forceCity) {
        cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
      }
      return;
    }

    if (forceCity && suggestions.length && !suggestions.includes(currentCity)) {
      cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
    }
  }

  function editContactFromButton(button) {
    getField('contact', 'PersonId').value = button.dataset.id || '';
    getField('contact', 'Name').value = button.dataset.name || '';
    getField('contact', 'Phone').value = button.dataset.phone || '';
    getField('contact', 'Email').value = button.dataset.email || '';
    const submit = document.getElementById('contactBtnSubmit');
    const cancel = document.getElementById('contactBtnCancel');
    if (submit) {
      submit.innerHTML = 'Salvar mudanças';
      submit.classList.remove('bg-slate-900');
      submit.classList.add('bg-blue-600');
    }
    if (cancel) {
      cancel.classList.remove('hidden');
    }
    const target = document.getElementById('contactForm');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetContactForm() {
    getField('contact', 'PersonId').value = '';
    getField('contact', 'Name').value = '';
    getField('contact', 'Phone').value = '';
    getField('contact', 'Email').value = '';
    const submit = document.getElementById('contactBtnSubmit');
    const cancel = document.getElementById('contactBtnCancel');
    if (submit) {
      submit.innerHTML = `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>Salvar contato`;
      submit.classList.remove('bg-blue-600');
      submit.classList.add('bg-slate-900');
    }
    if (cancel) cancel.classList.add('hidden');
  }

  function bindPixForm(prefix, options = {}) {
    const stateInput = getField(prefix, 'PixState');
    const keyTypeInput = getField(prefix, 'PixKeyType');
    const cityInput = getField(prefix, 'PixCity');

    if (stateInput) {
      stateInput.addEventListener('change', () => updatePixCityUi(prefix, true));
    }

    if (keyTypeInput) {
      keyTypeInput.addEventListener('change', () => updatePixKeyUi(prefix));
    }

    if (cityInput) {
      cityInput.addEventListener('blur', () => {
        const guessedState = findPixStateByCity(cityInput.value);
        if (guessedState && stateInput && !stateInput.value) {
          stateInput.value = guessedState;
          updatePixCityUi(prefix, false);
        }
      });
    }

    updatePixKeyUi(prefix);
    updatePixCityUi(prefix, !!options.forceCity);
  }

  async function prepareProfilePhotoFile(file) {
    const toDataUrl = (sourceFile) => new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('Não consegui ler essa imagem.'));
      reader.readAsDataURL(sourceFile);
    });

    const toImage = (src) => new Promise((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error('A imagem não abriu direitinho.'));
      image.src = src;
    });

    const sourceUrl = await toDataUrl(file);
    const image = await toImage(sourceUrl);
    const side = Math.min(image.naturalWidth || image.width, image.naturalHeight || image.height);
    const sx = Math.max(0, Math.floor(((image.naturalWidth || image.width) - side) / 2));
    const sy = Math.max(0, Math.floor(((image.naturalHeight || image.height) - side) / 2));
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(image, sx, sy, side, side, 0, 0, 512, 512);

    const blob = await new Promise((resolve, reject) => {
      canvas.toBlob((value) => value ? resolve(value) : reject(new Error('Não consegui preparar a foto.')), 'image/jpeg', 0.88);
    });

    return {
      file: new File([blob], ((file.name || 'perfil').replace(/\.[^.]+$/, '') || 'perfil') + '.jpg', { type: 'image/jpeg' }),
      previewUrl: canvas.toDataURL('image/jpeg', 0.88)
    };
  }

  function bindProfilePhotoForm() {
    const form = document.getElementById('profilePhotoForm');
    const input = document.getElementById('profilePhotoInput');
    const submit = document.getElementById('profilePhotoSubmit');
    const previewWrap = document.getElementById('profilePhotoPreviewWrap');
    const preview = document.getElementById('profilePhotoPreview');
    const hint = document.getElementById('profilePhotoHint');
    if (!form || !input || !submit || !previewWrap || !preview || !hint) return;

    input.addEventListener('change', async () => {
      const selected = input.files && input.files[0];
      if (!selected) return;
      submit.disabled = true;
      submit.textContent = 'Preparando foto...';
      hint.textContent = 'Dando aquela aparada para ela ficar redondinha por aqui.';
      try {
        const prepared = await prepareProfilePhotoFile(selected);
        const transfer = new DataTransfer();
        transfer.items.add(prepared.file);
        input.files = transfer.files;
        preview.src = prepared.previewUrl;
        previewWrap.classList.remove('hidden');
        previewWrap.classList.add('flex');
        hint.textContent = 'Tudo certo! Agora é só salvar que ela sobe enxuta e bonitona.';
      } catch (_error) {
        previewWrap.classList.add('hidden');
        previewWrap.classList.remove('flex');
        hint.textContent = 'Essa foto tropeçou aqui. Tenta outra imagem rapidinho.';
      } finally {
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      }
    });

    form.addEventListener('submit', () => {
      submit.disabled = true;
      submit.textContent = 'Subindo foto...';
    });
  }

  window.addEventListener('load', () => {
    bindPixForm('self');
    resetContactForm();
    bindProfilePhotoForm();

    const highlighted = document.querySelector('[id^="friend-request-"][class*="ring-2"]');
    if (highlighted) {
      highlighted.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>

<%- include("partials/footer") %>
