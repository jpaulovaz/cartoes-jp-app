                  <div class="flex flex-wrap items-center gap-2">
                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600/80 dark:text-violet-300/80">Pix nas cobranças</div>
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= pixState.badgeClasses %>"><%= pixState.label %></span>
                  </div>
                  <p class="mt-2 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= pixState.summary %></p>
                </div>

                <div class="rounded-[24px] border border-sky-100/70 bg-slate-50/90 px-4 py-3.5 shadow-sm shadow-sky-100/10 dark:border-slate-700 dark:bg-slate-900/70 sm:px-5">
                  <div class="flex items-start gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-white/95 text-sky-600 shadow-sm ring-1 ring-sky-100 dark:bg-slate-800 dark:text-sky-300 dark:ring-slate-700" aria-hidden="true">
                      <% if (profileSignatureVisible) { %>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h6m5 8H6a2 2 0 01-2-2V6a2 2 0 012-2h7.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V18a2 2 0 01-2 2z"></path></svg>
                      <% } else { %>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      <% } %>
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600/70 dark:text-sky-300/80"><%= profileSignatureVisible ? 'Assinatura da pessoa' : 'Recado do app' %></div>
                        <% if (profileSignatureVisible && profileSignatureMeta) { %>
                          <span class="inline-flex items-center rounded-full border border-sky-200 bg-white px-3 py-1 text-[11px] font-bold text-sky-700 dark:border-sky-800 dark:bg-slate-900 dark:text-sky-200"><%= profileSignatureMeta.label %></span>
                        <% } %>
                      </div>
                      <% if (profileSignatureVisible) { %>
                        <p class="mt-1 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= p.profile_signature_text || 'Essa pessoa preferiu mostrar só o status por aqui.' %></p>
                      <% } else { %>
                        <p class="mt-1 text-[13px] font-medium leading-5 text-slate-600 dark:text-slate-300"><%= personHintText %></p>
