      manageSubmit.textContent = 'Salvar PIN';
      resetPinFieldState(manageModal);
    };

    const openManage = (mode) => {
      closeAll();
      resetManageForm();
      const safeMode = mode === 'change' ? 'change' : 'create';
      manageModeInput.value = safeMode;
      const changing = safeMode === 'change';
      currentGroup.classList.toggle('hidden', !changing);
      currentInput.required = changing;
      manageTitle.textContent = changing ? 'Trocar PIN' : 'Criar PIN';
      manageHint.textContent = changing
        ? 'Confirme o PIN atual e depois escolha o novo jeitinho de destravar o app.'
        : 'Escolha um PIN numérico para proteger a abertura do app.';
      manageSubmit.textContent = changing ? 'Atualizar PIN' : 'Salvar PIN';
      setPinModalVisibility(manageModal, true);
