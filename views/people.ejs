                      <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis whitespace-nowrap leading-5" title="<%= p.phone_display ? p.phone_display : 'Telefone não informado ainda.' %>"><%= p.phone_display ? p.phone_display : 'Telefone não informado ainda.' %></span>
