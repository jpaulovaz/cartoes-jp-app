                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% }) %>

        <div id="networkFilteredEmpty" class="hidden rounded-[28px] border border-dashed border-slate-300 bg-slate-50/70 px-6 py-10 text-center text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400 lg:col-span-2">Nada apareceu com esse filtro agora. Limpa a busca ou troque o filtro para ver mais gente.</div>
      </div>
    <% } else { %>
      <div class="mt-6 rounded-[28px] border border-dashed border-slate-300 bg-slate-50/70 px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-900/50">
