                    <div class="inline-flex w-fit max-w-full items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
                      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50/80 text-slate-500 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300" aria-hidden="true">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-16 8h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                      </span>
                      <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis whitespace-nowrap leading-5" title="<%= p.email ? p.email : 'E-mail não informado ainda.' %>"><%= p.email ? p.email : 'E-mail não informado ainda.' %></span>
                    </div>
                  </div>

                  <div class="mt-3 inline-flex max-w-full items-center gap-2 overflow-hidden rounded-full border border-slate-200 bg-slate-50/80 px-3 py-2 text-[13px] font-semibold leading-5 text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300 whitespace-nowrap">
                    <span aria-hidden="true">💬</span>
                    <span class="block min-w-0 max-w-full overflow-hidden text-ellipsis"><%= personState.summary %></span>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-2">
                <%- renderPersonStatusChips(p) %>
              </div>

              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-4">
                <% if (p.friendship_state === 'active') { %>
                  <form method="post" action="/people/<%= p.id %>/unfriend" class="min-w-0" data-confirm-prompt="Desfazer amizade com <%= p.name %>? O histórico continua salvo, mas novas cobranças entre vocês param na hora.">
