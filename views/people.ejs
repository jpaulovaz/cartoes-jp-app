<%- include("partials/header", { title: "OrganizaPay | Pessoas" }) %>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Pessoas</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-2 font-medium">Gerencie quem participa das divisões de gastos
          das faturas.</p>
      </div>
    </div>

    <div
      class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 sm:p-8">

      <form method="post" action="/people" id="personForm"
        class="flex flex-col gap-4 mb-8 pb-8 border-b border-slate-100 dark:border-slate-700">
        <div class="text-sm font-medium text-slate-500 dark:text-slate-400 -mb-1">
          O e-mail é opcional. Ele será usado no futuro para identificar quando essa pessoa também tiver acesso ao OrganizaPay.
        </div>
        <input type="hidden" name="id" id="personId">
        <div class="flex flex-col md:flex-row gap-3">
          <div class="flex-1 relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <input name="name" id="inputName"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="Nome do participante" required />
          </div>

          <div class="md:w-64 relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <input name="phone" id="inputPhone"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="5511999999999" />
          </div>

          <div class="md:w-72 relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m8-4H8m12 8H4a2 2 0 01-2-2V6a2 2 0 012-2h16a2 2 0 012 2v8a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <input name="email" id="inputEmail" type="email"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-xl pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 focus:bg-white dark:focus:bg-slate-950 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
              placeholder="email@exemplo.com" />
          </div>

          <button type="submit" id="btnSubmit"
            class="px-6 py-3 rounded-xl font-bold text-white bg-slate-900 dark:bg-blue-600 hover:bg-slate-800 dark:hover:bg-blue-700 shadow-sm transition-all hover:-translate-y-0.5 whitespace-nowrap">
            + Adicionar
          </button>
          <button type="button" id="btnCancel" onclick="resetForm()"
            class="hidden px-4 py-3 rounded-xl font-bold text-slate-500 bg-slate-100 hover:bg-slate-200 transition-all">Cancelar</button>
        </div>
      </form>

      <div class="grid gap-4 sm:grid-cols-2">
        <% people.forEach(p=> { %>
          <div
            class="group border border-slate-200 dark:border-slate-700 rounded-2xl p-4 flex items-center justify-between hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-md transition-all bg-white dark:bg-slate-800">
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-300 font-bold text-lg group-hover:bg-blue-50 dark:group-hover:bg-blue-900 group-hover:text-blue-600 transition-colors relative">
                <%= p.name.charAt(0).toUpperCase() %>
                  <% if (p.is_owner) { %><span class="absolute -top-2 -right-2 text-xl drop-shadow-sm"
                      title="Titular">👑</span>
                    <% } %>
              </div>
              <div>
                <div class="font-extrabold text-slate-800 dark:text-white text-lg flex items-center gap-2">
                  <%= p.name %>
                    <button type="button" data-id="<%= p.id %>" data-name="<%= p.name %>" data-phone="<%= p.phone || '' %>" data-email="<%= p.email || '' %>" onclick="editPersonFromButton(this)"
                      class="text-slate-400 hover:text-blue-500 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                        </path>
                      </svg>
                    </button>
                </div>
                <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">
                  <%= p.phone ? '📱 ' + p.phone : '⚠️ Sem telefone' %>
                </div>
                <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1 break-all">
                  <%= p.email ? '✉️ ' + p.email : '— Sem e-mail vinculado' %>
                </div>
                <div class="flex gap-2 items-center">
                  <% if (p.active) { %>
                    <span
                      class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 border border-green-200 dark:border-green-800">Ativo</span>
                    <% } else { %>
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400 border border-slate-200 dark:border-slate-600">Inativo</span>
                      <% } %>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <form method="post" action="/people/<%= p.id %>/set-owner">
                <button
                  class="w-full px-3 py-1.5 text-xs font-bold rounded-lg border <%= p.is_owner ? 'bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400' : 'bg-white dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-600' %> shadow-sm transition-colors">
                  <%= p.is_owner ? "É o Titular" : "Tornar Titular" %>
                </button>
              </form>
              <form method="post" action="/people/<%= p.id %>/toggle">
                <button
                  class="w-full px-3 py-1.5 text-xs font-bold rounded-lg border <%= p.active ? 'border-red-200 dark:border-red-900 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20' : 'border-green-200 dark:border-green-900 text-green-700 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20' %> transition-colors bg-white dark:bg-slate-700 shadow-sm">
                  <%= p.active ? "Desativar" : "Reativar" %>
                </button>
              </form>
              <form method="post" action="/people/<%= p.id %>/delete"
                data-confirm-prompt="Excluir <%= p.name %>? A exclusão só será concluída se não houver histórico vinculado."
                data-confirm-phrase="Eu confirmo">
                <button
                  class="w-full px-3 py-1.5 text-xs font-bold rounded-lg border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors bg-white dark:bg-slate-700 shadow-sm">
                  Excluir
                </button>
              </form>
            </div>
          </div>
          <% }) %>
      </div>
    </div>
  </div>

  <script>
    function editPersonFromButton(button) {
      editPerson(button.dataset.id, button.dataset.name || "", button.dataset.phone || "", button.dataset.email || "");
    }

    function editPerson(id, name, phone, email) {
      document.getElementById('personId').value = id;
      document.getElementById('inputName').value = name;
      document.getElementById('inputPhone').value = phone;
      document.getElementById('inputEmail').value = email;
      document.getElementById('btnSubmit').innerText = 'Salvar Alterações';
      document.getElementById('btnSubmit').classList.replace('bg-slate-900', 'bg-blue-600');
      document.getElementById('btnCancel').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetForm() {
      document.getElementById('personId').value = '';
      document.getElementById('inputName').value = '';
      document.getElementById('inputPhone').value = '';
      document.getElementById('inputEmail').value = '';
      document.getElementById('btnSubmit').innerText = '+ Adicionar';
      document.getElementById('btnSubmit').classList.add('bg-slate-900');
      document.getElementById('btnCancel').classList.add('hidden');
    }
  </script>

  <%- include("partials/footer") %>