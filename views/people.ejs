      button.classList.toggle('hover:bg-sky-50', !isActive);
      button.classList.toggle('hover:text-sky-700', !isActive);
      button.classList.toggle('dark:hover:border-sky-800', !isActive);
      button.classList.toggle('dark:hover:bg-sky-900/20', !isActive);
      button.classList.toggle('dark:hover:text-sky-200', !isActive);
      selectedClasses.forEach((className) => button.classList.toggle(className, isActive));
      idleClasses.forEach((className) => button.classList.toggle(className, !isActive));
    });

    if (activeButton) {
      previewVibe.textContent = activeButton.textContent.trim();
      previewVibe.classList.remove('hidden');
    } else {
      previewVibe.textContent = '';
      previewVibe.classList.add('hidden');
    }

    previewText.textContent = textInput.value || 'Quando você escrever um recado aqui, ele aparece para seus amigos na sua rede.';
  };

  vibeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const nextCode = String(button.dataset.vibeCode || '').trim();
      vibeInput.value = vibeInput.value === nextCode ? '' : nextCode;
