<%- include("partials/header", { title: "Cartões JP | Pessoas" }) %>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Pessoas</h1>
        <p class="text-slate-500 mt-2 font-medium">Gerencie quem participa das divisões de gastos das faturas.</p>
      </div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-6 sm:p-8">

      <form method="post" action="/people" class="flex flex-col sm:flex-row gap-3 mb-8 pb-8 border-b border-slate-100">
        <div class="flex-1 relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <input name="name"
            class="w-full border border-slate-300 rounded-xl pl-11 pr-4 py-3 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium"
            placeholder="Nome do participante (ex: Cleiton)" autocomplete="off" required />
        </div>
        <button type="submit"
          class="px-6 py-3 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition-all hover:-translate-y-0.5 whitespace-nowrap">
          + Adicionar Pessoa
        </button>
      </form>

      <div class="grid gap-4 sm:grid-cols-2">
        <% people.forEach(p=> { %>
          <div
            class="group border border-slate-200 rounded-2xl p-4 flex items-center justify-between hover:border-blue-300 hover:shadow-md transition-all bg-white">
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-lg group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors relative">
                <%= p.name.charAt(0).toUpperCase() %>
                  <% if (p.is_owner) { %>
                    <span class="absolute -top-2 -right-2 text-xl drop-shadow-sm"
                      title="Titular do Desmembramento">👑</span>
                    <% } %>
              </div>
              <div>
                <div class="font-extrabold text-slate-800 text-lg flex items-center gap-2">
                  <%= p.name %>
                </div>
                <div class="flex gap-2 items-center">
                  <% if (p.active) { %>
                    <span
                      class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800 border border-green-200 mt-1">Ativo</span>
                    <% } else { %>
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 mt-1">Inativo</span>
                      <% } %>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <form method="post" action="/people/<%= p.id %>/set-owner">
                <button
                  class="w-full px-3 py-1.5 text-xs font-bold rounded-lg border <%= p.is_owner ? 'bg-amber-50 border-amber-300 text-amber-700' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50' %> shadow-sm transition-colors">
                  <%= p.is_owner ? "É o Titular" : "Tornar Titular" %>
                </button>
              </form>

              <form method="post" action="/people/<%= p.id %>/toggle">
                <button
                  class="w-full px-3 py-1.5 text-xs font-bold rounded-lg border <%= p.active ? 'border-red-200 text-red-600 hover:bg-red-50' : 'border-green-200 text-green-700 hover:bg-green-50' %> transition-colors bg-white shadow-sm">
                  <%= p.active ? "Desativar" : "Reativar" %>
                </button>
              </form>
            </div>
          </div>
          <% }) %>
      </div>

    </div>
  </div>

  <%- include("partials/footer") %>