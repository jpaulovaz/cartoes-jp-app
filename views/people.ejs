function bindNetworkDiscoveryControls() {
  const cards = Array.from(document.querySelectorAll('[data-person-card]'));
  const searchInput = document.getElementById('networkSearch');
  const filterButtons = Array.from(document.querySelectorAll('[data-network-filter]'));
  const emptyState = document.getElementById('networkFilteredEmpty');
  if (!cards.length) return;

  let activeFilter = 'all';

  const render = () => {
    const searchTerm = normalizeText(searchInput?.value || '');
    let visibleCount = 0;

    cards.forEach((card) => {
      const filterState = String(card.dataset.filterState || 'all');
      const searchableText = normalizeText(card.dataset.searchText || '');
      const matchesFilter = activeFilter === 'all' || filterState === activeFilter;
      const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
      const isVisible = matchesFilter && matchesSearch;
      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      updateNetworkFilterButtonState(button, String(button.dataset.networkFilter || '') === activeFilter);
    });


    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = String(button.dataset.networkFilter || 'all');
      render();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', render);
  }

  render();
}

function bindProfileSignatureForm() {
  const textInput = document.getElementById('profileSignatureText');
  const vibeInput = document.getElementById('profileSignatureVibe');
  const counter = document.getElementById('profileSignatureCount');
  const previewText = document.getElementById('profileSignaturePreviewText');
  const previewVibe = document.getElementById('profileSignaturePreviewVibe');
  const vibeButtons = Array.from(document.querySelectorAll('[data-signature-vibe-option]'));
  if (!textInput || !vibeInput || !previewText || !previewVibe || !vibeButtons.length) return;

  const selectedClasses = ['border-sky-600', 'bg-sky-600', 'text-white', 'shadow-lg', 'shadow-sky-500/15', 'dark:border-sky-400', 'dark:bg-sky-400', 'dark:text-slate-950'];
  const idleClasses = ['border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-slate-300'];

  const sanitizeTextLive = (value) => String(value || '')
    .replace(/[\r\n]+/g, ' ')
    .replace(/[ 	]{2,}/g, ' ')
    .replace(/^\s+/g, '');
  const sanitizeTextSubmit = (value) => sanitizeTextLive(value).trim();

  const render = () => {
    textInput.value = sanitizeTextLive(textInput.value).slice(0, Number(textInput.maxLength || 60));
    if (counter) {
      counter.textContent = `${textInput.value.length}/${textInput.maxLength || 60}`;
    }

    const activeVibeCode = String(vibeInput.value || '').trim();
    const activeButton = vibeButtons.find((button) => String(button.dataset.vibeCode || '') === activeVibeCode) || null;

    vibeButtons.forEach((button) => {
