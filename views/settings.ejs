              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto" data-app-pin-disable-close>Cancelar</button>
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-rose-200 bg-rose-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-rose-500/20 transition-all hover:-translate-y-0.5 hover:bg-rose-700 sm:w-auto">Desligar PIN</button>
              </div>
            </form>
          </div>
        </div>
    </section>

    </section>
  <% } %>
</div>
<script>
  const PIX_CITY_SUGGESTIONS_BY_STATE = <%- JSON.stringify(pixCitySuggestionsByState || {}) %>;
  const PIX_ALL_CITY_SUGGESTIONS = <%- JSON.stringify(pixAllCitySuggestions || []) %>;
  const PIX_DEFAULT_STATE = <%- JSON.stringify(pixStateDefault) %>;
  const PIX_DEFAULT_CITY = <%- JSON.stringify(pixCityDefault) %>;
  const PHONE_COUNTRY_OPTIONS = <%- JSON.stringify(phoneCountryOptionsList || []) %>;
  const PHONE_DEFAULT_COUNTRY = <%- JSON.stringify(phoneDefaultCountryCode) %>;
  const PHONE_PLACEHOLDERS = {
    BR: '(21) 99999-9999',
    PT: '912 345 678',
    US: '(201) 555-0123',
    AR: '11 2345-6789',
    MX: '55 1234 5678',
    default: 'Número local ou completo com +'
  };

  function normalizeText(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function getField(prefix, suffix) {
    return document.getElementById(`${prefix}${suffix}`);
  }

  function suggestionText(entry) {
    if (entry && typeof entry === 'object') {
      return String(entry.name || entry.label || entry.value || entry.code || '').trim();
    }
    return String(entry || '').trim();
  }

  function findPixStateByCity(city) {
    const safeCity = normalizeText(city);
    if (!safeCity) return '';
    return Object.entries(PIX_CITY_SUGGESTIONS_BY_STATE).find(([, cities]) =>
      (cities || []).some((entry) => normalizeText(suggestionText(entry)) === safeCity)
    )?.[0] || '';
  }

  function fillPixCitySuggestions(prefix, stateCode) {
    const datalist = document.getElementById(`${prefix}PixCitySuggestions`);
    if (!datalist) return;
    const entries = (stateCode && PIX_CITY_SUGGESTIONS_BY_STATE[stateCode])
      ? PIX_CITY_SUGGESTIONS_BY_STATE[stateCode]
      : PIX_ALL_CITY_SUGGESTIONS;
    datalist.innerHTML = (entries || []).map((city) => {
      const safeCity = suggestionText(city);
      if (!safeCity) return '';
      const option = document.createElement('option');
      option.value = safeCity;
      return option.outerHTML;
    }).join('');
  }

  function updatePixKeyUi(prefix) {
    const typeInput = getField(prefix, 'PixKeyType');
    const keyInput = getField(prefix, 'PixKeyValue');
    const help = getField(prefix, 'PixKeyHelp');
    if (!typeInput || !keyInput || !help) return;

    const type = String(typeInput.value || '').trim();
    keyInput.removeAttribute('maxlength');
    keyInput.inputMode = 'text';
    keyInput.autocapitalize = 'off';

    if (type === 'phone') {
      keyInput.placeholder = 'Ex.: 21999999999';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 15;
      help.textContent = 'Se for celular, pode mandar só DDD + número, com ou sem máscara. O +55 entra por nossa conta.';
      return;
    }

    if (type === 'cpf') {
      keyInput.placeholder = 'Ex.: 12345678900';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 14;
      help.textContent = 'Pode colar com pontuação ou só os números. A gente limpa por trás.';
      return;
    }

    if (type === 'cnpj') {
      keyInput.placeholder = 'Ex.: 12345678000190';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 18;
      help.textContent = 'Pode colar com pontuação ou só os números. A gente limpa por trás.';
      return;
    }

    if (type === 'email') {
      keyInput.placeholder = 'Ex.: joao@email.com';
      help.textContent = 'Aqui vale o e-mail completinho, do jeitinho que está cadastrado no banco.';
      return;
    }

    if (type === 'evp') {
      keyInput.placeholder = 'Ex.: 123e4567-e89b-12d3-a456-426614174000';
      help.textContent = 'Se for chave aleatória, cole ela inteira e pronto.';
      return;
    }

    keyInput.placeholder = 'Ex.: 21999999999';
    help.textContent = 'Se for celular, pode mandar só DDD + número, com ou sem máscara. O +55 entra por nossa conta.';
  }

  function updatePixCityUi(prefix, forceCity = false) {
    const stateInput = getField(prefix, 'PixState');
    const cityInput = getField(prefix, 'PixCity');
    if (!stateInput || !cityInput) return;

    const stateCode = String(stateInput.value || '').trim();
    fillPixCitySuggestions(prefix, stateCode);

    const suggestions = (PIX_CITY_SUGGESTIONS_BY_STATE[stateCode] || []).map(suggestionText).filter(Boolean);
    const currentCity = String(cityInput.value || '').trim();
    if (!currentCity) {
      if (forceCity) {
        cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
      }
      return;
    }

    if (forceCity && suggestions.length && !suggestions.includes(currentCity)) {
      cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
    }
  }

  function getPhoneUi(prefix) {
    return {
      country: getField(prefix, 'PhoneCountry'),
      phone: getField(prefix, 'Phone'),
      hint: getField(prefix, 'PhoneHint')
    };
  }

  function getSelectedPhoneCountryOption(countryCode) {
    return PHONE_COUNTRY_OPTIONS.find((option) => String(option?.code || '') === String(countryCode || '')) || null;
  }

  function formatBrazilPhoneInput(value) {
    const digits = String(value || '').replace(/\D/g, '').slice(0, 11);
    if (!digits) return '';
    if (digits.length <= 2) return digits;
    if (digits.length <= 6) return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
    if (digits.length <= 10) return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
    return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
  }

  function sanitizePhoneInputValue(countryCode, value) {
    const raw = String(value || '');
    if (!raw.trim()) return '';
    if (raw.trim().startsWith('+')) {
      return raw.replace(/[^\d+\s()-]/g, '').replace(/\s{2,}/g, ' ').trimStart();
    }
    if (String(countryCode || '').toUpperCase() === 'BR') {
      return formatBrazilPhoneInput(raw);
    }
    return raw.replace(/[^\d\s()-]/g, '').replace(/\s{2,}/g, ' ').trimStart();
  }

  function updatePhoneUi(prefix) {
    const { country, phone, hint } = getPhoneUi(prefix);
    if (!country || !phone) return;

    const countryCode = String(country.value || PHONE_DEFAULT_COUNTRY).trim().toUpperCase() || PHONE_DEFAULT_COUNTRY;
    const option = getSelectedPhoneCountryOption(countryCode);
    const countryLabel = option ? `${option.flag} +${option.callingCode}` : '🌍';

    phone.placeholder = PHONE_PLACEHOLDERS[countryCode] || PHONE_PLACEHOLDERS.default;
    phone.inputMode = 'tel';
    phone.autocomplete = 'tel-national';
    phone.value = sanitizePhoneInputValue(countryCode, phone.value);

    if (hint) {
      hint.textContent = countryCode === 'BR'
        ? `DDI ${countryLabel} já fica com você. Aqui entra DDD + celular, com ou sem máscara.`
        : `O DDI ${countryLabel} vai pelo seletor. Aqui você pode digitar só o número local ou colar o telefone completo com +.`;
    }
  }

  function bindPhoneField(prefix) {
    const { country, phone } = getPhoneUi(prefix);
    if (!country || !phone || country.dataset.phoneBound === 'true') return;

    country.dataset.phoneBound = 'true';
    phone.addEventListener('input', () => updatePhoneUi(prefix));
    country.addEventListener('change', () => updatePhoneUi(prefix));
    updatePhoneUi(prefix);
  }

  const SELF_IDENTITY_DEFAULT = {
    name: <%- JSON.stringify(selfName || '') %>,
    phoneCountry: <%- JSON.stringify(selfPhoneCountry || phoneDefaultCountryCode) %>,
    phone: <%- JSON.stringify(selfPhone || '') %>,
    email: <%- JSON.stringify(selfEmail || '') %>
  };

  function populateSelfIdentityForm(values = SELF_IDENTITY_DEFAULT) {
    const name = getField('self', 'Name');
    const phoneCountry = getField('self', 'PhoneCountry');
    const phone = getField('self', 'Phone');
    const email = getField('self', 'Email');

    if (name) name.value = values.name || '';
    if (phoneCountry) phoneCountry.value = values.phoneCountry || PHONE_DEFAULT_COUNTRY;
    if (phone) phone.value = values.phone || '';
    if (email) email.value = values.email || '';
    updatePhoneUi('self');
  }
  function setSelfIdentityEditMode() {
    populateSelfIdentityForm();
  }

  function toggleSelfIdentityEdit() {
    populateSelfIdentityForm();
    requestAnimationFrame(() => {
      const name = getField('self', 'Name');
      name?.focus();
      name?.select?.();
    });
  }

  function resetSelfIdentityForm() {
    populateSelfIdentityForm();
  }

function editContactFromButton(button) {
  const personId = getField('contact', 'PersonId');
  const name = getField('contact', 'Name');
  const phoneCountry = getField('contact', 'PhoneCountry');
  const phone = getField('contact', 'Phone');
  const email = getField('contact', 'Email');
  const submit = document.getElementById('contactBtnSubmit');
  const cancel = document.getElementById('contactBtnCancel');
  const eyebrow = document.getElementById('contactFormEyebrow');
  const title = document.getElementById('contactFormTitle');
  const hint = document.getElementById('contactFormHint');
  const badge = document.getElementById('contactEditingBadge');
  const composer = document.getElementById('contactComposerCard');

  if (personId) personId.value = button.dataset.id || '';
  if (name) name.value = button.dataset.name || '';
  if (phoneCountry) phoneCountry.value = button.dataset.phoneCountry || PHONE_DEFAULT_COUNTRY;
  if (phone) phone.value = button.dataset.phone || '';
  if (email) email.value = button.dataset.email || '';
  updatePhoneUi('contact');

  if (submit) {
    submit.innerHTML = `<svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>Salvar mudanças`;
    submit.classList.remove('bg-sky-600', 'hover:bg-sky-700');
    submit.classList.add('bg-blue-600', 'hover:bg-blue-700');
  }

  if (cancel) cancel.classList.remove('hidden');
  if (eyebrow) eyebrow.textContent = 'Editando contato';
  if (title) title.textContent = `Ajustando ${button.dataset.name || 'esse contato'}`;
  if (hint) hint.textContent = 'Mude só o que precisar e salve. O resto continua como está.';
  if (badge) badge.classList.remove('hidden');
  if (composer) {
    composer.classList.add('ring-2', 'ring-sky-200', 'dark:ring-sky-900/60');
  }

  const target = document.getElementById('contactForm');
  if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function resetContactForm() {
  const personId = getField('contact', 'PersonId');
  const name = getField('contact', 'Name');
  const phoneCountry = getField('contact', 'PhoneCountry');
  const phone = getField('contact', 'Phone');
  const email = getField('contact', 'Email');
  const submit = document.getElementById('contactBtnSubmit');
  const cancel = document.getElementById('contactBtnCancel');
  const eyebrow = document.getElementById('contactFormEyebrow');
  const title = document.getElementById('contactFormTitle');
  const hint = document.getElementById('contactFormHint');
  const badge = document.getElementById('contactEditingBadge');
  const composer = document.getElementById('contactComposerCard');

  if (personId) personId.value = '';
  if (name) name.value = '';
  if (phoneCountry) phoneCountry.value = PHONE_DEFAULT_COUNTRY;
  if (phone) phone.value = '';
  if (email) email.value = '';
  updatePhoneUi('contact');

  if (submit) {
    submit.innerHTML = `<svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>Salvar contato`;
    submit.classList.remove('bg-blue-600', 'hover:bg-blue-700');
    submit.classList.add('bg-sky-600', 'hover:bg-sky-700');
  }

  if (cancel) cancel.classList.add('hidden');
  if (eyebrow) eyebrow.textContent = 'Adicionar à sua rede';
  if (title) title.textContent = 'Quem vai entrar nessa roda?';
  if (hint) hint.textContent = 'Salve nome, telefone e e-mail. Se essa pessoa também usa o app, você pode mandar o convite depois. O Pix fica por conta dela.';
  if (badge) badge.classList.add('hidden');
  if (composer) {
    composer.classList.remove('ring-2', 'ring-sky-200', 'dark:ring-sky-900/60');
  }
}

function bindSelfPixToggle() {
  const toggle = document.getElementById('selfPixEnabled');
  const groups = Array.from(document.querySelectorAll('[data-self-pix-field]'));
  const dormantHint = document.getElementById('selfPixDormantHint');
  if (!toggle) return;

  const sync = () => {
    const enabled = !!toggle.checked;
    groups.forEach((group) => {
      group.style.opacity = enabled ? '' : '0.6';
      group.style.pointerEvents = enabled ? '' : 'none';
      Array.from(group.querySelectorAll('input, select, textarea')).forEach((field) => {
        field.disabled = !enabled;
      });
    });

    if (dormantHint) {
      dormantHint.classList.toggle('hidden', enabled);
    }
  };

  toggle.addEventListener('change', sync);
  sync();
}

function updateNetworkFilterButtonState(button, isActive) {
  if (!button) return;
  button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
  button.classList.toggle('border-slate-900', isActive);
  button.classList.toggle('bg-slate-900', isActive);
  button.classList.toggle('text-white', isActive);
  button.classList.toggle('shadow-lg', isActive);
  button.classList.toggle('dark:border-slate-100', isActive);
  button.classList.toggle('dark:bg-slate-100', isActive);
  button.classList.toggle('dark:text-slate-950', isActive);

  button.classList.toggle('border-slate-200', !isActive);
  button.classList.toggle('bg-white', !isActive);
  button.classList.toggle('text-slate-600', !isActive);
  button.classList.toggle('dark:border-slate-700', !isActive);
  button.classList.toggle('dark:bg-slate-900', !isActive);
  button.classList.toggle('dark:text-slate-300', !isActive);
}

function bindNetworkDiscoveryControls() {
  const cards = Array.from(document.querySelectorAll('[data-person-card]'));
  const searchInput = document.getElementById('networkSearch');
  const filterButtons = Array.from(document.querySelectorAll('[data-network-filter]'));
  const counter = document.getElementById('networkVisibleCounter');
  const emptyState = document.getElementById('networkFilteredEmpty');
  if (!cards.length) return;

  let activeFilter = 'all';

  const render = () => {
    const searchTerm = normalizeText(searchInput?.value || '');
    let visibleCount = 0;

    cards.forEach((card) => {
      const filterState = String(card.dataset.filterState || 'all');
      const searchableText = normalizeText(card.dataset.searchText || '');
      const matchesFilter = activeFilter === 'all' || filterState === activeFilter;
      const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
      const isVisible = matchesFilter && matchesSearch;
      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      updateNetworkFilterButtonState(button, String(button.dataset.networkFilter || '') === activeFilter);
    });

    if (counter) {
      counter.textContent = visibleCount === 1 ? '1 pessoa aparecendo' : `${visibleCount} pessoas aparecendo`;
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = String(button.dataset.networkFilter || 'all');
      render();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', render);
  }

  render();
}

function bindProfileSignatureForm() {
  const textInput = document.getElementById('profileSignatureText');
  const vibeInput = document.getElementById('profileSignatureVibe');
  const counter = document.getElementById('profileSignatureCount');
  const previewText = document.getElementById('profileSignaturePreviewText');
  const previewVibe = document.getElementById('profileSignaturePreviewVibe');
  const vibeButtons = Array.from(document.querySelectorAll('[data-signature-vibe-option]'));
  if (!textInput || !vibeInput || !previewText || !previewVibe || !vibeButtons.length) return;

  const selectedClasses = ['border-sky-600', 'bg-sky-600', 'text-white', 'shadow-lg', 'shadow-sky-500/15', 'dark:border-sky-400', 'dark:bg-sky-400', 'dark:text-slate-950'];
  const idleClasses = ['border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-slate-300'];

  const sanitizeTextLive = (value) => String(value || '')
    .replace(/[\r\n]+/g, ' ')
    .replace(/[ 	]{2,}/g, ' ')
    .replace(/^\s+/g, '');
  const sanitizeTextSubmit = (value) => sanitizeTextLive(value).trim();

  const render = () => {
    textInput.value = sanitizeTextLive(textInput.value).slice(0, Number(textInput.maxLength || 60));
    if (counter) {
      counter.textContent = `${textInput.value.length}/${textInput.maxLength || 60}`;
    }

    const activeVibeCode = String(vibeInput.value || '').trim();
    const activeButton = vibeButtons.find((button) => String(button.dataset.vibeCode || '') === activeVibeCode) || null;

    vibeButtons.forEach((button) => {
      const isActive = button === activeButton;
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      button.classList.toggle('hover:border-sky-200', !isActive);
      button.classList.toggle('hover:bg-sky-50', !isActive);
      button.classList.toggle('hover:text-sky-700', !isActive);
      button.classList.toggle('dark:hover:border-sky-800', !isActive);
      button.classList.toggle('dark:hover:bg-sky-900/20', !isActive);
      button.classList.toggle('dark:hover:text-sky-200', !isActive);
      selectedClasses.forEach((className) => button.classList.toggle(className, isActive));
      idleClasses.forEach((className) => button.classList.toggle(className, !isActive));
    });

    if (activeButton) {
      previewVibe.textContent = activeButton.textContent.trim();
      previewVibe.classList.remove('hidden');
    } else {
      previewVibe.textContent = '';
      previewVibe.classList.add('hidden');
    }

    previewText.textContent = textInput.value || 'Quando você escrever um recado aqui, ele aparece para seus amigos na sua rede.';
  };

  vibeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const nextCode = String(button.dataset.vibeCode || '').trim();
      vibeInput.value = vibeInput.value === nextCode ? '' : nextCode;
      render();
    });
  });


  textInput.addEventListener('input', render);
  const form = document.getElementById('profileSignatureForm');
  if (form) {
    form.addEventListener('submit', () => {
      textInput.value = sanitizeTextSubmit(textInput.value).slice(0, Number(textInput.maxLength || 60));
    });
  }

  render();
}

function bindPixForm(prefix, options = {}) {
    const stateInput = getField(prefix, 'PixState');
    const keyTypeInput = getField(prefix, 'PixKeyType');
    const cityInput = getField(prefix, 'PixCity');

    if (stateInput) {
      stateInput.addEventListener('change', () => updatePixCityUi(prefix, true));
    }

    if (keyTypeInput) {
      keyTypeInput.addEventListener('change', () => updatePixKeyUi(prefix));
    }

    if (cityInput) {
      cityInput.addEventListener('blur', () => {
        const guessedState = findPixStateByCity(cityInput.value);
        if (guessedState && stateInput && !stateInput.value) {
          stateInput.value = guessedState;
          updatePixCityUi(prefix, false);
        }
      });
    }

    updatePixKeyUi(prefix);
    updatePixCityUi(prefix, !!options.forceCity);
  }

  async function readFileAsDataUrl(sourceFile) {
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('Não consegui ler essa imagem.'));
      reader.readAsDataURL(sourceFile);
    });
  }

  function loadImageElement(src) {
    return new Promise((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error('A imagem não abriu direitinho.'));
      image.src = src;
    });
  }

  function clampPhotoCropOffset(state) {
    if (!state || !state.image) return;
    const stageSize = Math.max(1, state.stageSize || 1);
    const displayedWidth = (state.image.naturalWidth || state.image.width || 1) * state.scale;
    const displayedHeight = (state.image.naturalHeight || state.image.height || 1) * state.scale;
    const maxOffsetX = Math.max(0, (displayedWidth - stageSize) / 2);
    const maxOffsetY = Math.max(0, (displayedHeight - stageSize) / 2);
    state.offsetX = Math.max(-maxOffsetX, Math.min(maxOffsetX, state.offsetX || 0));
    state.offsetY = Math.max(-maxOffsetY, Math.min(maxOffsetY, state.offsetY || 0));
  }

  function applyPhotoCropTransforms(state) {
    if (!state || !state.stage || !state.imageElement || !state.previewElement || !state.image) return;
    const stageSize = Math.max(1, state.stage.clientWidth || state.stageSize || 1);
    state.stageSize = stageSize;
    clampPhotoCropOffset(state);
    const stageTransform = `translate(-50%, -50%) translate(${state.offsetX}px, ${state.offsetY}px) scale(${state.scale})`;
    state.imageElement.style.transform = stageTransform;
    const previewBox = Math.max(1, state.previewElement.parentElement?.clientWidth || 112);
    const previewRatio = previewBox / stageSize;
    const previewTransform = `translate(-50%, -50%) translate(${state.offsetX * previewRatio}px, ${state.offsetY * previewRatio}px) scale(${state.scale * previewRatio})`;
    state.previewElement.style.transform = previewTransform;
  }

  async function createPreparedPhotoFromCrop(state) {
    const stageSize = Math.max(1, state.stageSize || state.stage.clientWidth || 1);
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    const factor = 512 / stageSize;
    ctx.scale(factor, factor);
    const naturalWidth = state.image.naturalWidth || state.image.width || 1;
    const naturalHeight = state.image.naturalHeight || state.image.height || 1;
    const displayedWidth = naturalWidth * state.scale;
    const displayedHeight = naturalHeight * state.scale;
    const x = (stageSize / 2) + state.offsetX - (displayedWidth / 2);
    const y = (stageSize / 2) + state.offsetY - (displayedHeight / 2);
    ctx.drawImage(state.image, x, y, displayedWidth, displayedHeight);

    const blob = await new Promise((resolve, reject) => {
      canvas.toBlob((value) => value ? resolve(value) : reject(new Error('Não consegui preparar a foto.')), 'image/jpeg', 0.9);
    });

    return {
      file: new File([blob], ((state.originalFile?.name || 'perfil').replace(/\.[^.]+$/, '') || 'perfil') + '.jpg', { type: 'image/jpeg' }),
      previewUrl: canvas.toDataURL('image/jpeg', 0.9)
    };
  }

  function bindProfilePhotoForm() {
    const form = document.getElementById('profilePhotoForm');
    const input = document.getElementById('profilePhotoInput');
    const submit = document.getElementById('profilePhotoSubmit');
    const previewWrap = document.getElementById('profilePhotoPreviewWrap');
    const preview = document.getElementById('profilePhotoPreview');
    const hint = document.getElementById('profilePhotoHint');
    const modal = document.getElementById('profilePhotoCropModal');
    const stage = document.getElementById('profilePhotoCropStage');
    const stageImage = document.getElementById('profilePhotoCropImage');
    const previewCircle = document.getElementById('profilePhotoCropPreview');
    const zoom = document.getElementById('profilePhotoCropZoom');
    const applyButton = document.getElementById('profilePhotoCropApply');
    const modalCloseButtons = Array.from(document.querySelectorAll('[data-profile-photo-modal-close]'));
    if (!form || !input || !submit || !previewWrap || !preview || !hint || !modal || !stage || !stageImage || !previewCircle || !zoom || !applyButton) return;

    let cropState = null;
    let activeObjectUrl = '';
    let previewObjectUrl = '';

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const releaseObjectUrls = () => {
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = '';
      }
      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
        previewObjectUrl = '';
      }
    };

    const closeModal = () => {
      if (!cropState) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      if (cropState.stagePointerId !== undefined && cropState.stagePointerId !== null && stage.hasPointerCapture?.(cropState.stagePointerId)) {
        try { stage.releasePointerCapture(cropState.stagePointerId); } catch (_error) {}
      }
      cropState = null;
      releaseObjectUrls();
      stageImage.removeAttribute('src');
      previewCircle.removeAttribute('src');
      zoom.value = '1';
    };

    const openModalForFile = async (file) => {
      if (!file) return;
      releaseObjectUrls();
      activeObjectUrl = URL.createObjectURL(file);
      const image = await loadImageElement(activeObjectUrl);
      stageImage.src = activeObjectUrl;
      previewCircle.src = activeObjectUrl;
      const stageSize = Math.max(1, stage.clientWidth || 320);
      const naturalWidth = image.naturalWidth || image.width || 1;
      const naturalHeight = image.naturalHeight || image.height || 1;
      const baseScale = Math.max(stageSize / naturalWidth, stageSize / naturalHeight);
      cropState = {
        originalFile: file,
        image,
        stage,
        imageElement: stageImage,
        previewElement: previewCircle,
        stageSize,
        baseScale,
        scale: baseScale,
        offsetX: 0,
        offsetY: 0,
        dragStartX: 0,
        dragStartY: 0,
        dragOriginX: 0,
        dragOriginY: 0,
        stagePointerId: null
      };
      zoom.value = '1';
      applyPhotoCropTransforms(cropState);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
    };

    const showPreview = (previewUrl, message) => {
      preview.src = previewUrl;
      previewWrap.classList.remove('hidden');
      previewWrap.classList.add('flex');
      hint.textContent = message || 'Escolheu? Agora é só salvar.';
    };

    input.addEventListener('change', async () => {
      const selected = input.files && input.files[0];
      if (!selected) return;
      submit.disabled = true;
      submit.textContent = 'Preparando foto...';
      hint.textContent = 'Abrindo o ajuste da sua fotinha...';
      try {
        await openModalForFile(selected);
        submit.textContent = 'Salvar foto';
      } catch (_error) {
        releaseObjectUrls();
        previewWrap.classList.add('hidden');
        previewWrap.classList.remove('flex');
        hint.textContent = 'Essa foto tropeçou aqui. Tenta outra imagem rapidinho.';
        input.value = '';
        submit.textContent = 'Salvar foto';
      } finally {
        submit.disabled = false;
      }
    });

    zoom.addEventListener('input', () => {
      if (!cropState) return;
      const zoomFactor = Math.max(1, Number(zoom.value || 1));
      cropState.scale = cropState.baseScale * zoomFactor;
      applyPhotoCropTransforms(cropState);
    });

    stage.addEventListener('pointerdown', (event) => {
      if (!cropState) return;
      cropState.stagePointerId = event.pointerId;
      cropState.dragStartX = event.clientX;
      cropState.dragStartY = event.clientY;
      cropState.dragOriginX = cropState.offsetX || 0;
      cropState.dragOriginY = cropState.offsetY || 0;
      stage.setPointerCapture?.(event.pointerId);
    });

    stage.addEventListener('pointermove', (event) => {
      if (!cropState || cropState.stagePointerId !== event.pointerId) return;
      cropState.offsetX = cropState.dragOriginX + (event.clientX - cropState.dragStartX);
      cropState.offsetY = cropState.dragOriginY + (event.clientY - cropState.dragStartY);
      applyPhotoCropTransforms(cropState);
    });

    const releaseDrag = (event) => {
      if (!cropState || cropState.stagePointerId !== event.pointerId) return;
      if (stage.hasPointerCapture?.(event.pointerId)) {
        try { stage.releasePointerCapture(event.pointerId); } catch (_error) {}
      }
      cropState.stagePointerId = null;
    };
    stage.addEventListener('pointerup', releaseDrag);
    stage.addEventListener('pointercancel', releaseDrag);
    stage.addEventListener('lostpointercapture', () => {
      if (cropState) cropState.stagePointerId = null;
    });

    applyButton.addEventListener('click', async () => {
      if (!cropState) return;
      applyButton.disabled = true;
      applyButton.textContent = 'Preparando...';
      try {
        const prepared = await createPreparedPhotoFromCrop(cropState);
        const transfer = new DataTransfer();
        transfer.items.add(prepared.file);
        input.files = transfer.files;
        if (previewObjectUrl) {
          URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = '';
        }
        showPreview(prepared.previewUrl, 'Boa! Agora ela já está pronta para salvar.');
        closeModal();
      } catch (_error) {
        hint.textContent = 'A foto tropeçou no corte. Tenta de novo rapidinho.';
      } finally {
        applyButton.disabled = false;
        applyButton.textContent = 'Usar essa foto';
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      }
    });

    modalCloseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        input.value = '';
        closeModal();
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && cropState) {
        input.value = '';
        closeModal();
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      }
    });

    window.addEventListener('resize', () => {
      if (!cropState) return;
      const nextStageSize = Math.max(1, stage.clientWidth || cropState.stageSize || 1);
      if (nextStageSize === cropState.stageSize) return;
      const ratio = nextStageSize / Math.max(1, cropState.stageSize || 1);
      cropState.stageSize = nextStageSize;
      cropState.baseScale = Math.max(nextStageSize / (cropState.image.naturalWidth || cropState.image.width || 1), nextStageSize / (cropState.image.naturalHeight || cropState.image.height || 1));
      const zoomFactor = Math.max(1, Number(zoom.value || 1));
      cropState.scale = cropState.baseScale * zoomFactor;
      cropState.offsetX *= ratio;
      cropState.offsetY *= ratio;
      applyPhotoCropTransforms(cropState);
    });

    form.addEventListener('submit', () => {
      submit.disabled = true;
      submit.textContent = 'Subindo foto...';
    });
  }


  function createPinSlotMarkup(maxLength, filledCount) {
    const total = Math.max(1, Number(maxLength || 0) || 6);
    const active = Math.max(0, Math.min(total, Number(filledCount || 0) || 0));
    return Array.from({ length: total }, (_, index) => {
      const filled = index < active;
      return `
        <span class="inline-flex h-3 w-3 rounded-full border transition-all ${filled
          ? 'border-slate-900 bg-slate-900 dark:border-amber-400 dark:bg-amber-400'
          : 'border-slate-300 bg-transparent dark:border-slate-600'}"></span>
      `;
    }).join('');
  }

  function renderPinSlots(container, input) {
    if (!(container instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
    const maxLength = Math.max(1, Number(container.dataset.maxLength || input.maxLength || 6) || 6);
    const digits = String(input.value || '').replace(/\D/g, '').slice(0, maxLength);
    if (digits !== input.value) {
      input.value = digits;
    }
    container.innerHTML = `
      <div class="mx-auto flex w-fit items-center justify-center gap-2">${createPinSlotMarkup(maxLength, digits.length)}</div>
      <div class="mt-2 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">${digits.length}/${maxLength} dígitos</div>
    `;
  }

  function bindPinSlotPreview(container) {
    if (!(container instanceof HTMLElement) || container.dataset.pinSlotsBound === '1') return;
    const inputId = String(container.dataset.inputId || '').trim();
    if (!inputId) return;
    const input = document.getElementById(inputId);
    if (!(input instanceof HTMLInputElement)) return;
    const sync = () => renderPinSlots(container, input);
    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
    container.dataset.pinSlotsBound = '1';
    sync();
  }

  function setupPinVisibilityToggles(root) {
    const scope = root instanceof HTMLElement || root instanceof Document ? root : document;
    scope.querySelectorAll('[data-app-pin-visibility-toggle]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.pinVisibilityBound === '1') return;
      const target = document.getElementById(button.dataset.target || '');
      if (!(target instanceof HTMLInputElement)) return;
      const syncLabel = () => {
        const visible = target.type === 'text';
        button.textContent = visible ? 'Ocultar' : 'Ver';
        button.setAttribute('aria-pressed', visible ? 'true' : 'false');
      };
      button.addEventListener('click', () => {
        target.type = target.type === 'password' ? 'text' : 'password';
        syncLabel();
        target.focus();
        target.setSelectionRange?.(target.value.length, target.value.length);
      });
      button.dataset.pinVisibilityBound = '1';
      syncLabel();
    });
  }

  function resetPinFieldState(root) {
    if (!(root instanceof HTMLElement)) return;
    root.querySelectorAll('input[inputmode="numeric"]').forEach((input) => {
      if (!(input instanceof HTMLInputElement)) return;
      input.value = String(input.value || '').replace(/\D/g, '');
      input.type = 'password';
    });
    root.querySelectorAll('[data-app-pin-visibility-toggle]').forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        button.textContent = 'Ver';
        button.setAttribute('aria-pressed', 'false');
      }
    });
    root.querySelectorAll('[data-pin-slots]').forEach((container) => bindPinSlotPreview(container));
  }

