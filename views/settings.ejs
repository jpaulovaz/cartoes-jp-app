                    <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="current_pin" id="appPinCurrentInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••">
                    <button type="button" data-app-pin-visibility-toggle data-target="appPinCurrentInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500">Ver</button>
                  </div>
                  <div class="mt-3" data-pin-slots data-input-id="appPinCurrentInput" data-max-length="<%= appPinMaxLength %>"></div>
                </label>
              </div>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Novo PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="pin" id="appPinNewInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinNewInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinNewInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Confirmar PIN</span>
                <div class="relative">
                  <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="<%= appPinMaxLength %>" name="pin_confirm" id="appPinConfirmInput" enterkeyhint="done" autocomplete="one-time-code" class="w-full rounded-2xl border border-slate-300 bg-white px-14 py-3.5 text-center text-lg font-black tracking-[0.35em] text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20" placeholder="••••" required>
                  <button type="button" data-app-pin-visibility-toggle data-target="appPinConfirmInput" class="absolute inset-y-0 right-3 inline-flex items-center text-xs font-black uppercase tracking-[0.16em] text-slate-500">Ver</button>
                </div>
                <div class="mt-3" data-pin-slots data-input-id="appPinConfirmInput" data-max-length="<%= appPinMaxLength %>"></div>
              </label>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Depois de quanto tempo travar de novo</span>
                <select name="pin_idle_seconds" id="appPinIdleSelect" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-slate-500 dark:focus:ring-slate-500/20">
                  <% appPinIdleOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= option.selected ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto" data-app-pin-close>Cancelar</button>
                <button type="submit" id="appPinManageSubmit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto">Salvar PIN</button>
              </div>
            </form>
          </div>
        </div>


        <div id="appPinIdleModal" class="fixed inset-0 z-[130] hidden items-center justify-center overflow-y-auto p-4 sm:p-6" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="appPinIdleTitle" aria-describedby="appPinIdleHint">
