
<%- include("partials/header", { title: "AcerttaPay | Configurações" }) %>

<%
  const pendingRequests = Array.isArray(pendingFriendRequests) ? pendingFriendRequests : [];
  const selfProfile = selfPerson || null;
  const contactList = Array.isArray(contacts) ? contacts : (Array.isArray(people) ? people : []);
  const activeFriendCount = contactList.filter(p => p && p.friendship_active).length;
  const discoverableCount = contactList.filter(p => p && p.friendship_state === 'discoverable').length;
  const pendingContactCount = contactList.filter(p => p && (p.friendship_state === 'pending_sent' || p.friendship_state === 'pending_received')).length;
  const localOnlyCount = contactList.filter(p => p && !p.has_app_user).length;
  const readyPixNetworkCount = contactList.filter(p => p && p.friendship_active && p.linked_user_pix_ready).length;
  const pixStateList = Array.isArray(pixStateOptions) ? pixStateOptions : [];
  const getPixStateCode = (entry) => entry && typeof entry === 'object' ? String(entry.code || entry.sigla || '').trim() : String(entry || '').trim();
  const getPixStateName = (entry) => entry && typeof entry === 'object' ? String(entry.name || entry.nome || '').trim() : '';
  const getPixStateLabel = (entry) => {
    const code = getPixStateCode(entry);
    const name = getPixStateName(entry);
    if (code && name) return `${code} · ${name}`;
    return code || name || '';
  };
  const pixStateDefault = pixDefaultState || 'RJ';
  const pixCityDefault = pixDefaultCity || 'Rio de Janeiro';
  const phoneCountryOptionsList = Array.isArray(phoneCountryOptions) ? phoneCountryOptions : [];
  const preferredPhoneCountryOptions = phoneCountryOptionsList.filter((option) => option && option.preferred);
  const otherPhoneCountryOptions = phoneCountryOptionsList.filter((option) => option && !option.preferred);
  const phoneDefaultCountryCode = String(phoneDefaultCountry || 'BR').trim().toUpperCase() || 'BR';
  const selfName = selfProfile?.name || '';
  const selfPhoneCountry = selfProfile?.phone_ui_country || phoneDefaultCountryCode;
  const selfPhone = selfProfile?.phone_ui_national || '';
  const selfPhoneDisplay = selfProfile?.phone_display || '';
  const selfPhoneStored = selfProfile?.phone_e164 || selfPhoneDisplay || '';
  const selfEmail = selfProfile?.email || '';
  const appPinSecurityState = appPinSecurity || {};
  const appPinEnabled = !!appPinSecurityState.enabled;
  const appPinIdleLabel = appPinSecurityState.idleLabel || '1 minuto';
  const appPinIdleOptions = Array.isArray(appPinSecurityState.idleOptions) ? appPinSecurityState.idleOptions : [];
  const appPinMinLength = Number(appPinSecurityState.minLength || 4) || 4;
  const appPinMaxLength = Number(appPinSecurityState.maxLength || 6) || 6;
  const appPasskeyState = appPasskeys || {};
  const appPasskeyItems = Array.isArray(appPasskeyState.items) ? appPasskeyState.items : [];
  const appPasskeyCount = Number(appPasskeyState.count || 0) || 0;
  const appPasskeyMaxCount = Number(appPasskeyState.maxCount || 0) || 0;
  const selfPixEnabled = !!selfProfile?.pix_enabled;
  const selfPixKeyType = selfProfile?.pix_key_type || '';
  const selfPixKeyValueInput = selfProfile?.pix_key_value_input || selfProfile?.pix_key_value || '';
  const selfPixState = selfProfile?.pix_state || pixStateDefault;
  const selfPixCity = selfProfile?.pix_city || pixCityDefault;
  const selfPixLabel = selfProfile?.pix_label || '';
  const signatureMaxLength = Number(profileSignatureMaxLength || 60) || 60;
  const notificationPreferenceState = notificationPreferences || {};
  const automationWhatsappState = automationWhatsapp || {};
  const notificationPreferenceGroups = Array.isArray(notificationPreferenceState.groups) ? notificationPreferenceState.groups : [];
  const notificationPreferenceEnabledCount = Number(notificationPreferenceState.enabledCount || 0) || 0;
  const notificationPreferenceTotalCount = Number(notificationPreferenceState.totalCount || 0) || notificationPreferenceGroups.length;
  const notificationPreferenceCopy = {
    friendship_activity: {
      title: 'Minha Rede',
      description: 'Pedidos, aceites e mudanças na sua rede.'
    },
    shared_debt_new: {
      title: 'Novos acertos',
      description: 'Quando entra um novo acerto ou lembrete.'
    },
    shared_debt_updates: {
      title: 'Respostas dos acertos',
      description: 'Aceites, recusas, revisões e novas respostas.'
    },
    shared_debt_payments: {
      title: 'Pagamentos',
      description: 'Quando alguém avisa pagamento ou confirma recebimento.'
    },
    finance_date_alerts: {
      title: 'Datas do mês',
      description: 'Lembretes das datas marcadas de entradas e saídas.'
    },
    due_date_alerts: {
      title: 'Datas combinadas',
      description: 'Lembretes de acertos avulsos e lembretes privados.'
    },
    monthly_pix_updates: {
      title: 'Pix do mês',
      description: 'Atualizações do Pix informado ou confirmado no mês.'
    },
    card_due_today: {
      title: 'Fatura vencendo',
      description: 'Aviso no dia do vencimento do cartão.'
    }
  };
  const signatureVibeOptions = Array.isArray(profileSignatureVibeOptions) ? profileSignatureVibeOptions : [];
  const signatureVibeMap = new Map(signatureVibeOptions.map((option) => [String(option?.code || '').trim(), option]));
  const getSignatureVibeMeta = (value) => signatureVibeMap.get(String(value || '').trim()) || null;
  const selfSignatureText = String(selfProfile?.profile_signature_text || '').trim();
  const selfSignatureVibe = String(selfProfile?.profile_signature_vibe || '').trim();
  const selfSignatureMeta = getSignatureVibeMeta(selfSignatureVibe);
  const getAvatarUrl = (person) => person && person.photo_url ? String(person.photo_url) : (person && person.linked_user_photo_url && person.friendship_active ? String(person.linked_user_photo_url) : '');
  const getAvatarInitials = (person) => {
    const source = String((person && person.name) || '').trim().split(/\s+/).filter(Boolean).slice(0, 2);
    return source.length ? source.map((part) => part.charAt(0).toUpperCase()).join('') : 'OP';
  };

  const renderPersonStatusChips = (person) => {
    const chips = [];
    const addChip = (classes, label) => {
      chips.push(`<span class="inline-flex w-fit shrink-0 items-center whitespace-nowrap rounded-full border px-3 py-1 text-[11px] font-bold leading-4 ${classes}">${label}</span>`);
    };

    if (!person.is_self) {
      if (person.active) {
        addChip('border-green-200 bg-green-50 text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-200', 'Ativo');
      } else {
        addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Pausado');
      }
    }

    if (!person.is_self && person.friendship_state === 'discoverable' && person.has_app_user) {
      addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'No app');
    }

    if (!person.email) {
      addChip('border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-200', 'Sem e-mail');
    }

    if (person.is_self) {
      if (person.pix_enabled && person.pix_valid) {
        addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'Pix ok');
      } else if (person.pix_enabled && !person.pix_valid) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pendente');
      }
    }

    if (!person.is_self && person.friendship_active) {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Minha Rede');
      if (person.can_share_charge) {
        addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'Pode cobrar');
      } else if (!person.active) {
        addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Acerto pausado');
      }
      if (person.linked_user_pix_ready) {
        addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'Pix ok');
      } else if (person.linked_user_pix_enabled) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pendente');
      } else if (person.has_app_user) {
        addChip('border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300', 'Pix pendente');
      }
    } else if (!person.is_self && person.friendship_state === 'pending_sent') {
      addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pedido enviado');
    } else if (!person.is_self && person.friendship_state === 'pending_received') {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Te chamou');
    }

    return chips.join('');
  };

  const getNetworkState = (person) => {
    if (person && person.friendship_state === 'active') {
      return {
        key: 'friend',
        label: 'Minha Rede',
        summary: 'Já podem dividir e cobrar.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200',
        barClasses: 'from-emerald-400 via-cyan-400 to-cyan-500'
      };
    }

    if (person && person.friendship_state === 'pending_received') {
      return {
        key: 'pending',
        label: 'Te chamou',
        summary: 'Falta você aceitar.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200',
        barClasses: 'from-emerald-400 via-amber-300 to-amber-400'
      };
    }

    if (person && person.friendship_state === 'pending_sent') {
      return {
        key: 'pending',
        label: 'Convite enviado',
        summary: 'Agora é esperar a resposta.',
        badgeClasses: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200',
        barClasses: 'from-amber-300 via-amber-400 to-rose-400'
      };
    }

    if (person && person.friendship_state === 'discoverable') {
      return {
        key: 'discover',
        label: 'No app',
        summary: 'Dá para mandar convite.',
        badgeClasses: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200',
        barClasses: 'from-cyan-400 via-cyan-400 to-cyan-400'
      };
    }

    return {
      key: 'local',
      label: 'Na sua lista',
      summary: 'Só aparece na sua lista.',
      badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300',
      barClasses: 'from-slate-300 via-slate-200 to-slate-400 dark:from-slate-600 dark:via-slate-500 dark:to-slate-700'
    };
  };

  const getPixStateMeta = (person) => {
    if (person && person.friendship_active && person.linked_user_pix_ready) {
      return {
        label: 'Pix ok',
        summary: 'Quando houver pagamento, o app usa o Pix do perfil.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200'
      };
    }

    if (person && person.friendship_active && person.linked_user_pix_enabled) {
      return {
        label: 'Pix pendente',
        summary: 'O Pix foi informado e ainda está em validação.',
        badgeClasses: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
      };
    }

    if (person && person.friendship_active && person.has_app_user) {
      return {
        label: 'Pix pendente',
        summary: 'A amizade está ativa. O Pix ainda não foi configurado.',
        badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300'
      };
    }

    if (person && person.has_app_user) {
      return {
        label: 'Depois da amizade',
        summary: 'Depois da amizade, o Pix passa a vir do perfil.',
        badgeClasses: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200'
      };
    }

    return {
      label: 'Sem Pix por aqui',
      summary: 'Quando esse contato entrar no app, o Pix poderá ser configurado no perfil.',
      badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300'
    };
  };
%>

<%
  const settingsPartialLocals = {
    pendingRequests, selfProfile, contactList, activeFriendCount, discoverableCount, pendingContactCount, localOnlyCount, readyPixNetworkCount,
    preferredPhoneCountryOptions, otherPhoneCountryOptions, phoneDefaultCountryCode, selfName, selfPhoneCountry, selfPhone, selfPhoneDisplay, selfPhoneStored, selfEmail,
    appPinEnabled, appPinIdleLabel, appPinIdleOptions, appPinMinLength, appPinMaxLength, appPasskeyState, appPasskeyItems, appPasskeyCount, appPasskeyMaxCount,
    selfPixEnabled, selfPixKeyType, selfPixKeyValueInput, selfPixState, selfPixCity, selfPixLabel, pixStateList, signatureMaxLength, notificationPreferenceCopy,
    notificationPreferenceEnabledCount, notificationPreferenceGroups, notificationPreferenceTotalCount, automationWhatsappState, signatureVibeOptions, selfSignatureText, selfSignatureVibe, selfSignatureMeta,
    getAvatarUrl, getAvatarInitials, renderPersonStatusChips, getNetworkState, getPixStateMeta, getPixStateCode, getPixStateLabel
  };
%>

<%
  const settingsNavItems = [
    { href: '#profile', label: 'Perfil' },
    { href: '#alerts', label: 'Alertas' },
    { href: '#whatsapp-automation', label: 'WhatsApp' },
    { href: '#pix', label: 'Pix' },
    { href: '#security', label: 'Segurança' },
    { href: '/people#my-profile', label: 'Minha Rede' }
  ];

  const settingsHeroMetaHtml = [
    `<span class="badge">${notificationPreferenceEnabledCount}/${notificationPreferenceTotalCount} alertas ativos</span>`,
    `<span class="badge">${automationWhatsappState.enabled ? 'WhatsApp ativo' : 'WhatsApp desligado'}</span>`,
    `<span class="badge">${selfPixEnabled && selfProfile?.pix_valid ? 'Pix pronto' : (selfPixEnabled ? 'Pix em ajuste' : 'Pix desligado')}</span>`,
    `<span class="badge">${appPinEnabled ? 'PIN ativo' : 'PIN desligado'}</span>`,
    `<span class="badge">${appPasskeyCount}/${appPasskeyMaxCount || 6} aparelho(s)</span>`
  ].join('');
%>

<div class="op-page-shell op-settings-screen-v4 mx-auto max-w-7xl space-y-5">
  <%- include('partials/page-hero', {
    eyebrow: 'Preferências da conta',
    title: 'Configurações',
    subtitle: 'Perfil, alertas, Pix e segurança reunidos com leitura mais clara e operacional.',
    metaHtml: settingsHeroMetaHtml,
    heroClass: 'op-settings-hero-v4'
  }) %>

  <%- include('partials/page-chip-nav', { items: settingsNavItems, shellClass: 'op-settings-chip-nav' }) %>

  <% if (selfProfile) { %>
    <%- include('partials/settings/profile-section', settingsPartialLocals) %>
    <%- include('partials/settings/alerts-section', settingsPartialLocals) %>
    <%- include('partials/settings/whatsapp-automation-section', settingsPartialLocals) %>
    <%- include('partials/settings/pix-section', settingsPartialLocals) %>
    <%- include('partials/settings/security-section', settingsPartialLocals) %>
  <% } %>
</div>
<script>
  const PIX_CITY_SUGGESTIONS_BY_STATE = <%- JSON.stringify(pixCitySuggestionsByState || {}) %>;
  const PIX_ALL_CITY_SUGGESTIONS = <%- JSON.stringify(pixAllCitySuggestions || []) %>;
  const PIX_DEFAULT_STATE = <%- JSON.stringify(pixStateDefault) %>;
  const PIX_DEFAULT_CITY = <%- JSON.stringify(pixCityDefault) %>;
  const PHONE_COUNTRY_OPTIONS = <%- JSON.stringify(phoneCountryOptionsList || []) %>;
  const PHONE_DEFAULT_COUNTRY = <%- JSON.stringify(phoneDefaultCountryCode) %>;
  const PHONE_PLACEHOLDERS = {
    BR: '(21) 99999-9999',
    PT: '912 345 678',
    US: '(201) 555-0123',
    AR: '11 2345-6789',
    MX: '55 1234 5678',
    default: 'Número local ou completo com +'
  };

  function normalizeText(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function getField(prefix, suffix) {
    return document.getElementById(`${prefix}${suffix}`);
  }

  function suggestionText(entry) {
    if (entry && typeof entry === 'object') {
      return String(entry.name || entry.label || entry.value || entry.code || '').trim();
    }
    return String(entry || '').trim();
  }

  function findPixStateByCity(city) {
    const safeCity = normalizeText(city);
    if (!safeCity) return '';
    return Object.entries(PIX_CITY_SUGGESTIONS_BY_STATE).find(([, cities]) =>
      (cities || []).some((entry) => normalizeText(suggestionText(entry)) === safeCity)
    )?.[0] || '';
  }

  function fillPixCitySuggestions(prefix, stateCode) {
    const datalist = document.getElementById(`${prefix}PixCitySuggestions`);
    if (!datalist) return;
    const entries = (stateCode && PIX_CITY_SUGGESTIONS_BY_STATE[stateCode])
      ? PIX_CITY_SUGGESTIONS_BY_STATE[stateCode]
      : PIX_ALL_CITY_SUGGESTIONS;
    datalist.innerHTML = (entries || []).map((city) => {
      const safeCity = suggestionText(city);
      if (!safeCity) return '';
      const option = document.createElement('option');
      option.value = safeCity;
      return option.outerHTML;
    }).join('');
  }

  function updatePixKeyUi(prefix) {
    const typeInput = getField(prefix, 'PixKeyType');
    const keyInput = getField(prefix, 'PixKeyValue');
    const help = getField(prefix, 'PixKeyHelp');
    if (!typeInput || !keyInput || !help) return;

    const type = String(typeInput.value || '').trim();
    keyInput.removeAttribute('maxlength');
    keyInput.inputMode = 'text';
    keyInput.autocapitalize = 'off';

    if (type === 'phone') {
      keyInput.placeholder = 'Ex.: 21999999999';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 15;
      help.textContent = 'Informe DDD + número, com ou sem máscara. O código do país é tratado automaticamente.';
      return;
    }

    if (type === 'cpf') {
      keyInput.placeholder = 'Ex.: 12345678900';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 14;
      help.textContent = 'Pode colar com ou sem pontuação. A limpeza acontece automaticamente.';
      return;
    }

    if (type === 'cnpj') {
      keyInput.placeholder = 'Ex.: 12345678000190';
      keyInput.inputMode = 'numeric';
      keyInput.maxLength = 18;
      help.textContent = 'Pode colar com ou sem pontuação. A limpeza acontece automaticamente.';
      return;
    }

    if (type === 'email') {
      keyInput.placeholder = 'Ex.: joao@email.com';
      help.textContent = 'Informe o e-mail completo cadastrado no banco.';
      return;
    }

    if (type === 'evp') {
      keyInput.placeholder = 'Ex.: 123e4567-e89b-12d3-a456-426614174000';
      help.textContent = 'Cole a chave aleatória completa.';
      return;
    }

    keyInput.placeholder = 'Ex.: 21999999999';
    help.textContent = 'Informe DDD + número, com ou sem máscara. O código do país é tratado automaticamente.';
  }

  function updatePixCityUi(prefix, forceCity = false) {
    const stateInput = getField(prefix, 'PixState');
    const cityInput = getField(prefix, 'PixCity');
    if (!stateInput || !cityInput) return;

    const stateCode = String(stateInput.value || '').trim();
    fillPixCitySuggestions(prefix, stateCode);

    const suggestions = (PIX_CITY_SUGGESTIONS_BY_STATE[stateCode] || []).map(suggestionText).filter(Boolean);
    const currentCity = String(cityInput.value || '').trim();
    if (!currentCity) {
      if (forceCity) {
        cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
      }
      return;
    }

    if (forceCity && suggestions.length && !suggestions.includes(currentCity)) {
      cityInput.value = suggestions[0] || PIX_DEFAULT_CITY;
    }
  }

  function getPhoneUi(prefix) {
    return {
      country: getField(prefix, 'PhoneCountry'),
      phone: getField(prefix, 'Phone'),
      hint: getField(prefix, 'PhoneHint')
    };
  }

  function getSelectedPhoneCountryOption(countryCode) {
    return PHONE_COUNTRY_OPTIONS.find((option) => String(option?.code || '') === String(countryCode || '')) || null;
  }

  function formatBrazilPhoneInput(value) {
    const digits = String(value || '').replace(/\D/g, '').slice(0, 11);
    if (!digits) return '';
    if (digits.length <= 2) return digits;
    if (digits.length <= 6) return `(${digits.slice(0, 2)}) ${digits.slice(2)}`;
    if (digits.length <= 10) return `(${digits.slice(0, 2)}) ${digits.slice(2, 6)}-${digits.slice(6)}`;
    return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
  }

  function sanitizePhoneInputValue(countryCode, value) {
    const raw = String(value || '');
    if (!raw.trim()) return '';
    if (raw.trim().startsWith('+')) {
      return raw.replace(/[^\d+\s()-]/g, '').replace(/\s{2,}/g, ' ').trimStart();
    }
    if (String(countryCode || '').toUpperCase() === 'BR') {
      return formatBrazilPhoneInput(raw);
    }
    return raw.replace(/[^\d\s()-]/g, '').replace(/\s{2,}/g, ' ').trimStart();
  }

  function updatePhoneUi(prefix) {
    const { country, phone, hint } = getPhoneUi(prefix);
    if (!country || !phone) return;

    const countryCode = String(country.value || PHONE_DEFAULT_COUNTRY).trim().toUpperCase() || PHONE_DEFAULT_COUNTRY;
    const option = getSelectedPhoneCountryOption(countryCode);
    const countryLabel = option ? `${option.flag} +${option.callingCode}` : '🌍';

    phone.placeholder = PHONE_PLACEHOLDERS[countryCode] || PHONE_PLACEHOLDERS.default;
    phone.inputMode = 'tel';
    phone.autocomplete = 'tel-national';
    phone.value = sanitizePhoneInputValue(countryCode, phone.value);

    if (hint) {
      hint.textContent = countryCode === 'BR'
        ? `DDI ${countryLabel} já fica com você. Aqui entra DDD + celular, com ou sem máscara.`
        : `O DDI ${countryLabel} vai pelo seletor. Aqui você pode digitar só o número local ou colar o telefone completo com +.`;
    }
  }

  function bindPhoneField(prefix) {
    const { country, phone } = getPhoneUi(prefix);
    if (!country || !phone || country.dataset.phoneBound === 'true') return;

    country.dataset.phoneBound = 'true';
    phone.addEventListener('input', () => updatePhoneUi(prefix));
    country.addEventListener('change', () => updatePhoneUi(prefix));
    updatePhoneUi(prefix);
  }

  const SELF_IDENTITY_DEFAULT = {
    name: <%- JSON.stringify(selfName || '') %>,
    phoneCountry: <%- JSON.stringify(selfPhoneCountry || phoneDefaultCountryCode) %>,
    phone: <%- JSON.stringify(selfPhone || '') %>,
    email: <%- JSON.stringify(selfEmail || '') %>
  };

  function populateSelfIdentityForm(values = SELF_IDENTITY_DEFAULT) {
    const name = getField('self', 'Name');
    const phoneCountry = getField('self', 'PhoneCountry');
    const phone = getField('self', 'Phone');
    const email = getField('self', 'Email');

    if (name) name.value = values.name || '';
    if (phoneCountry) phoneCountry.value = values.phoneCountry || PHONE_DEFAULT_COUNTRY;
    if (phone) phone.value = values.phone || '';
    if (email) email.value = values.email || '';
    updatePhoneUi('self');
  }
  function setSelfIdentityEditMode() {
    populateSelfIdentityForm();
  }

  function toggleSelfIdentityEdit() {
    populateSelfIdentityForm();
    requestAnimationFrame(() => {
      const name = getField('self', 'Name');
      name?.focus();
      name?.select?.();
    });
  }

  function resetSelfIdentityForm() {
    populateSelfIdentityForm();
  }

