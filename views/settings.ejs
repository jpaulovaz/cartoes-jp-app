
<%- include("partials/header", { title: "AcerttaPay | Configurações" }) %>

<%
  const pendingRequests = Array.isArray(pendingFriendRequests) ? pendingFriendRequests : [];
  const selfProfile = selfPerson || null;
  const contactList = Array.isArray(contacts) ? contacts : (Array.isArray(people) ? people : []);
  const activeFriendCount = contactList.filter(p => p && p.friendship_active).length;
  const discoverableCount = contactList.filter(p => p && p.friendship_state === 'discoverable').length;
  const pendingContactCount = contactList.filter(p => p && (p.friendship_state === 'pending_sent' || p.friendship_state === 'pending_received')).length;
  const localOnlyCount = contactList.filter(p => p && !p.has_app_user).length;
  const readyPixNetworkCount = contactList.filter(p => p && p.friendship_active && p.linked_user_pix_ready).length;
  const pixStateList = Array.isArray(pixStateOptions) ? pixStateOptions : [];
  const getPixStateCode = (entry) => entry && typeof entry === 'object' ? String(entry.code || entry.sigla || '').trim() : String(entry || '').trim();
  const getPixStateName = (entry) => entry && typeof entry === 'object' ? String(entry.name || entry.nome || '').trim() : '';
  const getPixStateLabel = (entry) => {
    const code = getPixStateCode(entry);
    const name = getPixStateName(entry);
    if (code && name) return `${code} · ${name}`;
    return code || name || '';
  };
  const pixStateDefault = pixDefaultState || 'RJ';
  const pixCityDefault = pixDefaultCity || 'Rio de Janeiro';
  const phoneCountryOptionsList = Array.isArray(phoneCountryOptions) ? phoneCountryOptions : [];
  const preferredPhoneCountryOptions = phoneCountryOptionsList.filter((option) => option && option.preferred);
  const otherPhoneCountryOptions = phoneCountryOptionsList.filter((option) => option && !option.preferred);
  const phoneDefaultCountryCode = String(phoneDefaultCountry || 'BR').trim().toUpperCase() || 'BR';
  const selfName = selfProfile?.name || '';
  const selfPhoneCountry = selfProfile?.phone_ui_country || phoneDefaultCountryCode;
  const selfPhone = selfProfile?.phone_ui_national || '';
  const selfPhoneDisplay = selfProfile?.phone_display || '';
  const selfPhoneStored = selfProfile?.phone_e164 || selfPhoneDisplay || '';
  const selfEmail = selfProfile?.email || '';
  const appPinSecurityState = appPinSecurity || {};
  const appPinEnabled = !!appPinSecurityState.enabled;
  const appPinIdleLabel = appPinSecurityState.idleLabel || '1 minuto';
  const appPinIdleOptions = Array.isArray(appPinSecurityState.idleOptions) ? appPinSecurityState.idleOptions : [];
  const appPinMinLength = Number(appPinSecurityState.minLength || 4) || 4;
  const appPinMaxLength = Number(appPinSecurityState.maxLength || 6) || 6;
  const appPasskeyState = appPasskeys || {};
  const appPasskeyItems = Array.isArray(appPasskeyState.items) ? appPasskeyState.items : [];
  const appPasskeyCount = Number(appPasskeyState.count || 0) || 0;
  const appPasskeyMaxCount = Number(appPasskeyState.maxCount || 0) || 0;
  const selfPixEnabled = !!selfProfile?.pix_enabled;
  const selfPixKeyType = selfProfile?.pix_key_type || '';
  const selfPixKeyValueInput = selfProfile?.pix_key_value_input || selfProfile?.pix_key_value || '';
  const selfPixState = selfProfile?.pix_state || pixStateDefault;
  const selfPixCity = selfProfile?.pix_city || pixCityDefault;
  const selfPixLabel = selfProfile?.pix_label || '';
  const signatureMaxLength = Number(profileSignatureMaxLength || 60) || 60;
  const notificationPreferenceState = notificationPreferences || {};
  const notificationPreferenceGroups = Array.isArray(notificationPreferenceState.groups) ? notificationPreferenceState.groups : [];
  const notificationPreferenceEnabledCount = Number(notificationPreferenceState.enabledCount || 0) || 0;
  const notificationPreferenceTotalCount = Number(notificationPreferenceState.totalCount || 0) || notificationPreferenceGroups.length;
  const notificationPreferenceCopy = {
    friendship_activity: {
      title: 'Amizades',
      description: 'Pedidos, aceites e mudanças por aqui.'
    },
    shared_debt_new: {
      title: 'Novas cobranças',
      description: 'Quando chega cobrança, envio ou lembrete novo.'
    },
    shared_debt_updates: {
      title: 'Respostas de cobranças',
      description: 'Atualizações, aceites, recusas e revisões.'
    },
    shared_debt_payments: {
      title: 'Pagamentos',
      description: 'Quando alguém marca ou confirma pagamento.'
    },
    finance_date_alerts: {
      title: 'Datas do mês',
      description: 'Quando chega o dia marcado da grana que entra ou sai.'
    },
    due_date_alerts: {
      title: 'Datas combinadas',
      description: 'Lembretes automáticos quando uma cobrança avulsa ou lembrete privado bate na data.'
    },
    monthly_pix_updates: {
      title: 'Pix do mês',
      description: 'Pix informado, confirmado ou revisado.'
    },
    card_due_today: {
      title: 'Fatura vencendo',
      description: 'Lembrete no dia do vencimento do cartão.'
    }
  };
  const signatureVibeOptions = Array.isArray(profileSignatureVibeOptions) ? profileSignatureVibeOptions : [];
  const signatureVibeMap = new Map(signatureVibeOptions.map((option) => [String(option?.code || '').trim(), option]));
  const getSignatureVibeMeta = (value) => signatureVibeMap.get(String(value || '').trim()) || null;
  const selfSignatureText = String(selfProfile?.profile_signature_text || '').trim();
  const selfSignatureVibe = String(selfProfile?.profile_signature_vibe || '').trim();
  const selfSignatureMeta = getSignatureVibeMeta(selfSignatureVibe);
  const getAvatarUrl = (person) => person && person.photo_url ? String(person.photo_url) : (person && person.linked_user_photo_url && person.friendship_active ? String(person.linked_user_photo_url) : '');
  const getAvatarInitials = (person) => {
    const source = String((person && person.name) || '').trim().split(/\s+/).filter(Boolean).slice(0, 2);
    return source.length ? source.map((part) => part.charAt(0).toUpperCase()).join('') : 'OP';
  };

  const renderPersonStatusChips = (person) => {
    const chips = [];
    const addChip = (classes, label) => {
      chips.push(`<span class="inline-flex w-fit shrink-0 items-center whitespace-nowrap rounded-full border px-3 py-1 text-[11px] font-bold leading-4 ${classes}">${label}</span>`);
    };

    if (!person.is_self) {
      if (person.active) {
        addChip('border-green-200 bg-green-50 text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-200', 'Ativo');
      } else {
        addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Pausado');
      }
    }

    if (!person.is_self && person.friendship_state === 'discoverable' && person.has_app_user) {
      addChip('border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200', 'No app');
    }

    if (!person.email) {
      addChip('border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-200', 'Sem e-mail');
    }

    if (person.is_self) {
      if (person.pix_enabled && person.pix_valid) {
        addChip('border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200', 'Pix ok');
      } else if (person.pix_enabled && !person.pix_valid) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pendente');
      }
    }

    if (!person.is_self && person.friendship_active) {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Amigos');
      if (person.can_share_charge) {
        addChip('border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200', 'Pode cobrar');
      } else if (!person.active) {
        addChip('border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300', 'Cobrança pausada');
      }
      if (person.linked_user_pix_ready) {
        addChip('border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200', 'Pix ok');
      } else if (person.linked_user_pix_enabled) {
        addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pix pendente');
      } else if (person.has_app_user) {
        addChip('border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300', 'Pix pendente');
      }
    } else if (!person.is_self && person.friendship_state === 'pending_sent') {
      addChip('border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200', 'Pedido enviado');
    } else if (!person.is_self && person.friendship_state === 'pending_received') {
      addChip('border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200', 'Te chamou');
    }

    return chips.join('');
  };

  const getNetworkState = (person) => {
    if (person && person.friendship_state === 'active') {
      return {
        key: 'friend',
        label: 'Amigos',
        summary: 'Já podem dividir e cobrar.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200',
        barClasses: 'from-emerald-400 via-cyan-400 to-sky-500'
      };
    }

    if (person && person.friendship_state === 'pending_received') {
      return {
        key: 'pending',
        label: 'Te chamou',
        summary: 'Falta você aceitar.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200',
        barClasses: 'from-emerald-400 via-amber-300 to-orange-400'
      };
    }

    if (person && person.friendship_state === 'pending_sent') {
      return {
        key: 'pending',
        label: 'Convite enviado',
        summary: 'Agora é esperar a resposta.',
        badgeClasses: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200',
        barClasses: 'from-amber-300 via-orange-400 to-rose-400'
      };
    }

    if (person && person.friendship_state === 'discoverable') {
      return {
        key: 'discover',
        label: 'No app',
        summary: 'Dá para mandar convite.',
        badgeClasses: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200',
        barClasses: 'from-sky-400 via-cyan-400 to-violet-400'
      };
    }

    return {
      key: 'local',
      label: 'Na sua lista',
      summary: 'Só aparece na sua lista.',
      badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300',
      barClasses: 'from-slate-300 via-slate-200 to-slate-400 dark:from-slate-600 dark:via-slate-500 dark:to-slate-700'
    };
  };

  const getPixStateMeta = (person) => {
    if (person && person.friendship_active && person.linked_user_pix_ready) {
      return {
        label: 'Pix ok',
        summary: 'Quando rolar pagamento, vai no Pix do perfil.',
        badgeClasses: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200'
      };
    }

    if (person && person.friendship_active && person.linked_user_pix_enabled) {
      return {
        label: 'Pix pendente',
        summary: 'O Pix foi ligado, mas ainda não ficou pronto.',
        badgeClasses: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
      };
    }

    if (person && person.friendship_active && person.has_app_user) {
      return {
        label: 'Pix pendente',
        summary: 'A amizade vale; o Pix ainda falta.',
        badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300'
      };
    }

    if (person && person.has_app_user) {
      return {
        label: 'Depois da amizade',
        summary: 'Depois da amizade, o Pix vem do perfil.',
        badgeClasses: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200'
      };
    }

    return {
      label: 'Sem Pix por aqui',
      summary: 'Se ela entrar no app, cadastra o Pix do lado de lá.',
      badgeClasses: 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300'
    };
  };
%>


<div class="mx-auto max-w-7xl">
  <section class="op-page-hero op-fade-up mb-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span class="op-page-hero__eyebrow">Seu jeito no app</span>
        <h1 class="op-page-hero__title mt-4">Configurações</h1>
        <p class="op-page-hero__subtitle mt-3">Perfil, alertas, Pix e segurança agora ficam em uma casa só, sem bagunçar a parte social da sua rede.</p>
      </div>
    </div>
  </section>

  <div class="mb-8 flex flex-wrap gap-3">
    <a href="#profile" class="inline-flex items-center gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm font-bold text-amber-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-amber-100/80 dark:border-amber-900 dark:bg-amber-900/20 dark:text-amber-200 dark:hover:bg-amber-900/35"><span>👤</span>Perfil</a>
    <a href="#alerts" class="inline-flex items-center gap-2 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-2.5 text-sm font-bold text-sky-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-sky-100/80 dark:border-sky-900 dark:bg-sky-900/20 dark:text-sky-200 dark:hover:bg-sky-900/35"><span>🔔</span>Alertas</a>
    <a href="#pix" class="inline-flex items-center gap-2 rounded-2xl border border-violet-200 bg-violet-50 px-4 py-2.5 text-sm font-bold text-violet-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-violet-100/80 dark:border-violet-900 dark:bg-violet-900/20 dark:text-violet-200 dark:hover:bg-violet-900/35"><span>💜</span>Pix</a>
    <a href="#security" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"><span>🔐</span>Segurança</a>
    <a href="/people#my-profile" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"><span>🫶</span>Voltar para amigos</a>
  </div>

  <% if (selfProfile) { %>
    <section id="profile" class="scroll-mt-28 mb-8 grid gap-6 xl:grid-cols-[minmax(0,1.02fr)_minmax(340px,0.98fr)] xl:items-start">
      <div class="rounded-[32px] border border-amber-200 bg-white shadow-sm dark:border-amber-900/50 dark:bg-slate-800">
        <div class="border-b border-amber-100 px-5 py-5 dark:border-amber-900/40 sm:px-6 sm:py-6">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">Perfil</div>
          <h2 class="mt-2 text-xl font-black text-slate-900 dark:text-white">Edite seu perfil do seu jeitinho</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Nome, telefone e e-mail ficam abertos para ajuste aqui, na página que nasceu para isso.</p>
        </div>
        <div id="selfIdentityShell" class="border-t border-amber-100 p-5 dark:border-amber-900/40 sm:p-6">
          <form method="post" action="/people" id="selfIdentityForm" class="space-y-4" autocomplete="on">
            <input type="hidden" name="id" id="selfPersonId" value="<%= selfProfile.id %>">
            <input type="hidden" name="profile_section" value="identity">
            <input type="hidden" name="return_to" value="/settings#profile">

            <label class="block">
              <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Nome exibido</span>
              <input name="name" id="selfName" value="<%- selfName %>" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="Seu nome no app" required>
            </label>

            <div class="grid gap-4">
              <div class="min-w-0">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">País e telefone</span>
                <div class="grid gap-3 sm:grid-cols-3">
                  <div class="sm:col-span-1">
                    <select name="phone_country" id="selfPhoneCountry" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" autocomplete="tel-country-code">
                      <% if (preferredPhoneCountryOptions.length) { %>
                        <optgroup label="Mais usados">
                          <% preferredPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === selfPhoneCountry ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                      <% if (otherPhoneCountryOptions.length) { %>
                        <optgroup label="Todos os países">
                          <% otherPhoneCountryOptions.forEach((option) => { %>
                            <option value="<%= option.code %>" <%= option.code === selfPhoneCountry ? 'selected' : '' %>><%= option.label %></option>
                          <% }) %>
                        </optgroup>
                      <% } %>
                    </select>
                  </div>
                  <div class="sm:col-span-2">
                    <div class="relative min-w-0">
                      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                      </div>
                      <input name="phone" id="selfPhone" value="<%- selfPhone %>" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="(21) 99999-9999" inputmode="tel" autocomplete="tel-national">
                    </div>
                  </div>
                </div>
              </div>

              <label class="block">
                <span class="mb-2 block text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">E-mail visível</span>
                <div class="relative min-w-0">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-16 8h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                  </div>
                  <input name="email" id="selfEmail" type="email" value="<%- selfEmail %>" class="w-full rounded-2xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 font-medium text-slate-900 shadow-sm transition-all outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-100 dark:border-slate-600 dark:bg-slate-950 dark:text-white dark:focus:border-amber-500 dark:focus:ring-amber-500/20" placeholder="email@exemplo.com">
                </div>
              </label>
            </div>

            <div class="rounded-[24px] border border-sky-100 bg-sky-50/80 px-4 py-3.5 text-sm font-medium leading-6 text-slate-600 shadow-sm dark:border-sky-900/50 dark:bg-sky-950/20 dark:text-slate-300">
              Essas infos aparecem no clima de perfil: ajudam você a ser reconhecido nas divisões e deixam a conversa das cobranças com mais cara de gente de verdade, não de cadastro perdido no rolê.
            </div>

            <div class="pt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
              <button type="button" id="selfIdentityCancel" onclick="resetSelfIdentityForm()" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-600 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto">Cancelar</button>
              <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-black text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 sm:w-auto">Salvar alterações</button>
            </div>
          </form>
        </div>
      </div>
      <div class="grid gap-6">
        <section class="rounded-[32px] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Resumo rápido</div>
              <h3 class="mt-2 text-xl font-black text-slate-900 dark:text-white">Como seu app está hoje</h3>
            </div>
            <p class="max-w-sm text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Os quatro atalhos ficam aqui do ladinho para você bater o olho e entender como a conta está se comportando.</p>
          </div>
          <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-[22px] border border-slate-200 bg-slate-50/80 px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Alertas</div>
              <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= notificationPreferenceEnabledCount %>/<%= notificationPreferenceTotalCount %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Grupos ligados.</p>
            </div>
            <div class="rounded-[22px] border border-violet-200/70 bg-violet-50/80 px-4 py-3 shadow-sm dark:border-violet-900/50 dark:bg-violet-950/20">
              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600 dark:text-violet-300">Pix</div>
              <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= selfProfile.pix_enabled && selfProfile.pix_valid ? 'Pronto' : (selfProfile.pix_enabled ? 'Ajustar' : 'Desligado') %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">Recebimento por aqui.</p>
