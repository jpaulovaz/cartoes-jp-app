function bindNetworkDiscoveryControls() {
  const cards = Array.from(document.querySelectorAll('[data-person-card]'));
  const searchInput = document.getElementById('networkSearch');
  const filterButtons = Array.from(document.querySelectorAll('[data-network-filter]'));
  const counter = document.getElementById('networkVisibleCounter');
  const emptyState = document.getElementById('networkFilteredEmpty');
  if (!cards.length) return;

  let activeFilter = 'all';

  const render = () => {
    const searchTerm = normalizeText(searchInput?.value || '');
    let visibleCount = 0;

    cards.forEach((card) => {
      const filterState = String(card.dataset.filterState || 'all');
      const searchableText = normalizeText(card.dataset.searchText || '');
      const matchesFilter = activeFilter === 'all' || filterState === activeFilter;
      const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
      const isVisible = matchesFilter && matchesSearch;
      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      updateNetworkFilterButtonState(button, String(button.dataset.networkFilter || '') === activeFilter);
    });

    if (counter) {
      counter.textContent = visibleCount === 1 ? '1 pessoa aparecendo' : `${visibleCount} pessoas aparecendo`;
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = String(button.dataset.networkFilter || 'all');
      render();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', render);
  }

  render();
}

function bindProfileSignatureForm() {
  const textInput = document.getElementById('profileSignatureText');
  const vibeInput = document.getElementById('profileSignatureVibe');
  const counter = document.getElementById('profileSignatureCount');
  const previewText = document.getElementById('profileSignaturePreviewText');
  const previewVibe = document.getElementById('profileSignaturePreviewVibe');
  const vibeButtons = Array.from(document.querySelectorAll('[data-signature-vibe-option]'));
  if (!textInput || !vibeInput || !previewText || !previewVibe || !vibeButtons.length) return;

  const selectedClasses = ['border-cyan-600', 'bg-cyan-600', 'text-white', 'shadow-lg', 'shadow-cyan-500/15', 'dark:border-cyan-400', 'dark:bg-cyan-400', 'dark:text-slate-950'];
  const idleClasses = ['border-slate-200', 'bg-white', 'text-slate-600', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-slate-300'];

  const sanitizeTextLive = (value) => String(value || '')
    .replace(/[\r\n]+/g, ' ')
    .replace(/[ 	]{2,}/g, ' ')
    .replace(/^\s+/g, '');
  const sanitizeTextSubmit = (value) => sanitizeTextLive(value).trim();

  const render = () => {
    textInput.value = sanitizeTextLive(textInput.value).slice(0, Number(textInput.maxLength || 60));
    if (counter) {
      counter.textContent = `${textInput.value.length}/${textInput.maxLength || 60}`;
    }

    const activeVibeCode = String(vibeInput.value || '').trim();
    const activeButton = vibeButtons.find((button) => String(button.dataset.vibeCode || '') === activeVibeCode) || null;

    vibeButtons.forEach((button) => {
      const isActive = button === activeButton;
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      button.classList.toggle('hover:border-cyan-200', !isActive);
      button.classList.toggle('hover:bg-cyan-50', !isActive);
      button.classList.toggle('hover:text-cyan-700', !isActive);
      button.classList.toggle('dark:hover:border-cyan-800', !isActive);
      button.classList.toggle('dark:hover:bg-cyan-900/20', !isActive);
      button.classList.toggle('dark:hover:text-cyan-200', !isActive);
      selectedClasses.forEach((className) => button.classList.toggle(className, isActive));
      idleClasses.forEach((className) => button.classList.toggle(className, !isActive));
    });

    if (activeButton) {
      previewVibe.textContent = activeButton.textContent.trim();
      previewVibe.classList.remove('hidden');
    } else {
      previewVibe.textContent = '';
      previewVibe.classList.add('hidden');
    }

    previewText.textContent = textInput.value || 'Quando você salvar uma assinatura, ela aparece para quem já está na sua rede.';
  };

  vibeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const nextCode = String(button.dataset.vibeCode || '').trim();
      vibeInput.value = vibeInput.value === nextCode ? '' : nextCode;
      render();
    });
  });


  textInput.addEventListener('input', render);
  const form = document.getElementById('profileSignatureForm');
  if (form) {
    form.addEventListener('submit', () => {
      textInput.value = sanitizeTextSubmit(textInput.value).slice(0, Number(textInput.maxLength || 60));
    });
  }

  render();
}

function bindPixForm(prefix, options = {}) {
    const stateInput = getField(prefix, 'PixState');
    const keyTypeInput = getField(prefix, 'PixKeyType');
    const cityInput = getField(prefix, 'PixCity');

    if (stateInput) {
      stateInput.addEventListener('change', () => updatePixCityUi(prefix, true));
    }

    if (keyTypeInput) {
      keyTypeInput.addEventListener('change', () => updatePixKeyUi(prefix));
    }

    if (cityInput) {
      cityInput.addEventListener('blur', () => {
        const guessedState = findPixStateByCity(cityInput.value);
        if (guessedState && stateInput && !stateInput.value) {
          stateInput.value = guessedState;
          updatePixCityUi(prefix, false);
        }
      });
    }

    updatePixKeyUi(prefix);
    updatePixCityUi(prefix, !!options.forceCity);
  }

  async function readFileAsDataUrl(sourceFile) {
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('Não consegui ler essa imagem.'));
      reader.readAsDataURL(sourceFile);
    });
  }

  function loadImageElement(src) {
    return new Promise((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error('Não foi possível carregar a imagem.'));
      image.src = src;
    });
  }

  function clampPhotoCropOffset(state) {
    if (!state || !state.image) return;
    const stageSize = Math.max(1, state.stageSize || 1);
    const displayedWidth = (state.image.naturalWidth || state.image.width || 1) * state.scale;
    const displayedHeight = (state.image.naturalHeight || state.image.height || 1) * state.scale;
    const maxOffsetX = Math.max(0, (displayedWidth - stageSize) / 2);
    const maxOffsetY = Math.max(0, (displayedHeight - stageSize) / 2);
    state.offsetX = Math.max(-maxOffsetX, Math.min(maxOffsetX, state.offsetX || 0));
    state.offsetY = Math.max(-maxOffsetY, Math.min(maxOffsetY, state.offsetY || 0));
  }

  function applyPhotoCropTransforms(state) {
    if (!state || !state.stage || !state.imageElement || !state.previewElement || !state.image) return;
    const stageSize = Math.max(1, state.stage.clientWidth || state.stageSize || 1);
    state.stageSize = stageSize;
    clampPhotoCropOffset(state);
    const stageTransform = `translate(-50%, -50%) translate(${state.offsetX}px, ${state.offsetY}px) scale(${state.scale})`;
    state.imageElement.style.transform = stageTransform;
    const previewBox = Math.max(1, state.previewElement.parentElement?.clientWidth || 112);
    const previewRatio = previewBox / stageSize;
    const previewTransform = `translate(-50%, -50%) translate(${state.offsetX * previewRatio}px, ${state.offsetY * previewRatio}px) scale(${state.scale * previewRatio})`;
    state.previewElement.style.transform = previewTransform;
  }

  async function createPreparedPhotoFromCrop(state) {
    const stageSize = Math.max(1, state.stageSize || state.stage.clientWidth || 1);
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    const factor = 512 / stageSize;
    ctx.scale(factor, factor);
    const naturalWidth = state.image.naturalWidth || state.image.width || 1;
    const naturalHeight = state.image.naturalHeight || state.image.height || 1;
    const displayedWidth = naturalWidth * state.scale;
    const displayedHeight = naturalHeight * state.scale;
    const x = (stageSize / 2) + state.offsetX - (displayedWidth / 2);
    const y = (stageSize / 2) + state.offsetY - (displayedHeight / 2);
    ctx.drawImage(state.image, x, y, displayedWidth, displayedHeight);

    const blob = await new Promise((resolve, reject) => {
      canvas.toBlob((value) => value ? resolve(value) : reject(new Error('Não consegui preparar a foto.')), 'image/jpeg', 0.9);
    });

    return {
      file: new File([blob], ((state.originalFile?.name || 'perfil').replace(/\.[^.]+$/, '') || 'perfil') + '.jpg', { type: 'image/jpeg' }),
      previewUrl: canvas.toDataURL('image/jpeg', 0.9)
    };
  }

  function bindProfilePhotoForm() {
    const form = document.getElementById('profilePhotoForm');
    const input = document.getElementById('profilePhotoInput');
    const submit = document.getElementById('profilePhotoSubmit');
    const previewWrap = document.getElementById('profilePhotoPreviewWrap');
    const preview = document.getElementById('profilePhotoPreview');
    const hint = document.getElementById('profilePhotoHint');
    const modal = document.getElementById('profilePhotoCropModal');
    const stage = document.getElementById('profilePhotoCropStage');
    const stageImage = document.getElementById('profilePhotoCropImage');
    const previewCircle = document.getElementById('profilePhotoCropPreview');
    const zoom = document.getElementById('profilePhotoCropZoom');
    const applyButton = document.getElementById('profilePhotoCropApply');
    const modalCloseButtons = Array.from(document.querySelectorAll('[data-profile-photo-modal-close]'));
    if (!form || !input || !submit || !previewWrap || !preview || !hint || !modal || !stage || !stageImage || !previewCircle || !zoom || !applyButton) return;

    let cropState = null;
    let activeObjectUrl = '';
    let previewObjectUrl = '';

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const releaseObjectUrls = () => {
      if (activeObjectUrl) {
        URL.revokeObjectURL(activeObjectUrl);
        activeObjectUrl = '';
      }
      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
        previewObjectUrl = '';
      }
    };

    const closeModal = () => {
      if (!cropState) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      if (cropState.stagePointerId !== undefined && cropState.stagePointerId !== null && stage.hasPointerCapture?.(cropState.stagePointerId)) {
        try { stage.releasePointerCapture(cropState.stagePointerId); } catch (_error) {}
      }
      cropState = null;
      releaseObjectUrls();
      stageImage.removeAttribute('src');
      previewCircle.removeAttribute('src');
      zoom.value = '1';
    };

    const openModalForFile = async (file) => {
      if (!file) return;
      releaseObjectUrls();
      activeObjectUrl = URL.createObjectURL(file);
      const image = await loadImageElement(activeObjectUrl);
      stageImage.src = activeObjectUrl;
      previewCircle.src = activeObjectUrl;
      const stageSize = Math.max(1, stage.clientWidth || 320);
      const naturalWidth = image.naturalWidth || image.width || 1;
      const naturalHeight = image.naturalHeight || image.height || 1;
      const baseScale = Math.max(stageSize / naturalWidth, stageSize / naturalHeight);
      cropState = {
        originalFile: file,
        image,
        stage,
        imageElement: stageImage,
        previewElement: previewCircle,
        stageSize,
        baseScale,
        scale: baseScale,
        offsetX: 0,
        offsetY: 0,
        dragStartX: 0,
        dragStartY: 0,
        dragOriginX: 0,
        dragOriginY: 0,
        stagePointerId: null
      };
      zoom.value = '1';
      applyPhotoCropTransforms(cropState);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
    };

    const showPreview = (previewUrl, message) => {
      preview.src = previewUrl;
      previewWrap.classList.remove('hidden');
      previewWrap.classList.add('flex');
      hint.textContent = message || 'Escolheu? Agora é só salvar.';
    };

    input.addEventListener('change', async () => {
      const selected = input.files && input.files[0];
      if (!selected) return;
      submit.disabled = true;
      submit.textContent = 'Preparando foto...';
      hint.textContent = 'Abrindo o ajuste da sua foto...';
      try {
        await openModalForFile(selected);
        submit.textContent = 'Salvar foto';
      } catch (_error) {
        releaseObjectUrls();
        previewWrap.classList.add('hidden');
        previewWrap.classList.remove('flex');
        hint.textContent = 'Não foi possível carregar a foto. Tente outra imagem.';
        input.value = '';
        submit.textContent = 'Salvar foto';
      } finally {
        submit.disabled = false;
      }
    });

    zoom.addEventListener('input', () => {
      if (!cropState) return;
      const zoomFactor = Math.max(1, Number(zoom.value || 1));
      cropState.scale = cropState.baseScale * zoomFactor;
      applyPhotoCropTransforms(cropState);
    });

    stage.addEventListener('pointerdown', (event) => {
      if (!cropState) return;
      cropState.stagePointerId = event.pointerId;
      cropState.dragStartX = event.clientX;
      cropState.dragStartY = event.clientY;
      cropState.dragOriginX = cropState.offsetX || 0;
      cropState.dragOriginY = cropState.offsetY || 0;
      stage.setPointerCapture?.(event.pointerId);
    });

    stage.addEventListener('pointermove', (event) => {
      if (!cropState || cropState.stagePointerId !== event.pointerId) return;
      cropState.offsetX = cropState.dragOriginX + (event.clientX - cropState.dragStartX);
      cropState.offsetY = cropState.dragOriginY + (event.clientY - cropState.dragStartY);
      applyPhotoCropTransforms(cropState);
    });

    const releaseDrag = (event) => {
      if (!cropState || cropState.stagePointerId !== event.pointerId) return;
      if (stage.hasPointerCapture?.(event.pointerId)) {
        try { stage.releasePointerCapture(event.pointerId); } catch (_error) {}
      }
      cropState.stagePointerId = null;
    };
    stage.addEventListener('pointerup', releaseDrag);
    stage.addEventListener('pointercancel', releaseDrag);
    stage.addEventListener('lostpointercapture', () => {
      if (cropState) cropState.stagePointerId = null;
    });

    applyButton.addEventListener('click', async () => {
      if (!cropState) return;
      applyButton.disabled = true;
      applyButton.textContent = 'Preparando...';
      try {
        const prepared = await createPreparedPhotoFromCrop(cropState);
        const transfer = new DataTransfer();
        transfer.items.add(prepared.file);
        input.files = transfer.files;
        if (previewObjectUrl) {
          URL.revokeObjectURL(previewObjectUrl);
          previewObjectUrl = '';
        }
        showPreview(prepared.previewUrl, 'Boa! Agora ela já está pronta para salvar.');
        closeModal();
      } catch (_error) {
        hint.textContent = 'Não foi possível recortar a foto. Tente novamente.';
      } finally {
        applyButton.disabled = false;
        applyButton.textContent = 'Usar essa foto';
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      }
    });

    modalCloseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        input.value = '';
        closeModal();
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && cropState) {
        input.value = '';
        closeModal();
        submit.disabled = false;
        submit.textContent = 'Salvar foto';
      }
    });

    window.addEventListener('resize', () => {
      if (!cropState) return;
      const nextStageSize = Math.max(1, stage.clientWidth || cropState.stageSize || 1);
      if (nextStageSize === cropState.stageSize) return;
      const ratio = nextStageSize / Math.max(1, cropState.stageSize || 1);
      cropState.stageSize = nextStageSize;
      cropState.baseScale = Math.max(nextStageSize / (cropState.image.naturalWidth || cropState.image.width || 1), nextStageSize / (cropState.image.naturalHeight || cropState.image.height || 1));
      const zoomFactor = Math.max(1, Number(zoom.value || 1));
      cropState.scale = cropState.baseScale * zoomFactor;
      cropState.offsetX *= ratio;
      cropState.offsetY *= ratio;
      applyPhotoCropTransforms(cropState);
    });

    form.addEventListener('submit', () => {
      submit.disabled = true;
      submit.textContent = 'Subindo foto...';
    });
  }


  function createPinSlotMarkup(maxLength, filledCount) {
    const total = Math.max(1, Number(maxLength || 0) || 6);
    const active = Math.max(0, Math.min(total, Number(filledCount || 0) || 0));
    return Array.from({ length: total }, (_, index) => {
      const filled = index < active;
      return `
        <span class="inline-flex h-3 w-3 rounded-full border transition-all ${filled
          ? 'border-slate-900 bg-slate-900 dark:border-amber-400 dark:bg-amber-400'
          : 'border-slate-300 bg-transparent dark:border-slate-600'}"></span>
      `;
    }).join('');
  }

  function renderPinSlots(container, input) {
    if (!(container instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
    const maxLength = Math.max(1, Number(container.dataset.maxLength || input.maxLength || 6) || 6);
    const digits = String(input.value || '').replace(/\D/g, '').slice(0, maxLength);
    if (digits !== input.value) {
      input.value = digits;
    }
    container.innerHTML = `
      <div class="mx-auto flex w-fit items-center justify-center gap-2">${createPinSlotMarkup(maxLength, digits.length)}</div>
      <div class="mt-2 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">${digits.length}/${maxLength} dígitos</div>
    `;
  }

  function bindPinSlotPreview(container) {
    if (!(container instanceof HTMLElement) || container.dataset.pinSlotsBound === '1') return;
    const inputId = String(container.dataset.inputId || '').trim();
    if (!inputId) return;
    const input = document.getElementById(inputId);
    if (!(input instanceof HTMLInputElement)) return;
    const sync = () => renderPinSlots(container, input);
    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
    container.dataset.pinSlotsBound = '1';
    sync();
  }

  function setupPinVisibilityToggles(root) {
    const scope = root instanceof HTMLElement || root instanceof Document ? root : document;
    scope.querySelectorAll('[data-app-pin-visibility-toggle]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.pinVisibilityBound === '1') return;
      const target = document.getElementById(button.dataset.target || '');
      if (!(target instanceof HTMLInputElement)) return;
      const syncLabel = () => {
        const visible = target.type === 'text';
        button.textContent = visible ? 'Ocultar' : 'Ver';
        button.setAttribute('aria-pressed', visible ? 'true' : 'false');
      };
      button.addEventListener('click', () => {
        target.type = target.type === 'password' ? 'text' : 'password';
        syncLabel();
        target.focus();
        target.setSelectionRange?.(target.value.length, target.value.length);
      });
      button.dataset.pinVisibilityBound = '1';
      syncLabel();
    });
  }

  function resetPinFieldState(root) {
    if (!(root instanceof HTMLElement)) return;
    root.querySelectorAll('input[inputmode="numeric"]').forEach((input) => {
      if (!(input instanceof HTMLInputElement)) return;
      input.value = String(input.value || '').replace(/\D/g, '');
      input.type = 'password';
    });
    root.querySelectorAll('[data-app-pin-visibility-toggle]').forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        button.textContent = 'Ver';
        button.setAttribute('aria-pressed', 'false');
      }
    });
    root.querySelectorAll('[data-pin-slots]').forEach((container) => bindPinSlotPreview(container));
  }

  function setPinModalVisibility(modal, isOpen) {
    if (!(modal instanceof HTMLElement)) return;
    modal.classList.toggle('hidden', !isOpen);
    modal.classList.toggle('flex', isOpen);
    modal.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    document.body.classList.toggle('overflow-hidden', !!isOpen);
  }

  function bindAppPinSecurityControls() {
    const manageModal = document.getElementById('appPinManageModal');
    const disableModal = document.getElementById('appPinDisableModal');
    const idleModal = document.getElementById('appPinIdleModal');
    if (!(manageModal instanceof HTMLElement) || !(disableModal instanceof HTMLElement) || !(idleModal instanceof HTMLElement)) return;

    const manageForm = document.getElementById('appPinManageForm');
    const manageTitle = document.getElementById('appPinManageTitle');
    const manageHint = document.getElementById('appPinManageHint');
    const manageModeInput = document.getElementById('appPinManageMode');
    const currentGroup = document.getElementById('appPinCurrentGroup');
    const currentInput = document.getElementById('appPinCurrentInput');
    const newInput = document.getElementById('appPinNewInput');
    const confirmInput = document.getElementById('appPinConfirmInput');
    const idleSelect = document.getElementById('appPinIdleSelect');
    const manageSubmit = document.getElementById('appPinManageSubmit');
    const disableForm = document.getElementById('appPinDisableForm');
    const disableInput = document.getElementById('appPinDisableInput');
    const idleForm = document.getElementById('appPinIdleForm');
    const idleInput = document.getElementById('appPinIdleCurrentInput');
    const idleManageSelect = document.getElementById('appPinIdleManageSelect');

    if (!(manageForm instanceof HTMLFormElement) || !(disableForm instanceof HTMLFormElement) || !(idleForm instanceof HTMLFormElement) ||
        !(manageTitle instanceof HTMLElement) || !(manageHint instanceof HTMLElement) ||
        !(manageModeInput instanceof HTMLInputElement) || !(currentGroup instanceof HTMLElement) ||
        !(newInput instanceof HTMLInputElement) || !(confirmInput instanceof HTMLInputElement) ||
        !(idleSelect instanceof HTMLSelectElement) || !(manageSubmit instanceof HTMLButtonElement) ||
        !(disableInput instanceof HTMLInputElement) || !(idleInput instanceof HTMLInputElement) ||
        !(idleManageSelect instanceof HTMLSelectElement)) {
      return;
    }

    const openManageButtons = Array.from(document.querySelectorAll('[data-app-pin-open="create"], [data-app-pin-open="change"]'));
    const openDisableButton = document.querySelector('[data-app-pin-open="disable"]');
    const openIdleButton = document.querySelector('[data-app-pin-open="idle"]');
    const manageCloseButtons = Array.from(manageModal.querySelectorAll('[data-app-pin-close]'));
    const disableCloseButtons = Array.from(disableModal.querySelectorAll('[data-app-pin-disable-close]'));
    const idleCloseButtons = Array.from(idleModal.querySelectorAll('[data-app-pin-idle-close]'));
    const selectedIdleOption = idleSelect.value;

    manageModal.querySelectorAll('[data-pin-slots]').forEach((container) => bindPinSlotPreview(container));
    disableModal.querySelectorAll('[data-pin-slots]').forEach((container) => bindPinSlotPreview(container));
    idleModal.querySelectorAll('[data-pin-slots]').forEach((container) => bindPinSlotPreview(container));
    setupPinVisibilityToggles(manageModal);
    setupPinVisibilityToggles(disableModal);
    setupPinVisibilityToggles(idleModal);

    const closeAll = () => {
      setPinModalVisibility(manageModal, false);
      setPinModalVisibility(disableModal, false);
      setPinModalVisibility(idleModal, false);
    };

    const resetManageForm = () => {
      manageForm.reset();
      manageModeInput.value = 'create';
      idleSelect.value = selectedIdleOption;
      currentGroup.classList.add('hidden');
      currentInput.required = false;
      manageTitle.textContent = 'Criar PIN';
      manageHint.textContent = 'Escolha um PIN numérico para proteger a abertura do app.';
      manageSubmit.textContent = 'Salvar PIN';
      resetPinFieldState(manageModal);
    };

    const openManage = (mode) => {
      closeAll();
      resetManageForm();
      const safeMode = mode === 'change' ? 'change' : 'create';
      manageModeInput.value = safeMode;
      const changing = safeMode === 'change';
      currentGroup.classList.toggle('hidden', !changing);
      currentInput.required = changing;
      manageTitle.textContent = changing ? 'Trocar PIN' : 'Criar PIN';
      manageHint.textContent = changing
        ? 'Confirme o PIN atual e depois escolha o novo PIN do app.'
        : 'Escolha um PIN numérico para proteger a abertura do app.';
      manageSubmit.textContent = changing ? 'Atualizar PIN' : 'Salvar PIN';
      setPinModalVisibility(manageModal, true);
      window.setTimeout(() => {
        (changing ? currentInput : newInput).focus();
      }, 40);
    };

    const resetDisableForm = () => {
      disableForm.reset();
      resetPinFieldState(disableModal);
    };

    const openDisable = () => {
      closeAll();
      resetDisableForm();
      setPinModalVisibility(disableModal, true);
      window.setTimeout(() => disableInput.focus(), 40);
    };

    const resetIdleForm = () => {
      idleForm.reset();
      idleManageSelect.value = selectedIdleOption;
      resetPinFieldState(idleModal);
    };

    const openIdle = () => {
      closeAll();
      resetIdleForm();
      setPinModalVisibility(idleModal, true);
      window.setTimeout(() => idleInput.focus(), 40);
    };

    openManageButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.getAttribute('data-app-pin-open') || 'create';
        openManage(mode);
      });
    });

    if (openDisableButton instanceof HTMLButtonElement) {
      openDisableButton.addEventListener('click', openDisable);
    }

    if (openIdleButton instanceof HTMLButtonElement) {
      openIdleButton.addEventListener('click', openIdle);
    }

    manageCloseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        resetManageForm();
        setPinModalVisibility(manageModal, false);
      });
    });

    disableCloseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        resetDisableForm();
        setPinModalVisibility(disableModal, false);
      });
    });

    idleCloseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        resetIdleForm();
        setPinModalVisibility(idleModal, false);
      });
    });

    manageModal.addEventListener('click', (event) => {
      if (event.target === manageModal) {
        resetManageForm();
        setPinModalVisibility(manageModal, false);
      }
    });

    disableModal.addEventListener('click', (event) => {
      if (event.target === disableModal) {
        resetDisableForm();
        setPinModalVisibility(disableModal, false);
      }
    });

    idleModal.addEventListener('click', (event) => {
      if (event.target === idleModal) {
        resetIdleForm();
        setPinModalVisibility(idleModal, false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!manageModal.classList.contains('hidden')) {
        resetManageForm();
        setPinModalVisibility(manageModal, false);
      }
      if (!disableModal.classList.contains('hidden')) {
        resetDisableForm();
        setPinModalVisibility(disableModal, false);
      }
      if (!idleModal.classList.contains('hidden')) {
        resetIdleForm();
        setPinModalVisibility(idleModal, false);
      }
    });

    manageForm.addEventListener('submit', () => {
      manageSubmit.disabled = true;
      manageSubmit.textContent = 'Salvando...';
    });

    disableForm.addEventListener('submit', () => {
      const submitButton = disableForm.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Desligando...';
      }
    });

    idleForm.addEventListener('submit', () => {
      const submitButton = idleForm.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Atualizando...';
      }
    });

    resetManageForm();
    resetDisableForm();
    resetIdleForm();
  }


  function bindAppPasskeySecurityControls() {
    const registerButton = document.getElementById('appPasskeyRegisterButton');
    const feedback = document.getElementById('appPasskeyFeedback');
    if (!(feedback instanceof HTMLElement)) return;

    const hasClientSupport = !!(window.PublicKeyCredential && window.isSecureContext && navigator.credentials && typeof navigator.credentials.create === 'function');

    const setFeedback = (message, tone = 'slate') => {
      const safeMessage = String(message || '').trim();
      feedback.textContent = safeMessage;
      feedback.classList.remove('text-slate-600', 'text-cyan-700', 'text-emerald-700', 'text-amber-700', 'text-rose-700', 'dark:text-slate-300', 'dark:text-cyan-200', 'dark:text-emerald-200', 'dark:text-amber-200', 'dark:text-rose-200');
      if (tone === 'violet') {
        feedback.classList.add('text-cyan-700', 'dark:text-cyan-200');
      } else if (tone === 'emerald') {
        feedback.classList.add('text-emerald-700', 'dark:text-emerald-200');
      } else if (tone === 'amber') {
        feedback.classList.add('text-amber-700', 'dark:text-amber-200');
      } else if (tone === 'rose') {
        feedback.classList.add('text-rose-700', 'dark:text-rose-200');
      } else {
        feedback.classList.add('text-slate-600', 'dark:text-slate-300');
      }
      feedback.classList.toggle('hidden', !safeMessage);
    };

    function base64UrlToUint8Array(value) {
      const safe = String(value || '').replace(/-/g, '+').replace(/_/g, '/');
      const padded = safe + '='.repeat((4 - (safe.length % 4 || 4)) % 4);
      const binary = window.atob(padded);
      return Uint8Array.from(binary, (char) => char.charCodeAt(0));
    }

    function bufferToBase64Url(value) {
      const bytes = value instanceof ArrayBuffer ? new Uint8Array(value) : value instanceof Uint8Array ? value : new Uint8Array([]);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
    }

    function toPublicKeyCredentialJSON(value) {
      if (value instanceof ArrayBuffer) {
        return bufferToBase64Url(value);
      }
      if (ArrayBuffer.isView(value)) {
        return bufferToBase64Url(value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength));
      }
      if (Array.isArray(value)) {
        return value.map((entry) => toPublicKeyCredentialJSON(entry));
      }
      if (value && typeof value === 'object') {
        return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, toPublicKeyCredentialJSON(entry)]));
      }
      return value;
    }

    function serializeAuthenticatorResponse(response) {
      if (!response || typeof response !== 'object') {
        return {};
      }

      if (typeof response.toJSON === 'function') {
        try {
          return response.toJSON();
        } catch (_error) {
          // segue para o fallback manual logo abaixo
        }
      }

      const payload = {
        clientDataJSON: response.clientDataJSON ? bufferToBase64Url(response.clientDataJSON) : undefined
      };

      if ('attestationObject' in response && response.attestationObject) {
        payload.attestationObject = bufferToBase64Url(response.attestationObject);
      }

      if ('authenticatorData' in response && response.authenticatorData) {
        payload.authenticatorData = bufferToBase64Url(response.authenticatorData);
      }

      if ('signature' in response && response.signature) {
        payload.signature = bufferToBase64Url(response.signature);
      }

      if ('userHandle' in response) {
        payload.userHandle = response.userHandle ? bufferToBase64Url(response.userHandle) : null;
      }

      if (typeof response.getTransports === 'function') {
        try {
          const transports = response.getTransports();
          if (Array.isArray(transports) && transports.length) {
            payload.transports = transports.filter(Boolean);
          }
        } catch (_error) {
          // alguns navegadores podem não deixar consultar isso aqui, então deixa quietinho
        }
      }

      return payload;
    }

    function serializePublicKeyCredential(credential) {
      if (!credential || typeof credential !== 'object') {
        return {};
      }

      if (typeof credential.toJSON === 'function') {
        try {
          return credential.toJSON();
        } catch (_error) {
          // fallback manual para navegadores que tropeçam nessa serialização
        }
      }

      const clientExtensionResults = typeof credential.getClientExtensionResults === 'function'
        ? credential.getClientExtensionResults()
        : undefined;

      return {
        id: String(credential.id || '').trim() || undefined,
        rawId: credential.rawId ? bufferToBase64Url(credential.rawId) : undefined,
        type: String(credential.type || '').trim() || 'public-key',
        authenticatorAttachment: credential.authenticatorAttachment || undefined,
        clientExtensionResults: clientExtensionResults && Object.keys(clientExtensionResults).length
          ? toPublicKeyCredentialJSON(clientExtensionResults)
          : undefined,
        response: serializeAuthenticatorResponse(credential.response)
      };
    }

    function decodeRegistrationOptions(options) {
      const publicKey = options ? JSON.parse(JSON.stringify(options)) : {};
      if (publicKey.challenge) publicKey.challenge = base64UrlToUint8Array(publicKey.challenge);
      if (publicKey.user && publicKey.user.id) publicKey.user.id = base64UrlToUint8Array(publicKey.user.id);
      if (Array.isArray(publicKey.excludeCredentials)) {
        publicKey.excludeCredentials = publicKey.excludeCredentials
          .filter((credential) => credential && credential.id)
          .map((credential) => ({
            ...credential,
            type: credential.type || 'public-key',
            id: base64UrlToUint8Array(credential.id)
          }));
      }
      return publicKey;
    }

    function buildPasskeyDeviceLabel() {
      const parts = [];
      const uaData = navigator.userAgentData || null;
      const platform = uaData && uaData.platform ? uaData.platform : navigator.platform;
      const safePlatform = String(platform || '').trim();
      if (/iphone|ipad|ipod/i.test(navigator.userAgent)) {
        parts.push('iPhone');
      } else if (/android/i.test(navigator.userAgent)) {
        parts.push('Android');
      } else if (/mac/i.test(safePlatform)) {
        parts.push('Mac');
      } else if (/win/i.test(safePlatform)) {
        parts.push('Windows');
      } else if (/linux/i.test(safePlatform)) {
        parts.push('Linux');
      }
      const standalone = window.matchMedia && window.matchMedia('(display-mode: standalone)').matches;
      if (standalone || navigator.standalone) {
        parts.push('app');
      }
      return parts.join(' · ') || 'Este aparelho';
    }

    if (!(registerButton instanceof HTMLButtonElement)) {
      if (!hasClientSupport && feedback.textContent.trim()) {
        setFeedback('Se este navegador for compatível, você poderá configurar o desbloqueio por digital ou rosto.', 'slate');
      }
      return;
    }

    if (!hasClientSupport) {
      registerButton.disabled = true;
      registerButton.setAttribute('aria-disabled', 'true');
      setFeedback('Neste navegador ou endereço ainda não rolou liberar o desbloqueio pelo aparelho.', 'amber');
      return;
    }

    registerButton.addEventListener('click', async () => {
      if (registerButton.disabled) return;
      const defaultLabel = buildPasskeyDeviceLabel();
      registerButton.disabled = true;
      registerButton.textContent = 'Preparando...';
      setFeedback('Deixa comigo: estou preparando este aparelho.', 'violet');

      try {
        const optionsResponse = await fetch('/people/security/passkeys/register/options', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-AcerttaPay-Async': '1'
          },
          body: JSON.stringify({ label: defaultLabel })
        });
        const optionsPayload = await optionsResponse.json().catch(() => ({}));
        if (!optionsResponse.ok || !optionsPayload.ok || !optionsPayload.options) {
          throw new Error(optionsPayload.message || 'Não consegui preparar este aparelho agora.');
        }

        const credential = await navigator.credentials.create({ publicKey: decodeRegistrationOptions(optionsPayload.options) });
        if (!(credential instanceof PublicKeyCredential)) {
          throw new Error('Esse aparelho não devolveu o preparo completo agora.');
        }

        const verifyResponse = await fetch('/people/security/passkeys/register/verify', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-AcerttaPay-Async': '1'
          },
          body: JSON.stringify({
            ...serializePublicKeyCredential(credential),
            label: defaultLabel
          })
        });
        const verifyPayload = await verifyResponse.json().catch(() => ({}));
        if (!verifyResponse.ok || !verifyPayload.ok) {
          throw new Error(verifyPayload.message || 'Não consegui confirmar este aparelho agora.');
        }

        setFeedback(verifyPayload.message || 'Pronto, este aparelho já entrou na sua lista de desbloqueio.', 'emerald');
        window.setTimeout(() => {
          window.location.href = '/settings#security';
        }, 240);
      } catch (error) {
        console.warn('[passkey-register]', { name: error?.name || null, message: error?.message || null, raw: error || null });
        const safeMessage = error && typeof error === 'object' && 'name' in error && error.name === 'NotAllowedError'
          ? 'Tudo certo. Parece que esse preparo foi cancelado antes de terminar.'
          : (error && error.message) ? error.message : 'Não consegui preparar este aparelho agora.';
        setFeedback(safeMessage, 'rose');
      } finally {
        registerButton.disabled = false;
        registerButton.textContent = 'Adicionar neste aparelho';
      }
    });
  }

  window.addEventListener('load', () => {
    bindPhoneField('self');
    bindPhoneField('contact');
    resetSelfIdentityForm();
    bindPixForm('self');
    bindSelfPixToggle();
    resetContactForm();
    bindNetworkDiscoveryControls();
    bindProfilePhotoForm();
    bindProfileSignatureForm();
    bindAppPinSecurityControls();
    bindAppPasskeySecurityControls();

    const highlighted = document.querySelector('[id^="friend-request-"][class*="ring-2"]');
    if (highlighted) {
      highlighted.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>

