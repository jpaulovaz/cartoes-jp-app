            <div class="rounded-[22px] border border-amber-200/70 bg-amber-50/80 px-4 py-3 shadow-sm dark:border-amber-900/50 dark:bg-amber-950/20">
              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">PIN</div>
              <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= appPinEnabled ? appPinIdleLabel : 'Desligado' %></div>
              <p class="mt-1 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= appPinEnabled ? 'Tempo atual do bloqueio.' : 'Proteção extra ainda desligada.' %></p>
