function bindSelfPixToggle() {
  const toggle = document.getElementById('selfPixEnabled');
  const groups = Array.from(document.querySelectorAll('[data-self-pix-field]'));
  const dormantHint = document.getElementById('selfPixDormantHint');
  if (!toggle) return;

  const sync = () => {
    const enabled = !!toggle.checked;
    groups.forEach((group) => {
      group.style.opacity = enabled ? '' : '0.6';
      group.style.pointerEvents = enabled ? '' : 'none';
      Array.from(group.querySelectorAll('input, select, textarea')).forEach((field) => {
        field.disabled = !enabled;
      });
    });

    if (dormantHint) {
      dormantHint.classList.toggle('hidden', enabled);
    }
  };

  toggle.addEventListener('change', sync);
  sync();
}

