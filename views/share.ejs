<%- include("partials/header", { title: "Compartilhar Resumo" }) %>
<%
  const periodLabel = `${String(month).padStart(2, '0')}/${year}`;
  const getItemCents = (item) => {
    if (item && item.amount_cents !== undefined && item.amount_cents !== null && item.amount_cents !== '') return Number(item.amount_cents) || 0;
    if (item && item.amount !== undefined && item.amount !== null && item.amount !== '') return Math.round(Number(item.amount) * 100) || 0;
    if (item && item.share_cents !== undefined && item.share_cents !== null && item.share_cents !== '') return Number(item.share_cents) || 0;
    return 0;
  };
  const formatBRL = (cents) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format((Number(cents) || 0) / 100);
  const getDescription = (item) => (item && (item.description || item.title || item.name || item.label)) || 'Lançamento';
  const itemDate = (item) => {
    const raw = (item && (item.txn_date || item.date || item.purchase_date || item.created_at || item.imported_at)) || '';
    if (!raw) return '';
    const str = String(raw);
    const m = str.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return `${m[3]}/${m[2]}/${m[1]}`;
    return str;
  };
  const totalCents = items.reduce((acc, item) => acc + getItemCents(item), 0);
  const summaryMode = false;
  const compactMode = items.length > 10;
  const visibleItems = items;
  const hiddenItems = [];
  const hiddenTotalCents = 0;
  const captureScale = items.length > 36 ? 1 : items.length > 24 ? 1.15 : items.length > 16 ? 1.3 : items.length > 10 ? 1.55 : 2;
  const metricPills = [
    { label: 'Itens', value: `${items.length}` },
    { label: 'Valor total', value: formatBRL(totalCents) },
    { label: 'Visual', value: compactMode ? 'Compacta' : 'Completa' }
  ];
%>

<div class="op-page-shell">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Compartilhamento rápido</span>
      <h1 class="op-page-hero__title mt-4">Compartilhar Resumo</h1>
      <p class="op-page-hero__subtitle mt-3">Gere uma imagem pronta para compartilhar pelo menu nativo do aparelho, com prévia fiel do que a pessoa vai receber e todos os itens do período sempre visíveis.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= person.name %></span>
        <span class="badge">Ref. <%= periodLabel %></span>
        <span class="badge"><%= items.length %> item(ns)</span>
      </div>
    </div>
    <div class="op-page-hero__actions">
      <a href="/summary/<%= year %>/<%= month %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Voltar
      </a>
      <button id="btnPng" type="button" data-loading-label="Gerando PNG..." class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Baixar PNG
      </button>
      <button id="btnShare" type="button" data-loading-label="Preparando compartilhamento..." class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/20 transition-all hover:-translate-y-0.5 hover:bg-blue-700">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C9.886 12.64 11.278 12.25 12.75 12.25c1.472 0 2.864.39 4.066 1.092M8.684 13.342 5.5 15.25m3.184-1.908a3 3 0 10-1.368-2.53m9.5 2.53L19.5 15.25m-2.684-1.908a3 3 0 11 1.368-2.53M12 6v7" /></svg>
        Compartilhar
      </button>
    </div>
  </section>

  <div class="op-preview-shell op-fade-up">
    <div class="op-preview-shell__label">Prévia do cartão compartilhável</div>
    <div class="flex justify-center pb-2">
      <%- include('partials/share-summary-card', {
        cardId: 'cardPreview',
        person,
        periodLabel,
        items,
        visibleItems,
        hiddenItems,
        hiddenTotalCents,
        compactMode,
        summaryMode,
        formatBRL,
        getItemCents,
        getDescription,
        itemDate,
        totalCents,
        exportMode: false,
        captureScale,
        metricPills,
        compactHint: compactMode ? 'Layout mais compacto para manter todos os itens legíveis no celular, sem resumir nenhuma informação.' : 'Todos os itens aparecem integralmente na imagem.',
        footerLeft: 'Gerado pelo OrganizaPay · pronto para compartilhar pelo sistema do aparelho',
        footerRight: 'Imagem pronta para envio',
        totalLabel: 'Total do período'
      }) %>
    </div>
  </div>
</div>

<div aria-hidden="true" style="position:fixed; left:-99999px; top:0; pointer-events:none; opacity:0;">
  <%- include('partials/share-summary-card', {
    cardId: 'cardExport',
    person,
    periodLabel,
    items,
    visibleItems,
    hiddenItems,
    hiddenTotalCents,
    compactMode,
    summaryMode,
    formatBRL,
    getItemCents,
    getDescription,
    itemDate,
    totalCents,
    exportMode: true,
    captureScale,
    metricPills,
    compactHint: compactMode ? 'Layout mais compacto para manter todos os itens legíveis no celular, sem resumir nenhuma informação.' : 'Todos os itens aparecem integralmente na imagem.',
    footerLeft: 'Gerado pelo OrganizaPay · pronto para compartilhar pelo sistema do aparelho',
    footerRight: 'Imagem pronta para envio',
    totalLabel: 'Total do período'
  }) %>
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
  const shareState = {
    file: null,
    objectUrl: null,
    promise: null
  };

  function setBusy(button, loadingLabel) {
    if (!button) return () => {};
    const original = button.innerHTML;
    button.disabled = true;
    button.classList.add('op-button-loading');
    button.innerHTML = `<span class="op-submit-spinner" aria-hidden="true"></span><span>${loadingLabel}</span>`;
    return () => {
      button.disabled = false;
      button.classList.remove('op-button-loading');
      button.innerHTML = original;
    };
  }

  function ensureHtml2CanvasAvailable() {
    if (typeof window.html2canvas !== 'function') {
      throw new Error('A biblioteca de geração da imagem não foi carregada. Recarregue a página e tente novamente.');
    }
  }

  function getCaptureSourceNode() {
    return document.getElementById('cardPreview') || document.getElementById('cardExport');
  }

  function waitForPaint() {
    return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
  }

  async function buildReceiptCanvas() {
    ensureHtml2CanvasAvailable();
    const sourceNode = getCaptureSourceNode();
    if (!sourceNode) throw new Error('Resumo não encontrado para captura.');

    await waitForPaint();

    const rect = sourceNode.getBoundingClientRect();
    const baseWidth = Math.max(Math.ceil(rect.width || 0), sourceNode.scrollWidth || 0, sourceNode.offsetWidth || 0, 704);

    const stage = document.createElement('div');
    stage.setAttribute('data-capture-stage', 'true');
    stage.style.position = 'fixed';
    stage.style.left = '0';
    stage.style.top = '0';
    stage.style.zIndex = '-1';
    stage.style.pointerEvents = 'none';
    stage.style.opacity = '1';
    stage.style.background = '#ffffff';
    stage.style.padding = '0';
    stage.style.margin = '0';
    stage.style.width = `${baseWidth}px`;

    const clone = sourceNode.cloneNode(true);
    clone.id = `${sourceNode.id || 'share-card'}-capture`;
    clone.style.width = `${baseWidth}px`;
    clone.style.maxWidth = `${baseWidth}px`;
    clone.style.margin = '0';
    clone.style.transform = 'none';

    stage.appendChild(clone);
    document.body.appendChild(stage);

    try {
      await waitForPaint();
      const cloneRect = clone.getBoundingClientRect();
      const width = Math.max(Math.ceil(cloneRect.width || 0), clone.scrollWidth || 0, clone.offsetWidth || 0, baseWidth);
      const height = Math.max(Math.ceil(cloneRect.height || 0), clone.scrollHeight || 0, clone.offsetHeight || 0);

      console.info('[share] capture dimensions', { width, height, baseWidth });

      if (!width || !height) {
        throw new Error(`Não foi possível medir a área do recibo para captura (${width}x${height}).`);
      }

      const canvas = await html2canvas(clone, {
        scale: Number((sourceNode.dataset && sourceNode.dataset.captureScale) || 2),
        backgroundColor: '#ffffff',
        useCORS: true,
        width,
        height,
        windowWidth: width + 40,
        windowHeight: height + 40,
        scrollX: 0,
        scrollY: 0
      });

      if (!canvas || !canvas.width || !canvas.height) {
        throw new Error('A captura foi gerada sem conteúdo útil.');
      }

      return canvas;
    } finally {
      stage.remove();
    }
  }

  function blobToFile(blob, filename) {
    if (!blob || !blob.size) {
      throw new Error('A imagem foi gerada vazia.');
    }
    return new File([blob], filename, { type: blob.type || 'image/png' });
  }

  function dataUrlToFile(dataUrl, filename) {
    const parts = String(dataUrl || '').split(',');
    if (parts.length < 2) {
      throw new Error('Não foi possível gerar a imagem para compartilhamento.');
    }
    const mimeMatch = parts[0].match(/data:(.*?);base64/);
    const mime = mimeMatch ? mimeMatch[1] : 'image/png';
    const binary = atob(parts[1]);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i += 1) {
      bytes[i] = binary.charCodeAt(i);
    }
    return new File([bytes], filename, { type: mime });
  }

  function canvasToFile(canvas, filename) {
    return new Promise((resolve, reject) => {
      if (canvas.toBlob) {
        canvas.toBlob((blob) => {
          try {
            if (blob && blob.size > 0) {
              console.info('[share] blob generated', { size: blob.size, type: blob.type || 'image/png' });
              resolve(blobToFile(blob, filename));
              return;
            }

            const dataUrl = canvas.toDataURL('image/png');
            const file = dataUrlToFile(dataUrl, filename);
            console.info('[share] fallback dataUrl generated', { bytes: file.size });
            resolve(file);
          } catch (error) {
            reject(error);
          }
        }, 'image/png');
        return;
      }

      try {
        const dataUrl = canvas.toDataURL('image/png');
        const file = dataUrlToFile(dataUrl, filename);
        console.info('[share] dataUrl generated without toBlob', { bytes: file.size });
        resolve(file);
      } catch (error) {
        reject(error);
      }
    });
  }

  async function prepareShareFile(force) {
    if (!force && shareState.file) return shareState.file;
    if (!force && shareState.promise) return shareState.promise;

    const filename = `Fatura_<%= person.name.replace(/\s+/g,'_') %>_<%= String(month).padStart(2,'0') %>_<%= year %>.png`;
    shareState.promise = (async () => {
      const canvas = await buildReceiptCanvas();
      const file = await canvasToFile(canvas, filename);
      shareState.file = file;
      return file;
    })();

    try {
      return await shareState.promise;
    } finally {
      shareState.promise = null;
    }
  }

  function scheduleShareWarmup() {
    if (shareState.file || shareState.promise) return;
    const run = () => prepareShareFile(false).catch((error) => console.warn('[share] Pré-geração da imagem falhou', error));
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 1800 });
    } else {
      window.setTimeout(run, 350);
    }
  }

  function cleanupObjectUrl() {
    if (shareState.objectUrl) {
      URL.revokeObjectURL(shareState.objectUrl);
      shareState.objectUrl = null;
    }
  }

  function triggerDownloadFromFile(file) {
    cleanupObjectUrl();
    shareState.objectUrl = URL.createObjectURL(file);
    const link = document.createElement('a');
    link.download = file.name;
    link.href = shareState.objectUrl;
    link.click();
    window.setTimeout(cleanupObjectUrl, 1500);
  }

  function canShareFiles(file) {
    if (!navigator.share) return false;
    try {
      return !navigator.canShare || navigator.canShare({ files: [file] });
    } catch (error) {
      console.warn('[share] navigator.canShare falhou', error);
      return false;
    }
  }

  async function downloadReceipt() {
    const restore = setBusy(document.getElementById('btnPng'), 'Gerando PNG...');
    try {
      const file = await prepareShareFile(true);
      triggerDownloadFromFile(file);
    } finally {
      restore();
    }
  }

  async function shareReceipt() {
    const restore = setBusy(document.getElementById('btnShare'), 'Preparando compartilhamento...');
    try {
      const file = await prepareShareFile(false);
      const totalLabel = '<%= formatBRL(totalCents) %>';
      const periodLabel = '<%= periodLabel %>';

      if (canShareFiles(file)) {
        await navigator.share({
          title: `Resumo ${periodLabel} — <%= person.name %>`,
          text: `Resumo do período ${periodLabel} para <%= person.name %>. Total: ${totalLabel}.`,
          files: [file]
        });
        return;
      }

      triggerDownloadFromFile(file);
      alert('O compartilhamento direto não está disponível neste aparelho. A imagem foi baixada para compartilhamento manual.');
    } catch (error) {
      if (error && error.name === 'AbortError') return;
      console.error(error);
      try {
        const fallbackFile = shareState.file || await prepareShareFile(true);
        triggerDownloadFromFile(fallbackFile);
        alert('Não foi possível abrir o menu de compartilhamento agora. A imagem foi baixada para compartilhamento manual.');
      } catch (downloadError) {
        console.error(downloadError);
        alert('Não foi possível gerar ou compartilhar a imagem agora.');
      }
    } finally {
      restore();
    }
  }

  document.getElementById('btnPng')?.addEventListener('click', downloadReceipt);
  document.getElementById('btnShare')?.addEventListener('click', shareReceipt);
  document.getElementById('btnShare')?.addEventListener('touchstart', scheduleShareWarmup, { passive: true, once: true });
  document.getElementById('btnShare')?.addEventListener('mouseenter', scheduleShareWarmup, { once: true });
  document.getElementById('btnShare')?.addEventListener('focus', scheduleShareWarmup, { once: true });
  window.addEventListener('load', scheduleShareWarmup, { once: true });
  window.addEventListener('beforeunload', cleanupObjectUrl);
</script>

<%- include("partials/footer") %>
