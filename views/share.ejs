<%- include("partials/header", { title: "AcerttaPay | Compartilhar resumo" }) %>
<%
  const periodLabel = `${String(month).padStart(2, '0')}/${year}`;
  const getItemCents = (item) => {
    if (item && item.amount_cents !== undefined && item.amount_cents !== null && item.amount_cents !== '') return Number(item.amount_cents) || 0;
    if (item && item.amount !== undefined && item.amount !== null && item.amount !== '') return Math.round(Number(item.amount) * 100) || 0;
    if (item && item.share_cents !== undefined && item.share_cents !== null && item.share_cents !== '') return Number(item.share_cents) || 0;
    return 0;
  };
  const formatBRL = (cents) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format((Number(cents) || 0) / 100);
  const getDescription = (item) => (item && (item.description || item.title || item.name || item.label)) || 'Compra';
  const itemDate = (item) => {
    const raw = (item && (item.txn_date || item.date || item.purchase_date || item.created_at || item.imported_at)) || '';
    if (!raw) return '';
    const str = String(raw);
    const m = str.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return `${m[3]}/${m[2]}/${m[1]}`;
    return str;
  };
  const totalCents = items.reduce((acc, item) => acc + getItemCents(item), 0);
  const selectedItemOrder = itemOrder === 'recent' ? 'recent' : 'oldest';
  const paidCents = Math.max(0, Number(paid_cents || 0) || 0);
  const rawRemainingCents = (remaining_cents ?? (totalCents - paidCents));
  const remainingCents = Math.max(0, Number(rawRemainingCents || 0) || 0);
  const visibleItems = items;
  const captureScale = items.length > 48 ? 1.85 : 2;
  const heroText = remainingCents > 0
    ? (paidCents > 0
        ? 'Confira abaixo as compras deste período, o valor já pago e o saldo que ainda falta para fechar tudo.'
        : 'Confira abaixo as compras deste período e o valor que ainda falta pagar.')
    : 'Confira abaixo as compras deste período e a confirmação de que o pagamento já foi concluído.';
  const pageShareText = (shareContext && shareContext.nativeShareText) || `Resumo do período ${periodLabel} para ${person.name}.`;
  const sharePixContext = shareContext && shareContext.pix ? shareContext.pix : null;
  const pixAvailable = !!(sharePixContext && sharePixContext.available);
  const copyTextButtonLabel = pixAvailable ? 'Copiar texto do resumo + Pix' : 'Copiar texto do resumo';
%>

<div class="op-page-shell op-share-screen-v4 op-share-screen-v5">
  <section class="op-page-hero op-fade-up op-social-share-hero op-share-hero-v4 op-share-hero-v5">
    <div>
      <span class="op-page-hero__eyebrow">Envio manual</span>
      <h1 class="op-page-hero__title mt-4">Compartilhar resumo</h1>
      <p class="op-page-hero__subtitle mt-3">Ajuste a ordem, gere a imagem e compartilhe o resumo com clareza.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= person.name %></span>
        <span class="badge">Ref. <%= periodLabel %></span>
        <span class="badge"><%= items.length %> item(ns)</span>
      </div>
    </div>
    <div class="op-page-hero__actions op-social-share-hero__actions op-social-share-hero__actions--triple">
      <a href="/summary/<%= year %>/<%= month %>" class="op-btn op-hero-link op-hero-link--summary">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Voltar
      </a>
      <button id="btnPng" type="button" data-loading-label="Gerando imagem..." class="op-btn op-btn-success">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Baixar imagem
      </button>
      <button id="btnShare" type="button" data-loading-label="Preparando compartilhamento..." class="op-btn op-btn-info">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C9.886 12.64 11.278 12.25 12.75 12.25c1.472 0 2.864.39 4.066 1.092M8.684 13.342 5.5 15.25m3.184-1.908a3 3 0 10-1.368-2.53m9.5 2.53L19.5 15.25m-2.684-1.908a3 3 0 11 1.368-2.53M12 6v7" /></svg>
        Abrir compartilhamento
      </button>
    </div>
  </section>

  <div class="op-surface-card op-fade-up op-share-toolbar-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 mb-6">
    <form method="get" action="/share/<%= year %>/<%= month %>/<%= person.id %>" class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="w-full md:max-w-sm">
        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-1.5">Ordenação dos itens</label>
        <select name="order" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition-colors focus:bg-white focus:ring-2 focus:ring-cyan-500 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:bg-slate-950">
          <option value="recent" <%= selectedItemOrder === 'recent' ? 'selected' : '' %>>Mais recentes primeiro</option>
          <option value="oldest" <%= selectedItemOrder === 'oldest' ? 'selected' : '' %>>Mais antigos primeiro</option>
        </select>
      </div>
      <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        Aplicar ordem
      </button>
    </form>
  </div>

  <div class="op-surface-card op-fade-up op-share-copy-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 mb-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-600/70 dark:text-cyan-300/80"><%= pixAvailable ? 'Pix no resumo' : 'Texto do resumo' %></div>
        <% if (pixAvailable) { %>
          <h2 class="mt-2 text-lg font-bold tracking-[-0.03em] text-slate-900 dark:text-slate-100"><%= remainingCents > 0 && paidCents > 0 ? 'O texto segue com o Pix do saldo restante.' : 'O texto segue com o Pix pronto para pagamento.' %></h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= sharePixContext.helperText %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if (sharePixContext.keyTypeLabel) { %><span class="badge"><%= sharePixContext.keyTypeLabel %></span><% } %>
            <% if (sharePixContext.maskedKey) { %><span class="badge"><%= sharePixContext.maskedKey %></span><% } %>
            <% if (sharePixContext.ownerName) { %><span class="badge">Pix de <%= sharePixContext.ownerName %></span><% } %>
          </div>
        <% } else { %>
          <h2 class="mt-2 text-lg font-bold tracking-[-0.03em] text-slate-900 dark:text-slate-100"><%= shareContext && shareContext.state === 'settled' ? 'Agora o resumo segue apenas como registro.' : 'A imagem continua pronta, e o Pix entra assim que você deixar isso redondinho.' %></h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= sharePixContext && sharePixContext.reason ? sharePixContext.reason : 'Mesmo sem Pix nesta rodada, o texto continua pronto para compartilhamento manual.' %></p>
        <% } %>
      </div>
      <div class="flex flex-wrap gap-3">
        <% if (pixAvailable) { %>
          <button id="btnCopyPix" type="button" class="inline-flex items-center justify-center rounded-2xl border border-cyan-200 bg-cyan-50 px-5 py-3 text-sm font-bold text-cyan-700 transition-all hover:-translate-y-0.5 hover:bg-cyan-100 dark:border-cyan-900/50 dark:bg-cyan-950/30 dark:text-cyan-200 dark:hover:bg-cyan-950/50">Copiar Pix</button>
        <% } %>
        <button id="btnCopyShareText" type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:-translate-y-0.5 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800"><%= copyTextButtonLabel %></button>
      </div>
    </div>
  </div>

  <div class="op-preview-shell op-fade-up op-share-preview-shell">
    <div class="op-preview-shell__label">Prévia da imagem</div>
    <div class="flex justify-center pb-2">
      <%- include('partials/share-summary-card', {
        cardId: 'cardPreview',
        person,
        periodLabel,
        items,
        visibleItems,
        formatBRL,
        getItemCents,
        getDescription,
        itemDate,
        totalCents,
        paidCents,
        remainingCents,
        exportMode: false,
        captureScale,
        footerLeft: 'Feito no AcerttaPay',
        totalLabel: 'Total do período',
        paymentTitle: 'Situação do pagamento',
        heroText,
        sharePixContext
      }) %>
    </div>
  </div>
</div>

<div aria-hidden="true" style="position:fixed; left:-99999px; top:0; pointer-events:none; opacity:0;">
  <%- include('partials/share-summary-card', {
    cardId: 'cardExport',
    person,
    periodLabel,
    items,
    visibleItems,
    formatBRL,
    getItemCents,
    getDescription,
    itemDate,
    totalCents,
    paidCents,
    remainingCents,
    exportMode: true,
    captureScale,
    footerLeft: 'Feito no AcerttaPay',
    totalLabel: 'Total do período',
    paymentTitle: 'Situação do pagamento',
    heroText,
    sharePixContext
  }) %>
</div>

<script src="/vendor/html2canvas/html2canvas.min.js"></script>
<script>
  const shareState = {
    file: null,
    objectUrl: null,
    promise: null
  };

  const CAPTURE_MAX_PIXELS = 24000000;
  const CAPTURE_MIN_SCALE = 1;
  const CAPTURE_MAX_SCALE = 2;
  const shareMessageText = <%- JSON.stringify(pageShareText) %>;
  const sharePixPayload = <%- JSON.stringify((sharePixContext && sharePixContext.available && sharePixContext.payload) || '') %>;
  const shareTitle = <%- JSON.stringify((shareContext && shareContext.shareTitle) || `Resumo ${periodLabel} — ${person.name}`) %>;

  function setBusy(button, loadingLabel) {
    if (!button) return () => {};
    const original = button.innerHTML;
    button.disabled = true;
    button.classList.add('op-button-loading');
    button.innerHTML = `<span class="op-submit-spinner" aria-hidden="true"></span><span>${loadingLabel}</span>`;
    return () => {
      button.disabled = false;
      button.classList.remove('op-button-loading');
      button.innerHTML = original;
    };
  }

  function normalizeCopyText(value) {
    return String(value || '').trim();
  }

  async function copyTextToClipboard(value) {
    const text = normalizeCopyText(value);
    if (!text) throw new Error('Nada foi preparado para copiar ainda.');

    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', 'readonly');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    textarea.style.top = '0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Não consegui copiar o texto agora.');
  }

  function ensureHtml2CanvasAvailable() {
    if (typeof window.html2canvas !== 'function') {
      throw new Error('A biblioteca de geração da imagem não foi carregada. Verifique se as dependências foram instaladas e recarregue a página.');
    }
  }

  function getCaptureSourceNode() {
    return document.getElementById('cardExport') || document.getElementById('cardPreview');
  }

  function getCaptureWidth(node) {
    const requestedWidth = Number((node && node.dataset && node.dataset.captureWidth) || 860) || 860;
    return Math.max(requestedWidth, 720);
  }

  function getRequestedCaptureScale(node) {
    const requestedScale = Number((node && node.dataset && node.dataset.captureScale) || CAPTURE_MAX_SCALE) || CAPTURE_MAX_SCALE;
    return Math.max(CAPTURE_MIN_SCALE, Math.min(CAPTURE_MAX_SCALE, requestedScale));
  }

  function waitForPaint() {
    return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
  }

  async function waitForFonts() {
    try {
      if (document.fonts && document.fonts.ready) {
        await document.fonts.ready;
      }
    } catch (_) {}
  }

  async function waitForImages(root) {
    const images = Array.from(root.querySelectorAll('img'));
    await Promise.all(images.map((img) => {
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise((resolve) => {
        const done = () => resolve();
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        window.setTimeout(done, 3000);
      });
    }));
  }

  async function waitForAssets(node) {
    await waitForFonts();
    await waitForImages(node);
    await waitForPaint();
  }

  function buildCaptureClone(sourceNode, baseWidth) {
    const stage = document.createElement('div');
    stage.setAttribute('data-capture-stage', 'true');
    stage.setAttribute('aria-hidden', 'true');
    Object.assign(stage.style, {
      position: 'fixed',
      left: '-100000px',
      top: '0',
      width: `${baseWidth}px`,
      padding: '0',
      margin: '0',
      background: '#ffffff',
      pointerEvents: 'none',
      opacity: '1',
      overflow: 'hidden',
      display: 'inline-block',
      boxSizing: 'border-box'
    });

    const clone = sourceNode.cloneNode(true);
    clone.id = `${sourceNode.id || 'share-card'}-capture`;
    Object.assign(clone.style, {
      width: `${baseWidth}px`,
      minWidth: `${baseWidth}px`,
      maxWidth: `${baseWidth}px`,
      margin: '0',
      display: 'block',
      position: 'static',
      left: '0',
      top: '0',
      transform: 'none',
      opacity: '1',
      visibility: 'visible',
      height: 'auto',
      minHeight: '0',
      overflow: 'hidden',
      background: '#ffffff',
      boxSizing: 'border-box'
    });
    clone.dataset.exportMode = '1';
    clone.classList.add('share-summary-card--export');

    stage.appendChild(clone);
    document.body.appendChild(stage);
    return { stage, clone };
  }

  function getCaptureScale(width, height, requestedScale) {
    const basePixels = Math.max(1, width) * Math.max(1, height);
    if (!basePixels) return requestedScale;
    const safeScale = Math.sqrt(CAPTURE_MAX_PIXELS / basePixels);
    return Math.max(CAPTURE_MIN_SCALE, Math.min(requestedScale, Number.isFinite(safeScale) ? safeScale : requestedScale));
  }

  function canvasHasMeaningfulContent(canvas) {
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d', { willReadFrequently: true }) : null;
    if (!ctx || !canvas.width || !canvas.height) return false;

    const sampleCols = Math.min(32, Math.max(8, Math.ceil(canvas.width / 90)));
    const sampleRows = Math.min(32, Math.max(8, Math.ceil(canvas.height / 90)));
    const stepX = Math.max(1, Math.floor(canvas.width / sampleCols));
    const stepY = Math.max(1, Math.floor(canvas.height / sampleRows));
    let nonBlankSamples = 0;

    for (let y = 0; y < canvas.height; y += stepY) {
      for (let x = 0; x < canvas.width; x += stepX) {
        const pixel = ctx.getImageData(x, y, 1, 1).data;
        const red = pixel[0];
        const green = pixel[1];
        const blue = pixel[2];
        const alpha = pixel[3];
        const isTransparent = alpha === 0;
        const isNearWhite = red >= 248 && green >= 248 && blue >= 248;

        if (!isTransparent && !isNearWhite) {
          nonBlankSamples += 1;
          if (nonBlankSamples >= 8) return true;
        }
      }
    }

    return false;
  }

  function trimTrailingBlankRows(canvas, label) {
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d', { willReadFrequently: true }) : null;
    if (!ctx || !canvas.width || !canvas.height) return canvas;

    const sampleCols = Math.min(64, Math.max(12, Math.ceil(canvas.width / 40)));
    const stepX = Math.max(1, Math.floor(canvas.width / sampleCols));
    let lastContentRow = -1;

    for (let y = canvas.height - 1; y >= 0; y -= 1) {
      let rowHasContent = false;
      for (let x = 0; x < canvas.width; x += stepX) {
        const pixel = ctx.getImageData(x, y, 1, 1).data;
        const isTransparent = pixel[3] === 0;
        const isNearWhite = pixel[0] >= 248 && pixel[1] >= 248 && pixel[2] >= 248;
        if (!isTransparent && !isNearWhite) {
          rowHasContent = true;
          break;
        }
      }
      if (rowHasContent) {
        lastContentRow = y;
        break;
      }
    }

    if (lastContentRow < 0) return canvas;

    const paddingRows = Math.min(24, Math.max(8, Math.round(canvas.height * 0.012)));
    const targetHeight = Math.min(canvas.height, lastContentRow + 1 + paddingRows);
    const trimmedRows = canvas.height - targetHeight;

    if (trimmedRows < 40) return canvas;

    const trimmedCanvas = document.createElement('canvas');
    trimmedCanvas.width = canvas.width;
    trimmedCanvas.height = targetHeight;
    const trimmedCtx = trimmedCanvas.getContext('2d');
    if (!trimmedCtx) return canvas;

    trimmedCtx.drawImage(
      canvas,
      0,
      0,
      canvas.width,
      targetHeight,
      0,
      0,
      trimmedCanvas.width,
      trimmedCanvas.height
    );

    console.info(`[${label}] trailing blank rows trimmed`, {
      originalHeight: canvas.height,
      targetHeight,
      trimmedRows
    });

    return trimmedCanvas;
  }

  async function renderReceiptCanvas(node, width, height, requestedScale, label) {
    const attempts = [
      { foreignObjectRendering: false },
      { foreignObjectRendering: true }
    ];
    let lastError = null;

    for (const attempt of attempts) {
      try {
        const canvas = await html2canvas(node, {
          scale: getCaptureScale(width, height, requestedScale),
          backgroundColor: '#ffffff',
          useCORS: true,
          logging: false,
          imageTimeout: 0,
          width,
          height,
          windowWidth: Math.max(width, getCaptureWidth(node)),
          windowHeight: height,
          scrollX: 0,
          scrollY: 0,
          removeContainer: true,
          ...attempt
        });

        if (!canvasHasMeaningfulContent(canvas)) {
          lastError = new Error('A captura foi gerada em branco.');
          continue;
        }

        console.info(`[${label}] capture ok`, {
          width: canvas.width,
          height: canvas.height,
          scale: getCaptureScale(width, height, requestedScale),
          foreignObjectRendering: Boolean(attempt.foreignObjectRendering)
        });
        return canvas;
      } catch (error) {
        lastError = error;
      }
    }

    throw lastError || new Error('Falha ao renderizar o resumo.');
  }

  async function buildReceiptCanvas() {
    ensureHtml2CanvasAvailable();
    const sourceNode = getCaptureSourceNode();
    if (!sourceNode) throw new Error('Resumo não encontrado para captura.');

    await waitForAssets(sourceNode);

    const requestedWidth = getCaptureWidth(sourceNode);
    const sourceRect = sourceNode.getBoundingClientRect();
    const baseWidth = Math.max(
      requestedWidth,
      Math.ceil(sourceRect.width || sourceNode.scrollWidth || sourceNode.offsetWidth || requestedWidth)
    );
    const requestedScale = getRequestedCaptureScale(sourceNode);
    const { stage, clone } = buildCaptureClone(sourceNode, baseWidth);

    try {
      await waitForAssets(clone);
      const cloneRect = clone.getBoundingClientRect();
      const width = Math.max(baseWidth, Math.ceil(cloneRect.width || clone.scrollWidth || clone.offsetWidth || baseWidth));
      const height = Math.max(600, Math.ceil(cloneRect.height || clone.scrollHeight || clone.offsetHeight || 0));

      console.info('[share] capture dimensions', { width, height, baseWidth, requestedScale });

      if (!width || !height) {
        throw new Error(`Não foi possível medir a área do resumo para captura (${width}x${height}).`);
      }

      const rawCanvas = await renderReceiptCanvas(clone, width, height, requestedScale, 'share');
      const canvas = trimTrailingBlankRows(rawCanvas, 'share');
      if (!canvas || canvas.width < 50 || canvas.height < 50) {
        throw new Error('A imagem foi gerada sem conteúdo útil.');
      }

      return canvas;
    } finally {
      stage.remove();
    }
  }

  function blobToFile(blob, filename) {
    if (!blob || !blob.size) {
      throw new Error('A imagem foi gerada vazia.');
    }
    return new File([blob], filename, { type: blob.type || 'image/png' });
  }

  function dataUrlToFile(dataUrl, filename) {
    const parts = String(dataUrl || '').split(',');
    if (parts.length < 2) {
      throw new Error('Não foi possível gerar a imagem para compartilhamento.');
    }
    const mimeMatch = parts[0].match(/data:(.*?);base64/);
    const mime = mimeMatch ? mimeMatch[1] : 'image/png';
    const binary = atob(parts[1]);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
    return new File([bytes], filename, { type: mime });
  }

  function canvasToFile(canvas, filename) {
    return new Promise((resolve, reject) => {
      if (canvas.toBlob) {
        canvas.toBlob((blob) => {
          if (blob && blob.size > 0) {
            console.info('[share] blob generated', { size: blob.size, type: blob.type || 'image/png' });
            try {
              resolve(blobToFile(blob, filename));
            } catch (error) {
              reject(error);
            }
            return;
          }

          try {
            const dataUrl = canvas.toDataURL('image/png');
            const file = dataUrlToFile(dataUrl, filename);
            console.info('[share] dataUrl generated without toBlob', { bytes: file.size });
            resolve(file);
          } catch (error) {
            reject(error);
          }
        }, 'image/png');
        return;
      }

      try {
        const dataUrl = canvas.toDataURL('image/png');
        const file = dataUrlToFile(dataUrl, filename);
        console.info('[share] dataUrl generated without toBlob', { bytes: file.size });
        resolve(file);
      } catch (error) {
        reject(error);
      }
    });
  }

  async function prepareShareFile(force) {
    if (!force && shareState.file) return shareState.file;
    if (!force && shareState.promise) return shareState.promise;

    const filename = `Fatura_<%= person.name.replace(/\s+/g,'_') %>_<%= String(month).padStart(2,'0') %>_<%= year %>.png`;
    shareState.promise = (async () => {
      const canvas = await buildReceiptCanvas();
      const file = await canvasToFile(canvas, filename);
      shareState.file = file;
      return file;
    })();

    try {
      return await shareState.promise;
    } finally {
      shareState.promise = null;
    }
  }

  function scheduleShareWarmup() {
    if (shareState.file || shareState.promise) return;
    const run = () => prepareShareFile(false).catch((error) => console.warn('[share] Pré-geração da imagem falhou', error));
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 1800 });
    } else {
      window.setTimeout(run, 350);
    }
  }

  function cleanupObjectUrl() {
    if (shareState.objectUrl) {
      URL.revokeObjectURL(shareState.objectUrl);
      shareState.objectUrl = null;
    }
  }

  function triggerDownloadFromFile(file) {
    cleanupObjectUrl();
    shareState.objectUrl = URL.createObjectURL(file);
    const link = document.createElement('a');
    link.download = file.name;
    link.href = shareState.objectUrl;
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(cleanupObjectUrl, 1500);
  }

  function canShareFiles(file) {
    if (!navigator.share) return false;
    try {
      return !navigator.canShare || navigator.canShare({ files: [file] });
    } catch (error) {
      console.warn('[share] navigator.canShare falhou', error);
      return false;
    }
  }


  function showShareToast(message, tone = 'info', options = {}) {
    const text = String(message || '').trim();
    if (!text) return null;
    if (typeof window.showAppToast === 'function') {
      return window.showAppToast(text, { tone, ...options });
    }
    console[tone === 'error' ? 'error' : 'log']('[share]', text);
    return null;
  }

  async function showShareAlert(message, { title = 'Não consegui concluir', tone = 'error', buttonLabel = 'Entendi' } = {}) {
    const text = String(message || '').trim();
    if (!text) return false;
    if (typeof window.showAppAlert === 'function') {
      await window.showAppAlert({ title, message: text, tone, buttonLabel });
      return true;
    }
    showShareToast(text, tone, title ? { title } : {});
    return false;
  }

  async function downloadReceipt() {
    const restore = setBusy(document.getElementById('btnPng'), 'Gerando imagem...');
    try {
      const file = await prepareShareFile(true);
      triggerDownloadFromFile(file);
    } finally {
      restore();
    }
  }

  async function shareReceipt() {
    const restore = setBusy(document.getElementById('btnShare'), 'Preparando compartilhamento...');
    try {
      const file = await prepareShareFile(false);

      if (canShareFiles(file)) {
        await navigator.share({
          title: shareTitle,
          text: shareMessageText,
          files: [file]
        });
        return;
      }

      triggerDownloadFromFile(file);
      try {
        await copyTextToClipboard(shareMessageText);
        showShareToast('O compartilhamento direto não apareceu neste aparelho. A imagem foi baixada e o texto do resumo ficou copiado para uso manual.', 'info', { title: 'Use o envio manual' });
      } catch (_) {
        showShareToast('O compartilhamento direto não apareceu neste aparelho. A imagem foi baixada para compartilhamento manual.', 'info', { title: 'Use o envio manual' });
      }
    } catch (error) {
      if (error && error.name === 'AbortError') return;
      console.error('[share] share failure', error);
      try {
        const fallbackFile = shareState.file || await prepareShareFile(true);
        triggerDownloadFromFile(fallbackFile);
        try {
          await copyTextToClipboard(shareMessageText);
          showShareToast('Não consegui abrir o menu de compartilhamento agora. A imagem foi baixada e o texto do resumo ficou copiado para uso manual.', 'info', { title: 'Use o envio manual' });
        } catch (_) {
          showShareToast('Não consegui abrir o menu de compartilhamento agora. A imagem foi baixada para compartilhamento manual.', 'info', { title: 'Use o envio manual' });
        }
      } catch (downloadError) {
        console.error('[share] fallback failure', downloadError);
        await showShareAlert('Não foi possível gerar ou compartilhar a imagem agora.', { title: 'Falha no compartilhamento', tone: 'error' });
      }
    } finally {
      restore();
    }
  }

  async function copyShareText() {
    try {
      await copyTextToClipboard(shareMessageText);
      showShareToast('Texto do resumo copiado. Agora é só colar no canal desejado.', 'success', { title: 'Texto copiado' });
    } catch (error) {
      console.error('[share] copy text failure', error);
      showShareToast(error && error.message ? error.message : 'Não consegui copiar o texto agora.', 'error', { title: 'Não consegui copiar' });
    }
  }

  async function copyPixPayload() {
    try {
      await copyTextToClipboard(sharePixPayload);
      showShareToast('Pix copia e cola copiado. Agora é só enviar esse atalho.', 'success', { title: 'Pix copiado' });
    } catch (error) {
      console.error('[share] copy pix failure', error);
      showShareToast(error && error.message ? error.message : 'Não consegui copiar o Pix agora.', 'error', { title: 'Não consegui copiar' });
    }
  }

  document.getElementById('btnPng')?.addEventListener('click', downloadReceipt);
  document.getElementById('btnShare')?.addEventListener('click', shareReceipt);
  document.getElementById('btnCopyShareText')?.addEventListener('click', copyShareText);
  document.getElementById('btnCopyPix')?.addEventListener('click', copyPixPayload);
  document.getElementById('btnShare')?.addEventListener('touchstart', scheduleShareWarmup, { passive: true, once: true });
  document.getElementById('btnShare')?.addEventListener('mouseenter', scheduleShareWarmup, { once: true });
  document.getElementById('btnShare')?.addEventListener('focus', scheduleShareWarmup, { once: true });
  window.addEventListener('load', scheduleShareWarmup, { once: true });
  window.addEventListener('beforeunload', cleanupObjectUrl);
</script>

