                            <div class="sm:text-right">
                              <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= sheetMeta.classes %>"><%= sheetMeta.label %></span>
                              <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(itemPendingCents(item) > 0 ? itemPendingCents(item) : itemTotalCents(item)) %></div>
                              <% if (itemPaidCents(item) > 0) { %><div class="mt-1 text-xs font-bold text-emerald-600 dark:text-emerald-300"><%= formatBRLFromCents(itemPaidCents(item)) %> já entrou nesse acerto</div><% } %>
                            </div>
                          </div>
                          <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">
                              <span class="font-semibold text-slate-700 dark:text-slate-200"><span class="md:hidden">Mês:</span><span class="hidden md:inline">Competência:</span></span>
                              <%= item.source_due_month && item.source_due_year ? monthLabel(item.source_due_month, item.source_due_year) : '—' %>
                            </div>
                            <button type="button" data-jump-request="request-<%= item.id %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">
                              Abrir acerto
                            </button>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="divide-y divide-slate-200 dark:divide-slate-700">
                <% group.items.forEach(item => {
                  const meta = statusMeta(item);
                  const isHighlighted = requestIdToHighlight && Number(requestIdToHighlight) === Number(item.id);
                  const timeline = timelineFor(item.id);
                %>
                  <details id="request-<%= item.id %>" class="<%= isHighlighted ? 'bg-blue-50/70 dark:bg-blue-900/10' : 'bg-white/80 dark:bg-slate-900/20' %>" <%= isHighlighted ? 'open' : '' %>>
                    <summary class="list-none cursor-pointer px-5 py-4">
                      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-bold text-slate-900 dark:text-white truncate"><%= item.description_snapshot %></h3>
                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-bold <%= meta.classes %>"><%= meta.label %></span>
                          </div>
                          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium text-slate-500 dark:text-slate-400">
                            <span>Enviado para <span class="font-semibold text-slate-700 dark:text-slate-200"><%= item.receiver_name || item.receiver_email || item.receiver_email_snapshot || 'Usuário' %></span></span>
                            <span>Compra em <span class="font-semibold text-slate-700 dark:text-slate-200"><%= item.source_txn_date ? formatDateBR(item.source_txn_date) : '—' %></span></span>
                            <span>Cartão <span class="font-semibold text-slate-700 dark:text-slate-200"><%= item.card_name_snapshot || 'Não informado' %></span></span>
                          </div>
                        </div>
                        <div class="flex items-center justify-between gap-3 lg:block lg:text-right">
                          <div>
                            <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Valor</div>
                            <div class="mt-1 text-lg font-extrabold text-slate-900 dark:text-white"><%= formatBRLFromCents(itemPendingCents(item) > 0 ? itemPendingCents(item) : itemTotalCents(item)) %></div>
                            <% if (itemPaidCents(item) > 0) { %><div class="mt-1 text-xs font-bold text-emerald-600 dark:text-emerald-300"><%= formatBRLFromCents(itemPaidCents(item)) %> já entrou</div><% } %>
                          </div>
                          <div class="text-sm font-bold text-blue-600 dark:text-blue-300">Ver detalhes</div>
                        </div>
                      </div>
                    </summary>

                    <div class="px-5 pb-5 pt-1 space-y-4 border-t border-slate-200 dark:border-slate-700">
                      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/70 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500"><span class="md:hidden">Mês</span><span class="hidden md:inline">Competência</span></div>
                          <div class="mt-1 text-sm font-bold text-slate-900 dark:text-white"><%= item.source_due_month && item.source_due_year ? monthLabel(item.source_due_month, item.source_due_year) : '—' %></div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/70 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Data da compra</div>
                          <div class="mt-1 text-sm font-bold text-slate-900 dark:text-white"><%= item.source_txn_date ? formatDateBR(item.source_txn_date) : '—' %></div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/70 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Cartão</div>
                          <div class="mt-1 text-sm font-bold text-slate-900 dark:text-white"><%= item.card_name_snapshot || 'Não informado' %></div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/70 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Observação do envio</div>
                          <div class="mt-1 text-sm font-medium text-slate-700 dark:text-slate-200"><%= item.request_note || '—' %></div>
                        </div>
                      </div>

                      <% if (item.response_note) { %>
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Observação da resposta</div>
                          <div class="mt-1 text-sm font-medium text-slate-700 dark:text-slate-200"><%= item.response_note %></div>
                        </div>
                      <% } %>

                      <% if (item.status === 'rejected_by_receiver') { %>
                        <div class="rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 px-4 py-4">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Decidir sobre a rejeição</div>
                          <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">Você pode aceitar a rejeição e encerrar este acerto ou contestá-la. Enquanto estiver em disputa, ele não entra no quadro financeiro da outra pessoa.</p>
                          <form method="POST" action="/shared-debts/<%= item.id %>/sender-action" class="mt-3 space-y-3">
                            <label class="block">
                              <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Observação para <%= item.receiver_name || item.receiver_email || item.receiver_email_snapshot || 'o destinatário' %> (opcional)</span>
                              <textarea name="note" rows="2" class="w-full rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100 dark:focus:border-blue-500 dark:focus:ring-blue-500/20" placeholder="Ex.: Entendi sua posição, vou encerrar por aqui."></textarea>
                            </label>
                            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end op-shared-action-row op-shared-action-row--compact">
                              <button type="submit" name="action" value="accept_rejection" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">Aceitar rejeição</button>
                              <button type="submit" name="action" value="contest_rejection" class="inline-flex items-center justify-center rounded-2xl bg-amber-500 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-amber-600 transition-colors">Contestar rejeição</button>
                            </div>
                          </form>
                        </div>
                      <% } else if (item.status === 'accepted' && !item.payment_marked_at) { const itemSettlement = cardMonthlySnapshotForItem(item); const settlementHasReserved = itemSettlement && Math.max(0, Number(itemSettlement.reservedCents || 0)) > 0; %>
                        <div class="rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/20 px-4 py-3">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Acerto aceito e aguardando pagamento</div>
                          <div class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300"><%= settlementHasReserved ? 'Já existe um Pix desse mês esperando seu ok final. Enquanto isso, o restante continua aparecendo na carteira mensal sem bagunçar as compras lá de baixo.' : 'O pagamento deste cartão agora corre pela carteira do mês. Quando a outra pessoa avisar um Pix, você vai confirmar esse recebimento pelo resumo mensal.' %></div>
                          <% if (itemSettlement) { %>
                            <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
                              <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 dark:border-slate-700 dark:bg-slate-900/60"><%= monthLabel(itemSettlement.month || item.source_due_month, itemSettlement.year || item.source_due_year) %></span>
                              <span class="inline-flex items-center rounded-full border border-emerald-200 bg-white px-3 py-1 dark:border-emerald-800 dark:bg-slate-900/60"><%= formatBRLFromCents(itemSettlement.openCents || 0) %> em aberto</span>
                              <% if (Number(itemSettlement.reservedCents || 0) > 0) { %><span class="inline-flex items-center rounded-full border border-sky-200 bg-white px-3 py-1 text-sky-700 dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-200"><%= formatBRLFromCents(itemSettlement.reservedCents || 0) %> aguardando seu ok</span><% } %>
                            </div>
                          <% } %>
                        </div>
                      <% } else if (item.status === 'accepted' && item.payment_marked_at) { %>
                        <div class="rounded-2xl border border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-900/20 px-4 py-4">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Pagamento aguardando sua confirmação</div>
                          <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-300">O destinatário informou o pagamento em <strong><%= formatDateBR(item.payment_marked_at) %></strong> às <strong><%= formatTimeBR(item.payment_marked_at) %></strong>. Confirme abaixo quando o valor tiver realmente entrado.</p>
                          <% if (item.payment_note) { %>
                            <div class="mt-2 text-sm text-slate-600 dark:text-slate-300">Observação do pagamento: <span class="font-medium"><%= item.payment_note %></span></div>
                          <% } %>
                          <form method="POST" action="/shared-debts/<%= item.id %>/confirm-receipt" class="mt-3 space-y-3">
                            <label class="block">
                              <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Observação da liquidação (opcional)</span>
                              <textarea name="note" rows="2" class="w-full rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-100 dark:focus:border-sky-500 dark:focus:ring-sky-500/20" placeholder="Ex.: Recebido e conferido no extrato."></textarea>
                            </label>
                            <div class="flex justify-end">
                              <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-sky-700 transition-colors">Confirmar recebimento</button>
                            </div>
                          </form>
                        </div>
                      <% } else if (item.status === 'rejection_contested_by_sender') { %>
                        <div class="rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 px-4 py-3">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Acerto em disputa</div>
                          <div class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Esse acerto foi contestado por você e fica só em acompanhamento, sem entrar no quadro financeiro da outra pessoa.</div>
                        </div>
                      <% } else if (item.status === 'rejection_accepted_by_sender') { %>
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 px-4 py-3">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Acerto encerrado</div>
                          <div class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Você aceitou a rejeição deste acerto. Ele fica só no histórico para consulta futura.</div>
                        </div>
                      <% } else if (item.status === 'settled') { %>
                        <div class="rounded-2xl border border-cyan-200 dark:border-cyan-800 bg-cyan-50 dark:bg-cyan-900/20 px-4 py-3">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Dívida liquidada</div>
                          <div class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">O recebimento foi confirmado em <strong><%= item.resolved_at ? formatDateBR(item.resolved_at) : 'data não informada' %></strong><% if (item.resolved_at) { %> às <strong><%= formatTimeBR(item.resolved_at) %></strong><% } %>.</div>
                        </div>
                      <% } %>


                      <% if (canArchiveItem(item)) { %>
                        <div class="flex justify-end">
                          <form method="POST" action="<%= archiveToggleAction(item) %>" class="contents">
                            <input type="hidden" name="return_to" value="<%= currentPath %>">
                            <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"><%= archiveToggleLabel(item) %></button>
                          </form>
                        </div>
                      <% } %>

                      <% if (timeline.length) { %>
                        <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-900/50 px-4 py-4">
                          <div class="text-sm font-bold text-slate-900 dark:text-white">Histórico</div>
                          <div class="mt-3 space-y-3">
                            <% timeline.forEach(event => { const eMeta = eventMeta(event.event_type); %>
                              <div class="flex gap-3">
                                <div class="pt-1.5"><span class="block h-2.5 w-2.5 rounded-full <%= eMeta.dot %>"></span></div>
                                <div class="min-w-0 flex-1">
                                  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                                    <div class="text-sm font-semibold text-slate-800 dark:text-slate-100"><%= eMeta.label %></div>
                                    <div class="text-xs font-medium text-slate-400 dark:text-slate-500"><%= formatDateBR(event.created_at) %> • <%= formatTimeBR(event.created_at) %></div>
                                  </div>
                                  <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">Por <%= actorLabel(event) %></div>
                                  <% if (event.note) { %>
                                    <div class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= event.note %></div>
                                  <% } %>
                                </div>
                              </div>
                            <% }) %>
                          </div>
                        </div>
                      <% } %>
                    </div>
                  </details>
                <% }) %>
              </div>
            </details>
          <% }) %>
        </div>
      <% } %>
      </div>
    </details>
  </section>
</div>

<script>
  function openSharedDebtScopeFromHash() {
    const hash = window.location.hash;
    if (!hash) return;

    const scope = document.querySelector(hash);
    if (scope instanceof HTMLDetailsElement) {
      scope.open = true;
    }
  }

  function openRequestChain(target) {
    if (!target) return;

    let current = target;
    while (current) {
      if (current instanceof HTMLDetailsElement) current.open = true;
      current = current.parentElement ? current.parentElement.closest('details') : null;
    }

    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  const pixSheetState = { requestId: null, data: null };

  function showPixToast(message, tone = 'info') {
    if (!message) return;
    const toast = document.createElement('div');
    const toneClass = tone === 'success'
      ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200'
      : (tone === 'error'
        ? 'border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-900 dark:bg-rose-900/30 dark:text-rose-200'
        : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100');
    toast.className = `fixed bottom-24 left-1/2 z-[95] -translate-x-1/2 rounded-2xl border px-4 py-3 text-sm font-bold shadow-xl ${toneClass}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    window.setTimeout(() => {
      toast.remove();
    }, 2600);
  }

  async function copyTextToClipboard(text) {
    const safeText = String(text || '');
    if (!safeText) throw new Error('Nada para copiar por enquanto.');

    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(safeText);
      return true;
    }

    const textarea = document.createElement('textarea');
    textarea.value = safeText;
    textarea.setAttribute('readonly', 'readonly');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Não consegui copiar agora.');
    return true;
  }

  function closeSharedDebtSheets() {
    document.querySelectorAll('[data-shared-debts-sheet]').forEach((sheet) => {
      sheet.classList.add('hidden');
    });
    document.body.classList.remove('overflow-hidden');
  }

  function openSharedDebtSheet(sheetId) {
    const sheet = document.getElementById(sheetId);
    if (!sheet) return;
    closeSharedDebtSheets();
    sheet.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');

    const preferredInput = sheet.querySelector('[data-shared-debt-manual-focus]');
    if (preferredInput instanceof HTMLInputElement && !preferredInput.disabled) {
      const focusNow = () => {
        try {
          preferredInput.focus({ preventScroll: true });
        } catch (error) {
          preferredInput.focus();
        }
        try {
          preferredInput.select();
        } catch (error) {
          // noop
        }
      };

      requestAnimationFrame(focusNow);
      window.setTimeout(focusNow, 120);
    }
  }

  function setPixSheetState(mode, message = '') {
    const loading = document.querySelector('[data-pix-sheet-loading]');
    const errorBox = document.querySelector('[data-pix-sheet-error]');
    const content = document.querySelector('[data-pix-sheet-content]');
    if (!loading || !errorBox || !content) return;

    loading.classList.toggle('hidden', mode !== 'loading');
    errorBox.classList.toggle('hidden', mode !== 'error');
    content.classList.toggle('hidden', mode !== 'ready');

    if (mode === 'error') {
      errorBox.textContent = message || 'O Pix quase saiu, mas ainda tropeçou num detalhe.';
    }
  }

  function renderPixSheet(data) {
    const title = document.querySelector('[data-pix-sheet-title]');
    const subtitle = document.querySelector('[data-pix-sheet-subtitle]');
    const amount = document.querySelector('[data-pix-sheet-amount]');
    const keyMeta = document.querySelector('[data-pix-sheet-key-meta]');
    const city = document.querySelector('[data-pix-sheet-city]');
    const payload = document.querySelector('[data-pix-sheet-payload]');
    const qrImg = document.querySelector('[data-pix-sheet-qr]');
    const qrHint = document.querySelector('[data-pix-sheet-qr-hint]');

    if (title) title.textContent = data?.creditorName ? `Pix de ${data.creditorName}` : 'Pix do acerto avulso';
    if (subtitle) subtitle.textContent = data?.description ? `${data.description} · confirmação continua manual por aqui.` : 'Confirmação manual por aqui, pagamento no banco da pessoa.';
    if (amount) amount.textContent = data?.amountFormatted || '—';
    if (keyMeta) keyMeta.textContent = data?.maskedKey ? `${data.keyTypeLabel || 'Chave Pix'} · ${data.maskedKey}` : (data?.keyTypeLabel || '—');
    if (city) city.textContent = data?.city || '—';
    if (payload) payload.value = data?.payload || '';
    if (qrImg) {
      if (data?.qrDataUrl) {
        qrImg.src = data.qrDataUrl;
        qrImg.classList.remove('hidden');
      } else {
        qrImg.removeAttribute('src');
        qrImg.classList.add('hidden');
      }
    }
    if (qrHint) {
      qrHint.textContent = data?.qrDataUrl
        ? 'Se preferir, é só apontar a câmera do banco para esse QR.'
        : 'O copia e cola está prontinho. Quando a dependência do QR entrar, ele aparece aqui também.';
    }
  }

  async function fetchPixData(requestId) {
    const response = await fetch(`/shared-debts/${requestId}/pix`, {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin'
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data?.ok === false) {
      throw new Error(data?.message || 'O Pix não apareceu por aqui agora.');
    }
    return data;
  }

  async function ensurePixData(requestId) {
    if (pixSheetState.requestId === Number(requestId) && pixSheetState.data) {
      return pixSheetState.data;
    }
    const data = await fetchPixData(requestId);
    pixSheetState.requestId = Number(requestId);
    pixSheetState.data = data;
    return data;
  }

  async function openPixSheet(requestId) {
    openSharedDebtSheet('shared-debt-pix-sheet');
    setPixSheetState('loading');
    try {
      const data = await ensurePixData(requestId);
      renderPixSheet(data);
      setPixSheetState('ready');
    } catch (error) {
      setPixSheetState('error', error?.message || 'O Pix quase saiu, mas ainda tropeçou num detalhe.');
    }
  }

  async function sharePixData(data) {
    const shareText = data?.shareText || data?.payload || '';
    if (!shareText) throw new Error('Ainda não apareceu nada para compartilhar.');

    if (navigator.share) {
      await navigator.share({
        title: data?.shareTitle || (data?.creditorName ? `Acerto com Pix de ${data.creditorName}` : 'Acerto com Pix'),
        text: shareText
      });
      showPixToast('Acerto compartilhado. Agora é só aguardar o combinado andar.','success');
      return;
    }

    await copyTextToClipboard(shareText);
    showPixToast('Texto do acerto copiado. É só colar onde quiser.','success');
  }

  async function handlePixAction(action, requestId) {
    const cleanRequestId = Number(requestId || 0);
    if (!cleanRequestId) return;

    if (action === 'show') {
      await openPixSheet(cleanRequestId);
      return;
    }

    try {
      const data = await ensurePixData(cleanRequestId);
      if (action === 'copy') {
        await copyTextToClipboard(data?.payload || '');
        showPixToast('Pix copiado. Agora é só colar no banco e seguir o baile.','success');
        return;
      }

      if (action === 'share') {
        await sharePixData(data);
      }
    } catch (error) {
      showPixToast(error?.message || 'O Pix não apareceu por aqui agora.', 'error');
    }
  }

  const cardMonthlySheetState = {
    settlementId: null,
    prepare: null,
    pix: null,
    mode: 'full',
    amountCents: 0
  };

  const brlFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

  function formatClientBRL(cents) {
    return brlFormatter.format((Number(cents || 0) || 0) / 100);
  }

  function parseMoneyInputToCents(rawValue) {
    const value = String(rawValue || '').trim();
    if (!value) return 0;
    const normalized = value
      .replace(/\s+/g, '')
      .replace(/R\$/gi, '')
      .replace(/[^\d,.-]/g, '')
      .replace(/\.(?=.*\.)/g, '');

    if (!normalized) return 0;

    let decimalSafe = normalized;
    if (decimalSafe.includes(',')) {
      decimalSafe = decimalSafe.replace(/\./g, '').replace(',', '.');
    }

    const amount = Number(decimalSafe);
    if (!Number.isFinite(amount) || amount <= 0) return 0;
    return Math.round(amount * 100);
  }

  function buildCardMonthlyPreview(rows, rawAmountCents) {
    const safeRows = Array.isArray(rows) ? rows : [];
    const requestedAmount = Math.max(0, Number(rawAmountCents || 0));
    let remaining = requestedAmount;
    let allocated = 0;
    let touchedCount = 0;
    let fullySettledCount = 0;
    let partialRow = null;
    const previewRows = [];

    safeRows.forEach((row) => {
      const pending = Math.max(0, Number(row?.pendingCents || 0));
      if (!pending || remaining <= 0) return;
      const used = Math.min(pending, remaining);
      remaining -= used;
      allocated += used;
      touchedCount += 1;
      if (used >= pending) {
        fullySettledCount += 1;
      } else if (!partialRow) {
        partialRow = {
          description: row?.description || 'um acerto do mês',
          usedCents: used,
          pendingCents: pending,
          remainingCents: pending - used
        };
      }
      previewRows.push({
        id: row?.id,
        description: row?.description || 'Compra sem descrição',
        txnDate: row?.txnDate || null,
        pendingCents: pending,
        usedCents: used,
        remainingCents: Math.max(0, pending - used)
      });
    });

    let summary = 'Esse valor ainda não encosta em nenhum acerto do mês.';
    if (allocated > 0 && !partialRow && fullySettledCount > 0) {
      summary = `${formatClientBRL(allocated)} cobre ${fullySettledCount} ${fullySettledCount === 1 ? 'acerto' : 'acertos'} por completo nessa carteira.`;
    } else if (allocated > 0 && partialRow) {
      summary = `${formatClientBRL(allocated)} cobre ${fullySettledCount} ${fullySettledCount === 1 ? 'acerto' : 'acertos'} por completo e deixa “${partialRow.description}” com ${formatClientBRL(partialRow.remainingCents)} ainda em aberto.`;
    }

    return {
      amountCents: requestedAmount,
      allocatedCents: allocated,
      remainingToAllocateCents: Math.max(0, remaining),
      touchedCount,
      fullySettledCount,
      partialRow,
      rows: previewRows,
      summary
    };
  }

  function setCardMonthlySheetState(mode, message = '') {
    const loading = document.querySelector('[data-card-monthly-loading]');
    const errorBox = document.querySelector('[data-card-monthly-error]');
    const config = document.querySelector('[data-card-monthly-config]');
    const pix = document.querySelector('[data-card-monthly-pix]');
    if (!loading || !errorBox || !config || !pix) return;
    loading.classList.toggle('hidden', mode !== 'loading');
    errorBox.classList.toggle('hidden', mode !== 'error');
    config.classList.toggle('hidden', mode !== 'config');
    pix.classList.toggle('hidden', mode !== 'pix');
    if (mode === 'error') {
      errorBox.textContent = message || 'O Pix do mês quase saiu, mas ainda tropeçou num detalhe por aqui.';
    }
  }

  function setCardMonthlyChoice(mode) {
    const fullBtn = document.querySelector('[data-card-monthly-choice="full"]');
    const customBtn = document.querySelector('[data-card-monthly-choice="custom"]');
    const customWrap = document.querySelector('[data-card-monthly-custom-wrap]');
    const customInput = document.querySelector('[data-card-monthly-custom-input]');
    cardMonthlySheetState.mode = mode === 'custom' ? 'custom' : 'full';

    const fullActive = cardMonthlySheetState.mode === 'full';
    if (fullBtn) fullBtn.className = `rounded-2xl border px-4 py-3 text-left shadow-sm transition-colors ${fullActive ? 'border-emerald-200 bg-white hover:bg-emerald-50 dark:border-emerald-800 dark:bg-slate-900/70 dark:hover:bg-emerald-900/20' : 'border-slate-200 bg-white hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/70 dark:hover:bg-slate-800'}`;
    if (customBtn) customBtn.className = `rounded-2xl border px-4 py-3 text-left shadow-sm transition-colors ${!fullActive ? 'border-emerald-200 bg-white hover:bg-emerald-50 dark:border-emerald-800 dark:bg-slate-900/70 dark:hover:bg-emerald-900/20' : 'border-slate-200 bg-white hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/70 dark:hover:bg-slate-800'}`;
    if (customWrap) customWrap.classList.toggle('hidden', fullActive);
    if (!fullActive && customInput) {
      window.setTimeout(() => customInput.focus(), 60);
    }
  }

  function getCardMonthlySelectedAmountCents() {
    const openCents = Math.max(0, Number(cardMonthlySheetState.prepare?.openCents || 0));
    if (cardMonthlySheetState.mode === 'custom') {
      const customInput = document.querySelector('[data-card-monthly-custom-input]');
      return Math.min(openCents, parseMoneyInputToCents(customInput?.value || ''));
    }
    return openCents;
  }

  function renderCardMonthlyPreview() {
    const prepare = cardMonthlySheetState.prepare;
    if (!prepare) return;

    const selectedAmountCents = getCardMonthlySelectedAmountCents();
    cardMonthlySheetState.amountCents = selectedAmountCents;

    const previewAmount = document.querySelector('[data-card-monthly-preview-amount]');
    const previewSummary = document.querySelector('[data-card-monthly-preview-summary]');
    const previewList = document.querySelector('[data-card-monthly-preview-list]');
    const generateBtn = document.querySelector('[data-card-monthly-generate]');
    const customInput = document.querySelector('[data-card-monthly-custom-input]');

    if (previewAmount) previewAmount.textContent = selectedAmountCents ? formatClientBRL(selectedAmountCents) : 'Escolha um valor';

    const preview = buildCardMonthlyPreview(prepare?.preview?.rows || [], selectedAmountCents);

    if (previewSummary) {
      previewSummary.textContent = selectedAmountCents
        ? preview.summary
        : 'Escolha o valor do Pix para eu te mostrar como ele vai encostar nas compras desse mês.';
    }

    if (previewList) {
      previewList.innerHTML = '';
      if (selectedAmountCents && preview.rows.length) {
        preview.rows.slice(0, 4).forEach((row) => {
          const rowEl = document.createElement('div');
          rowEl.className = 'rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/70';
          rowEl.innerHTML = `
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="text-sm font-bold text-slate-900 dark:text-white truncate">${String(row.description || 'Compra sem descrição')}</div>
                <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">${row.txnDate ? `Compra de ${row.txnDate}` : 'Compra do mês'}</div>
              </div>
              <div class="sm:text-right">
                <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Vai agora</div>
                <div class="mt-1 text-sm font-black text-slate-900 dark:text-white">${formatClientBRL(row.usedCents || 0)}</div>
                ${Number(row.remainingCents || 0) > 0 ? `<div class="mt-1 text-xs font-medium text-amber-600 dark:text-amber-300">Ainda faltam ${formatClientBRL(row.remainingCents || 0)}</div>` : '<div class="mt-1 text-xs font-medium text-emerald-600 dark:text-emerald-300">Fecha essa peça por completo</div>'}
              </div>
            </div>`;
          previewList.appendChild(rowEl);
        });
        if (preview.rows.length > 4) {
          const moreEl = document.createElement('div');
          moreEl.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';
          moreEl.textContent = `... e mais ${preview.rows.length - 4} ${preview.rows.length - 4 === 1 ? 'acerto' : 'acertos'} nessa mesma ordem.`;
          previewList.appendChild(moreEl);
        }
      }
    }

    if (generateBtn) {
      const pixAvailable = !!prepare?.pixAvailable;
      generateBtn.disabled = !pixAvailable || !selectedAmountCents;
      generateBtn.textContent = pixAvailable ? 'Gerar Pix' : 'Pix indisponível agora';
    }

    if (customInput && cardMonthlySheetState.mode === 'custom' && selectedAmountCents) {
      customInput.dataset.lastValidValue = formatClientBRL(selectedAmountCents);
    }
  }

  function renderCardMonthlyPrepare(data) {
    const title = document.querySelector('[data-card-monthly-title]');
    const subtitle = document.querySelector('[data-card-monthly-subtitle]');
    const total = document.querySelector('[data-card-monthly-total]');
    const confirmed = document.querySelector('[data-card-monthly-confirmed]');
    const reserved = document.querySelector('[data-card-monthly-reserved]');
    const open = document.querySelector('[data-card-monthly-open]');
    const fullLabel = document.querySelector('[data-card-monthly-full-label]');
    const customMax = document.querySelector('[data-card-monthly-custom-max]');
    const errorBox = document.querySelector('[data-card-monthly-error]');

    if (title) title.textContent = data?.counterpartName ? `Pix do mês com ${data.counterpartName}` : 'Pix do cartão do mês';
    if (subtitle) subtitle.textContent = data?.monthLabel ? `Carteira de ${data.monthLabel}. Você pode pagar o valor todo ou só uma parte agora.` : 'Você escolhe quanto vai pagar e eu monto o Pix no valor certinho.';
    if (total) total.textContent = data?.totalAcceptedFormatted || '—';
    if (confirmed) confirmed.textContent = data?.confirmedFormatted || '—';
    if (reserved) reserved.textContent = data?.reservedFormatted || '—';
    if (open) open.textContent = data?.openFormatted || '—';
    if (fullLabel) fullLabel.textContent = data?.openFormatted || '—';
    if (customMax) customMax.textContent = data?.openFormatted || '—';

    if (errorBox && !data?.pixAvailable && data?.pixUnavailableReason) {
      errorBox.textContent = data.pixUnavailableReason;
      errorBox.classList.remove('hidden');
    } else if (errorBox) {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }

    const customInput = document.querySelector('[data-card-monthly-custom-input]');
    if (customInput) {
      customInput.value = '';
      customInput.dataset.lastValidValue = data?.openFormatted || '';
    }

    setCardMonthlyChoice('full');
    renderCardMonthlyPreview();
  }

  function renderCardMonthlyPix(data) {
    const title = document.querySelector('[data-card-monthly-title]');
    const subtitle = document.querySelector('[data-card-monthly-subtitle]');
    const amount = document.querySelector('[data-card-monthly-pix-amount]');
    const keyMeta = document.querySelector('[data-card-monthly-pix-key-meta]');
    const city = document.querySelector('[data-card-monthly-pix-city]');
    const payload = document.querySelector('[data-card-monthly-pix-payload]');
    const qrImg = document.querySelector('[data-card-monthly-pix-qr]');
    const qrHint = document.querySelector('[data-card-monthly-pix-qr-hint]');
    const noteField = document.querySelector('[data-card-monthly-pix-note]');

    if (title) title.textContent = data?.creditorName ? `Pix do mês para ${data.creditorName}` : 'Pix do cartão do mês';
    if (subtitle) subtitle.textContent = data?.monthLabel ? `${data.monthLabel} · se quiser, já avisa daqui mesmo quando fizer o pagamento.` : 'Paga no banco e depois avisa por aqui para o outro lado confirmar.';
    if (amount) amount.textContent = data?.amountFormatted || '—';
    if (keyMeta) keyMeta.textContent = data?.maskedKey ? `${data.keyTypeLabel || 'Chave Pix'} · ${data.maskedKey}` : (data?.keyTypeLabel || '—');
    if (city) city.textContent = data?.city || '—';
    if (payload) payload.value = data?.payload || '';
    if (noteField) noteField.value = '';
    if (qrImg) {
      if (data?.qrDataUrl) {
        qrImg.src = data.qrDataUrl;
        qrImg.classList.remove('hidden');
      } else {
        qrImg.removeAttribute('src');
        qrImg.classList.add('hidden');
      }
    }
    if (qrHint) {
      qrHint.textContent = data?.qrDataUrl
        ? 'Se preferir, é só apontar a câmera do banco para esse QR.'
        : 'O copia e cola está prontinho. Quando a dependência do QR estiver redonda por aqui, ele aparece também.';
    }
  }

  async function fetchCardMonthlyPrepare(settlementId) {
    const response = await fetch(`/shared-debts/monthly-settlements/${settlementId}/prepare`, {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin'
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data?.ok === false) {
      throw new Error(data?.message || 'Não consegui abrir a carteira do mês agora.');
    }
    return data;
  }

  async function openCardMonthlySheet(settlementId) {
    const cleanSettlementId = Number(settlementId || 0);
    if (!cleanSettlementId) return;
    openSharedDebtSheet('shared-debt-card-monthly-sheet');
    setCardMonthlySheetState('loading');
    cardMonthlySheetState.pix = null;
    try {
      const data = await fetchCardMonthlyPrepare(cleanSettlementId);
      cardMonthlySheetState.settlementId = cleanSettlementId;
      cardMonthlySheetState.prepare = data;
      cardMonthlySheetState.amountCents = Math.max(0, Number(data?.openCents || 0));
      renderCardMonthlyPrepare(data);
      setCardMonthlySheetState('config');
    } catch (error) {
      setCardMonthlySheetState('error', error?.message || 'Não consegui abrir a carteira do mês agora.');
    }
  }

  async function generateCardMonthlyPix() {
    const settlementId = Number(cardMonthlySheetState.settlementId || 0);
    const amountCents = getCardMonthlySelectedAmountCents();
    if (!settlementId) return;
    if (!amountCents) {
      showPixToast('Me conta quanto vai nesse Pix para eu montar o código certinho.', 'info');
      return;
    }

    const body = new URLSearchParams();
    body.set('amount_cents', String(amountCents));

    const button = document.querySelector('[data-card-monthly-generate]');
    if (button) button.disabled = true;
    try {
      const response = await fetch(`/shared-debts/monthly-settlements/${settlementId}/pix`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
        },
        credentials: 'same-origin',
        body: body.toString()
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data?.ok === false) {
        throw new Error(data?.message || 'O Pix do mês quase saiu, mas ainda tropeçou num detalhe.');
      }
      cardMonthlySheetState.pix = data;
      renderCardMonthlyPix(data);
      setCardMonthlySheetState('pix');
    } catch (error) {
      showPixToast(error?.message || 'O Pix do mês quase saiu, mas ainda tropeçou num detalhe.', 'error');
      if (button) button.disabled = false;
    }
  }

  async function reportCardMonthlyPix() {
    const settlementId = Number(cardMonthlySheetState.settlementId || 0);
    const intentId = Number(cardMonthlySheetState.pix?.intentId || 0);
    if (!settlementId || !intentId) return;

    const noteField = document.querySelector('[data-card-monthly-pix-note]');
    const body = new URLSearchParams();
    body.set('intent_id', String(intentId));
    if (noteField?.value?.trim()) body.set('note', noteField.value.trim());

    const button = document.querySelector('[data-card-monthly-report]');
    if (button) button.disabled = true;
    try {
      const response = await fetch(`/shared-debts/monthly-settlements/${settlementId}/report-payment`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
        },
        credentials: 'same-origin',
        body: body.toString()
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data?.ok === false) {
        throw new Error(data?.message || 'Não consegui avisar esse pagamento agora.');
      }
      showPixToast(data?.message || 'Pronto! Agora é só aguardar a confirmação final.', 'success');
      window.location.href = data?.redirectTo || `/shared-debts?settlement=${settlementId}`;
    } catch (error) {
      showPixToast(error?.message || 'Não consegui avisar esse pagamento agora.', 'error');
      if (button) button.disabled = false;
    }
  }

  async function shareCardMonthlyPixData(data) {
    const shareText = data?.shareText || data?.payload || '';
    if (!shareText) throw new Error('Ainda não apareceu nada para compartilhar desse Pix do mês.');

    if (navigator.share) {
      await navigator.share({
        title: data?.shareTitle || (data?.creditorName ? `Pix do mês para ${data.creditorName}` : 'Pix do mês'),
        text: shareText
      });
      showPixToast('Pix do mês compartilhado. Agora é só seguir o combinado.','success');
      return;
    }

    await copyTextToClipboard(shareText);
    showPixToast('Texto do Pix do mês copiado. É só colar onde quiser.','success');
  }


  document.addEventListener('click', (event) => {
    const openCardMonthlyBtn = event.target.closest('[data-open-card-monthly-settlement]');
    if (openCardMonthlyBtn) {
      event.preventDefault();
      openCardMonthlySheet(openCardMonthlyBtn.getAttribute('data-open-card-monthly-settlement'));
      return;
    }

    const cardMonthlyChoiceBtn = event.target.closest('[data-card-monthly-choice]');
    if (cardMonthlyChoiceBtn) {
      event.preventDefault();
      setCardMonthlyChoice(cardMonthlyChoiceBtn.getAttribute('data-card-monthly-choice'));
      renderCardMonthlyPreview();
      return;
    }

    const generateCardMonthlyBtn = event.target.closest('[data-card-monthly-generate]');
    if (generateCardMonthlyBtn) {
      event.preventDefault();
      generateCardMonthlyPix();
      return;
    }

    const backCardMonthlyBtn = event.target.closest('[data-card-monthly-back]');
    if (backCardMonthlyBtn) {
      event.preventDefault();
      setCardMonthlySheetState('config');
      const reportBtn = document.querySelector('[data-card-monthly-report]');
      if (reportBtn) reportBtn.disabled = false;
      renderCardMonthlyPreview();
      return;
    }

    const reportCardMonthlyBtn = event.target.closest('[data-card-monthly-report]');
    if (reportCardMonthlyBtn) {
      event.preventDefault();
      reportCardMonthlyPix();
      return;
    }

    const cardMonthlyPixBtn = event.target.closest('[data-card-monthly-pix-action]');
    if (cardMonthlyPixBtn) {
      event.preventDefault();
      const action = cardMonthlyPixBtn.getAttribute('data-card-monthly-pix-action');
      const data = cardMonthlySheetState.pix;
      if (!data) {
        showPixToast('Ainda estou terminando de montar esse Pix do mês por aqui.', 'info');
        return;
      }

      if (action === 'copy') {
        copyTextToClipboard(data?.payload || '')
          .then(() => showPixToast('Pix do mês copiado. Agora é só colar no banco.','success'))
          .catch((error) => showPixToast(error?.message || 'Não consegui copiar agora.', 'error'));
        return;
      }

      if (action === 'share') {
        shareCardMonthlyPixData(data).catch((error) => showPixToast(error?.message || 'Não consegui compartilhar agora.', 'error'));
        return;
      }
    }

    const pixBtn = event.target.closest('[data-pix-action]');
    if (pixBtn) {
      event.preventDefault();
      handlePixAction(pixBtn.getAttribute('data-pix-action'), pixBtn.getAttribute('data-request-id'));
      return;
    }

    const pixSheetBtn = event.target.closest('[data-pix-sheet-action]');
    if (pixSheetBtn) {
      event.preventDefault();
      const action = pixSheetBtn.getAttribute('data-pix-sheet-action');
      const data = pixSheetState.data;
      if (!data) {
        showPixToast('Ainda estou terminando de montar esse Pix por aqui.', 'info');
        return;
      }

      if (action === 'copy') {
        copyTextToClipboard(data?.payload || '')
          .then(() => showPixToast('Pix copiado. Agora é só colar no banco.','success'))
          .catch((error) => showPixToast(error?.message || 'Não consegui copiar agora.', 'error'));
        return;
      }

      if (action === 'share') {
        sharePixData(data).catch((error) => showPixToast(error?.message || 'Não consegui compartilhar agora.', 'error'));
        return;
      }

      if (action === 'copy-key') {
        copyTextToClipboard(data?.keyValue || '')
          .then(() => showPixToast('Chave Pix copiada.','success'))
          .catch((error) => showPixToast(error?.message || 'Não consegui copiar a chave agora.', 'error'));
        return;
      }
    }

    const openBtn = event.target.closest('[data-open-sheet]');
    if (openBtn) {
      event.preventDefault();
      openSharedDebtSheet(openBtn.getAttribute('data-open-sheet'));
      return;
    }

    const closeBtn = event.target.closest('[data-close-sheet]');
    if (closeBtn) {
      event.preventDefault();
      closeSharedDebtSheets();
      return;
    }

    const jumpBtn = event.target.closest('[data-jump-request]');
    if (jumpBtn) {
      event.preventDefault();
      const target = document.getElementById(jumpBtn.getAttribute('data-jump-request'));
      closeSharedDebtSheets();
      if (target) {
        setTimeout(() => openRequestChain(target), 40);
      }
    }
  });

  document.addEventListener('input', (event) => {
    const customInput = event.target.closest('[data-card-monthly-custom-input]');
    if (customInput) {
      renderCardMonthlyPreview();
    }
  });

  document.addEventListener('blur', (event) => {
    const customInput = event.target.closest('[data-card-monthly-custom-input]');
    if (customInput) {
      const cents = parseMoneyInputToCents(customInput.value);
      customInput.value = cents ? formatClientBRL(cents) : '';
      renderCardMonthlyPreview();
    }
  }, true);


  function setManualDebtModeCardState(card, active, disabled) {
    if (!card) return;
    const mode = card.getAttribute('data-manual-debt-mode-card');
    const accent = mode === 'private'
      ? (active ? 'border-cyan-200 bg-cyan-50 dark:border-cyan-800 dark:bg-cyan-900/20' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800/80')
      : (active ? 'border-violet-200 bg-violet-50 dark:border-violet-800 dark:bg-violet-900/20' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800/80');
    card.className = `rounded-2xl border px-4 py-3 transition-colors ${accent} ${disabled ? 'cursor-not-allowed opacity-60' : 'cursor-pointer'}`;
    card.dataset.disabled = disabled ? 'true' : 'false';
  }

  function initManualDebtComposer() {
    const form = document.querySelector('[data-manual-debt-form]');
    if (!form) return;

    const select = form.querySelector('[data-manual-debt-person-select]');
    const noteBox = form.querySelector('[data-manual-debt-mode-note]');
    const submitBtn = form.querySelector('[data-manual-debt-submit]');
    const appInput = form.querySelector('[data-manual-debt-mode-input="app"]');
    const privateInput = form.querySelector('[data-manual-debt-mode-input="private"]');
    const appCard = form.querySelector('[data-manual-debt-mode-card="app"]');
    const privateCard = form.querySelector('[data-manual-debt-mode-card="private"]');

    const sync = () => {
      const option = select?.selectedOptions?.[0] || null;
      const hasContact = !!option;
      const canApp = option?.dataset?.canApp === '1';
      const hasApp = option?.dataset?.hasApp === '1';
      const friendshipActive = option?.dataset?.friendshipActive === '1';

      if (appInput) appInput.disabled = !canApp || !hasContact;
      if (privateInput) privateInput.disabled = !hasContact;

      if (!hasContact) {
        if (submitBtn) submitBtn.disabled = true;
        if (noteBox) {
          noteBox.className = 'rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200';
          noteBox.textContent = 'Ainda não há contato ativo por aqui. Criou em Minha Rede, voltou, e já dá para usar.';
        }
        setManualDebtModeCardState(appCard, false, true);
        setManualDebtModeCardState(privateCard, false, true);
        return;
      }

      if (appInput?.checked && appInput.disabled && privateInput && !privateInput.disabled) {
        privateInput.checked = true;
      }
      if (!appInput?.checked && !privateInput?.checked) {
        if (canApp && appInput) appInput.checked = true;
        else if (privateInput) privateInput.checked = true;
      }

      const selectedMode = privateInput?.checked ? 'private' : 'app';
      setManualDebtModeCardState(appCard, selectedMode === 'app', !!appInput?.disabled);
      setManualDebtModeCardState(privateCard, selectedMode === 'private', !!privateInput?.disabled);

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = selectedMode === 'private' ? 'Salvar no meu radar' : 'Enviar no app';
      }

      if (noteBox) {
        if (selectedMode === 'private') {
          noteBox.className = 'rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm font-medium text-cyan-800 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200';
          if (canApp && friendshipActive) {
            noteBox.textContent = 'Esse contato até pode receber no app, mas esse combinado vai ficar só no seu radar. Nada é enviado para a outra pessoa.';
          } else if (hasApp) {
            noteBox.textContent = 'Essa pessoa até usa o app, mas esse combinado vai ficar só com você por aqui. Sem amizade ativa, sem aviso e sem estresse.';
          } else {
            noteBox.textContent = 'Perfeito para quem não usa o app ou para aquele empréstimo que você só quer acompanhar por aqui. Nada é enviado para a outra pessoa.';
          }
        } else {
          noteBox.className = 'rounded-2xl border border-violet-200 bg-violet-50 px-4 py-3 text-sm font-medium text-violet-800 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200';
          noteBox.textContent = 'Vai como acerto no app: a outra pessoa recebe por lá, responde e vocês acompanham tudo aqui.';
        }
      }
    };

    form.addEventListener('change', (event) => {
      if (event.target === select || event.target === appInput || event.target === privateInput) {
        sync();
      }
    });

    sync();
  }

  initManualDebtComposer();

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeSharedDebtSheets();
    }
  });

  window.addEventListener('load', () => {
    openSharedDebtScopeFromHash();

    <% if (batchIdToHighlight) { %>
      const batchEl = document.getElementById('batch-<%= batchIdToHighlight %>');
      if (batchEl) {
        batchEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    <% } %>

    <% if (settlementIdToHighlight) { %>
      const settlementEl = document.getElementById('settlement-<%= settlementIdToHighlight %>');
      if (settlementEl) {
        openRequestChain(settlementEl);
      }
    <% } %>

    <% if (requestIdToHighlight) { %>
      const el = document.getElementById('request-<%= requestIdToHighlight %>');
      if (el) openRequestChain(el);
    <% } %>

    <% if (privateReminderIdToHighlight) { %>
      const privateEl = document.getElementById('private-reminder-<%= privateReminderIdToHighlight %>');
      if (privateEl) openRequestChain(privateEl);
    <% } %>
  });

  window.addEventListener('hashchange', openSharedDebtScopeFromHash);
</script>

<%- include("partials/footer") %>
