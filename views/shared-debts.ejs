                    <% sentSettlementEntries.forEach((entry) => { const settlementMeta = settlementStatusMeta(entry, 'sent'); const highlightedSettlement = settlementIdToHighlight && Number(settlementIdToHighlight) === Number(entry.id); const reportedIntentRows = Array.isArray(entry.snapshot?.reportedIntentRows) ? entry.snapshot.reportedIntentRows : []; const sentSettlementHistoryRows = settlementIntentHistoryRows(entry, { includeReported: reportedIntentRows.length === 0, limit: reportedIntentRows.length ? 3 : 4 }); %>
                      <article id="settlement-<%= entry.id %>" class="rounded-[28px] border <%= highlightedSettlement ? 'border-sky-300 bg-sky-50/90 shadow-sky-200/60 dark:border-sky-700 dark:bg-sky-900/20 dark:shadow-sky-950/30' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/40' %> p-4 shadow-sm">
