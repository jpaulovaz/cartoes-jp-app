<%- include("partials/header", { title: title || "AcerttaPay | Acertos" }) %>

<%
  function itemTotalCents(item) {
    return Math.max(0, Number(item?.amount_cents || 0));
  }

  function itemPaidCents(item) {
    const totalCents = itemTotalCents(item);
    const paidCents = Math.max(0, Number(item?.amount_paid_cents || (item?.status === 'settled' ? totalCents : 0)));
    return Math.min(totalCents, paidCents);
  }

  function itemPendingCents(item) {
    return Math.max(0, itemTotalCents(item) - itemPaidCents(item));
  }

  function statusMeta(itemOrStatus) {
    const item = (itemOrStatus && typeof itemOrStatus === 'object') ? itemOrStatus : null;
    const status = item ? item.status : itemOrStatus;

    if (status === 'accepted' && item?.payment_marked_at) {
      return {
        label: 'Pagamento informado',
        classes: 'bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-900/20 dark:text-sky-300 dark:border-sky-800'
      };
    }

    if (status === 'accepted' && item && itemPaidCents(item) > 0) {
      return {
        label: 'Parcial',
        classes: 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/20 dark:text-amber-300 dark:border-amber-800'
      };
    }

    switch (status) {
      case 'accepted':
        return { label: 'Aceita', classes: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-300 dark:border-emerald-800' };
      case 'rejected_by_receiver':
        return { label: 'Recusada', classes: 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-900/20 dark:text-rose-300 dark:border-rose-800' };
      case 'rejection_contested_by_sender':
        return { label: 'Em disputa', classes: 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/20 dark:text-amber-300 dark:border-amber-800' };
      case 'rejection_accepted_by_sender':
        return { label: 'Rejeição aceita', classes: 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700' };
      case 'cancelled':
        return { label: 'Cancelada', classes: 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700' };
      case 'settled':
        return { label: 'Liquidada', classes: 'bg-cyan-50 text-cyan-700 border-cyan-200 dark:bg-cyan-900/20 dark:text-cyan-300 dark:border-cyan-800' };
      default:
        return { label: 'Pendente', classes: 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-900/20 dark:text-blue-300 dark:border-blue-800' };
    }
  }

  function eventMeta(eventType) {
    switch (eventType) {
      case 'created':
        return { label: 'Acerto criado', dot: 'bg-blue-500' };
      case 'updated':
        return { label: 'Acerto atualizado', dot: 'bg-amber-500' };
      case 'accepted':
        return { label: 'Acerto aceito', dot: 'bg-emerald-500' };
      case 'rejected_by_receiver':
        return { label: 'Acerto recusado', dot: 'bg-rose-500' };
      case 'cancelled':
        return { label: 'Acerto cancelado', dot: 'bg-slate-400' };
      case 'rejection_contested_by_sender':
        return { label: 'Rejeição contestada', dot: 'bg-amber-500' };
      case 'rejection_accepted_by_sender':
        return { label: 'Rejeição aceita', dot: 'bg-slate-500' };
      case 'payment_marked_by_receiver':
        return { label: 'Pagamento informado', dot: 'bg-sky-500' };
      case 'partial_payment_confirmed_via_monthly_pix':
        return { label: 'Pix do mês confirmado em parte', dot: 'bg-amber-500' };
      case 'settled_via_monthly_pix':
        return { label: 'Pix do mês confirmou esse acerto', dot: 'bg-cyan-500' };
      case 'settled':
        return { label: 'Recebimento confirmado', dot: 'bg-cyan-500' };
      default:
        return { label: eventType || 'Atualização', dot: 'bg-slate-400' };
    }
  }

  function actorLabel(event) {
    return event?.actor_name || event?.actor_email || 'Usuário';
  }

  function timelineFor(requestId) {
    if (!eventsByRequest || typeof eventsByRequest.get !== 'function') return [];
    const rows = eventsByRequest.get(Number(requestId)) || eventsByRequest.get(requestId) || [];
    return Array.isArray(rows) ? rows : [];
  }

  function formatTimeBR(dateStr) {
    if (!dateStr) return '--:--';
    try {
      return new Date(dateStr).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    } catch (err) {
      return '--:--';
    }
  }

  function pluralizePt(count, singular, plural) {
    return Number(count) === 1 ? singular : plural;
  }

  function countLabel(count, singular, plural) {
    const safeCount = Number(count || 0);
    return `${safeCount} ${pluralizePt(safeCount, singular, plural)}`;
  }

  function formatCountLabel(count, singular, plural) {
    return countLabel(count, singular, plural);
  }

  function draftActionMeta(actionKind) {
    switch (String(actionKind || 'create').trim().toLowerCase()) {
      case 'update':
        return {
          label: 'Atualização',
          classes: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
        };
      case 'cancel':
        return {
          label: 'Cancelamento',
          classes: 'border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-200'
        };
      default:
        return {
          label: 'Nova',
          classes: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200'
        };
    }
  }

  function statusWeight(status) {
    switch (status) {
      case 'pending': return 0;
      case 'accepted': return 1;
      case 'rejected_by_receiver': return 2;
      case 'rejection_contested_by_sender': return 3;
      case 'rejection_accepted_by_sender': return 4;
      case 'cancelled': return 5;
      case 'settled': return 6;
      default: return 7;
    }
  }

  function monthRank(item) {
    const year = Number(item?.source_due_year || 0);
    const month = Number(item?.source_due_month || 0);
    if (!year || !month) return 0;
    return (year * 100) + month;
  }

  function buildMonthGroups(items) {
    const sorted = (items || []).slice().sort((a, b) => {
      const rankDiff = monthRank(b) - monthRank(a);
      if (rankDiff !== 0) return rankDiff;
      const statusDiff = statusWeight(a?.status) - statusWeight(b?.status);
      if (statusDiff !== 0) return statusDiff;
      return String(b?.created_at || '').localeCompare(String(a?.created_at || ''));
    });

    const groups = new Map();
    sorted.forEach(item => {
      const month = Number(item?.source_due_month || 0);
      const year = Number(item?.source_due_year || 0);
      const key = (month && year) ? `${year}-${String(month).padStart(2, '0')}` : 'sem-competencia';
      if (!groups.has(key)) {
        groups.set(key, {
          key,
          month,
          year,
          rank: month && year ? ((year * 100) + month) : 0,
          label: month && year ? monthLabel(month, year) : 'Sem mês informado',
          items: [],
          totalCents: 0,
          pendingCents: 0,
          paidCents: 0
        });
      }
      const group = groups.get(key);
      group.items.push(item);
      group.totalCents += itemTotalCents(item);
      group.pendingCents += itemPendingCents(item);
      group.paidCents += itemPaidCents(item);
    });

    return Array.from(groups.values()).sort((a, b) => {
      if (b.rank !== a.rank) return b.rank - a.rank;
      return a.label.localeCompare(b.label);
    });
  }

  function countItems(items, predicate) {
    return (items || []).filter(predicate).length;
  }

  function receivedActionState(item) {
    if (item?.status === 'pending') return 'respond';
    if (item?.status === 'accepted' && !item?.payment_marked_at) return 'mark_paid';
    return null;
  }

  function sentActionState(item) {
    if (item?.status === 'rejected_by_receiver') return 'sender_decision';
    if (item?.status === 'accepted' && !!item?.payment_marked_at) return 'confirm_receipt';
    return null;
  }

  function actionStateForItem(item, scope) {
    return scope === 'received' ? receivedActionState(item) : sentActionState(item);
  }

  function isReceivedActionable(item) {
    return !!receivedActionState(item);
  }

  function isSentActionable(item) {
    return !!sentActionState(item);
  }

  function actionableItems(items, scope) {
    return (items || []).filter(item => !!actionStateForItem(item, scope));
  }

  function groupContainsRequest(group, requestId) {
    if (!group || !requestId) return false;
    return (group.items || []).some(item => Number(item.id) === Number(requestId));
  }

  function countGroupActions(group, scope) {
    if (!group) return 0;
    return (group.items || []).filter(item => scope === 'received' ? isReceivedActionable(item) : isSentActionable(item)).length;
  }

  function getReceivedMonthPayableItems(group) {
    return (group?.items || []).filter(item => item?.status === 'accepted' && !item?.payment_marked_at);
  }

  function getSentMonthConfirmableItems(group) {
    return (group?.items || []).filter(item => item?.status === 'accepted' && !!item?.payment_marked_at);
  }

  function sumAmountCents(items) {
    return (items || []).reduce((sum, item) => sum + Number(item?.amount_cents || 0), 0);
  }

  function countDistinctCounterparts(items, scope) {
    return new Set((items || []).map(item => {
      if (scope === 'received') return Number(item?.requester_user_id || 0) || String(item?.requester_email || '');
      return Number(item?.receiver_user_id || 0) || String(item?.receiver_email || '');
    }).filter(Boolean)).size;
  }

  function batchOriginLabel(kind, count) {
    switch (kind) {
      case 'manual':
        return count > 1 ? 'Lembretes avulsos' : 'Lembrete avulso';
      case 'installment':
        return count > 1 ? 'Envio parcelado' : 'Parcela enviada';
      case 'multiple':
        return 'Envio múltiplo';
      case 'mixed':
        return 'Envio misto';
      default:
        return count > 1 ? 'Envio agrupado' : 'Envio individual';
    }
  }

  function batchRangeLabel(batch) {
    if (batch?.originKind === 'manual') return 'Sem mês fixo';
    if (!batch?.minMonth || !batch?.minYear) return 'Sem mês definido';
    if (batch.minMonth === batch.maxMonth && batch.minYear === batch.maxYear) {
      return monthLabel(batch.minMonth, batch.minYear);
    }
    return `${monthLabel(batch.minMonth, batch.minYear)} até ${monthLabel(batch.maxMonth, batch.maxYear)}`;
  }

  function batchPendingSummary(batch) {
    if (!batch) return 'Sem itens pendentes';
    if (batch.pendingCount === batch.totalCount) {
      return `${countLabel(batch.pendingCount, 'acerto pendente', 'acertos pendentes')}`;
    }
    return `${countLabel(batch.pendingCount, 'pendência', 'pendências')} de ${countLabel(batch.totalCount, 'acerto', 'acertos')}`;
  }

  function batchStatusMeta(batch) {
    const status = String(batch?.statusSummary || 'pending');
    switch (status) {
      case 'accepted':
        return { label: 'Aceito', classes: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200' };
      case 'rejected':
        return { label: 'Recusado', classes: 'border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-200' };
      case 'settled':
        return { label: 'Liquidado', classes: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200' };
      case 'partial':
        return { label: 'Parcial', classes: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200' };
      default:
        return { label: 'Pendente', classes: 'border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200' };
    }
  }

  function batchStatusText(batch) {
    const meta = batchStatusMeta(batch);
    if (!batch) return meta.label;
    if (batch.statusSummary === 'partial' && batch.pendingCount > 0) {
      return `${meta.label} · ${countLabel(batch.pendingCount, 'pendência', 'pendências')}`;
    }
    return meta.label;
  }

  function batchUpdateText(batch) {
    if (!batch?.hasUpdates || !batch?.updatedAt || !batch?.createdAt) return null;
    if (String(batch.updatedAt) === String(batch.createdAt)) return null;
    return `Atualizado em ${formatDateBR(batch.updatedAt)} às ${formatTimeBR(batch.updatedAt)}.`;
  }

  function batchPreviewText(batch) {
    const previews = (batch?.previewDescriptions || []).filter(Boolean).slice(0, 2);
    if (!previews.length) return 'Abra os itens para revisar o envio completo.';
    return previews.join(' · ');
  }

  function isManualItem(item) {
    return String(item?.request_kind || item?.batch_origin_kind || '').trim().toLowerCase() === 'manual';
  }

  function itemPillMeta(item) {
    if (!isManualItem(item)) return null;
    return {
      label: 'Avulsa',
      classes: 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200'
    };
  }

  function itemDateLead(item) {
    return isManualItem(item) ? 'Lembrete criado em' : 'Compra em';
  }

  function itemDateBlockLabel(item) {
    return isManualItem(item) ? 'Data do lembrete' : 'Data da compra';
  }

  function itemDateValue(item) {
    return item?.source_txn_date ? formatDateBR(item.source_txn_date) : '—';
  }

  function itemContextLabel(item) {
    return isManualItem(item) ? 'Tipo' : 'Cartão';
  }

  function itemContextValue(item) {
    return isManualItem(item) ? 'Acerto avulso' : (item?.card_name_snapshot || 'Não informado');
  }

  function itemPeriodLabel(item) {
    return isManualItem(item) ? 'Fluxo' : 'Mês do cartão';
  }

  function itemPeriodValue(item) {
    if (isManualItem(item)) return 'Sem mês fixo';
    return item?.source_due_month && item?.source_due_year ? monthLabel(item.source_due_month, item.source_due_year) : '—';
  }

  function itemObservacaoLabel(item) {
    return isManualItem(item) ? 'Recado do lembrete' : 'Observação do envio';
  }

  function manualSectionHint(scope) {
    if (isArchiveMode) {
      return scope === 'received'
        ? 'Combinados sem cartão que já saíram da fila principal e agora ficam guardados aqui.'
        : 'Combinados sem cartão guardados para consulta, sem bagunçar o que ainda está ativo.';
    }

    return scope === 'received'
      ? 'Combinados sem cartão. Quando você aceita, eles passam a aparecer no seu controle até fechar.'
      : 'Combinados sem cartão. Depois de aceitos, continuam aqui até o pagamento ser confirmado.';
  }

  function privateReminderStatusMeta(item) {
    switch (String(item?.status || '').trim()) {
      case 'settled':
        return { label: 'Recebido', classes: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200' };
      case 'cancelled':
        return { label: 'Encerrado', classes: 'border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200' };
      default:
        return { label: 'Em aberto', classes: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200' };
    }
  }

  function privateReminderSecondaryLine(item) {
    const parts = [];
    if (item?.person_email_snapshot) parts.push(item.person_email_snapshot);
    if (item?.person_phone_snapshot) parts.push(item.person_phone_snapshot);
    if (item?.is_contact_detached) {
      parts.push('contato saiu da sua rede');
    } else if (String(item?.current_person_status || '').trim().toLowerCase() === 'inactive' || Number(item?.current_person_active ?? 1) === 0) {
      parts.push('contato inativo');
    }
    return parts.join(' · ');
  }

  function privateReminderCreatedLabel(item) {
    return item?.created_at ? formatDateBR(item.created_at) : 'Data não informada';
  }

  function promisedPaymentLabel(value) {
    return value ? formatDateBR(value) : 'Sem data combinada';
  }

  function privateReminderSettledLabel(item) {
    return item?.settled_at ? formatDateBR(item.settled_at) : (item?.payment_date ? formatDateBR(item.payment_date) : 'Data não informada');
  }

  function shouldOpenPrivateReminderSection(items, regularSectionCount) {
    if (!(items || []).length) return false;
    if ((items || []).some(item => Number(item?.id || 0) === Number(privateReminderIdToHighlight || 0))) return true;
    if ((items || []).some(item => String(item?.status || '').trim() === 'open')) return true;
    return Number(regularSectionCount || 0) === 0;
  }

  function isPrivateReminderItem(item) {
    return String(item?.kind || '').trim() === 'private_reminder';
  }

  function canArchiveItem(item) {
    if (isPrivateReminderItem(item)) {
      return isArchiveMode ? Number(item?.is_archived || 0) > 0 : !!item?.is_archivable;
    }
    return archiveEligibleStatusSet.has(String(item?.status || '').trim());
  }

  function archiveToggleAction(item) {
    if (isPrivateReminderItem(item)) {
      return isArchiveMode ? `/shared-debts/private/${item.id}/unarchive` : `/shared-debts/private/${item.id}/archive`;
    }
    return isArchiveMode ? `/shared-debts/${item.id}/unarchive` : `/shared-debts/${item.id}/archive`;
  }

  function archiveToggleLabel(item) {
    if (isPrivateReminderItem(item)) {
      return isArchiveMode ? 'Restaurar lembrete' : 'Arquivar lembrete';
    }
    return isArchiveMode ? 'Restaurar acerto' : 'Arquivar acerto';
  }

  function archiveToggleGroupLabel(items) {
    const count = (items || []).length;
    const firstItem = (items || [])[0] || null;
    const noun = isPrivateReminderItem(firstItem) ? countLabel(count, 'lembrete', 'lembretes') : countLabel(count, 'acerto', 'acertos');
    return isArchiveMode
      ? `Restaurar ${noun}`
      : `Arquivar ${noun}`;
  }

  function hasManualActionableItem(items, scope) {
    return (items || []).some(item => scope === 'received' ? isReceivedActionable(item) : isSentActionable(item));
  }

  function actionMetaForItem(item, scope) {
    const actionState = actionStateForItem(item, scope);
    if (!actionState) return null;

    const counterpartName = scope === 'received'
      ? (item?.requester_name || item?.requester_email || 'quem enviou')
      : (item?.receiver_name || item?.receiver_email || 'quem recebeu');
    const amountCents = Math.max(0, Number(item?.amount_pending_cents || item?.amount_cents || 0));
    const metaPrefix = isManualItem(item) ? 'Avulsa' : itemPeriodValue(item);
    const baseMeta = `${metaPrefix} · ${formatBRLFromCents(amountCents)}`;
    const sortDate = String(item?.payment_marked_at || item?.updated_at || item?.created_at || '');

    switch (actionState) {
      case 'respond':
        return {
          requestId: item.id,
          title: `Responder acerto de ${counterpartName}`,
          helper: isManualItem(item)
            ? 'Esse lembrete ainda espera seu ok ou sua recusa.'
            : 'Esse acerto ainda espera seu ok ou sua recusa.',
          meta: baseMeta,
          buttonLabel: 'Responder',
          priority: 0,
          sortDate
        };
      case 'mark_paid':
        return {
          requestId: item.id,
          title: `Avisar pagamento para ${counterpartName}`,
          helper: 'Você já deu o ok. Agora é só avisar quando pagar.',
          meta: baseMeta,
          buttonLabel: 'Avisar que pagou',
          priority: 1,
          sortDate
        };
      case 'sender_decision':
        return {
          requestId: item.id,
          title: `Revisar resposta de ${counterpartName}`,
          helper: 'A pessoa não aceitou esse acerto. Agora você decide se encerra ou se contesta.',
          meta: baseMeta,
          buttonLabel: 'Revisar',
          priority: 2,
          sortDate
        };
      case 'confirm_receipt':
        return {
          requestId: item.id,
          title: `Confirmar dinheiro de ${counterpartName}`,
          helper: `Pagamento informado em ${formatDateBR(item.payment_marked_at)} às ${formatTimeBR(item.payment_marked_at)}.`,
          meta: baseMeta,
          buttonLabel: 'Confirmar entrada',
          priority: 3,
          sortDate
        };
      default:
        return null;
    }
  }

  function shouldOpenManualSection(items, scope, regularGroupCount) {
    if (!(items || []).length) return false;
    if ((items || []).some(item => Number(item?.id || 0) === Number(requestIdToHighlight || 0))) return true;
    if (hasManualActionableItem(items, scope)) return true;
    return Number(regularGroupCount || 0) === 0;
  }

  const isArchiveMode = !!archiveMode;
  const currentPath = pagePath || (isArchiveMode ? '/shared-debts/archive' : '/shared-debts');
  const otherPath = counterpartPath || (isArchiveMode ? '/shared-debts' : '/shared-debts/archive');
  const archiveEligibleStatusSet = new Set(Array.isArray(archiveEligibleStatuses) ? archiveEligibleStatuses : []);
  const trackingFilters = sharedDebtFilters || { envio: 'all', origin: 'all', installment: 'all' };
  const trackingFiltersActive = !!sharedDebtFiltersActive;
  const manualDebtPeopleList = Array.isArray(manualDebtPeople) ? manualDebtPeople : [];
  const manualDebtEligibleList = Array.isArray(manualDebtEligiblePeople) ? manualDebtEligiblePeople : [];
  const rawPrivateReminderItems = Array.isArray(privateDebtReminders) ? privateDebtReminders : [];
  const privateReminderItems = Array.isArray(privateDebtReminderTracking) ? privateDebtReminderTracking : rawPrivateReminderItems;
  const privateReminderIdFocus = Number(privateReminderIdToHighlight || 0) || null;
  const receivedBaseItems = Array.isArray(receivedTracking) ? receivedTracking : (received || []);
  const sentBaseItems = Array.isArray(sentTracking) ? sentTracking : (sent || []);
  const receivedManualItems = receivedBaseItems.filter(isManualItem);
  const sentManualItems = sentBaseItems.filter(isManualItem);
  const receivedTrackingItems = receivedBaseItems.filter(item => !isManualItem(item));
  const sentTrackingItems = sentBaseItems.filter(item => !isManualItem(item));
  const rawReceivedGroups = buildMonthGroups((received || []).filter(item => !isManualItem(item)));
  const rawSentGroups = buildMonthGroups((sent || []).filter(item => !isManualItem(item)));
  const receivedGroups = buildMonthGroups(receivedTrackingItems);
  const sentGroups = buildMonthGroups(sentTrackingItems);
  const receivedBatchCards = Array.isArray(receivedPendingBatches) ? receivedPendingBatches : [];
  const sentBatchCards = Array.isArray(sentPendingBatches) ? sentPendingBatches : [];
  const receivedManualSectionOpen = shouldOpenManualSection(receivedManualItems, 'received', receivedGroups.length);
  const sentManualSectionOpen = shouldOpenManualSection(sentManualItems, 'sent', sentGroups.length);
  const sentPrivateReminderSectionOpen = shouldOpenPrivateReminderSection(privateReminderItems, sentManualItems.length + sentGroups.length);
  const sentPrivateReminderOpenCount = countItems(privateReminderItems, item => String(item?.status || '').trim() === 'open');
  const sentVisibleCount = sentBaseItems.length + privateReminderItems.length;
  const sentTotalCount = (sent || []).length + rawPrivateReminderItems.length;
  const sentHeroCount = (sent || []).length + rawPrivateReminderItems.length;
  const archivedTotalVisible = (received || []).length + (sent || []).length + rawPrivateReminderItems.length;
  const receivedPendingCount = countItems(received, item => item.status === 'pending');
  const sentDecisionCount = countItems(sent, item => item.status === 'rejected_by_receiver');
  const sentReceiptCount = countItems(sent, item => item.status === 'accepted' && item.payment_marked_at);
  const cardMonthlySettlementsList = Array.isArray(cardMonthlySettlements) ? cardMonthlySettlements : [];
  const cardMonthlySettlementsByKey = new Map(cardMonthlySettlementsList.map((snapshot) => [snapshot?.settlementKey, snapshot]).filter(([key]) => !!key));
  const cardMonthlySettlementsById = new Map(cardMonthlySettlementsList.map((snapshot) => [Number(snapshot?.id || 0), snapshot]).filter(([id]) => !!id));
  const receivedSettlementEntriesAll = rawReceivedGroups.flatMap((group) => buildGroupSettlementEntries(group, 'received'));
  const sentSettlementEntriesAll = rawSentGroups.flatMap((group) => buildGroupSettlementEntries(group, 'sent'));
  const monthlyReceiverOpenCount = receivedSettlementEntriesAll.filter((entry) => Number(entry?.openCents || 0) > 0).length;
  const monthlyReceiverAwaitingCount = receivedSettlementEntriesAll.filter((entry) => Number(entry?.reservedCents || 0) > 0).length;
  const monthlySenderReviewCount = sentSettlementEntriesAll.filter((entry) => {
    const reportedRows = Array.isArray(entry?.snapshot?.reportedIntentRows) ? entry.snapshot.reportedIntentRows : [];
    return reportedRows.length > 0;
  }).length;
  const monthlyMovementHistoryCount = [...receivedSettlementEntriesAll, ...sentSettlementEntriesAll].reduce((sum, entry) => {
    return sum + settlementIntentHistoryRows(entry, { includeReported: false, limit: 99 }).length;
  }, 0);
  const monthlyGuideHref = '/docs/guia-pix-cartao-fase2.html';

  function cardMonthlySnapshotForItem(item) {
    return cardMonthlySettlementsByKey.get(item?.card_monthly_settlement_key || '') || null;
  }

  function groupContainsSettlement(group, settlementId) {
    if (!settlementId) return false;
    return (group?.items || []).some((item) => Number(item?.card_monthly_settlement_id || 0) === Number(settlementId));
  }

  function buildGroupSettlementEntries(group, scope) {
    const grouped = new Map();
    (group?.items || []).forEach((item) => {
      const key = item?.card_monthly_settlement_key || '';
      const snapshot = cardMonthlySnapshotForItem(item);
      if (!key || !snapshot || !Number(snapshot?.requestCount || 0)) return;
      if (!grouped.has(key)) {
        grouped.set(key, {
          key,
          id: Number(snapshot?.id || 0),
          snapshot,
          items: [],
          counterpartName: scope === 'received'
            ? (item?.requester_name || item?.requester_email || 'quem enviou')
            : (item?.receiver_name || item?.receiver_email || 'quem recebeu')
        });
      }
      grouped.get(key).items.push(item);
    });

    return Array.from(grouped.values()).map((entry) => ({
      ...entry,
      month: Number(entry.snapshot?.month || group?.month || 0),
      year: Number(entry.snapshot?.year || group?.year || 0),
      status: String(entry.snapshot?.status || 'open'),
      requestCount: Math.max(0, Number(entry.snapshot?.requestCount || entry.items.length || 0)),
      totalAcceptedCents: Math.max(0, Number(entry.snapshot?.totalAcceptedCents || 0)),
      confirmedCents: Math.max(0, Number(entry.snapshot?.confirmedCents || 0)),
      reservedCents: Math.max(0, Number(entry.snapshot?.reservedCents || 0)),
      openCents: Math.max(0, Number(entry.snapshot?.openCents || 0)),
      lastActivityAt: entry.snapshot?.lastActivityAt || null
    })).sort((a, b) => String(a.counterpartName || '').localeCompare(String(b.counterpartName || ''), 'pt-BR', { sensitivity: 'base' }));
  }

  function settlementStatusMeta(entry, scope) {
    const openCents = Math.max(0, Number(entry?.openCents || 0));
    const reservedCents = Math.max(0, Number(entry?.reservedCents || 0));
    const confirmedCents = Math.max(0, Number(entry?.confirmedCents || 0));

    if (openCents === 0 && reservedCents === 0 && (confirmedCents > 0 || Number(entry?.totalAcceptedCents || 0) > 0)) {
      return {
        label: 'Mês redondinho',
        helper: 'Tudo o que foi aceito nessa carteira já ficou coberto.',
        classes: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200'
      };
    }

    if (reservedCents > 0 && openCents === 0) {
      return {
        label: scope === 'received' ? 'Aguardando confirmação' : 'Esperando seu ok',
        helper: scope === 'received'
          ? `Você já avisou ${formatBRLFromCents(reservedCents)} e agora só falta a confirmação final.`
          : `${formatBRLFromCents(reservedCents)} já foi informado pelo outro lado e está esperando sua confirmação.`,
        classes: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200'
      };
    }

    if (reservedCents > 0) {
      return {
        label: 'Parte aguardando ok',
        helper: `${formatBRLFromCents(reservedCents)} já foi informado e ${formatBRLFromCents(openCents)} ainda continua em aberto.`,
        classes: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200'
      };
    }

    if (confirmedCents > 0) {
      return {
        label: 'Pago em parte',
        helper: `${formatBRLFromCents(confirmedCents)} já entrou na conta desse mês e ${formatBRLFromCents(openCents)} ainda falta fechar.`,
        classes: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
      };
    }

    return {
      label: scope === 'received' ? 'Pronto para pagar' : 'Mês em aberto',
      helper: scope === 'received'
        ? `${formatBRLFromCents(openCents)} ainda em aberto nessa carteira.`
        : `${formatBRLFromCents(openCents)} ainda aguardando pagamento nessa carteira.`,
      classes: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200'
    };
  }


  function settlementIntentHistoryRows(entry, options = {}) {
    const rows = Array.isArray(entry?.snapshot?.intentRowsDetailed) ? entry.snapshot.intentRowsDetailed : [];
    const includeReported = options.includeReported !== false;
    const limit = Number(options.limit || 4);
    return rows
      .filter((intent) => {
        const status = String(intent?.status || '');
        if (!['reported', 'confirmed', 'rejected'].includes(status)) return false;
        if (!includeReported && status === 'reported') return false;
        return true;
      })
      .slice(0, limit > 0 ? limit : 4);
  }

  function settlementIntentHistoryMeta(intent) {
    switch (String(intent?.status || '')) {
      case 'reported':
        return {
          label: intent?.historyLabel || 'Pix avisado',
          classes: 'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200'
        };
      case 'confirmed':
        return {
          label: intent?.historyLabel || 'Recebimento confirmado',
          classes: 'border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200'
        };
      case 'rejected':
        return {
          label: intent?.historyLabel || 'Pix voltou para revisão',
          classes: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
        };
      default:
        return {
          label: intent?.historyLabel || 'Movimentação',
          classes: 'border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200'
        };
    }
  }

  function settlementIntentHistoryWhen(intent) {
    const dateLabel = intent?.activityAtLabel || (intent?.activityAt ? formatDateBR(intent.activityAt) : null);
    const timeLabel = intent?.activityAtTimeLabel || (intent?.activityAt ? formatTimeBR(intent.activityAt) : null);
    if (!dateLabel) return 'Sem data registrada';
    return timeLabel ? `${dateLabel} às ${timeLabel}` : dateLabel;
  }

  function buildReceivedActionEntries(items) {
    const entries = [];
    const seenSettlements = new Set();

    (items || []).forEach((item) => {
      if (isManualItem(item)) {
        const meta = actionMetaForItem(item, 'received');
        if (meta) entries.push({ kind: 'request', ...meta });
        return;
      }

      if (item?.status === 'pending') {
        const meta = actionMetaForItem(item, 'received');
        if (meta) entries.push({ kind: 'request', ...meta });
        return;
      }

      if (item?.status !== 'accepted') return;

      const key = item?.card_monthly_settlement_key || '';
      const snapshot = cardMonthlySnapshotForItem(item);
      if (!key || !snapshot || seenSettlements.has(key) || Math.max(0, Number(snapshot?.openCents || 0)) <= 0) return;

      const counterpartName = item?.requester_name || item?.requester_email || 'quem enviou';
      const periodLabel = monthLabel(snapshot?.month || item?.source_due_month, snapshot?.year || item?.source_due_year);
      entries.push({
        kind: 'settlement',
        settlementId: Number(snapshot?.id || 0),
        settlementKey: key,
        title: `Pagar ${counterpartName} em ${periodLabel}`,
        helper: Math.max(0, Number(snapshot?.reservedCents || 0)) > 0
          ? `${formatBRLFromCents(snapshot?.openCents || 0)} ainda em aberto. Já tem ${formatBRLFromCents(snapshot?.reservedCents || 0)} aguardando confirmação.`
          : `${formatBRLFromCents(snapshot?.openCents || 0)} ainda em aberto nessa carteira do mês.`,
        meta: `Carteira mensal · ${formatBRLFromCents(snapshot?.openCents || 0)}`,
        buttonLabel: 'Abrir Pix do mês',
        priority: 1,
        sortDate: String(snapshot?.lastActivityAt || item?.updated_at || item?.created_at || '')
      });
      seenSettlements.add(key);
    });

    return entries;
  }

  function buildSentActionEntries(items) {
    const entries = [];
    const seenSettlements = new Set();

    (items || []).forEach((item) => {
      if (!isManualItem(item) && item?.status === 'accepted') {
        const key = item?.card_monthly_settlement_key || '';
        const snapshot = cardMonthlySnapshotForItem(item);
        const reportedIntentRows = Array.isArray(snapshot?.reportedIntentRows) ? snapshot.reportedIntentRows : [];
        if (key && snapshot && reportedIntentRows.length && !seenSettlements.has(key)) {
          const counterpartName = item?.receiver_name || item?.receiver_email || 'quem recebeu';
          const periodLabel = monthLabel(snapshot?.month || item?.source_due_month, snapshot?.year || item?.source_due_year);
          const freshestIntent = reportedIntentRows[0] || null;
          entries.push({
            kind: 'settlement',
            settlementId: Number(snapshot?.id || 0),
            settlementKey: key,
            actionTarget: 'jump',
            jumpTarget: `settlement-${Number(snapshot?.id || 0)}`,
            title: `Confirmar Pix de ${counterpartName} em ${periodLabel}`,
            helper: freshestIntent
              ? `${freshestIntent.amountFormatted || formatBRLFromCents(freshestIntent.amountCents || 0)} já foi avisado e está esperando seu ok final nessa carteira.`
              : `${formatBRLFromCents(snapshot?.reservedCents || 0)} está esperando sua confirmação nessa carteira.`,
            meta: `Carteira mensal · ${formatCountLabel(reportedIntentRows.length, 'Pix avisado', 'Pix avisados')}`,
            buttonLabel: 'Conferir pagamento',
            priority: 2,
            sortDate: String(freshestIntent?.reported_at || snapshot?.lastActivityAt || item?.updated_at || item?.created_at || '')
          });
          seenSettlements.add(key);
          return;
        }
      }

      const meta = actionMetaForItem(item, 'sent');
      if (meta) entries.push({ kind: 'request', ...meta });
    });

    return entries;
  }


  function sentFriendActionGroupKey(item) {
    const userId = Number(item?.receiver_user_id || 0);
    if (userId) return `user:${userId}`;
    const email = String(item?.receiver_email || item?.receiver_email_snapshot || '').trim().toLowerCase();
    if (email) return `email:${email}`;
    return `request:${Number(item?.id || 0)}`;
  }

  function buildSentFriendActionGroups(items) {
    const groups = new Map();

    (items || []).forEach((item) => {
      const actionState = sentActionState(item);
      if (!['sender_decision', 'confirm_receipt'].includes(actionState)) return;

      const key = sentFriendActionGroupKey(item);
      if (!groups.has(key)) {
        groups.set(key, {
          key,
          counterpartName: item?.receiver_name || item?.receiver_email || item?.receiver_email_snapshot || 'Usuário',
          counterpartEmail: item?.receiver_email || item?.receiver_email_snapshot || null,
          firstRequestId: Number(item?.id || 0) || null,
          latestAt: item?.payment_marked_at || item?.responded_at || item?.updated_at || item?.created_at || null,
          decisionItems: [],
          receiptItems: [],
          items: [],
          periods: new Set()
        });
      }

      const group = groups.get(key);
      group.items.push(item);
      if (actionState === 'sender_decision') group.decisionItems.push(item);
      if (actionState === 'confirm_receipt') group.receiptItems.push(item);
      if (!group.firstRequestId) group.firstRequestId = Number(item?.id || 0) || null;

      const activityAt = String(item?.payment_marked_at || item?.responded_at || item?.updated_at || item?.created_at || '');
      if (activityAt > String(group.latestAt || '')) group.latestAt = activityAt;

      const periodValue = itemPeriodValue(item);
      if (periodValue && periodValue !== '—') group.periods.add(periodValue);
    });

    return Array.from(groups.values()).map((group) => ({
      ...group,
      decisionCount: group.decisionItems.length,
      decisionCents: sumAmountCents(group.decisionItems),
      receiptCount: group.receiptItems.length,
      receiptCents: sumAmountCents(group.receiptItems),
      actionCount: group.decisionItems.length + group.receiptItems.length,
      periods: Array.from(group.periods.values()).slice(0, 3)
    })).sort((a, b) => {
      const activityDiff = String(b.latestAt || '').localeCompare(String(a.latestAt || ''));
      if (activityDiff !== 0) return activityDiff;
      return String(a.counterpartName || '').localeCompare(String(b.counterpartName || ''), 'pt-BR', { sensitivity: 'base' });
    });
  }

  function countGroupActions(group, scope) {
    return scope === 'received'
      ? buildReceivedActionEntries(group?.items || []).length
      : buildSentActionEntries(group?.items || []).length;
  }

  const actionCount = (trackingFiltersActive ? buildReceivedActionEntries(receivedBaseItems) : buildReceivedActionEntries(received)).length
    + (trackingFiltersActive ? buildSentActionEntries(sentBaseItems) : buildSentActionEntries(sent)).length;
  const receivedHasActionableGroup = receivedGroups.some(group => countGroupActions(group, 'received') > 0);
  const sentHasActionableGroup = sentGroups.some(group => countGroupActions(group, 'sent') > 0);

  function shouldOpenGroup(group, index, scope) {
    if (groupContainsRequest(group, requestIdToHighlight) || groupContainsSettlement(group, settlementIdToHighlight)) return true;
    const actionCountForGroup = countGroupActions(group, scope);
    if (actionCountForGroup > 0) return true;
    if (scope === 'received' && !receivedHasActionableGroup && index === 0) return true;
    if (scope === 'sent' && !sentHasActionableGroup && index === 0) return true;
    return false;
  }

  function groupsContainFocus(groups, requestId, settlementId) {
    if (!requestId && !settlementId) return false;
    return (groups || []).some((group) => groupContainsRequest(group, requestId) || groupContainsSettlement(group, settlementId));
  }

  const receivedAllActionEntries = buildReceivedActionEntries(received);
  const sentAllActionEntries = buildSentActionEntries(sent);
  const receivedVisibleActionEntries = buildReceivedActionEntries(receivedBaseItems);
  const sentVisibleActionEntries = buildSentActionEntries(sentBaseItems);
  const receivedActionCount = (trackingFiltersActive ? receivedVisibleActionEntries : receivedAllActionEntries).length;
  const sentActionCount = (trackingFiltersActive ? sentVisibleActionEntries : sentAllActionEntries).length;
  const sentFriendActionGroups = buildSentFriendActionGroups(trackingFiltersActive ? sentBaseItems : sent);
  const receivedScopeOpen = groupsContainFocus(receivedGroups, requestIdToHighlight, settlementIdToHighlight) || receivedHasActionableGroup || receivedManualSectionOpen;
  const sentScopeOpen = groupsContainFocus(sentGroups, requestIdToHighlight, settlementIdToHighlight)
    || sentHasActionableGroup
    || sentManualSectionOpen
    || sentPrivateReminderSectionOpen;

  function buildQuickActions() {
    const sourceReceivedItems = trackingFiltersActive ? receivedVisibleActionEntries : receivedAllActionEntries;
    const sourceSentItems = trackingFiltersActive ? sentVisibleActionEntries : sentAllActionEntries;
    const actions = [
      ...sourceReceivedItems,
      ...sourceSentItems
    ]
      .filter(Boolean)
      .sort((a, b) => {
        if (a.priority !== b.priority) return a.priority - b.priority;
        return String(b.sortDate || '').localeCompare(String(a.sortDate || ''));
      });

    return actions.slice(0, 3);
  }

  const quickActions = buildQuickActions();
  const firstQuickAction = quickActions[0] || null;
  const draftQueueSummaryMeta = draftSendQueueSummary || { queueCount: 0, itemCount: 0, totalCents: 0 };
  const draftQueueRows = Array.isArray(draftSendQueues) ? draftSendQueues : [];
%>

<div hidden data-offline-snapshot
  data-snapshot-page="<%= isArchiveMode ? 'Arquivo de acertos' : 'Central de acertos' %>"
  data-snapshot-title="<%= isArchiveMode ? 'Arquivo de acertos' : 'Central de acertos' %>"
  data-snapshot-summary="<%= isArchiveMode
    ? `Último arquivo salvo com ${archivedTotalVisible} item(ns) pronto(s) para restaurar.`
    : (draftQueueSummaryMeta.queueCount > 0
      ? `${actionCount} pedindo sua atenção e ${draftQueueSummaryMeta.queueCount} rascunho(s) guardado(s) na caixa de saída antes do envio.`
      : `${actionCount} pedindo sua atenção, com ${received.length} chegando para você e ${sentHeroCount} já enviado(s) por aqui.`) %>"
  data-snapshot-primary-label="<%= isArchiveMode ? 'No arquivo' : 'Sua vez' %>"
  data-snapshot-primary-value="<%= isArchiveMode ? `${archivedTotalVisible} item(ns)` : `${actionCount} pendência(s)` %>"
  data-snapshot-secondary-label="Chegou pra você"
  data-snapshot-secondary-value="<%= `${received.length} item(ns)` %>"
  data-snapshot-tertiary-label="<%= isArchiveMode ? 'Restaurar depois' : 'Caixa de saída' %>"
  data-snapshot-tertiary-value="<%= isArchiveMode ? `${archiveTotalCount || archivedTotalVisible} item(ns)` : `${draftQueueSummaryMeta.queueCount} rascunho(s)` %>"
  data-snapshot-cta-label="<%= isArchiveMode ? 'Voltar para o arquivo' : 'Voltar para os acertos' %>"
  data-snapshot-cta-href="<%= isArchiveMode ? otherPath : '/shared-debts' %>"></div>

<div class="op-screen op-screen--shared-debts op-debts-screen-v4 op-debts-screen-v5 max-w-7xl mx-auto space-y-8">
  <section class="op-page-hero op-fade-up op-debts-hero-v4 op-debts-hero-v5">
    <div>
      <span class="op-page-hero__eyebrow"><%= isArchiveMode ? 'Histórico de acertos' : 'Fluxo entre pessoas' %></span>
      <h1 class="op-page-hero__title mt-4"><%= isArchiveMode ? 'Arquivo de acertos' : 'Acertos' %></h1>
      <p class="op-page-hero__subtitle mt-3"><%= isArchiveMode
        ? 'Consulte o que já foi encerrado sem perder a trilha do que foi combinado por aqui.'
        : 'Acompanhe o que chegou para você, o que saiu da sua caixa de saída e o que ainda depende de ação, sem mudar a lógica atual do aplicativo.' %></p>
      <div class="op-page-hero__meta mt-4">
        <% if (isArchiveMode) { %>
          <span class="badge">Consulta com opção de restaurar</span>
          <span class="badge">Mesmo fluxo visual das ativas</span>
        <% } else { %>
          <span class="badge">Divisões ficam na caixa de saída até o envio</span>
          <span class="badge">Você controla envio, pagamento e confirmação</span>
        <% } %>
      </div>
      <div class="mt-5 flex flex-wrap gap-3 op-shared-action-row">
        <% if (isArchiveMode) { %>
          <a href="<%= otherPath %>" class="op-btn op-hero-link op-hero-link--debts">Voltar para ativas</a>
        <% } else { %>
          <% if (draftQueueSummaryMeta.queueCount) { %>
            <a href="#draft-queues" class="op-btn op-hero-link op-hero-link--debts">
              Caixa de saída
              <span class="ml-2 inline-flex min-w-[1.8rem] items-center justify-center rounded-full bg-sky-700 px-2 py-0.5 text-[11px] font-black text-white dark:bg-sky-200 dark:text-sky-900"><%= draftQueueSummaryMeta.queueCount %></span>
            </a>
          <% } %>
          <a href="<%= otherPath %>" class="op-btn op-hero-link op-hero-link--debts-soft">
            Arquivo
            <% if (archiveTotalCount) { %>
              <span class="ml-2 inline-flex min-w-[1.8rem] items-center justify-center rounded-full bg-slate-900 px-2 py-0.5 text-[11px] font-black text-white dark:bg-slate-100 dark:text-slate-900"><%= archiveTotalCount %></span>
            <% } %>
          </a>
        <% } %>
      </div>
    </div>

    <div class="op-kpi-strip op-debts-kpi-strip op-debts-kpi-strip--hero xl:max-w-[37rem] xl:self-end">
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label">Chegou pra você</div>
        <div class="op-kpi-card__value"><%= received.length %></div>
        <div class="op-kpi-card__hint"><span class="md:hidden"><%= countLabel(rawReceivedGroups.length, 'mês', 'meses') %></span><span class="hidden md:inline"><%= countLabel(rawReceivedGroups.length, 'período', 'períodos') %></span></div>
      </div>
      <div class="op-kpi-card text-center">
        <div class="op-kpi-card__label">Você mandou</div>
        <div class="op-kpi-card__value"><%= sentHeroCount %></div>
        <div class="op-kpi-card__hint">
          <% if (rawPrivateReminderItems.length) { %>
            <span><%= countLabel(rawSentGroups.length, 'período', 'períodos') %> + <%= countLabel(rawPrivateReminderItems.length, 'privada', 'privadas') %></span>
          <% } else { %>
            <span class="md:hidden"><%= countLabel(rawSentGroups.length, 'mês', 'meses') %></span><span class="hidden md:inline"><%= countLabel(rawSentGroups.length, 'período', 'períodos') %></span>
          <% } %>
        </div>
      </div>
      <div class="op-kpi-card text-center">
        <% if (isArchiveMode) { %>
          <div class="op-kpi-card__label text-violet-600 dark:text-violet-300">No arquivo</div>
          <div class="op-kpi-card__value text-violet-700 dark:text-violet-200"><%= archivedTotalVisible %></div>
          <div class="op-kpi-card__hint text-violet-700/80 dark:text-violet-200/80">Prontas para restaurar</div>
        <% } else { %>
          <div class="op-kpi-card__label text-amber-600 dark:text-amber-300">Sua vez</div>
          <div class="op-kpi-card__value text-amber-700 dark:text-amber-200"><%= actionCount %></div>
          <div class="op-kpi-card__hint text-amber-700/80 dark:text-amber-200/80">Pedindo sua ação</div>
        <% } %>
      </div>
    </div>
  </section>

  <% if (!isArchiveMode) { %>
  <section class="op-fade-up op-debts-insight-section">
    <div class="grid gap-4 xl:grid-cols-[1.25fr,0.95fr]">
      <article class="op-debts-overview-card rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
          <div class="max-w-2xl">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-500 dark:text-emerald-300">Fluxo do cartão por competência</div>
            <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white">Leitura mensal do cartão</h2>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">O histórico do envio continua aqui, mas o pagamento conversa com o mês do cartão entre vocês. Fica mais fácil entender quanto falta, o que já entrou e o que ainda espera confirmação.</p>
          </div>
          <div class="flex flex-wrap gap-2 lg:justify-end op-shared-action-row op-shared-action-row--compact">
            <a href="#received" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Ver o que chegou</a>
            <a href="#sent" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Ver o que você mandou</a>
            <a href="<%= monthlyGuideHref %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600">Guia completo</a>
          </div>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/70">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Pra pagar</div>
            <div class="mt-1 text-2xl font-black text-slate-900 dark:text-white"><%= monthlyReceiverOpenCount %></div>
            <p class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= monthlyReceiverOpenCount ? `${countLabel(monthlyReceiverOpenCount, 'mês aberto', 'meses abertos')} esperando seu pagamento ou complemento.` : 'Nada aberto do seu lado agora.' %></p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/70">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Esperando seu ok</div>
            <div class="mt-1 text-2xl font-black text-slate-900 dark:text-white"><%= monthlySenderReviewCount %></div>
            <p class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= monthlySenderReviewCount ? `${countLabel(monthlySenderReviewCount, 'mês', 'meses')} com Pix avisado e esperando sua confirmação.` : 'Nenhum Pix do mês esperando sua confirmação.' %></p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/70">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Você já avisou</div>
            <div class="mt-1 text-2xl font-black text-slate-900 dark:text-white"><%= monthlyReceiverAwaitingCount %></div>
            <p class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= monthlyReceiverAwaitingCount ? `${countLabel(monthlyReceiverAwaitingCount, 'mês', 'meses')} em que você já avisou o Pix e agora só falta o outro lado confirmar.` : 'Quando você avisar um Pix do mês, ele aparece aqui até receber o ok.' %></p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/70">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Resolvidos</div>
            <div class="mt-1 text-2xl font-black text-slate-900 dark:text-white"><%= monthlyMovementHistoryCount %></div>
            <p class="mt-2 text-xs font-medium leading-5 text-slate-500 dark:text-slate-400"><%= monthlyMovementHistoryCount ? 'Pix e revisões já fechados nesse mês.' : 'Quando um Pix do mês for confirmado, ele passa a aparecer aqui.' %></p>
          </div>
        </div>
      </article>

      <article class="op-debts-guide-card rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-500 dark:text-sky-300">Como usar sem se perder</div>
        <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white">Hoje funciona assim</h2>
        <div class="mt-4 space-y-3">
          <details class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/70" open>
            <summary class="cursor-pointer list-none text-sm font-black text-slate-900 dark:text-white">1. Salvou a divisão? Ela vai para a Caixa de saída</summary>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Nada é enviado na hora. Você revisa por pessoa e por mês antes de mandar, com calma e sem surpresa do outro lado.</p>
          </details>
          <details class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/70">
            <summary class="cursor-pointer list-none text-sm font-black text-slate-900 dark:text-white">2. Só vira acerto quando você enviar</summary>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Quando fizer sentido, você abre a Caixa de saída e manda. Aí sim a outra pessoa recebe no app e o combinado começa a andar entre vocês.</p>
          </details>
          <details class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/70">
            <summary class="cursor-pointer list-none text-sm font-black text-slate-900 dark:text-white">3. Depois você acompanha por aqui</summary>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">O que chegou para você fica em “Chegou pra você”. O que você mandou fica em “Você enviou”. E o cartão do mês continua organizado na carteira mensal.</p>
          </details>
        </div>
        <a href="<%= monthlyGuideHref %>" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Abrir guia completo</a>
      </article>
    </div>
  </section>

  <section class="op-fade-up">
    <div class="op-debts-outbox-card rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-500 dark:text-violet-300">Lançamento fora do cartão</div>
          <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white">Registrar acerto avulso</h2>
          <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">Ótimo para almoço, ingresso, Pix emprestado ou qualquer valor que não veio do cartão. Você escolhe se a pessoa recebe no app ou se isso fica só no seu radar.</p>
        </div>

        <div class="flex w-full flex-col gap-3 lg:max-w-sm lg:items-end">
          <button
            type="button"
            data-open-sheet="manual-shared-debt-sheet"
            <%= manualDebtPeopleList.length ? '' : 'disabled' %>
            class="inline-flex w-full items-center justify-center rounded-2xl bg-violet-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-500/20 transition-all lg:w-auto <%= manualDebtPeopleList.length ? 'hover:-translate-y-0.5 hover:bg-violet-700' : 'cursor-not-allowed opacity-60' %>">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Novo acerto avulso
          </button>
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400 lg:text-right">Poucos campos, data de hoje automática e opção de lembrar na data combinada.</p>
        </div>
      </div>

      <% if (!manualDebtPeopleList.length) { %>
        <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
          Para criar um combinado por aqui, você precisa ter pelo menos um contato ativo na <strong>Minha Rede</strong>. Criou o contato, voltou, e já pode usar.
        </div>
      <% } else { %>
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-slate-600 dark:text-slate-300">
          <span class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200"><%= countLabel(manualDebtEligibleList.length, 'amizade pronta', 'amizades prontas') %> para receber no app</span>
          <span class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-cyan-700 dark:border-cyan-800 dark:bg-cyan-900/20 dark:text-cyan-200"><%= countLabel(manualDebtPeopleList.length, 'contato ativo', 'contatos ativos') %> para lembrete privado</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/70">Data de hoje automática</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/70">Lembrete em data combinada</span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 dark:border-slate-700 dark:bg-slate-900/70">Acompanha até quitar</span>
        </div>
      <% } %>
    </div>
  </section>

  <section id="draft-queues" class="op-fade-up op-debts-outbox-section scroll-mt-24">
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
      <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
        <div class="max-w-3xl">
          <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-500 dark:text-sky-300">Caixa de saída</div>
          <h2 class="mt-1 text-xl font-black text-slate-900 dark:text-white">Revisar antes de enviar</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Tudo o que está aqui ainda não chegou para a outra pessoa. Você junta por pessoa e por mês, confere com calma e envia quando quiser.</p>
        </div>
        <div class="flex flex-wrap gap-2 xl:justify-end">
          <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-bold text-sky-700 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200"><%= countLabel(draftQueueSummaryMeta.queueCount, 'rascunho guardado', 'rascunhos guardados') %></span>
          <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200"><%= countLabel(draftQueueSummaryMeta.itemCount, 'movimento pronto', 'movimentos prontos') %></span>
          <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200"><%= formatBRLFromCents(draftQueueSummaryMeta.totalCents) %> na fila</span>
        </div>
      </div>

      <div class="mt-4 rounded-2xl border border-sky-200 bg-sky-50/90 px-4 py-3 text-sm font-medium text-sky-900 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">
Enquanto estiver aqui, nada é avisado para a outra pessoa e nada entra no controle dela. Só sai daqui quando você enviar.
      </div>

      <% if (draftQueueRows.length) { %>
        <div class="mt-5 grid gap-4 xl:grid-cols-2">
          <% draftQueueRows.forEach((queue) => { %>
            <% const queueItems = Array.isArray(queue.items) ? queue.items : []; %>
            <% const visibleItems = queueItems.slice(0, 4); %>
            <% const moreItemsCount = Math.max(0, queueItems.length - visibleItems.length); %>
            <article class="rounded-[28px] border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/60">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div>
                  <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Pronto para enviar</div>
                  <h3 class="mt-1 text-lg font-black text-slate-900 dark:text-white"><%= queue.receiverDisplayName %> · <%= queue.periodLabel %></h3>
                  <p class="mt-2 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Atualizado em <strong><%= queue.updatedAtLabel || 'agora há pouco' %></strong><%= queue.updatedAtTimeLabel ? ` às ${queue.updatedAtTimeLabel}` : '' %>. Quando você enviar, essa pessoa passa a ver o combinado no app. Se tiver ajuste ou cancelamento, ele vai junto.</p>
                </div>
                <div class="flex flex-wrap gap-2 lg:justify-end op-shared-action-row op-shared-action-row--compact">
                  <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200"><%= queue.totalFormatted %></span>
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"><%= countLabel(queue.itemCount, 'movimento', 'movimentos') %></span>
                </div>
              </div>

              <% if (queue.previewDescriptions && queue.previewDescriptions.length) { %>
                <div class="mt-4 flex flex-wrap gap-2">
                  <% queue.previewDescriptions.forEach((description) => { %>
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"><%= description %></span>
                  <% }) %>
                  <% if (queue.itemCount > queue.previewDescriptions.length) { %>
                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">+ <%= queue.itemCount - queue.previewDescriptions.length %> item(ns)</span>
                  <% } %>
                </div>
              <% } %>

              <div class="mt-4 space-y-2 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800/80">
                <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Prévia do envio</div>
                <% if (visibleItems.length) { %>
                  <div class="space-y-2">
                    <% visibleItems.forEach((item) => { %>
                      <% const actionMeta = draftActionMeta(item.actionKind); %>
                      <div class="flex items-start justify-between gap-3 text-sm">
                        <div>
                          <div class="flex flex-wrap items-center gap-2">
                            <div class="font-bold text-slate-900 dark:text-slate-100"><%= item.description_snapshot || 'Compra sem descrição' %></div>
                            <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-black uppercase tracking-[0.16em] <%= actionMeta.classes %>"><%= actionMeta.label %></span>
                          </div>
                          <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400"><%= item.txnDateLabel || queue.periodLabel %></div>
                        </div>
                        <div class="text-right font-black text-slate-900 dark:text-slate-100"><%= item.amountFormatted %></div>
                      </div>
                    <% }) %>
                  </div>
                  <% if (moreItemsCount > 0) { %>
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">E ainda tem mais <%= countLabel(moreItemsCount, 'movimento guardado', 'movimentos guardados') %> nesse rascunho.</div>
                  <% } %>
                <% } else { %>
                  <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-3 py-3 text-sm font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">Esse rascunho ficou sem itens visíveis por aqui. Se ele estiver estranho, pode descartar sem dó.</div>
                <% } %>
              </div>

              <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap op-shared-action-row">
                <form method="post" action="/shared-debts/draft-queues/<%= queue.id %>/send" class="sm:flex-1">
                  <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600">Enviar agora</button>
                </form>
                <form method="post" action="/shared-debts/draft-queues/<%= queue.id %>/discard" class="sm:flex-1">
                  <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Descartar rascunho</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="mt-5 rounded-[26px] border border-dashed border-slate-300 bg-slate-50 px-5 py-6 text-sm font-medium leading-6 text-slate-600 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-300">
          Nada guardado na caixa de saída por enquanto. Quando você salvar uma divisão, ela aparece aqui antes de ser enviada.
        </div>
      <% } %>
    </div>
  </section>

  <div id="manual-shared-debt-sheet" data-shared-debts-sheet class="fixed inset-0 z-[80] hidden">
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-close-sheet></div>
    <div class="absolute inset-x-0 bottom-0 flex max-h-[90vh] flex-col overflow-hidden rounded-t-[30px] bg-white shadow-2xl dark:bg-slate-900 sm:inset-0 sm:m-auto sm:max-h-[84vh] sm:max-w-2xl sm:rounded-[32px]">
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
        <div>
          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-violet-500 dark:text-violet-300">Acerto avulso</div>
          <h3 class="mt-1 text-lg font-black text-slate-900 dark:text-white">Criar combinado fora do cartão</h3>
          <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Vai com a data de hoje e, se quiser, você ainda marca uma data combinada para o app lembrar depois.</p>
        </div>
        <button type="button" data-close-sheet class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700" aria-label="Fechar envio avulso">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <form method="POST" action="/shared-debts/manual" class="min-h-0 flex-1 overflow-y-auto px-5 py-4" data-manual-debt-form>
        <div class="space-y-4" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
        <div class="rounded-2xl border border-violet-200 bg-violet-50 px-4 py-3 text-sm font-medium text-violet-800 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200" data-manual-debt-mode-note>
          Escolha se esse combinado vai para a outra pessoa no app ou se fica só no seu radar.
        </div>

        <div class="space-y-2">
          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Como esse acerto vai seguir?</div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="cursor-pointer rounded-2xl border border-violet-200 bg-violet-50/70 px-4 py-3 transition-colors data-[disabled=true]:cursor-not-allowed data-[disabled=true]:opacity-60" data-manual-debt-mode-card="app">
              <input type="radio" name="mode" value="app" class="sr-only" data-manual-debt-mode-input="app" checked>
              <div class="text-sm font-black text-slate-900 dark:text-white">Enviar no app</div>
              <div class="mt-1 text-xs font-medium leading-5 text-slate-600 dark:text-slate-300">A outra pessoa recebe por lá e vocês acompanham tudo nesta central.</div>
            </label>
            <label class="cursor-pointer rounded-2xl border border-slate-200 bg-white px-4 py-3 transition-colors data-[disabled=true]:cursor-not-allowed data-[disabled=true]:opacity-60 dark:border-slate-700 dark:bg-slate-800/80" data-manual-debt-mode-card="private">
              <input type="radio" name="mode" value="private" class="sr-only" data-manual-debt-mode-input="private">
              <div class="text-sm font-black text-slate-900 dark:text-white">Só no meu radar</div>
              <div class="mt-1 text-xs font-medium leading-5 text-slate-600 dark:text-slate-300">Fica só no seu radar. Ninguém recebe aviso.</div>
            </label>
          </div>
        </div>

        <label class="block">
          <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Com quem é esse acerto?</span>
          <select name="person_id" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20" data-manual-debt-person-select <%= manualDebtPeopleList.length ? '' : 'disabled' %>>
            <% (manualDebtPeopleList || []).forEach((person, index) => { %>
              <option value="<%= person.id %>" <%= index === 0 ? 'selected' : '' %> data-can-app="<%= person.can_share_charge && person.friendship_active ? '1' : '0' %>" data-has-app="<%= person.has_app_user ? '1' : '0' %>" data-friendship-active="<%= person.friendship_active ? '1' : '0' %>" data-email="<%= person.linked_user_email || person.email || '' %>" data-phone="<%= person.phone || '' %>"><%= person.name %><%= person.linked_user_email ? ` · ${person.linked_user_email}` : (person.email ? ` · ${person.email}` : '') %></option>
            <% }) %>
          </select>
          <% if (!manualDebtPeopleList.length) { %>
