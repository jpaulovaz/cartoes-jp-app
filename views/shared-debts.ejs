                            <div class="rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-900/70">
                              <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Total aceito</div>
                              <div class="mt-1 text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(entry.totalAcceptedCents) %></div>
