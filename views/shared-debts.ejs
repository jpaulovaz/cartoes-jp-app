                            <div class="sm:text-right">
                              <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Ainda em aberto</div>
                              <div class="mt-1 text-xl font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(entry.openCents) %></div>
                            </div>
                          </div>

