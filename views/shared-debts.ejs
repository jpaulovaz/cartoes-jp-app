                            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
                              <div>
                                <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Carteira do mês · <%= entry.counterpartName %></div>
                                <h3 class="mt-1 text-lg font-black text-slate-900 dark:text-white">Não recebi esse Pix agora</h3>
