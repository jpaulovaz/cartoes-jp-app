                            <div class="mt-1 text-lg font-extrabold text-slate-900 dark:text-white"><%= formatBRLFromCents(item.amount_cents) %></div>
                          </div>
                          <div class="text-sm font-bold text-cyan-600 dark:text-cyan-300">Ver detalhes</div>
                        </div>
                      </div>
                    </summary>

                    <div class="px-5 pb-5 pt-1 space-y-4 border-t border-cyan-200/70 dark:border-cyan-900/40">
                      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                        <div class="rounded-2xl bg-slate-50 dark:bg-slate-900/70 px-4 py-3">
                          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Contato</div>
                          <div class="mt-1 text-sm font-bold text-slate-900 dark:text-white"><%= item.display_name || item.person_name_snapshot || 'Contato' %></div>
