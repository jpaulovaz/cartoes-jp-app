                                <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-600">Confirmar recebimento</button>
                              </div>
                            </form>
                          </div>
                        </div>
                        <div id="<%= rejectSheetId %>" data-shared-debts-sheet class="fixed inset-0 z-[80] hidden">
                          <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-close-sheet></div>
