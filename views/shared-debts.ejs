                                <span class="inline-flex items-center rounded-full border border-sky-200 bg-white px-3 py-1 text-[11px] font-bold text-sky-700 dark:border-sky-800 dark:bg-slate-900/70 dark:text-sky-200"><%= formatBRLFromCents(entry.reservedCents) %> aguardando confirmação</span>
                              </div>
                              <div class="mt-4 space-y-3">
                                <% reportedIntentRows.forEach((intent) => { const confirmSheetId = `sent-settlement-confirm-${entry.id}-${intent.id}`.replace(/[^a-zA-Z0-9_-]/g, '-'); const rejectSheetId = `sent-settlement-reject-${entry.id}-${intent.id}`.replace(/[^a-zA-Z0-9_-]/g, '-'); const allocationRows = Array.isArray(intent.preview?.allocationRows) ? intent.preview.allocationRows : []; %>
