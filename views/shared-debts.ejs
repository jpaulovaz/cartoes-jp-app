                              </label>
                              <div class="rounded-2xl border border-emerald-200/70 bg-white/80 px-4 py-3 dark:border-emerald-800/70 dark:bg-slate-900/50">
                                <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Valor que sai do radar</div>
                                <div class="mt-1 text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(item.amount_cents) %></div>
                                <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">Assim que confirmar, esse valor deixa de pesar em <strong>Acertos a receber</strong>.</div>
                              </div>
                            </div>
                            <label class="block">
                              <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Observação da liquidação (opcional)</span>
                              <textarea name="note" rows="2" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:border-emerald-500 dark:focus:ring-emerald-500/20" placeholder="Ex.: Caiu no Pix e já conferi por aqui."></textarea>
                            </label>
                            <div class="flex justify-end">
                              <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600">Confirmar recebimento</button>
                            </div>
                          </form>
                        </div>
                      <% } else if (item.status === 'settled') { %>
