                      Ver lista do mês
                    </button>
                    <% if (sentMonthArchiveItems.length) { %>
                      <form method="POST" action="<%= isArchiveMode ? '/shared-debts/bulk/unarchive' : '/shared-debts/bulk/archive' %>" class="contents">
