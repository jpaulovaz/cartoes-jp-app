            <button
              type="button"
              <%= firstQuickAction.kind === 'settlement'
                ? (firstQuickAction.actionTarget === 'jump'
                    ? `data-jump-request="${firstQuickAction.jumpTarget || ('settlement-' + firstQuickAction.settlementId)}"`
                    : `data-open-card-monthly-settlement="${firstQuickAction.settlementId}"`)
                : `data-jump-request="request-${firstQuickAction.requestId}"` %>
              class="inline-flex shrink-0 items-center justify-center rounded-2xl bg-amber-500 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-amber-600">Abrir 1ª ação</button>
          <% } %>
        </div>
        <% if (quickActions.length) { %>
          <div class="mt-4 space-y-3">
