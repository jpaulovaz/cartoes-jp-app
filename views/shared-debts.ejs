                    </form>
                    <form method="POST" action="/shared-debts/batches/<%= batch.id %>/respond" class="contents">
                      <input type="hidden" name="action" value="accept">
                      <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"><%= batch.pendingCount > 1 ? 'Aceitar tudo' : 'Aceitar acerto' %></button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (sentBatchCards.length) { %>
        <div class="space-y-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
