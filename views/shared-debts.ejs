                            <div class="rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-900/70">
                              <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Já confirmado</div>
                              <div class="mt-1 text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(entry.confirmedCents) %></div>
                            </div>
                            <div class="rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-900/70">
                              <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Aguardando ok</div>
                              <div class="mt-1 text-sm font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(entry.reservedCents) %></div>
                            </div>
                            <div class="rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-900/70">
                              <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Compras do mês</div>
                              <div class="mt-1 text-sm font-black text-slate-900 dark:text-white"><%= countLabel(entry.requestCount, 'acerto', 'acertos') %></div>
                            </div>
                          </div>

                          <% if (reportedIntentRows.length) { %>
                            <div class="rounded-[26px] border border-sky-200 bg-sky-50/70 px-4 py-4 dark:border-sky-800 dark:bg-sky-900/20">
