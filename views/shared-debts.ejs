            </div>
            <div class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"><%= countLabel(sentBatchCards.length, 'envio aguardando resposta', 'envios aguardando resposta') %></div>
