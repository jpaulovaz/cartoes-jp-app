<%- include("partials/header", { title: `AcerttaPay | Resumo mensal ${String(month).padStart(2,'0')}/${year}` }) %>

  <div class="op-screen op-screen--summary op-summary-screen-v4 op-summary-screen-v5 w-full max-w-[104rem] mx-auto space-y-5 pb-24" data-op-mobile-safe-area="bottom-nav" data-summary-autosave-root data-year="<%= year %>" data-month="<%= month %>">

    <section class="op-page-hero op-summary-hero-v4 op-summary-hero-v5 op-fade-up mb-6">
      <div>
        <span class="op-page-hero__eyebrow">Fechamento do período</span>
        <h1 class="op-page-hero__title mt-4">Resumo financeiro — <%= String(month).padStart(2,'0') %>/<%= year %></h1>
        <p class="op-page-hero__subtitle mt-3">Acompanhe cartões, repasses e pagamentos do período em um único painel.</p>
      </div>
      <div class="op-page-hero__actions">
        <div class="op-page-hero__meta mt-4 mb-4 lg:mb-0">
          <span class="badge"><%= cardsPanel ? cardsPanel.length : 0 %> cartões no fechamento</span>
          <span class="badge"><%= personPanel ? personPanel.length : 0 %> pessoas no repasse</span>
          <% if (isClosed) { %><span class="badge">Mês fechado para consulta</span><% } %>
        </div>
        <a href="/month/<%= year %>/<%= month %>"
          class="op-btn op-btn--compact op-hero-link op-hero-link--month whitespace-nowrap">
          Ver mês
        </a>
        <a href="/analytics/<%= year %>/<%= month %>"
          class="op-btn op-btn--compact op-hero-link op-hero-link--analytics whitespace-nowrap">
          Análises
        </a>
      </div>
    </section>

    <% const privateReminderRadar = privateDebtReminderSummary || { activeCount: 0, activeCents: 0, readyToArchiveCount: 0, readyToArchiveCents: 0, hasActive: false, hasReadyToArchive: false }; %>
    <%
      const visibleCardsPanel = (cardsPanel || []).filter((cp) => Number(cp?.total_cents || 0) > 0);
      const visiblePersonPanel = (personPanel || []).filter((pp) => Number(pp?.total_cents || 0) > 0);
      const detailRowsWithValue = (rows || []).filter((row) => Number(row?.total_cents || 0) > 0);
      const visibleDetailCardIds = new Set(detailRowsWithValue.map((row) => Number(row?.card_id || 0)).filter(Boolean));
      const visibleDetailCards = (cards || []).filter((card) => visibleDetailCardIds.has(Number(card?.id || 0)));
      const visibleDetailPersonIds = new Set(detailRowsWithValue.map((row) => Number(row?.person_id || 0)).filter(Boolean));
      const visibleDetailPeople = (people || []).filter((person) => visibleDetailPersonIds.has(Number(person?.id || 0)));
      const cardsPanelTotals = visibleCardsPanel.reduce((acc, cp) => {
        acc.total_cents += Number(cp?.total_cents || 0);
        acc.paid_cents += Number(cp?.paid_cents || 0);
        acc.remaining_cents += Number(cp?.total_cents || 0) - Number(cp?.paid_cents || 0);
        return acc;
      }, { total_cents: 0, paid_cents: 0, remaining_cents: 0 });
      const personPanelTotals = visiblePersonPanel.reduce((acc, pp) => {
        const totalCents = Number(pp?.total_cents || 0);
        const paidCents = Number(pp?.paid_cents || 0);
        acc.total_cents += totalCents;
        acc.paid_cents += paidCents;
        acc.manual_paid_cents += Number(pp?.manual_paid_cents || 0);
        acc.auto_paid_cents += Number(pp?.auto_paid_cents || 0);
        acc.remaining_cents += Math.max(0, totalCents - paidCents);
        acc.overpaid_cents += Math.max(0, paidCents - totalCents);
        return acc;
      }, { total_cents: 0, paid_cents: 0, manual_paid_cents: 0, auto_paid_cents: 0, remaining_cents: 0, overpaid_cents: 0 });
      const hasAutoPersonPayments = visiblePersonPanel.some((pp) => Number(pp?.auto_paid_cents || 0) > 0);
      const summaryCardsRemainingCents = visibleCardsPanel.reduce((acc, cp) => acc + Math.max(0, Number(cp?.total_cents || 0) - Number(cp?.paid_cents || 0)), 0);
      const summaryPeopleRemainingCents = visiblePersonPanel.reduce((acc, pp) => acc + Math.max(0, Number(pp?.total_cents || 0) - Number(pp?.paid_cents || 0)), 0);
      const nextDueCard = visibleCardsPanel[0] || null;
      const nextDueLabel = nextDueCard?.due_date ? new Date(`${nextDueCard.due_date}T12:00:00`).toLocaleDateString('pt-BR') : 'Sem data salva';
      const cashReserveCents = personPanelTotals.paid_cents - cardsPanelTotals.paid_cents;
      const cashReserveToneClass = cashReserveCents > 0
        ? 'text-emerald-600 dark:text-emerald-300'
        : (cashReserveCents < 0 ? 'text-red-500 dark:text-red-300' : 'text-slate-700 dark:text-slate-200');
      const cashReserveHint = cashReserveCents > 0
        ? 'Livre para próximos vencimentos.'
        : (cashReserveCents < 0
          ? 'Saiu mais do que entrou.'
          : 'Entrou e saiu no mesmo valor.');
    %>
    <div hidden data-offline-snapshot
      data-snapshot-page="Resumo mensal"
      data-snapshot-title="Resumo mensal - <%= String(month).padStart(2,'0') %>/<%= year %>"
      data-snapshot-summary="<%= `Cartões com ${formatBRLFromCents(summaryCardsRemainingCents)} em aberto e repasses com ${formatBRLFromCents(summaryPeopleRemainingCents)} pendentes.` %>"
      data-snapshot-primary-label="Próxima fatura"
      data-snapshot-primary-value="<%= nextDueCard ? `${nextDueCard.card_name} · ${nextDueLabel}` : 'Sem fatura visível' %>"
      data-snapshot-secondary-label="Ainda nos cartões"
      data-snapshot-secondary-value="<%= formatBRLFromCents(summaryCardsRemainingCents) %>"
      data-snapshot-tertiary-label="Parcerias em aberto"
      data-snapshot-tertiary-value="<%= formatBRLFromCents(summaryPeopleRemainingCents) %>"
      data-snapshot-cta-label="Voltar para este resumo"
      data-snapshot-cta-href="/summary/<%= year %>/<%= month %>"></div>

    <% if (isClosed) { %>
      <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
        Este mês já foi fechado. As compras continuam visíveis, e os campos de pagamento e vencimento ficam disponíveis apenas para consulta.
      </div>
    <% } %>

    <% if (privateReminderRadar.hasActive || privateReminderRadar.hasReadyToArchive) { %>
      <div class="mb-8 rounded-3xl border border-cyan-200 bg-cyan-50/80 px-5 py-4 shadow-sm dark:border-cyan-800 dark:bg-cyan-900/20">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-cyan-700 dark:text-cyan-200">Radar só seu</div>
            <h3 class="mt-1 text-lg font-extrabold text-slate-900 dark:text-white">Há valores fora do cartão pedindo acompanhamento</h3>
            <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
              <% if (privateReminderRadar.hasActive) { %>
                <span><strong><%= privateReminderRadar.activeCount %></strong> lembrete<%= privateReminderRadar.activeCount === 1 ? '' : 's' %> privado<%= privateReminderRadar.activeCount === 1 ? '' : 's' %> segue<%= privateReminderRadar.activeCount === 1 ? '' : 'm' %> em aberto, somando <strong><%= formatBRLFromCents(privateReminderRadar.activeCents) %></strong>.</span>
              <% } %>
              <% if (privateReminderRadar.hasReadyToArchive) { %>
                <span class="<%= privateReminderRadar.hasActive ? 'ml-1' : '' %>"><strong><%= privateReminderRadar.readyToArchiveCount %></strong> já <%= privateReminderRadar.readyToArchiveCount === 1 ? 'pode' : 'podem' %> ir para o arquivo sem perder o histórico.</span>
              <% } %>
            </p>
          </div>
          <div class="flex flex-wrap gap-2 lg:justify-end">
            <% if (privateReminderRadar.hasActive) { %>
              <span class="inline-flex items-center rounded-full border border-emerald-200 bg-white px-3 py-1 text-xs font-bold text-emerald-700 dark:border-emerald-800 dark:bg-slate-900/70 dark:text-emerald-200"><%= privateReminderRadar.activeCount %> em aberto · <%= formatBRLFromCents(privateReminderRadar.activeCents) %></span>
            <% } %>
            <% if (privateReminderRadar.hasReadyToArchive) { %>
              <span class="inline-flex items-center rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-bold text-cyan-700 dark:border-cyan-800 dark:bg-slate-900/70 dark:text-cyan-200"><%= privateReminderRadar.readyToArchiveCount %> prontos para arquivo</span>
            <% } %>
            <a href="/shared-debts#private-reminders" class="inline-flex items-center justify-center rounded-2xl bg-cyan-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-cyan-700 dark:bg-cyan-500 dark:hover:bg-cyan-600">Abrir acertos</a>
          </div>
        </div>
      </div>
    <% } %>

    <% if (unassigned && unassigned.length> 0) { %>
      <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm flex items-start gap-4">
        <div
          class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0 mt-0.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
            </path>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-amber-900 mb-2">Há compras sem responsável definido</h3>
          <div class="flex flex-wrap gap-3">
            <% unassigned.forEach(u=> { %>
              <div
                class="bg-white dark:bg-slate-800 border border-amber-200 dark:border-amber-800 px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 shadow-sm">
                <span class="font-bold text-amber-800">
                  <%= u.card_name %>
                </span>
                <span class="font-black text-amber-900">
                  <%= formatBRLFromCents(u.total_cents) %>
                </span>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
      <% } %>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 lg:gap-8 mb-8">

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              Cartões do período
            </h2>
            <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <div data-summary-cards-panel>
                <% if (visibleCardsPanel.length > 0) { %>
                <div class="overflow-x-auto op-summary-scroll-shell">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-3 py-4">Cartão</th>
                        <th class="px-2 py-4 text-center">Vencimento</th>
                        <th class="px-3 py-4 text-right">Fatura</th>
                        <th class="px-3 py-4 text-right">Já saiu daqui</th>
                        <th class="px-3 py-4 text-right">Ainda falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% visibleCardsPanel.forEach(cp=> {
                        const falta = (cp.total_cents || 0) - (cp.paid_cents || 0);
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-card-row data-card-id="<%= cp.card_id %>" data-total-cents="<%= cp.total_cents || 0 %>">
                          <td class="px-3 py-3 font-bold text-slate-800 dark:text-white">
                            <%= cp.card_name %>
                          </td>
                          <td class="px-2 py-3 text-center">
                            <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">A gente calculou: <%=
                                formatDateBR(cp.computed_due_date) %>
                            </div>
                            <input name="override_due" type="date" value="<%= (cp.due_date || '') %>" <%= isClosed ? 'disabled' : '' %>
                              data-summary-card-due data-card-id="<%= cp.card_id %>"
                              class="border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none w-full min-w-[110px] text-center" />
                          </td>
                          <td class="px-3 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell">
                            <%= formatBRLFromCents(cp.total_cents) %>
                          </td>
                          <td class="px-3 py-3 text-right">
                            <input name="paid" inputmode="numeric" type="text"
                              value="<%= formatBRLFromCents(cp.paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                              data-money-mask data-summary-card-paid data-card-id="<%= cp.card_id %>"
                              class="op-summary-money-input text-right border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none" />
                          </td>
                          <td data-summary-card-remaining data-card-id="<%= cp.card_id %>"
                            class="px-3 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-3 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-2 py-3 text-center text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Ordenado por vencimento</td>
                        <td class="px-3 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(cardsPanelTotals.total_cents) %></td>
                        <td data-summary-cards-total-paid class="px-3 py-3 text-right font-black text-emerald-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(cardsPanelTotals.paid_cents) %></td>
                        <td data-summary-cards-total-remaining class="px-3 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= cardsPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(cardsPanelTotals.remaining_cents) %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
                <% } else { %>
                  <div class="px-5 py-8 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">
                    Nenhum cartão entrou no fechamento deste mês, então este quadro permanece vazio.
                  </div>
                <% } %>
              </div>
            </div>

            <div class="mt-4 op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden" data-summary-cash-section>
              <div class="border-b border-slate-200 bg-slate-50/80 px-5 py-4 dark:border-slate-700 dark:bg-slate-900/70">
                <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-200">Caixa das faturas</div>
                <h3 class="mt-1 text-lg font-extrabold text-slate-900 dark:text-white">Caixa disponível para faturas</h3>
                <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">Entradas confirmadas menos o que já saiu para quitar faturas.</p>
              </div>
              <div class="p-5">
                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4 op-summary-cash-grid">
                  <article class="rounded-2xl border border-slate-200 bg-white px-4 py-4 dark:border-slate-700 dark:bg-slate-900/70 op-summary-cash-card">
                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Faturas do mês</div>
                    <div data-summary-cash-total-bills class="op-summary-kpi-value op-summary-cash-value mt-2 text-slate-900 dark:text-white"><%= formatBRLFromCents(cardsPanelTotals.total_cents) %></div>
                    <p class="op-summary-kpi-note mt-2 text-slate-500 dark:text-slate-400">Total dos cartões.</p>
                  </article>
                  <article class="rounded-2xl border border-cyan-200 bg-cyan-50/70 px-4 py-4 dark:border-cyan-800 dark:bg-cyan-950/20 op-summary-cash-card">
                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-cyan-700 dark:text-cyan-200">Já reunido</div>
                    <div data-summary-cash-inflow class="op-summary-kpi-value op-summary-cash-value mt-2 text-cyan-700 dark:text-cyan-200"><%= formatBRLFromCents(personPanelTotals.paid_cents) %></div>
                    <p class="op-summary-kpi-note mt-2 text-cyan-900/80 dark:text-cyan-100/80">Já entrou.</p>
                  </article>
                  <article class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/80 op-summary-cash-card">
                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Já saiu nas faturas</div>
                    <div data-summary-cash-outflow class="op-summary-kpi-value op-summary-cash-value mt-2 text-slate-900 dark:text-white"><%= formatBRLFromCents(cardsPanelTotals.paid_cents) %></div>
                    <p class="op-summary-kpi-note mt-2 text-slate-500 dark:text-slate-400">Já foi pago.</p>
                  </article>
                  <article class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-4 dark:border-emerald-800 dark:bg-emerald-950/20 op-summary-cash-card">
                    <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-200">Saldo em caixa</div>
                    <div data-summary-cash-balance-value class="op-summary-kpi-value op-summary-cash-value mt-2 <%= cashReserveToneClass %>"><%= formatBRLFromCents(cashReserveCents) %></div>
                    <p data-summary-cash-balance-caption class="op-summary-kpi-note mt-2 text-slate-600 dark:text-slate-300"><%= cashReserveHint %></p>
                  </article>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                </path>
              </svg>
              Como está cada parceria
            </h2>
            <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <% if (hasAutoPersonPayments) { %>
                <div class="border-b border-indigo-100 bg-indigo-50/80 px-5 py-4 text-sm font-medium leading-6 text-indigo-900 dark:border-indigo-900/40 dark:bg-indigo-950/20 dark:text-indigo-100">
                  💡 O Pix confirmado do cartão entra sozinho nessa conta. O campo editável continua sendo só o ajuste manual do mês.
                </div>
              <% } %>
              <div data-summary-people-panel>
                <% if (visiblePersonPanel.length > 0) { %>
                <div class="overflow-x-auto op-summary-scroll-shell">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-4 py-4">Pessoa</th>
                        <th class="px-4 py-4 text-right">Total (Deve)</th>
                        <th class="px-4 py-4 text-right">Já entrou</th>
                        <th class="px-4 py-4 text-right">Ajuste manual</th>
                        <th class="px-4 py-4 text-right">Ainda falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% visiblePersonPanel.forEach(pp=> {
                        const falta = Math.max(0, (pp.total_cents || 0) - (pp.paid_cents || 0));
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-person-row data-person-id="<%= pp.person_id %>" data-total-cents="<%= pp.total_cents || 0 %>" data-auto-paid-cents="<%= pp.auto_paid_cents || 0 %>">
                          <td class="px-4 py-3 font-bold text-slate-800 dark:text-white">
                            <%= pp.person_name %>
                          </td>
                          <td class="px-4 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell">
                            <%= formatBRLFromCents(pp.total_cents) %>
                          </td>
                          <td class="px-4 py-3 text-right align-top">
                            <div data-summary-person-combined data-person-id="<%= pp.person_id %>" class="font-black text-indigo-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(pp.paid_cents || 0) %></div>
                            <div class="mt-1 flex flex-wrap justify-end gap-2 text-[11px] font-bold text-slate-500 dark:text-slate-400">
                              <% if (Number(pp.auto_paid_cents || 0) > 0) { %>
                                <span class="inline-flex items-center whitespace-nowrap rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pix <%= formatBRLFromCents(pp.auto_paid_cents || 0) %></span>
                              <% } %>
                              <% if (Number(pp.manual_paid_cents || 0) > 0) { %>
                                <span class="inline-flex items-center whitespace-nowrap rounded-full border border-slate-200 bg-white px-2.5 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">Ajuste <%= formatBRLFromCents(pp.manual_paid_cents || 0) %></span>
                              <% } else { %>
                                <span class="inline-flex w-fit max-w-full items-center whitespace-nowrap rounded-full border border-slate-200 bg-white px-2.5 py-1 text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">Sem ajuste manual</span>
                              <% } %>
                            </div>
                          </td>
                          <td class="px-4 py-3 text-right align-top">
                            <input name="paid" inputmode="numeric" type="text"
                              value="<%= formatBRLFromCents(pp.manual_paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                              data-money-mask data-summary-person-paid data-person-id="<%= pp.person_id %>"
                              class="op-summary-money-input text-right border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none" />
                            <p class="mt-2 text-[11px] font-medium leading-5 text-slate-500 dark:text-slate-400">Ajuste manual</p>
                          </td>
                          <td data-summary-person-remaining data-person-id="<%= pp.person_id %>"
                            class="px-4 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-4 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-4 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.total_cents) %></td>
                        <td data-summary-people-total-paid class="px-4 py-3 text-right font-black text-indigo-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.paid_cents) %></td>
                        <td data-summary-people-total-manual class="px-4 py-3 text-right font-black text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.manual_paid_cents) %></td>
                        <td data-summary-people-total-remaining class="px-4 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= personPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(personPanelTotals.remaining_cents) %></td>
                      </tr>
                      <% if (personPanelTotals.auto_paid_cents > 0) { %>
                        <tr>
                          <td colspan="5" class="px-4 pb-4 text-right text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                            Desses <span class="font-bold text-emerald-600 dark:text-emerald-300"><%= formatBRLFromCents(personPanelTotals.auto_paid_cents) %></span> já vieram automaticamente do Pix confirmado do cartão.
                          </td>
                        </tr>
                      <% } %>
                      <tr>
                        <td colspan="5" class="px-4 pb-4 text-right text-[11px] font-semibold leading-5 text-slate-500 dark:text-slate-400">
                          Pago a mais entra no caixa, sem reduzir o restante dos outros.
                          <span data-summary-people-overpaid-note <%= personPanelTotals.overpaid_cents > 0 ? '' : 'hidden' %>> Hoje isso soma <span data-summary-people-overpaid class="font-bold text-emerald-600 dark:text-emerald-300"><%= formatBRLFromCents(personPanelTotals.overpaid_cents) %></span>.</span>
                        </td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
                <% } else { %>
                  <div class="px-5 py-8 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">
                    Quando ninguém estiver com valor em aberto neste mês, essa visão some da muvuca e deixa só o que realmente pede atenção.
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
            </path>
          </svg>
          Distribuição por pessoa e cartão
        </h2>
        <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
          <% if (visibleDetailPeople.length > 0 && visibleDetailCards.length > 0) { %>
          <div class="overflow-x-auto op-summary-scroll-shell">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-900 text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-4 rounded-tl-3xl">Pessoa</th>
                  <% visibleDetailCards.forEach(c=> { %>
                    <th class="px-5 py-4 text-right">
                      <%= c.name %>
                    </th>
                    <% }) %>
                      <th class="px-5 py-4 text-right border-l border-slate-700 dark:border-slate-600">Total Geral</th>
                      <th class="px-5 py-4 text-center rounded-tr-3xl">Próximo passo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                <% visibleDetailPeople.forEach(p=> {
                  const perRow = detailRowsWithValue.filter(r => r.person_id === p.id);
                  const byCard = {};
                  perRow.forEach(r => byCard[r.card_id] = r.total_cents);
                  const total = Object.values(byCard).reduce((a,b)=>a+b,0);
                  %>
                  <tr class="hover:bg-blue-50/50 dark:hover:bg-slate-700/40 transition-colors group">
                    <td class="px-5 py-4 font-extrabold text-slate-800 dark:text-white text-base whitespace-nowrap">
                      <%= p.name %>
                    </td>
                    <% visibleDetailCards.forEach(c=> { %>
                      <td class="px-5 py-4 text-right font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap op-summary-amount-cell">
                        <%= formatBRLFromCents(byCard[c.id] || 0) %>
                      </td>
                      <% }) %>
                        <td
                          class="px-5 py-4 text-right font-black text-slate-900 dark:text-white border-l border-slate-100 dark:border-slate-700 text-base whitespace-nowrap op-summary-amount-cell">
                          <%= formatBRLFromCents(total) %>
                        </td>
                        <td class="px-5 py-4 text-center">
                          <% if (isAdmin) { %>
                            <a class="inline-flex items-center px-4 py-2 text-xs font-bold rounded-xl text-emerald-700 bg-emerald-100 hover:bg-emerald-200 transition-colors shadow-sm"
                              href="/whatsapp/<%= year %>/<%= month %>/<%= p.id %>">
                              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                              </svg>
                              Enviar no WhatsApp
                            </a>
                          <% } else { %>
                            <a class="inline-flex items-center px-4 py-2 text-xs font-bold rounded-xl text-sky-700 bg-sky-100 hover:bg-sky-200 transition-colors shadow-sm"
                              href="/share/<%= year %>/<%= month %>/<%= p.id %>">
                              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C9.886 12.64 11.278 12.25 12.75 12.25c1.472 0 2.864.39 4.066 1.092M8.684 13.342 5.5 15.25m3.184-1.908a3 3 0 10-1.368-2.53m9.5 2.53L19.5 15.25m-2.684-1.908a3 3 0 11 1.368-2.53M12 6v7" />
                              </svg>
                              Gerar resumo
                            </a>
                          <% } %>
                        </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
          <% } else { %>
            <div class="px-5 py-8 text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">
              O resumo detalhado só aparece quando já existe valor distribuído entre pessoa e cartão neste mês.
            </div>
          <% } %>
        </div>

  </div>


  </div>

  <%- include("partials/footer") %>
