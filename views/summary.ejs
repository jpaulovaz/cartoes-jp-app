<%- include("partials/header", { title: `OrganizaPay | Resumo ${String(month).padStart(2,'0')}/${year}` }) %>

  <div class="op-screen op-screen--summary w-full" data-summary-autosave-root data-year="<%= year %>" data-month="<%= month %>">

    <section class="op-page-hero op-fade-up mb-8">
      <div>
        <span class="op-page-hero__eyebrow">Fechamento inteligente</span>
        <h1 class="op-page-hero__title mt-4">Resumo — <%= String(month).padStart(2,'0') %>/<%= year %></h1>
        <p class="op-page-hero__subtitle mt-3">Veja cartões, pessoas e pagamentos do mês sem precisar caçar informação em várias telas.</p>
      </div>
      <div class="op-page-hero__actions">
        <a href="/month/<%= year %>/<%= month %>"
          class="inline-flex items-center justify-center rounded-2xl bg-rose-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-rose-500/20 transition-all hover:-translate-y-0.5 hover:bg-rose-600">
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          Ver compras
        </a>
      </div>
    </section>

    <% const graphKpis = summaryCharts && summaryCharts.kpis ? summaryCharts.kpis : null; %>
    <% const graphSectionDefaultOpen = true; %>
    <section class="mb-8 op-surface-card rounded-[28px] border border-slate-200 bg-white/95 p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 lg:p-6" data-summary-graphs-root data-summary-year="<%= year %>" data-summary-month="<%= month %>">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.24em] text-violet-700 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-200">Fase 11 · leitura visual</div>
          <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white">Gráficos do mês, sem mistério e sem cambalhota</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-300">Aqui o resumo ganha olho de águia: categoria, evolução mensal e indicadores rápidos para entender onde a grana pousou. A regra do app continua a mesma, só ficou mais fácil de ler.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2 lg:justify-end">
          <a href="/summary/<%= previousSummaryRef.year %>/<%= previousSummaryRef.month %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700/60">← <span class="ml-2">Mês anterior</span></a>
          <a href="/summary/<%= nextSummaryRef.year %>/<%= nextSummaryRef.month %>" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700/60"><span class="mr-2">Próximo mês</span>→</a>
          <button type="button" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white" data-summary-graphs-toggle aria-expanded="<%= graphSectionDefaultOpen ? 'true' : 'false' %>">
            <span data-summary-graphs-toggle-label><%= graphSectionDefaultOpen ? 'Esconder gráficos' : 'Mostrar gráficos' %></span>
          </button>
        </div>
      </div>

      <div class="mt-5 space-y-5" data-summary-graphs-panel <%= graphSectionDefaultOpen ? '' : 'hidden' %>>
        <div class="flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300">
          <span class="font-bold text-slate-800 dark:text-slate-100">Dica esperta:</span> tocou numa categoria ou num ponto da linha, a gente te leva direto pro mês ou filtro correspondente. Nada de caça ao tesouro financeiro.</span>
          <div class="hidden sm:block h-4 w-px bg-slate-300 dark:bg-slate-700"></div>
          <span data-summary-interaction-hint class="font-medium text-slate-500 dark:text-slate-400">Clique para explorar os detalhes.</span>
        </div>

        <div class="grid gap-3 lg:grid-cols-3">
          <div class="rounded-[24px] border border-slate-200 bg-white/90 p-4 dark:border-slate-700 dark:bg-slate-900/50">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Mês anterior</div>
            <div class="mt-2 text-xl font-black tracking-tight text-slate-900 dark:text-white"><%= formatBRLFromCents(summaryCharts?.monthlyTrend?.length > 1 ? summaryCharts.monthlyTrend[summaryCharts.monthlyTrend.length - 2].total_cents : 0) %></div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Ótimo para comparar se o mês atual veio mais comedido ou resolveu fazer cosplay de Carnaval.</p>
          </div>
          <div class="rounded-[24px] border border-slate-200 bg-white/90 p-4 dark:border-slate-700 dark:bg-slate-900/50">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Variação</div>
            <div class="mt-2 text-xl font-black tracking-tight <%= Number(graphKpis?.deltaCents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : 'text-emerald-600 dark:text-emerald-300' %>"><%= graphKpis?.deltaPct === null || graphKpis?.deltaPct === undefined ? 'Sem base ainda' : `${Number(graphKpis?.deltaPct || 0) > 0 ? '+' : ''}${Number(graphKpis?.deltaPct || 0)}%` %></div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Comparação pronta no capricho para não deixar aumento de gasto passar desfilando em silêncio.</p>
          </div>
          <div class="rounded-[24px] border border-violet-200 bg-violet-50/80 p-4 dark:border-violet-900/70 dark:bg-violet-950/30">
            <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-violet-700 dark:text-violet-300">Atalhos do gráfico</div>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href="/month/<%= year %>/<%= month %>" class="inline-flex items-center rounded-full border border-violet-200 bg-white px-3 py-1.5 text-xs font-bold text-violet-700 transition hover:-translate-y-0.5 hover:bg-violet-100 dark:border-violet-800 dark:bg-violet-950/40 dark:text-violet-200 dark:hover:bg-violet-900/50">Ver mês atual</a>
              <a href="/summary/<%= previousSummaryRef.year %>/<%= previousSummaryRef.month %>" class="inline-flex items-center rounded-full border border-violet-200 bg-white px-3 py-1.5 text-xs font-bold text-violet-700 transition hover:-translate-y-0.5 hover:bg-violet-100 dark:border-violet-800 dark:bg-violet-950/40 dark:text-violet-200 dark:hover:bg-violet-900/50">Comparar com mês anterior</a>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
          <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
            <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Total do mês</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= formatBRLFromCents(graphKpis?.totalSpentCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">Tudo que caiu neste resumo, sem fazer o usuário brincar de caça ao número.</p>
          </div>
          <div class="rounded-3xl border border-emerald-200 bg-emerald-50/80 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-700 dark:text-emerald-300">Pago nos cartões</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-emerald-700 dark:text-emerald-200"><%= formatBRLFromCents(graphKpis?.totalPaidCardsCents || 0) %></div>
            <p class="mt-2 text-xs leading-5 text-emerald-700/80 dark:text-emerald-200/80">Fatura andando bonita: ainda faltam <span class="font-bold"><%= formatBRLFromCents(graphKpis?.totalRemainingCardsCents || 0) %></span>.</p>
          </div>
          <div class="rounded-3xl border border-blue-200 bg-blue-50/80 p-4 dark:border-blue-900/60 dark:bg-blue-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-blue-700 dark:text-blue-300">Cobertura por categoria</div>
            <div class="mt-2 text-2xl font-black tracking-tight text-blue-700 dark:text-blue-200"><%= Number(graphKpis?.categoryCoveragePct || 0) %>%</div>
            <p class="mt-2 text-xs leading-5 text-blue-700/80 dark:text-blue-200/80"><%= formatBRLFromCents(graphKpis?.categorizedCents || 0) %> já estão com etiqueta bonitinha. O resto ainda está sem crachá.</p>
          </div>
          <div class="rounded-3xl border border-violet-200 bg-violet-50/80 p-4 dark:border-violet-900/60 dark:bg-violet-950/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-violet-700 dark:text-violet-300">Categoria campeã</div>
            <div class="mt-2 text-xl font-black tracking-tight text-violet-700 dark:text-violet-200"><%= graphKpis?.topCategory?.label || 'Sem líder por enquanto' %></div>
            <p class="mt-2 text-xs leading-5 text-violet-700/80 dark:text-violet-200/80"><% if (graphKpis?.topCategory) { %><span class="font-bold"><%= formatBRLFromCents(graphKpis.topCategory.total_cents || 0) %></span> · <%= Number(graphKpis.topCategory.share_pct || 0) %>% do mês.<% } else { %>Quando pintar gasto por categoria, ela assume a coroa.<% } %></p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
          <div class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white">Distribuição por categoria</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">O famoso “para onde foi o dinheiro?”. Se ele estiver tímido, o gráfico entrega.</p>
              </div>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Pizza esperta</span>
            </div>
            <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center">
              <div class="mx-auto w-full max-w-[280px]" data-summary-donut-chart></div>
              <div class="min-w-0 flex-1" data-summary-donut-legend></div>
            </div>
          </div>

          <div class="rounded-[26px] border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900/40">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white">Evolução mensal</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Se o mês acelerou, freou ou resolveu pedir carona para o próximo, a linha conta.</p>
              </div>
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Últimos 6 meses</span>
            </div>
            <div class="mt-4" data-summary-line-chart></div>
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/70">
                <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Comparação com mês anterior</div>
                <div class="mt-2 text-lg font-black <%= Number(graphKpis?.deltaCents || 0) > 0 ? 'text-rose-600 dark:text-rose-300' : 'text-emerald-600 dark:text-emerald-300' %>"><%= Number(graphKpis?.deltaCents || 0) > 0 ? '+' : '' %><%= formatBRLFromCents(graphKpis?.deltaCents || 0) %></div>
                <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400"><% if (graphKpis?.deltaPct === null || graphKpis?.deltaPct === undefined) { %>Ainda não deu para comparar, mas já estamos aquecendo o gramado.<% } else { %><%= Math.abs(Number(graphKpis.deltaPct || 0)) %>% <%= Number(graphKpis.deltaPct || 0) >= 0 ? 'acima' : 'abaixo' %> do mês anterior.<% } %></p>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/70">
                <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Compras sem categoria</div>
                <div class="mt-2 text-lg font-black text-slate-900 dark:text-white"><%= formatBRLFromCents(graphKpis?.uncategorizedCents || 0) %></div>
                <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">Essas aqui ainda estão no modo “sou misteriosa”. Vale classificar antes dos relatórios ficarem fofoqueiros.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <script type="application/json" data-summary-graphs-json><%- JSON.stringify(summaryCharts || { categories: [], monthlyTrend: [], kpis: {} }) %></script>
    </section>

    <div class="mb-6 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold leading-6 text-sky-900 dark:border-sky-800 dark:bg-sky-950/30 dark:text-sky-100 lg:hidden">
      💡 Dica amiga: no celular, esse resumo respira melhor na horizontal. Na vertical também funciona, mas de lado os números ficam bem mais confortáveis.
    </div>

    <% if (isClosed) { %>
      <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
        🔒 Este mês já foi fechado. As compras continuam visíveis, mas os campos de pagamento e vencimento ficam só para consulta.
      </div>
    <% } %>

    <% if (unassigned && unassigned.length> 0) { %>
      <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm flex items-start gap-4">
        <div
          class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0 mt-0.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
            </path>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-amber-900 mb-2">Ops: ainda tem compra sem dono</h3>
          <div class="flex flex-wrap gap-3">
            <% unassigned.forEach(u=> { %>
              <div
                class="bg-white dark:bg-slate-800 border border-amber-200 dark:border-amber-800 px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 shadow-sm">
                <span class="font-bold text-amber-800">
                  <%= u.card_name %>
                </span>
                <span class="font-black text-amber-900">
                  <%= formatBRLFromCents(u.total_cents) %>
                </span>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
      <% } %>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 lg:gap-8 mb-8">

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              Como estão os cartões
            </h2>
            <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <% const cardsPanelTotals = cardsPanel.reduce((acc, cp) => {
                   acc.total_cents += cp.total_cents || 0;
                   acc.paid_cents += cp.paid_cents || 0;
                   acc.remaining_cents += (cp.total_cents || 0) - (cp.paid_cents || 0);
                   return acc;
                 }, { total_cents: 0, paid_cents: 0, remaining_cents: 0 }); %>
              <div data-summary-cards-panel>
                <div class="overflow-x-auto op-summary-scroll-shell">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-3 py-4">Cartão</th>
                        <th class="px-2 py-4 text-center">Vencimento</th>
                        <th class="px-3 py-4 text-right">Fatura</th>
                        <th class="px-3 py-4 text-right">Valor Pago</th>
                        <th class="px-3 py-4 text-right">Falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% cardsPanel.forEach(cp=> {
                        const falta = (cp.total_cents || 0) - (cp.paid_cents || 0);
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-card-row data-card-id="<%= cp.card_id %>" data-total-cents="<%= cp.total_cents || 0 %>">
                          <td class="px-3 py-3 font-bold text-slate-800 dark:text-white">
                            <%= cp.card_name %>
                          </td>
                          <td class="px-2 py-3 text-center">
                            <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Calculado: <%=
                                formatDateBR(cp.computed_due_date) %>
                            </div>
                            <input name="override_due" type="date" value="<%= (cp.due_date || '') %>" <%= isClosed ? 'disabled' : '' %>
                              data-summary-card-due data-card-id="<%= cp.card_id %>"
                              class="border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none w-full min-w-[110px] text-center" />
                          </td>
                          <td class="px-3 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell">
                            <%= formatBRLFromCents(cp.total_cents) %>
                          </td>
                          <td class="px-3 py-3 text-right">
                            <input name="paid" inputmode="numeric" type="text"
                              value="<%= formatBRLFromCents(cp.paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                              data-money-mask data-summary-card-paid data-card-id="<%= cp.card_id %>"
                              class="op-summary-money-input text-right border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none" />
                          </td>
                          <td data-summary-card-remaining data-card-id="<%= cp.card_id %>"
                            class="px-3 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-3 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-2 py-3 text-center text-xs font-bold uppercase text-slate-500 dark:text-slate-400">Ordenado por vencimento</td>
                        <td class="px-3 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(cardsPanelTotals.total_cents) %></td>
                        <td data-summary-cards-total-paid class="px-3 py-3 text-right font-black text-emerald-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(cardsPanelTotals.paid_cents) %></td>
                        <td data-summary-cards-total-remaining class="px-3 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= cardsPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(cardsPanelTotals.remaining_cents) %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                </path>
              </svg>
              Como está cada pessoa
            </h2>
            <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <% const personPanelTotals = personPanel.reduce((acc, pp) => {
                   acc.total_cents += pp.total_cents || 0;
                   acc.paid_cents += pp.paid_cents || 0;
                   acc.manual_paid_cents += pp.manual_paid_cents || 0;
                   acc.auto_paid_cents += pp.auto_paid_cents || 0;
                   acc.remaining_cents += (pp.total_cents || 0) - (pp.paid_cents || 0);
                   return acc;
                 }, { total_cents: 0, paid_cents: 0, manual_paid_cents: 0, auto_paid_cents: 0, remaining_cents: 0 });
                 const hasAutoPersonPayments = personPanel.some((pp) => Number(pp.auto_paid_cents || 0) > 0); %>
              <% if (hasAutoPersonPayments) { %>
                <div class="border-b border-indigo-100 bg-indigo-50/80 px-5 py-4 text-sm font-medium leading-6 text-indigo-900 dark:border-indigo-900/40 dark:bg-indigo-950/20 dark:text-indigo-100">
                  💡 O Pix confirmado do cartão entra sozinho nessa conta. O campo editável continua sendo só o ajuste manual do mês.
                </div>
              <% } %>
              <div data-summary-people-panel>
                <div class="overflow-x-auto op-summary-scroll-shell">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-4 py-4">Pessoa</th>
                        <th class="px-4 py-4 text-right">Total (Deve)</th>
                        <th class="px-4 py-4 text-right">Já entrou</th>
                        <th class="px-4 py-4 text-right">Ajuste manual</th>
                        <th class="px-4 py-4 text-right">Falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% personPanel.forEach(pp=> {
                        const falta = (pp.total_cents || 0) - (pp.paid_cents || 0);
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-person-row data-person-id="<%= pp.person_id %>" data-total-cents="<%= pp.total_cents || 0 %>" data-auto-paid-cents="<%= pp.auto_paid_cents || 0 %>">
                          <td class="px-4 py-3 font-bold text-slate-800 dark:text-white">
                            <%= pp.person_name %>
                          </td>
                          <td class="px-4 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell">
                            <%= formatBRLFromCents(pp.total_cents) %>
                          </td>
                          <td class="px-4 py-3 text-right align-top">
                            <div data-summary-person-combined data-person-id="<%= pp.person_id %>" class="font-black text-indigo-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(pp.paid_cents || 0) %></div>
                            <div class="mt-1 flex flex-wrap justify-end gap-2 text-[11px] font-bold text-slate-500 dark:text-slate-400">
                              <% if (Number(pp.auto_paid_cents || 0) > 0) { %>
                                <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Pix <%= formatBRLFromCents(pp.auto_paid_cents || 0) %></span>
                              <% } %>
                              <% if (Number(pp.manual_paid_cents || 0) > 0) { %>
                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">Ajuste <%= formatBRLFromCents(pp.manual_paid_cents || 0) %></span>
                              <% } else { %>
                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">Sem ajuste manual</span>
                              <% } %>
                            </div>
                          </td>
                          <td class="px-4 py-3 text-right align-top">
                            <input name="paid" inputmode="numeric" type="text"
                              value="<%= formatBRLFromCents(pp.manual_paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                              data-money-mask data-summary-person-paid data-person-id="<%= pp.person_id %>"
                              class="op-summary-money-input text-right border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none" />
                            <p class="mt-2 text-[11px] font-medium leading-5 text-slate-500 dark:text-slate-400">Aqui entra só o ajuste manual. O Pix confirmado soma sozinho.</p>
                          </td>
                          <td data-summary-person-remaining data-person-id="<%= pp.person_id %>"
                            class="px-4 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-4 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-4 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.total_cents) %></td>
                        <td data-summary-people-total-paid class="px-4 py-3 text-right font-black text-indigo-700 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.paid_cents) %></td>
                        <td data-summary-people-total-manual class="px-4 py-3 text-right font-black text-slate-700 dark:text-slate-200 whitespace-nowrap op-summary-amount-cell"><%= formatBRLFromCents(personPanelTotals.manual_paid_cents) %></td>
                        <td data-summary-people-total-remaining class="px-4 py-3 text-right font-black whitespace-nowrap op-summary-amount-cell <%= personPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(personPanelTotals.remaining_cents) %></td>
                      </tr>
                      <% if (personPanelTotals.auto_paid_cents > 0) { %>
                        <tr>
                          <td colspan="5" class="px-4 pb-4 text-right text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                            Desses <span class="font-bold text-emerald-600 dark:text-emerald-300"><%= formatBRLFromCents(personPanelTotals.auto_paid_cents) %></span> já vieram automaticamente do Pix confirmado do cartão.
                          </td>
                        </tr>
                      <% } %>
                    </tfoot>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
            </path>
          </svg>
          Resumo Detalhado (Pessoa x Cartão)
        </h2>
        <div class="op-surface-card bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
          <div class="overflow-x-auto op-summary-scroll-shell">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-900 text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-4 rounded-tl-3xl">Pessoa</th>
                  <% cards.forEach(c=> { %>
                    <th class="px-5 py-4 text-right">
                      <%= c.name %>
                    </th>
                    <% }) %>
                      <th class="px-5 py-4 text-right border-l border-slate-700 dark:border-slate-600">Total Geral</th>
                      <th class="px-5 py-4 text-center rounded-tr-3xl">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                <% people.forEach(p=> {
                  const perRow = rows.filter(r => r.person_id === p.id);
                  const byCard = {};
                  perRow.forEach(r => byCard[r.card_id] = r.total_cents);
                  const total = Object.values(byCard).reduce((a,b)=>a+b,0);
                  %>
                  <tr class="hover:bg-blue-50/50 dark:hover:bg-slate-700/40 transition-colors group">
                    <td class="px-5 py-4 font-extrabold text-slate-800 dark:text-white text-base whitespace-nowrap">
                      <%= p.name %>
                    </td>
                    <% cards.forEach(c=> { %>
                      <td class="px-5 py-4 text-right font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap op-summary-amount-cell">
                        <%= formatBRLFromCents(byCard[c.id] || 0) %>
                      </td>
                      <% }) %>
                        <td
                          class="px-5 py-4 text-right font-black text-slate-900 dark:text-white border-l border-slate-100 dark:border-slate-700 text-base whitespace-nowrap op-summary-amount-cell">
                          <%= formatBRLFromCents(total) %>
                        </td>
                        <td class="px-5 py-4 text-center">
                          <% if (isAdmin) { %>
                            <a class="inline-flex items-center px-4 py-2 text-xs font-bold rounded-xl text-emerald-700 bg-emerald-100 hover:bg-emerald-200 transition-colors shadow-sm"
                              href="/whatsapp/<%= year %>/<%= month %>/<%= p.id %>">
                              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                              </svg>
                              WhatsApp
                            </a>
                          <% } else { %>
                            <a class="inline-flex items-center px-4 py-2 text-xs font-bold rounded-xl text-sky-700 bg-sky-100 hover:bg-sky-200 transition-colors shadow-sm"
                              href="/share/<%= year %>/<%= month %>/<%= p.id %>">
                              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C9.886 12.64 11.278 12.25 12.75 12.25c1.472 0 2.864.39 4.066 1.092M8.684 13.342 5.5 15.25m3.184-1.908a3 3 0 10-1.368-2.53m9.5 2.53L19.5 15.25m-2.684-1.908a3 3 0 11 1.368-2.53M12 6v7" />
                              </svg>
                              Compartilhar
                            </a>
                          <% } %>
                        </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
        </div>

  </div>

  

  <%- include("partials/footer") %>