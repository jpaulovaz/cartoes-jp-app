<%- include("partials/header", { title: `OrganizaPay | Resumo ${String(month).padStart(2,'0')}/${year}` }) %>

  <div class="w-full">

    <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Resumo — <%= String(month).padStart(2,'0') %>/
            <%= year %>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1 font-medium">Fechamento de faturas e divisões por pessoa.</p>
      </div>
      <a href="/month/<%= year %>/<%= month %>"
        class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-600 hover:text-blue-600 transition-all shadow-sm">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16">
          </path>
        </svg>
        Ver Itens (Lançamentos)
      </a>
    </div>

    <% if (isClosed) { %>
      <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
        🔒 Este mês está fechado. Os lançamentos continuam visíveis, mas os campos de pagamento e vencimento estão em somente leitura.
      </div>
    <% } else { %>
      <div id="summaryAutosaveStatus" class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">
        As alterações desta página são salvas automaticamente em segundo plano.
      </div>
    <% } %>

    <% if (unassigned && unassigned.length> 0) { %>
      <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm flex items-start gap-4">
        <div
          class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0 mt-0.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
            </path>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-amber-900 mb-2">Atenção: Existem itens não atribuídos a pessoas!</h3>
          <div class="flex flex-wrap gap-3">
            <% unassigned.forEach(u=> { %>
              <div
                class="bg-white dark:bg-slate-800 border border-amber-200 dark:border-amber-800 px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 shadow-sm">
                <span class="font-bold text-amber-800">
                  <%= u.card_name %>
                </span>
                <span class="font-black text-amber-900">
                  <%= formatBRLFromCents(u.total_cents) %>
                </span>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
      <% } %>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 lg:gap-8 mb-8">

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              Fechamento de Cartões
            </h2>
            <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <% const cardsPanelTotals = cardsPanel.reduce((acc, cp) => {
                   acc.total_cents += cp.total_cents || 0;
                   acc.paid_cents += cp.paid_cents || 0;
                   acc.remaining_cents += (cp.total_cents || 0) - (cp.paid_cents || 0);
                   return acc;
                 }, { total_cents: 0, paid_cents: 0, remaining_cents: 0 }); %>
              <form method="post" action="/summary/<%= year %>/<%= month %>/cards" id="summaryCardsForm" data-summary-autosave="cards">
                <div class="overflow-x-auto">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-3 py-4">Cartão</th>
                        <th class="px-2 py-4 text-center">Vencimento</th>
                        <th class="px-3 py-4 text-right">Fatura</th>
                        <th class="px-3 py-4 text-center">Valor Pago</th>
                        <th class="px-3 py-4 text-right">Falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% cardsPanel.forEach(cp=> {
                        const falta = (cp.total_cents || 0) - (cp.paid_cents || 0);
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-card-row data-total-cents="<%= cp.total_cents || 0 %>">
                          <td class="px-3 py-3 font-bold text-slate-800 dark:text-white">
                            <%= cp.card_name %>
                              <input type="hidden" name="card_id" value="<%= cp.card_id %>" />
                          </td>
                          <td class="px-2 py-3 text-center align-top">
                            <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Calculado: <%= formatDateBR(cp.computed_due_date) %></div>
                            <div class="flex justify-center">
                              <input name="override_due" type="date" value="<%= (cp.due_date || '') %>" data-summary-card-due <%= isClosed ? 'disabled' : '' %>
                                class="border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 text-sm font-medium text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none w-full max-w-[150px]" />
                            </div>
                          </td>
                          <td class="px-3 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap">
                            <%= formatBRLFromCents(cp.total_cents) %>
                          </td>
                          <td class="px-3 py-3 text-center">
                            <div class="flex justify-center">
                              <input name="paid" inputmode="numeric" type="text" data-money-mask data-money-zero="1" data-summary-card-paid
                                value="<%= formatBRLFromCents(cp.paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                                class="w-28 lg:w-32 text-center border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none paid-input" />
                            </div>
                          </td>
                          <td data-summary-card-remaining
                            class="px-3 py-3 text-right font-black whitespace-nowrap <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-3 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-2 py-3 text-xs font-bold uppercase text-slate-500 dark:text-slate-400 text-center">Ordenado por vencimento</td>
                        <td class="px-3 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap"><%= formatBRLFromCents(cardsPanelTotals.total_cents) %></td>
                        <td id="summaryCardsPaidTotal" class="px-3 py-3 text-center font-black text-emerald-700 whitespace-nowrap"><%= formatBRLFromCents(cardsPanelTotals.paid_cents) %></td>
                        <td id="summaryCardsRemainingTotal" class="px-3 py-3 text-right font-black whitespace-nowrap <%= cardsPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(cardsPanelTotals.remaining_cents) %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
                <div class="p-4 bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700 flex justify-end">
                  <% if (isClosed) { %>
                    <span class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Mês fechado</span>
                  <% } else { %>
                    <span class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">Salvamento automático ativo</span>
                  <% } %>
                </div>
              </form>
            </div>
          </div>

          <div>
            <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
              <svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                </path>
              </svg>
              Controle de Pessoas
            </h2>
            <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
              <% const personPanelTotals = personPanel.reduce((acc, pp) => {
                   acc.total_cents += pp.total_cents || 0;
                   acc.paid_cents += pp.paid_cents || 0;
                   acc.remaining_cents += (pp.total_cents || 0) - (pp.paid_cents || 0);
                   return acc;
                 }, { total_cents: 0, paid_cents: 0, remaining_cents: 0 }); %>
              <form method="post" action="/summary/<%= year %>/<%= month %>/people" id="summaryPeopleForm" data-summary-autosave="people">
                <div class="overflow-x-auto">
                  <table class="w-full text-sm text-left">
                    <thead
                      class="bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 uppercase font-bold text-xs tracking-wider">
                      <tr>
                        <th class="px-4 py-4">Pessoa</th>
                        <th class="px-4 py-4 text-right">Total (Deve)</th>
                        <th class="px-4 py-4 text-center">Já Pagou</th>
                        <th class="px-4 py-4 text-right">Falta</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                      <% personPanel.forEach(pp=> {
                        const falta = (pp.total_cents || 0) - (pp.paid_cents || 0);
                        %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors" data-summary-person-row data-total-cents="<%= pp.total_cents || 0 %>">
                          <td class="px-4 py-3 font-bold text-slate-800 dark:text-white">
                            <%= pp.person_name %>
                              <input type="hidden" name="person_id" value="<%= pp.person_id %>" />
                          </td>
                          <td class="px-4 py-3 text-right font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap">
                            <%= formatBRLFromCents(pp.total_cents) %>
                          </td>
                          <td class="px-4 py-3 text-center">
                            <div class="flex justify-center">
                              <input name="paid" inputmode="numeric" type="text" data-money-mask data-money-zero="1" data-summary-person-paid
                                value="<%= formatBRLFromCents(pp.paid_cents || 0) %>" <%= isClosed ? 'disabled' : '' %>
                                class="w-28 lg:w-32 text-center border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 bg-slate-50 dark:bg-slate-900 font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none paid-input" />
                            </div>
                          </td>
                          <td data-summary-person-remaining
                            class="px-4 py-3 text-right font-black whitespace-nowrap <%= falta > 0 ? 'text-red-500' : 'text-emerald-500' %>">
                            <%= formatBRLFromCents(falta) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                      <tr>
                        <td class="px-4 py-3 font-black text-slate-800 dark:text-white">Total</td>
                        <td class="px-4 py-3 text-right font-black text-slate-900 dark:text-white whitespace-nowrap"><%= formatBRLFromCents(personPanelTotals.total_cents) %></td>
                        <td id="summaryPeoplePaidTotal" class="px-4 py-3 text-center font-black text-indigo-700 whitespace-nowrap"><%= formatBRLFromCents(personPanelTotals.paid_cents) %></td>
                        <td id="summaryPeopleRemainingTotal" class="px-4 py-3 text-right font-black whitespace-nowrap <%= personPanelTotals.remaining_cents > 0 ? 'text-red-500' : 'text-emerald-500' %>"><%= formatBRLFromCents(personPanelTotals.remaining_cents) %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
                <div class="p-4 bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700 flex justify-end">
                  <% if (isClosed) { %>
                    <span class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Mês fechado</span>
                  <% } else { %>
                    <span class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-900 dark:border-indigo-800 dark:bg-indigo-900/20 dark:text-indigo-200">Salvamento automático ativo</span>
                  <% } %>
                </div>
              </form>
            </div>
          </div>
        </div>

        <h2 class="text-xl font-extrabold text-slate-800 dark:text-white mb-4 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
            </path>
          </svg>
          Resumo Detalhado (Pessoa x Cartão)
        </h2>
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-900 text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-4 rounded-tl-3xl">Pessoa</th>
                  <% cards.forEach(c=> { %>
                    <th class="px-5 py-4 text-right">
                      <%= c.name %>
                    </th>
                    <% }) %>
                      <th class="px-5 py-4 text-right border-l border-slate-700 dark:border-slate-600">Total Geral</th>
                      <th class="px-5 py-4 text-center rounded-tr-3xl">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                <% people.forEach(p=> {
                  const perRow = rows.filter(r => r.person_id === p.id);
                  const byCard = {};
                  perRow.forEach(r => byCard[r.card_id] = r.total_cents);
                  const total = Object.values(byCard).reduce((a,b)=>a+b,0);
                  %>
                  <tr class="hover:bg-blue-50/50 dark:hover:bg-slate-700/40 transition-colors group">
                    <td class="px-5 py-4 font-extrabold text-slate-800 dark:text-white text-base whitespace-nowrap">
                      <%= p.name %>
                    </td>
                    <% cards.forEach(c=> { %>
                      <td class="px-5 py-4 text-right font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap">
                        <%= formatBRLFromCents(byCard[c.id] || 0) %>
                      </td>
                      <% }) %>
                        <td
                          class="px-5 py-4 text-right font-black text-slate-900 dark:text-white border-l border-slate-100 dark:border-slate-700 text-base whitespace-nowrap">
                          <%= formatBRLFromCents(total) %>
                        </td>
                        <td class="px-5 py-4 text-center">
                          <a class="inline-flex items-center px-4 py-2 text-xs font-bold rounded-xl text-emerald-700 bg-emerald-100 hover:bg-emerald-200 transition-colors shadow-sm"
                            href="/whatsapp/<%= year %>/<%= month %>/<%= p.id %>">
                            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24">
                              <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                            </svg>
                            WhatsApp
                          </a>
                        </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
        </div>

  </div>

    <script>
    document.addEventListener("DOMContentLoaded", () => {
      const statusEl = document.getElementById("summaryAutosaveStatus");
      const formatter = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
      const saveTimers = new WeakMap();

      const setStatus = (message, type = "idle") => {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.className = "mb-8 rounded-2xl px-4 py-3 text-sm font-semibold";
        if (type === "saving") {
          statusEl.classList.add("border", "border-blue-200", "bg-blue-50", "text-blue-900", "dark:border-blue-800", "dark:bg-blue-900/20", "dark:text-blue-200");
        } else if (type === "success") {
          statusEl.classList.add("border", "border-emerald-200", "bg-emerald-50", "text-emerald-900", "dark:border-emerald-800", "dark:bg-emerald-900/20", "dark:text-emerald-200");
        } else if (type === "error") {
          statusEl.classList.add("border", "border-rose-200", "bg-rose-50", "text-rose-900", "dark:border-rose-800", "dark:bg-rose-900/20", "dark:text-rose-200");
        } else {
          statusEl.classList.add("border", "border-emerald-200", "bg-emerald-50", "text-emerald-900", "dark:border-emerald-800", "dark:bg-emerald-900/20", "dark:text-emerald-200");
        }
      };

      const centsFromInput = (value) => {
        const digits = String(value || "").replace(/\D/g, "");
        return digits ? Number(digits) : 0;
      };

      const updateColor = (element, cents) => {
        if (!element) return;
        element.classList.remove("text-red-500", "text-emerald-500");
        element.classList.add(cents > 0 ? "text-red-500" : "text-emerald-500");
      };

      const updateCardTotals = () => {
        const rows = document.querySelectorAll("[data-summary-card-row]");
        let paidTotal = 0;
        let remainingTotal = 0;

        rows.forEach((row) => {
          const totalCents = Number(row.dataset.totalCents || 0);
          const input = row.querySelector("[data-summary-card-paid]");
          const paidCents = centsFromInput(input ? input.value : "");
          const remainingCents = Math.max(0, totalCents - paidCents);
          paidTotal += paidCents;
          remainingTotal += remainingCents;

          const remainingCell = row.querySelector("[data-summary-card-remaining]");
          if (remainingCell) {
            remainingCell.textContent = formatter.format(remainingCents / 100);
            updateColor(remainingCell, remainingCents);
          }
        });

        const paidTotalEl = document.getElementById("summaryCardsPaidTotal");
        const remainingTotalEl = document.getElementById("summaryCardsRemainingTotal");
        if (paidTotalEl) paidTotalEl.textContent = formatter.format(paidTotal / 100);
        if (remainingTotalEl) {
          remainingTotalEl.textContent = formatter.format(remainingTotal / 100);
          updateColor(remainingTotalEl, remainingTotal);
        }
      };

      const updatePeopleTotals = () => {
        const rows = document.querySelectorAll("[data-summary-person-row]");
        let paidTotal = 0;
        let remainingTotal = 0;

        rows.forEach((row) => {
          const totalCents = Number(row.dataset.totalCents || 0);
          const input = row.querySelector("[data-summary-person-paid]");
          const paidCents = centsFromInput(input ? input.value : "");
          const remainingCents = Math.max(0, totalCents - paidCents);
          paidTotal += paidCents;
          remainingTotal += remainingCents;

          const remainingCell = row.querySelector("[data-summary-person-remaining]");
          if (remainingCell) {
            remainingCell.textContent = formatter.format(remainingCents / 100);
            updateColor(remainingCell, remainingCents);
          }
        });

        const paidTotalEl = document.getElementById("summaryPeoplePaidTotal");
        const remainingTotalEl = document.getElementById("summaryPeopleRemainingTotal");
        if (paidTotalEl) paidTotalEl.textContent = formatter.format(paidTotal / 100);
        if (remainingTotalEl) {
          remainingTotalEl.textContent = formatter.format(remainingTotal / 100);
          updateColor(remainingTotalEl, remainingTotal);
        }
      };

      const submitForm = async (form) => {
        if (!(form instanceof HTMLFormElement)) return;
        if (form.dataset.submitting === "1") return;

        form.dataset.submitting = "1";
        setStatus("Salvando alterações...", "saving");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
              "X-Requested-With": "fetch"
            },
            body: new URLSearchParams(new FormData(form)).toString()
          });

          if (!response.ok) {
            let errorMessage = "Não foi possível salvar as alterações.";
            try {
              const data = await response.json();
              if (data && data.error) errorMessage = data.error;
            } catch (e) {}
            throw new Error(errorMessage);
          }

          setStatus("Alterações salvas automaticamente.", "success");
        } catch (error) {
          setStatus(error.message || "Não foi possível salvar as alterações.", "error");
        } finally {
          form.dataset.submitting = "0";
        }
      };

      const scheduleSubmit = (form) => {
        if (!(form instanceof HTMLFormElement)) return;
        const existing = saveTimers.get(form);
        if (existing) clearTimeout(existing);
        setStatus("Alterações pendentes...", "saving");
        const timer = setTimeout(() => submitForm(form), 500);
        saveTimers.set(form, timer);
      };

      updateCardTotals();
      updatePeopleTotals();

      document.querySelectorAll("[data-summary-card-paid]").forEach((input) => {
        input.addEventListener("input", () => {
          updateCardTotals();
          scheduleSubmit(input.form);
        });
        input.addEventListener("change", () => {
          updateCardTotals();
          scheduleSubmit(input.form);
        });
      });

      document.querySelectorAll("[data-summary-person-paid]").forEach((input) => {
        input.addEventListener("input", () => {
          updatePeopleTotals();
          scheduleSubmit(input.form);
        });
        input.addEventListener("change", () => {
          updatePeopleTotals();
          scheduleSubmit(input.form);
        });
      });

      document.querySelectorAll("[data-summary-card-due]").forEach((input) => {
        input.addEventListener("change", () => scheduleSubmit(input.form));
      });
    });
  </script>

  <%- include("partials/footer") %>