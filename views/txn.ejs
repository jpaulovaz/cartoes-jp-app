<%- include("partials/header", { title: "Distribuir item" }) %>
<div class="mb-4 flex items-center justify-between">
  <div>
    <h1 class="text-xl font-semibold">Distribuir item</h1>
    <div class="text-sm text-slate-600"><span class="badge"><%= txn.card_name %></span> • <%= (txn.txn_date || "-") %> • <%= txn.card_number || "-" %></div>
  </div>
  <a class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50" href="/month/<%= txn.year %>/<%= txn.month %>">Voltar</a>
</div>
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
  <div class="text-sm text-slate-700 mb-2"><b>Descrição:</b> <%= txn.description %></div>
  <div class="text-sm text-slate-700 mb-4"><b>Valor:</b> <%= formatBRLFromCents(txn.amount_cents) %></div>
  <form method="post" action="/txn/<%= txn.id %>">
    <h2 class="font-semibold mb-2">Pessoas (divide em partes iguais)</h2>
    <div class="grid md:grid-cols-3 gap-2 mb-4">
      <% people.forEach(p => { %>
        <label class="border border-slate-200 rounded-xl p-3 flex items-center gap-2">
          <input type="checkbox" name="person_ids" value="<%= p.id %>" <%= selected.includes(p.id) ? "checked" : "" %> />
          <span><%= p.name %></span>
        </label>
      <% }) %>
    </div>
    <button class="px-4 py-2 rounded-xl bg-slate-900 text-white">Salvar</button>
  </form>
</div>
<%- include("partials/footer") %>
