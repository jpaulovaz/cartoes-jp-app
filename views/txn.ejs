<%- include("partials/header", { title: "Dividir compra" }) %>

<%
  function isSelfParticipant(person) {
    return !!person && (String(person.profile_kind || "").toLowerCase() === "self" || Number(person.is_owner || 0) !== 0 || !!person.is_self);
  }

  function getParticipantDisplayName(person) {
    if (!person) return "";
    return isSelfParticipant(person) ? "Eu" : String(person.name || "").trim();
  }
%>

<div class="op-screen op-screen--txn mx-auto max-w-5xl space-y-6">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Divisão da compra</span>
      <h1 class="op-page-hero__title mt-4">Dividir compra</h1>
      <p class="op-page-hero__subtitle mt-3">Escolha quem entra nessa compra e decida se o app reparte sozinho ou se você quer ditar o valor certinho de cada pessoa.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= txn.card_name %></span>
        <span class="badge"><%= txn.txn_date || '-' %></span>
        <% if (txn.card_number) { %>
          <span class="badge">Final <%= String(txn.card_number).slice(-4) %></span>
        <% } %>
      </div>
    </div>
    <div class="op-page-hero__actions">
      <a href="/month/<%= txn.year %>/<%= txn.month %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Voltar para o mês
      </a>
      <% if (!isClosed) { %>
        <div class="flex flex-wrap gap-2 sm:justify-end">
          <button type="submit" form="txn-alloc-form" data-txn-save-button data-delivery-mode-button data-delivery-mode="send_now" class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Salvar Divisão
          </button>
          <button type="submit" form="txn-alloc-form" data-txn-save-button data-delivery-mode-button data-delivery-mode="draft" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">
            Salvar e Mandar Depois
          </button>
        </div>
      <% } %>
    </div>
  </section>

  <% if (isClosed) { %>
    <div class="rounded-[22px] border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
      🔒 Este mês está fechado. Esta divisão fica só para consulta.
    </div>
  <% } %>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_340px]">
    <div class="op-form-card op-fade-up">
      <div class="relative z-10">
        <div class="op-form-card__title">Quem entra nessa compra</div>
        <p class="op-form-card__subtitle">Marque quem participou. Se mais de uma pessoa entrar na roda, você escolhe entre partes iguais ou valor definido.</p>

        <form
          id="txn-alloc-form"
          method="post"
          action="/txn/<%= txn.id %>"
          class="mt-6 space-y-5"
          data-installment-scope-form="alloc"
          data-has-future-installments="<%= hasFutureInstallments ? '1' : '0' %>"
          data-installment-label="<%= txn.description %>"
          data-txn-amount-cents="<%= Number(txn.amount_cents || 0) %>"
          data-is-closed="<%= isClosed ? '1' : '0' %>"
        >
          <input type="hidden" name="delivery_mode" value="send_now" data-delivery-mode-input />
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" data-txn-people-grid>
            <% people.forEach(p => { %>
              <label class="group <%= isClosed ? 'cursor-default' : 'cursor-pointer' %>">
                <input
                  class="peer sr-only"
                  type="checkbox"
                  name="person_ids"
                  value="<%= p.id %>"
                  data-person-checkbox
                  <%= selected.includes(p.id) ? 'checked' : '' %>
                  <%= isClosed ? 'disabled' : '' %>
                />
                <span class="flex min-h-[74px] items-center gap-3 rounded-[22px] border border-slate-200/80 bg-white/80 px-4 py-3 shadow-sm transition-all group-hover:-translate-y-0.5 group-hover:border-blue-300 group-hover:shadow-md peer-checked:border-blue-400 peer-checked:bg-blue-50 peer-checked:shadow-lg dark:border-slate-700 dark:bg-slate-900/55 dark:group-hover:border-blue-500 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-950/40 <%= isClosed ? 'opacity-70' : '' %>">
                  <span class="flex-1 text-sm font-bold text-slate-800 dark:text-slate-100"><%= getParticipantDisplayName(p) %></span>
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-400 transition-all peer-checked:border-blue-500 peer-checked:bg-blue-600 peer-checked:text-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-500 dark:peer-checked:border-blue-500 dark:peer-checked:bg-blue-500 dark:peer-checked:text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </span>
                </span>
              </label>
            <% }) %>
          </div>

          <section class="space-y-3" data-split-mode-shell hidden>
            <div class="text-sm font-black text-slate-900 dark:text-slate-100">Como você quer dividir essa compra?</div>
            <div class="grid gap-3 md:grid-cols-2">
              <label class="group <%= isClosed ? 'cursor-default' : 'cursor-pointer' %>">
                <input class="peer sr-only" type="radio" name="split_mode" value="equal" data-split-mode-input <%= isClosed && initialSplitMode !== 'exact' ? 'checked' : '' %> <%= isClosed ? 'disabled' : '' %> />
                <span class="flex h-full items-start gap-3 rounded-[22px] border border-slate-200 bg-white px-4 py-4 shadow-sm transition-all group-hover:-translate-y-0.5 group-hover:shadow-md peer-checked:border-emerald-400 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 dark:border-slate-700 dark:bg-slate-900/55 dark:peer-checked:border-emerald-500 dark:peer-checked:bg-emerald-950/25 dark:peer-checked:text-emerald-200">
                  <span class="mt-0.5 inline-flex h-10 w-10 flex-none items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-500 transition-all peer-checked:border-emerald-500 peer-checked:bg-emerald-600 peer-checked:text-white dark:border-slate-700 dark:bg-slate-950 dark:peer-checked:border-emerald-500 dark:peer-checked:bg-emerald-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </span>
                  <span>
                    <span class="block text-sm font-black text-slate-900 dark:text-slate-100">Partes iguais</span>
                    <span class="mt-1 block text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">O app reparte sozinho entre as pessoas marcadas e deixa tudo redondinho.</span>
                  </span>
                </span>
              </label>

              <label class="group <%= isClosed ? 'cursor-default' : 'cursor-pointer' %>">
                <input class="peer sr-only" type="radio" name="split_mode" value="exact" data-split-mode-input <%= isClosed && initialSplitMode === 'exact' ? 'checked' : '' %> <%= isClosed ? 'disabled' : '' %> />
                <span class="flex h-full items-start gap-3 rounded-[22px] border border-slate-200 bg-white px-4 py-4 shadow-sm transition-all group-hover:-translate-y-0.5 group-hover:shadow-md peer-checked:border-violet-400 peer-checked:bg-violet-50 peer-checked:text-violet-700 dark:border-slate-700 dark:bg-slate-900/55 dark:peer-checked:border-violet-500 dark:peer-checked:bg-violet-950/25 dark:peer-checked:text-violet-200">
                  <span class="mt-0.5 inline-flex h-10 w-10 flex-none items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-500 transition-all peer-checked:border-violet-500 peer-checked:bg-violet-600 peer-checked:text-white dark:border-slate-700 dark:bg-slate-950 dark:peer-checked:border-violet-500 dark:peer-checked:bg-violet-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-3.314 0-6 2.239-6 5 0 1.657.97 3.126 2.465 4.038L8 21l3.211-2.14A7.43 7.43 0 0012 19c3.314 0 6-2.239 6-5s-2.686-5-6-5z"></path>
                    </svg>
                  </span>
                  <span>
                    <span class="block text-sm font-black text-slate-900 dark:text-slate-100">Valor definido</span>
                    <span class="mt-1 block text-sm font-medium leading-6 text-slate-500 dark:text-slate-400">Perfeito para almoço, Uber ou qualquer compra em que cada um ficou com uma parte diferente.</span>
                  </span>
                </span>
              </label>
            </div>
          </section>

          <section class="space-y-3 rounded-[24px] border border-violet-200 bg-violet-50/80 p-4 dark:border-violet-900/70 dark:bg-violet-950/20" data-exact-split-shell hidden>
            <div class="text-sm font-semibold text-violet-900 dark:text-violet-200">Total da compra: <span class="font-black"><%= formatBRLFromCents(txn.amount_cents) %></span>. Preencha até fechar certinho.</div>
            <div class="grid gap-3" data-exact-fields></div>
            <div class="rounded-[18px] border border-white/70 bg-white/85 px-4 py-3 text-sm dark:border-slate-800 dark:bg-slate-900/60" data-exact-summary></div>
          </section>

          <div class="rounded-[18px] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/20 dark:text-red-200" data-split-error hidden></div>

          <% if (hasFutureInstallments) { %>
            <div class="rounded-[22px] border border-sky-200 bg-sky-50/90 px-4 py-3 text-sm font-semibold text-sky-900 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">
              Esta compra faz parte de um parcelamento. Ao salvar ou excluir, você pode decidir se a mudança vale só nesta parcela ou também nas próximas.
            </div>
          <% } %>

          <% if (!isClosed) { %>
            <div class="rounded-[22px] border border-sky-200 bg-sky-50/90 px-4 py-3 text-sm font-medium text-sky-900 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-200">
              Quer evitar flood quando estiver atribuindo muita compra? Salve agora e mande depois. A cobrança fica na sua caixa de saída até você disparar por pessoa e por mês.
            </div>
            <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:flex-wrap">
              <button type="submit" data-txn-save-button data-delivery-mode-button data-delivery-mode="send_now" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">Salvar e Cobrar Agora</button>
              <button type="submit" data-txn-save-button data-delivery-mode-button data-delivery-mode="draft" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Salvar e Mandar Depois</button>
              <% if (!txn.import_id) { %><button type="button" data-edit-txn-open class="inline-flex items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3 text-sm font-bold text-emerald-700 transition-all hover:-translate-y-0.5 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200 dark:hover:bg-emerald-900/35">Editar Compra</button><% } %>
              <button type="submit" form="delete-txn-form" class="inline-flex items-center justify-center rounded-2xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-bold text-red-700 transition-all hover:-translate-y-0.5 hover:bg-red-100 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200 dark:hover:bg-red-900/35">Excluir Compra</button>
            </div>
          <% } else { %>
            <span class="inline-flex rounded-2xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200">Mês fechado</span>
          <% } %>
        </form>
      </div>

      <% if (!isClosed) { %>
        <form id="delete-txn-form" method="post" action="/txn/<%= txn.id %>/delete" data-confirm-prompt="Excluir esta compra? Isso apaga o item e a divisão associada." data-confirm-phrase="Eu confirmo" data-installment-scope-form="delete" data-has-future-installments="<%= (hasFutureInstallments || txn.recurring_rule_id) ? '1' : '0' %>" data-future-scope-kind="<%= txn.recurring_rule_id ? 'recurring' : 'installment' %>" data-installment-label="<%= txn.description %>"></form>

        <div id="txn-edit-modal" class="fixed inset-0 z-[90] hidden" aria-hidden="true">
          <div data-edit-modal-backdrop class="absolute inset-0 bg-slate-950/55 backdrop-blur-sm"></div>
          <div class="absolute inset-x-0 bottom-0 top-auto flex max-h-[92vh] flex-col overflow-hidden rounded-t-[32px] border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-950 sm:inset-x-auto sm:bottom-auto sm:left-1/2 sm:top-1/2 sm:max-h-[88vh] sm:w-full sm:max-w-3xl sm:-translate-x-1/2 sm:-translate-y-1/2 sm:rounded-[32px]">
            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
              <div>
                <div class="text-xs font-black uppercase tracking-[0.22em] text-emerald-600 dark:text-emerald-300">Editar compra</div>
                <div class="mt-1 text-lg font-black text-slate-900 dark:text-slate-100">Sem excluir e lançar de novo, ufa.</div>
                <p class="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">Ajuste os dados da compra e, se houver parcelas ou recorrência, o app pergunta o alcance antes de salvar.</p>
              </div>
              <button type="button" data-edit-txn-close class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500 transition hover:border-slate-300 hover:text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-slate-100">✕</button>
            </div>
            <div class="flex-1 overflow-y-auto px-5 py-5">
              <div id="txn-edit-feedback" class="hidden rounded-[22px] border px-4 py-3 text-sm font-semibold"></div>
              <form id="txn-edit-form" class="mt-4 space-y-4" data-has-future-installments="<%= (hasFutureInstallments || txn.recurring_rule_id) ? '1' : '0' %>" data-future-scope-kind="<%= txn.recurring_rule_id ? 'recurring' : 'installment' %>" data-installment-label="<%= txn.description %>">
                <div id="txn-edit-summary" class="rounded-[24px] border border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-900/50"></div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class="block">
                    <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Data da compra</span>
                    <input type="date" name="date" value="<%= txn.txn_date %>" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                  </label>
                  <label class="block">
                    <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Cartão</span>
                    <select name="card_id" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                      <% (cards || []).forEach(card => { %>
                        <option value="<%= card.id %>" data-close-day="<%= card.close_day || '' %>" data-due-day="<%= card.due_day || '' %>" <%= Number(card.id) === Number(txn.card_id || 0) ? 'selected' : '' %>><%= card.name %></option>
                      <% }) %>
                    </select>
                  </label>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label class="block">
                    <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor total (R$)</span>
                    <input type="text" name="amount" value="<%= formatBRLFromCents(txn.amount_cents).replace('R$','').trim() %>" required inputmode="decimal" data-money-mask="1" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                  </label>
                  <label class="block">
                    <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= txn.recurring_rule_id ? 'Próxima fatura desta recorrência' : 'Vai cair em qual fatura?' %></span>
                    <input type="month" name="first_due" value="<%= String(txn.year).padStart(4, '0') %>-<%= String(txn.month).padStart(2, '0') %>" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                  </label>
                </div>
                <label class="block">
                  <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Descrição</span>
                  <input type="text" name="description" value="<%= txn.description %>" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                </label>
                <div data-purchase-category-control class="space-y-3">
                  <label class="block">
                    <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</span>
                    <select name="purchase_category_id" data-purchase-category-select class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                      <option value="" <%= !txn.purchase_category_id ? 'selected' : '' %>>Sem categoria por enquanto</option>
                      <% (purchaseCategories || []).forEach(category => { %>
                        <option value="<%= category.id %>" <%= Number(category.id) === Number(txn.purchase_category_id || 0) ? 'selected' : '' %>><%= category.name %><%= category.active ? '' : ' (arquivada)' %></option>
                      <% }) %>
                      <option value="__new__">Criar categoria nova</option>
                    </select>
                  </label>
                  <div data-purchase-category-custom-shell hidden>
                    <label class="block">
                      <span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Nome da nova categoria</span>
                      <input type="text" name="purchase_category_custom" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input disabled class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:bg-white focus:ring-2 focus:ring-emerald-500 dark:border-slate-600 dark:bg-slate-950/70 dark:text-slate-100">
                    </label>
                  </div>
                </div>
                <div id="txn-edit-insights" class="space-y-3"></div>
              </form>
            </div>
            <div class="flex flex-col gap-3 border-t border-slate-200 px-5 py-4 dark:border-slate-800 sm:flex-row sm:justify-end">
              <button type="button" data-edit-txn-close class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Cancelar</button>
              <button type="submit" form="txn-edit-form" data-edit-txn-submit class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition hover:-translate-y-0.5 hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">Salvar alterações</button>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <aside class="space-y-4 op-fade-up">
      <section class="op-form-card">
        <div class="relative z-10 space-y-4">
          <div>
            <div class="op-form-card__title">Resumo da compra</div>
            <p class="op-form-card__subtitle">Um resumo rapidinho da compra antes de dividir.</p>
          </div>
          <div class="space-y-3">
            <div class="rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/55">
              <div class="op-field-label">Descrição</div>
              <div class="text-base font-black text-slate-900 dark:text-slate-100"><%= txn.description %></div>
            </div>
            <div class="rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/55">
              <div class="op-field-label">Valor</div>
              <div class="text-2xl font-black text-slate-900 dark:text-slate-100"><%= formatBRLFromCents(txn.amount_cents) %></div>
            </div>
            <div class="rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/55">
              <div class="op-field-label">Tipo de compra</div>
              <div class="text-sm font-bold text-slate-700 dark:text-slate-200"><%= txn.recurring_rule_id ? 'Recorrente' : (hasFutureInstallments ? 'Parcelada' : 'À vista') %></div>
            </div>
          </div>
        </div>
      </section>

      <section class="op-form-card">
        <div class="relative z-10 space-y-4">
          <div>
            <div class="op-form-card__title">Categoria da compra</div>
            <p class="op-form-card__subtitle">Opcional, mas uma mão na roda para organizar depois sem mudar o valor da compra.</p>
          </div>

          <div class="rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/55">
            <div class="op-field-label">Categoria atual</div>
            <% if (txn.purchase_category_name) { %>
              <span class="mt-2 inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200"><%= txn.purchase_category_name %><% if (!txn.purchase_category_active) { %> · arquivada<% } %></span>
            <% } else { %>
              <div class="mt-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Sem categoria por enquanto</div>
            <% } %>
          </div>

          <% if (!isClosed) { %>
            <form method="post" action="/txn/<%= txn.id %>/category" class="space-y-3" data-installment-scope-form="category" data-has-future-category-scope="<%= (hasFutureInstallments || txn.recurring_rule_id) ? '1' : '0' %>" data-future-scope-kind="<%= txn.recurring_rule_id ? 'recurring' : 'installment' %>" data-installment-label="<%= txn.description %>">
              <div data-purchase-category-control class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Escolha a categoria</label>
                  <select name="purchase_category_id" data-purchase-category-select
                    class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950">
                    <option value="" <%= !txn.purchase_category_id ? 'selected' : '' %>>Sem categoria por enquanto</option>
                    <% (purchaseCategories || []).forEach(category => { %>
                      <option value="<%= category.id %>" <%= Number(txn.purchase_category_id || 0) === Number(category.id) ? 'selected' : '' %>><%= category.name %><%= category.active ? '' : ' (arquivada)' %></option>
                    <% }) %>
                    <option value="__new__">Criar categoria nova</option>
                  </select>
                </div>
                <div data-purchase-category-custom-shell hidden>
                  <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase mb-1">Nome da nova categoria</label>
                  <input type="text" name="purchase_category_custom" maxlength="60" placeholder="Ex: Feira de sábado" data-purchase-category-custom-input disabled
                    class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 outline-none transition focus:border-blue-400 focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:focus:bg-slate-950">
                </div>
              </div>
              <p class="text-xs font-medium text-slate-500 dark:text-slate-400">A categoria ajuda a organizar a leitura do mês e prepara o terreno para relatórios mais bonitos depois.</p>
              <% if (txn.recurring_rule_id) { %>
                <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Como essa compra é recorrente, ao salvar você pode decidir se a mudança vale só neste mês ou também nas próximas recorrências.</p>
              <% } else if (hasFutureInstallments) { %>
                <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Como essa compra é parcelada, ao salvar você pode decidir se a mudança vale só aqui ou também nas próximas parcelas.</p>
              <% } %>
              <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">Salvar categoria</button>
            </form>
          <% } else { %>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Mês fechado: a categoria aparece aqui, mas qualquer ajuste fica para quando o mês estiver aberto.</p>
          <% } %>
        </div>
      </section>

      <section class="op-form-card">
        <div class="relative z-10">
          <div class="op-form-card__title">Como mexer aqui</div>
          <div class="op-step-list">
            <div class="op-step-item">
              <div class="op-step-item__index">1</div>
              <div>
                <div class="op-step-item__title">Escolha as pessoas</div>
                <div class="op-step-item__text">Pode incluir você também. Isso é ótimo quando a compra tem sua parte + a galera.</div>
              </div>
            </div>
            <div class="op-step-item">
              <div class="op-step-item__index">2</div>
              <div>
                <div class="op-step-item__title">Defina o jeito do rateio</div>
                <div class="op-step-item__text">Em partes iguais o app resolve. Em valor definido, você dita o valor exato de cada pessoa.</div>
              </div>
            </div>
            <div class="op-step-item">
              <div class="op-step-item__index">3</div>
              <div>
                <div class="op-step-item__title">Escolha se envia agora ou depois</div>
                <div class="op-step-item__text">Pode cobrar na hora ou guardar na caixa de saída para disparar em lote por pessoa e por mês. O restante do app continua seguindo o mesmo combinado.</div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </aside>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('txn-alloc-form');
    if (!form) return;

    const amountCents = Number(form.dataset.txnAmountCents || 0);
    const isClosed = form.dataset.isClosed === '1';
    const people = <%- JSON.stringify((people || []).map(p => ({ id: Number(p.id), name: p.name, is_self: !!p.is_self, is_owner: !!p.is_owner, profile_kind: p.profile_kind || '' }))).replace(/</g, '\\u003c') %>;
    const selectedIdsSeed = <%- JSON.stringify((selected || []).map(Number)).replace(/</g, '\\u003c') %>;
    const selectedSharesSeed = <%- JSON.stringify(selectedShares || {}).replace(/</g, '\\u003c') %>;

    const currencyFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    const splitModeShell = form.querySelector('[data-split-mode-shell]');
    const exactShell = form.querySelector('[data-exact-split-shell]');
    const exactFields = form.querySelector('[data-exact-fields]');
    const exactSummary = form.querySelector('[data-exact-summary]');
    const errorBox = form.querySelector('[data-split-error]');
    const modeInputs = Array.from(form.querySelectorAll('[data-split-mode-input]'));
    const saveButtons = Array.from(document.querySelectorAll('[data-txn-save-button]'));
    const deliveryModeInput = form.querySelector('[data-delivery-mode-input]');
    const deliveryModeButtons = Array.from(document.querySelectorAll('[data-delivery-mode-button]'));
    const draftShares = {};

    function formatMoney(cents) {
      return currencyFormatter.format((Number(cents || 0)) / 100);
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getSelectedIds() {
      return Array.from(form.querySelectorAll('[data-person-checkbox]:checked'))
        .map(input => Number(input.value))
        .filter(Number.isInteger);
    }

    function buildEqualShareMap(totalCents, personIds) {
      const ids = Array.from(new Set((personIds || []).map(Number).filter(Number.isInteger)));
      const shareMap = {};
      if (!ids.length) return shareMap;
      const share = Math.floor(Number(totalCents || 0) / ids.length);
      const remainder = Number(totalCents || 0) - (share * ids.length);
      ids.forEach((personId, index) => {
        const extra = index < Math.abs(remainder) ? Math.sign(remainder) : 0;
        shareMap[personId] = share + extra;
      });
      return shareMap;
    }

    function getSplitMode() {
      const active = modeInputs.find(input => input.checked);
      return active ? String(active.value || '') : '';
    }

    function bindMoneyMask(input) {
      if (!(input instanceof HTMLInputElement)) return;
      if (window.OPMoneyMask && typeof window.OPMoneyMask.bind === 'function') {
        window.OPMoneyMask.bind(input);
        return;
      }
      input.setAttribute('inputmode', 'numeric');
    }

    function inputValueToCents(input) {
      if (window.OPMoneyMask && typeof window.OPMoneyMask.toCents === 'function') {
        return window.OPMoneyMask.toCents(input.value);
      }
      return Number(String(input.value || '').replace(/\D/g, '')) || 0;
    }

    function formatInputFromCents(cents) {
      if (window.OPMoneyMask && typeof window.OPMoneyMask.formatFromCents === 'function') {
        return window.OPMoneyMask.formatFromCents(cents);
      }
      return formatMoney(cents);
    }

    function showError(message) {
      if (!errorBox) return;
      if (!message) {
        errorBox.hidden = true;
        errorBox.textContent = '';
        return;
      }
      errorBox.hidden = false;
      errorBox.textContent = message;
    }

    function renderExactSummary() {
      if (!exactSummary) return;
      const selectedIds = getSelectedIds();
      const typedTotal = selectedIds.reduce((sum, personId) => sum + Number(draftShares[personId] || 0), 0);
      const diff = amountCents - typedTotal;
      let toneClass = 'text-emerald-700 dark:text-emerald-300';
      let helperText = 'Fechou certinho. Agora é só salvar.';
      if (diff > 0) {
        toneClass = 'text-amber-700 dark:text-amber-300';
        helperText = `Ainda falta ${formatMoney(diff)} para bater com o total.`;
      } else if (diff < 0) {
        toneClass = 'text-red-700 dark:text-red-300';
        helperText = `Passou ${formatMoney(Math.abs(diff))}. Dá uma aparada e tenta de novo.`;
      }
      exactSummary.innerHTML = `
        <div class=\"flex flex-wrap items-center justify-between gap-3\">
          <div>
            <div class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500\">Resumo da divisão</div>
            <div class=\"mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300\">Compra: ${escapeHtml(formatMoney(amountCents))}</div>
          </div>
          <div class=\"text-right\">
            <div class=\"text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500\">Somando agora</div>
            <div class=\"mt-1 text-lg font-black text-slate-900 dark:text-slate-100\">${escapeHtml(formatMoney(typedTotal))}</div>
          </div>
        </div>
        <div class=\"mt-3 text-sm font-bold ${toneClass}\">${escapeHtml(helperText)}</div>
      `;
    }

    function renderExactFields() {
      if (!exactFields) return;
      exactFields.innerHTML = '';
      const selectedIds = getSelectedIds();
      const defaultShareMap = buildEqualShareMap(amountCents, selectedIds);

      selectedIds.forEach((personId) => {
        const person = people.find(entry => Number(entry.id) === Number(personId));
        if (!person) return;
        if (draftShares[personId] === undefined) draftShares[personId] = Number(defaultShareMap[personId] || 0);

        const row = document.createElement('label');
        row.className = 'rounded-[20px] border border-white/80 bg-white/90 px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-900/70';

        const header = document.createElement('div');
        header.className = 'mb-2 flex items-center justify-between gap-3';
        const isSelfPerson = person.is_self || String(person.profile_kind || '').toLowerCase() === 'self' || person.is_owner;
        const personTitle = isSelfPerson ? 'Minha parte' : person.name;
        const personHint = isSelfPerson ? 'Minha parte' : 'Digite a parte dessa pessoa';
        header.innerHTML = `<span class=\"text-sm font-black text-slate-900 dark:text-slate-100\">${escapeHtml(personTitle)}</span><span class=\"text-xs font-semibold text-slate-500 dark:text-slate-400\">${escapeHtml(personHint)}</span>`;
        row.appendChild(header);

        const input = document.createElement('input');
        input.type = 'text';
        input.name = `share_amounts[${personId}]`;
        input.placeholder = '0,00';
        input.value = formatInputFromCents(draftShares[personId]);
        input.disabled = isClosed;
        input.className = 'w-full rounded-2xl border border-violet-200 bg-white px-4 py-3 text-sm font-bold text-slate-900 shadow-sm focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-100 dark:border-violet-900/70 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-violet-500 dark:focus:ring-violet-500/20';
        input.setAttribute('data-money-mask', '1');
        bindMoneyMask(input);
        input.addEventListener('input', () => {
          draftShares[personId] = inputValueToCents(input);
          renderExactSummary();
          showError('');
        });
        row.appendChild(input);
        exactFields.appendChild(row);
      });
    }

    function syncSaveButtons() {
      const requiresModeChoice = !isClosed && amountCents >= 0 && getSelectedIds().length > 1;
      const shouldDisable = requiresModeChoice && !getSplitMode();
      saveButtons.forEach((button) => {
        button.disabled = shouldDisable;
        button.setAttribute('aria-disabled', shouldDisable ? 'true' : 'false');
      });
    }

    function syncUi() {
      const selectedIds = getSelectedIds();
      const canChooseMode = selectedIds.length > 1 && amountCents >= 0;
      if (splitModeShell) splitModeShell.hidden = !canChooseMode;

      if (!canChooseMode) {
        if (exactShell) exactShell.hidden = true;
        showError('');
        syncSaveButtons();
        return;
      }

      const wantsExact = getSplitMode() === 'exact';
      if (exactShell) exactShell.hidden = !wantsExact;
      if (wantsExact) {
        renderExactFields();
        renderExactSummary();
      } else {
        showError('');
      }
      syncSaveButtons();
    }

    selectedIdsSeed.forEach((personId) => {
      if (Object.prototype.hasOwnProperty.call(selectedSharesSeed || {}, personId) || Object.prototype.hasOwnProperty.call(selectedSharesSeed || {}, String(personId))) {
        draftShares[personId] = Number(selectedSharesSeed[personId] ?? selectedSharesSeed[String(personId)] ?? 0);
      }
    });

    form.querySelectorAll('[data-person-checkbox]').forEach((input) => {
      input.addEventListener('change', syncUi);
    });
    modeInputs.forEach((input) => {
      input.addEventListener('change', syncUi);
    });
    deliveryModeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (deliveryModeInput) deliveryModeInput.value = button.getAttribute('data-delivery-mode') || 'send_now';
      });
    });

    syncUi();


    const editModal = document.getElementById('txn-edit-modal');
    const editForm = document.getElementById('txn-edit-form');
    const editFeedback = document.getElementById('txn-edit-feedback');
    const editInsights = document.getElementById('txn-edit-insights');
    const editSummary = document.getElementById('txn-edit-summary');
    const editOpenButtons = Array.from(document.querySelectorAll('[data-edit-txn-open]'));
    const editCloseButtons = Array.from(document.querySelectorAll('[data-edit-txn-close]'));
    const editBackdrop = editModal ? editModal.querySelector('[data-edit-modal-backdrop]') : null;
    const editTxnSeed = <%- JSON.stringify({
      id: Number(txn.id || 0),
      txn_date: txn.txn_date || '',
      description: txn.description || '',
      amount_cents: Number(txn.amount_cents || 0),
      card_id: Number(txn.card_id || 0),
      card_name: txn.card_name || '',
      month: Number(txn.month || 0),
      year: Number(txn.year || 0),
      purchase_category_id: Number(txn.purchase_category_id || 0),
      recurring_rule_id: Number(txn.recurring_rule_id || 0),
      import_id: Number(txn.import_id || 0),
      has_future_installments: <%= hasFutureInstallments ? 'true' : 'false' %>,
      selected_ids: (selected || []).map(Number),
      selected_shares: selectedShares || {}
    }).replace(/</g, '\u003c') %>;

    function bindMoneyMask(input) {
      if (!(input instanceof HTMLInputElement)) return;
      if (window.OPMoneyMask && typeof window.OPMoneyMask.bind === 'function') {
        window.OPMoneyMask.bind(input);
      }
    }

    function formatMonthLabel(month, year) {
      const date = new Date(Number(year || 0), Math.max(Number(month || 1) - 1, 0), 1);
      return date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
    }

    function buildImpactPanel({ tone = 'info', title = '', body = '' } = {}) {
      const palette = {
        info: 'border-sky-200 bg-sky-50 text-sky-900 dark:border-sky-800 dark:bg-sky-900/20 dark:text-sky-100',
        warning: 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-100',
        success: 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-100'
      };
      const panel = document.createElement('div');
      panel.className = `rounded-[22px] border px-4 py-3 text-sm ${palette[tone] || palette.info}`;
      panel.innerHTML = `<div class="text-sm font-black">${escapeHtml(title)}</div><p class="mt-1 leading-6 opacity-90">${escapeHtml(body)}</p>`;
      return panel;
    }

    function inferEditSplitMode(item) {
      const ids = Array.isArray(item?.selected_ids) ? item.selected_ids.map((value) => Number(value || 0)).filter(Boolean) : [];
      if (ids.length <= 1) return ids.length ? 'single' : 'none';
      const shares = item?.selected_shares && typeof item.selected_shares === 'object' ? item.selected_shares : {};
      const amount = Number(item?.amount_cents || 0);
      const values = ids.map((personId) => Number(shares[personId] || shares[String(personId)] || 0));
      if (values.reduce((sum, value) => sum + value, 0) !== amount) return 'exact';
      const base = Math.floor(amount / ids.length);
      let remainder = amount - (base * ids.length);
      const expected = ids.map(() => {
        const next = base + (remainder > 0 ? 1 : 0);
        if (remainder > 0) remainder -= 1;
        return next;
      });
      return expected.every((value, index) => value === values[index]) ? 'equal' : 'exact';
    }

    function syncEditSummary() {
      if (!(editSummary instanceof HTMLElement) || !(editForm instanceof HTMLFormElement)) return;
      const currentType = editTxnSeed.recurring_rule_id ? 'Recorrente' : (editTxnSeed.has_future_installments ? 'Parcelada' : 'Única');
      editSummary.innerHTML = `<div class="flex flex-wrap items-center gap-2"><span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-black uppercase tracking-[0.18em] text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-200">Edição segura</span><span class="inline-flex items-center rounded-full bg-slate-900/5 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-600 dark:bg-slate-100/10 dark:text-slate-300">${escapeHtml(currentType)}</span></div><div class="mt-2 text-sm font-black text-slate-900 dark:text-slate-100">${escapeHtml(formatMoney(editTxnSeed.amount_cents))} · ${escapeHtml(formatMonthLabel(editTxnSeed.month, editTxnSeed.year))}</div><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">Cartão atual: ${escapeHtml(editTxnSeed.card_name || 'Sem cartão')}</p>`;
    }

    function refreshEditInsights() {
      if (!(editInsights instanceof HTMLElement) || !(editForm instanceof HTMLFormElement)) return;
      const amountInput = editForm.querySelector('input[name="amount"]');
      const dateInput = editForm.querySelector('input[name="date"]');
      const firstDueInput = editForm.querySelector('input[name="first_due"]');
      const descriptionInput = editForm.querySelector('input[name="description"]');
      const cardSelect = editForm.querySelector('select[name="card_id"]');
      editInsights.innerHTML = '';

      if (editTxnSeed.recurring_rule_id) {
        editInsights.appendChild(buildImpactPanel({ tone: 'info', title: 'Compra recorrente', body: 'Se você aplicar no futuro, a compra atual, as futuras já materializadas e a regra da recorrência andam juntas.' }));
      } else if (editTxnSeed.has_future_installments) {
        editInsights.appendChild(buildImpactPanel({ tone: 'info', title: 'Compra parcelada', body: 'Se você aplicar no futuro, a parcela atual e as próximas acompanham a mudança sem perder a ordem.' }));
      } else {
        editInsights.appendChild(buildImpactPanel({ tone: 'success', title: 'Compra única', body: 'Aqui a edição vale só para esta compra. Ajustou, salvou e partiu.' }));
      }

      const splitMode = inferEditSplitMode(editTxnSeed);
      if (splitMode === 'equal') {
        editInsights.appendChild(buildImpactPanel({ tone: 'success', title: 'Divisão em partes iguais detectada', body: 'Se o valor mudar, o app recalcula as partes automaticamente para manter tudo redondinho.' }));
      } else if (splitMode === 'exact') {
        editInsights.appendChild(buildImpactPanel({ tone: 'warning', title: 'Divisão com valores definidos', body: 'Se o valor mudar, o app pode travar o salvamento até a divisão ser revisada. Melhor evitar surpresa no acerto.' }));
      }

      const originalDue = `${String(editTxnSeed.year || 0).padStart(4, '0')}-${String(editTxnSeed.month || 0).padStart(2, '0')}`;
      if (descriptionInput instanceof HTMLInputElement && editTxnSeed.has_future_installments && descriptionInput.value.trim() !== String(editTxnSeed.description || '').trim()) {
        editInsights.appendChild(buildImpactPanel({ tone: 'info', title: 'Nome das parcelas continua organizado', body: 'Ao aplicar no futuro, o novo nome-base vai junto e o contador das parcelas continua em ordem.' }));
      }
      if (firstDueInput instanceof HTMLInputElement && /^\d{4}-\d{2}$/.test(firstDueInput.value) && firstDueInput.value !== originalDue) {
        editInsights.appendChild(buildImpactPanel({ tone: 'warning', title: 'Fatura de destino alterada', body: editTxnSeed.recurring_rule_id ? 'A base da recorrência passa a olhar para a nova fatura escolhida.' : 'Se você aplicar no futuro, as próximas parcelas reencaixam nessa fatura também.' }));
      }
      if (cardSelect instanceof HTMLSelectElement && Number(cardSelect.value || 0) !== Number(editTxnSeed.card_id || 0)) {
        editInsights.appendChild(buildImpactPanel({ tone: 'warning', title: 'Cartão novo na jogada', body: 'Trocar o cartão também mexe na fatura de destino e respeita bloqueios de mês fechado.' }));
      }
      if (dateInput instanceof HTMLInputElement && dateInput.value && dateInput.value !== String(editTxnSeed.txn_date || '')) {
        editInsights.appendChild(buildImpactPanel({ tone: 'info', title: 'Data da compra mudou', body: 'O app recalcula a sugestão de fatura com base no cartão escolhido. Se você travar a fatura manualmente, a gente respeita.' }));
      }
      if (amountInput instanceof HTMLInputElement && amountInput.value && amountInput.value !== formatInputFromCents(editTxnSeed.amount_cents)) {
        editInsights.appendChild(buildImpactPanel({ tone: splitMode === 'exact' ? 'warning' : 'info', title: 'Valor alterado', body: splitMode === 'exact' ? 'Esse é o ponto mais sensível porque a divisão já foi desenhada no detalhe.' : 'Se não houver trava de liquidação ou mês fechado, o valor novo segue normalmente.' }));
      }
    }

    function setEditFeedback(message, tone = 'error') {
      if (!(editFeedback instanceof HTMLElement)) return;
      if (!message) {
        editFeedback.className = 'hidden rounded-[22px] border px-4 py-3 text-sm font-semibold';
        editFeedback.textContent = '';
        return;
      }
      const palette = {
        error: 'border-red-200 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200',
        success: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200',
        warning: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-900/20 dark:text-amber-200'
      };
      editFeedback.className = `rounded-[22px] border px-4 py-3 text-sm font-semibold ${palette[tone] || palette.error}`;
      editFeedback.textContent = message;
    }

    function openEditModal() {
      if (!(editModal instanceof HTMLElement)) return;
      editModal.classList.remove('hidden');
      editModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      syncEditSummary();
      refreshEditInsights();
      if (window.OPInitPurchaseCategoryControls) {
        const shell = editForm?.querySelector('[data-purchase-category-control]');
        if (shell) window.OPInitPurchaseCategoryControls(shell);
      }
      const amountInput = editForm?.querySelector('input[name="amount"]');
      if (amountInput instanceof HTMLInputElement) bindMoneyMask(amountInput);
      setEditFeedback('');
    }

    function closeEditModal() {
      if (!(editModal instanceof HTMLElement)) return;
      editModal.classList.add('hidden');
      editModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      setEditFeedback('');
    }

    if (editForm instanceof HTMLFormElement) {
      const amountInput = editForm.querySelector('input[name="amount"]');
      const dateInput = editForm.querySelector('input[name="date"]');
      const firstDueInput = editForm.querySelector('input[name="first_due"]');
      const descriptionInput = editForm.querySelector('input[name="description"]');
      const cardSelect = editForm.querySelector('select[name="card_id"]');
      const syncSuggestedDue = () => {
        if (!(dateInput instanceof HTMLInputElement) || !(firstDueInput instanceof HTMLInputElement) || !(cardSelect instanceof HTMLSelectElement)) return;
        const selectedOption = cardSelect.options[cardSelect.selectedIndex];
        const suggested = (window.OPComputeSuggestedFirstDue || (() => ''))(dateInput.value, selectedOption?.dataset.closeDay || '', selectedOption?.dataset.dueDay || '');
        if (suggested && !firstDueInput.dataset.touched) firstDueInput.value = suggested;
      };
      [amountInput, dateInput, firstDueInput, descriptionInput, cardSelect].forEach((field) => {
        if (!field) return;
        field.addEventListener('input', refreshEditInsights);
        field.addEventListener('change', () => {
          if (field === dateInput || field === cardSelect) syncSuggestedDue();
          if (field === firstDueInput) firstDueInput.dataset.touched = '1';
          refreshEditInsights();
        });
      });
      bindMoneyMask(amountInput);
      syncSuggestedDue();
      editForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        setEditFeedback('');
        const descriptionField = editForm.querySelector('input[name="description"]');
        if (descriptionField instanceof HTMLInputElement && !descriptionField.value.trim()) {
          setEditFeedback('A descrição da compra não pode ficar em branco.', 'warning');
          descriptionField.focus();
          return;
        }
        let scope = 'single';
        if (String(editForm.dataset.hasFutureInstallments || '') === '1') {
          scope = await window.resolveInstallmentScope(editForm, { actionLabel: 'salvar essa edição' });
          if (!scope) return;
        }
        const payload = new URLSearchParams(new FormData(editForm));
        payload.set('apply_scope', scope);
        const submitButton = document.querySelector('[data-edit-txn-submit]');
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
        try {
          const response = await fetch(`/txn/${editTxnSeed.id}/edit`, {
            method: 'POST',
            body: payload.toString(),
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
              'X-Requested-With': 'XMLHttpRequest',
              'X-AcerttaPay-Async': '1'
            }
          });
          const data = await response.json().catch(() => null);
          if (!response.ok || !data || data.ok === false) throw new Error((data && (data.error || data.message)) || 'Não consegui salvar essa edição agora.');
          setEditFeedback(data.message || 'Compra atualizada com sucesso.', 'success');
          window.setTimeout(() => { window.location.href = `/txn/${editTxnSeed.id}`; }, 280);
        } catch (error) {
          console.error(error);
          setEditFeedback(error.message || 'Não consegui salvar essa edição agora.', 'error');
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    }

    editOpenButtons.forEach((button) => button.addEventListener('click', openEditModal));
    editCloseButtons.forEach((button) => button.addEventListener('click', closeEditModal));
    if (editBackdrop instanceof HTMLElement) editBackdrop.addEventListener('click', closeEditModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && editModal instanceof HTMLElement && !editModal.classList.contains('hidden')) {
        closeEditModal();
      }
    });
    if (!isClosed) {
      form.addEventListener('submit', (event) => {
        const selectedIds = getSelectedIds();
        const needsModeChoice = amountCents >= 0 && selectedIds.length > 1;
        if (needsModeChoice && !getSplitMode()) {
          event.preventDefault();
          showError('Escolha como a compra será dividida antes de salvar.');
          syncSaveButtons();
          return;
        }
        if (selectedIds.length > 1 && getSplitMode() === 'exact') {
          const typedTotal = selectedIds.reduce((sum, personId) => sum + Number(draftShares[personId] || 0), 0);
          if (typedTotal !== amountCents) {
            event.preventDefault();
            renderExactSummary();
            showError('Os valores definidos ainda não fecharam com o total da compra.');
          }
        }
      });
    }
  });
</script>

<%- include("partials/footer") %>
