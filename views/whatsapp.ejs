<%- include("partials/header", { title: "Exportar Resumo" }) %>
<%
  const periodLabel = `${String(month).padStart(2, '0')}/${year}`;
  const getItemCents = (item) => {
    if (item && item.amount_cents !== undefined && item.amount_cents !== null && item.amount_cents !== '') return Number(item.amount_cents) || 0;
    if (item && item.amount !== undefined && item.amount !== null && item.amount !== '') return Math.round(Number(item.amount) * 100) || 0;
    if (item && item.share_cents !== undefined && item.share_cents !== null && item.share_cents !== '') return Number(item.share_cents) || 0;
    return 0;
  };
  const formatBRL = (cents) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format((Number(cents) || 0) / 100);
  const getDescription = (item) => (item && (item.description || item.title || item.name || item.label)) || 'Lançamento';
  const itemDate = (item) => {
    const raw = (item && (item.txn_date || item.date || item.purchase_date || item.created_at || item.imported_at)) || '';
    if (!raw) return '';
    const str = String(raw);
    const m = str.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return `${m[3]}/${m[2]}/${m[1]}`;
    return str;
  };
  const totalCents = items.reduce((acc, item) => acc + getItemCents(item), 0);
  const remainingCents = Number(remaining_cents || 0);
  const paidCents = Number(paid_cents || 0);
  const effectiveTotalCents = remainingCents > 0 ? remainingCents : totalCents;
  const summaryMode = false;
  const compactMode = items.length > 10;
  const visibleItems = items;
  const hiddenItems = [];
  const hiddenTotalCents = 0;
  const captureScale = items.length > 36 ? 1 : items.length > 24 ? 1.15 : items.length > 16 ? 1.3 : items.length > 10 ? 1.55 : 2;
  const metricPills = [
    { label: 'Itens', value: `${items.length}` },
    { label: 'Em aberto', value: formatBRL(effectiveTotalCents) },
    { label: paidCents > 0 ? 'Já pago' : 'Status', value: paidCents > 0 ? formatBRL(paidCents) : 'Sem baixa' }
  ];
%>

<div class="op-page-shell">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Envio assistido</span>
      <h1 class="op-page-hero__title mt-4">Exportar Resumo</h1>
      <p class="op-page-hero__subtitle mt-3">Use a mesma imagem otimizada para o mobile tanto no WhatsApp quanto no download manual, mantendo todos os itens do período visíveis na imagem.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= person.name %></span>
        <span class="badge">Ref. <%= periodLabel %></span>
        <span class="badge"><%= items.length %> item(ns)</span>
        <% if (person.phone) { %><span class="badge">Número disponível</span><% } else { %><span class="badge">Sem número cadastrado</span><% } %>
      </div>
    </div>
    <div class="op-page-hero__actions">
      <a href="/summary/<%= year %>/<%= month %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Voltar
      </a>
      <button id="btnPng" type="button" data-loading-label="Gerando PNG..." class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Baixar PNG
      </button>
      <% if (person.phone) { %>
        <button id="btnEvolution" type="button" data-loading-label="Enviando via WhatsApp..." class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/20 transition-all hover:-translate-y-0.5 hover:bg-blue-700">
          <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
          WhatsApp
        </button>
      <% } %>
    </div>
  </section>

  <% if (!person.phone) { %>
    <div class="op-inline-alert op-inline-alert--warning op-fade-up">
      <div class="op-inline-alert__icon">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.29 3.86l-8 14A1 1 0 003.17 19h17.66a1 1 0 00.88-1.5l-8-14a1 1 0 00-1.74 0z"></path></svg>
      </div>
      <div>
        <div class="op-inline-alert__title">Número ausente para envio automático</div>
        <div class="op-inline-alert__text">O download da imagem continua disponível. Para liberar o envio pelo WhatsApp, preencha um telefone válido em Pessoas.</div>
      </div>
    </div>
  <% } %>

  <div class="op-preview-shell op-fade-up">
    <div class="op-preview-shell__label">Prévia do cartão compartilhável</div>
    <div class="flex justify-center pb-2">
      <%- include('partials/share-summary-card', {
        cardId: 'cardPreview',
        person,
        periodLabel,
        items,
        visibleItems,
        hiddenItems,
        hiddenTotalCents,
        compactMode,
        summaryMode,
        formatBRL,
        getItemCents,
        getDescription,
        itemDate,
        totalCents: effectiveTotalCents,
        exportMode: false,
        captureScale,
        metricPills,
        compactHint: compactMode ? 'Layout mais compacto para manter todos os itens legíveis em telas menores e mensageiros, sem resumir nenhuma informação.' : 'A imagem mantém todos os itens visíveis sem compactação.',
        footerLeft: 'Gerado pelo OrganizaPay · compatível com envio automático via WhatsApp',
        footerRight: 'Imagem pronta para envio',
        totalLabel: remainingCents > 0 ? 'Total em aberto' : 'Total do período',
        heroText: remainingCents > 0 ? 'Resumo financeiro pensado para leitura rápida no celular, destacando o valor ainda em aberto e mantendo todos os itens do período visíveis.' : 'Resumo financeiro pronto para envio, com todos os itens do período e total sempre visíveis.'
      }) %>
    </div>
  </div>
</div>

<div aria-hidden="true" style="position:fixed; left:-99999px; top:0; pointer-events:none; opacity:0;">
  <%- include('partials/share-summary-card', {
    cardId: 'cardExport',
    person,
    periodLabel,
    items,
    visibleItems,
    hiddenItems,
    hiddenTotalCents,
    compactMode,
    summaryMode,
    formatBRL,
    getItemCents,
    getDescription,
    itemDate,
    totalCents: effectiveTotalCents,
    exportMode: true,
    captureScale,
    metricPills,
    compactHint: compactMode ? 'Layout mais compacto para manter todos os itens legíveis em telas menores e mensageiros, sem resumir nenhuma informação.' : 'A imagem mantém todos os itens visíveis sem compactação.',
    footerLeft: 'Gerado pelo OrganizaPay · compatível com envio automático via WhatsApp',
    footerRight: 'Imagem pronta para envio',
    totalLabel: remainingCents > 0 ? 'Total em aberto' : 'Total do período',
    heroText: remainingCents > 0 ? 'Resumo financeiro pensado para leitura rápida no celular, destacando o valor ainda em aberto e mantendo todos os itens do período visíveis.' : 'Resumo financeiro pronto para envio, com todos os itens do período e total sempre visíveis.'
  }) %>
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
  function setBusy(button, loadingLabel) {
    if (!button) return () => {};
    const original = button.innerHTML;
    button.disabled = true;
    button.classList.add('op-button-loading');
    button.innerHTML = `<span class="op-submit-spinner" aria-hidden="true"></span><span>${loadingLabel}</span>`;
    return () => {
      button.disabled = false;
      button.classList.remove('op-button-loading');
      button.innerHTML = original;
    };
  }

  function ensureHtml2CanvasAvailable() {
    if (typeof window.html2canvas !== 'function') {
      throw new Error('A biblioteca de geração da imagem não foi carregada. Recarregue a página e tente novamente.');
    }
  }

  function getCaptureSourceNode() {
    return document.getElementById('cardPreview') || document.getElementById('cardExport');
  }

  function waitForPaint() {
    return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
  }

  async function buildReceiptCanvas() {
    ensureHtml2CanvasAvailable();
    const sourceNode = getCaptureSourceNode();
    if (!sourceNode) throw new Error('Resumo não encontrado para captura.');

    await waitForPaint();

    const rect = sourceNode.getBoundingClientRect();
    const baseWidth = Math.max(Math.ceil(rect.width || 0), sourceNode.scrollWidth || 0, sourceNode.offsetWidth || 0, 704);

    const stage = document.createElement('div');
    stage.setAttribute('data-capture-stage', 'true');
    stage.style.position = 'fixed';
    stage.style.left = '0';
    stage.style.top = '0';
    stage.style.zIndex = '-1';
    stage.style.pointerEvents = 'none';
    stage.style.opacity = '1';
    stage.style.background = '#ffffff';
    stage.style.padding = '0';
    stage.style.margin = '0';
    stage.style.width = `${baseWidth}px`;

    const clone = sourceNode.cloneNode(true);
    clone.id = `${sourceNode.id || 'whatsapp-card'}-capture`;
    clone.style.width = `${baseWidth}px`;
    clone.style.maxWidth = `${baseWidth}px`;
    clone.style.margin = '0';
    clone.style.transform = 'none';

    stage.appendChild(clone);
    document.body.appendChild(stage);

    try {
      await waitForPaint();
      const cloneRect = clone.getBoundingClientRect();
      const width = Math.max(Math.ceil(cloneRect.width || 0), clone.scrollWidth || 0, clone.offsetWidth || 0, baseWidth);
      const height = Math.max(Math.ceil(cloneRect.height || 0), clone.scrollHeight || 0, clone.offsetHeight || 0);

      console.info('[whatsapp] capture dimensions', { width, height, baseWidth });

      if (!width || !height) {
        throw new Error(`Não foi possível medir a área do recibo para captura (${width}x${height}).`);
      }

      const canvas = await html2canvas(clone, {
        scale: Number((sourceNode.dataset && sourceNode.dataset.captureScale) || 2),
        backgroundColor: '#ffffff',
        useCORS: true,
        width,
        height,
        windowWidth: width + 40,
        windowHeight: height + 40,
        scrollX: 0,
        scrollY: 0
      });

      if (!canvas || !canvas.width || !canvas.height) {
        throw new Error('A captura foi gerada sem conteúdo útil.');
      }

      return canvas;
    } finally {
      stage.remove();
    }
  }

  function canvasToBlob(canvas) {
    return new Promise((resolve, reject) => {
      if (canvas.toBlob) {
        canvas.toBlob((blob) => {
          if (blob && blob.size > 0) {
            console.info('[whatsapp] blob generated', { size: blob.size, type: blob.type || 'image/png' });
            resolve(blob);
            return;
          }

          try {
            const dataUrl = canvas.toDataURL('image/png');
            const base64 = String(dataUrl).split(',')[1] || '';
            if (!base64) {
              reject(new Error('A imagem foi gerada vazia.'));
              return;
            }
            const binary = atob(base64);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
            const blobFromDataUrl = new Blob([bytes], { type: 'image/png' });
            console.info('[whatsapp] fallback blob generated', { size: blobFromDataUrl.size, type: blobFromDataUrl.type });
            resolve(blobFromDataUrl);
          } catch (error) {
            reject(error);
          }
        }, 'image/png');
        return;
      }

      try {
        const dataUrl = canvas.toDataURL('image/png');
        const base64 = String(dataUrl).split(',')[1] || '';
        if (!base64) {
          reject(new Error('A imagem foi gerada vazia.'));
          return;
        }
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
        resolve(new Blob([bytes], { type: 'image/png' }));
      } catch (error) {
        reject(error);
      }
    });
  }

  function blobToDataUrl(blob) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(reader.error || new Error('Não foi possível ler a imagem gerada.'));
      reader.readAsDataURL(blob);
    });
  }

  async function downloadReceipt() {
    const restore = setBusy(document.getElementById('btnPng'), 'Gerando PNG...');
    try {
      const canvas = await buildReceiptCanvas();
      const blob = await canvasToBlob(canvas);
      const link = document.createElement('a');
      link.download = `Fatura_<%= person.name.replace(/\s+/g,'_') %>_<%= String(month).padStart(2,'0') %>_<%= year %>.png`;
      const url = URL.createObjectURL(blob);
      link.href = url;
      link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1500);
    } finally {
      restore();
    }
  }

  async function sendViaEvolution() {
    const button = document.getElementById('btnEvolution');
    const restore = setBusy(button, 'Enviando via WhatsApp...');
    try {
      const canvas = await buildReceiptCanvas();
      const blob = await canvasToBlob(canvas);
      const imageBase64 = await blobToDataUrl(blob);
      const totalLabel = '<%= formatBRL(effectiveTotalCents) %>';
      const message = [
        `*Olá, <%= person.name %>!* 💳`,
        '',
        `Segue o fechamento da fatura de *<%= periodLabel %>*.`,
        `Total a pagar: *${totalLabel}*.`,
        ''
      ].filter(Boolean).join('\n');

      const response = await fetch('/whatsapp/send-automation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          personPhone: '<%= person.phone || "" %>',
          message,
          imageBase64
        })
      });

      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Falha na API de envio.');
      }

      alert('Resumo enviado com imagem com sucesso.');
    } catch (error) {
      console.error('[whatsapp] send failure', error);
      alert(error && error.message ? error.message : 'Não foi possível enviar a imagem pelo WhatsApp agora.');
    } finally {
      restore();
    }
  }

  document.getElementById('btnPng')?.addEventListener('click', downloadReceipt);
  document.getElementById('btnEvolution')?.addEventListener('click', sendViaEvolution);
</script>

<%- include("partials/footer") %>
