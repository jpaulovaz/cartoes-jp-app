<%- include("partials/header", { title: `WhatsApp ${person.name}` }) %>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-semibold">WhatsApp — <%= person.name %> • <%= String(month).padStart(2,'0') %>/<%= year %></h1>
  <div class="flex gap-2">
    <a class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50" href="/summary/<%= year %>/<%= month %>">Voltar</a>
    <button id="btnPng" class="px-4 py-2 rounded-xl bg-slate-900 text-white">Baixar imagem (PNG)</button>
  </div>
</div>

<div id="card" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
  <div class="flex items-start justify-between">
    <div>
      <div class="text-sm text-slate-600">Consolidado do mês</div>
      <div class="text-2xl font-semibold"><%= person.name %></div>
      <div class="text-sm text-slate-600"><%= String(month).padStart(2,'0') %>/<%= year %></div>
    </div>
    <div class="text-right">
      <div class="text-sm text-slate-600">Total</div>
      <div class="text-2xl font-semibold"><%= formatBRLFromCents(total) %></div>
    </div>
  </div>

  <div class="mt-4 grid md:grid-cols-3 gap-2">
    <% totalsByCard.forEach(t => { %>
      <div class="border border-slate-200 rounded-xl p-3">
        <div class="text-sm text-slate-600"><%= t.card_name %></div>
        <div class="text-lg font-semibold"><%= formatBRLFromCents(t.total_cents) %></div>
      </div>
    <% }) %>
  </div>

  <h2 class="font-semibold mt-6 mb-2">Itens</h2>
  <div class="border border-slate-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="text-left px-3 py-2">Data</th>
          <th class="text-left px-3 py-2">Descrição</th>
          <th class="text-left px-3 py-2">Cartão</th>
          <th class="text-right px-3 py-2">Parcela</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(it => { %>
          <tr class="border-t border-slate-200">
            <td class="px-3 py-2 whitespace-nowrap"><%= it.txn_date || "-" %></td>
            <td class="px-3 py-2"><%= it.description %></td>
            <td class="px-3 py-2"><span class="badge"><%= it.card_name %></span></td>
            <td class="px-3 py-2 text-right"><%= formatBRLFromCents(it.share_cents) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="text-xs text-slate-500 mt-3">Gerado pelo Cartões JP (local).</div>
</div>

<script>
  document.getElementById("btnPng").addEventListener("click", async () => {
    const el = document.getElementById("card");
    const canvas = await html2canvas(el, { scale: 2, backgroundColor: "#ffffff" });
    const link = document.createElement("a");
    link.download = `whatsapp-<%= person.name.replace(/\s+/g,'_') %>-<%= String(month).padStart(2,'0') %>-<%= year %>.png`;
    link.href = canvas.toDataURL("image/png");
    link.click();
  });
</script>

<%- include("partials/footer") %>
