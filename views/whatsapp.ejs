<%- include("partials/header", { title: "Mandar resumo" }) %>
<%
  const periodLabel = `${String(month).padStart(2, '0')}/${year}`;
  const getItemCents = (item) => {
    if (item && item.amount_cents !== undefined && item.amount_cents !== null && item.amount_cents !== '') return Number(item.amount_cents) || 0;
    if (item && item.amount !== undefined && item.amount !== null && item.amount !== '') return Math.round(Number(item.amount) * 100) || 0;
    if (item && item.share_cents !== undefined && item.share_cents !== null && item.share_cents !== '') return Number(item.share_cents) || 0;
    return 0;
  };
  const formatBRL = (cents) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format((Number(cents) || 0) / 100);
  const getDescription = (item) => (item && (item.description || item.title || item.name || item.label)) || 'Compra';
  const itemDate = (item) => {
    const raw = (item && (item.txn_date || item.date || item.purchase_date || item.created_at || item.imported_at)) || '';
    if (!raw) return '';
    const str = String(raw);
    const m = str.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return `${m[3]}/${m[2]}/${m[1]}`;
    return str;
  };
  const totalCents = items.reduce((acc, item) => acc + getItemCents(item), 0);
  const selectedItemOrder = itemOrder === 'recent' ? 'recent' : 'oldest';
  const paidCents = Math.max(0, Number(paid_cents || 0) || 0);
  const rawRemainingCents = (remaining_cents ?? (totalCents - paidCents));
  const remainingCents = Math.max(0, Number(rawRemainingCents || 0) || 0);
  const visibleItems = items;
  const captureScale = items.length > 48 ? 1.85 : 2;
  const heroText = remainingCents > 0
    ? (paidCents > 0
        ? 'Confira abaixo as compras deste período, o valor já pago e o saldo que ainda falta para fechar tudo.'
        : 'Confira abaixo as compras deste período e o valor que ainda falta pagar.')
    : 'Confira abaixo as compras deste período e a confirmação de que o pagamento já foi concluído.';
  const whatsappCaptionText = (shareContext && shareContext.whatsappCaption) || `Resumo de ${periodLabel} pronto para conferência.`;
  const whatsappFollowUpText = (shareContext && shareContext.whatsappFollowUpMessage) || '';
  const whatsappCopyText = [whatsappCaptionText, whatsappFollowUpText].filter(Boolean).join('\n\n');
  const sharePixContext = shareContext && shareContext.pix ? shareContext.pix : null;
  const pixAvailable = !!(sharePixContext && sharePixContext.available);
  const copyTextButtonLabel = pixAvailable ? 'Copiar texto do WhatsApp + Pix' : 'Copiar texto do WhatsApp';
%>

<div class="op-page-shell">
  <section class="op-page-hero op-fade-up">
    <div>
      <span class="op-page-hero__eyebrow">Compartilhamento rápido</span>
      <h1 class="op-page-hero__title mt-4">Mandar resumo</h1>
      <p class="op-page-hero__subtitle mt-3">Monte uma imagem bonitinha e pronta para mandar para a pessoa certa.</p>
      <div class="op-page-hero__meta mt-4">
        <span class="badge"><%= person.name %></span>
        <span class="badge">Ref. <%= periodLabel %></span>
        <span class="badge"><%= items.length %> <%= items.length === 1 ? "item" : "itens" %></span>
      </div>
    </div>
    <div class="op-page-hero__actions">
      <a href="/summary/<%= year %>/<%= month %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Voltar
      </a>
      <button id="btnPng" type="button" data-loading-label="Gerando imagem..." class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700">
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Baixar imagem
      </button>
      <% if (person.phone) { %>
        <button id="btnEvolution" type="button" data-loading-label="Enviando no WhatsApp..." class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/20 transition-all hover:-translate-y-0.5 hover:bg-blue-700">
          <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
          Enviar no WhatsApp
        </button>
      <% } %>
    </div>
  </section>

  <div class="op-surface-card op-fade-up rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 mb-6">
    <form method="get" action="/whatsapp/<%= year %>/<%= month %>/<%= person.id %>" class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="w-full md:max-w-sm">
        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-1.5">Como ordenar os itens</label>
        <select name="order" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition-colors focus:bg-white focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:bg-slate-950">
          <option value="recent" <%= selectedItemOrder === 'recent' ? 'selected' : '' %>>Mais recentes primeiro</option>
          <option value="oldest" <%= selectedItemOrder === 'oldest' ? 'selected' : '' %>>Mais antigos primeiro</option>
        </select>
      </div>
      <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-900/15 transition-all hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white">
        Atualizar ordem
      </button>
    </form>
  </div>

  <div class="op-surface-card op-fade-up rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 mb-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-sky-600/70 dark:text-sky-300/80"><%= pixAvailable ? 'Pix no WhatsApp' : 'Texto do WhatsApp' %></div>
        <% if (pixAvailable) { %>
          <h2 class="mt-2 text-lg font-black tracking-[-0.03em] text-slate-900 dark:text-slate-100">A imagem vai primeiro, e o Pix segue na mensagem logo depois.</h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= sharePixContext.helperText %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if (sharePixContext.keyTypeLabel) { %><span class="badge"><%= sharePixContext.keyTypeLabel %></span><% } %>
            <% if (sharePixContext.maskedKey) { %><span class="badge"><%= sharePixContext.maskedKey %></span><% } %>
            <% if (sharePixContext.ownerName) { %><span class="badge">Pix de <%= sharePixContext.ownerName %></span><% } %>
          </div>
        <% } else { %>
          <h2 class="mt-2 text-lg font-black tracking-[-0.03em] text-slate-900 dark:text-slate-100"><%= shareContext && shareContext.state === 'settled' ? 'Aqui vai só o registro bonito mesmo.' : 'O WhatsApp segue prontinho, e o Pix entra assim que você deixar isso redondinho.' %></h2>
          <p class="mt-2 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300"><%= sharePixContext && sharePixContext.reason ? sharePixContext.reason : 'A mensagem continua organizada e a imagem segue igualzinha ao relatório que você já aprovou.' %></p>
        <% } %>
      </div>
      <div class="flex flex-wrap gap-3">
        <% if (pixAvailable) { %>
          <button id="btnCopyPix" type="button" class="inline-flex items-center justify-center rounded-2xl border border-blue-200 bg-blue-50 px-5 py-3 text-sm font-bold text-blue-700 transition-all hover:-translate-y-0.5 hover:bg-blue-100 dark:border-blue-900/50 dark:bg-blue-950/30 dark:text-blue-200 dark:hover:bg-blue-950/50">Copiar Pix</button>
        <% } %>
        <button id="btnCopyWhatsappText" type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:-translate-y-0.5 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800"><%= copyTextButtonLabel %></button>
      </div>
    </div>
  </div>

  <% if (!person.phone) { %>
    <div class="op-inline-alert op-inline-alert--warning op-fade-up">
      <div class="op-inline-alert__icon">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.29 3.86l-8 14A1 1 0 003.17 19h17.66a1 1 0 00.88-1.5l-8-14a1 1 0 00-1.74 0z"></path></svg>
      </div>
      <div>
        <div class="op-inline-alert__title">Faltou um telefone</div>
        <div class="op-inline-alert__text">O download da imagem continua disponível. Para liberar o envio pelo WhatsApp, preencha um telefone válido em Amigos.</div>
      </div>
    </div>
  <% } %>

  <div class="op-preview-shell op-fade-up">
    <div class="op-preview-shell__label">Prévia da imagem</div>
    <div class="flex justify-center pb-2">
      <%- include('partials/share-summary-card', {
        cardId: 'cardPreview',
        person,
        periodLabel,
        items,
        visibleItems,
        formatBRL,
        getItemCents,
        getDescription,
        itemDate,
        totalCents,
        paidCents,
        remainingCents,
        exportMode: false,
        captureScale,
        footerLeft: 'Feito no AcerttaPay',
        totalLabel: 'Total do período',
        paymentTitle: 'Situação do pagamento',
        heroText,
        sharePixContext
      }) %>
    </div>
  </div>
</div>

<div aria-hidden="true" style="position:fixed; left:-99999px; top:0; pointer-events:none; opacity:0;">
  <%- include('partials/share-summary-card', {
    cardId: 'cardExport',
    person,
    periodLabel,
    items,
    visibleItems,
    formatBRL,
    getItemCents,
    getDescription,
    itemDate,
    totalCents,
    paidCents,
    remainingCents,
    exportMode: true,
    captureScale,
    footerLeft: 'Feito no AcerttaPay',
    totalLabel: 'Total do período',
    paymentTitle: 'Situação do pagamento',
    heroText,
    sharePixContext
  }) %>
</div>

<script src="/vendor/html2canvas/html2canvas.min.js"></script>
<script>
  const whatsappCaptureState = {
    blobPromise: null,
    objectUrl: null
  };

  const CAPTURE_MAX_PIXELS = 24000000;
  const CAPTURE_MIN_SCALE = 1;
  const CAPTURE_MAX_SCALE = 2;
  const whatsappCaptionMessage = <%- JSON.stringify(whatsappCaptionText) %>;
  const whatsappFollowUpMessage = <%- JSON.stringify(whatsappFollowUpText) %>;
  const whatsappShareText = <%- JSON.stringify(whatsappCopyText) %>;
  const whatsappPixPayload = <%- JSON.stringify((sharePixContext && sharePixContext.available && sharePixContext.payload) || '') %>;

  function setBusy(button, loadingLabel) {
    if (!button) return () => {};
    const original = button.innerHTML;
    button.disabled = true;
    button.classList.add('op-button-loading');
    button.innerHTML = `<span class="op-submit-spinner" aria-hidden="true"></span><span>${loadingLabel}</span>`;
    return () => {
      button.disabled = false;
      button.classList.remove('op-button-loading');
      button.innerHTML = original;
    };
  }

  function normalizeCopyText(value) {
    return String(value || '').trim();
  }

  async function copyTextToClipboard(value) {
    const text = normalizeCopyText(value);
    if (!text) throw new Error('Nada pronto para copiar por aqui.');

    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', 'readonly');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    textarea.style.top = '0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Não consegui copiar o texto agora.');
  }

  function ensureHtml2CanvasAvailable() {
    if (typeof window.html2canvas !== 'function') {
      throw new Error('A biblioteca de geração da imagem não foi carregada. Verifique se as dependências foram instaladas e recarregue a página.');
    }
  }

  function getCaptureSourceNode() {
    return document.getElementById('cardExport') || document.getElementById('cardPreview');
  }

  function getCaptureWidth(node) {
    const requestedWidth = Number((node && node.dataset && node.dataset.captureWidth) || 860) || 860;
    return Math.max(requestedWidth, 720);
  }

  function getRequestedCaptureScale(node) {
    const requestedScale = Number((node && node.dataset && node.dataset.captureScale) || CAPTURE_MAX_SCALE) || CAPTURE_MAX_SCALE;
    return Math.max(CAPTURE_MIN_SCALE, Math.min(CAPTURE_MAX_SCALE, requestedScale));
  }

  function waitForPaint() {
    return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
  }

  async function waitForFonts() {
    try {
      if (document.fonts && document.fonts.ready) {
        await document.fonts.ready;
      }
    } catch (_) {}
  }

  async function waitForImages(root) {
    const images = Array.from(root.querySelectorAll('img'));
    await Promise.all(images.map((img) => {
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise((resolve) => {
        const done = () => resolve();
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        window.setTimeout(done, 3000);
      });
    }));
  }

  async function waitForAssets(node) {
    await waitForFonts();
    await waitForImages(node);
    await waitForPaint();
  }

  function buildCaptureClone(sourceNode, baseWidth) {
    const stage = document.createElement('div');
    stage.setAttribute('data-capture-stage', 'true');
    stage.setAttribute('aria-hidden', 'true');
    Object.assign(stage.style, {
      position: 'fixed',
      left: '-100000px',
      top: '0',
      width: `${baseWidth}px`,
      padding: '0',
      margin: '0',
      background: '#ffffff',
      pointerEvents: 'none',
      opacity: '1',
      overflow: 'hidden',
      display: 'inline-block',
      boxSizing: 'border-box'
    });

    const clone = sourceNode.cloneNode(true);
    clone.id = `${sourceNode.id || 'whatsapp-card'}-capture`;
    Object.assign(clone.style, {
      width: `${baseWidth}px`,
      minWidth: `${baseWidth}px`,
      maxWidth: `${baseWidth}px`,
      margin: '0',
      display: 'block',
      position: 'static',
      left: '0',
      top: '0',
      transform: 'none',
      opacity: '1',
      visibility: 'visible',
      height: 'auto',
      minHeight: '0',
      overflow: 'hidden',
      background: '#ffffff',
      boxSizing: 'border-box'
    });
    clone.dataset.exportMode = '1';
    clone.classList.add('share-summary-card--export');

    stage.appendChild(clone);
    document.body.appendChild(stage);
    return { stage, clone };
  }

  function getCaptureScale(width, height, requestedScale) {
    const basePixels = Math.max(1, width) * Math.max(1, height);
    if (!basePixels) return requestedScale;
    const safeScale = Math.sqrt(CAPTURE_MAX_PIXELS / basePixels);
    return Math.max(CAPTURE_MIN_SCALE, Math.min(requestedScale, Number.isFinite(safeScale) ? safeScale : requestedScale));
  }

  function canvasHasMeaningfulContent(canvas) {
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d', { willReadFrequently: true }) : null;
    if (!ctx || !canvas.width || !canvas.height) return false;

    const sampleCols = Math.min(32, Math.max(8, Math.ceil(canvas.width / 90)));
    const sampleRows = Math.min(32, Math.max(8, Math.ceil(canvas.height / 90)));
    const stepX = Math.max(1, Math.floor(canvas.width / sampleCols));
    const stepY = Math.max(1, Math.floor(canvas.height / sampleRows));
    let nonBlankSamples = 0;

    for (let y = 0; y < canvas.height; y += stepY) {
      for (let x = 0; x < canvas.width; x += stepX) {
        const pixel = ctx.getImageData(x, y, 1, 1).data;
        const red = pixel[0];
        const green = pixel[1];
        const blue = pixel[2];
        const alpha = pixel[3];
        const isTransparent = alpha === 0;
        const isNearWhite = red >= 248 && green >= 248 && blue >= 248;

        if (!isTransparent && !isNearWhite) {
          nonBlankSamples += 1;
          if (nonBlankSamples >= 8) return true;
        }
      }
    }

    return false;
  }

  function trimTrailingBlankRows(canvas, label) {
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d', { willReadFrequently: true }) : null;
    if (!ctx || !canvas.width || !canvas.height) return canvas;

    const sampleCols = Math.min(64, Math.max(12, Math.ceil(canvas.width / 40)));
    const stepX = Math.max(1, Math.floor(canvas.width / sampleCols));
    let lastContentRow = -1;

    for (let y = canvas.height - 1; y >= 0; y -= 1) {
      let rowHasContent = false;
      for (let x = 0; x < canvas.width; x += stepX) {
        const pixel = ctx.getImageData(x, y, 1, 1).data;
        const isTransparent = pixel[3] === 0;
        const isNearWhite = pixel[0] >= 248 && pixel[1] >= 248 && pixel[2] >= 248;
        if (!isTransparent && !isNearWhite) {
          rowHasContent = true;
          break;
        }
      }
      if (rowHasContent) {
        lastContentRow = y;
        break;
      }
    }

    if (lastContentRow < 0) return canvas;

    const paddingRows = Math.min(24, Math.max(8, Math.round(canvas.height * 0.012)));
    const targetHeight = Math.min(canvas.height, lastContentRow + 1 + paddingRows);
    const trimmedRows = canvas.height - targetHeight;

    if (trimmedRows < 40) return canvas;

    const trimmedCanvas = document.createElement('canvas');
    trimmedCanvas.width = canvas.width;
    trimmedCanvas.height = targetHeight;
    const trimmedCtx = trimmedCanvas.getContext('2d');
    if (!trimmedCtx) return canvas;

    trimmedCtx.drawImage(
      canvas,
      0,
      0,
      canvas.width,
      targetHeight,
      0,
      0,
      trimmedCanvas.width,
      trimmedCanvas.height
    );

    console.info(`[${label}] trailing blank rows trimmed`, {
      originalHeight: canvas.height,
      targetHeight,
      trimmedRows
    });

    return trimmedCanvas;
  }

  async function renderReceiptCanvas(node, width, height, requestedScale, label) {
    const attempts = [
      { foreignObjectRendering: false },
      { foreignObjectRendering: true }
    ];
    let lastError = null;

    for (const attempt of attempts) {
      try {
        const canvas = await html2canvas(node, {
          scale: getCaptureScale(width, height, requestedScale),
          backgroundColor: '#ffffff',
          useCORS: true,
          logging: false,
          imageTimeout: 0,
          width,
          height,
          windowWidth: Math.max(width, getCaptureWidth(node)),
          windowHeight: height,
          scrollX: 0,
          scrollY: 0,
          removeContainer: true,
          ...attempt
        });

        if (!canvasHasMeaningfulContent(canvas)) {
          lastError = new Error('A captura foi gerada em branco.');
          continue;
        }

        console.info(`[${label}] capture ok`, {
          width: canvas.width,
          height: canvas.height,
          scale: getCaptureScale(width, height, requestedScale),
          foreignObjectRendering: Boolean(attempt.foreignObjectRendering)
        });
        return canvas;
      } catch (error) {
        lastError = error;
      }
    }

    throw lastError || new Error('Falha ao renderizar o resumo.');
  }

  async function buildReceiptCanvas() {
    ensureHtml2CanvasAvailable();
    const sourceNode = getCaptureSourceNode();
    if (!sourceNode) throw new Error('Resumo não encontrado para captura.');

    await waitForAssets(sourceNode);

    const requestedWidth = getCaptureWidth(sourceNode);
    const sourceRect = sourceNode.getBoundingClientRect();
    const baseWidth = Math.max(
      requestedWidth,
      Math.ceil(sourceRect.width || sourceNode.scrollWidth || sourceNode.offsetWidth || requestedWidth)
    );
    const requestedScale = getRequestedCaptureScale(sourceNode);
    const { stage, clone } = buildCaptureClone(sourceNode, baseWidth);

    try {
      await waitForAssets(clone);
      const cloneRect = clone.getBoundingClientRect();
      const width = Math.max(baseWidth, Math.ceil(cloneRect.width || clone.scrollWidth || clone.offsetWidth || baseWidth));
      const height = Math.max(600, Math.ceil(cloneRect.height || clone.scrollHeight || clone.offsetHeight || 0));

      console.info('[whatsapp] capture dimensions', { width, height, baseWidth, requestedScale });

      if (!width || !height) {
        throw new Error(`Não foi possível medir a área do resumo para captura (${width}x${height}).`);
      }

      const rawCanvas = await renderReceiptCanvas(clone, width, height, requestedScale, 'whatsapp');
      const canvas = trimTrailingBlankRows(rawCanvas, 'whatsapp');
      if (!canvas || canvas.width < 50 || canvas.height < 50) {
        throw new Error('A imagem foi gerada sem conteúdo útil.');
      }

      return canvas;
    } finally {
      stage.remove();
    }
  }

  function dataUrlToBlob(dataUrl) {
    const parts = String(dataUrl || '').split(',');
    if (parts.length < 2) {
      throw new Error('Não foi possível gerar a imagem do resumo.');
    }

    const mimeMatch = parts[0].match(/data:(.*?);base64/);
    const mime = mimeMatch ? mimeMatch[1] : 'image/png';
    const binary = atob(parts[1]);
    const bytes = new Uint8Array(binary.length);
    for (let index = 0; index < binary.length; index += 1) {
      bytes[index] = binary.charCodeAt(index);
    }

    return new Blob([bytes], { type: mime });
  }

  function canvasToBlob(canvas) {
    return new Promise((resolve, reject) => {
      if (canvas.toBlob) {
        canvas.toBlob((blob) => {
          if (blob && blob.size > 0) {
            console.info('[whatsapp] blob generated', { size: blob.size, type: blob.type || 'image/png' });
            resolve(blob);
            return;
          }

          try {
            resolve(dataUrlToBlob(canvas.toDataURL('image/png')));
          } catch (error) {
            reject(error);
          }
        }, 'image/png');
        return;
      }

      try {
        resolve(dataUrlToBlob(canvas.toDataURL('image/png')));
      } catch (error) {
        reject(error);
      }
    });
  }

  async function getReceiptBlob(forceRefresh = false) {
    if (!whatsappCaptureState.blobPromise || forceRefresh) {
      whatsappCaptureState.blobPromise = (async () => {
        const canvas = await buildReceiptCanvas();
        return canvasToBlob(canvas);
      })().catch((error) => {
        whatsappCaptureState.blobPromise = null;
        throw error;
      });
    }
    return whatsappCaptureState.blobPromise;
  }

  function cleanupObjectUrl() {
    if (whatsappCaptureState.objectUrl) {
      URL.revokeObjectURL(whatsappCaptureState.objectUrl);
      whatsappCaptureState.objectUrl = null;
    }
  }

  function blobToDataUrl(blob) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(reader.error || new Error('Não foi possível ler a imagem gerada.'));
      reader.readAsDataURL(blob);
    });
  }

  async function downloadReceipt() {
    const restore = setBusy(document.getElementById('btnPng'), 'Gerando imagem...');
    try {
      cleanupObjectUrl();
      const blob = await getReceiptBlob(true);
      const link = document.createElement('a');
      link.download = `Fatura_<%= person.name.replace(/\s+/g,'_') %>_<%= String(month).padStart(2,'0') %>_<%= year %>.png`;
      whatsappCaptureState.objectUrl = URL.createObjectURL(blob);
      link.href = whatsappCaptureState.objectUrl;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(cleanupObjectUrl, 1500);
    } finally {
      restore();
    }
  }

  async function sendViaEvolution() {
    const button = document.getElementById('btnEvolution');
    const restore = setBusy(button, 'Enviando no WhatsApp...');
    try {
      const blob = await getReceiptBlob(true);
      const imageBase64 = await blobToDataUrl(blob);

      const response = await fetch('/whatsapp/send-automation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          personPhone: '<%= person.phone || "" %>',
          message: whatsappCaptionMessage,
          followUpMessage: whatsappFollowUpMessage,
          imageBase64
        })
      });

      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Falha na API de envio.');
      }

      alert(whatsappFollowUpMessage
        ? 'Prontinho! O resumo foi enviado com a imagem e o Pix foi logo atrás para facilitar a vida.'
        : 'Prontinho! O resumo foi enviado no WhatsApp com a imagem.');
    } catch (error) {
      console.error('[whatsapp] send failure', error);
      alert(error && error.message ? error.message : 'Não consegui enviar a imagem pelo WhatsApp agora.');
    } finally {
      restore();
    }
  }

  async function copyWhatsappText() {
    try {
      await copyTextToClipboard(whatsappShareText);
      alert('Texto do WhatsApp copiado. Agora é só colar quando quiser.');
    } catch (error) {
      console.error('[whatsapp] copy text failure', error);
      alert(error && error.message ? error.message : 'Não consegui copiar o texto agora.');
    }
  }

  async function copyPixPayload() {
    try {
      await copyTextToClipboard(whatsappPixPayload);
      alert('Pix copia e cola copiado. Agora ficou facinho mandar esse atalho.');
    } catch (error) {
      console.error('[whatsapp] copy pix failure', error);
      alert(error && error.message ? error.message : 'Não consegui copiar o Pix agora.');
    }
  }

  document.getElementById('btnPng')?.addEventListener('click', downloadReceipt);
  document.getElementById('btnEvolution')?.addEventListener('click', sendViaEvolution);
  document.getElementById('btnCopyWhatsappText')?.addEventListener('click', copyWhatsappText);
  document.getElementById('btnCopyPix')?.addEventListener('click', copyPixPayload);
  window.addEventListener('beforeunload', cleanupObjectUrl);
</script>

